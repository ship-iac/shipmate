#!/usr/bin/env python3
"""Post a one-verdict reply comment: a refusal, a failure or a notice.

The bash sites in `actions/comment-ops` and `actions/dispatch` post their replies through this
script, so every one carries the shared header and footer from `summary-comment`. Reads:

- `SHIPMATE_REPLY_VERB`, `SHIPMATE_REPLY_ENV`: the header words, `_md_escape`d there; an empty
  verb gives `### shipmate`.
- `SHIPMATE_REPLY_OUTCOME`: `refused` (the engine decided not to run the command), `failed` (it
  could not), or `notice`. Anything else prints `::error::` to stderr and exits 1, posting
  nothing.
- `SHIPMATE_REPLY_TEXT`: the reason or notice, engine-authored and posted unescaped.

The body is POSTed with `gh` (`GH_TOKEN`) as a comment on pull request `PR_NUMBER` of
`GITHUB_REPOSITORY`; gh's response is discarded and nothing is printed. Any argument exits 1 with
`::error::usage` before anything else. A `PR_NUMBER` that is not a pull-request number exits 1
before any `gh` call; a failed POST exits 1 with gh's stderr.

The footer links this run (`current_run_url()`), then `FOOTER_HINT` on a refusal or a failure;
a notice asks nothing of the reader, so it carries no hint.
"""

import os
import sys

from _shipmate import _load, current_run_url, is_pr_number, run

sc = _load("summary-comment")

VERDICTS = {"refused": "🔴 refused: ", "failed": "🔴 failed: ", "notice": "⚪ "}


def body(verb, env, outcome, text, run_url):
    """The whole comment body for `outcome`, which must be a key of `VERDICTS`."""
    foot = sc.footer(run_url, hint=outcome != "notice")
    return f"{sc.header(verb, env)}\n\n{VERDICTS[outcome]}{text}\n\n{foot}"


def main():
    if sys.argv[1:]:
        sys.exit("::error::usage: reply-comment")
    outcome = os.environ.get("SHIPMATE_REPLY_OUTCOME", "")
    if outcome not in VERDICTS:
        print(
            f"::error::SHIPMATE_REPLY_OUTCOME must be refused, failed or notice (got: {outcome})",
            file=sys.stderr,
        )
        sys.exit(1)
    pr = os.environ.get("PR_NUMBER", "")
    # Bound into the API path; dispatch hands its input through unvalidated.
    if not is_pr_number(pr):
        print(f"::error::PR_NUMBER must be a pull request number (got: {pr})", file=sys.stderr)
        sys.exit(1)
    text = body(
        os.environ.get("SHIPMATE_REPLY_VERB", ""),
        os.environ.get("SHIPMATE_REPLY_ENV", ""),
        outcome,
        os.environ.get("SHIPMATE_REPLY_TEXT", ""),
        current_run_url(),
    )
    repo = os.environ.get("GITHUB_REPOSITORY", "")
    run(["gh", "api", "-X", "POST", f"repos/{repo}/issues/{pr}/comments", "-f", f"body={text}"])


if __name__ == "__main__":
    main()
