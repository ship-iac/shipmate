#!/usr/bin/env python3
"""Post a one-verdict reply comment: a refusal, a failure, a notice or a started run.

The bash sites in `actions/comment-ops` and `actions/dispatch` post their replies through this
script, so every one carries the shared header and footer from `summary-comment`. Reads:

- `SHIPMATE_REPLY_VERB`, `SHIPMATE_REPLY_ENV`: the header words, `_md_escape`d there; an empty
  verb gives `### shipmate`.
- `SHIPMATE_REPLY_OUTCOME`: `refused` (the engine decided not to run the command), `failed` (it
  could not), `notice`, or `started` (a dispatch started the verb's run). Anything else prints
  `::error::` to stderr and exits 1, posting nothing.
- `SHIPMATE_REPLY_TEXT`: the reason or notice, posted unescaped. Engine text, holding a
  commenter's text only inside a code span (`comment-parse`'s `_quotable`). Not read for
  `started`.
- `SHIPMATE_REPLY_RUN_ID`: read for `started` only, the `workflow_run_id` of the dispatch
  answer, unchecked but cut to 21 characters by the caller. When it is 1 to 20 digits the
  notice links that run (`started_text`); otherwise it says where the run is listed.

The body is POSTed with `gh` (`GH_TOKEN`) as a comment on pull request `PR_NUMBER` of
`GITHUB_REPOSITORY`; gh's response is discarded and nothing is printed. Any argument exits 1 with
`::error::usage` before anything else. A `PR_NUMBER` that is not a pull-request number exits 1
before any `gh` call; a failed POST exits 1 unannotated, naming the pull request and gh's
stderr, never the body.

The footer links this run (`current_run_url()`), then `FOOTER_HINT` on a refusal or a failure;
a notice or a started run asks nothing of the reader, so it carries no hint.
"""

import os
import sys

from _shipmate import _load, current_run_url, is_pr_number, is_run_id, run, run_annotated

sc = _load("summary-comment")

VERDICTS = {"refused": "🔴 refused: ", "failed": "🔴 failed: ", "notice": "⚪ ", "started": "⚪ "}


def started_text(verb, run_id):
    """The `started` verdict text. The link is built from `run_id`, never taken from the API's
    `html_url`, whose length is unbounded and which could break out of the markdown link."""
    if is_run_id(run_id):
        return f"started [the {sc._md_escape(verb)} run]({current_run_url(run_id)})"
    return f"started the {sc._md_escape(verb)} run; it is listed in this repository's Actions tab"


def body(verb, env, outcome, text, run_url):
    """The whole comment body for `outcome`, which must be a key of `VERDICTS`."""
    foot = sc.footer(run_url, hint=outcome in ("refused", "failed"))
    return f"{sc.header(verb, env)}\n\n{VERDICTS[outcome]}{text}\n\n{foot}"


def main():
    if sys.argv[1:]:
        sys.exit("::error::usage: reply-comment")
    outcome = os.environ.get("SHIPMATE_REPLY_OUTCOME", "")
    if outcome not in VERDICTS:
        print(
            "::error::SHIPMATE_REPLY_OUTCOME must be refused, failed, notice or started "
            f"(got: {outcome})",
            file=sys.stderr,
        )
        sys.exit(1)
    pr = os.environ.get("PR_NUMBER", "")
    # Bound into the API path; dispatch hands its input through unvalidated.
    if not is_pr_number(pr):
        print(f"::error::PR_NUMBER must be a pull request number (got: {pr})", file=sys.stderr)
        sys.exit(1)
    verb = os.environ.get("SHIPMATE_REPLY_VERB", "")
    if outcome == "started":
        verdict = started_text(verb, os.environ.get("SHIPMATE_REPLY_RUN_ID", ""))
    else:
        verdict = os.environ.get("SHIPMATE_REPLY_TEXT", "")
    text = body(verb, os.environ.get("SHIPMATE_REPLY_ENV", ""), outcome, verdict, current_run_url())
    repo = os.environ.get("GITHUB_REPOSITORY", "")
    # The body goes through stdin: `run`'s failure message quotes the argv.
    argv = ["gh", "api", "-X", "POST", f"repos/{repo}/issues/{pr}/comments", "-F", "body=@-"]
    try:
        run(argv, stdin=text)
    except SystemExit as exc:
        sys.exit(f"could not post the reply on pull request #{pr}: {exc.code}")


if __name__ == "__main__":
    run_annotated(main)
