#!/usr/bin/env python3
"""Write a plan cell's cell.json from env vars, or print its step-summary line.

Used by actions/plan-cell's `Write cell summary` step. Built from env vars rather than shell
interpolation so an author-controlled stack/env cannot inject shell or break the JSON.

`--step-line` prints the cell's line for the `Step summary` step: the plan comment's cell line
without a link, from `STACK_NAME`, `ENV`, `CHANGED` and the counts in `plan.txt`.
"""

import json
import os
import pathlib
import sys

from _shipmate import _load

sc = _load("summary-comment")


def step_line():
    cell = {"changed": os.environ["CHANGED"] == "true"}
    # The same derivation as summary-comment's load_cells, so the step summary and the comment
    # name one state.
    tally = sc.counts(pathlib.Path("plan.txt")) or ("?",) * 5
    cell["add"], cell["change"], cell["destroy"], cell["import"], cell["forget"] = tally
    return sc.cell_line(sc.emoji(cell), os.environ["STACK_NAME"], os.environ["ENV"], sc.state(cell))


def main():
    with open("fingerprint.txt", encoding="utf-8") as fh:
        fingerprint = fh.read().strip()
    with open("cell.json", "w") as fh:
        json.dump(
            {
                "stack": os.environ["STACK_NAME"],
                "stack_path": os.environ["STACK"],
                "environment": os.environ["ENV"],
                "changed": os.environ["CHANGED"] == "true",
                "fingerprint": fingerprint,
            },
            fh,
        )


if __name__ == "__main__":
    if sys.argv[1:] == ["--step-line"]:
        print(step_line())
    else:
        main()
