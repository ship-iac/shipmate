#!/usr/bin/env python3
"""Annotate a failed `tofu plan` or `tofu init` with OpenTofu's first error diagnostic.

Reads the command's combined output on stdin and prints one `::error::` with the
first diagnostic box (`╷`) whose title is `Error:`, up to its closing `╵`, colour and box
prefix removed (`lock-info`'s `_strip`), cut at `CAP` characters. Prints nothing
when the output holds no such box, so a failure outside OpenTofu keeps the
runner's own "Process completed with exit code" annotation and nothing else.

`tofu-error cache-entry <key>` reads a failed init's output instead and prints the remedy for a
corrupt restored provider cache entry `<key>`, naming the repository when `GITHUB_REPOSITORY` is
set, only when any `Error:` diagnostic's title starts with `INSTALL_FAILED`, and nothing
otherwise: a backend or credential failure is not the cache's, and its own diagnostic names the
cause.

`tofu-error cell-error` writes `$RUNNER_TEMP/cell-error.json`, `{stack, environment, error}` from
`STACK`, `ENV` and the first diagnostic of `$RUNNER_TEMP/plan-run.txt` when `PLAN_OUTCOME` is
`failure`, else of `$RUNNER_TEMP/init.txt`, unescaped. No diagnostic writes no file. The held plan
comment shows it under the cell's row. Other arguments are refused.

The text is author-controlled (a stack's config and provider output), so it
prints only through `command_data`: a raw newline would start a second workflow
command.
"""

import json
import os
import pathlib
import sys

from _shipmate import _load, command_data, run_annotated

li = _load("lock-info")

#: Annotation messages are shown whole in the check run; the cut keeps one bounded.
CAP = 1000

#: The title prefix of the diagnostic a cached provider package that fails to install produces.
INSTALL_FAILED = "Error: Failed to install provider"


def _lines(text):
    return [li._strip(ln) for ln in text.splitlines()]


def _titles(lines):
    """Indices of the `Error:` diagnostic titles in `lines`, in order.

    Only a title right after a box opener counts: an `Error: ` inside a warning's detail or in
    terramate's log is not a diagnostic."""
    return (
        i for i in range(1, len(lines)) if lines[i - 1] == "╷" and lines[i].startswith("Error: ")
    )


def first_error(text):
    """The first `Error:` diagnostic in `text`, stripped and joined with newlines, or ""."""
    lines = _lines(text)
    start = next(_titles(lines), None)
    if start is None:
        return ""
    block = []
    for ln in lines[start:]:
        if ln == "╵":
            break
        block.append(ln)
    return "\n".join(block).strip()[:CAP]


def _decode(data):
    # Provider output is not guaranteed UTF-8; a strict decode would lose the diagnostic.
    return data.decode("utf-8", errors="replace")


def cell_error():
    temp = pathlib.Path(os.environ["RUNNER_TEMP"])
    log = "plan-run.txt" if os.environ.get("PLAN_OUTCOME") == "failure" else "init.txt"
    error = first_error(_decode((temp / log).read_bytes()))
    if error:
        cell = {"stack": os.environ["STACK"], "environment": os.environ["ENV"], "error": error}
        # Outside the workspace: a `cell-error.json` the pull request commits must not upload.
        with open(temp / "cell-error.json", "w", encoding="utf-8") as fh:
            json.dump(cell, fh)


def main(argv=()):
    if list(argv) == ["cell-error"]:
        cell_error()
        return
    if argv and (len(argv) != 2 or argv[0] != "cache-entry"):
        raise SystemExit(
            f"::error::usage: tofu-error [cache-entry <key> | cell-error] (got {list(argv)})"
        )
    text = _decode(sys.stdin.buffer.read())
    if not argv:
        if error := first_error(text):
            print(f"::error::{command_data(error)}")
        return
    lines = _lines(text)
    if any(lines[i].startswith(INSTALL_FAILED) for i in _titles(lines)):
        key, repo = argv[1], os.environ.get("GITHUB_REPOSITORY", "")
        # Without `--repo`, gh resolves the repository from the clone it runs in.
        flag = f" --repo {repo}" if repo else ""
        remedy = (
            f"OpenTofu's init failed after restoring provider cache entry {key}. If the log above"
            " says a cached package does not match the content of the downloaded package, delete"
            f" the entry with gh cache delete {key}{flag} and re-run."
        )
        print(f"::error::{command_data(remedy)}")


if __name__ == "__main__":
    run_annotated(main, sys.argv[1:])
