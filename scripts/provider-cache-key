#!/usr/bin/env python3
"""Write the provider cache key's digest for the stack at ``$STACK`` to ``$GITHUB_OUTPUT``.

Used by the ``Provider cache key`` step of plan-cell, drift-cell and apply-cell. The digest is
the SHA-256 of the lock file's ``<address> <version>`` pairs, one per line, sorted. Constraint
strings and hash lines stay out: one address at one version is one package, so two stacks
naming it share a cache entry, and every reader still verifies the package against its own lock.

Writes ``digest=`` when ``.terraform.lock.hcl`` holds no ``provider`` block or cannot be read
(missing, a directory, unreadable); the cell then restores and saves nothing. Never exits
non-zero on file content: the step sits among apply-cell's fail-safes and must not halt an apply.
"""

import hashlib
import os
import pathlib
import re

_PROVIDER = re.compile(r'^provider\s+"([^"]+)"\s*\{[^}]*?^\s*version\s*=\s*"([^"]+)"', re.M)


def digest(text):
    pairs = [f"{address} {version}" for address, version in _PROVIDER.findall(text)]
    if not pairs:
        return ""
    return hashlib.sha256("\n".join(sorted(pairs)).encode()).hexdigest()


def main():
    lock = pathlib.Path(os.environ["STACK"]) / ".terraform.lock.hcl"
    try:
        text = lock.read_text(encoding="utf-8", errors="replace")
    except OSError:
        text = ""
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"digest={digest(text)}\n")


if __name__ == "__main__":
    main()
