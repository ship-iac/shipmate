#!/usr/bin/env python3
"""Write the provider cache entry name for the stack at ``$STACK`` to ``$GITHUB_OUTPUT``.

The one builder of the name every provider cache restore and save uses: cell-init's
``Provider cache key`` step, which plan-cell, drift-cell and apply-cell call, and the merge
deploy's ``warm`` legs. Writes ``entry=tofu-providers-<RUNNER_OS>-<RUNNER_ARCH>-<digest>``, the
OS and architecture of the runner it runs on. The digest is the SHA-256 of the lock file's
``<address> <version>`` pairs, one per line, sorted. Constraint strings and hash lines stay out:
one address at one version is one package, so two stacks naming it share a cache entry, and
every reader still verifies the package against its own lock.

Writes ``entry=`` when ``.terraform.lock.hcl`` holds no ``provider`` block or cannot be read
(missing, a directory, unreadable); the cell then restores and saves nothing. Never exits
non-zero on file content: the step runs inside apply-cell's init step and must not halt an apply.
"""

import hashlib
import os
import pathlib
import re

from _shipmate import run_annotated, write_outputs

_PROVIDER = re.compile(r'^provider\s+"([^"]+)"\s*\{[^}]*?^\s*version\s*=\s*"([^"]+)"', re.M)


def digest(text):
    pairs = [f"{address} {version}" for address, version in _PROVIDER.findall(text)]
    if not pairs:
        return ""
    return hashlib.sha256("\n".join(sorted(pairs)).encode()).hexdigest()


def lock_digest(stack):
    """`digest` of the stack directory `stack`'s `.terraform.lock.hcl`; "" when unreadable."""
    try:
        text = (pathlib.Path(stack) / ".terraform.lock.hcl").read_text(
            encoding="utf-8", errors="replace"
        )
    except OSError:
        text = ""
    return digest(text)


def main():
    found = lock_digest(os.environ["STACK"])
    platform = f"{os.environ['RUNNER_OS']}-{os.environ['RUNNER_ARCH']}"
    write_outputs(entry=f"tofu-providers-{platform}-{found}" if found else "")


if __name__ == "__main__":
    run_annotated(main)
