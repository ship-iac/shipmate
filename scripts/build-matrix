#!/usr/bin/env python3
"""Compute the plan matrix: changed stacks x their env tags -> cells.

Pure core (build_matrix) is unit-tested; main() gathers inputs from terramate
(the changed stack set + each stack's tags) and writes GitHub Actions job
outputs. Environment membership comes purely from stack tags (CONTRACT tag
grammar: env/<name>). The environment table is a separate read and does need
GH_TOKEN: it comes from the default branch through the contents API, not from the
checked-out tree.
"""

import json
import os

from _shipmate import _load

ec = _load("env-config")
# One subprocess wrapper and one `gh api` reader for both modules, homed in the one
# that `_load`s nothing; `_run`'s docstring says why that direction is the terminating one.
_run = ec._run
gh_json = ec.gh_json

#: The two pull-request events `plan_workflow_error` requires a consumer workflow file on.
_PR_EVENTS = ("pull_request", "pull_request_target")

MATRIX_LIMIT = 256

#: Where the consumer's workflow file must live. Three surfaces match this filename
#: literally: `shipmate doctor` keys its fork-trigger exemption and its shim probes on it,
#: `actions/dispatch` sends every commented verb to it, and `scripts/onboard` renders it
#: under this name. No plan-run lookup does — each reads a cell's own apply check.
PLAN_WORKFLOW = ".github/workflows/shipmate.yml"


def workload_of(tags, stack):
    """The `workload/<name>` tag name of `stack`, or "" when it carries none.

    Raises SystemExit naming `stack` and every `workload/*` tag when it carries two or more."""
    workloads = sorted(t for t in tags if t.startswith("workload/"))
    if len(workloads) > 1:
        raise SystemExit(
            f"::error::stack '{stack}' carries {len(workloads)} workload tags "
            f"({', '.join(workloads)}), and a stack carries at most one `workload/<name>` tag. "
            "Keep one in the stack's `tags` and remove the rest."
        )
    return workloads[0][len("workload/") :] if workloads else ""


def guard_slug_collisions(cells):
    """A plan artifact is `plan.<env>.<path with '/' replaced by '-'>`, so `a/b`
    and `a-b` in one environment produce ONE artifact name and an apply
    downloads the wrong stack's plan. Refused here, at matrix construction,
    because that is before any artifact exists -- the plan run refuses up front
    instead of an apply discovering the clash after a plan already ran.

    Per environment, not across the matrix: the env is part of the artifact
    name, so the same slug under two different envs collides with nothing."""
    for env in sorted({c["environment"] for c in cells}):
        by_slug = {}
        for c in cells:
            if c["environment"] == env:
                by_slug.setdefault(c["stack"].replace("/", "-"), set()).add(c["stack"])
        for slug, paths in sorted(by_slug.items()):
            if len(paths) > 1:
                raise SystemExit(
                    f"::error::{', '.join(sorted(paths))} all map to the plan artifact "
                    f"'plan.{env}.{slug}': distinct stack paths sharing one artifact name would "
                    "make an apply download another stack's plan. Rename one so the "
                    "path->'-' slug is unique."
                )


def _matrix_limit_error(count, all_stacks):
    head = (
        f"::error::{count} plan cells exceeds the GitHub Actions matrix limit of {MATRIX_LIMIT}. "
    )
    if all_stacks:
        return head + (
            "A whole-tree sweep covers every stack and environment cell and cannot be split; "
            "the only lever is fewer environments or fewer env-tagged stacks."
        )
    return head + (
        "Split the change across several pull requests -- the matrix is "
        "built over `terramate list --changed`. A one-line edit to a shared local module "
        "correctly marks every dependent stack changed and is one atomic change by nature; "
        "there the only lever is to reduce the number of environments in play."
    )


def build_matrix(envs, stacks_by_env, tags_by_stack, all_stacks=False):
    """The sorted cells of `envs`, each stamped with its `workload_of`."""
    cells = sorted(
        (
            {"stack": stack, "environment": env}
            for env in envs
            for stack in stacks_by_env.get(env, [])
        ),
        key=lambda c: (c["environment"], c["stack"]),
    )
    cells = [
        {**c, "workload": workload_of(tags_by_stack.get(c["stack"], []), c["stack"])} for c in cells
    ]
    guard_slug_collisions(cells)
    if len(cells) > MATRIX_LIMIT:
        raise SystemExit(_matrix_limit_error(len(cells), all_stacks))
    return cells


_ZERO_SHA = "0" * 40


def _list_stacks(all_stacks, base):
    args = ["terramate", "list"]
    if not all_stacks:
        args.append("--changed")
        # github.event.before is the all-zero SHA on a force-push or the first
        # push to a branch; `-B 000...` can't be resolved by git, so omit it
        # (terramate then diffs against its default base) rather than failing.
        if base and base != _ZERO_SHA:
            args += ["-B", base]
    return [s.strip() for s in _run(args).splitlines() if s.strip()]


def _tags(stack):
    out = _run(
        ["terramate", "-C", stack, "experimental", "eval", "--as-json", "terramate.stack.tags"]
    )
    return json.loads(out)


def env_membership(all_stacks=False, base="", require_env_tag=True):
    """({env: [stacks...]}, {stack: [tags...]}) from Terramate tags (CONTRACT
    tag grammar: env/<name>).

    `require_env_tag` (default True) is the plan/deploy fan-out posture: an
    untagged stack fails loud, because there it would silently vanish from the
    matrix. The artifact-sourced bare-apply path passes False -- an untagged
    stack produces no `plan.<env>.<slug>` artifact and so contributes no cell
    regardless, and an unrelated one must not abort the apply."""
    stacks = _list_stacks(all_stacks, base)
    tags_by_stack = {s: _tags(s) for s in stacks}
    if require_env_tag:
        untagged = [s for s in stacks if not any(t.startswith("env/") for t in tags_by_stack[s])]
        if untagged:
            raise SystemExit(
                f"::error::{len(untagged)} stack(s) have no env/* tag and cannot fan out to any "
                "environment (they would silently skip): " + ", ".join(sorted(untagged))
            )
    stacks_by_env = {}
    for s in stacks:
        for t in tags_by_stack[s]:
            if t.startswith("env/"):
                stacks_by_env.setdefault(t[len("env/") :], []).append(s)
    return stacks_by_env, tags_by_stack


def tagged_workloads(stacks_by_env, tags_by_stack):
    """`{env: frozenset of the names its stacks' workload/<name> tags carry}`, every env of
    `stacks_by_env` included.

    Not through `workload_of`: its two-tag refusal is scoped to the cells a run runs."""
    return {
        env: frozenset(
            t[len("workload/") :]
            for s in stacks
            for t in tags_by_stack.get(s, [])
            if t.startswith("workload/")
        )
        for env, stacks in stacks_by_env.items()
    }


def compute_cells(all_stacks=False, base=""):
    """(`tagged_workloads` of the scan, cells). The map is returned beside the cells because a
    caller that scanned the whole tree feeds it to `env_config` as `tagged`, and re-scanning
    would be a second source that can disagree with this one."""
    stacks_by_env, tags_by_stack = env_membership(all_stacks, base)
    cells = build_matrix(sorted(stacks_by_env), stacks_by_env, tags_by_stack, all_stacks)
    return tagged_workloads(stacks_by_env, tags_by_stack), cells


def env_config(cells, tagged=None, table=None):
    """The validated table for `cells`. One read per detect, not per row.

    `tagged` is the whole-tree `tagged_workloads` scan, which only the unused-entry and
    untagged-workload warnings read; the caller passes it only where it actually scanned the
    whole tree, and `None` otherwise. `table` is a mapping the caller already read from the
    default branch, for a path needing a field of it before its cells exist; passing it here
    is what keeps that path on one read.
    """
    envs = {c["environment"] for c in cells}
    table = ec.read_table() if table is None else table
    return ec.validate(table, envs, tagged=tagged)


def stamp_rows(cells, table, tier):
    """Stamp each row with what the table resolves for it, or `SystemExit`.

    `tier` is the calling detect's path (`plan` or `apply`) and is always passed
    explicitly: one call site serves both tiers, so nothing may infer it. Applied at each
    site that emits rows rather than inside `build_matrix`, which stays pure and
    unit-testable; `run_unlock` returns from `apply-detect`'s `main` early, so a stamp in any
    `main` tail would skip the unlock path. `test_row_stamp_guard.py` pins each site.

    A row whose `env_binding` is not a non-empty string refuses before any caller writes a
    matrix: every cell job binds `environment:` from it, and GitHub binds no environment for
    an empty one, so the cell would run outside every environment control.
    """
    rows = [
        {**cell, **ec.resolve(table, cell["environment"], tier, cell["workload"])} for cell in cells
    ]
    for row in rows:
        binding = row.get("env_binding")
        if not isinstance(binding, str) or not binding:
            raise SystemExit(
                f"::error::{row['stack']} in {row['environment']} resolved env_binding "
                f"{binding!r}, which names no GitHub Environment. A job bound to it would run "
                "outside every environment control, so no matrix is written."
            )
    return rows


def refuse_workload_gaps(rows, table):
    """`SystemExit` naming every row whose `workload/<name>` tag its environment's `workloads`
    list does not name (`env-config`'s `outside_workloads`), in row order. Membership is per
    environment, so the plan and apply paths refuse the same rows.

    Each caller passes only the rows it will run. A completed, excluded or held cell is not
    refused: a table-only change can make an applied cell look misconfigured, and refusing
    over it would strand every pull request that planned it. `test_workload_gap_guard.py`
    pins each call site.
    """
    items = []
    for row in rows:
        env, workload = row["environment"], row["workload"]
        listed = ec.outside_workloads(table, env, workload)
        if listed is not None:
            items.append(
                f"{row['stack']} in {env} (workload/{workload}; {env} lists {', '.join(listed)})"
            )
    if items:
        raise SystemExit(
            f"::error::{len(items)} cell(s) carry a workload tag their environment's workloads "
            f"list does not name: {'; '.join(items)}. A listed workload is the only one the "
            "default branch grants a role to. Retag the stack, or add the workload to "
            f"environments.<env>.workloads in {ec.CONFIG_PATH} on the default branch, which is "
            "where this table is read from: merge it there on its own pull request first."
        )


def fork_pr_error(repository, head_repo, no_pull_request: bool):
    """The `::error::` line rejecting a run this script may not plan, or "" when
    it may.

    A fork's run is handed no secrets, but the plan cell still runs
    `terramate`/`tofu` over the fork's own HCL on the consumer's runners with
    whatever the plan environment exposes as *variables* -- which are not
    secrets and are not withheld. Fork pull requests are not supported at all.

    Loud rather than an empty matrix: the engine plan workflow's `summary` job
    refuses a head repository it was not told about, so a green "nothing to
    plan" would leave an outside contributor waiting on a gate that
    structurally cannot arrive.

    REFUSES BY DEFAULT, keyed on the head repository the WRAPPER states -- not
    on the event name. `github.event_name` cannot express the distinction: the
    drift path already triggers on `schedule` and `workflow_dispatch`, so a
    dispatched plan would be indistinguishable from a manual drift run. A
    caller with no pull-request context (drift) says so explicitly with
    `no-pull-request`; anything else that omits `head-repo` is refused. The
    direction is chosen on failure mode -- a forgotten input on a plan wrapper
    still refuses forks, while a forgotten opt-out on a drift wrapper turns the
    nightly red.

    The stated value is trustworthy against the threat this guards: the caller
    is the consumer's own default-branch workflow, which a pull-request author
    cannot edit. The residual risk is consumer misconfiguration, which is what
    doctor's wiring probe reports.

    Only the bool `True` skips the refusal, here and in the two checks below: a
    caller passing the raw input string would otherwise skip it for "false"."""
    if no_pull_request is True:
        return ""
    head_repo = head_repo.strip()
    if not head_repo:
        return (
            "::error::this run did not state its head repository. The `head-repo` input of "
            "shipmate's `build-matrix` action must be the pull request's head repository full "
            "name (`owner/repo`), so this run can be checked against a fork head. See "
            "`docs/getting-started.md` for the wiring. A workflow with no pull request at all "
            "(nightly drift) passes `no-pull-request: true` instead."
        )
    if repository and head_repo == repository:
        return ""
    return (
        f"::error::fork pull requests are not supported: this run's stated head repository "
        f"(`{head_repo}`) is not `{repository or 'this repository'}`. Planning it would run "
        "the pull request's own Terramate/OpenTofu code on your runners with your plan "
        "environment's variables, and no `shipmate / gate` status is ever written for a "
        "fork head, so the pull request could not merge either way. Push the branch to "
        "this repository (`gh pr checkout` then push) and open the pull request there."
    )


def head_checkout_error(head_sha, no_pull_request: bool):
    """The `::error::` line refusing a checkout that is not the commit this run
    says it is planning, or "" when it may be planned.

    Keyed on the head SHA the WRAPPER states, like the fork refusal beside it,
    and not on the event name. Both plan triggers check out something else by
    default -- `pull_request_target` the base branch, `workflow_dispatch` the
    dispatch ref -- so a checkout that does not name the head plans a stranger,
    diffs it against the base, comes out with an empty matrix, skips the plan
    job and greens the gate with no pending apply checks, leaving the post-merge
    deploy an empty queue.

    REFUSES BY DEFAULT. A caller with no pull request at all (nightly drift)
    says so with `no-pull-request`; anything else that omits `head-sha` is
    refused. Same direction and same reason as the fork refusal: a forgotten
    input on a plan wrapper still refuses, while a forgotten opt-out on a drift
    wrapper turns the nightly red.

    No `pull_request` exclusion, even though its default checkout is
    `refs/pull/<n>/merge` and so never equals the payload head: the comparison is
    against the head the wrapper states, and `actions/pr-facts` states the payload
    head under both pull-request events, so a `pull_request` consumer names `ref:`
    like every other one.
    """
    if no_pull_request is True:
        return ""
    head_sha = head_sha.strip()
    if not head_sha:
        return (
            "::error::this run did not state the commit it is planning. The `head-sha` input "
            "of shipmate's `build-matrix` action must be the pull request's head commit, so "
            "this checkout can be checked against it. Wire it to the `head-sha` output of "
            "shipmate's `pr-facts` action; see `docs/getting-started.md`. A workflow with no "
            "pull request at all (nightly drift) passes `no-pull-request: true` instead."
        )
    checked_out = _run(["git", "rev-parse", "HEAD"]).strip()
    if checked_out == head_sha:
        return ""
    return (
        f"::error::this run checked out {checked_out}, which is not the commit it is planning "
        f"({head_sha}). `actions/checkout` takes the base branch under "
        "`pull_request_target` and the dispatch ref under `workflow_dispatch` unless its "
        "`ref:` names the head SHA. Add it to every checkout in "
        f"`{PLAN_WORKFLOW}`; without it planning diffs the wrong tree against the "
        "base, silently reports no changes, and the gate greens with nothing queued to apply."
    )


def plan_workflow_error(event_name):
    """The `::error::` line refusing a checkout with no consumer workflow file at
    `PLAN_WORKFLOW`, or "" when this run may be planned.

    A sparse checkout would fail this falsely; `detect` needs the whole tree for
    terramate, so that shape does not occur here.
    """
    if event_name not in _PR_EVENTS:
        return ""
    if os.path.isfile(PLAN_WORKFLOW):
        return ""
    return (
        f"::error::this repository has no `{PLAN_WORKFLOW}`, the one path `CONTRACT.md` "
        "lets the consumer's workflow file live at, and this refusal is what enforces it. "
        "That exact filename is matched literally by `shipmate doctor`, which keys its "
        "calling-job-name, dispatch-wiring and routing probes on it, and by "
        "`actions/dispatch`, which sends every commented verb to it. A consumer workflow "
        "under any other name silently loses those probes, draws doctor's own "
        "`pull_request_target` warning instead, and is reached by no `shipmate` command at "
        f"all. Move the consumer's workflow back to `{PLAN_WORKFLOW}`."
    )


def main():
    all_stacks = os.environ.get("SHIPMATE_ALL_STACKS", "") == "true"
    base = os.environ.get("SHIPMATE_BASE_SHA", "")
    event_name = os.environ.get("GITHUB_EVENT_NAME", "")
    # Case- and whitespace-insensitive: a `no-pull-request: True` would otherwise
    # redden a nightly for a YAML capitalisation, and honouring it is no fork
    # exposure -- only this repository's default-branch workflow can set it.
    no_pull_request = os.environ.get("SHIPMATE_NO_PULL_REQUEST", "").strip().lower() == "true"
    # `or`, so the fork refusal precedes the two consumer-wiring checks: a fork
    # head must be turned away before this script shells out or reads its tree.
    rejection = (
        fork_pr_error(
            os.environ.get("GITHUB_REPOSITORY", ""),
            os.environ.get("SHIPMATE_HEAD_REPO", ""),
            no_pull_request,
        )
        or head_checkout_error(os.environ.get("SHIPMATE_HEAD_SHA", ""), no_pull_request)
        or plan_workflow_error(event_name)
    )
    if rejection:
        raise SystemExit(rejection)
    tagged, cells = compute_cells(all_stacks, base)
    # One call serves plan and drift, and only drift scans the whole tree. Under
    # `all_stacks=False` the map covers the CHANGED stacks alone, so passing it would
    # report every unchanged environment as an unused table entry on every plan.
    table = env_config(cells, tagged if all_stacks else None)
    cells = stamp_rows(cells, table, "plan")
    refuse_workload_gaps(cells, table)
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"matrix={json.dumps({'include': cells})}\n")
        fh.write(f"empty={'true' if not cells else 'false'}\n")
        fh.write(f"count={len(cells)}\n")
    listing = ", ".join(f"{c['environment']}/{c['stack']}" for c in cells) or "(none)"
    print(f"{len(cells)} cell(s): {listing}")


if __name__ == "__main__":
    main()
