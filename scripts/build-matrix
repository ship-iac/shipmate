#!/usr/bin/env python3
"""Compute the plan matrix: changed stacks x their env tags -> cells.

Pure core (build_matrix) is unit-tested; main() gathers inputs from terramate
(the changed stack set + each stack's tags) and writes GitHub Actions job
outputs. Environment membership comes purely from stack tags (CONTRACT tag
grammar: env/<name>) -- no GitHub API or token required.
"""

import json
import os
import subprocess
import sys

#: The two pull-request events `fork_pr_error` refuses a fork on. Under
#: `pull_request_target` the plan job runs at the base ref with the plan
#: environment's variables, so a fork head reaching it would run the fork's own
#: Terramate/OpenTofu code with them.
_PR_EVENTS = ("pull_request", "pull_request_target")

MATRIX_LIMIT = 256

#: Stack paths whose verb-less plan check name would land inside a namespace
#: the engine selects on. `shipmate` fails SILENTLY: summary-comment resolves
#: each row's plan link by exact `<stack> / <env>` lookup, so the link points at
#: the wrong check rather than erroring.
RESERVED_STACK_PATHS = {
    "apply": (
        "::error::a stack path may not be exactly 'apply': its plan check "
        "'apply / <env>' collides with the apply-check namespace "
        "('apply / <stack> / <env>'). Rename or nest the stack."
    ),
    "shipmate": (
        "::error::a stack path may not be exactly 'shipmate': its plan check "
        "'shipmate / <env>' falls inside the reserved 'shipmate / ' namespace "
        "(e.g. 'shipmate / gate'). Rename or nest the stack."
    ),
}


class MatrixTooLarge(Exception):
    pass


def build_matrix(envs, stacks_by_env, tags_by_stack):
    cells = []
    for env in envs:
        for stack in stacks_by_env.get(env, []):
            workload = ""
            for tag in tags_by_stack.get(stack, []):
                if tag.startswith("workload/"):
                    workload = tag[len("workload/") :]
                    break
            cells.append({"stack": stack, "environment": env, "workload": workload})
    cells.sort(key=lambda c: (c["environment"], c["stack"]))
    for reserved, message in RESERVED_STACK_PATHS.items():
        if any(c["stack"] == reserved for c in cells):
            raise SystemExit(message)
    if len(cells) > MATRIX_LIMIT:
        raise MatrixTooLarge(
            f"{len(cells)} plan cells exceeds the GitHub Actions matrix limit of {MATRIX_LIMIT}. "
            "Split the change across multiple PRs."
        )
    return cells


def _run(args):
    # args is a code-controlled tool invocation (gh/terramate/tofu by PATH name),
    # never user input, and shell=False — safe.
    p = subprocess.run(args, capture_output=True, text=True)  # noqa: S603
    if p.returncode != 0:
        # Surface the tool's own error; a swallowed stderr makes CI opaque.
        sys.stderr.write(p.stderr)
        raise SystemExit(f"::error::command failed ({p.returncode}): {' '.join(args)}")
    return p.stdout


def gh_json(path):
    """`gh api <path>` -> parsed JSON, through _run so a nonzero exit surfaces
    the tool's stderr then raises ::error:: from a single definition. Shared by
    apply-detect and deploy-detect (each aliases it as `_gh_json`)."""
    return json.loads(_run(["gh", "api", path]))


_ZERO_SHA = "0" * 40


def _list_stacks(all_stacks, base):
    args = ["terramate", "list"]
    if not all_stacks:
        args.append("--changed")
        # github.event.before is the all-zero SHA on a force-push or the first
        # push to a branch; `-B 000...` can't be resolved by git, so omit it
        # (terramate then diffs against its default base) rather than failing.
        if base and base != _ZERO_SHA:
            args += ["-B", base]
    return [s.strip() for s in _run(args).splitlines() if s.strip()]


def _tags(stack):
    out = _run(
        ["terramate", "-C", stack, "experimental", "eval", "--as-json", "terramate.stack.tags"]
    )
    return json.loads(out)


def env_membership(all_stacks=False, base="", require_env_tag=True):
    """({env: [stacks...]}, {stack: [tags...]}) from Terramate tags (CONTRACT
    tag grammar: env/<name>).

    `require_env_tag` (default True) is the plan/deploy fan-out posture: an
    untagged stack fails loud, because there it would silently vanish from the
    matrix. The artifact-sourced bare-apply path passes False -- an untagged
    stack produces no `plan.<env>.<slug>` artifact and so contributes no cell
    regardless, and an unrelated one must not abort the apply."""
    stacks = _list_stacks(all_stacks, base)
    tags_by_stack = {s: _tags(s) for s in stacks}
    if require_env_tag:
        untagged = [s for s in stacks if not any(t.startswith("env/") for t in tags_by_stack[s])]
        if untagged:
            raise SystemExit(
                "::error::stack(s) have no env/* tag and cannot fan out to any "
                "environment (they would silently skip): " + ", ".join(sorted(untagged))
            )
    stacks_by_env = {}
    for s in stacks:
        for t in tags_by_stack[s]:
            if t.startswith("env/"):
                stacks_by_env.setdefault(t[len("env/") :], []).append(s)
    return stacks_by_env, tags_by_stack


def compute_cells(all_stacks=False, base=""):
    stacks_by_env, tags_by_stack = env_membership(all_stacks, base)
    return build_matrix(sorted(stacks_by_env), stacks_by_env, tags_by_stack)


def _event_payload(path):
    """The triggering event's payload, or {} when it cannot be read.

    Unreadable is not "same repository": `fork_pr_error` treats a payload it
    cannot interpret as a fork, so a lost GITHUB_EVENT_PATH refuses the run
    rather than planning fork code by accident."""
    if not path:
        return {}
    try:
        with open(path, encoding="utf-8") as fh:
            payload = json.load(fh)
    except (OSError, ValueError):
        return {}
    return payload if isinstance(payload, dict) else {}


def fork_pr_error(event_name, repository, payload):
    """The `::error::` line rejecting a fork pull request, or "" when this run
    may be planned.

    A fork's run is handed no secrets, but the plan cell still runs
    `terramate`/`tofu` over the fork's own HCL on the consumer's runners with
    whatever the plan environment exposes as *variables* -- which are not
    secrets and are not withheld. Fork pull requests are not supported at all.

    Loud rather than an empty matrix: `summary.yml` refuses a fork head, so a
    green "nothing to plan" would leave an outside contributor waiting on a gate
    that structurally cannot arrive.

    Keyed on the EVENT being a pull request, never on a missing head repository:
    the drift path runs with no pull-request context, where `head.repo` is
    absent by construction, and keying on the field would kill nightly drift
    silently. Both PR events count -- `pull_request_target` especially, the one
    that runs at the base ref with the repository's secrets.

    Within a PR event an undeterminable head repository is REJECTED: a
    same-repository pull request always carries `head.repo.full_name`, so
    "unknown" only ever means a run this script cannot vouch for."""
    if event_name not in _PR_EVENTS:
        return ""
    head = ((payload.get("pull_request") or {}).get("head") or {}).get("repo") or {}
    full_name = head.get("full_name") or ""
    if repository and full_name == repository:
        return ""
    origin = f"`{full_name}`" if full_name else "could not be determined"
    return (
        f"::error::fork pull requests are not supported — this run's head repository "
        f"({origin}) is not `{repository or 'this repository'}`. Planning it would run "
        "the pull request's own Terramate/OpenTofu code on your runners with your plan "
        "environment's variables, and no `shipmate / gate` status is ever written for a "
        "fork head, so the pull request could not merge either way. Push the branch to "
        "this repository (`gh pr checkout` then push) and open the pull request there."
    )


def main():
    all_stacks = os.environ.get("SHIPMATE_ALL_STACKS", "") == "true"
    base = os.environ.get("SHIPMATE_BASE_SHA", "")
    event_name = os.environ.get("GITHUB_EVENT_NAME", "")
    rejection = fork_pr_error(
        event_name,
        os.environ.get("GITHUB_REPOSITORY", ""),
        _event_payload(os.environ.get("GITHUB_EVENT_PATH", "")),
    )
    if rejection:
        raise SystemExit(rejection)
    cells = compute_cells(all_stacks, base)
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"matrix={json.dumps({'include': cells})}\n")
        fh.write(f"empty={'true' if not cells else 'false'}\n")
        fh.write(f"count={len(cells)}\n")
    listing = ", ".join(f"{c['environment']}/{c['stack']}" for c in cells) or "(none)"
    print(f"{len(cells)} cell(s): {listing}")


if __name__ == "__main__":
    try:
        main()
    except MatrixTooLarge as e:
        print(f"::error::{e}", file=sys.stderr)
        sys.exit(1)
