#!/usr/bin/env python3
"""Compute the plan matrix: changed stacks x their env tags -> cells.

Pure core (build_matrix) is unit-tested; main() gathers inputs from terramate
(the changed stack set + each stack's tags) and writes GitHub Actions job
outputs. Environment membership comes purely from stack tags (CONTRACT tag
grammar: env/<name>) -- no GitHub API or token required.

main() also runs the consumer plan/summary wiring checks (scripts/wiring) and
FAILS a pull-request run on a confident break. detect is the only job upstream
of all three wiring failure modes, and two of the three otherwise merge green:
GitHub resolves a workflow_run trigger against the workflow name recorded on
the default branch, so breaking the plan workflow's name or the summary wrapper
does not stop this pull request from getting its gate -- it stops every pull
request afterwards, including the one opened to fix it.
"""

import importlib.util
import json
import os
import pathlib
import subprocess
import sys
from importlib.machinery import SourceFileLoader

_D = pathlib.Path(__file__).resolve().parent


def _load(fname):
    loader = SourceFileLoader(fname.replace("-", "_"), str(_D / fname))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


wi = _load("wiring")

#: Pull-request events, the ones where a wiring break is still preventable.
_PR_EVENTS = ("pull_request", "pull_request_target")

MATRIX_LIMIT = 256

#: Stack paths whose plan check name (grammar `<stack> / <env>`, verb-less)
#: would land inside a namespace the engine selects on, mapped to the rejection
#: raised. The `shipmate` case is the one that fails silently: summary-comment
#: resolves each row's plan link by exact `<stack> / <env>` lookup, so the link
#: points at the wrong check rather than erroring.
RESERVED_STACK_PATHS = {
    "apply": (
        "::error::a stack path may not be exactly 'apply': its plan check "
        "'apply / <env>' collides with the apply-check namespace "
        "('apply / <stack> / <env>'). Rename or nest the stack."
    ),
    "shipmate": (
        "::error::a stack path may not be exactly 'shipmate': its plan check "
        "'shipmate / <env>' falls inside the reserved 'shipmate / ' namespace "
        "(e.g. 'shipmate / gate'). Rename or nest the stack."
    ),
}


class MatrixTooLarge(Exception):
    pass


def build_matrix(envs, stacks_by_env, tags_by_stack):
    cells = []
    for env in envs:
        for stack in stacks_by_env.get(env, []):
            workload = ""
            for tag in tags_by_stack.get(stack, []):
                if tag.startswith("workload/"):
                    workload = tag[len("workload/") :]
                    break
            cells.append({"stack": stack, "environment": env, "workload": workload})
    cells.sort(key=lambda c: (c["environment"], c["stack"]))
    for reserved, message in RESERVED_STACK_PATHS.items():
        if any(c["stack"] == reserved for c in cells):
            raise SystemExit(message)
    if len(cells) > MATRIX_LIMIT:
        raise MatrixTooLarge(
            f"{len(cells)} plan cells exceeds the GitHub Actions matrix limit of {MATRIX_LIMIT}. "
            "Split the change across multiple PRs."
        )
    return cells


def _run(args):
    # args is a code-controlled tool invocation (gh/terramate/tofu by PATH name),
    # never user input, and shell=False — safe.
    p = subprocess.run(args, capture_output=True, text=True)  # noqa: S603
    if p.returncode != 0:
        # Surface the tool's own error; a swallowed stderr makes CI opaque.
        sys.stderr.write(p.stderr)
        raise SystemExit(f"::error::command failed ({p.returncode}): {' '.join(args)}")
    return p.stdout


def gh_json(path):
    """`gh api <path>` -> parsed JSON, through _run so a nonzero exit surfaces
    the tool's stderr then raises ::error:: from a single definition. Shared by
    apply-detect and deploy-detect (each aliases it as `_gh_json`)."""
    return json.loads(_run(["gh", "api", path]))


_ZERO_SHA = "0" * 40


def _list_stacks(all_stacks, base):
    args = ["terramate", "list"]
    if not all_stacks:
        args.append("--changed")
        # github.event.before is the all-zero SHA on a force-push or the first
        # push to a branch; `-B 000...` can't be resolved by git, so omit it
        # (terramate then diffs against its default base) rather than failing.
        if base and base != _ZERO_SHA:
            args += ["-B", base]
    return [s.strip() for s in _run(args).splitlines() if s.strip()]


def _tags(stack):
    out = _run(
        ["terramate", "-C", stack, "experimental", "eval", "--as-json", "terramate.stack.tags"]
    )
    return json.loads(out)


def env_membership(all_stacks=False, base="", require_env_tag=True):
    """({env: [stacks...]}, {stack: [tags...]}) from Terramate tags (CONTRACT
    tag grammar: env/<name>).

    `require_env_tag` (default True) is the plan/deploy fan-out posture: a
    stack with no env/* tag fails loud, because there it would contribute no
    cells and silently vanish from the matrix. The artifact-sourced bare-apply
    path passes False -- an untagged stack produces no `plan.<env>.<slug>`
    artifact and so contributes no cell regardless, and an unrelated untagged
    stack anywhere else in the repo must not abort the apply (the targeted
    `shipmate apply <env>` path never tag-validates either)."""
    stacks = _list_stacks(all_stacks, base)
    tags_by_stack = {s: _tags(s) for s in stacks}
    if require_env_tag:
        untagged = [s for s in stacks if not any(t.startswith("env/") for t in tags_by_stack[s])]
        if untagged:
            raise SystemExit(
                "::error::stack(s) have no env/* tag and cannot fan out to any "
                "environment (they would silently skip): " + ", ".join(sorted(untagged))
            )
    stacks_by_env = {}
    for s in stacks:
        for t in tags_by_stack[s]:
            if t.startswith("env/"):
                stacks_by_env.setdefault(t[len("env/") :], []).append(s)
    return stacks_by_env, tags_by_stack


def compute_cells(all_stacks=False, base=""):
    stacks_by_env, tags_by_stack = env_membership(all_stacks, base)
    return build_matrix(sorted(stacks_by_env), stacks_by_env, tags_by_stack)


def _event_payload(path):
    """The triggering event's payload, or {} when it cannot be read.

    Unreadable is not "same repository": `fork_pr_error` treats a payload it
    cannot interpret as a fork, so a lost GITHUB_EVENT_PATH refuses the run
    rather than planning fork code by accident."""
    if not path:
        return {}
    try:
        with open(path, encoding="utf-8") as fh:
            payload = json.load(fh)
    except (OSError, ValueError):
        return {}
    return payload if isinstance(payload, dict) else {}


def fork_pr_error(event_name, repository, payload):
    """The `::error::` line rejecting a fork pull request, or "" when this run
    may be planned.

    A fork's `pull_request` run is handed no secrets, but the plan cell still
    runs `terramate`/`tofu` over the fork's own HCL on the consumer's runners
    and with whatever the plan environment exposes as *variables* -- variables
    are not secrets and are not withheld. Fork pull requests are therefore not
    supported at all; the branch has to live in the repository.

    Loud rather than an empty matrix: `summary.yml` refuses a fork head, so no
    `shipmate / gate` status is ever written and the required check never
    appears. A green "nothing to plan" would leave an outside contributor
    waiting on a gate that structurally cannot arrive.

    Keyed on the event being a pull request, never on a missing head repository:
    the drift path calls this script with all-stacks and no pull request context
    (`schedule` / `workflow_dispatch`), where `head.repo` is absent by
    construction. Keying on the field instead would kill nightly drift silently.
    Both pull-request events count -- `pull_request` and `pull_request_target`,
    which carries the same `pull_request.head.repo.full_name`. The latter
    especially: it is the one pull-request event that runs at the base ref with
    the repository's secrets, so refusing nothing there is the worst place to
    fail open.

    Within a pull request event, an undeterminable head repository is rejected
    -- a payload missing, unreadable, or without
    `pull_request.head.repo.full_name` (the shape GitHub sends once the fork has
    been deleted). A same-repository pull request always carries it, so
    "unknown" only ever means a run this script cannot vouch for."""
    if event_name not in ("pull_request", "pull_request_target"):
        return ""
    head = ((payload.get("pull_request") or {}).get("head") or {}).get("repo") or {}
    full_name = head.get("full_name") or ""
    if repository and full_name == repository:
        return ""
    origin = f"`{full_name}`" if full_name else "could not be determined"
    return (
        f"::error::fork pull requests are not supported — this run's head repository "
        f"({origin}) is not `{repository or 'this repository'}`. Planning it would run "
        "the pull request's own Terramate/OpenTofu code on your runners with your plan "
        "environment's variables, and no `shipmate / gate` status is ever written for a "
        "fork head, so the pull request could not merge either way. Push the branch to "
        "this repository (`gh pr checkout` then push) and open the pull request there."
    )


def workflow_files(root):
    """{filename: bytes} for `.github/workflows` under `root`, or None when the
    directory cannot be listed.

    Read off the local checkout rather than the API: on a `pull_request` event
    that checkout is the MERGE commit, which is the state the gate will actually
    live under once this pull request lands.
    """
    d = pathlib.Path(root) / ".github" / "workflows"
    try:
        entries = sorted(p for p in d.iterdir() if p.is_file())
    except OSError:
        return None
    files = {}
    for p in entries:
        if p.suffix not in (".yml", ".yaml"):
            continue
        try:
            files[p.name] = p.read_bytes()
        except OSError:
            files[p.name] = None
    return files


def wiring_report(found, event_name):
    """(annotation lines to print, the `::error::` line or "") for a set of
    `wiring.findings`.

    Fails only a pull-request event, exactly like `fork_pr_error`: the drift
    path (`schedule` / `workflow_dispatch`, `all-stacks: true`) must keep
    running against a repository whose wiring is already broken, or one merged
    mistake takes nightly drift down in every consumer. Off that path the same
    finding is a warning, which also makes drift a post-merge detector.

    UNKNOWN never blocks and never warns. A false positive would red every pull
    request in every consumer until an engine fix and a re-pin, so the only
    findings allowed to reach `::error::` are the near-tautological ones
    `scripts/wiring` classifies as BROKEN.

    Deliberately no GHA data escaping, unlike doctor's `render_annotations`:
    every message here is a module constant, and the one interpolation is
    `ascii()` of a single line, which cannot contain a newline or a carriage
    return. Only a literal `%` in a workflow name could render oddly, and it
    still names the right file.
    """
    lines = [f"::notice title={wi.WIRING_TITLE}::{m}" for state, m in found if state == wi.UNKNOWN]
    broken = [m for state, m in found if state == wi.BROKEN]
    if not broken:
        return lines, ""
    if event_name in _PR_EVENTS:
        return lines, "\n".join(f"::error title={wi.WIRING_TITLE}::{m}" for m in broken)
    lines.extend(f"::warning title={wi.WIRING_TITLE}::{m}" for m in broken)
    return lines, ""


def main():
    all_stacks = os.environ.get("SHIPMATE_ALL_STACKS", "") == "true"
    base = os.environ.get("SHIPMATE_BASE_SHA", "")
    event_name = os.environ.get("GITHUB_EVENT_NAME", "")
    rejection = fork_pr_error(
        event_name,
        os.environ.get("GITHUB_REPOSITORY", ""),
        _event_payload(os.environ.get("GITHUB_EVENT_PATH", "")),
    )
    if rejection:
        raise SystemExit(rejection)
    notes, wiring_error = wiring_report(
        wi.findings(workflow_files("."), os.environ.get("SHIPMATE_ENGINE_REPO", "")),
        event_name,
    )
    for note in notes:
        print(note)
    if wiring_error:
        raise SystemExit(wiring_error)
    cells = compute_cells(all_stacks, base)
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"matrix={json.dumps({'include': cells})}\n")
        fh.write(f"empty={'true' if not cells else 'false'}\n")
        fh.write(f"count={len(cells)}\n")
    listing = ", ".join(f"{c['environment']}/{c['stack']}" for c in cells) or "(none)"
    print(f"{len(cells)} cell(s): {listing}")


if __name__ == "__main__":
    try:
        main()
    except MatrixTooLarge as e:
        print(f"::error::{e}", file=sys.stderr)
        sys.exit(1)
