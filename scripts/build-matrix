#!/usr/bin/env python3
"""Compute the plan matrix: changed stacks x their env tags -> cells.

Pure core (full_tree, cap_cells) is unit-tested; main() gathers inputs from terramate
(the changed stack set + each stack's tags) and writes GitHub Actions job
outputs. Environment membership comes purely from stack tags (CONTRACT tag
grammar: env/<name>). The environment table is a separate read and does need
GH_TOKEN: it comes from the default branch through the contents API, not from the
checked-out tree.
"""

import codecs
import json
import os
import posixpath
import re
import shutil
import subprocess
import tempfile

from _shipmate import _load, _run, command_data, named, run, run_annotated, write_outputs

ag = _load("apply-gate")
ec = _load("env-config")
wv = _load("waves")

#: The two pull-request events `plan_workflow_error` requires a consumer workflow file on.
_PR_EVENTS = ("pull_request", "pull_request_target")

MATRIX_LIMIT = 256

PLAN_WORKFLOW = ag.PLAN_WORKFLOW

#: How many unmanaged stack paths the notice and the `unmanaged` output name; the rest are
#: counted. The output crosses a job boundary in one environment variable, so it stays small.
#: The partial-untag warning and the `lost` output reuse the cap for their `<stack> / <env>`
#: pairs.
UNMANAGED_NAMES = 10


def workload_of(tags, stack, errors=None):
    """The `workload/<name>` tag name of `stack`, or "" when it carries none.

    When it carries two or more, the `::error::` message naming `stack` and every `workload/*`
    tag is raised as `SystemExit`, or, given an `errors` list, appended to it and `None`
    returned."""
    workloads = sorted(t for t in tags if t.startswith("workload/"))
    if len(workloads) > 1:
        message = (
            f"::error::stack '{stack}' carries {len(workloads)} workload tags "
            f"({', '.join(workloads)}), and a stack carries at most one `workload/<name>` tag. "
            "Keep one in the stack's `tags` and remove the rest."
        )
        if errors is None:
            raise SystemExit(message)
        errors.append(message)
        return None
    return workloads[0][len("workload/") :] if workloads else ""


def guard_slug_collisions(cells):
    """A plan artifact is `plan.<env>.<path with '/' replaced by '-'>`, so `a/b`
    and `a-b` in one environment produce ONE artifact name and an apply
    downloads the wrong stack's plan. Refused here, at matrix construction,
    because that is before any artifact exists -- the plan run refuses up front
    instead of an apply discovering the clash after a plan already ran.

    Per environment, not across the matrix: the env is part of the artifact
    name, so the same slug under two different envs collides with nothing."""
    for env in sorted({c["environment"] for c in cells}):
        by_slug = {}
        for c in cells:
            if c["environment"] == env:
                by_slug.setdefault(c["stack"].replace("/", "-"), set()).add(c["stack"])
        for slug, paths in sorted(by_slug.items()):
            if len(paths) > 1:
                raise SystemExit(
                    f"::error::{', '.join(sorted(paths))} all map to the plan artifact "
                    f"'plan.{env}.{slug}': distinct stack paths sharing one artifact name would "
                    "make an apply download another stack's plan. Rename one so the "
                    "path->'-' slug is unique."
                )


def _parse_tag_query(query):
    """`a:b,c` -> [{'a', 'b'}, {'c'}]: comma-separated OR-clauses, each an
    AND of colon-separated terms. Terramate forbids ':' inside a tag value, so
    a ':' here can only be the operator.

    An empty term is refused rather than dropped: a trailing comma or a doubled
    separator is a typo, and both silent readings of it -- matches everything,
    matches nothing -- are wrong in a direction the consumer cannot see."""
    clauses = []
    for clause in query.split(","):
        terms = {t.strip() for t in clause.split(":")}
        if "" in terms:
            raise SystemExit(
                f"::error::the `tags` filter has an empty term: '{query}'. Terms are separated "
                "by ',' (OR) and ':' (AND), and each must be a tag in its on-disk form -- "
                "'env/dev-eu,env/dev-us' or 'env/dev-eu:workload/app'."
            )
        clauses.append(terms)
    return clauses


def _cell_tags(cell, tags_by_stack):
    """The tag set a `tags` filter matches this cell against: the stack's tags
    with every `env/*` tag other than this cell's own removed.

    A stack carrying several env tags becomes one cell per env, so matching the
    raw stack tags would keep the `prod-eu` cell of a `dev-eu`-filtered run."""
    own = "env/" + cell["environment"]
    return {t for t in tags_by_stack.get(cell["stack"], []) if not t.startswith("env/") or t == own}


def filter_cells(cells, tags_by_stack, query):
    """`cells` narrowed to those matching `query`, or all of them when it is empty.

    An empty term refuses (`_parse_tag_query`). A clause matching no cell matches nothing on
    its own, so `env/prod-eu,env/prod-us` written before the first prod-us stack still sweeps
    prod-eu. Every such clause is named in one `::notice::`, with the terms no stack carries;
    a query matching no cell returns `[]` with one. Notices, not refusals: a drift file may
    precede its first tagged stack."""
    if not query.strip():
        return cells
    clauses = _parse_tag_query(query)
    cell_tags = [(c, _cell_tags(c, tags_by_stack)) for c in cells]
    kept = [c for c, tags in cell_tags if any(clause <= tags for clause in clauses)]
    # dict.fromkeys: a clause repeated in the query is named once, in first-occurrence order.
    dead = list(
        dict.fromkeys(
            ":".join(sorted(clause))
            for clause in clauses
            if not any(clause <= tags for _, tags in cell_tags)
        )
    )
    if not dead:
        return kept
    if kept:
        notice = (
            f"the drift tags query '{query}' has clause(s) matching no cell: {', '.join(dead)}."
        )
    else:
        notice = (
            f"the drift tags query '{query}' matches no stack x environment cell, "
            "so this sweep is empty."
        )
    observed = {t for tags in tags_by_stack.values() for t in tags}
    unknown = sorted({t for clause in clauses for t in clause} - observed)
    if unknown:
        notice += (
            f" No stack carries: {', '.join(unknown)}. Tags match in their on-disk form, "
            "such as 'env/dev-eu'."
        )
    print("::notice::" + command_data(notice))
    return kept


def full_tree(envs, stacks_by_env, tags_by_stack, errors=None):
    """The sorted cells of `envs`, each stamped with its `workload_of`, slug collisions refused.

    Uncapped: a `tags` filter narrows this list before `cap_cells` counts it, and both
    refusals here cover the whole scan whatever the filter keeps. Given an `errors` list, a
    stack with two `workload/*` tags appends one message however many environments it is in,
    and its cells are dropped rather than refused."""
    cells = sorted(
        (
            {"stack": stack, "environment": env}
            for env in envs
            for stack in stacks_by_env.get(env, [])
        ),
        key=lambda c: (c["environment"], c["stack"]),
    )
    workloads = {}
    for c in cells:
        if c["stack"] not in workloads:
            workloads[c["stack"]] = workload_of(
                tags_by_stack.get(c["stack"], []), c["stack"], errors
            )
    cells = [
        {**c, "workload": workloads[c["stack"]]} for c in cells if workloads[c["stack"]] is not None
    ]
    guard_slug_collisions(cells)
    return cells


def cap_cells(cells, all_stacks):
    """`cells`, or `SystemExit` when they exceed the GitHub Actions matrix limit."""
    if len(cells) <= MATRIX_LIMIT:
        return cells
    head = (
        f"::error::{len(cells)} plan cells exceeds the GitHub Actions matrix limit of "
        f"{MATRIX_LIMIT}. "
    )
    if all_stacks:
        raise SystemExit(
            head + "A drift sweep is one matrix; split it across more drift files, each calling "
            "drift.yml with a narrower `tags` query (docs/drift.md)."
        )
    raise SystemExit(
        head + "Split the change across several pull requests -- the matrix is "
        "built over `terramate list --changed`. A one-line edit to a shared local module "
        "correctly marks every dependent stack changed and is one atomic change by nature; "
        "there the only lever is to reduce the number of environments in play."
    )


def select_cells(full, tags_by_stack, query, all_stacks):
    """The cells of `full` a run plans: narrowed by the `tags` query, then capped.

    The first half of the sweep chain, shared by `compute_cells` and onboard's drift-sweep
    item; `check_cells` is the second. A refusal that needs no table belongs in here; it runs
    on every plan, drift and deploy detect and on onboard's drift-sweep item, not only on
    sweeps."""
    return cap_cells(filter_cells(full, tags_by_stack, query), all_stacks)


_ZERO_SHA = "0" * 40
_ENV_TAG_LITERAL = re.compile(f'"env/({ec._ENV_ENTRY.pattern})"')


def _list_stacks(all_stacks, base, tree=None):
    args = ["terramate", *(["-C", tree] if tree else []), "list"]
    if not all_stacks:
        args.append("--changed")
        # github.event.before is the all-zero SHA on a force-push or the first
        # push to a branch; `-B 000...` can't be resolved by git, so omit it
        # (terramate then diffs against its default base) rather than failing.
        if base and base != _ZERO_SHA:
            args += ["-B", base]
    return [s.strip() for s in _run(args).splitlines() if s.strip()]


def merge_base(base, retry="Re-run the workflow"):
    """The merge base of `base` and `HEAD`, which plan detect diffs from, so a branch behind its
    base plans only the stacks its own commits change. Refuses when the two share no history
    (exit 1, no output) with that cause and its remedy, and on any other git failure, such as a
    base missing from the clone, with git's error on one line and `retry` as the remedy.
    """
    # Not `_run`: the refusal depends on git's exit status, which `run` folds into its message.
    # S603/S607: a fixed argv, git from PATH as every other call here.
    args = ["git", "merge-base", base, "HEAD"]  # noqa: S607
    p = subprocess.run(args, capture_output=True, encoding="utf-8", errors="replace")  # noqa: S603
    if p.returncode == 0:
        return p.stdout.strip()
    if p.returncode == 1 and not p.stdout.strip():
        message = (
            f"the pull request's head shares no history with its base {base}, so shipmate "
            "cannot tell which stacks the pull request changes. Rebase the branch onto the "
            "base, or recreate it from the base, and push."
        )
    else:
        lines = [line.strip() for line in p.stderr.splitlines() if line.strip()]
        error = " | ".join(lines) or f"git merge-base exited {p.returncode} with no message"
        message = (
            f"could not resolve the merge base of the pull request's base {base} and its head: "
            f"{error}. {retry}; if it fails again, the base commit is not reachable from this "
            "checkout."
        )
    raise SystemExit("::error::" + message)


# Not a bare `shipmate apply`, which runs no overlap check: the push re-plans and re-dispatches.
_BASE_REMEDY = "Update the branch from the base and push"
# Pinned against repository config so it cannot change which stacks are held. Empty
# `core.attributesFile` also drops XDG attributes; `safe.directory=*` disables the ownership check
# for this step, because isolation drops the runner's exemption.
_MERGE_PINS = (
    *("-c", "merge.renames=true"),  # Also covers the `diff.renames` it falls back to.
    *("-c", "merge.directoryRenames=conflict"),
    *("-c", "merge.renameLimit=32767"),  # 32767 because 0 means git's default limit.
    *("-c", "merge.default=text"),
    *("-c", "core.attributesFile="),
    *("-c", "safe.directory=*"),
)
_MERGE_ENV = {
    "LC_ALL": "C",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_CONFIG_GLOBAL": os.devnull,
    "GIT_ATTR_NOSYSTEM": "1",
}


def _merge_env():
    """merge-tree's environment, which ignores runner global and system config and system
    attributes so none changes which stacks are held. merge-tree runs in the working directory's
    own repository and needs no inherited git variable, so every `GIT_*` one is dropped. A caller
    relying on `GIT_DIR` or `GIT_OBJECT_DIRECTORY` would break the following `commit-tree`, which
    keeps them; none does."""
    return {k: v for k, v in os.environ.items() if not k.startswith("GIT_")} | _MERGE_ENV


def base_changed_stacks(base_ref, candidates):
    """The stacks that the merge of `base_ref` into `HEAD` changes, directly or through a module
    they source, or removes files in, so that a plan of them made on `HEAD` reverts the base's
    change. Terramate's change detection runs once, on that merge (`git merge-tree`), committed
    as a child of `HEAD` and checked out in a detached worktree, against `HEAD`. A base change
    the branch already holds changes nothing in the merge, so it holds no stack; a merged tree
    equal to `HEAD`'s returns before any commit or checkout. A base edit of a file the branch
    renamed is held at the new path, or refused as a conflict when git does not pair the rename
    (modify/delete). Any merge conflict refuses with git's conflict lines before any checkout,
    a file the base added under a directory the branch renamed included, and a base delete of a
    file the branch renamed, or a base rename of it to another path. Nothing is merged when the
    base changed no file since the merge base.

    Terramate lists only stacks the merge still has, so each stack path in `candidates` holding
    a file the merge deletes or renames away from `HEAD`, read from `git diff --name-status`, is
    added. Refuses as `merge_base` does when the merge base cannot be resolved, and on a failed
    diff from the merge base to the base tip; a failed merge step, the diff from `HEAD` to the
    merge included, refuses with its error. A `base_ref` the clone lacks, a tip the
    base gained after the checkout, is fetched from `origin` first; a failed fetch refuses."""
    # S603/S607: fixed argvs, git from PATH as every other call here.
    present = ["git", "cat-file", "-e", f"{base_ref}^{{commit}}"]  # noqa: S607
    if subprocess.run(present, capture_output=True).returncode:  # noqa: S603
        fetch = ["git", "fetch", "--quiet", "--no-tags", "origin", base_ref]  # noqa: S607
        p = subprocess.run(fetch, capture_output=True, encoding="utf-8", errors="replace")  # noqa: S603
        if p.returncode:
            error = " | ".join(x.strip() for x in p.stderr.splitlines() if x.strip())
            raise SystemExit(
                f"::error::could not fetch the base tip {base_ref} ({error or p.returncode}). "
                f"{_BASE_REMEDY}."
            )
    since = merge_base(base_ref, retry=_BASE_REMEDY)
    return _merge_stacks(base_ref, candidates) if _diff_records(since, base_ref) else set()


def _merge_stacks(base_ref, candidates):
    """`base_changed_stacks`' listing and its removed-file stacks: the merge of `base_ref` into
    `HEAD`, committed on `HEAD`, checked out in a detached worktree and listed against `HEAD`.
    A merge conflict refuses with git's conflict lines before the worktree is added, any other
    failure with its error."""
    try:
        head = run(["git", "rev-parse", "HEAD"]).strip()
        # Not `run`: git prints a conflict on stdout.
        # LC_ALL=C: git localizes `CONFLICT`, which the cause is read by.
        merge = ["git", *_MERGE_PINS, "merge-tree", "--write-tree"]
        p = subprocess.run(  # noqa: S603
            [*merge, base_ref, head],
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            env=_merge_env(),
        )
        cause = _merge_tree_failure(p)
        if cause is None:
            merged = p.stdout.split()[0]
            if merged == run(["git", "rev-parse", f"{head}^{{tree}}"]).strip():
                return set()
            ident = ["-c", "user.name=shipmate", "-c", "user.email=shipmate@invalid"]
            commit = ["git", *ident, "-c", "commit.gpgsign=false", "commit-tree", merged]
            sha = run([*commit, "-p", head, "-m", "overlay"]).strip()
            moved = _moved_from(_diff_records(head, sha))
            gone = {s for s in candidates if any(_inside(x, s, candidates) for x in moved)}
            tree = tempfile.mkdtemp(prefix="shipmate-merge-")
            try:
                run(["git", "worktree", "add", "--quiet", "--detach", tree, sha])
            except SystemExit:
                shutil.rmtree(tree, ignore_errors=True)
                raise
            try:
                return set(_list_stacks(False, head, tree)) | gone
            finally:
                run(["git", "worktree", "remove", "--force", tree])
    except (SystemExit, OSError) as e:
        message = str(e.code if isinstance(e, SystemExit) else e).removeprefix("::error::")
        cause = " | ".join(x.strip() for x in message.splitlines()[1:] if x.strip()) or message
    raise SystemExit(
        "::error::change detection on the merge of the base into the branch failed: "
        f"{cause.removesuffix('.')}. {_BASE_REMEDY}."
    )


def _merge_tree_failure(p):
    """The refusal cause of the finished `git merge-tree --write-tree` `p`, or None when it
    printed a tree: its `CONFLICT` lines on exit 1, else its stderr."""
    if not p.returncode:
        return None if p.stdout.split() else "git merge-tree printed no tree"
    lines = [x.strip() for x in p.stdout.splitlines() if x.startswith("CONFLICT")]
    if p.returncode != 1 or not lines:
        lines = [x.strip() for x in p.stderr.splitlines() if x.strip()]
    return " | ".join(lines) or f"git merge-tree exited {p.returncode}"


def _inside(path, stack, stacks):
    """Whether the repository-relative `path` lies in `stack`'s directory. git names no `./`
    prefix, so the root stack `.` holds every path no other stack of `stacks` holds; a path of a
    stack missing from `stacks` counts as the root's, a hold too many, never too few."""
    if stack == ".":
        return not any(path.startswith(f"{s}/") for s in stacks if s != ".")
    return path.startswith(f"{stack}/")


def _diff_records(since, until):
    """`(status letter, path, new path or None)` per record of `git diff --name-status
    --find-renames` between `since` and `until`. `-z`: one NUL-separated field per status and
    path, so no path is quoted; a rename, or a copy under `diff.renames=copies`, carries its old
    path, then its new one."""
    fields = _run(["git", "diff", "-z", "--name-status", "--find-renames", since, until]).split(
        "\0"
    )
    records, i = [], 0
    while i < len(fields) - 1:
        status = fields[i][:1]
        pair = status in ("R", "C")
        records.append((status, fields[i + 1], fields[i + 2] if pair else None))
        i += 3 if pair else 2
    return records


def _moved_from(records):
    """The old paths of the files deleted or renamed in `_diff_records`' `records`. A copy leaves
    its source in place, so it is not counted."""
    return {path for status, path, _ in records if status in ("D", "R")}


_METADATA_STACK = re.compile(r'^stack ("(?:[^"\\]|\\.)*"):$')
_METADATA_TAGS = "\tterramate.stack.tags="


def parse_metadata(text):
    """`{stack: [tags...]}` from `terramate debug show metadata` output, keyed as `terramate
    list` prints paths from the repository root (`stacks/app`; the root stack is `.`).

    Each `stack "<path>":` header opens a stack; its tab-indented `terramate.stack.tags=` line
    holds a JSON list. The header path is quoted with escapes and decodes as JSON (`\\uf022`
    in a header is the character `list` prints raw). A line is a tags line only from its start: a
    `description` holding the same text is a different attribute. A stack with no tags line
    has no key. A header or tags line that does not decode raises `SystemExit` naming it."""
    tags = {}
    stack = None
    for line in text.splitlines():
        try:
            if m := _METADATA_STACK.match(line):
                stack = json.loads(m.group(1)).removeprefix("/") or "."
            elif stack is not None and line.startswith(_METADATA_TAGS):
                tags[stack] = json.loads(line[len(_METADATA_TAGS) :])
        except json.JSONDecodeError:
            raise SystemExit(
                "::error::terramate debug show metadata printed a line that does not parse "
                f"as JSON: {line[:200]!r}."
            ) from None
    return tags


def all_tags():
    """Every stack's tags in one Terramate call, as `parse_metadata` keys them.

    Reading the whole tree costs no availability: a stack's `tags` cannot reference
    `global.*`, and such a reference fails `terramate list` too, so every detect already
    refuses it. A stack whose `globals` fail to evaluate still prints its tags."""
    return parse_metadata(_run(["terramate", "debug", "show", "metadata"]))


def run_graph_deps():
    """The stack dependency graph, parsed. `--label stack.dir` is what makes
    waves.parse_dot's node normalization correct -- its docstring pins the argv
    as contract. A cycle refuses here, so every detect refuses it before any other
    ordering check."""
    deps = wv.parse_dot(_run(["terramate", "experimental", "run-graph", "--label", "stack.dir"]))
    wv.stack_levels(deps)
    return deps


def tags_of(stacks, tag_map=None):
    """`{stack: [tags...]}` for `stacks` from `tag_map`, an `all_tags` map the caller read, or
    from an `all_tags` read when it is None; `SystemExit` naming each stack the metadata has no
    tags for: a default of no tags would read as unmanaged and drop the stack from CI. An empty
    `stacks` reads nothing."""
    if not stacks:
        return {}
    tags = all_tags() if tag_map is None else tag_map
    missing = [s for s in stacks if s not in tags]
    if missing:
        raise SystemExit(
            f"::error::terramate debug show metadata printed no tags for {len(missing)} "
            f"stack(s): {named(missing, UNMANAGED_NAMES)}. Two causes produce this: a working "
            "directory other than the repository root, where `terramate list` prints stack "
            "paths relative to it and the metadata does not; or metadata output this parser "
            "does not read, as after a Terramate version change."
        )
    return {s: tags[s] for s in stacks}


def unmanaged_stacks(tags_by_stack):
    """Sorted stack paths carrying no `env/*` tag: shipmate does not run them (CONTRACT §Tag
    grammar)."""
    return sorted(
        s for s, tags in tags_by_stack.items() if not any(t.startswith("env/") for t in tags)
    )


def lost_env_tags(base, head_envs):
    """`{stack: sorted env names}` for each stack of `head_envs` whose diff from the merge base
    of `base` to `HEAD` removes a line holding a complete tag literal `"env/<name>"`, `<name>`
    in the environment-name charset, from the stack's own Terramate files (`*.tm.hcl` and
    `*.tm` directly in its directory, so a child stack and a `.tf` are out), less the names in
    `head_envs[stack]`, the environments the stack carries at `HEAD`. Stacks with no such name
    are left out. A backend key such as `"env/${global.x}/state"` is not a tag literal.

    A heuristic, paired with the exact head-side fact of which environments each stack
    carries now, so a reformatted or reordered tag line names nothing. A removed comment or
    string holding exactly `"env/<name>"` for an environment the stack does not carry is a
    false positive, which only warns about a stack or a stack / environment pair, never
    refuses.

    `base` must share a merge base with `HEAD`; otherwise the nonzero `git diff` exits the run
    fail-closed through `_run`'s `::error::`.

    One tree-wide `git diff` covers every stack, because a blobless checkout fetches each
    call's blobs lazily, and per-stack pathspecs would grow the command line with the tree. A
    file belongs to the stack whose directory holds it, read from the `diff --git` header; a
    file in no stack's directory is skipped. `--no-renames` keeps a file moved between two
    stacks a removal from the first, as a diff scoped to one stack would show it."""
    if not head_envs:
        return {}
    pathspecs = [":(glob)**/*.tm.hcl", ":(glob)**/*.tm"]
    diff = _run(["git", "diff", "-U0", "--no-renames", f"{base}...HEAD", "--", *pathspecs])
    removed = {}
    stack = None
    for line in diff.splitlines():
        if line.startswith("diff --git "):
            stack = posixpath.dirname(_diff_path(line)) or "."
        elif line.startswith("-") and stack in head_envs:
            removed.setdefault(stack, set()).update(
                m.group(1) for m in _ENV_TAG_LITERAL.finditer(line)
            )
    lost = {}
    for stack, envs in sorted(removed.items()):
        names = sorted(envs - head_envs[stack])
        if names:
            lost[stack] = names
    return lost


def _diff_path(header):
    """The path of a `diff --git a/<path> b/<path>` header from a diff with no renames, so both
    halves are equal; git quotes both, C-style, when the path holds `"`, `\\`, a control
    character or, under the default `core.quotePath`, a non-ASCII byte."""
    rest = header.removeprefix("diff --git ")
    if rest.startswith('"'):
        quoted = rest[3 : 3 + (len(rest) - 8) // 2]
        return codecs.escape_decode(quoted.encode())[0].decode()
    return rest[2 : 2 + (len(rest) - 5) // 2]


def warn_lost_env_tags(all_stacks, base, unmanaged, tree):
    """One `::warning::` naming the `unmanaged` stacks a pull request untagged, then one naming
    each `<stack> / <env>` pair it untagged on a stack of `tree` that keeps another `env/*`
    tag. `tree` is the scan's `[{environment, stack}]` cells, which give each scanned stack's
    environments at `HEAD`. Returns the second warning's pairs, sorted by stack then
    environment, or `None` when skipped: an untagged stack is never among them, so the plan
    comment names no stack twice.

    Plan detect only: deploy-detect's base is the push's `before`, which would warn about the
    same removal again on the merge, and a drift sweep scans the whole tree with no base."""
    if all_stacks or not base or base == _ZERO_SHA:
        return None
    head_envs = {s: set() for s in unmanaged}
    for c in tree:
        head_envs.setdefault(c["stack"], set()).add(c["environment"])
    lost = lost_env_tags(base, head_envs)
    gone = [s for s in unmanaged if s in lost]
    untagged = set(unmanaged)
    if gone:
        print(
            "::warning::"
            + command_data(
                f"{len(gone)} stack(s) lost their last env/* tag in this pull request, so "
                f"shipmate no longer plans or deploys them: {named(gone, UNMANAGED_NAMES)}. If "
                "that is deliberate (CONTRACT.md §Taking a stack out of CI), nothing is wrong; "
                "otherwise restore the tag."
            )
        )
    pairs = [f"{s} / {e}" for s, envs in lost.items() if s not in untagged for e in envs]
    if pairs:
        print(
            "::warning::"
            + command_data(
                f"{len(pairs)} stack / environment pair(s) lost their env/* tag in this pull "
                "request, so shipmate no longer plans or deploys them: "
                f"{named(pairs, UNMANAGED_NAMES)}. If that is deliberate (CONTRACT.md §Taking a "
                "stack out of CI), nothing is wrong; otherwise restore the tag."
            )
        )
    return pairs


def env_membership(all_stacks=False, base="", check_names=True, tag_map=None):
    """({env: [stacks...]}, {stack: [tags...]}) from Terramate tags (CONTRACT tag
    grammar: env/<name>). A stack with no `env/*` tag is unmanaged: it is in the tag map,
    in no environment, and named in one notice scoped to what this call scanned.

    `check_names` refuses an `env/<name>` tag whose name `ec.check_env_name` refuses.
    Terramate accepts `.` and `/` in a tag, and under `layout: folder` or `workspace` no
    table entry need check the name: a stack `c` tagged `env/a.b` and a stack `b.c` tagged
    `env/a` would both render the artifact `plan.a.b.c`. `tag_map` goes to `tags_of`."""
    stacks = _list_stacks(all_stacks, base)
    tags_by_stack = tags_of(stacks, tag_map)
    unmanaged = unmanaged_stacks(tags_by_stack)
    if unmanaged:
        scope = "stack(s)" if all_stacks else "changed stack(s)"
        print(
            "::notice::"
            + command_data(
                f"{len(unmanaged)} {scope} carry no env/* tag and are not managed by "
                f"shipmate: {named(unmanaged, UNMANAGED_NAMES)}"
            )
        )
    stacks_by_env = {}
    for s in stacks:
        for t in tags_by_stack[s]:
            if t.startswith("env/"):
                name = t[len("env/") :]
                if check_names:
                    ec.check_env_name(name, f"stack {s!r} tag 'env/{name}'", "a tag")
                stacks_by_env.setdefault(name, []).append(s)
    return stacks_by_env, tags_by_stack


def tagged_workloads(stacks_by_env, tags_by_stack):
    """`{env: frozenset of the names its stacks' workload/<name> tags carry}`, every env of
    `stacks_by_env` included.

    Not through `workload_of`: its two-tag refusal runs in `full_tree` over the scanned tree's
    managed stacks, before any `tags` filter. An unmanaged stack's workload tags are never
    checked."""
    return {
        env: frozenset(
            t[len("workload/") :]
            for s in stacks
            for t in tags_by_stack.get(s, [])
            if t.startswith("workload/")
        )
        for env, stacks in stacks_by_env.items()
    }


def compute_cells(all_stacks=False, base="", tags="", errors=None, tag_map=None):
    """(`tagged_workloads` of the scan, the cells to plan, the scanned tree's cell names, the
    scan's `unmanaged_stacks`).

    The map is returned beside the cells because a caller that scanned the whole tree feeds it
    to `env_config` as `tagged`, and re-scanning would be a second source that can disagree
    with this one. The tree-wide checks here -- slug collisions, two `workload/*` tags on one
    stack -- run over the whole tree's managed stacks; `tags` narrows only the cells to
    plan, and the matrix limit counts those. The caller's per-cell checks (`check_cells`) see
    only the returned cells.
    The tree is `[{environment, stack}]` in matrix order, uncapped. `errors` is `full_tree`'s.
    `tag_map` goes to `tags_of`."""
    stacks_by_env, tags_by_stack = env_membership(all_stacks, base, tag_map=tag_map)
    full = full_tree(sorted(stacks_by_env), stacks_by_env, tags_by_stack, errors)
    cells = select_cells(full, tags_by_stack, tags, all_stacks)
    tree = [{"environment": c["environment"], "stack": c["stack"]} for c in full]
    return (
        tagged_workloads(stacks_by_env, tags_by_stack),
        cells,
        tree,
        unmanaged_stacks(tags_by_stack),
    )


def env_config(cells, tagged=None, table=None):
    """The validated table for `cells`. One read per detect, not per row.

    `tagged` is the whole-tree `tagged_workloads` scan, which only the unused-entry and
    untagged-workload warnings read; the caller passes it only where it actually scanned the
    whole tree, and `None` otherwise. `table` is a mapping the caller already read from the
    default branch, for a path needing a field of it before its cells exist; passing it here
    is what keeps that path on one read.
    """
    envs = {c["environment"] for c in cells}
    table = ec.read_table() if table is None else table
    return ec.validate(table, envs, tagged=tagged)


def stamp_rows(cells, table, tier):
    """Stamp each row with what the table resolves for it, or `SystemExit`.

    `tier` is the calling detect's path (`plan` or `apply`) and is always passed
    explicitly: one call site serves both tiers, so nothing may infer it. Applied at each
    site that emits rows rather than inside `full_tree`, which stays pure and
    unit-testable. `test_row_stamp_guard.py` pins each site.

    A row whose `env_binding` is not a non-empty string refuses before any caller writes a
    matrix: every cell job binds `environment:` from it, and GitHub binds no environment for
    an empty one, so the cell would run outside every environment control.
    """
    rows = [
        {**cell, **ec.resolve(table, cell["environment"], tier, cell["workload"])} for cell in cells
    ]
    for row in rows:
        binding = row.get("env_binding")
        if not isinstance(binding, str) or not binding:
            raise SystemExit(
                f"::error::{row['stack']} in {row['environment']} resolved env_binding "
                f"{binding!r}, which names no GitHub Environment. A job bound to it would run "
                "outside every environment control, so no matrix is written."
            )
    return rows


def refuse_workload_gaps(rows, table):
    """`SystemExit` naming every row whose `workload/<name>` tag its environment's `workloads`
    list does not name (`env-config`'s `outside_workloads`), in row order. Membership is per
    environment, so the plan and apply paths refuse the same rows.

    Each caller passes only the rows it will run. A completed, excluded or held cell is not
    refused: a table-only change can make an applied cell look misconfigured, and refusing
    over it would strand every pull request that planned it. `test_workload_gap_guard.py`
    pins each call site.
    """
    items = []
    for row in rows:
        env, workload = row["environment"], row["workload"]
        listed = ec.outside_workloads(table, env, workload)
        if listed is not None:
            items.append(
                f"{row['stack']} in {env} (workload/{workload}; {env} lists {', '.join(listed)})"
            )
    if items:
        raise SystemExit(
            f"::error::{len(items)} cell(s) carry a workload tag their environment's workloads "
            f"list does not name: {'; '.join(items)}. A listed workload is the only one the "
            "default branch grants a role to. Retag the stack, or add the workload to "
            f"environments.<env>.workloads in {ec.CONFIG_PATH} on the default branch, which is "
            "where this table is read from: merge it there on its own pull request first."
        )


def check_cells(cells, table):
    """`cells` stamped with the plan tier's resolved fields, after the table's per-cell
    refusals: `stamp_rows`, then `refuse_workload_gaps` over the stamped rows.

    The second half of the sweep chain, shared by `main` and onboard's drift-sweep item;
    `select_cells` is the first. A refusal that reads the table belongs in here; it runs on
    every plan and drift detect and on onboard's drift-sweep item, not only on sweeps."""
    rows = stamp_rows(cells, table, "plan")
    refuse_workload_gaps(rows, table)
    return rows


def fork_pr_error(repository, head_repo, sweep: bool):
    """The `::error::` line rejecting a run this script may not plan, or "" when
    it may.

    A fork's run is handed no secrets, but the plan cell still runs
    `terramate`/`tofu` over the fork's own HCL on the consumer's runners with
    whatever the plan environment exposes as *variables* -- which are not
    secrets and are not withheld. Fork pull requests are not supported at all.

    Loud rather than an empty matrix: the engine plan workflow's `summary` job
    refuses a head repository it was not told about, so a green "nothing to
    plan" would leave an outside contributor waiting on a gate that
    structurally cannot arrive.

    REFUSES BY DEFAULT, keyed on the head repository the WRAPPER states -- not
    on the event name. `github.event_name` cannot express the distinction: the
    drift path already triggers on `schedule` and `workflow_dispatch`, so a
    dispatched plan would be indistinguishable from a manual drift run. A
    caller with no pull-request context (drift) says so explicitly with
    `sweep`; anything else that omits `head-repo` is refused. The
    direction is chosen on failure mode -- a forgotten input on a plan wrapper
    still refuses forks, while a forgotten opt-out on a drift wrapper turns every
    sweep red.

    The stated value is trustworthy against the threat this guards: the caller
    is the consumer's own default-branch workflow, which a pull-request author
    cannot edit. The residual risk is consumer misconfiguration, which is what
    doctor's wiring probe reports.

    Only the bool `True` skips the refusal, here and in the two checks below: a
    caller passing the raw input string would otherwise skip it for "false"."""
    if sweep is True:
        return ""
    head_repo = head_repo.strip()
    if not head_repo:
        return (
            "::error::this run did not state its head repository. The `head-repo` input of "
            "shipmate's `build-matrix` action must be the pull request's head repository full "
            "name (`owner/repo`), so this run can be checked against a fork head. See "
            "`docs/getting-started.md` for the wiring. A workflow with no pull request at all "
            "(a drift sweep) passes `sweep: true` instead."
        )
    if repository and head_repo == repository:
        return ""
    return (
        f"::error::fork pull requests are not supported: this run's stated head repository "
        f"(`{head_repo}`) is not `{repository or 'this repository'}`. Planning it would run "
        "the pull request's own Terramate/OpenTofu code on your runners with your plan "
        "environment's variables, and no `shipmate / gate` status is ever written for a "
        "fork head, so the pull request could not merge either way. Push the branch to "
        "this repository (`gh pr checkout` then push) and open the pull request there."
    )


def head_checkout_error(head_sha, sweep: bool):
    """The `::error::` line refusing a checkout that is not the commit this run
    says it is planning, or "" when it may be planned.

    Keyed on the head SHA the WRAPPER states, like the fork refusal beside it,
    and not on the event name. Both plan triggers check out something else by
    default -- `pull_request_target` the base branch, `workflow_dispatch` the
    dispatch ref -- so a checkout that does not name the head plans a stranger,
    diffs it against the base, comes out with an empty matrix, skips the plan
    job and greens the gate with no pending apply checks, leaving the post-merge
    deploy an empty queue.

    REFUSES BY DEFAULT. A caller with no pull request at all (a drift sweep)
    says so with `sweep`; anything else that omits `head-sha` is
    refused. Same direction and same reason as the fork refusal: a forgotten
    input on a plan wrapper still refuses, while a forgotten opt-out on a drift
    wrapper turns every sweep red.

    No `pull_request` exclusion, even though its default checkout is
    `refs/pull/<n>/merge` and so never equals the payload head: the comparison is
    against the head the wrapper states, and `actions/pr-facts` states the payload
    head under both pull-request events, so a `pull_request` consumer names `ref:`
    like every other one.
    """
    if sweep is True:
        return ""
    head_sha = head_sha.strip()
    if not head_sha:
        return (
            "::error::this run did not state the commit it is planning. The `head-sha` input "
            "of shipmate's `build-matrix` action must be the pull request's head commit, so "
            "this checkout can be checked against it. Wire it to the `head-sha` output of "
            "shipmate's `pr-facts` action; see `docs/getting-started.md`. A workflow with no "
            "pull request at all (a drift sweep) passes `sweep: true` instead."
        )
    checked_out = _run(["git", "rev-parse", "HEAD"]).strip()
    if checked_out == head_sha:
        return ""
    return (
        f"::error::this run checked out {checked_out}, which is not the commit it is planning "
        f"({head_sha}). `actions/checkout` takes the base branch under "
        "`pull_request_target` and the dispatch ref under `workflow_dispatch` unless its "
        "`ref:` names the head SHA. Add it to every checkout in "
        f"`{PLAN_WORKFLOW}`; without it planning diffs the wrong tree against the "
        "base, silently reports no changes, and the gate greens with nothing queued to apply."
    )


def plan_workflow_error(event_name):
    """The `::error::` line refusing a checkout with no consumer workflow file at
    `PLAN_WORKFLOW`, or "" when this run may be planned.

    A sparse checkout would fail this falsely; `detect` needs the whole tree for
    terramate, so that shape does not occur here.
    """
    if event_name not in _PR_EVENTS:
        return ""
    if os.path.isfile(PLAN_WORKFLOW):
        return ""
    return (
        f"::error::this repository has no `{PLAN_WORKFLOW}`, the one path `CONTRACT.md` "
        "lets the consumer's workflow file live at, and this refusal is what enforces it. "
        "That exact filename is matched literally by `shipmate doctor`, whose `shipmate.yml` "
        "probe checks its job name, dispatch wiring, event routing and drift call, and by "
        "`actions/dispatch`, which sends every commented verb to it. A consumer workflow "
        "under any other name draws that probe's could-not-read notice and doctor's own "
        "`pull_request_target` warning, and is reached by no `shipmate` command at "
        f"all. Move the consumer's workflow back to `{PLAN_WORKFLOW}`."
    )


def tag_filter_error(tags, sweep: bool):
    """The `::error::` line refusing a `tags` filter outside a run with no pull
    request, or "" when it may be honoured.

    In a plan job a filter would drop changed stacks from the matrix, and a
    dropped stack gets no plan cell, so no apply check is created, `count` and
    the summary's cell count still agree, the gate greens, and the reviewed
    change merges and never applies."""
    if not tags.strip():
        return ""
    if sweep is True:
        return ""
    return (
        "::error::the `tags` filter is only for a workflow with no pull request at all "
        "(a drift sweep), and this run did not pass `sweep: true`. In a plan "
        "job it would drop changed stacks from the matrix: a dropped stack gets no plan "
        "cell and no apply check, `shipmate / gate` greens over it, and the change merges "
        "and never applies. Remove the input from the plan job."
    )


def main():
    sweep = os.environ.get("SHIPMATE_SWEEP", "") == "true"
    base = os.environ.get("SHIPMATE_BASE_SHA", "")
    event_name = os.environ.get("GITHUB_EVENT_NAME", "")
    tags = os.environ.get("SHIPMATE_TAGS", "")
    # `or`, so the fork refusal precedes the two consumer-wiring checks: a fork
    # head must be turned away before this script shells out or reads its tree.
    rejection = (
        fork_pr_error(
            os.environ.get("GITHUB_REPOSITORY", ""),
            os.environ.get("SHIPMATE_HEAD_REPO", ""),
            sweep,
        )
        or head_checkout_error(os.environ.get("SHIPMATE_HEAD_SHA", ""), sweep)
        or plan_workflow_error(event_name)
        or tag_filter_error(tags, sweep)
    )
    if rejection:
        raise SystemExit(rejection)
    if not sweep and base and base != _ZERO_SHA:
        base = merge_base(base)
    errors = []
    tag_map = all_tags()
    tagged, cells, tree, unmanaged = compute_cells(sweep, base, tags, errors, tag_map)
    with ec._gather(errors):
        # Outside a sweep `tagged` covers the changed stacks alone, so passing it would warn
        # every unchanged environment unused on every plan. The table is checked against
        # `tree`, so a `tags` filter cannot hide an uncovered env.
        table = env_config(tree, tagged if sweep else None)
        cells = check_cells(cells, table)
    if errors:
        raise SystemExit("\n".join(errors))
    order = ec.env_order(table)
    # A pull request that plans no cell can still close a loop.
    if not sweep:
        deps = run_graph_deps()
        present = {(c["stack"], c["environment"]) for c in cells}
        wv.refuse_inversions(cells, present, deps, tag_map, order)
    pairs = warn_lost_env_tags(sweep, base, unmanaged, tree)
    # Before the write: a refusal after `matrix=` would leave a matrix with no cap.
    cap = ec.max_parallel(table)
    hints = ec.command_hints(table)
    named = {"count": len(unmanaged), "paths": unmanaged[:UNMANAGED_NAMES]}
    lost = ""
    if pairs is not None:
        lost = json.dumps({"count": len(pairs), "pairs": pairs[:UNMANAGED_NAMES]})
    write_outputs(
        matrix=json.dumps({"include": cells}),
        empty=not cells,
        count=len(cells),
        max_parallel=cap,
        command_hints=hints,
        cells=json.dumps(tree),
        unmanaged=json.dumps(named),
        lost=lost,
        env_order=json.dumps(wv.env_sequence(order, {c["environment"] for c in cells})),
    )
    listing = ", ".join(f"{c['environment']}/{c['stack']}" for c in cells) or "(none)"
    print(f"{len(cells)} cell(s): {listing}")


if __name__ == "__main__":
    run_annotated(main, refusal_output=True)
