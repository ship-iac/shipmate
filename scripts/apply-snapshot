#!/usr/bin/env python3
"""Map every cell in this run's wave matrices to its App-authored apply-check ids.

Runs BEFORE wave0, in a job that holds no secret: the trailing completer marks
only these ids done, so an apply check created mid-run by a fresh plan is left
pending (its plan was never applied here) instead of being greened. Only checks
authored by the shipmate App are eligible — a forged same-name check from any
other identity is never completed.
"""

import json
import os
import sys

SEP = "\x00"


def _key(stack, env):
    return f"{stack}{SEP}{env}"


def snapshot(waves, check_runs, app_id):
    """{cell key: [check id, ...]} for every cell in this run's waves.

    Every wanted cell must have one. A cell that has none fails the run here,
    before wave0 and so before anything applies. Skipping it would let that
    cell mutate infrastructure with no id for the trailing completer to PATCH:
    its apply check stays pending forever, the gate stays pending with it, and
    a re-run hits the exact-plan stale-plan fail-safe against the state the
    skipped cell already advanced. Failing pre-flight costs the run's other
    waves — and, on the deploy/apply-all paths, the successor env-levels — but
    leaves nothing half-applied, the recoverable direction.
    """
    wanted = [
        (cell["stack"], cell["environment"]) for name in sorted(waves) for cell in waves[name] or []
    ]
    out = {}
    for stack, env in wanted:
        name = f"apply / {stack} / {env}"
        ids = [
            c["id"]
            for c in check_runs
            if c.get("name") == name and ((c.get("app") or {}).get("id")) == app_id
        ]
        if not ids:
            raise SystemExit(
                f"::error::no App-authored apply check named '{name}' on the head "
                "SHA before apply; this cell would apply with nothing to complete "
                "afterwards, stranding its check pending — re-plan."
            )
        out[_key(stack, env)] = ids
    return out


def main():
    raw_app_id = os.environ["SHIPMATE_APP_ID"]
    if not raw_app_id:
        raise SystemExit(
            "::error::SHIPMATE_APP_ID is empty — set the SHIPMATE_APP_ID repo/org "
            "variable to the shipmate App id."
        )
    waves = json.loads(os.environ["SHIPMATE_WAVES_JSON"])
    check_runs = [json.loads(line) for line in sys.stdin if line.strip()]
    json.dump(snapshot(waves, check_runs, int(raw_app_id)), sys.stdout)


if __name__ == "__main__":
    main()
