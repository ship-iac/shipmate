#!/usr/bin/env python3
"""Map every cell in this run's wave matrices to its App-authored apply-check ids.

Runs BEFORE wave0, in a job that holds no secret: the trailing completer marks
only these ids done, so an apply check created mid-run by a fresh plan is left
pending (its plan was never applied here) instead of being greened. Only checks
authored by the shipmate App are eligible — a forged same-name check from any
other identity is never completed.
"""

import json
import os
import sys

SEP = "\x00"


def _key(stack, env):
    return f"{stack}{SEP}{env}"


def snapshot(waves, check_runs, app_id):
    """{cell key: [check id, ...]} for every cell that has one.

    A cell with no App-authored apply check is warned about and left OUT of the
    snapshot rather than failing the run: this runs pre-flight, before wave0, so
    a hard failure here skips every wave -- and, on the deploy/apply-all paths,
    every successor env-level too -- over one bad cell. An excluded cell is
    simply never completed, so its check stays pending, which is the safe
    direction. Only a run in which NO cell has a check fails loudly: that is a
    whole-run signal (wrong head SHA, no plan, the App id misconfigured), not
    one cell's problem.
    """
    wanted = [
        (cell["stack"], cell["environment"]) for name in sorted(waves) for cell in waves[name] or []
    ]
    out = {}
    for stack, env in wanted:
        name = f"apply / {stack} / {env}"
        ids = [
            c["id"]
            for c in check_runs
            if c.get("name") == name and ((c.get("app") or {}).get("id")) == app_id
        ]
        if not ids:
            # stderr, not stdout: this script's stdout IS the snapshot JSON the
            # action captures into a step output.
            print(
                f"::warning::no App-authored apply check named '{name}' on the head "
                "SHA before apply; this cell will apply but its check is left "
                "pending -- re-plan to recover it.",
                file=sys.stderr,
            )
            continue
        out[_key(stack, env)] = ids
    if wanted and not out:
        raise SystemExit(
            "::error::no App-authored apply check exists on the head SHA for any "
            "cell in this run; nothing could be completed — re-plan."
        )
    return out


def main():
    raw_app_id = os.environ["SHIPMATE_APP_ID"]
    if not raw_app_id:
        raise SystemExit(
            "::error::SHIPMATE_APP_ID is empty — set the SHIPMATE_APP_ID repo/org "
            "variable to the shipmate App id."
        )
    waves = json.loads(os.environ["SHIPMATE_WAVES_JSON"])
    check_runs = [json.loads(line) for line in sys.stdin if line.strip()]
    json.dump(snapshot(waves, check_runs, int(raw_app_id)), sys.stdout)


if __name__ == "__main__":
    main()
