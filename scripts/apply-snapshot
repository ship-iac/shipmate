#!/usr/bin/env python3
"""Map every cell in this run's wave matrices to its App-authored apply-check ids.

Runs BEFORE wave0: the completers (each cell's `save`, the level's `complete`) mark only these
ids done, so an apply check created mid-run by a fresh plan is left pending (its plan was never
applied here) instead of being greened. Only checks authored by the shipmate App are eligible —
a forged same-name check from any other identity is never completed — only those not yet
`completed`: a completed same-head duplicate is left alone, since a later write would relink or
retitle it — and only those whose record names the wave row's plan run and plan-text digest, or
an older plan run of the same pull request: a check a newer plan, or a plan that found the cell
behind the base, published after detect is not this run's to complete, while an older plan's
unfinished duplicate is superseded by this apply.
The jobs that run it (`apply-env-level.yml`'s `snapshot`, `apply-run.yml`'s `lock` and
`unflip`) hold the App key and check out no repository content, so no branch content runs beside
the key. `by_wave` slices the snapshot per wave, so each wave's checks are flipped
right before that wave and completed by each cell's `save` job, or by the level's `complete`.
"""

import json
import os
import sys

from _shipmate import _load, decoded, is_pr_number, run_annotated, write_outputs

ag = _load("apply-gate")


def snapshot(waves, check_runs, app_id):
    """{apply check name: [check id, ...]} for every cell in this run's waves, each id a check
    not yet `completed` whose decoded record's `plan_run` and `plan_sha256` equal the wave row's
    `plan_run_id` and `plan_sha256` (`_records`), or whose record names an older plan run of the
    same pull request and is no behind record (`_older`). Only a matching check keeps the cell
    from refusing below.

    Every wanted cell must have one. A cell that has none fails the run here,
    before wave0 and so before anything applies. Skipping it would let that
    cell mutate infrastructure with no id for a completer to PATCH:
    its apply check stays pending forever, the gate stays pending with it, and
    a re-run hits the exact-plan stale-plan fail-safe against the state the
    skipped cell already advanced. Failing pre-flight costs the run's other
    waves — and, on the deploy and bare-apply paths, the successor env-levels — but
    leaves nothing half-applied, the recoverable direction.
    """
    runs = ag.from_app(check_runs, app_id)
    wanted = [cell for name in sorted(waves) for cell in waves[name] or []]
    out = {}
    for cell in wanted:
        name = ag.check_name(cell["stack"], cell["environment"])
        plan = (cell.get("plan_run_id"), cell.get("plan_sha256"))
        unfinished = [
            (c["id"], decoded(c) or {})
            for c in runs
            if c.get("name") == name and c.get("status") != "completed"
        ]
        own = next((r for _, r in unfinished if _records(r, plan)), None)
        if own is None:
            raise SystemExit(
                f"::error::no App-authored apply check named '{name}' that is not yet "
                f"completed and records plan run {plan[0]} with its plan-text digest on the head "
                "SHA before apply; this cell would apply with nothing to complete afterwards, "
                "stranding its check pending. Re-plan."
            )
        out[name] = [cid for cid, r in unfinished if _records(r, plan) or _older(r, own)]
    return out


def _records(record, plan):
    """Whether decoded `record` names `plan`, a `(plan run, plan-text digest)` pair of non-empty
    strings."""
    return all(plan) and (record.get("plan_run"), record.get("plan_sha256")) == plan


def _older(record, own):
    """Whether decoded `record` names a lower plan run than the matching record `own`, the same
    pull request as `own`'s `pr` (a number `is_pr_number` accepts), and is no behind record
    (`behind` exactly `True`)."""
    recorded, bound, pr = ag._plan_run(record), ag._plan_run(own), own.get("pr")
    return (
        recorded is not None
        and bound is not None
        and int(recorded) < int(bound)
        and isinstance(pr, str)
        and is_pr_number(pr)
        and record.get("pr") == pr
        and record.get("behind") is not True
    )


def by_wave(waves, snap):
    """{wave key: {apply check name: [check id, ...]}} for every key of `waves`, `{}` for an
    empty wave."""
    return {
        key: {
            name: snap[name]
            for name in (ag.check_name(c["stack"], c["environment"]) for c in waves[key] or [])
        }
        for key in sorted(waves)
    }


def main():
    """Write output `by_wave` to `GITHUB_OUTPUT`, from `SHIPMATE_WAVES_JSON`,
    `SHIPMATE_APP_ID` (an empty one refuses first) and the check runs on stdin."""
    app_id = os.environ["SHIPMATE_APP_ID"]
    # Refuses an empty id before the waves or the listing are parsed, so a misconfiguration is
    # reported first.
    ag.from_app([], app_id)
    waves = json.loads(os.environ["SHIPMATE_WAVES_JSON"])
    snap = snapshot(waves, ag.parse_jsonl(sys.stdin), app_id)
    write_outputs(by_wave=json.dumps(by_wave(waves, snap)))


if __name__ == "__main__":
    run_annotated(main, refusal_output=True, usage="apply-snapshot")
