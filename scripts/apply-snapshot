#!/usr/bin/env python3
"""Map every cell in this run's wave matrices to its App-authored apply-check ids.

Runs BEFORE wave0: the trailing completer marks only these ids done, so an apply check
created mid-run by a fresh plan is left pending (its plan was never applied here) instead of
being greened. Only checks authored by the shipmate App are eligible — a forged same-name
check from any other identity is never completed. The `snapshot` job holds the App key and
checks out no repository content, so no branch content runs beside the key. `by_wave` slices
the snapshot per wave, so each wave's checks complete right after that wave.
"""

import json
import os
import sys

from _shipmate import _load, run_annotated, write_outputs

ag = _load("apply-gate")


def snapshot(waves, check_runs, app_id):
    """{apply check name: [check id, ...]} for every cell in this run's waves.

    Every wanted cell must have one. A cell that has none fails the run here,
    before wave0 and so before anything applies. Skipping it would let that
    cell mutate infrastructure with no id for the trailing completer to PATCH:
    its apply check stays pending forever, the gate stays pending with it, and
    a re-run hits the exact-plan stale-plan fail-safe against the state the
    skipped cell already advanced. Failing pre-flight costs the run's other
    waves — and, on the deploy and bare-apply paths, the successor env-levels — but
    leaves nothing half-applied, the recoverable direction.
    """
    runs = ag.from_app(check_runs, app_id)
    wanted = [
        (cell["stack"], cell["environment"]) for name in sorted(waves) for cell in waves[name] or []
    ]
    out = {}
    for stack, env in wanted:
        name = ag.check_name(stack, env)
        ids = [c["id"] for c in runs if c.get("name") == name]
        if not ids:
            raise SystemExit(
                f"::error::no App-authored apply check named '{name}' on the head "
                "SHA before apply; this cell would apply with nothing to complete "
                "afterwards, stranding its check pending. Re-plan."
            )
        out[name] = ids
    return out


def by_wave(waves, snap):
    """{wave key: {apply check name: [check id, ...]}} for every key of `waves`, `{}` for an
    empty wave."""
    return {
        key: {
            name: snap[name]
            for name in (ag.check_name(c["stack"], c["environment"]) for c in waves[key] or [])
        }
        for key in sorted(waves)
    }


def main(argv=()):
    """Write outputs `snapshot` and `by_wave` to `GITHUB_OUTPUT`, from `SHIPMATE_WAVES_JSON`,
    `SHIPMATE_APP_ID` (an empty one refuses first) and the check runs on stdin."""
    if argv:
        raise SystemExit("::error::usage: apply-snapshot")
    app_id = os.environ["SHIPMATE_APP_ID"]
    # Refuses an empty id before the waves or the listing are parsed, so a misconfiguration is
    # reported first.
    ag.from_app([], app_id)
    waves = json.loads(os.environ["SHIPMATE_WAVES_JSON"])
    snap = snapshot(waves, ag.parse_jsonl(sys.stdin), app_id)
    write_outputs(snapshot=json.dumps(snap), by_wave=json.dumps(by_wave(waves, snap)))


if __name__ == "__main__":
    run_annotated(main, sys.argv[1:])
