#!/usr/bin/env python3
"""Author drift Issues from every drift-cell's uploaded cell.json.

Runs from the drift workflow's trusted trailing `issues` job -- the only place
on the drift path that mints the App key. `drift-cell` touches no Issue: a plan
environment must stay policy-free for planning to work at all, so a job naming
one is reachable from a feature branch, and the credentialed work lives here so a
compromised drift-cell run cannot open, close or comment on an Issue.

One cell's failure -- a rate limit, a transient 5xx -- must not abandon every
later cell: a stack that has gone clean would otherwise keep an open Issue
claiming it drifts. Failures are collected here and the run exits nonzero at the
end naming every cell that failed.

A cell whose plan attempt itself did not succeed (`plan_ok` false -- state
restore or `terramate plan` failed, or the composite action aborted before
`Compose cell summary` could read a real classification) is skipped entirely:
it says nothing reliable about drift, so an existing open Issue for that
stack x env is left untouched rather than being auto-closed as if the
environment were clean.

An open Issue titled `drift: ` that names no cell of this run's matrix is
closed: its stack or environment left the drift sweep. The matrix, passed in
`SHIPMATE_MATRIX_CELLS`, says which cells exist, not the loaded artifacts -- a
lost artifact or a cell job that died before uploading must not read as a
removed cell. An unset, unparseable or empty matrix is refused before any Issue
call, since an empty "present" set would close every drift Issue.
"""

import functools
import json
import os
import subprocess

from _shipmate import _load, cell_summaries, current_run_url

_run = _load("build-matrix")._run

CELL_KEYS = (
    "stack",
    "environment",
    "plan_ok",
    "drifted",
    "add",
    "change",
    "destroy",
)

LABEL = "drift"
PREFIX = "drift: "


def load_cells(cells_dir):
    """[cell, ...] from every downloaded `drift-summary.*/cell.json`, sorted
    for a deterministic run order. A cell.json missing a schema key is
    drift-cell/this-script pin skew -- fail loud rather than silently drop a
    stack x env's drift state."""
    skew = "-- drift-cell and this script must be pinned at the same engine SHA"
    return [cell for _, cell in cell_summaries(cells_dir, CELL_KEYS, skew)]


def matrix_titles():
    """The Issue title of every cell in this run's matrix, from `SHIPMATE_MATRIX_CELLS`.
    Refuses an unset, unparseable or empty value: every open drift Issue would read as
    naming a removed cell and be closed."""
    raw = os.environ.get("SHIPMATE_MATRIX_CELLS", "")
    try:
        cells = json.loads(raw)
    except ValueError:
        cells = None
    if not isinstance(cells, list) or not cells:
        raise SystemExit(
            "::error::drift-issues needs the drift matrix's cells as a non-empty JSON list "
            f"in SHIPMATE_MATRIX_CELLS, got {raw!r}"
        )
    return {_title(cell) for cell in cells}


def open_issues():
    """[{number, title}, ...] for every OPEN issue labelled `drift` -- one list call
    for the whole run, not one per cell. --limit caps how many are scanned,
    kept well above the realistic count of simultaneously-drifting stack x
    envs so an existing issue is never missed (which would open a duplicate)."""
    return json.loads(
        _run(
            [
                "gh",
                "issue",
                "list",
                "--label",
                LABEL,
                "--state",
                "open",
                "--limit",
                "1000",
                "--json",
                "number,title",
            ]
        )
    )


def existing_issue_numbers(rows):
    """{title: number} over `open_issues()` rows.

    The LOWEST number wins when two open issues share a title, because gh
    guarantees no particular listing order. Picking arbitrarily would leave the
    other one unreachable by title lookup: never edited, and closed only once its
    cell leaves the drift sweep."""
    out = {}
    for row in rows:
        title, number = row["title"], row["number"]
        if title not in out or number < out[title]:
            out[title] = number
    return out


def _title(cell):
    return f"{PREFIX}{cell['environment']} / {cell['stack']}"


def _body(cell, run_url):
    return (
        f"Drift detected in `{cell['stack']}` @ `{cell['environment']}`: "
        f"+{cell['add']} ~{cell['change']} -{cell['destroy']}. [Drift run]({run_url}) "
        "-- plan output is in that run's log. "
        "Auto-closed on the next clean drift run of this stack and environment, "
        "or when the stack or environment leaves the drift sweep."
    )


@functools.cache
def _ensure_label():
    # Best-effort: the label may already exist. Not run through `_run` (which
    # would fail the whole job on the common "already exists" case).
    args = ["gh", "label", "create", LABEL, "--color", "FBCA04"]  # noqa: S607
    args += ["--description", "shipmate drift", "--force"]
    subprocess.run(args, capture_output=True, text=True)  # noqa: S603


def upsert_or_close(cell, existing, run_url):
    """Create, update or close this cell's Issue."""
    if not cell["plan_ok"]:
        return
    title = _title(cell)
    number = existing.get(title)
    if cell["drifted"]:
        body = _body(cell, run_url)
        if number is not None:
            _run(["gh", "issue", "edit", str(number), "--body", body])
        else:
            _ensure_label()
            _run(["gh", "issue", "create", "--title", title, "--label", LABEL, "--body", body])
    elif number is not None:
        resolved = f"Drift resolved -- clean plan for {cell['environment']} / {cell['stack']}."
        _run(["gh", "issue", "close", str(number), "--comment", resolved])


def main():
    cells = load_cells(os.environ.get("SHIPMATE_CELLS_DIR", "drift"))
    print(f"loaded {len(cells)} drift cell summaries")
    present = matrix_titles()
    url = current_run_url()
    rows = open_issues()
    existing = existing_issue_numbers(rows)
    # Failures are collected here, not raised: one cell's failure must not abandon the rest,
    # and the run still exits nonzero at the end. The module docstring says why.
    failed = []
    for cell in cells:
        label = f"{cell['environment']} / {cell['stack']}"
        try:
            upsert_or_close(cell, existing, url)
        except SystemExit as exc:
            print(f"::error::drift issue update failed for {label}: {exc}")
            failed.append(label)
    # The raw rows, not `existing`, so every duplicate-titled Issue of a removed cell closes.
    for row in rows:
        title = row["title"]
        if not title.startswith(PREFIX) or title in present:
            continue
        label = title.removeprefix(PREFIX)
        comment = (
            f"`{label}` left the drift sweep: [drift run]({url}) has no such stack and environment."
        )
        try:
            _run(["gh", "issue", "close", str(row["number"]), "--comment", comment])
        except SystemExit as exc:
            print(f"::error::drift issue update failed for {label}: {exc}")
            failed.append(label)
    if failed:
        raise SystemExit("::error::drift reporting failed for: " + "; ".join(failed))


if __name__ == "__main__":
    main()
