#!/usr/bin/env python3
"""Author drift Issues from every drift-cell's uploaded cell.json, and notify
Slack once per drifted cell.

Runs from the drift workflow's trusted trailing `issues` job -- the only place
on the drift path that mints the App key. `drift-cell` touches no Issue and no
Slack webhook: a plan environment must stay policy-free for planning to work at
all, so a job naming one is reachable from a feature branch, and the credentialed
work lives here so a compromised drift-cell run cannot open, close or comment on
an Issue.

One cell's failure -- a rate limit, a transient 5xx, a rejected webhook -- must
not abandon every later cell: a stack that has gone clean would otherwise keep an
open Issue claiming it drifts. The per-cell jobs this batch replaced isolated such
a failure to one cell, and their `curl --fail-with-body` step failed the job on a
rejected webhook, so failures are collected here and the run exits nonzero at the
end naming every cell that failed -- Slack failures included, because a revoked or
rotated URL must not leave every nightly run green while no notification reaches
anyone.

A cell whose plan attempt itself did not succeed (`plan_ok` false -- state
restore or `terramate plan` failed, or the composite action aborted before
`Compose cell summary` could read a real classification) is skipped entirely:
it says nothing reliable about drift, so an existing open Issue for that
stack x env is left untouched rather than being auto-closed as if the
environment were clean.
"""

import glob
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

CELL_KEYS = (
    "stack",
    "stack_name",
    "environment",
    "plan_ok",
    "drifted",
    "add",
    "change",
    "destroy",
)

LABEL = "drift"


def _run(args):
    # args is a code-controlled `gh` invocation (never user input), shell=False -- safe.
    p = subprocess.run(args, capture_output=True, text=True)  # noqa: S603
    if p.returncode != 0:
        sys.stderr.write(p.stderr)
        raise SystemExit(f"::error::command failed ({p.returncode}): {' '.join(args)}")
    return p.stdout


def load_cells(cells_dir):
    """[cell, ...] from every downloaded `drift-summary.*/cell.json`, sorted
    for a deterministic run order. A cell.json missing a schema key is
    drift-cell/this-script pin skew -- fail loud rather than silently drop a
    stack x env's drift state."""
    out = []
    for p in sorted(glob.glob(os.path.join(cells_dir, "**", "cell.json"), recursive=True)):
        with open(p, encoding="utf-8") as fh:
            cell = json.load(fh)
        missing = [k for k in CELL_KEYS if k not in cell]
        if missing:
            raise SystemExit(
                f"::error::cell summary {p} missing keys {missing} -- drift-cell and "
                "this script must be pinned at the same engine SHA"
            )
        out.append(cell)
    return out


def existing_issue_numbers():
    """{title: number} for every OPEN issue labelled `drift` -- one list call
    for the whole run, not one per cell. --limit caps how many are scanned,
    kept well above the realistic count of simultaneously-drifting stack x
    envs so an existing issue is never missed (which would open a duplicate).

    The LOWEST number wins when two open issues share a title, because gh
    guarantees no particular listing order. Picking arbitrarily would leave the
    other one permanently unreachable by title lookup -- never edited, never
    auto-closed."""
    rows = json.loads(
        _run(
            [
                "gh",
                "issue",
                "list",
                "--label",
                LABEL,
                "--state",
                "open",
                "--limit",
                "1000",
                "--json",
                "number,title",
            ]
        )
    )
    out = {}
    for row in rows:
        title, number = row["title"], row["number"]
        if title not in out or number < out[title]:
            out[title] = number
    return out


def _title(cell):
    return f"drift: {cell['environment']} / {cell['stack_name']}"


def _body(cell, run_url):
    return (
        f"Drift detected in `{cell['stack_name']}` @ `{cell['environment']}`: "
        f"+{cell['add']} ~{cell['change']} -{cell['destroy']}. [Drift run]({run_url}) "
        "-- plan output is in that run's log. "
        "Auto-closed on the next clean drift run that covers this stack and environment."
    )


def _ensure_label(created):
    if created[0]:
        return
    # Best-effort: the label may already exist. Not run through `_run` (which
    # would fail the whole job on the common "already exists" case).
    args = ["gh", "label", "create", LABEL, "--color", "FBCA04"]  # noqa: S607
    args += ["--description", "shipmate drift", "--force"]
    subprocess.run(args, capture_output=True, text=True)  # noqa: S603
    created[0] = True


def upsert_or_close(cell, existing, run_url, label_created):
    """Create, update or close this cell's Issue. Returns True when the cell is
    drifted and its Issue carries a fresh body -- the Slack-notify signal."""
    if not cell["plan_ok"]:
        return False
    title = _title(cell)
    number = existing.get(title)
    if cell["drifted"]:
        body = _body(cell, run_url)
        if number is not None:
            _run(["gh", "issue", "edit", str(number), "--body", body])
        else:
            _ensure_label(label_created)
            _run(["gh", "issue", "create", "--title", title, "--label", LABEL, "--body", body])
        return True
    if number is not None:
        resolved = f"Drift resolved -- clean plan for {cell['environment']} / {cell['stack_name']}."
        _run(["gh", "issue", "close", str(number), "--comment", resolved])
    return False


def notify_slack(webhook, cell):
    payload = json.dumps(
        {"text": f":ocean: drift detected: {cell['environment']} / {cell['stack_name']}"}
    ).encode()
    # webhook is a fixed repo/org variable (a GitHub Environment var this
    # action's caller supplies), never user input -- not an arbitrary scheme
    # (create-github-app-token/gh already require https endpoints throughout
    # this codebase).
    req = urllib.request.Request(  # noqa: S310
        webhook, data=payload, headers={"Content-Type": "application/json"}, method="POST"
    )
    with urllib.request.urlopen(req, timeout=10) as resp:  # noqa: S310
        resp.read()


def main():
    cells = load_cells(os.environ.get("SHIPMATE_CELLS_DIR", "drift"))
    if not cells:
        return
    run_url = (
        f"{os.environ['GITHUB_SERVER_URL']}/{os.environ['GITHUB_REPOSITORY']}"
        f"/actions/runs/{os.environ['GITHUB_RUN_ID']}"
    )
    existing = existing_issue_numbers()
    webhook = os.environ.get("SHIPMATE_SLACK_WEBHOOK", "")
    label_created = [False]
    # Failures are collected here, not raised: one cell's failure must not abandon the rest,
    # and the run still exits nonzero at the end. The module docstring says why, per kind.
    failed = []
    for cell in cells:
        label = f"{cell['environment']} / {cell['stack_name']}"
        try:
            drifted_now = upsert_or_close(cell, existing, run_url, label_created)
        except SystemExit as exc:
            print(f"::error::drift issue update failed for {label}: {exc}")
            failed.append(label)
            continue
        if drifted_now and webhook:
            try:
                notify_slack(webhook, cell)
            except (urllib.error.URLError, TimeoutError) as exc:
                print(f"::error::slack notify failed for {label}: {exc}")
                failed.append(label)
    if failed:
        raise SystemExit("::error::drift reporting failed for: " + "; ".join(failed))


if __name__ == "__main__":
    main()
