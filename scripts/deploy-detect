#!/usr/bin/env python3
"""deploy.yml detect: merge commit -> PR head SHA -> pending applies -> waves.

Exact-plan / fail-safe model: the work set is the merged PR's changed stacks
whose apply check is still pending (completed = applied pre-merge, or
no-change). No 'last deployed ref' diff — pending checks ARE the queue, and
each cell applies from the plan run its own apply check records.

This is the path with no comment, no dispatch inputs and no operator watching, so
a pending cell whose check records no plan run refuses the whole run — a default
would apply it from nowhere and a skip would leave its check pending with nothing
said. Every pending cell here is also runnable: this path holds nothing back, unlike
the bare-apply path's targeted and held envs. It refuses the whole run instead in two more
cases. A pending cell that `after` runs behind a pending cell `needs` puts on a later env-level
has no order that meets both. A pending cell another pull request locks refuses too;
CONTRACT.md §Cell locks gives the reason.

It also writes `warm`, the provider cache warm-up matrix (`warm_cells`), which never refuses.
"""

import json
import os
import sys
import time
from urllib.parse import quote

from _shipmate import (
    StackCycle,
    _load,
    command_data,
    deploy_lock_remedy,
    lock_who,
    run_annotated,
    validate_head_sha,
    write_outputs,
)
from _shipmate import gh_json as _gh_json

bm = _load("build-matrix")
wv = _load("waves")
# No apply-gate load of its own: the App-scoped "already applied" query is
# ad.ag.app_done_names, and test_detect_app_scoping pins this script to it.
ad = _load("apply-detect")
pck = _load("provider-cache-key")


def _merged_head(repo, merge_sha, branch, _attempts=3, _sleep=2):
    """Map a merge commit -> (head SHA, number) of the PR it merged.

    Reviewed .otplan artifacts and apply checks live on the PR head, not on main.
    Edge cases handled: (1) `commits/{sha}/pulls` can transiently return [] for a
    few seconds after the push (association indexing lag) — retry before falling
    back; (2) a commit may be associated with more than one PR — pick the one
    this commit actually merged (merge_commit_sha == merge_sha), which GitHub sets
    to the commit the branch moved to for a merge commit, a squash and a rebase;
    (3) a non-empty answer with no such PR maps to no PR (a listed PR's plans
    would apply more or other than the branch holds): head = merge_sha and the
    number is empty, at once, with a warning naming the listed PRs.

    When every attempt returns [], one page of the 100 most recently updated closed pull
    requests into `branch` is read, and only a pull request with `merge_commit_sha ==
    merge_sha` and `merged_at` set is taken: GitHub fills `merge_commit_sha` with the
    test-merge commit on a closed unmerged pull request. A merge older than that page is not
    found. Each poll and the listing are reads of their own through `gh_json`, which retries a
    transient failure; any other failure raises. With no match it returns `(merge_sha, "")`.
    Each warning goes to stderr, flushed so it precedes a refusal in the log.
    """
    for attempt in range(_attempts):
        pulls = _gh_json(f"repos/{repo}/commits/{merge_sha}/pulls")
        if pulls:
            pull = next((p for p in pulls if p.get("merge_commit_sha") == merge_sha), None)
            if pull:
                return pull["head"]["sha"], str(pull["number"])
            listed = ", ".join(f"#{p['number']}" for p in pulls)
            verb = "contains" if len(pulls) == 1 else "contain"
            return _push(
                f"could not map {merge_sha} to the pull request that merged it: {listed} {verb} "
                f"it but none records it as its merge commit; deploying it as a push to {branch}",
                merge_sha,
            )
        if attempt < _attempts - 1:
            time.sleep(_sleep)
    path = (
        f"repos/{repo}/pulls?state=closed&base={quote(branch, safe='')}"
        "&sort=updated&direction=desc&per_page=100"
    )
    closed = _gh_json(path)
    for p in closed:
        if p.get("merge_commit_sha") == merge_sha and p.get("merged_at"):
            return p["head"]["sha"], str(p["number"])
    return _push(
        f"could not map {merge_sha} to a merged pull request (commits/{merge_sha}/pulls stayed "
        "empty and no recently closed pull request records it as its merge commit); deploying "
        f"it as a push to {branch}",
        merge_sha,
    )


def _push(warning, merge_sha):
    """Write `warning` to stderr and return `merge_sha` as a push with no pull request."""
    sys.stderr.write(f"::warning::{command_data(warning)}\n")
    sys.stderr.flush()
    return merge_sha, ""


def refuse_stranded_checks(tree, unmanaged, open_names, pending):
    """Refuse each open apply check of a stack this scan covers (a stack of a `tree` cell, or
    `unmanaged`) whose `(stack, env)` is no `tree` cell: the stack lost that `env/*` tag on
    the default branch after its pull request was planned, so no cell carries its reviewed
    change and nothing else would ever complete the check. The gate fails closed.

    A check of a stack absent from the scan is skipped silently, for one of two causes. This
    merge's diff did not touch the stack, because an identical change landed first: a correct
    skip. Or the stack is no longer a stack at the merge commit, deleted on the default branch
    after planning: its check strands with nothing said. The deploy does not refuse that case,
    because no remedy exists for a deleted stack.

    The refusal applies nothing, so the message also names every `pending` cell as
    `<stack> / <env>`, with an apply check or without: those stay unapplied too, and the
    remedy pull request must change their stacks as well.

    A check names its env only in its name, and after the merge no env set holds the one a
    stack lost (under `folder` or `workspace` a table may declare none), so the env is read
    back with `parse_check_name`, taken only when it is an env name."""
    cells = {(c["stack"], c["environment"]) for c in tree}
    scanned = {s for s, _ in cells} | set(unmanaged)
    stranded = [
        name
        for name in open_names
        for stack, env in [ad.ag.parse_check_name(name)]
        if stack in scanned and bm.ec.is_env_name(env) and (stack, env) not in cells
    ]
    if not stranded:
        return
    others = sorted(f"{c['stack']} / {c['environment']}" for c in pending)
    also = (
        f" This deploy applies nothing, so these other cells of this merge are not applied "
        f"either: {', '.join(others)}."
        if others
        else ""
    )
    raise SystemExit(
        f"::error::deploy aborted: {', '.join(sorted(stranded))}: the stack of each lost its "
        "env/* tag after this pull request was planned, so its reviewed change was not "
        f"applied.{also} Open a new pull request that retags each stranded stack and changes "
        "every other listed stack (any edit that `terramate list --changed` marks, such as a "
        "comment line). It plans the current default branch for all of them, this merged "
        "change included, and its cells are applied before merge under a required gate "
        "(`shipmate apply`, and `shipmate apply <env>` for a `targeted` environment), or by "
        "its deploy otherwise. If an untag was deliberate, apply that stranded "
        "change by hand instead of retagging; the pull request still changes every listed "
        "stack, and with none listed no pull request is needed. Re-running this deploy checks "
        "out the same commit and refuses again. This deploy's apply checks are never read "
        "again and stay open on the merged pull request."
    )


def refuse_locked(repo, pending, pr_number):
    """Refuse the whole run when another pull request holds the lock of a `pending` cell; a
    push that merged no pull request passes `0`, which no pull request holds. Writes
    `refused_locked=true` first, so the lock release also drops the merged pull request's
    locks on pending cells. A failed lock read refuses through `locked_cells`."""
    locked = ad.locked_cells(repo, pending, pr_number)
    if not locked:
        return
    write_outputs(refused_locked=True)
    held = sorted((f"{c['stack']} / {c['environment']}", lock_who(c["holder"])) for c in locked)
    cells = sorted(f"{c['stack']} / {c['environment']}" for c in pending)
    remedy = deploy_lock_remedy([(c["holder"], c["environment"]) for c in locked], "these stacks")
    raise SystemExit(
        f"::error::deploy refused: {len(held)} pending cell(s) are locked by another pull "
        f"request: {', '.join(f'{k} (locked by {who})' for k, who in held)}. None of this "
        f"deploy's {len(cells)} pending cell(s) were applied: {', '.join(cells)}. {remedy}."
    )


def refuse_inversions(pending, order, deps, tag_map):
    """Refuse when a pending cell runs after a pending cell `needs` puts on a later env-level.

    Every pending cell of the merge is in the run, so none waits; the refusal applies
    nothing, and the message names every pending cell. A re-run reads `needs` from the
    default branch but tags and `after` from this commit, so a `needs` fix needs only a
    re-run and a fix to tags or `after` needs a new pull request."""
    present = {(c["stack"], c["environment"]) for c in pending}
    cells = ", ".join(sorted(f"{s} / {e}" for s, e in present))
    wv.refuse_inversions(
        pending,
        present,
        deps,
        tag_map,
        order,
        remedy=f"This deploy applies nothing, so none of these cells of this merge is "
        f"applied: {cells}. A fix by `needs`: merge it, then re-run this deploy, which reads "
        "`needs` from the default branch and applies these cells. A fix to tags or `after`: "
        "both live in this merged commit, so a re-run refuses again; open a new pull request "
        "that makes the fix and changes every listed stack (any edit `terramate list "
        "--changed` marks); its cells are applied before merge under a required gate "
        "(`shipmate apply`, and `shipmate apply <env>` for a `targeted` environment), or by "
        "its deploy otherwise.",
    )


def run_graph_deps(pending):
    """`bm.run_graph_deps()`. A stack ordering cycle refuses with the plan's message, then the
    `pending` cells, which the refusal leaves unapplied, when there are any, then the
    troubleshooting entry that holds the remedy."""
    try:
        return bm.run_graph_deps()
    except StackCycle as e:
        cells = ", ".join(sorted(f"{c['stack']} / {c['environment']}" for c in pending))
        listed = f"; pending on this merge: {cells}" if cells else ""
        raise SystemExit(
            f"{e.code.removesuffix('.')}{listed}; see `stack ordering cycle through <stacks>` "
            "in docs/troubleshooting.md."
        ) from e


def warm_cells(tag_map, table):
    """One `{stack, environment, tf_vars}` row per distinct provider lock digest
    (`provider-cache-key`'s) over every managed stack of `tag_map`, changed or not, for
    `deploy.yml`'s `warm` matrix: a stack with an `env/*` tag and no `LOCAL_TAG`, so one a cell
    can run. A stack whose lock yields no digest is left out. Each digest's row is its first
    stack in path order, at that stack's first environment by name, with the `tf_vars` `table`
    resolves for it. Capped at the matrix limit."""
    rows = {}
    for stack in sorted(tag_map):
        tags = tag_map[stack]
        envs = sorted(t[len("env/") :] for t in tags if t.startswith("env/"))
        if not envs or bm.LOCAL_TAG in tags:
            continue
        found = pck.lock_digest(stack)
        if found and found not in rows:
            tf_vars = bm.ec.resolve(table, envs[0], "apply", "")["tf_vars"]
            rows[found] = {"stack": stack, "environment": envs[0], "tf_vars": tf_vars}
    return list(rows.values())[: bm.MATRIX_LIMIT]


def warm_or_none(tag_map, table):
    """`warm_cells`, or `[]` after a warning when it raises. A degrade: `warm` only fills the
    provider cache, so a failure here must not refuse the deploy."""
    try:
        return warm_cells(tag_map, table)
    except Exception as e:
        sys.stderr.write(f"::warning::{command_data(f'no provider cache warm-up: {e}')}\n")
        return []


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    merge_sha = os.environ["GITHUB_SHA"]
    branch = os.environ["GITHUB_REF_NAME"]
    head, pr_number = _merged_head(repo, merge_sha, branch)
    validate_head_sha(
        head,
        "the deploy's head SHA (the merged pull request's head from "
        f"commits/{merge_sha}/pulls or the closed pull requests of {branch}, else GITHUB_SHA)",
    )
    # Before any refusal past head validation, so a refused deploy's summary can write the gate's
    # failure on the head.
    # Hyphen-free: `steps.d.outputs.head-sha` parses the '-' as subtraction.
    write_outputs(head_sha=head, pr_number=pr_number)
    # `all_stacks=False`: the map covers the changed stacks alone and is no evidence that
    # an environment is unused or a workload untagged, so both warnings stay silent here.
    tag_map = bm.all_tags()
    _, cells, tree, scanned, _ = bm.compute_cells(
        all_stacks=False, base=os.environ.get("SHIPMATE_BASE_SHA", ""), tag_map=tag_map
    )
    table = bm.env_config(cells)
    cells = bm.stamp_rows(cells, table, "apply")
    app_id = os.environ["SHIPMATE_APP_ID"]
    # One listing answers both questions: which cells are already applied, and which plan
    # run each remaining one applies from. A re-plan landing between two reads makes them
    # disagree — the name leaves `completed` and its cell re-queues on the earlier record.
    lines = ad._check_run_lines(repo, head)
    completed = ad.ag.app_done_names(lines, app_id)
    pending = ad.filter_pending(cells, completed)
    refuse_locked(repo, pending, pr_number or 0)
    # `scanned` includes local stacks on purpose: a stack moved to `shipmate/local` with an
    # open apply check must still refuse. Guard test:
    # test_main_refuses_a_pending_apply_check_on_a_stack_moved_to_local.
    refuse_stranded_checks(tree, scanned, ad.apply_check_names(lines, app_id) - completed, pending)
    # AFTER the pending filter, as on both pre-merge paths: an applied cell needs no record,
    # so a completed check that carries none never refuses the deploy.
    pending = ad.with_plan_runs(pending, lines, app_id, pr_number=None)
    bm.refuse_workload_gaps(pending, table)
    deps = run_graph_deps(pending)
    order = bm.ec.env_order(table)
    refuse_inversions(pending, order, deps, tag_map)
    # Before the padding, whose over-depth refusal is where this line helps most.
    print(ad.dag_shape_notice(deps))
    per_level = wv.env_level_waves(pending, order, deps)
    level_counts = [sum(map(len, w.values())) for w in per_level]
    print(
        f"::notice title=deploy-detect::base={os.environ.get('SHIPMATE_BASE_SHA', '')} "
        f"head={head} cells={len(cells)} completed={len(completed)} pending={len(pending)} "
        f"envlevels={level_counts} empty={not any(level_counts)}"
    )
    write_outputs(**wv.env_level_outputs(per_level), warm=json.dumps(warm_or_none(tag_map, table)))


if __name__ == "__main__":
    run_annotated(main)
