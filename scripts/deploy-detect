#!/usr/bin/env python3
"""deploy.yml detect: merge commit -> PR head SHA -> pending applies -> waves.

Exact-plan / fail-safe model: the work set is the merged PR's changed stacks
whose apply check is still pending (completed = applied pre-merge, or
no-change). No 'last deployed ref' diff — pending checks ARE the queue, and
each cell applies from the plan run its own apply check records.

This is the path with no comment, no dispatch inputs and no operator watching, so
a pending cell whose check records no plan run refuses the whole run — a default
would apply it from nowhere and a skip would leave its check pending with nothing
said. Every pending cell here is also runnable: this path holds nothing back, unlike
the bare-apply path's targeted and held envs. It refuses the whole run instead in four more
cases. A pending cell that `after` runs behind a pending cell `needs` puts on a later env-level
has no order that meets both. A pending cell another pull request locks refuses too;
CONTRACT.md §Cell locks gives the reason. A pending cell whose apply check records that its
plan found the base changed it has no reviewed plan (`refuse_behind_checks`). A pending cell
whose apply check another run holds in progress refuses while that run may still apply it,
or may have applied it without saving its state (`refuse_in_flight`).

It also writes `warm`, the cache warm-up matrix (`warm_rows`), which never refuses,
`max_parallel`, its cap, and `push`, the stacks the push changed (`push_stacks`), which the
`summary` job's re-plan of open pull requests reads.
"""

import json
import os
import sys
import time
from urllib.parse import quote

from _shipmate import (
    READ_ERRORS,
    StackCycle,
    _load,
    command_data,
    current_run_url,
    deploy_lock_remedy,
    exit_text,
    gh_json,
    is_run_id,
    listed_jobs,
    lock_who,
    one_line,
    run_annotated,
    validate_head_sha,
    write_outputs,
)
from _shipmate import gh_json as _gh_json

bm = _load("build-matrix")
wv = _load("waves")
# No apply-gate load of its own: the App-scoped "already applied" query is
# ad.ag.app_done_names, and test_detect_app_scoping pins this script to it.
ad = _load("apply-detect")
pck = _load("provider-cache-key")


def _merged_head(repo, merge_sha, branch, _attempts=3, _sleep=2):
    """Map a merge commit -> (head SHA, number) of the PR it merged.

    Reviewed .otplan artifacts and apply checks live on the PR head, not on main.
    Edge cases handled: (1) `commits/{sha}/pulls` can transiently return [] for a
    few seconds after the push (association indexing lag) — retry before falling
    back; (2) a commit may be associated with more than one PR — pick the one
    this commit actually merged (merge_commit_sha == merge_sha), which GitHub sets
    to the commit the branch moved to for a merge commit, a squash and a rebase;
    (3) a non-empty answer with no such PR maps to no PR (a listed PR's plans
    would apply more or other than the branch holds): head = merge_sha and the
    number is empty, at once, with a warning naming the listed PRs.

    When every attempt returns [], one page of the 100 most recently updated closed pull
    requests into `branch` is read, and only a pull request with `merge_commit_sha ==
    merge_sha` and `merged_at` set is taken: GitHub fills `merge_commit_sha` with the
    test-merge commit on a closed unmerged pull request. A merge older than that page is not
    found. Each poll and the listing are reads of their own through `gh_json`, which retries a
    transient failure; any other failure raises. With no match it returns `(merge_sha, "")`.
    Each warning goes to stderr, flushed so it precedes a refusal in the log.
    """
    for attempt in range(_attempts):
        pulls = _gh_json(f"repos/{repo}/commits/{merge_sha}/pulls")
        if pulls:
            pull = next((p for p in pulls if p.get("merge_commit_sha") == merge_sha), None)
            if pull:
                return pull["head"]["sha"], str(pull["number"])
            listed = ", ".join(f"#{p['number']}" for p in pulls)
            verb = "contains" if len(pulls) == 1 else "contain"
            return _push(
                f"could not map {merge_sha} to the pull request that merged it: {listed} {verb} "
                f"it but none records it as its merge commit; deploying it as a push to {branch}",
                merge_sha,
            )
        if attempt < _attempts - 1:
            time.sleep(_sleep)
    path = (
        f"repos/{repo}/pulls?state=closed&base={quote(branch, safe='')}"
        "&sort=updated&direction=desc&per_page=100"
    )
    closed = _gh_json(path)
    for p in closed:
        if p.get("merge_commit_sha") == merge_sha and p.get("merged_at"):
            return p["head"]["sha"], str(p["number"])
    return _push(
        f"could not map {merge_sha} to a merged pull request (commits/{merge_sha}/pulls stayed "
        "empty and no recently closed pull request records it as its merge commit); deploying "
        f"it as a push to {branch}",
        merge_sha,
    )


def _push(warning, merge_sha):
    """Write `warning` to stderr and return `merge_sha` as a push with no pull request."""
    sys.stderr.write(f"::warning::{command_data(warning)}\n")
    sys.stderr.flush()
    return merge_sha, ""


def refuse_stranded_checks(tree, unmanaged, open_names, pending):
    """Refuse each open apply check of a stack this scan covers (a stack of a `tree` cell, or
    `unmanaged`) whose `(stack, env)` is no `tree` cell: the stack lost that `env/*` tag on
    the default branch after its pull request was planned, so no cell carries its reviewed
    change and nothing else would ever complete the check. The gate fails closed.

    A check of a stack absent from the scan is skipped silently, for one of two causes. This
    merge's diff did not touch the stack, because an identical change landed first: a correct
    skip. Or the stack is no longer a stack at the merge commit, deleted on the default branch
    after planning: its check strands with nothing said. The deploy does not refuse that case,
    because no remedy exists for a deleted stack.

    The refusal applies nothing, so the message also names every `pending` cell as
    `<stack> / <env>`, with an apply check or without: those stay unapplied too, and the
    remedy pull request must change their stacks as well.

    A check names its env only in its name, and after the merge no env set holds the one a
    stack lost (under `folder` or `workspace` a table may declare none), so the env is read
    back with `parse_check_name`, taken only when it is an env name."""
    cells = {(c["stack"], c["environment"]) for c in tree}
    scanned = {s for s, _ in cells} | set(unmanaged)
    stranded = [
        name
        for name in open_names
        for stack, env in [ad.ag.parse_check_name(name)]
        if stack in scanned and bm.ec.is_env_name(env) and (stack, env) not in cells
    ]
    if not stranded:
        return
    raise SystemExit(
        f"::error::deploy aborted: {', '.join(sorted(stranded))}: the stack of each lost its "
        "env/* tag after this pull request was planned, so its reviewed change was not "
        f"applied.{_also(pending)} Open a new pull request that retags each stranded stack and "
        f"changes every other listed stack {_PLANS_AFRESH} If an untag was deliberate, apply "
        "that stranded change by hand instead of retagging; the pull request still changes "
        f"every listed stack, and with none listed no pull request is needed. {_NOT_AGAIN}"
    )


#: The new pull request's effect, shared by the stranded and behind refusals.
_PLANS_AFRESH = (
    "(any edit that `terramate list --changed` marks, such as a comment line). It plans the "
    "current default branch for all of them, this merged change included, and its cells are "
    "applied before merge under a required gate (`shipmate apply`, and `shipmate apply <env>` "
    "for a `targeted` environment), or by its deploy otherwise."
)
_NOT_AGAIN = (
    "Re-running this deploy checks out the same commit and refuses again. This deploy's apply "
    "checks are never read again and stay open on the merged pull request."
)


def _also(cells):
    """The sentence naming `cells` as `<stack> / <env>`, which a refused deploy does not apply
    either; empty for none."""
    others = sorted(f"{c['stack']} / {c['environment']}" for c in cells)
    if not others:
        return ""
    return (
        " This deploy applies nothing, so these other cells of this merge are not applied "
        f"either: {', '.join(others)}."
    )


def refuse_behind_checks(pending, behind):
    """Refuse when a `pending` cell's apply check name is in `behind` (`apply-gate.behind_names`):
    its plan found the base changed its stack after the branch left it and planned nothing, so
    no reviewed plan exists to deploy. Names every other `pending` cell, which this deploy does
    not apply either, and the new pull request that plans them all afresh."""
    hit = [c for c in pending if ad.ag.check_name(c["stack"], c["environment"]) in behind]
    if not hit:
        return
    cells = sorted(f"{c['stack']} / {c['environment']}" for c in hit)
    raise SystemExit(
        f"::error::deploy aborted: {', '.join(cells)}: each was planned behind the base, so no "
        f"reviewed plan exists for it.{_also([c for c in pending if c not in hit])} Open a new "
        f"pull request that changes every listed stack {_PLANS_AFRESH} {_NOT_AGAIN}"
    )


def _apply_not_started(job):
    """Whether listed job `job` shows its cell never applied: no steps, exactly one `APPLY_STEP`
    concluded `skipped`, or exactly one `PRE_APPLY_STEP` concluded `failure`, which makes
    `apply-cell` refuse before it applies. Any other shape, an unnamed step included, may have
    applied."""
    steps = job.get("steps")
    if steps == []:
        return True
    if not isinstance(steps, list):
        return False

    def conclusion(name):
        named = [s for s in steps if isinstance(s, dict) and s.get("name") == name]
        return named[0].get("conclusion") if len(named) == 1 else None

    return (
        conclusion(ad.ag.APPLY_STEP) == "skipped" or conclusion(ad.ag.PRE_APPLY_STEP) == "failure"
    )


def _read_run(repo, run_id):
    """`(status, run_attempt)` of run `run_id`, or None, with one warning naming the cause, when
    the read fails, the status is not a string or the attempt not an int."""
    try:
        read = gh_json(f"repos/{repo}/actions/runs/{run_id}", ad._run)
        status, attempt = read["status"], read["run_attempt"]
    except READ_ERRORS as e:
        why = exit_text(e) if isinstance(e, SystemExit) else repr(e)
        sys.stderr.write(f"::warning::{command_data(one_line(why))}\n")
        return None
    if not isinstance(status, str):
        sys.stderr.write(f"::warning::run {run_id} has status {command_data(repr(status))}\n")
        return None
    if type(attempt) is not int:
        sys.stderr.write(f"::warning::run {run_id} has run_attempt {command_data(repr(attempt))}\n")
        return None
    return status, attempt


def _newest_attempt(run_id, jobs):
    """The highest `run_attempt` of run `run_id`'s listed `jobs`, or None, with one warning
    naming the cause, when it lists no job or a job whose attempt is not an int."""
    if not jobs:
        sys.stderr.write(f"::warning::run {run_id} lists no job\n")
        return None
    bad = [j.get("run_attempt") for j in jobs if type(j.get("run_attempt")) is not int]
    if bad:
        found = command_data(repr(bad[0]))
        sys.stderr.write(f"::warning::run {run_id} lists a job with run_attempt {found}\n")
        return None
    return max(j["run_attempt"] for j in jobs)


def _holding_run(repo, run_id):
    """`("live", None)` while run `run_id` is not `completed`, when its listing's newest attempt
    is not the first read's, or when read again after its jobs listing it is not the same
    completed attempt: a re-run between the reads may not list its jobs yet, or may list them
    before the run read shows it, and a listing below the run's attempt is stale.
    `("ended", jobs)` otherwise, with every job of every attempt. `("unreadable", None)` when a
    run read or the jobs listing could not be read completely, a job's `run_attempt` included;
    each cause prints as one warning."""
    first = _read_run(repo, run_id)
    if first is None:
        return "unreadable", None
    if first[0] != "completed":
        return "live", None
    jobs = listed_jobs(repo, run_id, ad._run, counted=True, job_filter="all")
    newest = None if jobs is None else _newest_attempt(run_id, jobs)
    if newest is None:
        return "unreadable", None
    if newest != first[1]:
        return "live", None
    again = _read_run(repo, run_id)
    if again is None:
        return "unreadable", None
    if again != first:
        return "live", None
    return "ended", jobs


def refuse_in_flight(repo, lines, app_id, pending):
    """Refuse when any App apply check of a `pending` cell is `in_progress` under another run,
    not only the newest, since a same-head re-plan queues a newer check over a held one: a live
    holder may still apply the cell, and an ended holder may have applied it without saving its
    state. Everything else deploys. The check's `details_url` names the holder only
    when it is exactly a run page of this repository; this run's own page passes, so a re-run of
    this deploy passes over its own flips.

    The holder is read, its jobs listed, and the holder read again. While it is not
    `completed`, its listing's newest attempt is not the one read, it is not the same completed
    attempt when read again after the listing, or it lists a job of the cell that is not
    `completed`, the cell is held. Otherwise its jobs listing decides: when no job of the cell
    applied (`_apply_not_started`, or no job at all), the ended holder writes nothing more to
    the check, so the cell deploys with a warning; otherwise the cell is held. A run or listing
    that could not be read completely, and a `details_url` naming no run of this repository,
    hold it too. The refusal names every other pending cell, which it does not apply either."""
    flipped = _flipped(lines, app_id)
    runs, held = {}, {}
    for c in pending:
        for check in flipped.get(ad.ag.check_name(c["stack"], c["environment"]), []):
            cells = held.setdefault(_holder(repo, c, check, runs), [])
            if c not in cells:
                cells.append(c)
    deployed = {k: held.pop(k) for k in [k for k in held if k[0] == "deploy"]}
    if not held:
        for (_, run_id), cells in sorted(deployed.items()):
            for name in sorted(map(_name, cells)):
                sys.stderr.write(
                    f"::warning::{command_data(name)}: run {run_id} ended before applying this "
                    "cell and left its apply check in progress; this deploy queues it\n"
                )
        return
    sentences = [_held(cause, ident, cells) for (cause, ident), cells in sorted(held.items())]
    hit = [c for cells in held.values() for c in cells]
    others = _also([c for c in pending if c not in hit])
    raise SystemExit(f"::error::deploy refused: {' '.join(sentences)}{others}")


def _flipped(lines, app_id):
    """`{name: [check]}`: every App apply check `in_progress` under a run other than this one."""
    own, flipped = current_run_url(), {}
    for check in ad.ag.app_runs(lines, app_id):
        if check["status"] == "in_progress" and check.get("details_url") != own:
            flipped.setdefault(check["name"], []).append(check)
    return flipped


def _name(cell):
    return f"{cell['stack']} / {cell['environment']}"


def _holder(repo, cell, check, runs):
    """`(cause, id)` for `cell`, whose apply check `check` another run holds in progress:
    `("unknown", <check id>)` when `details_url` names no run of this repository, else
    `(<cause>, <run id>)`: the run's state in `runs`, filled through `_holding_run` once per
    run; also `live` while a job of the cell it lists is not `completed`; `deploy` when the run
    ended and every job of the cell shows it never applied (`_apply_not_started`), or when the
    run lists no job of the cell."""
    url, page = check.get("details_url") or "", current_run_url("")
    run_id = url.removeprefix(page) if url.startswith(page) else ""
    if not is_run_id(run_id):
        return "unknown", str(check["id"])
    if run_id not in runs:
        runs[run_id] = _holding_run(repo, run_id)
    state, detail = runs[run_id]
    if state != "ended":
        return state, run_id
    jobs = [j for j in detail if ad.ag.is_cell_job(j["name"], cell["stack"], cell["environment"])]
    if any(j["status"] != "completed" for j in jobs):
        return "live", run_id
    return ("deploy" if all(map(_apply_not_started, jobs)) else "ended"), run_id


#: The troubleshooting section that returns an in-progress apply check to `queued` by hand.
_BY_HAND = "Return an in-progress apply check by hand"


def _held(cause, ident, cells):
    """The refusal's sentence for `cells`, held for `cause` by run or check `ident`."""
    names = ", ".join(sorted(map(_name, cells)))
    if cause == "live":
        return (
            f"{names} are held in progress by run {ident}, which is still running. Once it "
            "ends, re-run this deploy: a cell whose check that run left in progress deploys if "
            "the run never applied it and is refused otherwise."
        )
    if cause == "ended":
        return (
            f"{names} were left in progress by run {ident}, which ended after their apply may "
            "have started, so their state may not be saved. Follow docs/troubleshooting.md "
            "section The apply step ran and its state was not saved before applying them again."
        )
    if cause == "unknown":
        return (
            f"{names}: apply check {ident} is in progress with no run named; follow "
            f"docs/troubleshooting.md section {_BY_HAND}, then re-run this deploy."
        )
    return (
        f"{names}: run {ident} could not be read completely; re-run this deploy. If it fails "
        f"the same way, follow docs/troubleshooting.md section {_BY_HAND}."
    )


def refuse_locked(repo, pending, pr_number):
    """Refuse the whole run when another pull request holds the lock of a `pending` cell; a
    push that merged no pull request passes `0`, which no pull request holds. Writes
    `refused_locked=true` first, so the lock release also drops the merged pull request's
    locks on pending cells. A failed lock read refuses through `locked_cells`."""
    locked = ad.locked_cells(repo, pending, pr_number)
    if not locked:
        return
    write_outputs(refused_locked=True)
    held = sorted((f"{c['stack']} / {c['environment']}", lock_who(c["holder"])) for c in locked)
    cells = sorted(f"{c['stack']} / {c['environment']}" for c in pending)
    remedy = deploy_lock_remedy([(c["holder"], c["environment"]) for c in locked], "these stacks")
    raise SystemExit(
        f"::error::deploy refused: {len(held)} pending cell(s) are locked by another pull "
        f"request: {', '.join(f'{k} (locked by {who})' for k, who in held)}. None of this "
        f"deploy's {len(cells)} pending cell(s) were applied: {', '.join(cells)}. {remedy}."
    )


def refuse_inversions(pending, order, deps, tag_map):
    """Refuse when a pending cell runs after a pending cell `needs` puts on a later env-level.

    Every pending cell of the merge is in the run, so none waits; the refusal applies
    nothing, and the message names every pending cell. A re-run reads `needs` from the
    default branch but tags and `after` from this commit, so a `needs` fix needs only a
    re-run and a fix to tags or `after` needs a new pull request."""
    present = {(c["stack"], c["environment"]) for c in pending}
    cells = ", ".join(sorted(f"{s} / {e}" for s, e in present))
    wv.refuse_inversions(
        pending,
        present,
        deps,
        tag_map,
        order,
        remedy=f"This deploy applies nothing, so none of these cells of this merge is "
        f"applied: {cells}. A fix by `needs`: merge it, then re-run this deploy, which reads "
        "`needs` from the default branch and applies these cells. A fix to tags or `after`: "
        "both live in this merged commit, so a re-run refuses again; open a new pull request "
        "that makes the fix and changes every listed stack (any edit `terramate list "
        "--changed` marks); its cells are applied before merge under a required gate "
        "(`shipmate apply`, and `shipmate apply <env>` for a `targeted` environment), or by "
        "its deploy otherwise.",
    )


def run_graph_deps(pending):
    """`bm.run_graph_deps()`. A stack ordering cycle refuses with the plan's message, then the
    `pending` cells, which the refusal leaves unapplied, when there are any, then the
    troubleshooting entry that holds the remedy."""
    try:
        return bm.run_graph_deps()
    except StackCycle as e:
        cells = ", ".join(sorted(f"{c['stack']} / {c['environment']}" for c in pending))
        listed = f"; pending on this merge: {cells}" if cells else ""
        raise SystemExit(
            f"{e.code.removesuffix('.')}{listed}; see `stack ordering cycle through <stacks>` "
            "in docs/troubleshooting.md."
        ) from e


#: The `warm` row that saves only the OpenTofu release entry: its leg runs `setup` alone.
TOOLS_ROW = {"stack": "", "tf_vars": {}}


def warm_cells(tag_map, table):
    """One `{stack, tf_vars}` row per distinct provider lock digest (`provider-cache-key`'s)
    over every managed stack of `tag_map`, changed or not, for `deploy.yml`'s `warm` matrix: a
    stack with an `env/*` tag and no `LOCAL_TAG`, so one a cell can run. A stack whose lock
    yields no digest is left out. Each digest's row is its first stack in path order, with the
    `tf_vars` `table` resolves for that stack's first environment by name. Past the matrix
    limit, the rest are dropped with one warning naming how many."""
    rows = {}
    for stack in sorted(tag_map):
        tags = tag_map[stack]
        envs = sorted(t[len("env/") :] for t in tags if t.startswith("env/"))
        if not envs or bm.LOCAL_TAG in tags:
            continue
        found = pck.lock_digest(stack)
        if found and found not in rows:
            tf_vars = bm.ec.resolve(table, envs[0], "apply", "")["tf_vars"]
            rows[found] = {"stack": stack, "tf_vars": tf_vars}
    dropped = len(rows) - bm.MATRIX_LIMIT
    if dropped > 0:
        sys.stderr.write(
            f"::warning::{dropped} of {len(rows)} distinct provider locks are not warmed: "
            f"the warm matrix holds at most {bm.MATRIX_LIMIT}.\n"
        )
    return list(rows.values())[: bm.MATRIX_LIMIT]


def warm_rows(tag_map, table):
    """`warm_cells`, or `[TOOLS_ROW]` when it is empty or raises, so a deploy still saves the
    OpenTofu release entry. A degrade: `warm` only fills caches, so a failure here warns and
    must not refuse the deploy."""
    try:
        rows = warm_cells(tag_map, table)
    except (Exception, SystemExit) as e:
        sys.stderr.write(f"::warning::{command_data(f'no provider cache warm-up: {e}')}\n")
        rows = []
    return rows or [TOOLS_ROW]


#: The largest serialized `push`: it reaches a step `env:` string, capped at 128 KiB.
PUSH_CAP = 64 * 1024


def push_stacks(before, changed, tag_map):
    """The `push` output: `{"stacks": sorted(changed), "outside": <bool>}`. `outside` is true when
    `git diff --name-only before..HEAD` names a path in no stack directory of `tag_map`
    (`bm._inside`), and when `before` is empty or all zeros, which leaves the change
    unknown. Past `PUSH_CAP` serialized, `{"stacks": null, "outside": true}`. A failed diff
    warns and returns None: `push` only selects pull requests to re-plan, so it never refuses
    the deploy."""
    outside = True
    if before.strip("0"):
        try:
            paths = bm._run(["git", "diff", "-z", "--name-only", "--no-renames", before, "HEAD"])
        except SystemExit as e:
            why = one_line(f"the push's changed paths could not be read: {exit_text(e)}")
            sys.stderr.write(f"::warning::{command_data(why)}\n")
            return None
        stacks = set(tag_map)
        outside = any(
            not any(bm._inside(p, s, stacks) for s in stacks) for p in paths.split("\0") if p
        )
    value = json.dumps({"stacks": sorted(changed), "outside": outside})
    return value if len(value) <= PUSH_CAP else json.dumps({"stacks": None, "outside": True})


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    merge_sha = os.environ["GITHUB_SHA"]
    branch = os.environ["GITHUB_REF_NAME"]
    head, pr_number = _merged_head(repo, merge_sha, branch)
    validate_head_sha(
        head,
        "the deploy's head SHA (the merged pull request's head from "
        f"commits/{merge_sha}/pulls or the closed pull requests of {branch}, else GITHUB_SHA)",
    )
    # Before any refusal past head validation, so a refused deploy's summary can write the gate's
    # failure on the head.
    # Hyphen-free: `steps.d.outputs.head-sha` parses the '-' as subtraction.
    write_outputs(head_sha=head, pr_number=pr_number)
    # `all_stacks=False`: the map covers the changed stacks alone and is no evidence that
    # an environment is unused or a workload untagged, so both warnings stay silent here.
    tag_map = bm.all_tags()
    before = os.environ.get("SHIPMATE_BASE_SHA", "")
    _, cells, tree, scanned, _ = bm.compute_cells(all_stacks=False, base=before, tag_map=tag_map)
    # Before any refusal: a refused deploy's push still changed stacks open pull requests plan.
    push = push_stacks(before, {c["stack"] for c in tree} | set(scanned), tag_map)
    if push is not None:
        write_outputs(push=push)
    table = bm.env_config(cells)
    cells = bm.stamp_rows(cells, table, "apply")
    app_id = os.environ["SHIPMATE_APP_ID"]
    # One listing answers both questions: which cells are already applied, and which plan
    # run each remaining one applies from. A re-plan landing between two reads makes them
    # disagree — the name leaves `completed` and its cell re-queues on the earlier record.
    lines = ad._check_run_lines(repo, head)
    completed = ad.ag.app_done_names(lines, app_id)
    pending = ad.filter_pending(cells, completed)
    refuse_locked(repo, pending, pr_number or 0)
    # `scanned` includes local stacks on purpose: a stack moved to `shipmate/local` with an
    # open apply check must still refuse. Guard test:
    # test_main_refuses_a_pending_apply_check_on_a_stack_moved_to_local.
    refuse_stranded_checks(tree, scanned, ad.apply_check_names(lines, app_id) - completed, pending)
    # Before `with_plan_runs`, whose missing-digest refusal would name a re-plan remedy.
    refuse_behind_checks(pending, ad.ag.behind_names(lines, app_id))
    refuse_in_flight(repo, lines, app_id, pending)
    # AFTER the pending filter, as on both pre-merge paths: an applied cell needs no record,
    # so a completed check that carries none never refuses the deploy.
    pending = ad.with_plan_runs(pending, lines, app_id, pr_number=None)
    bm.refuse_workload_gaps(pending, table)
    deps = run_graph_deps(pending)
    order = bm.ec.env_order(table)
    refuse_inversions(pending, order, deps, tag_map)
    # Before the padding, whose over-depth refusal is where this line helps most.
    print(ad.dag_shape_notice(deps))
    per_level = wv.env_level_waves(pending, order, deps)
    level_counts = [sum(map(len, w.values())) for w in per_level]
    print(
        f"::notice title=deploy-detect::base={os.environ.get('SHIPMATE_BASE_SHA', '')} "
        f"head={head} cells={len(cells)} completed={len(completed)} pending={len(pending)} "
        f"envlevels={level_counts} empty={not any(level_counts)}"
    )
    write_outputs(
        **wv.env_level_outputs(per_level),
        warm=json.dumps(warm_rows(tag_map, table)),
        max_parallel=bm.ec.max_parallel(table),
    )


if __name__ == "__main__":
    run_annotated(main)
