#!/usr/bin/env python3
"""deploy.yml detect: merge commit -> PR head SHA -> pending applies -> waves.

Exact-plan / fail-safe model: the work set is the merged PR's changed stacks
whose apply check is still pending (completed = applied pre-merge, or
no-change). No 'last deployed ref' diff — pending checks ARE the queue, and
each cell applies from the plan run its own apply check records.

This is the path with no comment, no dispatch inputs and no operator watching, so
a pending cell whose check records no plan run refuses the whole run — a default
would apply it from nowhere and a skip would leave its check pending with nothing
said. Every pending cell here is also runnable: this path holds nothing back, unlike
the bare-apply path's explicit and held envs.
"""

import os
import time

from _shipmate import _load
from _shipmate import gh_json as _gh_json

bm = _load("build-matrix")
wv = _load("waves")
# No apply-gate load of its own: the App-scoped "already applied" query is
# ad.ag.app_done_names, and test_detect_app_scoping pins this script to it.
ad = _load("apply-detect")


def _merged_head(repo, merge_sha, _attempts=3, _sleep=2):
    """Map a merge commit -> the head SHA of the PR it merged.

    Reviewed .otplan artifacts and apply checks live on the PR head, not on main.
    Edge cases handled: (1) `commits/{sha}/pulls` can transiently return [] for a
    few seconds after the push (association indexing lag) — retry before falling
    back; (2) a commit may be associated with more than one PR — pick the one
    this commit actually merged (merge_commit_sha == merge_sha); (3) if none of
    the returned pulls match exactly, only *merged* PRs (`merged_at` set) are
    eligible fallback candidates — an OPEN PR that merely contains the pushed
    commit must never be selected, since deploying its plans would apply more
    than main actually contains. If no pull qualifies, head = merge_sha, same as
    a genuine non-PR push to main.
    """
    for attempt in range(_attempts):
        pulls = _gh_json(f"repos/{repo}/commits/{merge_sha}/pulls")
        if pulls:
            exact = next((p for p in pulls if p.get("merge_commit_sha") == merge_sha), None)
            if exact is not None:
                return exact["head"]["sha"]
            merged = next((p for p in pulls if p.get("merged_at")), None)
            return merged["head"]["sha"] if merged is not None else merge_sha
        if attempt < _attempts - 1:
            time.sleep(_sleep)
    return merge_sha


def refuse_stranded_checks(tree, unmanaged, open_names, pending):
    """Refuse each open apply check of a stack this scan covers (a stack of a `tree` cell, or
    `unmanaged`) whose `(stack, env)` is no `tree` cell: the stack lost that `env/*` tag on
    the default branch after its pull request was planned, so no cell carries its reviewed
    change and nothing else would ever complete the check. The gate fails closed.

    A check of a stack absent from the scan is skipped silently, for one of two causes. This
    merge's diff did not touch the stack, because an identical change landed first: a correct
    skip. Or the stack is no longer a stack at the merge commit, deleted on the default branch
    after planning: its check strands with nothing said. The deploy does not refuse that case,
    because no remedy exists for a deleted stack.

    The refusal applies nothing, so the message also names every `pending` cell as
    `<stack> / <env>`, with an apply check or without: those stay unapplied too, and the
    remedy pull request must change their stacks as well.

    A check names its env only in its name, and after the merge no env set holds the one a
    stack lost (under `folder` or `workspace` a table may declare none), so the env is the
    rest of the name after the stack's `check_name` prefix, taken only when it is an env
    name. An env name holds no ` / `, so a longer stack path sharing the prefix leaves a rest
    that is no env name, and its check is never taken for this stack's."""
    cells = {(c["stack"], c["environment"]) for c in tree}
    scanned = {s for s, _ in cells} | set(unmanaged)
    stranded = []
    for name in open_names:
        for stack in scanned:
            prefix = ad.ag.check_name(stack, "")
            if (
                name.startswith(prefix)
                and bm.ec.is_env_name(rest := name[len(prefix) :])
                and (stack, rest) not in cells
            ):
                stranded.append(name)
    if not stranded:
        return
    others = sorted(f"{c['stack']} / {c['environment']}" for c in pending)
    also = (
        f" This deploy applies nothing, so these other cells of this merge are not applied "
        f"either: {', '.join(others)}."
        if others
        else ""
    )
    raise SystemExit(
        f"::error::deploy aborted: {', '.join(sorted(stranded))}: the stack of each lost its "
        "env/* tag after this pull request was planned, so its reviewed change was not "
        f"applied.{also} Open a new pull request that retags each stranded stack and changes "
        "every other listed stack (any edit that `terramate list --changed` marks, such as a "
        "comment line); its plan and deploy apply the current default branch for all of "
        "them, this merged change included. If an untag was deliberate, apply that stranded "
        "change by hand instead of retagging; the pull request still changes every listed "
        "stack, and with none listed no pull request is needed. Re-running this deploy checks "
        "out the same commit and refuses again. This deploy's apply checks are never read "
        "again and stay open on the merged pull request."
    )


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    merge_sha = os.environ["GITHUB_SHA"]
    head = _merged_head(repo, merge_sha)
    ad.validate_head_sha(
        head,
        "the deploy's head SHA (the merged pull request's head from "
        f"commits/{merge_sha}/pulls, else GITHUB_SHA)",
    )
    # `all_stacks=False`: the map covers the changed stacks alone and is no evidence that
    # an environment is unused or a workload untagged, so both warnings stay silent here.
    _, cells, tree, unmanaged = bm.compute_cells(
        all_stacks=False, base=os.environ.get("SHIPMATE_BASE_SHA", "")
    )
    table = bm.env_config(cells)
    cells = bm.stamp_rows(cells, table, "apply")
    app_id = os.environ["SHIPMATE_APP_ID"]
    # One listing answers both questions: which cells are already applied, and which plan
    # run each remaining one applies from. A re-plan landing between two reads makes them
    # disagree — the name leaves `completed` and its cell re-queues on the earlier record.
    lines = ad._check_run_lines(repo, head)
    completed = ad.ag.app_done_names(lines, app_id)
    pending = ad.filter_pending(cells, completed)
    refuse_stranded_checks(
        tree, unmanaged, ad.apply_check_names(lines, app_id) - completed, pending
    )
    # AFTER the pending filter, as on both pre-merge paths: an applied cell needs no record,
    # so a completed check that carries none never refuses the deploy.
    pending = ad.with_plan_runs(pending, lines, app_id)
    bm.refuse_workload_gaps(pending, table)
    deps = ad.run_graph_deps()
    # Before the padding, whose over-depth refusal is where this line helps most.
    print(ad.dag_shape_notice(deps))
    per_level = wv.env_level_waves(pending, bm.ec.env_order(table), deps)
    level_counts = [sum(map(len, w.values())) for w in per_level]
    print(
        f"::notice title=deploy-detect::base={os.environ.get('SHIPMATE_BASE_SHA', '')} "
        f"head={head} cells={len(cells)} completed={len(completed)} pending={len(pending)} "
        f"envlevels={level_counts} empty={not any(level_counts)}"
    )
    # Output names must be hyphen-free: `steps.d.outputs.head-sha` parses the '-'
    # as subtraction, breaking the composite action's outputs block. Underscores.
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        wv.write_env_level_waves(fh, per_level)
        fh.write(f"head_sha={head}\n")


if __name__ == "__main__":
    main()
