#!/usr/bin/env python3
"""Apply waves: stack-waves from the Terramate `after` DAG, bucketed by env-level.

Stack-waves are topological levels of the run-graph. Ordering is over the FULL
graph, then filtered to the work set, so transitive order through unchanged
stacks is preserved and empty middle waves are normal.

Env-levels come from each environment's `needs` in `.github/shipmate-config.yml`:
the envs that must fully apply before it, collected by `env-config.env_order`
into env -> predecessors and topologically sorted into levels. A deploy applies
level 0 fully, then level 1, etc. Unlisted envs are level 0; no `needs` anywhere
-> {} -> all level 0.

Nothing here reads anything: the callers pass the mapping `env-config` already
loaded for the operation, which comes from the default branch. A pull request
therefore cannot reorder its own apply waves or drop its own exclusion.

`MAX_ENV_LEVELS` is fixed because GHA declares no jobs or outputs dynamically.
Bumping it needs, per new level N:
- `envlevelN_waves`/`_empty` outputs in actions/deploy-detect/action.yml and
  actions/apply-detect/action.yml;
- the same two slots in the `detect` job `outputs:` of .github/workflows/apply.yml
  and .github/workflows/deploy.yml, and an `envlevelN` job in each;
- an `envlevelN-waves` input on apply.yml's `summary` step and on
  actions/apply-summary/action.yml, with its `SHIPMATE_ENVLEVELN_WAVES` env line;
- scripts/apply-comment's own `MAX_ENV_LEVELS`.

A module, never a program: the detects and `env-config` `_load` it. It runs nothing
on import -- it only defines functions and constants.
"""

import json
import re
from graphlib import CycleError, TopologicalSorter

MAX_WAVES = 8
# Cap on env-DAG depth. COUPLED to fixed GHA job and output slots; see the module docstring.
MAX_ENV_LEVELS = 4
_NODE = re.compile(r'(\w+)\s*\[label="([^"]+)"\]')
_EDGE = re.compile(r"^\s*(\w+)\s*->\s*(\w+)")


def parse_dot(text):
    """Return {stack: set(stacks-that-run-before-it)} from run-graph dot.

    Generated with `terramate experimental run-graph --label stack.dir`: node
    ids (nN) carry `label="/stacks/app"` (absolute-from-root dir). Normalize to
    `list` form (`stacks/app`) by stripping the leading '/'. An edge `nA -> nB`
    means A runs before B, so B depends on A. Isolated nodes (no edges) are
    included with an empty dependency set.
    """
    ids = {nid: label.lstrip("/") for nid, label in _NODE.findall(text)}
    deps = {path: set() for path in ids.values()}
    for line in text.splitlines():
        if "[label=" in line:  # A `[label=` line declares a node, not an edge.
            continue
        m = _EDGE.match(line)
        if not m:
            continue
        before, after = ids.get(m.group(1)), ids.get(m.group(2))
        if before is not None and after is not None:
            deps[after].add(before)
    return deps


def levels(deps):
    """Topological levels; level 0 = nodes with no dependencies."""
    ts = TopologicalSorter(deps)
    ts.prepare()
    out = []
    while ts.is_active():
        ready = sorted(ts.get_ready())
        out.append(ready)
        for n in ready:
            ts.done(n)
    return out


def stack_levels(deps):
    """`levels` over the stack run-graph, or `SystemExit` naming the cycle.

    Every stack-graph sort goes through here, so no detect reaches a raw
    `CycleError`. The env graph sorts with `levels` directly: `env-config.validate` has
    already refused its cycles with its own message."""
    try:
        return levels(deps)
    except CycleError as e:
        raise SystemExit(
            f"::error::dependency cycle in the Terramate stack run-graph: {e}. Two or more "
            "stacks order each other through `after`/`before`; break the loop in their stack "
            "configuration."
        ) from e


def assign_waves(levels_, cells):
    """Bucket cells by the full-graph level of their stack (index-preserving)."""
    level_of = {stack: i for i, lv in enumerate(levels_) for stack in lv}
    waves = [[] for _ in range(len(levels_))]
    for c in cells:
        if c["stack"] not in level_of:
            raise SystemExit(
                f"::error::stack '{c['stack']}' is not a node in the run-graph; "
                "cannot order it into a wave (regenerate run-graph or check the label)."
            )
        waves[level_of[c["stack"]]].append(c)
    return waves


def pad_waves(waves):
    """`waves` as a {wave0..wave{MAX_WAVES-1}: cells} dict, short lists padded.

    Refuses a populated wave beyond the pre-declared wave0..wave7 jobs before
    truncating. A deep FULL graph with only low-level cells in the work set is
    fine -- empty trailing levels do not count.

    Every key is always present -- apply-env-level.yml indexes
    `fromJSON(waves_json).waveN` for every N and errors on a missing one."""
    over = [i for i, w in enumerate(waves) if w and i >= MAX_WAVES]
    if over:
        raise SystemExit(
            f"::error::change spans {over[-1] + 1} dependency levels (> {MAX_WAVES}); split the PR."
        )
    return {f"wave{i}": (waves[i] if i < len(waves) else []) for i in range(MAX_WAVES)}


def blocked_envs(order, unavailable, envs):
    """Envs in `envs` with an unavailable env among their transitive
    predecessors (per `order`). The bare-apply path skips these with a notice:
    their ordering precondition cannot be met this run (an explicit env
    upstream was excluded), exactly like a failed predecessor level.

    `order` comes from `env-config`'s `env_order` on a table that passed `validate`."""

    def _hit(env, seen):
        if env in seen:
            return False
        seen.add(env)
        return any(p in unavailable or _hit(p, seen) for p in order.get(env, []))

    return {e for e in envs if _hit(e, set())}


def env_levels(order, envs):
    """Topological level (0-based) per env in `envs`. Predecessors absent from
    `envs` (no changed cells this run) still constrain ordering.

    `order` comes from `env-config`'s `env_order` on a table that passed `validate`."""
    nodes = set(envs) | set(order) | {p for preds in order.values() for p in preds}
    graph = {n: set(order.get(n, [])) for n in nodes}
    level = {n: i for i, ready in enumerate(levels(graph)) for n in ready}
    return {e: level[e] for e in envs}


def env_level_waves(cells, order, deps):
    """Return a list of MAX_ENV_LEVELS dicts, each {wave0..wave7: [cells]}.

    Cells are bucketed by their env's level in `order`, then stack-wave-ordered
    within it. Env-levels apply fully in order: level 0 entirely before level 1,
    and so on. Shared by deploy-detect (merge path) and both apply-detect forms: the bare
    `shipmate apply`, and the targeted `shipmate apply <env>`, which passes an
    empty order: that puts every cell at level 0.

    Refuses an env beyond MAX_ENV_LEVELS before bucketing: the loop below keys on
    `range(MAX_ENV_LEVELS)`, so an over-deep env falls out of every level and its
    cells apply nothing under a run that still reports success."""
    env_level = env_levels(order, {c["environment"] for c in cells})
    over = [e for e, lv in env_level.items() if lv >= MAX_ENV_LEVELS]
    if over:
        raise SystemExit(
            f"::error::env order spans more than {MAX_ENV_LEVELS} levels "
            f"({sorted(over)}); flatten the env dependency chain."
        )
    graph_levels = stack_levels(deps)
    out = []
    for lvl in range(MAX_ENV_LEVELS):
        bucket = [c for c in cells if env_level[c["environment"]] == lvl]
        out.append(pad_waves(assign_waves(graph_levels, bucket)))
    return out


def write_env_level_waves(fh, per_level):
    """Emit envlevel{0..N}_waves (JSON) + envlevel{0..N}_empty flags for a list
    of per-env-level wave dicts, to a GITHUB_OUTPUT file handle. Shared by
    deploy-detect and both apply-detect forms so the env-level output contract
    that the reusable apply-env-level.yml consumes stays single-sourced -- a format
    drift between the detect paths would silently break that shared consumer."""
    for lvl, w in enumerate(per_level):
        fh.write(f"envlevel{lvl}_waves={json.dumps(w)}\n")
        fh.write(f"envlevel{lvl}_empty={'false' if any(w.values()) else 'true'}\n")
