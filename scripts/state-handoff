#!/usr/bin/env python3
"""Hand an apply cell's local state to its `save` job, which runs no pull-request code.

Runs in apply-cell's `Hand off the state` step, after the apply, whatever its outcome. Writes the
step output `state` = `<value> attempt=<GITHUB_RUN_ATTEMPT>`, which `cell.yml` passes on as the
`apply` job output `state-save` reads:

| `APPLY_OUTCOME` | State | Value |
| --- | --- | --- |
| `skipped` | any | `not-applied` |
| `success`, `failure`, `cancelled` | `STATE_PATH` empty (a backend other than `local`) | `none` |
| the same | the file absent or 0 bytes | `missing` |
| the same | a non-empty file | the bundle's sha256 |
| anything else, empty included | any | no output, an `::error::` |

For a digest it seals a copy of the state with `plan-crypt encrypt-state` under the key
`state/<SLUG>/<ENV>/<run>-<attempt>`, writes `$RUNNER_TEMP/state.bundle` = `BUNDLE_MAGIC`, the
state path and a newline, then the ciphertext, and writes the outputs `bundle=true` and `name`,
the artifact name. The path travels inside the digested bytes, never in the output. `state` is
written last, so a failure before it leaves the output empty and `state-save` reads the cell from
the run's job listing.
"""

import hashlib
import os

from _shipmate import _load, run_annotated, write_outputs

BUNDLE_MAGIC = b"shipmate-state-bundle-v1\n"


def artifact_name(env, slug, attempt):
    """The artifact a cell's bundle travels in. Environment names hold no `.`, the attempt is
    digits, and slugs are unique per environment, so no two cells of a run share a name."""
    return f"state.{env}.{slug}.{attempt}"


def main():
    outcome = os.environ.get("APPLY_OUTCOME", "")
    attempt = os.environ["GITHUB_RUN_ATTEMPT"]
    if outcome == "skipped":
        write_outputs(state=f"not-applied attempt={attempt}")
        return
    if outcome not in ("success", "failure", "cancelled"):
        raise SystemExit(
            f"::error::the apply step's outcome {outcome!r} is not one this step knows, so the "
            "cell's state is not handed off and its save job reads the cell from the job listing."
        )
    path = os.environ.get("STATE_PATH", "")
    if not path:
        write_outputs(state=f"none attempt={attempt}")
        return
    if not os.path.isfile(path) or os.path.getsize(path) == 0:
        write_outputs(state=f"missing attempt={attempt}")
        return
    slug, env = os.environ.get("SLUG", ""), os.environ.get("ENV", "")
    if not slug or not env:
        raise SystemExit("::error::the stack slug or environment is empty, so no state key.")
    temp = os.environ["RUNNER_TEMP"]
    sealed = os.path.join(temp, "state.sealed")
    with open(path, "rb") as src, open(sealed, "wb") as dst:
        dst.write(src.read())
    run_id = os.environ["GITHUB_RUN_ID"]
    _load("plan-crypt").encrypt_state(sealed, f"state/{slug}/{env}/{run_id}-{attempt}")
    with open(sealed, "rb") as fh:
        bundle = BUNDLE_MAGIC + path.encode() + b"\n" + fh.read()
    os.remove(sealed)
    with open(os.path.join(temp, "state.bundle"), "wb") as fh:
        fh.write(bundle)
    write_outputs(bundle=True, name=artifact_name(env, slug, attempt))
    write_outputs(state=f"{hashlib.sha256(bundle).hexdigest()} attempt={attempt}")


if __name__ == "__main__":
    run_annotated(main)
