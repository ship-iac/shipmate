#!/usr/bin/env python3
"""Select the apply-check ids to complete: the pre-flight snapshot intersected
with the wave jobs that actually succeeded in THIS run.

Evidence is `GET /actions/runs/{id}/jobs`, not the cells' own artifacts: a job
conclusion is written by GitHub, so one cell cannot claim another applied. A
cell lying about itself by exiting 0 is irreducible and is the trust level the
per-cell completion already had.

Job names are matched by suffix because a called workflow's jobs display as
`<caller job> / <called job> / <matrix job>`, and CONTRACT.md pins the matrix
job's own name to `apply / <stack> / <env>`. The suffix match requires a
`/ `-boundary immediately before `apply`, not a bare `str.endswith` -- a job
named e.g. `reapply / <stack> / <env>` shares the trailing characters but is
a different verb entirely, and a bare `endswith` would let it complete a
check its own apply never earned.

A cell is therefore classified, not merely filtered, into four states.

*Matched, succeeded* — its ids are emitted.

*Matched, no conclusion yet* — the listing lags, by seconds, a job that has
already ended. Under a plain success filter this cell is indistinguishable
from one that never ran, so it would be dropped and its check stranded
pending forever. It is reported retryable instead, and `main` exits
`UNRESOLVED_EXIT` so the caller can tell "ask me again" from "I broke".

*Matched, terminal, not `success`* — the cell failed, was cancelled, or was
skipped. Its check legitimately stays pending, and no retry can change that,
but it is named rather than dropped: everything that leaves a check pending
has to be visible, or a step that reports success is the only trace.

*No matching job at all* — the snapshot comes from the same `waves_json` the
caller fans out (`actions/apply-snapshot`), so every snapshot cell is a cell
of this run; there is no "belongs to another environment" case. What there is
is skip-propagation: wave1..wave7 carry `if: !failure() && !cancelled()`, and
`complete` runs on `always()`. GitHub expands a matrix only for a job it
actually starts, so a skipped wave contributes exactly one row to the
listing, named with the literal un-interpolated `apply / ${{ matrix.stack }} /
${{ matrix.environment }}` template — matching no cell. (Observed on a real
run whose `snapshot` job failed: all eight wave jobs listed that way, none
expanded.) Those checks legitimately stay pending -- but a lost or truncated
listing looks exactly the same, so they are named in a warning rather than
skipped in silence, and a listing that matches *no* cell at all is retried
and then fails the run: a run always lists its own wave jobs.
"""

import json
import os
import sys

SEP = "\x00"
UNRESOLVED_EXIT = 75  # EX_TEMPFAIL; not 2, which CPython itself exits with.
# The one channel that says "ask me again, and here is why". The caller greps this prefix out
# of stderr to annotate what it gave up on after its retries, so it is a line-anchored
# contract, not a message: stderr also carries warnings naming other cells no retry can help.
RETRY_PREFIX = "retry: "


def to_complete(snapshot, jobs):
    out = []
    unresolved = []
    unmatched = []
    unsuccessful = []
    for key, ids in snapshot.items():
        stack, env = key.split(SEP)
        suffix = f"apply / {stack} / {env}"
        matched = [
            j for j in jobs if (name := j.get("name", "")) == suffix or name.endswith(f"/ {suffix}")
        ]
        if any(j.get("conclusion") == "success" for j in matched):
            out.extend(ids)
        elif not matched:
            unmatched.append(f"{stack} / {env}")
        elif any(j.get("conclusion") is None for j in matched):
            unresolved.append(f"{stack} / {env}")
        else:
            unsuccessful.append(f"{stack} / {env}")
    return sorted(out), sorted(unresolved), sorted(unmatched), sorted(unsuccessful)


def main():
    snapshot = json.loads(os.environ["SHIPMATE_SNAPSHOT_JSON"])
    jobs = [json.loads(line) for line in sys.stdin if line.strip()]
    ids, unresolved, unmatched, unsuccessful = to_complete(snapshot, jobs)
    for cid in ids:
        print(cid)
    if unmatched:
        print(
            "::warning::no job in this run's listing matched these cells, so their apply "
            f"checks stay pending: {', '.join(unmatched)}",
            file=sys.stderr,
        )
    if unsuccessful:
        print(
            "::warning::these cells' apply jobs did not succeed, so their apply checks "
            f"stay pending: {', '.join(unsuccessful)}",
            file=sys.stderr,
        )
    if snapshot and len(unmatched) == len(snapshot):
        print(
            RETRY_PREFIX + f"none of the {len(snapshot)} snapshot cells matched a job in this "
            "run's listing — a run always lists its own wave jobs, so the listing cannot "
            "be trusted; refusing to complete nothing",
            file=sys.stderr,
        )
        sys.exit(UNRESOLVED_EXIT)
    if unresolved:
        print(
            RETRY_PREFIX
            + "the jobs listing reported no conclusion for these cells: "
            + ", ".join(unresolved),
            file=sys.stderr,
        )
        sys.exit(UNRESOLVED_EXIT)


if __name__ == "__main__":
    main()
