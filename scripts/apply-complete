#!/usr/bin/env python3
"""Decide each apply check's write from the state of its cell's wave job in THIS run.

`apply-complete list` prints this run's jobs listing, one job per line;
`apply-complete` reads that listing on stdin and prints one row per decided cell;
`apply-complete plan <rows>` turns every attempt's rows into the `patch-checks` write plan;
`apply-complete stranded <reasons>` refuses with the reasons no attempt resolved.

Evidence is `GET /actions/runs/{id}/jobs`, not the cells' own artifacts: a job
conclusion is written by GitHub, so one cell cannot claim another applied. A
cell lying about itself by exiting 0 is irreducible and is the trust level the
per-cell completion already had.

Job names are matched as `L<n> / <env> / <stack>` suffixes
(`apply-gate.is_cell_job`) because a called workflow's jobs display as
`<caller job> / <called job> / <matrix job>`, one segment per call level
(`apply / run / L<n> / ...`): `apply-run.yml` and `deploy.yml` name the level
`L<n>`, and CONTRACT.md pins the matrix job's own name to `<env> / <stack>`, read
from the snapshot's check name with `apply-gate.parse_check_name`. Requiring the
level and a ` / ` boundary, not a bare `str.endswith`, keeps out a job of env
`dev-eu` for env `eu` and a non-wave job such as `apply / run / detect` for env
`run` and stack `detect`; either would complete a check its own apply never earned.

The cells are those of the waves named in `SHIPMATE_WAVE_RESULTS_JSON`, `{wave key: result
of its wave job}`, read from `SHIPMATE_BY_WAVE_JSON`, `apply-snapshot`'s `by_wave`. Each cell
takes the row of its matched job:

| Matched job | Row `conclusion` | Write (`plan`) |
| --- | --- | --- |
| any `success` | `success` | `completed`/`success`, the job's URL, the record title |
| `failure` | `failure` | `queued`, `Failed: <first error line>`, the job's URL |
| `cancelled` | `cancelled` | `queued`, `Cancelled` |
| `skipped`, or none in a wave that did not run | `skipped` / null | `queued`, `Not run` |
| any other conclusion | itself | `queued`, `Not applied (<conclusion>)`: never `success` |
| no conclusion yet | `unresolved: true` | none; `main` exits `UNRESOLVED_EXIT` |
| none in a wave that ran | no row | none; `main` exits `UNRESOLVED_EXIT` |

A job with no conclusion yet is the listing lagging, by seconds, a job that has already ended,
so the caller asks again. A wave that did not run (a failed or skipped release, a failed
earlier wave, a cancel before it started) lists one row under its literal `${{
matrix.environment }} / ${{ matrix.stack }}` name, since GitHub expands a matrix only for a job
it starts, so its cells match nothing and are not run. That holds for every `skipped` wave; a
`cancelled` wave may have started, so its missing cell is not run only when the listing shows
that literal row, `cancelled`, under this job's own level (`SHIPMATE_JOB_ID`, this job's check
run id, names the level) and lists no cell of the same wave. Any other missing cell, of a
wave that ran (`success` or `failure`, or a result this script does not know), is a lost or
lagging listing: it is retried. `plan` takes, per cell, a `success` row from any attempt; else
the last row any attempt printed for it, so a resolved outcome an earlier attempt saw is
written unless a later attempt listed the cell unresolved, which writes nothing. A cell no
attempt resolved gets no write, so a stale listing never turns a completed `success` back to
`queued`. Accepted limit: when every cell of
a cancelled wave is missing while that literal row is listed, the cells are written `Not run`
even if one started before the cancel; the check returns to `queued` either way, and only the
title differs.

Each row also carries `persisted`, the evidence that the cell's state was saved, from the wave's
`state-read` report in `SHIPMATE_WAVE_STATE_JSON` and the cell's saver leg
(`apply-gate.is_leg_job`): none is needed for a cell in `none` or `not_run`, or in
`not_applied` unless its job succeeded; a cell in `state` needs a `success` leg. Anything else
is a reason: an absent or malformed report, a `refused` cell, a failed or cancelled leg, a cell
in no class. A cell in `state` whose leg is not listed with a conclusion is unresolved, as a
lagging cell is. A `success`, `failure` or `cancelled` cell with a reason is written `queued`,
`Failed: state not saved (<reason>)` or `Cancelled: state not saved (<reason>)` in place of the
table's write. `apply-complete verdict <rows>` (`SHIPMATE_MODE` `verdict`) writes nothing and
refuses, naming each cell of the waves with a reason or no resolved row, whatever its job's
conclusion.
"""

import json
import os
import sys
import unicodedata

from _shipmate import _load, command_data, gh_json, one_line, print_annotated, run, run_annotated

ag = _load("apply-gate")

UNRESOLVED_EXIT = 75  # EX_TEMPFAIL; not 2, which CPython itself exits with.
# The one channel that says "ask me again, and here is why". The caller greps this prefix out
# of stderr to annotate what it gave up on after its retries, so it is a line-anchored
# contract, not a message.
RETRY_PREFIX = "retry: "
UNEXPANDED = "${{ matrix.environment }} / ${{ matrix.stack }}"
ERROR_LINE_CAP = 120
EMPTY_LISTING = "the run jobs listing came back empty; cannot tell which wave cells succeeded"
_CLASSES = ("state", "none", "not_applied", "not_run")
READER_UNFINISHED = "the state reader did not finish"
UNAPPLIED_SUCCESS = "the cell succeeded without applying"
UNCLASSIFIED = "the state reader did not classify the cell"
NEVER_RERUN = (
    "Never re-run these cells' jobs or their workflow run. A re-run, a shipmate apply comment, "
    "or a merge can apply their reviewed plans again against the state from before the apply. "
    "Before applying or merging any plan of a named stack in its environment, on any pull "
    "request, follow docs/troubleshooting.md section The apply step ran and its state was not "
    "saved."
)


def _row(check, ids, job=None, persisted=None):
    job = job or {}
    return {
        "check": check,
        "ids": ids,
        "conclusion": job.get("conclusion"),
        "job_id": job.get("id"),
        "url": job.get("html_url"),
        "persisted": persisted,
    }


def report(text):
    """The `state-read` report in `text`, or None when it is empty, not JSON, or not that
    shape: every class a list of check names, `refused` a name-to-reason object, and no name
    in two places."""
    try:
        parsed = json.loads(text) if isinstance(text, str) else None
    except ValueError:
        return None
    if not isinstance(parsed, dict) or set(parsed) != {*_CLASSES, "refused"}:
        return None
    lists = [parsed[c] for c in _CLASSES]
    refused = parsed["refused"]
    if not all(isinstance(names, list) for names in lists) or not isinstance(refused, dict):
        return None
    names = [n for names in lists for n in names] + list(refused)
    texts = names + list(refused.values())
    if not all(isinstance(x, str) for x in texts) or len(set(names)) != len(names):
        return None
    return parsed


def reports(raw):
    """`{wave key: report or None}` from `SHIPMATE_WAVE_STATE_JSON`, each value the reader's
    `report` output as a JSON string, `""` when it is absent."""
    try:
        waves = json.loads(raw)
    except ValueError:
        waves = None
    if not isinstance(waves, dict):
        raise SystemExit("::error::wave-state must be a JSON object of state-read reports")
    return {wave: report(text) for wave, text in waves.items()}


def persisted(check, found, conclusion, legs):
    """None when the cell left no state to save or its saver leg saved it; else
    `{"reason", "leg_id"}`. `found` is the wave's report (None when absent), `conclusion` the
    cell job's, `legs` the cell's listed saver legs, each with a conclusion. A cell that ran
    successfully without applying exists only through a forged line, so it has a reason."""
    if found is None:
        return {"reason": READER_UNFINISHED, "leg_id": None}
    if check in found["refused"]:
        return {"reason": found["refused"][check], "leg_id": None}
    if check in found["none"] or check in found["not_run"]:
        return None
    if check in found["not_applied"]:
        if conclusion == "success":
            return {"reason": UNAPPLIED_SUCCESS, "leg_id": None}
        return None
    if check in found["state"]:
        if any(j.get("conclusion") == "success" for j in legs):
            return None
        leg = legs[-1]
        return {"reason": f"the saver job concluded {leg['conclusion']}", "leg_id": leg.get("id")}
    return {"reason": UNCLASSIFIED, "leg_id": None}


def _leg_lagging(check, found, legs):
    """Whether the cell's saver leg is what the listing has not shown yet: the cell has a
    state to save and no leg is listed with a conclusion, so the caller asks again."""
    saved = found is not None and check in found["state"]
    return saved and (not legs or any(j.get("conclusion") is None for j in legs))


def unexpanded(jobs, job_id):
    """Whether `jobs` holds a `cancelled` literal unexpanded wave row of the level of the job
    `job_id`. Every wave of a level shares that name, so the row does not say which wave."""
    own = next((j.get("name", "") for j in jobs if str(j.get("id")) == str(job_id)), "")
    level = own.rpartition(" / ")[0]
    row = level + " / " + UNEXPANDED
    return bool(level) and any(
        j.get("name") == row and j.get("conclusion") == "cancelled" for j in jobs
    )


def classify(by_wave, results, jobs, job_id, states):
    """`(rows, unresolved)` for the cells of the waves keyed in `results`, each wave's job
    result, from the jobs listing `jobs` that holds this job, `job_id`, and `states`, each
    wave's `report` (`reports`): `unresolved` labels the cells with no resolved row, each listed
    without a conclusion, or with a state whose saver leg is not listed with one, also getting
    an `unresolved` row. Each row carries `persisted` for its cell."""
    literal = unexpanded(jobs, job_id)
    rows, unresolved = [], []
    for wave in sorted(results):
        cells = [
            (
                check,
                ids,
                [j for j in jobs if ag.is_cell_job(j.get("name", ""), *ag.parse_check_name(check))],
            )
            for check, ids in sorted((by_wave.get(wave) or {}).items())
        ]
        # An expanded matrix lists all its cells at once, so a cell missing beside a listed
        # sibling is a lagging listing, not a wave that never started.
        started = any(matched for _, _, matched in cells)
        not_run = results[wave] == "skipped" or (
            results[wave] == "cancelled" and literal and not started
        )
        found = states.get(wave)
        for check, ids, matched in cells:
            legs = [
                j for j in jobs if ag.is_leg_job(j.get("name", ""), *ag.parse_check_name(check))
            ]
            won = next((j for j in matched if j.get("conclusion") == "success"), None)
            job = won or (matched[-1] if matched else None)
            if not matched and not not_run:
                unresolved.append(check.removeprefix(ag.APPLY_PREFIX))
            elif (any(j.get("conclusion") is None for j in matched) and not won) or _leg_lagging(
                check, found, legs
            ):
                unresolved.append(check.removeprefix(ag.APPLY_PREFIX))
                rows.append({**_row(check, ids), "unresolved": True})
            else:
                conclusion = job and job.get("conclusion")
                rows.append(_row(check, ids, job, persisted(check, found, conclusion, legs)))
    return rows, sorted(unresolved)


def error_line(job_id, repo):
    """`Failed: <message>` from the first `failure` annotation of the check run `job_id`: the
    message's first line, control characters stripped, cut at `ERROR_LINE_CAP` characters.
    `Failed` alone when there is none or the read fails: the title only names the error, the
    outcome comes from the job's conclusion, so this read degrades instead of failing."""
    if not isinstance(job_id, int):
        return "Failed"
    try:
        notes = gh_json(f"repos/{repo}/check-runs/{job_id}/annotations?per_page=100", retry=False)
    except SystemExit as exc:
        why = command_data(str(exc.code).removeprefix("::error::"))
        print(f"::warning::could not read the annotations of job {job_id}: {why}", file=sys.stderr)
        return "Failed"
    message = next(
        (a.get("message") or "" for a in notes if a.get("annotation_level") == "failure"), ""
    )
    first = (message.splitlines() or [""])[0]
    line = "".join(c for c in first if unicodedata.category(c) != "Cc").strip()
    return f"Failed: {line[:ERROR_LINE_CAP]}" if line else "Failed"


def _lost_reason(why, repo):
    """The reason in a `state not saved` title: a failed leg's first error line when it has
    one."""
    if why["leg_id"] is not None:
        line = error_line(why["leg_id"], repo)
        if line != "Failed":
            return line.removeprefix("Failed: ")
    return why["reason"]


def writes(row, repo):
    """The `patch-checks` entries for `row`, one per check id. A cell that ran with a
    `persisted` reason returns to `queued` titled `ag.lost_state_title`, whatever its own
    outcome."""
    conclusion, why = row["conclusion"], row["persisted"]
    if why and conclusion in ("success", "failure", "cancelled"):
        reason = _lost_reason(why, repo)
        body, title = {"status": "queued"}, ag.lost_state_title(conclusion == "cancelled", reason)
    elif conclusion == "success":
        body, title = {"status": "completed", "conclusion": "success"}, None
    elif conclusion == "failure":
        body, title = {"status": "queued"}, error_line(row["job_id"], repo)
    elif conclusion == "cancelled":
        body, title = {"status": "queued"}, "Cancelled"
    elif conclusion in (None, "skipped"):
        body, title = {"status": "queued"}, "Not run"
    else:
        body, title = {"status": "queued"}, f"Not applied ({conclusion})"
    if conclusion in ("success", "failure") and row["url"]:
        body["details_url"] = row["url"]
    return [{"id": cid, "body": body, "title": title} for cid in row["ids"]]


def merge(every):
    """One row per check of `every`, each attempt's rows in order: a `success` row from any
    attempt, else the last row seen for it, and none when that row is `unresolved`. A later,
    staler or failed listing never downgrades a success nor drops an outcome an earlier attempt
    saw; a later attempt that lists the cell's job without a conclusion withholds it."""
    out = {r["check"]: r for r in every}
    out.update({r["check"]: r for r in every if r["conclusion"] == "success"})
    return [out[check] for check in sorted(out) if not out[check].get("unresolved")]


def _rows(path):
    with open(path, encoding="utf-8") as fh:
        return ag.parse_jsonl(fh)


def plan(every_path):
    repo = os.environ["GITHUB_REPOSITORY"]
    for row in merge(_rows(every_path)):
        for entry in writes(row, repo):
            print(json.dumps(entry))


def fetch_jobs():
    """Every job of this run as `gh api`'s raw JSON lines, from one paginated call. Raises
    SystemExit naming the cause on a failed call or an empty listing: the listing lags a
    finished job, and a failed or empty one is the extreme form of that lag."""
    repo, run_id = os.environ["GITHUB_REPOSITORY"], os.environ["GITHUB_RUN_ID"]
    path = f"repos/{repo}/actions/runs/{run_id}/jobs?per_page=100"
    listing = run(["gh", "api", "--paginate", "--jq", ".jobs[]", path])
    if not listing.strip():
        raise SystemExit(EMPTY_LISTING)
    return listing


def list_jobs():
    """Print every job of this run, one JSON object per line, unvalidated (`fetch_jobs`). A
    failure prints its cause as one `::error::` and a `RETRY_PREFIX` line, except an empty
    listing, which prints only the `RETRY_PREFIX` line. Both exit `UNRESOLVED_EXIT`. The
    caller's loop is the only retry."""
    try:
        listing = fetch_jobs()
    except SystemExit as exc:
        cause = one_line(exc.code)
        if cause != EMPTY_LISTING:
            print_annotated(f"::error::{cause}")
        print(RETRY_PREFIX + cause, file=sys.stderr)
        sys.exit(UNRESOLVED_EXIT)
    sys.stdout.write(listing)


def verdict(rows_path):
    """Refuse when any cell of the waves in `SHIPMATE_WAVE_RESULTS_JSON` has a `persisted`
    reason or no resolved row, whatever its job's conclusion, naming each cell and its reason;
    no write. A failed cell whose state was saved passes: its failed wave stops the next
    release anyway."""
    by_wave = json.loads(os.environ["SHIPMATE_BY_WAVE_JSON"])
    waves = json.loads(os.environ["SHIPMATE_WAVE_RESULTS_JSON"])
    merged = {r["check"]: r for r in merge(_rows(rows_path))}
    lost = []
    for wave in sorted(waves):
        for check in sorted(by_wave.get(wave) or {}):
            row = merged.get(check)
            why = "the jobs listing never resolved the cell" if row is None else None
            why = why or (row["persisted"] or {}).get("reason")
            if why:
                lost.append(f"{check.removeprefix(ag.APPLY_PREFIX)} ({why})")
    if lost:
        raise SystemExit(
            "::error::"
            + one_line(f"no saved state was found for these cells: {'; '.join(lost)}. ")
            + NEVER_RERUN
        )


def stranded(reasons_path):
    """Refuse with the `RETRY_PREFIX` reasons in `reasons_path` on one line: they hold gh's
    stderr and stack names raw, and `run_annotated` prints the refusal escaped."""
    with open(reasons_path, encoding="utf-8") as fh:
        reasons = one_line(fh.read())
    raise SystemExit(
        f"::error::the retries were exhausted and these apply checks are left pending: {reasons}"
    )


def command(argv):
    """Run the subcommand `argv` names, or refuse with the usage."""
    commands = {"plan": plan, "stranded": stranded, "verdict": verdict}
    if argv == ["list"]:
        list_jobs()
    elif len(argv) == 2 and argv[0] in commands:
        commands[argv[0]](argv[1])
    else:
        raise SystemExit(
            "::error::usage: apply-complete [list | plan <rows> | verdict <rows> | stranded "
            "<reasons>]"
        )


def main(argv=()):
    if argv:
        command(argv)
        return
    if os.environ.get("SHIPMATE_MODE") not in ("complete", "verdict"):
        raise SystemExit("::error::mode must be complete or verdict")
    try:
        results = json.loads(os.environ["SHIPMATE_WAVE_RESULTS_JSON"])
    except ValueError:
        results = None
    if not isinstance(results, dict) or not results:
        raise SystemExit("::error::wave-results must be a non-empty JSON object of wave results")
    rows, unresolved = classify(
        json.loads(os.environ["SHIPMATE_BY_WAVE_JSON"]),
        results,
        ag.parse_jsonl(sys.stdin),
        os.environ["SHIPMATE_JOB_ID"],
        reports(os.environ["SHIPMATE_WAVE_STATE_JSON"]),
    )
    for row in rows:
        print(json.dumps(row))
    if unresolved:
        print(
            RETRY_PREFIX
            + "the jobs listing shows no conclusion for these cells of waves that ran: "
            + ", ".join(unresolved),
            file=sys.stderr,
        )
        sys.exit(UNRESOLVED_EXIT)


if __name__ == "__main__":
    run_annotated(main, sys.argv[1:])
