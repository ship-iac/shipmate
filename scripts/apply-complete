#!/usr/bin/env python3
"""Decide each apply check's write from its cell's `apply` and `save` jobs in THIS run.

`apply-complete list` prints this run's jobs listing, every attempt, one job per line;
`apply-complete` reads that listing on stdin and prints one row per decided cell;
`apply-complete plan <rows>` turns every attempt's rows into the `patch-checks` write plan;
`apply-complete stranded <reasons>` refuses with the reasons no attempt resolved;
`apply-complete unflip <first key>` reads that listing on stdin and prints the rows of the first
stage, `<first key>`, for `apply-run.yml`'s `unflip` (`unflip`);
`apply-complete own <by_wave> <stack> <env> <job id>` prints the `success` writes of one cell
whose `apply` job `<job id>` succeeded and whose state is saved, for that cell's own `save` job
(`own`).

Evidence is `GET /actions/runs/{id}/jobs?filter=all`, not the cells' own artifacts: a job
conclusion is written by GitHub, so one cell cannot claim another applied. A cell lying about
itself by exiting 0 is irreducible and is the trust level of every per-cell completion.

A cell's jobs are `<stage> / <env> / <stack> / apply` and `... / save` (`apply-gate.cell_rows`),
`<stage>` being the stage path of this job, `<caller> / run / waves / L<i>-W<w> / complete`
(`apply-gate.level_of`; `SHIPMATE_JOB_ID`, this job's check run id, names it), so a listing that
does not list this job matches no cell. The write reads the rows of this job's run attempt. The
cells are those of the stage keyed in `SHIPMATE_WAVE_RESULTS_JSON`, `{stage key: result of its
cell matrix}`, read from `SHIPMATE_BY_WAVE_JSON`, `apply-snapshot`'s `by_wave`. When
`SHIPMATE_ENTRY_PHASE` is `refused`, the stage was never released: it prints a notice and no row.

Per cell, in this order:

1. A row without a conclusion, or an `apply` row without a `save` row or the reverse (except
   an `apply` row cancelled with no steps), is unresolved: the listing lags a finished job, so
   the caller asks again. Read before the hold, since a lagging row reads as an unsaved apply.
2. Any attempt of the run that `apply-gate.unsaved` names holds the check: `in_progress`,
   titled `apply-gate.HELD_TITLE`, linked to the run page, the only link the hold's readers
   parse. This covers a re-run whose own rows read refused after an unsaved attempt.
3. Otherwise:

| `apply` row | `save` row's state (`apply-gate.state_safe`) | Write (`plan`) |
| --- | --- | --- |
| `success` | safe | `completed`/`success`, the `apply` job's URL, the record title |
| `failure` | safe | `queued`, `Failed: <first error line>` of the `apply` job |
| `cancelled` | safe | `queued`, `Cancelled` |
| other conclusion | safe | `queued`, `Not applied (<conclusion>)`: never `success` |
| any, never applied | not safe | `queued`, `Failed: <first error line>` of the `save` job |
| `cancelled`, no steps | none | `queued`, `Cancelled` (cancelled while pending) |
| none | none | `queued`, `Not run` when the wave did not run, else unresolved |

A wave that did not run (a failed or skipped release, a failed earlier wave, a cancel before it
started) lists one row under its literal `${{ matrix.environment }} / ${{ matrix.stack }}` name,
since GitHub expands a matrix only for a job it starts, so its cells match nothing and are not
run. That holds for every `skipped` wave; a `cancelled` wave may have started, so its missing
cell is not run only when this attempt lists that literal row, `cancelled`, under this job's
level and lists no cell of the same wave. Any other missing cell is a lost or lagging listing: it
is retried. `plan` takes, per cell, a `success` row from any attempt; else a held row from any
attempt; else the last row any attempt printed for it, so a resolved outcome an earlier attempt
saw is written unless a later attempt listed the cell unresolved, which writes nothing. A cell
no attempt resolved gets no write, so a stale listing never turns a completed `success` back to
`queued`. Accepted limit: when every cell of a cancelled wave is missing while that literal row is
listed, the cells are written `Not run` even if one started before the cancel; the check returns
to `queued` either way, and only the title differs.

`unflip` runs as `<caller> / run / unflip` and reads the first stage `<caller> / run / waves /
<first key>`. It prints no row when that stage's `complete` job of this attempt concluded
`success` or `skipped`; otherwise it classifies that stage as `skipped` when no attempt lists a
cell job of it, else as started, so a missing cell beside a listed one is retried.
"""

import json
import os
import re
import sys
import unicodedata

from _shipmate import (
    _load,
    command_data,
    current_run_url,
    gh_json,
    is_run_id,
    is_transient,
    one_line,
    print_annotated,
    run,
    run_annotated,
)

ag = _load("apply-gate")

UNRESOLVED_EXIT = 75  # EX_TEMPFAIL; not 2, which CPython itself exits with.
# The one channel that says "ask me again, and here is why". The caller greps this prefix out
# of stderr to annotate what it gave up on after its retries, so it is a line-anchored
# contract, not a message.
RETRY_PREFIX = "retry: "
UNEXPANDED = "${{ matrix.environment }} / ${{ matrix.stack }}"
ERROR_LINE_CAP = 120


def _row(check, ids, job=None):
    job = job or {}
    return {
        "check": check,
        "ids": ids,
        "conclusion": job.get("conclusion"),
        "job_id": job.get("id"),
        "url": job.get("html_url"),
    }


def unexpanded(jobs, level, attempt):
    """Whether `jobs` holds a `cancelled` literal unexpanded cell matrix row of the stage path
    `level` in run attempt `attempt`."""
    row = level + " / " + UNEXPANDED
    return bool(level) and any(
        j.get("name") == row
        and j.get("conclusion") == "cancelled"
        and j.get("run_attempt") == attempt
        for j in jobs
    )


def _decide(check, ids, own, jobs, not_run):
    """The row of the cell `check` from `own`, its `apply` and `save` rows of this attempt,
    and `jobs`, the whole listing; None when it is missing from a wave that ran."""
    applies, saves = own["apply"], own["save"]
    pending_cancel = (
        len(applies) == 1
        and not saves
        and applies[0].get("conclusion") == "cancelled"
        and applies[0].get("steps") == []
    )
    lagging = any(j.get("conclusion") is None for j in applies + saves)
    if lagging or (bool(applies) != bool(saves) and not pending_cancel):
        return {**_row(check, ids), "unresolved": True}
    if ag.unsaved(jobs, *ag.parse_check_name(check)):
        return {**_row(check, ids), "held": True}
    if not applies:
        return _row(check, ids) if not_run else None
    if pending_cancel or ag.state_safe(saves[-1]):
        return _row(check, ids, applies[-1])
    # Not held, so this attempt did not apply: the save itself failed.
    return _row(check, ids, {**saves[-1], "conclusion": "failure"})


def classify(by_wave, results, jobs, level, attempt):
    """`(rows, unresolved)` for the cells of the stages keyed in `results`, each stage's cell
    matrix result, from the jobs listing `jobs`, reading the rows under the stage path `level` of
    run attempt `attempt`: `unresolved` labels the cells with no resolved row, each listed
    without one also getting an `unresolved` row. Refuses a stage key `by_wave` lacks, as
    `apply-release release` does: its released checks would stay `in_progress`."""
    literal = unexpanded(jobs, level, attempt)
    rows, unresolved = [], []
    for wave in sorted(results):
        if wave not in by_wave:
            raise SystemExit(f"::error::the stage snapshot holds no stage {wave!r}")
        cells = []
        for check, ids in sorted((by_wave[wave] or {}).items()):
            both = ag.cell_rows(jobs, level, *ag.parse_check_name(check))
            own = {
                part: [j for j in listed if j.get("run_attempt") == attempt]
                for part, listed in both.items()
            }
            cells.append((check, ids, own))
        # An expanded matrix lists all its cells at once, so a cell missing beside a listed
        # sibling is a lagging listing, not a wave that never started.
        started = any(own["apply"] or own["save"] for _, _, own in cells)
        not_run = results[wave] == "skipped" or (
            results[wave] == "cancelled" and literal and not started
        )
        for check, ids, own in cells:
            decided = _decide(check, ids, own, jobs, not_run)
            if decided is not None:
                rows.append(decided)
            if decided is None or decided.get("unresolved"):
                unresolved.append(check.removeprefix(ag.APPLY_PREFIX))
    return rows, sorted(unresolved)


def _own(jobs, job_id):
    """The listed job `job_id` of `jobs`, or {} when it is not listed."""
    return next((j for j in jobs if str(j.get("id")) == str(job_id)), {})


def unflip(by_wave, jobs, job_id, key):
    """`(rows, unresolved)` of the first stage `key` for `unflip`, the listed job `job_id`
    (module docstring). Exits `UNRESOLVED_EXIT` when `jobs` does not list that job; refuses one
    whose name does not end in the segment `unflip`, or a key that is not `apply-gate.STAGE`."""
    own = _own(jobs, job_id)
    if not own:
        print(RETRY_PREFIX + "the run jobs listing does not list this unflip job", file=sys.stderr)
        sys.exit(UNRESOLVED_EXIT)
    name = own.get("name", "")
    if name.split(" / ")[-1] != "unflip" or not re.fullmatch(ag.STAGE, key):
        raise SystemExit("::error::unflip needs its own job named '... / unflip' and a stage key")
    stage = name.removesuffix("unflip") + f"waves / {key}"
    attempt = own.get("run_attempt")
    if any(
        j.get("name") == f"{stage} / complete"
        and j.get("run_attempt") == attempt
        and j.get("conclusion") in ("success", "skipped")
        for j in jobs
    ):
        return [], []
    cell_job = rf"{re.escape(stage)} / .+ / .+ / (?:apply|save)"
    started = any(re.fullmatch(cell_job, j.get("name", "")) for j in jobs)
    return classify(by_wave, {key: "started" if started else "skipped"}, jobs, stage, attempt)


def error_line(job_id, repo):
    """`Failed: <message>` from the first `failure` annotation of the check run `job_id`: the
    message's first line, control characters stripped, cut at `ERROR_LINE_CAP` characters.
    `Failed` alone when there is none or the read fails: the title only names the error, the
    outcome comes from the job's conclusion, so this read degrades instead of failing."""
    if not isinstance(job_id, int):
        return "Failed"
    try:
        notes = gh_json(f"repos/{repo}/check-runs/{job_id}/annotations?per_page=100", retry=False)
    except SystemExit as exc:
        why = command_data(str(exc.code).removeprefix("::error::"))
        print(f"::warning::could not read the annotations of job {job_id}: {why}", file=sys.stderr)
        return "Failed"
    message = next(
        (a.get("message") or "" for a in notes if a.get("annotation_level") == "failure"), ""
    )
    first = (message.splitlines() or [""])[0]
    line = "".join(c for c in first if unicodedata.category(c) != "Cc").strip()
    return f"Failed: {line[:ERROR_LINE_CAP]}" if line else "Failed"


def writes(row, repo):
    """The `patch-checks` entries for `row`, one per check id. A held entry carries `held`."""
    if row.get("held"):
        body = {"status": "in_progress", "details_url": current_run_url()}
        return [
            {"id": cid, "body": body, "title": ag.HELD_TITLE, "held": True} for cid in row["ids"]
        ]
    conclusion = row["conclusion"]
    if conclusion == "success":
        body, title = {"status": "completed", "conclusion": "success"}, None
    elif conclusion == "failure":
        body, title = {"status": "queued"}, error_line(row["job_id"], repo)
    elif conclusion == "cancelled":
        body, title = {"status": "queued"}, "Cancelled"
    elif conclusion in (None, "skipped"):
        body, title = {"status": "queued"}, "Not run"
    else:
        body, title = {"status": "queued"}, f"Not applied ({conclusion})"
    if conclusion in ("success", "failure") and row["url"]:
        body["details_url"] = row["url"]
    return [{"id": cid, "body": body, "title": title} for cid in row["ids"]]


def merge(every):
    """One row per check of `every`, each attempt's rows in order: a `success` row from any
    attempt, else a held row from any attempt, else the last row seen for it, and none when that
    row is `unresolved`. A later, staler or failed listing never downgrades a success or a hold
    nor drops an outcome an earlier attempt saw; a later attempt that lists the cell's job without
    a conclusion withholds it."""
    out = {r["check"]: r for r in every}
    out.update({r["check"]: r for r in every if r.get("held")})
    out.update({r["check"]: r for r in every if r["conclusion"] == "success"})
    return [out[check] for check in sorted(out) if not out[check].get("unresolved")]


def _rows(path):
    with open(path, encoding="utf-8") as fh:
        return ag.parse_jsonl(fh)


def plan(every_path):
    repo = os.environ["GITHUB_REPOSITORY"]
    for row in merge(_rows(every_path)):
        for entry in writes(row, repo):
            print(json.dumps(entry))


def _cell_ids(by_wave_json, name):
    """The check ids of the cell `name` in `by_wave_json`, `apply-snapshot`'s `by_wave`, matched
    exactly, so names differing only in case stay apart. Refuses when the name is in no wave or
    in two, or its ids are not a non-empty list of positive integers."""
    try:
        by_wave = json.loads(by_wave_json)
    except ValueError:
        by_wave = None
    if not isinstance(by_wave, dict):
        raise SystemExit("::error::by_wave is not a JSON object of waves")
    found = [cells[name] for cells in by_wave.values() if isinstance(cells, dict) and name in cells]
    if len(found) != 1:
        raise SystemExit(f"::error::{name} is listed in {len(found)} waves of by_wave, not one")
    ids = found[0]
    if not (
        isinstance(ids, list)
        and ids
        and all(isinstance(i, int) and not isinstance(i, bool) and i > 0 for i in ids)
    ):
        raise SystemExit(f"::error::the apply-check ids of {name} are not a non-empty list of ids")
    return ids


def own(by_wave_json, stack, env, job_id):
    """Print the `patch-checks` entries completing the checks of the cell `stack` in `env`
    (`_cell_ids`), `success` and linked to the `apply` job `job_id` of this run, through
    `writes`, which restores the record title. Refuses a `job_id` that is not 1 to 20 digits:
    `apply` runs pull-request code, and the id is bound into a link."""
    ids = _cell_ids(by_wave_json, ag.check_name(stack, env))
    if not is_run_id(job_id):
        raise SystemExit("::error::the apply job id is not 1 to 20 digits")
    url = f"{current_run_url()}/job/{job_id}"
    row = {"check": "", "ids": ids, "conclusion": "success", "job_id": int(job_id), "url": url}
    for entry in writes(row, os.environ["GITHUB_REPOSITORY"]):
        print(json.dumps(entry))


def list_jobs():
    """Print every job of every attempt of this run, one JSON object per line, from one paginated
    `gh api` call, unvalidated. A failure `_shipmate.is_transient` reads as permanent (a 403, a
    404) refuses at once. A transient one prints its cause as one `::error::` and a
    `RETRY_PREFIX` line; an empty listing prints a `RETRY_PREFIX` line. Both exit
    `UNRESOLVED_EXIT`: the listing lags a finished job, and a failed or empty one is the extreme
    form of that lag. The caller's loop is the only retry."""
    repo, run_id = os.environ["GITHUB_REPOSITORY"], os.environ["GITHUB_RUN_ID"]
    path = f"repos/{repo}/actions/runs/{run_id}/jobs?filter=all&per_page=100"
    try:
        listing = run(["gh", "api", "--paginate", "--jq", ".jobs[]", path])
    except SystemExit as exc:
        cause = one_line(exc.code)
        if not is_transient(exc):
            raise SystemExit(f"::error::{cause}") from None
        print_annotated(f"::error::{cause}")
        print(RETRY_PREFIX + cause, file=sys.stderr)
        sys.exit(UNRESOLVED_EXIT)
    if not listing.strip():
        print(
            RETRY_PREFIX + "the run jobs listing came back empty; "
            "cannot tell which wave cells succeeded",
            file=sys.stderr,
        )
        sys.exit(UNRESOLVED_EXIT)
    sys.stdout.write(listing)


def stranded(reasons_path):
    """Refuse with the `RETRY_PREFIX` reasons in `reasons_path` on one line: they hold gh's
    stderr and stack names raw, and `run_annotated` prints the refusal through `print_annotated`,
    whose `command_data` escapes it."""
    with open(reasons_path, encoding="utf-8") as fh:
        reasons = one_line(fh.read())
    raise SystemExit(
        f"::error::the retries were exhausted and these apply checks are left pending: {reasons}"
    )


def _print_rows(rows, unresolved):
    for row in rows:
        print(json.dumps(row))
    if unresolved:
        print(
            RETRY_PREFIX
            + "the jobs listing shows no conclusion for these cells of waves that ran: "
            + ", ".join(unresolved),
            file=sys.stderr,
        )
        sys.exit(UNRESOLVED_EXIT)


def _unflip_mode(key):
    jobs = ag.parse_jsonl(sys.stdin)
    by_wave = json.loads(os.environ["SHIPMATE_BY_WAVE_JSON"])
    _print_rows(*unflip(by_wave, jobs, os.environ["SHIPMATE_JOB_ID"], key))


MODES = {
    "list": (0, list_jobs),
    "plan": (1, plan),
    "stranded": (1, stranded),
    "own": (4, own),
    "unflip": (1, _unflip_mode),
}


def main(argv=()):
    if argv:
        count, mode = MODES.get(argv[0], (None, None))
        if len(argv) - 1 != count:
            raise SystemExit(
                "::error::usage: apply-complete [list | plan <rows> | stranded <reasons> | "
                "own <by_wave> <stack> <env> <job id> | unflip <first key>]"
            )
        mode(*argv[1:])
        return
    if os.environ.get("SHIPMATE_ENTRY_PHASE") == "refused":
        print(
            "::notice::the stage was refused before its release, so no check is written",
            file=sys.stderr,
        )
        return
    try:
        results = json.loads(os.environ["SHIPMATE_WAVE_RESULTS_JSON"])
    except ValueError:
        results = None
    if not isinstance(results, dict) or not results:
        raise SystemExit("::error::wave-results must be a non-empty JSON object of wave results")
    jobs = ag.parse_jsonl(sys.stdin)
    job_id = os.environ["SHIPMATE_JOB_ID"]
    level = ag.level_of(jobs, job_id)
    by_wave = json.loads(os.environ["SHIPMATE_BY_WAVE_JSON"])
    _print_rows(*classify(by_wave, results, jobs, level, _own(jobs, job_id).get("run_attempt")))


if __name__ == "__main__":
    run_annotated(main, sys.argv[1:])
