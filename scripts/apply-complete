#!/usr/bin/env python3
"""Decide each apply check's write from the state of its cell's wave job in THIS run.

`apply-complete` reads the run's jobs listing on stdin and prints one row per decided cell;
`apply-complete plan <all rows> <last rows>` turns rows into the `patch-checks` write plan.

Evidence is `GET /actions/runs/{id}/jobs`, not the cells' own artifacts: a job
conclusion is written by GitHub, so one cell cannot claim another applied. A
cell lying about itself by exiting 0 is irreducible and is the trust level the
per-cell completion already had.

Job names are matched as `L<n> / <env> / <stack>` suffixes
(`apply-gate.is_cell_job`) because a called workflow's jobs display as
`<caller job> / <called job> / <matrix job>`, one segment per call level
(`apply / run / L<n> / ...`): `apply-run.yml` and `deploy.yml` name the level
`L<n>`, and CONTRACT.md pins the matrix job's own name to `<env> / <stack>`, read
from the snapshot's check name with `apply-gate.parse_check_name`. Requiring the
level and a ` / ` boundary, not a bare `str.endswith`, keeps out a job of env
`dev-eu` for env `eu` and a non-wave job such as `apply / run / detect` for env
`run` and stack `detect`; either would complete a check its own apply never earned.

The cells are those of the waves named in `SHIPMATE_RELEASES_JSON`, `{wave key: result of its
release job}`, read from `SHIPMATE_BY_WAVE_JSON`, `apply-snapshot`'s `by_wave`. A release that
ended `failure` or `cancelled` stops its wave and every later one: their cells are not run,
whatever the listing says. Every other cell takes the row of its matched job:

| Matched job | Row `conclusion` | Write (`plan`) |
| --- | --- | --- |
| any `success` | `success` | `completed`/`success`, the job's URL, the record title |
| `failure` | `failure` | `queued`, `Failed: <first error line>`, the job's URL |
| `cancelled` | `cancelled` | `queued`, `Cancelled` |
| `skipped`, or none | `skipped` / null | `queued`, `Not run` |
| any other conclusion | itself | `queued`, `Not applied (<conclusion>)`: never `success` |
| no conclusion yet | no row | none; `main` exits `UNRESOLVED_EXIT` |

A job with no conclusion yet is the listing lagging, by seconds, a job that has already ended,
so the caller asks again. No matching job is skip-propagation: GitHub expands a matrix only for
a job it starts, so a skipped wave lists one row under its literal `${{ matrix.environment }} /
${{ matrix.stack }}` name. A lost or truncated listing looks the same, so a listing that matches
none of the cells not stopped by a release is retried and then fails the run: a run always
lists its own wave jobs. Those cells then get no row.
"""

import json
import os
import sys
import unicodedata

from _shipmate import _load, command_data, gh_json, run_annotated

ag = _load("apply-gate")

UNRESOLVED_EXIT = 75  # EX_TEMPFAIL; not 2, which CPython itself exits with.
# The one channel that says "ask me again, and here is why". The caller greps this prefix out
# of stderr to annotate what it gave up on after its retries, so it is a line-anchored
# contract, not a message.
RETRY_PREFIX = "retry: "
STOPPED = ("failure", "cancelled")
ERROR_LINE_CAP = 120


def _row(check, ids, job=None):
    job = job or {}
    return {
        "check": check,
        "ids": ids,
        "conclusion": job.get("conclusion"),
        "job_id": job.get("id"),
        "url": job.get("html_url"),
    }


def classify(by_wave, releases, jobs):
    """`(rows, unresolved, floor)` for the cells of the waves keyed in `releases`, from the
    jobs listing `jobs`: `unresolved` labels the cells with no conclusion yet, and `floor` is
    True when no cell outside a stopped wave matched a job, in which case only stopped cells
    get rows."""
    stop = min((w for w, r in releases.items() if r in STOPPED), default=None)
    stopped, rows, unresolved, unmatched = [], [], [], 0
    for wave in sorted(releases):
        for check, ids in sorted((by_wave.get(wave) or {}).items()):
            if stop is not None and wave >= stop:
                stopped.append(_row(check, ids))
                continue
            matched = [
                j for j in jobs if ag.is_cell_job(j.get("name", ""), *ag.parse_check_name(check))
            ]
            won = next((j for j in matched if j.get("conclusion") == "success"), None)
            if won:
                rows.append(_row(check, ids, won))
            elif not matched:
                unmatched += 1
                rows.append(_row(check, ids))
            elif any(j.get("conclusion") is None for j in matched):
                unresolved.append(check.removeprefix(ag.APPLY_PREFIX))
            else:
                rows.append(_row(check, ids, matched[-1]))
    floor = bool(rows) and unmatched == len(rows) and not unresolved
    return stopped + ([] if floor else rows), sorted(unresolved), floor


def error_line(job_id, repo):
    """`Failed: <message>` from the first `failure` annotation of the check run `job_id`: the
    message's first line, control characters stripped, cut at `ERROR_LINE_CAP` characters.
    `Failed` alone when there is none or the read fails: the title only names the error, the
    outcome comes from the job's conclusion, so this read degrades instead of failing."""
    if not isinstance(job_id, int):
        return "Failed"
    try:
        notes = gh_json(f"repos/{repo}/check-runs/{job_id}/annotations?per_page=100", retry=False)
    except SystemExit as exc:
        why = command_data(str(exc.code).removeprefix("::error::"))
        print(f"::warning::could not read the annotations of job {job_id}: {why}", file=sys.stderr)
        return "Failed"
    message = next(
        (a.get("message") or "" for a in notes if a.get("annotation_level") == "failure"), ""
    )
    first = (message.splitlines() or [""])[0]
    line = "".join(c for c in first if unicodedata.category(c) != "Cc").strip()
    return f"Failed: {line[:ERROR_LINE_CAP]}" if line else "Failed"


def writes(row, repo):
    """The `patch-checks` entries for `row`, one per check id."""
    conclusion = row["conclusion"]
    if conclusion == "success":
        body, title = {"status": "completed", "conclusion": "success"}, None
    elif conclusion == "failure":
        body, title = {"status": "queued"}, error_line(row["job_id"], repo)
    elif conclusion == "cancelled":
        body, title = {"status": "queued"}, "Cancelled"
    elif conclusion in (None, "skipped"):
        body, title = {"status": "queued"}, "Not run"
    else:
        body, title = {"status": "queued"}, f"Not applied ({conclusion})"
    if conclusion in ("success", "failure") and row["url"]:
        body["details_url"] = row["url"]
    return [{"id": cid, "body": body, "title": title} for cid in row["ids"]]


def merge(every, last):
    """One row per check: a `success` row from any attempt in `every`, else its row in `last`.
    A later, staler listing never downgrades a success."""
    out = {r["check"]: r for r in last}
    out.update({r["check"]: r for r in every if r["conclusion"] == "success"})
    return [out[check] for check in sorted(out)]


def _rows(path):
    with open(path, encoding="utf-8") as fh:
        return ag.parse_jsonl(fh)


def plan(every_path, last_path):
    repo = os.environ["GITHUB_REPOSITORY"]
    for row in merge(_rows(every_path), _rows(last_path)):
        for entry in writes(row, repo):
            print(json.dumps(entry))


def main(argv=()):
    if argv:
        if argv[0] != "plan" or len(argv) != 3:
            raise SystemExit("::error::usage: apply-complete [plan <all rows> <last rows>]")
        plan(argv[1], argv[2])
        return
    rows, unresolved, floor = classify(
        json.loads(os.environ["SHIPMATE_BY_WAVE_JSON"]),
        json.loads(os.environ["SHIPMATE_RELEASES_JSON"]),
        ag.parse_jsonl(sys.stdin),
    )
    for row in rows:
        print(json.dumps(row))
    if floor:
        print(
            RETRY_PREFIX + "no cell matched a job in this run's listing. A run always lists its "
            "own wave jobs, so the listing cannot be trusted; refusing to write over it",
            file=sys.stderr,
        )
        sys.exit(UNRESOLVED_EXIT)
    if unresolved:
        print(
            RETRY_PREFIX
            + "the jobs listing reported no conclusion for these cells: "
            + ", ".join(unresolved),
            file=sys.stderr,
        )
        sys.exit(UNRESOLVED_EXIT)


if __name__ == "__main__":
    run_annotated(main, sys.argv[1:])
