#!/usr/bin/env python3
"""Build the apply result comment: a verdict line, then one line or fold-out per cell.

Reads the run's jobs listing as JSON Lines on stdin (one object per line,
keys `name`/`html_url`, as emitted by `gh api --paginate .../jobs --jq
'.jobs[]'`), per-cell `apply-summary.*` artifacts from the $CELLS directory,
the expected-cell set (per-env-level waves JSON), the head SHA,
the excluded/skipped/held envs (bare form only) and the ungated and no-review envs,
and writes a fresh comment.md -- this comment is never upserted, unlike the plan
sticky comment. The ungated and no-review envs go to stdout, the step log, as
`notices` annotations, not into the comment.

DO NOT refactor this and summary-comment into one renderer with a
`mode=plan|apply` switch. The injection-critical primitives (fence escaping,
`_md_escape`, size budgeting) and the comment frame are already imported from
summary-comment and written once; what differs is the layout and, critically, the
direction truncation cuts from. A plan diff is read top-down and keeps its head; apply
output's decisive line (a fatal `Error:`, or `Apply complete! Resources: ...`)
is always last, so this script keeps the TAIL.
"""

import collections
import json
import os
import pathlib
import re
import sys

from _shipmate import _load, cell_summaries, current_run_url

sc = _load("summary-comment")
# COUPLING: "what counts as a done apply check" is written once in apply-gate and shared with
# the gate status and both detect paths, so this comment's row states can never disagree with
# the work queue they report on. A second predicate here would drift silently.
ag = _load("apply-gate")
# COUPLING: the only parser of tofu's lock output in the engine, shared with
# actions/unlock-cell so the note and the unlock can never name different locks.
li = _load("lock-info")

# COUPLED to env-order.MAX_ENV_LEVELS, whose module docstring lists the GHA slots that move
# with it; pinned equal by test_apply_comment. A local constant rather than an
# `_load("env-order")`, which would widen this renderer's pin closure.
MAX_ENV_LEVELS = 4

CELL_KEYS = ("stack", "environment", "result", "reason")
_RESULTS = frozenset({"applied", "failed", "blocked"})
# (circle, verdict word) per display status, in verdict token order. A SUPERSET of cell.json's
# `result` enum: `unrecorded` is derived at render time (apply_check_state), never written,
# so _validate_cell still rejects an out-of-enum artifact value as pin skew.
_STATUS = {
    "failed": ("🔴", "failed"),
    "unrecorded": ("🟠", "not recorded"),
    "not_attempted": ("🟡", "not attempted"),
    "blocked": ("⚪", "blocked"),
    "applied": ("🟢", "applied"),
}

# Statuses that get a fold-out with the cell's apply output.
# `unrecorded` is here because its apply genuinely ran: the output is the
# evidence a reader needs to confirm what landed before re-planning.
_SECTION_STATUSES = ("applied", "failed", "unrecorded")

# How many cells the unrecorded note names before it summarizes the rest.
_UNRECORDED_NAMED = 5

# Same, for the state-lock note; same reasoning (see `_lock_note`).
_LOCK_NAMED = 5


def _not_attempted_note(rows, env_name):
    """The 'apply checks stay pending' note when a row is not attempted, parameterized on the
    targeted environment: a bare `shipmate apply` excludes explicit envs
    (`explicit = true` in `.github/shipmate.toml`), so it cannot retry one — the note must
    name the targeted form. env_name is author-controlled and escaped."""
    if not any(r["status"] == "not_attempted" for r in rows):
        return ""
    cmd = f"shipmate apply {sc._md_escape(env_name)}" if env_name else "shipmate apply"
    return f"not attempted: the apply checks stay pending; retry with `{cmd}`."


def _named(cells, cap):
    """`cells` joined with `, `: the first `cap` by name, the rest as `, and N more`."""
    listed = ", ".join(cells[:cap])
    if len(cells) > cap:
        listed += f", and {len(cells) - cap} more"
    return listed


def _unrecorded_note(rows):
    """The 'not recorded' note, naming every affected cell.

    Cell names are author-controlled, so **bold** + `_md_escape` — never a
    backtick code span, which `_md_escape` does not escape.

    The _UNRECORDED_NAMED cap is not cosmetic. Notes belong to the part of the
    comment that never sheds, so uncapped this one could only push the render past
    HARD_CAP into `SystemExit`, costing the whole comment. Unrecorded rows are
    usually correlated across cells (expired App key, checks-API outage), so that
    is precisely the run that needs the comment most. The cell lines still name
    every affected cell."""
    cells = [
        f"**{sc._md_escape(r['stack_display'])} ({sc._md_escape(r['environment'])})**"
        for r in rows
        if r["status"] == "unrecorded"
    ]
    if not cells:
        return ""
    return (
        f"not recorded: {_named(cells, _UNRECORDED_NAMED)}. The apply succeeded but its apply "
        "check is not recorded as complete (it failed, was cancelled, or a newer plan "
        "re-created it), so `shipmate / gate` stays pending. Re-plan and re-apply."
    )


def _lock_cell(row, lock):
    """One cell of the state-lock note: its name, the lock id, and when the lock
    was taken -- the last omitted entirely when lock-info refused the `Created`
    value (unbounded runtime output), so the sentence stays grammatical."""
    held = f", held since **{sc._md_escape(lock['created'])}**" if lock["created"] else ""
    return (
        f"**{sc._md_escape(row['stack_display'])} ({sc._md_escape(row['environment'])})** "
        f"(lock **{sc._md_escape(lock['id'])}**{held})"
    )


def _lock_note(rows, env_name):
    """The 'state lock held' note, naming every cell whose apply could not
    acquire the lock.

    Cell names are author-controlled, and the lock id and creation time come
    from apply.txt -- provider and `local-exec` output a stack under review can
    influence -- so all four are **bold** + `_md_escape`, never a backtick code
    span, which `_md_escape` does not escape. `_md_escape` alone is not enough
    for the lock values, which is why lock-info bounds their length and charset
    at the source: it escapes neither `*` nor a backtick, and `apply_text` is
    capped only in total, so one crafted `Created:` line could both break out of
    the bold span and, since _LOCK_NAMED bounds the cell COUNT and not the
    rendered length, push the comment past HARD_CAP and cost all of it.

    The _LOCK_NAMED cap is the `_unrecorded_note` cap for the same reason: notes
    belong to the part of the comment that never sheds. A stranded lock is usually
    correlated across the cells of one cancelled run -- precisely the run that
    needs the comment most.

    It names no run. `Who` is `user@host` on a hosted runner, so the only
    honest attribution is that per-cell concurrency admits one apply at a time,
    which makes the holder that cell's most recent apply run.
    """
    hits = []
    for r in rows:
        if r["status"] != "failed":
            continue
        lock = li.parse(r["apply_text"] or "")
        if lock:
            hits.append(_lock_cell(r, lock))
    if not hits:
        return ""
    cmd = f"shipmate unlock {sc._md_escape(env_name)}" if env_name else "shipmate unlock <env>"
    return (
        f"state lock held: {_named(hits, _LOCK_NAMED)}. An earlier apply was cancelled or "
        "killed before releasing the lock, so nothing in these cells was applied. Per-cell "
        "concurrency admits one apply at a time, so the holder was that cell's most recent "
        f"apply run. Release it with `{cmd}`, then re-apply. Unlocking is not recovery: if "
        "the reviewed plan is now stale, re-plan."
    )


# Digits-only captures, so look-alike author text cannot inject into the cell line. Whole-line
# anchored (^...$, re.M): tofu prints `Outputs:` after this line, and an output value holding
# the literal would otherwise win last. tofu omits a zero import or forget count.
_RESOURCES_RE = re.compile(
    r"^Apply complete! Resources: (?:(?P<import>\d+) imported, )?(?P<add>\d+) added, "
    r"(?P<change>\d+) changed, (?P<destroy>\d+) destroyed(?:, (?P<forget>\d+) forgotten)?\.?$",
    re.MULTILINE,
)


def _validate_cell(cell, path):
    """Type/enum-check cell.json values past the missing-keys check, mirroring
    summary-comment's `_validate_cell`. A pin-skewed or crafted cell.json with
    the right keys but wrong types would otherwise land unescaped in the
    comment, and an out-of-enum result would fall through the status dispatch."""
    for k in CELL_KEYS:
        if type(cell[k]) is not str:
            raise SystemExit(f"::error::cell summary {path} key {k!r} must be a string")
    if cell["result"] not in _RESULTS:
        raise SystemExit(
            f"::error::cell summary {path} key 'result' must be one of "
            f"{sorted(_RESULTS)} (got {cell['result']!r})"
        )


def _read_tail(path, budget):
    """Read the trailing `budget` characters of `path`, decoded permissively.

    Seeks from the END, unlike plan.txt's head-first cap: apply output IS
    parsed for a trailing line (`_resources`), so a head cap silently blanks
    that parse on any output long enough to need capping, and drops the `Error:`
    line a failed cell line sends the reader looking for.

    errors="replace": apply.txt is provider/local-exec stdout, not guaranteed
    valid UTF-8, and one stray byte must not abort the whole render.

    The byte window is 4x `budget` (UTF-8's worst case) so a codepoint
    straddling the seek point still decodes before the slice down to `budget`.
    """
    with open(path, "rb") as fh:
        fh.seek(0, os.SEEK_END)
        size = fh.tell()
        window = budget * 4
        start = max(0, size - window)
        fh.seek(start)
        data = fh.read()
    text = data.decode("utf-8", errors="replace")
    truncated_front = start > 0 or len(text) > budget
    if len(text) > budget:
        text = text[-budget:]
    if truncated_front:
        # The seek point (or the subsequent budget-slice) can land mid-line, and mid-character
        # too (smoothed over by errors="replace"); drop that leading fragment rather than
        # emit a line that never existed in the source.
        nl = text.find("\n")
        text = text[nl + 1 :] if nl != -1 else ""
    return text


def load_cells(cells_dir):
    """(cell, apply_text) per downloaded apply-summary artifact. A cell.json
    missing schema keys, or carrying the right keys with the wrong types/an
    out-of-enum result, fails loud -- that is apply-cell/apply-comment pin
    skew, not a state to render around.

    ANSI stripping happens HERE, before any other consumer sees the text, and
    the ordering is load-bearing both ways:

    - Strip before `_fence_of`. It sizes the fence from the longest backtick
      run; stripping afterwards can merge two runs an escape sat between into
      a longer one than the fence accounted for, reopening the fence-escape
      hole the computed fence exists to close.
    - Strip before `_resources`. Its regex is line-anchored, and tofu commonly
      wraps that line in colour (`ESC[1m...ESC[0m`), which defeats the anchor.
    - Strip AFTER `_read_tail`, not inside it. `_read_tail`'s only cut that can
      split a sequence is at the front of its window, and it already discards
      that leading fragment — so this only ever sees whole sequences."""
    out = []
    skew = "(apply-cell and this script must be pinned at the same engine SHA)"
    for p, cell in cell_summaries(cells_dir, CELL_KEYS, skew):
        _validate_cell(cell, p)
        txt = pathlib.Path(p).with_name("apply.txt")
        text = None
        if txt.exists():
            text = li.ANSI_RE.sub("", _read_tail(txt, sc.SIZE_BUDGET))
        out.append((cell, text))
    return out


def _expected_cells():
    """Union of every wave array in the SHIPMATE_ENVLEVEL{0..N}_WAVES inputs (a
    targeted apply fills level 0 alone); '' contributes nothing. Cell identity is
    (environment, stack_path) -- a wave element is
    `{"stack": "<stack path>", "environment": "<env>"}`."""
    raw_values = [
        os.environ.get(f"SHIPMATE_ENVLEVEL{i}_WAVES", "") or "" for i in range(MAX_ENV_LEVELS)
    ]
    expected = set()
    for raw in raw_values:
        if not raw:
            continue
        waves = json.loads(raw)
        for cells in waves.values():
            for item in cells:
                expected.add((item["environment"], item["stack"]))
    return expected


def build_rows(expected, downloaded):
    """Merge the expected cell set with downloaded cells into row dicts, sorted
    by (environment, stack). An expected cell with no downloaded artifact is
    'not attempted'. A downloaded cell outside the expected set is still
    rendered (never silently drop evidence that an apply ran) -- it has no
    display name in the wave element schema, so 'not attempted' rows fall back
    to the stack path for display."""
    by_key = {}
    for cell, text in downloaded:
        key = (cell["environment"], cell["stack"])
        by_key[key] = {
            "environment": cell["environment"],
            "stack_path": cell["stack"],
            "stack_display": cell["stack"],
            "status": cell["result"],
            "reason": cell["reason"],
            "apply_text": text,
        }
    for env, stack_path in expected:
        key = (env, stack_path)
        if key not in by_key:
            by_key[key] = {
                "environment": env,
                "stack_path": stack_path,
                "stack_display": stack_path,
                "status": "not_attempted",
                "reason": "",
                "apply_text": None,
            }
    rows = list(by_key.values())
    rows.sort(key=lambda r: (r["environment"], r["stack_display"]))
    return rows


def load_check_maps(path, app_id):
    """(present, done) apply-check name sets from the scan step's check-runs JSONL file,
    tolerating failure.

    `present` is every App-authored `apply / ...` check name on the head SHA
    (newest run per name); `done` is the subset whose newest run completed with
    a good conclusion. Both come from `apply-gate`, per this module's COUPLING
    note.

    Every failure degrades to no data with a warning, never propagates: for
    comment-ops the comment IS the feedback channel, so losing this one display
    axis must not cost the whole render. An empty SHIPMATE_APP_ID gets its own
    warning before the file is read, since the file is not at fault. The
    catch-all covers a malformed line (parse_jsonl's SystemExit), a missing or
    unreadable file (OSError), a non-numeric SHIPMATE_APP_ID (ValueError from
    `int(app_id)`), and a valid-JSON line of the wrong shape reaching
    `latest_by_name` (KeyError/TypeError/AttributeError). See apply_check_state
    for why no data is the safe state."""
    if not app_id:
        print(
            "::warning::SHIPMATE_APP_ID is empty, so the apply result comment falls back "
            "to artifact-only status (see docs/github-app.md)."
        )
        return set(), set()
    try:
        with open(path, encoding="utf-8") as fh:
            runs = ag.app_runs(fh, app_id)
            return set(ag.latest_by_name(runs)), ag.done_names(runs)
    except (OSError, SystemExit, ValueError, KeyError, TypeError, AttributeError) as exc:
        print(
            f"::warning::{path} could not be read as apply checks ({exc}) -- "
            "the apply result comment falls back to artifact-only status"
        )
        return set(), set()


def _check_name(row):
    """This row's apply check name, forward-built per the CONTRACT grammar
    `apply / <stack> / <env>` -- never reverse-parsed."""
    return ag.check_name(row["stack_path"], row["environment"])


def apply_check_state(rows, present, done):
    """Re-derive display status from the real apply-check state (in place).

    The pending apply checks ARE the work queue, so they -- not the per-cell
    artifact -- are the authority on whether a unit is done. `Compose cell
    summary` runs `if: always()`, and the trailing `complete` job completes the
    check only for a cell whose job succeeded, so an `applied` artifact can
    coexist with a pending check (`Save state` failed, the job was cancelled, or
    the `complete` job failed); and the continue-on-error upload can drop,
    leaving an applied cell with no artifact.
    Two directions, therefore:

    - applied + pending check -> `unrecorded`: the apply succeeded but was not
      recorded, the gate stays pending, and the stack needs a re-plan (state
      has advanced past the reviewed .otplan).
    - not_attempted + done check -> `applied`: the check proves the apply
      landed; apply_text stays None so the row renders its bare line.

    A check absent from both sets is unknown, never pending: a failed scan, an
    empty file, an app-id mismatch and from_app dropping a forged same-name
    check all land there, and every one of them must fall back to the
    artifact-only rendering rather than invent a stranded cell.

    `failed`/`blocked` are never re-derived. A red row against a done check
    means some other run applied that cell -- over-reporting, nothing
    stranded -- and downgrading on check state would let an unrelated run's
    green check hide a real failure in this one."""
    for row in rows:
        name = _check_name(row)
        if row["status"] == "applied" and name in present and name not in done:
            row["status"] = "unrecorded"
        elif row["status"] == "not_attempted" and name in done:
            row["status"] = "applied"
    return rows


def _resources(text):
    """The `tally` of the last `Apply complete!` line in `text`, or "" when there is none."""
    matches = list(_RESOURCES_RE.finditer(text or ""))
    if not matches:
        return ""
    m = matches[-1]
    return sc.tally(*(int(m[k] or 0) for k in ("add", "change", "destroy", "import", "forget")))


def _state(row):
    """A row's state text: applied counts (or `applied`), the same plus `, not recorded`,
    `failed`, `blocked: <reason>` (escaped: cell.json is untrusted), `not attempted`."""
    status = row["status"]
    word = _STATUS[status][1]
    if status == "blocked":
        return f"{word}: {sc._md_escape(row['reason'])}"
    if status in ("applied", "unrecorded"):
        counts = _resources(row["apply_text"]) or "applied"
        return counts if status == "applied" else f"{counts}, {word}"
    return word


def _cell_line(row, url):
    return sc.cell_line(
        _STATUS[row["status"]][0],
        row["stack_display"],
        row["environment"],
        _state(row),
        url,
        "logs",
    )


def _job_url(row, jobs, run_url):
    """Per-cell log link: the FORWARD-built `apply / <stack_path> / <env>`
    CONTRACT name, matched as a suffix of the listed job name — every caller
    level prepends its own job name and the prefix differs per route. Matched on
    a ` / ` boundary, not a bare `endswith`, so `reapply / ...` cannot
    false-positive. No match -> the workflow-run URL."""
    target = _check_name(row)
    url = None
    for job in jobs:
        name = job.get("name", "")
        if name == target or name.endswith("/ " + target):
            url = job.get("html_url") or url
    return url or run_url


def render_apply_section(line, text, url, limit):
    """Largest form of a row that fits in `limit` characters: fold-out of its bare `line` with
    the full apply.txt `text` -> fold-out with a truncated one -> `line`, which the caller has
    already reserved room for.

    Truncation keeps the TAIL, cutting the front, unlike the plan renderer:
    the line a reader opens this section for is always at the end. Cut at a
    line boundary, and the truncated body REUSES the full body's fence so a cut
    can never re-open the fence-escape hole."""
    # A limit under MIN_PLAN_CHARS means this row's budget is spent; returning before
    # `_fence_of` also keeps a wide fan-out from regex-scanning every capped apply.txt.
    if text is None or limit < sc.MIN_PLAN_CHARS:
        return line
    f = sc._fence_of(text)
    head = f"<details><summary>{line}</summary>\n\n"
    full = f"{head}{sc.fence(text, f, lang='')}\n</details>"
    if len(full) <= limit:
        return full
    trailer = (
        f"\n\n_Truncated, earlier output elided; [full output in the job log]({url})._\n</details>"
    )
    room = limit - len(head) - len(sc.fence("", f, lang="")) - len(trailer)
    if room >= sc.MIN_PLAN_CHARS:
        sliced = text[-room:]
        cut = sliced[sliced.find("\n") + 1 :] if "\n" in sliced else ""
        if cut:
            return f"{head}{sc.fence(cut, f, lang='')}{trailer}"
    return line


def _verdict(rows, failed_run, held, head_sha, run_url):
    """(circle, line): the line under the header and its circle. With rows: a count per
    status in `_STATUS` order, zero counts omitted, led by a bare `failed` when the run failed
    and no failed or blocked row shows it; the circle is the worst row's, or 🔴 for a failed
    run. Without rows: `🔴 failed`, the held sentence, or `🟢 no pending applies`. Then
    `provenance`. The circle is returned with the line so the footer decision reads it, never
    the rendered text.

    The leading `failed` is suppressed by a `failed` or `blocked` row, each of which already
    names a cell that did not apply. An `unrecorded` row does not suppress it: it describes ONE
    cell in ONE environment and says nothing about a different environment whose job died
    before any cell reported (a denied apply environment, a job-level cancel), whose rows read
    `not attempted`; suppressing on it would hide that environment's only failure signal."""
    if not rows:
        if failed_run:
            circle, text = "🔴", "failed"
        elif held:
            # Work WAS pending and the engine refused it.
            circle, text = "⚪", "nothing applied, environments are held for review"
        else:
            circle, text = "🟢", "no pending applies"
    else:
        n = collections.Counter(r["status"] for r in rows)
        tokens = [f"{n[s]} {word}" for s, (_, word) in _STATUS.items() if n[s]]
        if failed_run and not (n["failed"] or n["blocked"]):
            tokens.insert(0, "failed")
        circle = "🔴" if failed_run else sc.worst(_STATUS[s][0] for s in n)
        text = ", ".join(tokens)
    return circle, f"{circle} {text} {sc.provenance(head_sha, run_url)}"


_HELD_REMEDY = (
    "held: get an approving review, or resolve or dismiss a requested-changes review. "
    "The run log's apply-all-detect notice names the decision seen."
)


def _esc(envs):
    return [sc._md_escape(e) for e in envs]


def _held_line(env, explicit):
    line = f"⚪ {env}: held, the review state does not permit applying"
    return f"{line}; once it clears, comment `shipmate apply {env}`" if explicit else line


_UNGATED = (
    "ungated, permitted to apply without an approving review "
    "(gated = false in .github/shipmate.toml)"
)
_NO_REVIEW = "no approving review was required, so gated had nothing to enforce"


def notices(rows, applied_ungated, review_not_required):
    """One `::notice::` workflow command per environment in `applied_ungated` (an all-environments
    set: the caller passes it empty in the targeted form, as apply.yml reads it from the
    bare-apply detector only) and per environment in `review_not_required` that has an applied,
    failed or unrecorded row, where infrastructure may have changed, so a run with no rows
    names none. Env names are author-controlled, so `command_data`-escaped.

    An ungated notice is the audit trail an apply permitted by `gated = false` under a
    REVIEW_REQUIRED decision leaves: `reviewDecision` is a live value with no history, so once
    the review lands nothing in the run tells an apply that waited for it from one that did not.
    It carries no completion verb for the named env -- detect derives the set from `runnable`,
    before any wave runs, so a failed wave or a skipped env-level leaves an env named there that
    never applied.

    `review_not_required` names gated envs a null (`NONE`) decision authorized: the pull
    request's review state required none, so `gated` enforced nothing. It is a different cause
    from `applied_ungated`, so it gets its own text, which states the authorization fact and
    never that nobody reviewed -- a code-owner review can still be required at count 0."""
    ran = {r["environment"] for r in rows if r["status"] in _SECTION_STATUSES}
    lines = [f"::notice::{sc.command_data(e)}: {_UNGATED}" for e in applied_ungated]
    return lines + [
        f"::notice::{sc.command_data(e)}: {_NO_REVIEW}" for e in review_not_required if e in ran
    ]


def _dispositions(excluded, skipped, held):
    """Each disposition's environments, `_md_escape`d, for both renderings of the footer lines.
    All are all-environments sets; the caller passes them empty in the targeted form, because
    apply.yml reads them from the bare-apply detector only. A held env that is also explicit
    is listed under `held` only, and under `held_explicit` for its command."""
    excluded, held = _esc(excluded), _esc(held)
    return {
        "explicit": [e for e in excluded if e not in held],
        "skipped": _esc(skipped),
        "held": held,
        "held_explicit": [e for e in held if e in excluded],
    }


def _per_env_lines(d):
    lines = [
        f"🟡 {e}: left pending (explicit), comment `shipmate apply {e}`" for e in d["explicit"]
    ]
    lines += [
        f"⚪ {e}: skipped, ordered after an environment not applying this run" for e in d["skipped"]
    ]
    lines += [_held_line(e, e in d["held_explicit"]) for e in d["held"]]
    if d["held"]:
        lines.append(_HELD_REMEDY)
    return lines


def _grouped_lines(d):
    """The compact form's footer lines: one per disposition, its environments comma-separated."""
    g = {k: ", ".join(v) for k, v in d.items()}
    lines = []
    if g["explicit"]:
        lines.append(
            f"🟡 left pending (explicit): {g['explicit']}; comment `shipmate apply <env>` for each"
        )
    if g["skipped"]:
        lines.append(
            f"⚪ skipped, ordered after an environment not applying this run: {g['skipped']}"
        )
    if g["held"]:
        line = f"⚪ held, the review state does not permit applying: {g['held']}"
        if g["held_explicit"]:
            line += (
                f"; once the hold clears, comment `shipmate apply <env>` for {g['held_explicit']}"
            )
        lines += [line, _HELD_REMEDY]
    return lines


def _footer_parts(excluded, skipped, held=(), compact=False):
    """The lines above the footer, produced only when the caller passes the all-environments
    sets, which apply.yml reads from the bare-apply detector only: one line per environment
    for each disposition this run produced (explicit left pending, skipped, held for review) and
    a `held:` remedy line when any is held. Env names are author-controlled, so `_md_escape`d.
    `compact` renders each disposition as one line naming its environments comma-separated, with
    the same meanings, for the hard-cap fallback. Applied-ungated and no-review environments are
    not comment lines: `notices` reports them in the run log, and the `shipmate / gate` status
    shows the gate's state.

    `excluded` can overlap `held`. A held env that is also in `excluded` is
    listed once, on its held line, with its `shipmate apply <env>` command: once
    reviewed, a bare `shipmate apply` still leaves it pending. A held env that
    is not explicit names no command. The held lines are also cause-agnostic --
    three decisions hold (REVIEW_REQUIRED on a gated env, CHANGES_REQUESTED,
    and an unknown or absent decision) and only the run's own detect notice
    carries which one, since the decision never reaches this renderer; the
    `held:` line names every remedy and points there."""
    d = _dispositions(excluded, skipped, held)
    return _grouped_lines(d) if compact else _per_env_lines(d)


def _results_failed(results_csv):
    """Tokenize SHIPMATE_RESULTS (`join(needs.*.result, ',')`) and report
    whether any job-level outcome signals failure. Read once per render, so the
    verdict with rows and without cannot disagree.

    A blank token counts as FAILURE. Dropping empty tokens would let a blank
    result read as clean, silently turning "failed" into "no pending
    applies"."""
    tokens = results_csv.split(",")
    return any(t not in ("success", "skipped") for t in tokens)


_BLOCKED_NOTE = "blocked: each blocked cell's reason is in its logs."


def _tail(notes, parts, hint):
    """The non-empty notes, then the footer lines, then the footer `hint`, a blank line between
    each; empty when all three are."""
    return "\n\n".join(p for p in ("\n".join(n for n in notes if n), "\n".join(parts), hint) if p)


def _compact(head, rows, urls, bares, notes, parts, hint):
    """The hard-cap fallback, tried only after the normal render overflows HARD_CAP: every row's
    bare line with a blocked row's state shortened to `blocked` and `_BLOCKED_NOTE` leading the
    notes when a row is blocked, above the grouped footer `parts`. A blocked reason is the one
    free text a bare line carries, and the footer lines grow with the environments the
    dispositions name, so a 256-cell run that is all blocked, or whose dispositions name hundreds
    of environments, can overflow in the normal form and fit in this one."""
    if any(r["status"] == "blocked" for r in rows):
        notes = (_BLOCKED_NOTE, *notes)
    circle, word = _STATUS["blocked"]
    lines = [
        sc.cell_line(circle, r["stack_display"], r["environment"], word, u, "logs")
        if r["status"] == "blocked"
        else b
        for r, u, b in zip(rows, urls, bares, strict=True)
    ]
    return "\n\n".join(p for p in (head, "\n".join(lines), _tail(notes, parts, hint)) if p)


def build_comment(
    rows,
    jobs,
    run_url,
    excluded,
    skipped,
    env_name,
    results_csv="",
    held=(),
    head_sha="",
):
    """Assemble the comment under SIZE_BUDGET: header, verdict, every row in order (a fold-out
    for an applied, failed or unrecorded row with output, else its bare line), the notes, the
    footer lines, and `footer_hint`'s footer, which is empty under a 🟢 verdict. With no rows it
    is header, verdict, footer lines and footer.

    Every row is guaranteed its bare line: the space all remaining rows' bare lines need is
    reserved up front, together, so an early giant apply.txt cannot starve a later row. When
    even the bare lines overflow HARD_CAP, `_compact` renders them without the blocked reasons
    and with one footer line per disposition; past that a SystemExit names the cause."""
    circle, verdict = _verdict(rows, _results_failed(results_csv), held, head_sha, run_url)
    head = f"{sc.header('apply', env_name)}\n\n{verdict}"
    hint = sc.footer_hint(circle)
    notes = (
        _lock_note(rows, env_name),
        _unrecorded_note(rows),
        _not_attempted_note(rows, env_name),
    )
    dispositions = (excluded, skipped, held)
    parts = _footer_parts(*dispositions)
    tail = _tail(notes, parts, hint)
    urls = [_job_url(r, jobs, run_url) for r in rows]
    bares = [_cell_line(r, u) for r, u in zip(rows, urls, strict=True)]
    used = len(head) + len(tail) + 4
    reserve = sum(len(b) + 2 for b in bares)
    sections = []
    for r, url, bare in zip(rows, urls, bares, strict=True):
        reserve -= len(bare) + 2
        section = bare
        if r["status"] in _SECTION_STATUSES:
            section = render_apply_section(
                bare, r["apply_text"], url, sc.SIZE_BUDGET - used - reserve - 2
            )
        sections.append(section)
        used += len(section) + 2
    body = "\n\n".join(p for p in (head, sc._join(sections), tail) if p)
    # Past SIZE_BUDGET every row is already its bare line; only the compact form is smaller.
    if len(body) > sc.HARD_CAP:
        parts = _footer_parts(*dispositions, compact=True)
        body = _compact(head, rows, urls, bares, notes, parts, hint)
    # Stack/env display names are author-controlled, so fail loud rather than let GitHub 422
    # the POST on an oversized body.
    if len(body) > sc.HARD_CAP:
        raise SystemExit(
            "::error::apply comment exceeds the 65,536-character comment cap even in its "
            "compact form; shorten stack or environment names"
        )
    return body


def main():
    jobs = ag.parse_jsonl(sys.stdin)
    downloaded = load_cells(os.environ.get("CELLS", "cells"))
    expected = _expected_cells()
    present, done = load_check_maps(
        os.environ.get("SHIPMATE_CHECKS", "checks.jsonl"),
        os.environ.get("SHIPMATE_APP_ID", ""),
    )
    rows = apply_check_state(build_rows(expected, downloaded), present, done)
    env_name = os.environ.get("SHIPMATE_ENVIRONMENT", "") or ""
    # Printed before the render, so an over-cap SystemExit still leaves the audit trail.
    for line in notices(
        rows,
        json.loads(os.environ.get("SHIPMATE_APPLIED_UNGATED_ENVS") or "[]"),
        json.loads(os.environ.get("SHIPMATE_REVIEW_NOT_REQUIRED_ENVS") or "[]"),
    ):
        print(line)
    body = build_comment(
        rows,
        jobs,
        current_run_url(),
        json.loads(os.environ.get("SHIPMATE_EXCLUDED_ENVS") or "[]"),
        json.loads(os.environ.get("SHIPMATE_SKIPPED_ENVS") or "[]"),
        env_name,
        os.environ.get("SHIPMATE_RESULTS", "") or "",
        json.loads(os.environ.get("SHIPMATE_REVIEW_HELD_ENVS") or "[]"),
        os.environ.get("SHIPMATE_HEAD_SHA", ""),
    )
    with open("comment.md", "w", encoding="utf-8") as fh:
        fh.write(body)


if __name__ == "__main__":
    main()
