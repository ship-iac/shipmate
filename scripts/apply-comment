#!/usr/bin/env python3
"""Build the apply result comment: overview table + per-cell apply output.

Reads the run's jobs listing as JSON Lines on stdin (one object per line,
keys `name`/`html_url`, as emitted by `gh api --paginate .../jobs --jq
'.jobs[]'`), per-cell `apply-summary.*` artifacts from the $CELLS directory,
the expected-cell set (waves JSON — targeted or per-env-level), the gate
verdict, and the excluded/skipped/held/ungated envs (apply-all only), and writes
a fresh comment.md -- this comment is never upserted, unlike the plan sticky
comment.

DO NOT refactor this and summary-comment into one renderer with a
`mode=plan|apply` switch. The injection-critical primitives (fence escaping,
`_md_escape`, size budgeting) are already imported from summary-comment and
written once; what differs is the layout and, critically, the direction
truncation cuts from. A plan diff is read top-down and keeps its head; apply
output's decisive line (a fatal `Error:`, or `Apply complete! Resources: ...`)
is always last, so this script keeps the TAIL.
"""

import glob
import importlib.util
import json
import os
import pathlib
import re
import sys
from importlib.machinery import SourceFileLoader

_D = pathlib.Path(__file__).resolve().parent


def _load(fname):
    loader = SourceFileLoader(fname.replace("-", "_"), str(_D / fname))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


sc = _load("summary-comment")
# COUPLING: "what counts as a done apply check" is written once in apply-gate and shared with
# the gate status and both detect paths, so this comment's row states can never disagree with
# the work queue they report on. A second predicate here would drift silently.
ag = _load("apply-gate")
# COUPLING: the only parser of tofu's lock output in the engine, shared with
# actions/unlock-cell so the note and the unlock can never name different locks.
li = _load("lock-info")

# COUPLED to env-order.MAX_ENV_LEVELS (which lists the GHA slots that move with
# it); pinned equal by test_apply_comment. A local constant rather than an
# `_load("env-order")`, which would widen this renderer's pin closure.
MAX_ENV_LEVELS = 4

CELL_KEYS = ("stack", "stack_path", "environment", "result", "reason")
_RESULTS = frozenset({"applied", "failed", "blocked"})
# Display statuses are a SUPERSET of cell.json's `result` enum: `unrecorded` is
# derived at render time (see apply_check_state), never written by apply-cell,
# so _validate_cell keeps rejecting an out-of-enum artifact value as pin skew.
_EMOJI = {
    "applied": "✅",
    "failed": "❌",
    "blocked": "🚫",
    "not_attempted": "⏭️",
    "unrecorded": "⚠️",
}

# Statuses that get a <details> section with the cell's apply output.
# `unrecorded` is here because its apply genuinely ran: the output is the
# evidence a reader needs to confirm what landed before re-planning.
_SECTION_STATUSES = ("applied", "failed", "unrecorded")

# Human phrase per display status, for the <details> summary line. `unrecorded`
# is an internal enum token; the reader-facing wording must match the table
# legend and CONTRACT.md.
_STATUS_PHRASE = {
    "applied": "applied",
    "failed": "failed",
    "blocked": "blocked",
    "not_attempted": "not attempted",
    "unrecorded": "applied but not recorded",
}

# How many cells the unrecorded note names before it summarizes the rest.
_UNRECORDED_NAMED = 5

# Same, for the state-lock note; same reasoning (see `_lock_note`).
_LOCK_NAMED = 5


def _not_attempted_note(env_name):
    """The 'apply check stays pending' note, parameterized on the targeted
    environment: a bare `shipmate apply` excludes explicit envs
    (`global.shipmate.explicit_envs`), so it cannot retry one — the note must
    name the targeted form. env_name is author-controlled and escaped."""
    cmd = f"shipmate apply {sc._md_escape(env_name)}" if env_name else "shipmate apply"
    return f"_⏭️ not attempted — the apply check stays pending; retry with `{cmd}`._"


def _unrecorded_note(rows):
    """The 'applied but not recorded' note, naming every affected cell.

    Cell names are author-controlled, so **bold** + `_md_escape` — never a
    backtick code span, which `_md_escape` does not escape.

    The _UNRECORDED_NAMED cap is not cosmetic. This note rides in `top`, which
    the HARD_CAP table-only fallback re-emits verbatim and so can never shed;
    uncapped it could only push the render past HARD_CAP into `SystemExit`,
    costing the whole comment. Unrecorded rows are usually correlated across
    cells (expired App key, checks-API outage), so that is precisely the run
    that needs the comment most. The table still lists every affected cell."""
    cells = [
        f"**{sc._md_escape(r['stack_display'])} / {sc._md_escape(r['environment'])}**"
        for r in rows
        if r["status"] == "unrecorded"
    ]
    if not cells:
        return ""
    named, rest = cells[:_UNRECORDED_NAMED], len(cells) - _UNRECORDED_NAMED
    listed = ", ".join(named)
    if rest > 0:
        listed += f", and {rest} more (see the ⚠️ rows above)"
    return (
        "⚠️ applied but not recorded: "
        + listed
        + " — the apply succeeded but the apply check is not recorded as "
        "complete (it failed, was cancelled, or a newer plan re-created it), "
        "so `shipmate / gate` stays pending. Re-plan and re-apply."
    )


def _lock_cell(row, lock):
    """One cell of the state-lock note: its name, the lock id, and when the lock
    was taken -- the last omitted entirely when lock-info refused the `Created`
    value (unbounded runtime output), so the sentence stays grammatical."""
    held = f", held since **{sc._md_escape(lock['created'])}**" if lock["created"] else ""
    return (
        f"**{sc._md_escape(row['stack_display'])} / {sc._md_escape(row['environment'])}** "
        f"(lock **{sc._md_escape(lock['id'])}**{held})"
    )


def _lock_note(rows, env_name):
    """The 'state lock held' note, naming every cell whose apply could not
    acquire the lock.

    Cell names are author-controlled, and the lock id and creation time come
    from apply.txt -- provider and `local-exec` output a stack under review can
    influence -- so all four are **bold** + `_md_escape`, never a backtick code
    span, which `_md_escape` does not escape. `_md_escape` alone is not enough
    for the lock values, which is why lock-info bounds their length and charset
    at the source: it escapes neither `*` nor a backtick, and `apply_text` is
    capped only in total, so one crafted `Created:` line could both break out of
    the bold span and, since _LOCK_NAMED bounds the cell COUNT and not the
    rendered length, push `top` past HARD_CAP and cost the whole comment.

    The _LOCK_NAMED cap is the `_unrecorded_note` cap for the same reason: this
    note rides in `top`, which the HARD_CAP table-only fallback re-emits
    verbatim and so can never shed. A stranded lock is usually correlated
    across the cells of one cancelled run -- precisely the run that needs the
    comment most.

    It names no run. `Who` is `user@host` on a hosted runner, so the only
    honest attribution is that per-cell concurrency admits one apply at a time,
    which makes the holder that cell's most recent apply run.
    """
    hits = []
    for r in rows:
        if r["status"] != "failed":
            continue
        lock = li.parse(r["apply_text"] or "")
        if lock:
            hits.append((r, lock))
    if not hits:
        return ""
    named, rest = hits[:_LOCK_NAMED], len(hits) - _LOCK_NAMED
    listed = ", ".join(_lock_cell(r, lock) for r, lock in named)
    if rest > 0:
        listed += f", and {rest} more (see the ❌ rows above)"
    cmd = f"shipmate unlock {sc._md_escape(env_name)}" if env_name else "shipmate unlock <env>"
    return (
        "🔒 state lock held: "
        + listed
        + " — an earlier apply was cancelled or killed before releasing the "
        "lock, so nothing in these cells was applied. Per-cell concurrency "
        "admits one apply at a time, so the holder was that cell's most recent "
        f"apply run. Release it with `{cmd}`, then re-apply — unlocking is not "
        "recovery: if the reviewed plan is now stale, re-plan."
    )


# Digits-only captures, so a look-alike line in author-controlled apply.txt cannot inject into
# the resources cell. Whole-line anchored (^...$, re.M) because tofu prints `Outputs:` AFTER
# this line: an unanchored match would let an output value containing the literal win last.
_RESOURCES_RE = re.compile(
    r"^Apply complete! Resources: (\d+) added, (\d+) changed, (\d+) destroyed\.?$",
    re.MULTILINE,
)


def _validate_cell(cell, path):
    """Type/enum-check cell.json values past the missing-keys check, mirroring
    summary-comment's `_validate_cell`. A pin-skewed or crafted cell.json with
    the right keys but wrong types would otherwise land unescaped in the
    comment, and an out-of-enum result would fall through the status dispatch."""
    for k in CELL_KEYS:
        if type(cell[k]) is not str:
            raise SystemExit(f"::error::cell summary {path} key {k!r} must be a string")
    if cell["result"] not in _RESULTS:
        raise SystemExit(
            f"::error::cell summary {path} key 'result' must be one of "
            f"{sorted(_RESULTS)} (got {cell['result']!r})"
        )


def _read_tail(path, budget):
    """Read the trailing `budget` characters of `path`, decoded permissively.

    Seeks from the END, unlike plan.txt's head-first cap: apply output IS
    parsed for a trailing line (`_resources`), so a head cap silently blanks
    that parse on any output long enough to need capping, and drops the `Error:`
    line the table's ❌ sends the reader looking for.

    errors="replace": apply.txt is provider/local-exec stdout, not guaranteed
    valid UTF-8, and one stray byte must not abort the whole render.

    The byte window is 4x `budget` (UTF-8's worst case) so a codepoint
    straddling the seek point still decodes before the slice down to `budget`.
    """
    with open(path, "rb") as fh:
        fh.seek(0, os.SEEK_END)
        size = fh.tell()
        window = budget * 4
        start = max(0, size - window)
        fh.seek(start)
        data = fh.read()
    text = data.decode("utf-8", errors="replace")
    truncated_front = start > 0 or len(text) > budget
    if len(text) > budget:
        text = text[-budget:]
    if truncated_front:
        # The seek point (or the subsequent budget-slice) can land mid-line, and mid-character
        # too (smoothed over by errors="replace"); drop that leading fragment rather than
        # emit a line that never existed in the source.
        nl = text.find("\n")
        text = text[nl + 1 :] if nl != -1 else ""
    return text


# CSI is listed FIRST so a well-formed CSI run matches whole, including its
# final byte; the two-character branch would otherwise match a bare `ESC[`.
_ANSI_RE = re.compile(
    r"\x1b\[[0-?]*[ -/]*[@-~]"  # CSI
    r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"  # OSC
    r"|\x1b[@-_]"  # two-character escape
)


def _strip_ansi(text):
    """Strip terminal escape sequences from `text`. `\\r` is left alone — not an
    escape sequence."""
    return _ANSI_RE.sub("", text)


def load_cells(cells_dir):
    """(cell, apply_text) per downloaded apply-summary artifact. A cell.json
    missing schema keys, or carrying the right keys with the wrong types/an
    out-of-enum result, fails loud -- that is apply-cell/apply-comment pin
    skew, not a state to render around.

    ANSI stripping happens HERE, before any other consumer sees the text, and
    the ordering is load-bearing both ways:

    - Strip before `_fence_of`. It sizes the fence from the longest backtick
      run; stripping afterwards can merge two runs an escape sat between into
      a longer one than the fence accounted for, reopening the fence-escape
      hole the computed fence exists to close.
    - Strip before `_resources`. Its regex is line-anchored, and tofu commonly
      wraps that line in colour (`ESC[1m...ESC[0m`), which defeats the anchor.
    - Strip AFTER `_read_tail`, not inside it. `_read_tail`'s only cut that can
      split a sequence is at the front of its window, and it already discards
      that leading fragment — so this only ever sees whole sequences."""
    out = []
    for p in sorted(glob.glob(os.path.join(cells_dir, "**", "cell.json"), recursive=True)):
        with open(p, encoding="utf-8") as fh:
            cell = json.load(fh)
        missing = [k for k in CELL_KEYS if k not in cell]
        if missing:
            raise SystemExit(
                f"::error::cell summary {p} missing keys {missing} — "
                "apply-cell and this script must be pinned at the same engine SHA"
            )
        _validate_cell(cell, p)
        txt = pathlib.Path(p).with_name("apply.txt")
        text = None
        if txt.exists():
            text = _strip_ansi(_read_tail(txt, sc.SIZE_BUDGET))
        out.append((cell, text))
    return out


def _expected_cells():
    """Union of every wave array in SHIPMATE_WAVES_JSON (targeted) or the
    SHIPMATE_ENVLEVEL{0..N}_WAVES inputs (all-environments); '' contributes
    nothing. Cell identity is (environment, stack_path) -- a wave element is
    `{"stack": "<stack path>", "environment": "<env>"}`."""
    raw_values = [os.environ.get("SHIPMATE_WAVES_JSON", "") or ""]
    raw_values += [
        os.environ.get(f"SHIPMATE_ENVLEVEL{i}_WAVES", "") or "" for i in range(MAX_ENV_LEVELS)
    ]
    expected = set()
    for raw in raw_values:
        if not raw:
            continue
        waves = json.loads(raw)
        for cells in waves.values():
            for item in cells:
                expected.add((item["environment"], item["stack"]))
    return expected


def build_rows(expected, downloaded):
    """Merge the expected cell set with downloaded cells into row dicts, sorted
    by (environment, stack). An expected cell with no downloaded artifact is
    'not attempted'. A downloaded cell outside the expected set is still
    rendered (never silently drop evidence that an apply ran) -- it has no
    display name in the wave element schema, so 'not attempted' rows fall back
    to the stack path for display."""
    by_key = {}
    for cell, text in downloaded:
        key = (cell["environment"], cell["stack_path"])
        by_key[key] = {
            "environment": cell["environment"],
            "stack_path": cell["stack_path"],
            "stack_display": cell["stack"],
            "status": cell["result"],
            "reason": cell["reason"],
            "apply_text": text,
        }
    for env, stack_path in expected:
        key = (env, stack_path)
        if key not in by_key:
            by_key[key] = {
                "environment": env,
                "stack_path": stack_path,
                "stack_display": stack_path,
                "status": "not_attempted",
                "reason": "",
                "apply_text": None,
            }
    rows = list(by_key.values())
    rows.sort(key=lambda r: (r["environment"], r["stack_display"]))
    return rows


CHECK_UNKNOWN, CHECK_DONE, CHECK_PENDING = "unknown", "done", "pending"


def check_state_maps(check_run_lines, app_id):
    """(present, done) apply-check name sets from check-runs JSONL.

    `present` is every App-authored `apply / ...` check name on the head SHA
    (newest run per name); `done` is the subset whose newest run completed with
    a good conclusion. Both come from `apply-gate`, per this module's COUPLING
    note.

    An empty app id warns and reports no data rather than raising the way
    `from_app` does: for comment-ops the comment IS the feedback channel, so a
    missing SHIPMATE_APP_ID must cost this one display axis, never the whole
    comment."""
    if not app_id:
        print(
            "::warning::SHIPMATE_APP_ID is empty — the apply result comment falls back "
            "to artifact-only status (see docs/github-app.md)."
        )
        return set(), set()
    runs = ag.from_app(ag.parse_jsonl(check_run_lines), app_id)
    return set(ag.latest_by_name(runs)), ag.done_names(runs)


def load_check_maps(path, app_id):
    """check_state_maps over the scan step's output file, tolerating absence
    or corruption.

    A MISSING file is silent no-data: the scan step degrades a failed fetch to
    an empty file, so absence means an older pinned apply-summary with no scan
    step at all (the two-step pin window in docs/releasing.md) — expected, not
    an error.

    Every other failure degrades to no data WITH a warning, never propagates:
    for comment-ops the comment IS the feedback channel, so losing this one
    display axis must not cost the whole render. That covers a malformed line
    (parse_jsonl's SystemExit), an unreadable file (OSError), a non-numeric
    SHIPMATE_APP_ID (ValueError from `int(app_id)`), and a valid-JSON line of
    the wrong shape reaching `latest_by_name` (KeyError/TypeError/
    AttributeError). See apply_check_state for why no data is the safe state."""
    try:
        with open(path, encoding="utf-8") as fh:
            return check_state_maps(fh, app_id)
    except FileNotFoundError:
        return set(), set()
    except (OSError, SystemExit, ValueError, KeyError, TypeError, AttributeError) as exc:
        print(
            f"::warning::{path} could not be read as apply checks ({exc}) -- "
            "the apply result comment falls back to artifact-only status"
        )
        return set(), set()


def _check_name(row):
    """This row's apply check name, forward-built per the CONTRACT grammar
    `apply / <stack> / <env>` -- never reverse-parsed."""
    return f"apply / {row['stack_path']} / {row['environment']}"


def _check_state(row, present, done):
    """This row's apply check: CHECK_DONE, CHECK_PENDING, or CHECK_UNKNOWN.

    Absence means UNKNOWN, never pending: a failed scan, an empty file, an
    app-id mismatch and from_app dropping a forged same-name check all land
    here, and every one of them must fall back to the artifact-only rendering
    rather than invent a stranded cell."""
    name = _check_name(row)
    if name in done:
        return CHECK_DONE
    if name in present:
        return CHECK_PENDING
    return CHECK_UNKNOWN


def apply_check_state(rows, present, done):
    """Re-derive display status from the real apply-check state (in place).

    The pending apply checks ARE the work queue, so they -- not the per-cell
    artifact -- are the authority on whether a unit is done. `Compose cell
    summary` uploads BEFORE the completion-token mint and `Complete the apply
    check`, so an `applied` artifact can coexist with a pending check; and the
    continue-on-error upload can drop, leaving an applied cell with no artifact.
    Two directions, therefore:

    - applied + pending check -> `unrecorded`: the apply succeeded but was not
      recorded, the gate stays pending, and the stack needs a re-plan (state
      has advanced past the reviewed .otplan).
    - not_attempted + done check -> `applied`: the check proves the apply
      landed; apply_text stays None so the section degrades to link-only.

    `failed`/`blocked` are never re-derived. A red row against a done check
    means some other run applied that cell -- over-reporting, nothing
    stranded -- and downgrading on check state would let an unrelated run's
    green check hide a real failure in this one."""
    for row in rows:
        state = _check_state(row, present, done)
        if row["status"] == "applied" and state == CHECK_PENDING:
            row["status"] = "unrecorded"
        elif row["status"] == "not_attempted" and state == CHECK_DONE:
            row["status"] = "applied"
    return rows


def _resources(text):
    if not text:
        return ""
    last = None
    for m in _RESOURCES_RE.finditer(text):
        last = m
    if not last:
        return ""
    added, changed, destroyed = last.groups()
    return f"+{added} ~{changed} -{destroyed}"


def _job_url(row, jobs, run_url):
    """Per-cell log link: the FORWARD-built `apply / <stack_path> / <env>`
    CONTRACT name, matched as a suffix of the listed job name — every caller
    level prepends its own job name and the prefix differs per route. Matched on
    a ` / ` boundary, not a bare `endswith`, so `reapply / ...` cannot
    false-positive. No match -> the workflow-run URL."""
    target = _check_name(row)
    url = None
    for job in jobs:
        name = job.get("name", "")
        if name == target or name.endswith("/ " + target):
            url = job.get("html_url") or url
    return url or run_url


def build_table(rows, jobs, run_url):
    lines = ["| | stack | env | resources | logs |", "|---|---|---|---|---|"]
    for r in rows:
        lines.append(
            f"| {_EMOJI[r['status']]} | {sc._md_escape(r['stack_display'])} "
            f"| {sc._md_escape(r['environment'])} | {_resources(r['apply_text'])} "
            f"| [logs]({_job_url(r, jobs, run_url)}) |"
        )
    return "\n".join(lines)


def _summary_line(row):
    return (
        f"<summary>{_EMOJI[row['status']]} {sc._md_escape(row['stack_display'])} / "
        f"{sc._md_escape(row['environment'])} — {_STATUS_PHRASE[row['status']]}</summary>"
    )


def _link_only(row, url):
    """The smallest possible section for a row: no output, only a link.

    Two reasons land here and must not share one sentence. Output that exists
    but does not fit is "too large"; output that never arrived is unavailable,
    and the linked run may not even contain that cell's apply (`_job_url` falls
    back to this run's URL) -- so that wording promises nothing about what is at
    the other end.

    Keep the branch INSIDE this function. build_comment's up-front size reserve
    calls it per row, so it reserves exactly what will be rendered; branching at
    the call sites instead reserves one shape and renders another, and the
    assembled body then overruns sc.HARD_CAP and posts no comment at all."""
    if row["apply_text"] is None:
        body = f"_Apply output unavailable for this cell — [run log]({url})._"
    else:
        body = f"_Output too large for this comment — [full output in the job log]({url})._"
    return f"<details>{_summary_line(row)}\n\n{body}\n</details>"


def render_apply_section(row, text, url, limit):
    """Largest details section that fits in `limit` characters: full apply.txt
    -> truncated -> link-only.

    Truncation keeps the TAIL, cutting the front, unlike the plan renderer:
    the line a reader opens this section for is always at the end. Cut at a
    line boundary, and the truncated body REUSES the full body's fence so a cut
    can never re-open the fence-escape hole."""
    if text is None:
        return _link_only(row, url)
    f = sc._fence_of(text)
    head = f"<details>{_summary_line(row)}\n\n"
    full = f"{head}{sc.fence(text, f, lang='')}\n</details>"
    if len(full) <= limit and limit >= sc.MIN_PLAN_CHARS:
        return full
    trailer = (
        f"\n\n_Truncated — earlier output elided; [full output in the job log]({url})._\n</details>"
    )
    room = limit - len(head) - len(sc.fence("", f, lang="")) - len(trailer)
    if room >= sc.MIN_PLAN_CHARS:
        sliced = text[-room:]
        cut = sliced[sliced.find("\n") + 1 :] if "\n" in sliced else ""
        if cut:
            return f"{head}{sc.fence(cut, f, lang='')}{trailer}"
    return _link_only(row, url)


def _blocked_line(row, url):
    return (
        f"🚫 **{sc._md_escape(row['stack_display'])} / {sc._md_escape(row['environment'])}** "
        f"— {sc._md_escape(row['reason'])}. [logs]({url})"
    )


def _header(env_name):
    if env_name:
        return f"### shipmate apply {sc._md_escape(env_name)}"
    return "### shipmate apply (all environments)"


def _gate_sentence(gate):
    return (
        "`shipmate / gate` is complete — every environment is applied."
        if gate == "complete"
        else "`shipmate / gate` stays pending until every environment is applied "
        "(or the merge deploy runs)."
    )


def _env_disposition_lines(excluded, skipped, held=(), applied_ungated=()):
    """One sentence per env disposition this run produced: excluded, skipped,
    held for review, applied ungated. Shared by `_footer` and `_short_form` so
    the short form cannot silently drop the comment's most actionable warning.
    Env names are author-controlled, so `_md_escape`d.

    The held sentence names no command: a held env can also be an explicit env
    (the held cause wins, so it is not in `excluded`), and a bare `shipmate
    apply` would not pick it up once reviewed. It is also cause-agnostic --
    three decisions hold (REVIEW_REQUIRED on an unlisted env, CHANGES_REQUESTED,
    and an unknown or absent decision) and only the run's own detect notice
    carries which one, since the decision never reaches this renderer.

    An empty `applied_ungated` renders NOTHING, and never "zero environments
    applied" -- it is populated only under a REVIEW_REQUIRED decision with
    SHIPMATE_UNGATED_ENVS set. That sentence is the only audit trail an
    unreviewed apply leaves: `reviewDecision` is a live value with no history,
    so once the review lands nothing in the run tells an apply that waited for
    it from one that did not. No clause of it uses a completion
    verb for the named envs -- detect derives the set from `runnable`, before
    any wave runs, so a failed wave or a skipped env-level leaves an env named
    here that never applied, and this comment's own legend reserves "applied"
    for the ✅ state (_EMOJI), so a completion verb would contradict the table
    beside it. It points at the run rather than the table because the short
    form has no table."""
    lines = []
    if excluded:
        envs = ", ".join(f"`{sc._md_escape(e)}`" for e in excluded)
        cmds = ", ".join(f"`shipmate apply {sc._md_escape(e)}`" for e in excluded)
        lines.append(f"Explicit environment(s) left pending: {envs} — run {cmds} to apply them.")
    if skipped:
        envs = ", ".join(f"`{sc._md_escape(e)}`" for e in skipped)
        # Cause-agnostic: `partition_envs` blocks on explicit AND held envs, so
        # naming "explicit" here misattributes every hold-induced skip.
        lines.append(f"Skipped (ordered after an environment not applying this run): {envs}.")
    if held:
        envs = ", ".join(f"`{sc._md_escape(e)}`" for e in held)
        lines.append(
            f"Held — the pull request's review state does not permit applying: {envs}. "
            "Get an approving review, or resolve or dismiss a requested-changes "
            "review; the run log's apply-all-detect notice names the decision seen."
        )
    if applied_ungated:
        envs = ", ".join(f"`{sc._md_escape(e)}`" for e in applied_ungated)
        lines.append(
            "Ungated environment(s) permitted to apply without an approving review, "
            f"per the `SHIPMATE_UNGATED_ENVS` repository variable: {envs} — "
            "see this run for what actually applied."
        )
    return lines


def _footer(gate, run_url, excluded, skipped, env_name, held=(), applied_ungated=()):
    """Excluded/skipped/held/ungated-env lines (all-environments form only), the
    gate sentence, then the run link."""
    parts = []
    if not env_name:
        parts.extend(_env_disposition_lines(excluded, skipped, held, applied_ungated))
    parts.append(_gate_sentence(gate))
    parts.append(f"[Logs & artifacts]({run_url})")
    return "\n\n".join(parts)


def _results_failed(results_csv):
    """Tokenize SHIPMATE_RESULTS (`join(needs.*.result, ',')`) and report
    whether any job-level outcome signals failure. One tokenizer, shared by the
    short form and the table path, so the two cannot disagree.

    A blank token counts as FAILURE. Dropping empty tokens would let a blank
    result read as clean, silently turning "failed" into "found no pending
    applies to run"."""
    tokens = results_csv.split(",")
    return any(t not in ("success", "skipped") for t in tokens)


def _apply_head(env_name, emoji, word):
    """The `:x:`/`:white_check_mark:` lead sentence. Shared so the table path's
    failure line reuses the exact wording instead of a reworded duplicate."""
    if env_name:
        return f"{emoji} shipmate: `shipmate apply {sc._md_escape(env_name)}` {word}."
    return f"{emoji} shipmate: `shipmate apply` (all environments) {word}."


def _short_form(
    results_csv, env_name, gate, run_url, excluded, skipped, held=(), applied_ungated=()
):
    """Used only when the expected set is empty and no cells were downloaded
    (nothing to tabulate). Carries the excluded/skipped/held/ungated-env lines
    too: an all-levels-empty run whose only pending work is an explicit or held
    env is exactly the case where they matter most."""
    if _results_failed(results_csv):
        head = _apply_head(env_name, ":x:", "failed")
    elif held:
        # Work WAS pending and the engine refused it — a green "found no
        # pending applies" head would contradict the Held sentence below it.
        head = _apply_head(
            env_name, ":no_entry_sign:", "applied nothing — environments are held for review"
        )
    else:
        head = _apply_head(env_name, ":white_check_mark:", "found no pending applies to run")
    parts = [head]
    if not env_name:
        parts.extend(_env_disposition_lines(excluded, skipped, held, applied_ungated))
    parts.append(_gate_sentence(gate))
    parts.append(f"[Logs & artifacts]({run_url})")
    return " ".join(parts)


def _failure_line(results_csv, rows, env_name):
    """The job-level failure signal, surfaced when the table cannot carry it.
    An apply run that dies before any cell reports (a denied apply
    environment, a job-level cancel) renders every expected cell as a benign
    not_attempted, with no ❌ anywhere — this restores it.

    `unrecorded` is deliberately NOT in the suppression set. Its ⚠️ describes
    ONE cell in ONE environment and says nothing about a different environment
    that died before reporting; suppressing on it would let a ⚠️ in env A
    swallow the only ❌ env B is ever going to get."""
    if not _results_failed(results_csv):
        return ""
    if any(r["status"] in ("failed", "blocked") for r in rows):
        return ""
    return _apply_head(env_name, ":x:", "failed")


def _top_section(env_name, results_csv, rows, jobs, run_url):
    """Header, any failure line directly beneath it, the table, then the
    state-lock, unrecorded and not-attempted notes, each when it has content.

    Split out of build_comment so the latter's C901 ceiling of 8 is not spent on
    this concatenation."""
    header = _header(env_name)
    table = build_table(rows, jobs, run_url)
    fail_line = _failure_line(results_csv, rows, env_name)
    top = "\n\n".join(s for s in (header, fail_line, table) if s)
    lock = _lock_note(rows, env_name)
    if lock:
        # Above the unrecorded note and below the table it points at: a held
        # lock is why the run failed, and nothing in those cells was applied.
        top += "\n\n" + lock
    unrecorded = _unrecorded_note(rows)
    if unrecorded:
        # Before the not-attempted note: a stranded applied cell needs a
        # re-plan, a not-attempted one only a retry.
        top += "\n\n" + unrecorded
    if any(r["status"] == "not_attempted" for r in rows):
        top += "\n\n" + _not_attempted_note(env_name)
    return top


def build_comment(
    rows,
    jobs,
    run_url,
    gate,
    excluded,
    skipped,
    env_name,
    results_csv="",
    held=(),
    applied_ungated=(),
):
    """Assemble the comment under SIZE_BUDGET. Sections render in table order:
    attempted cells get a details section, blocked cells a single no-fence
    line, not-attempted cells none.

    The space every remaining link-only fallback and blocked one-liner needs is
    reserved UP FRONT, together. Otherwise an early giant apply.txt starves a
    later cell's link, and hundreds of blocked cells starve the first attempted
    cell's guaranteed minimum by going uncounted until too late."""
    top = _top_section(env_name, results_csv, rows, jobs, run_url)
    footer = "\n\n" + _footer(gate, run_url, excluded, skipped, env_name, held, applied_ungated)
    used = len(top) + len(footer)

    urls = {id(r): _job_url(r, jobs, run_url) for r in rows}
    link_onlys = {
        id(r): _link_only(r, urls[id(r)]) for r in rows if r["status"] in _SECTION_STATUSES
    }
    blocked_lines = {id(r): _blocked_line(r, urls[id(r)]) for r in rows if r["status"] == "blocked"}
    reserve = sum(len(lo) + 2 for lo in link_onlys.values())
    reserve += sum(len(bl) + 2 for bl in blocked_lines.values())

    parts = [top]
    for r in rows:
        url = urls[id(r)]
        if r["status"] in _SECTION_STATUSES:
            reserve -= len(link_onlys[id(r)]) + 2
            limit = sc.SIZE_BUDGET - used - reserve - 2
            section = render_apply_section(r, r["apply_text"], url, limit)
            parts.append(section)
            used += len(section) + 2
        elif r["status"] == "blocked":
            line = blocked_lines[id(r)]
            reserve -= len(line) + 2
            parts.append(line)
            used += len(line) + 2
        # not_attempted: the table row + the note above is the whole statement.

    body = "\n\n".join(parts) + footer
    if len(body) > sc.HARD_CAP:
        # Extreme fan-out: even link-only sections (and blocked one-liners)
        # overflow. The table alone (<=256 rows) normally fits; every row
        # keeps its log link.
        fallback = "_Apply output too large for this comment — use each row's log link._"
        body = top + "\n\n" + fallback + footer
        if len(body) > sc.HARD_CAP:
            # Stack/env display names are author-controlled (fork-PR input), so even the
            # table-only fallback can exceed the hard cap at extreme fan-out. Fail loud
            # rather than let GitHub 422 the POST on an oversized comment body.
            raise SystemExit(
                "::error::apply table alone exceeds the 65,536-char comment "
                "cap — shorten stack/env display names"
            )
    return body


def main():
    jobs = ag.parse_jsonl(sys.stdin)
    downloaded = load_cells(os.environ.get("CELLS", "cells"))
    expected = _expected_cells()
    present, done = load_check_maps(
        os.environ.get("SHIPMATE_CHECKS", "checks.jsonl"),
        os.environ.get("SHIPMATE_APP_ID", ""),
    )
    rows = apply_check_state(build_rows(expected, downloaded), present, done)
    env_name = os.environ.get("SHIPMATE_ENVIRONMENT", "") or ""
    gate = os.environ.get("SHIPMATE_GATE", "")
    run_url = (
        f"{os.environ['GITHUB_SERVER_URL']}/{os.environ['GITHUB_REPOSITORY']}"
        f"/actions/runs/{os.environ['GITHUB_RUN_ID']}"
    )
    # Both render paths need these: an excluded explicit env can be the entire
    # reason nothing else is pending.
    excluded = json.loads(os.environ.get("SHIPMATE_EXCLUDED_ENVS") or "[]")
    skipped = json.loads(os.environ.get("SHIPMATE_SKIPPED_ENVS") or "[]")
    held = json.loads(os.environ.get("SHIPMATE_REVIEW_HELD_ENVS") or "[]")
    applied_ungated = json.loads(os.environ.get("SHIPMATE_APPLIED_UNGATED_ENVS") or "[]")
    results_csv = os.environ.get("SHIPMATE_RESULTS", "") or ""

    if not rows:
        body = _short_form(
            results_csv, env_name, gate, run_url, excluded, skipped, held, applied_ungated
        )
    else:
        body = build_comment(
            rows,
            jobs,
            run_url,
            gate,
            excluded,
            skipped,
            env_name,
            results_csv,
            held,
            applied_ungated,
        )

    with open("comment.md", "w", encoding="utf-8") as fh:
        fh.write(body)


if __name__ == "__main__":
    main()
