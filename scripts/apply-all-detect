#!/usr/bin/env python3
"""apply.yml detect, bare form: the bare `shipmate apply` work set -> env-levels -> waves.

The pre-merge equivalent of deploy-detect, sourced like apply-detect: cells are
the tree's stacks whose `apply / <stack> / <env>` check is on the head, each
applying from the plan run its own check records, and the environment entries'
`needs` bucket the pending ones into env-levels exactly as on the
merge-deploy path. Env membership comes from stack tags
(build-matrix.env_membership) so this module only ever constructs check names
forward, never reverse-parses them (deploy-detect's stranded-check refusal is the
one site that does); a stack with no `env/*` tag is in no environment and adds no cell.

Three exclusions distinguish the bare form from deploy:
- envs whose entry holds `explicit: true` (typically prod) are removed
  before env-levels are built; their apply checks stay pending, so
  `shipmate / gate` keeps gating the merge until a targeted
  `shipmate apply <env>` completes them. `excluded_envs` names every one with
  pending work, including those also held for review;
- envs ordered (transitively) after an env not applying this run — held or
  excluded as explicit — are skipped with a notice — their ordering
  precondition cannot be met this run, exactly like a failed predecessor
  level;
- envs the PR's review decision does not authorize are held until it carries
  an approving review, dropped the same way; an entry holding
  `gated: false` is exempt from that hold.
"""

import json
import os

from _shipmate import _load

ad = _load("apply-detect")
bm = _load("build-matrix")
eo = _load("env-order")
# No apply-gate load of its own -- see deploy-detect and test_detect_app_scoping. The
# apply-gate functions this path needs are reached through `ad.ag`, so there is no
# second apply-gate instance.


def cells_from_checks(check_names, stacks_by_env, tags_by_stack):
    """All-envs workset: per env (from tags, never from a parse of a check
    name), the tree's candidates whose forward-constructed check name is on the
    head — exactly the single-env path's matching and workload handling, run
    over every env."""
    cells = []
    for env in sorted(stacks_by_env):
        paths = ad.paths_with_checks(env, stacks_by_env[env], check_names)
        cells.extend(ad.cells_for_env(env, paths, tags_by_stack))
    return cells


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    head = os.environ["SHIPMATE_HEAD_SHA"]

    ad.validate_head_sha(head)

    stacks_by_env, tags_by_stack = bm.env_membership(all_stacks=True)
    app_id = os.environ["SHIPMATE_APP_ID"]
    lines = ad._check_run_lines(repo, head)
    cells = cells_from_checks(ad.apply_check_names(lines, app_id), stacks_by_env, tags_by_stack)
    table = bm.env_config(cells, bm.tagged_workloads(stacks_by_env, tags_by_stack))
    cells = bm.stamp_rows(cells, table, "apply")

    pending = ad.filter_pending(cells, ad.ag.app_done_names(lines, app_id))

    order = bm.ec.env_order(table)
    pending_envs = {c["environment"] for c in pending}
    ungated = bm.ec.ungated_envs(table)
    decision = os.environ.get("SHIPMATE_REVIEW_DECISION", "")
    # An absent decision reads as '' and holds every env. It is reachable only through
    # wiring drift: the review job has no `if:`, and a failed one skips this script.
    held = sorted(e for e in pending_envs if ad.az._review_reason(decision, e, ungated))
    explicit = bm.ec.explicit_envs(table)
    stopped = pending_envs & set(explicit + held)
    skipped = sorted(eo.blocked_envs(order, stopped, pending_envs - stopped))
    # Every pending explicit env, held or not: the comment names a held one's
    # explicit command under the hold. A held env that is not explicit stays out.
    excluded = sorted(pending_envs & set(explicit))
    dropped = set(excluded) | set(skipped) | set(held)
    # The plan runs attach to `runnable`, not `pending`: an excluded or held env's checks
    # stay pending by design for a later targeted apply, and that apply refuses on its own
    # over a record-less cell, so refusing here would strand the envs that CAN apply.
    runnable = ad.with_plan_runs(
        [c for c in pending if c["environment"] not in dropped], lines, app_id
    )
    bm.refuse_workload_gaps(runnable, table)
    # From `runnable`, never from `pending & ungated`: an ungated env can still be
    # excluded or skipped, and claiming it applied is worse than saying nothing.
    applied_ungated = sorted(
        {
            c["environment"]
            for c in runnable
            if ad.az._ungated_exemption(decision, c["environment"], ungated)
        }
    )
    # From `runnable` for the same reason.
    no_review_required = sorted(
        {
            c["environment"]
            for c in runnable
            if ad.az._review_not_required(decision, c["environment"], ungated)
        }
    )

    deps = ad.run_graph_deps()
    # Before the padding, whose over-depth refusal is where this line helps most.
    print(ad.dag_shape_notice(deps))
    per_level = eo.env_level_waves(runnable, order, deps)
    level_counts = [sum(map(len, w.values())) for w in per_level]
    print(
        f"::notice title=apply-all-detect::head={head} "
        f"cells={len(cells)} pending={len(pending)} envlevels={level_counts} "
        f"excluded_explicit={excluded} skipped_after_explicit={skipped} "
        f"review_held={held} applied_ungated={applied_ungated} "
        # The hold cause: an everything-held run is otherwise indistinguishable
        # from a CHANGES_REQUESTED one, and an absent decision (a mis-wired
        # review job) renders visibly as ''.
        f"review_decision={decision!r}"
    )
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        eo.write_env_level_waves(fh, per_level)
        fh.write(f"head_sha={head}\n")
        fh.write(f"excluded_envs={json.dumps(excluded)}\n")
        fh.write(f"skipped_envs={json.dumps(skipped)}\n")
        fh.write(f"review_held_envs={json.dumps(held)}\n")
        fh.write(f"applied_ungated_envs={json.dumps(applied_ungated)}\n")
        fh.write(f"review_not_required_envs={json.dumps(no_review_required)}\n")


if __name__ == "__main__":
    main()
