#!/usr/bin/env python3
"""shipmate doctor: read-only GitHub-settings drift probes.

Three modes, selected via SHIPMATE_DOCTOR_MODE:
- annotate: run the probes and emit GitHub workflow-command annotations
  (::warning::/::notice::) on stdout, one line per finding. Used by
  actions/summary right after a plan run. NEVER fails the run: a probe
  error becomes a 'could not verify' note — doctor guards onboarding, it
  must not take down the plan path.
- report: render the sticky PR comment on demand — the ten live probes'
  findings plus a harvest of the warnings GitHub already recorded as
  annotations on this commit's workflow check runs.
- check-ids: reduce a check-runs JSONL listing to the (id, name) pairs worth
  fetching annotations for, one call ahead of `report`. Runs before the rest
  of doctor's env contract is read.

An index only — one bullet per entry in PROBES, pinned by
test_probe_count_is_stated_correctly_in_the_docs. Each probe's own docstring
carries its rationale; do not restate it here.

Probes:
- gate ruleset: `shipmate / gate` required, pinned to the App, strict policy on.
- `pull_request` rule: code-owner review required (an approval count is not a
  substitute — the App can submit an approving review).
- GitHub Environment pair (<env>, <env>-apply) exists for every planned env.
- protection shape of that pair: plan envs open, apply envs reviewed.
- `shipmate-engine`: exists, with a branch policy naming the default branch.
- secrets held by each declared plan environment.
- engine action-pin freshness in the consumer's workflow files.
- `pull_request_target` triggers in the consumer's workflow files.
- approvers team resolvability in the repo's org.
- GitHub App installation permission drift.
"""

import base64
import importlib.util
import json
import os
import pathlib
import re
import sys
from importlib.machinery import SourceFileLoader

_D = pathlib.Path(__file__).resolve().parent


def _load(fname):
    loader = SourceFileLoader(fname.replace("-", "_"), str(_D / fname))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


bm = _load("build-matrix")
_gh_json = bm.gh_json
sc = _load("summary-comment")
_md_escape = sc._md_escape

GATE = "shipmate / gate"

MODES = ("annotate", "report", "check-ids")
DOCTOR_TITLE = "shipmate doctor"
# Finding levels: NOTICE is informational (a legitimate-but-worth-knowing
# setting), WARNING is a misconfiguration. Rendered as ::notice::/::warning::
# in annotate mode.
WARNING, NOTICE = "warning", "notice"

# Findings of the review-rule probe. Format templates rather than finished
# tuples: each names the default branch, which is per repository.
_REVIEW_RULE_ABSENT = (
    "no active ruleset puts a `pull_request` rule on `{branch}` — nothing there "
    "requires the code-owner review that a leaked App private key cannot forge "
    "(docs/hardening.md #3–5). Classic branch protection is not reported by this "
    "endpoint, so check it if that is what this repository uses."
)
_CODE_OWNER_REVIEW_OFF = (
    "the `pull_request` rule on `{branch}` does not require code-owner review — "
    "the shipmate App can submit a counting approving review, so an approval count "
    "is no substitute against a leaked App private key. Set "
    "`require_code_owner_review`, and a `CODEOWNERS` entry covering the paths the "
    "IaC lives in: the rule is a no-op for changed files with no owner "
    "(docs/hardening.md #3–5)."
)
_SOLE_MAINTAINER_REVIEW = (
    "the `pull_request` rule on `{branch}` requires no approving review "
    "(sole-maintainer mode, docs/hardening.md #3–5) — a supported mode. "
    "`require_code_owner_review` is on, so the merge-side control a leaked App "
    "private key cannot satisfy is still in place."
)
# Same degrade posture as FORK_TRIGGER_UNREADABLE: unread is not misconfigured.
_REVIEW_RULE_UNREADABLE = (
    "the `pull_request` rule on `{branch}` carried no parameters — review "
    "requirements not verified."
)

DOCTOR_MARKER = "<!-- shipmate:doctor -->"
ANNOTATION_CAP = 10  # GitHub keeps at most 10 annotations per level per step
HARVEST_LEVELS = ("warning", "failure")
_LEVEL_EMOJI = {WARNING: ":warning:", NOTICE: ":information_source:"}
# The github-actions app authors the plan/apply/drift auto check-runs carrying
# shipmate's ::warning:: emissions; the shipmate App is matched by id instead
# (org-dependent slug). The consumer's own non-shipmate workflows are
# indistinguishable at this level and remain, hence the report heading says
# "workflow runs", not "shipmate runs".
_HARVEST_APP_SLUGS = ("github-actions",)
# Covers both shapes the gather step reports: nothing read at all, and some read
# but not all. A list item, so it reads as a peer of the rows it follows.
HARVEST_INCOMPLETE = (
    "- :warning: could not read all of this commit's check runs — any warnings recorded on "
    "the ones that could not be read are missing from this list."
)
# Distinct from HARVEST_INCOMPLETE: every read succeeded, there is simply
# nothing recorded YET. An empty payload is byte-identical to "no warnings", so
# without this a `shipmate doctor` typed while the plan run is queued gets an
# all-clear that is never refreshed.
HARVEST_PENDING = (
    "- :hourglass: some of this commit's workflow runs had not finished when this report was "
    "rendered — warnings they record later are not in this list; comment `shipmate doctor` "
    "again once they have finished."
)


def _gate_rule_warnings(ctx):
    repo, default_branch = ctx["repo"], ctx["default_branch"]
    rules = _gh_json(f"repos/{repo}/rules/branches/{default_branch}?per_page=100")
    for rule in rules:
        if rule.get("type") != "required_status_checks":
            continue
        params = rule.get("parameters", {})
        for chk in params.get("required_status_checks", []):
            if chk.get("context") != GATE:
                continue
            out = []
            if chk.get("integration_id") != int(ctx["app_id"]):
                out.append(
                    (
                        WARNING,
                        f"gate ruleset does not pin `integration_id` to the shipmate App "
                        f"(found {chk.get('integration_id')!r}) — a forged `{GATE}` status "
                        "from another identity would satisfy the required check.",
                    )
                )
            if not params.get("strict_required_status_checks_policy"):
                out.append(
                    (
                        WARNING,
                        "gate ruleset does not require branches to be up to date "
                        "(strict) — plans can go stale against the base before merge.",
                    )
                )
            return out
    return [
        (
            WARNING,
            f"no active ruleset requires `{GATE}` on `{default_branch}` — "
            "merges are not gated (see docs/branch-protection.md).",
        )
    ]


def _review_rule_warnings(ctx):
    """Code-owner review on the default-branch ruleset (`docs/hardening.md`
    #3–5) — with #6's `<env>-apply` reviewers, the controls a holder of the App
    private key structurally cannot satisfy: an App cannot be a CODEOWNER and
    cannot approve a pending deployment. So the finding keys on
    `require_code_owner_review`, never on an approval COUNT, which the App holds
    `pull-requests: write` to forge.

    Aggregated across every `pull_request` rule on the branch, not the first:
    GitHub enforces the union across layered rulesets, so an org ruleset
    supplying code-owner review must not be masked by a repo-level count-only
    rule listed first. Count 0 with code-owner review OFF is the one
    configuration with no unforgeable merge-time control at all, so it must not
    read as the sole-maintainer note.

    Re-reads `rules/branches` rather than sharing `_gate_rule_warnings`'
    response, for `_existing_env_names`' per-probe-degrade reason.

    Two limits, both stated in the finding text or the docs rather than probed:
    the endpoint returns rulesets only (classic branch protection reads as no
    rule), and `require_code_owner_review` is a no-op for changed files no
    `CODEOWNERS` entry owns."""
    branch = ctx["default_branch"]
    rules = _gh_json(f"repos/{ctx['repo']}/rules/branches/{branch}?per_page=100")
    found = readable = code_owner = False
    count = 0
    for rule in rules:
        if rule.get("type") != "pull_request":
            continue
        found = True
        params = rule.get("parameters") or {}
        if not params:
            continue
        readable = True
        code_owner = code_owner or bool(params.get("require_code_owner_review"))
        count = max(count, params.get("required_approving_review_count") or 0)
    if not found:
        return [(WARNING, _REVIEW_RULE_ABSENT.format(branch=branch))]
    if not readable:
        return [(NOTICE, _REVIEW_RULE_UNREADABLE.format(branch=branch))]
    if not code_owner:
        return [(WARNING, _CODE_OWNER_REVIEW_OFF.format(branch=branch))]
    if not count:
        return [(NOTICE, _SOLE_MAINTAINER_REVIEW.format(branch=branch))]
    return []


def _existing_env_names(ctx):
    """The repository's GitHub Environment names.

    THE LISTING IS THE ONLY EXISTENCE ORACLE. `bm.gh_json`'s exception carries
    no status code, so a per-environment read cannot tell a 404 (absence, which
    is `_environment_warnings`' finding) from a 403 or a 5xx. Every probe below
    that needs existence decides it from here, then treats a failed
    per-environment read as "not checked" — inferring absence from that read
    would let a token lacking `environments` access produce loud findings about
    environments that are fine, while a genuine 403 on a present one passes as
    healthy. A failure of this listing is the caller's precondition and
    propagates to `warnings()`' degrade note.

    Re-read per probe rather than shared through `ctx`: `warnings()` degrades
    per probe, so one endpoint failure must not silence the others.

    per_page=100: one page covers >=50 logical env pairs; bm.gh_json does not
    multi-page merge."""
    listing = _gh_json(f"repos/{ctx['repo']}/environments?per_page=100")
    return {e["name"] for e in listing.get("environments", [])}


def _environment_warnings(ctx):
    if not ctx["envs_available"]:
        return [
            (
                NOTICE,
                "no plan run with cell summaries for this commit — the declared "
                "environment set is unknown, so the environment probes were skipped.",
            )
        ]
    names = _existing_env_names(ctx)
    out = []
    for env in sorted(ctx["envs"]):
        for needed in (env, f"{env}-apply"):
            if needed not in names:
                out.append(
                    (
                        WARNING,
                        f"GitHub Environment `{needed}` does not exist — stacks tagged "
                        f"`env:{env}` cannot plan/apply (create it and set TF_VAR_* vars).",
                    )
                )
    return out


def _env_shape_findings(name, env, data, is_apply):
    """One environment's protection-shape findings, from its already-read
    "Get an environment" payload."""
    out = []
    rules = sorted({r.get("type") for r in data.get("protection_rules", []) if r.get("type")})
    # GitHub reports "branch_policy" whenever deployment_branch_policy is set.
    # Excluded both ways: it refuses a plan job outright rather than delaying it
    # (handled below), and it is not a review, so an apply env carrying nothing
    # else is still entirely unreviewed.
    approval = [r for r in rules if r != "branch_policy"]
    policy = data.get("deployment_branch_policy")
    if not is_apply and approval:
        out.append(
            (
                WARNING,
                f"GitHub Environment `{name}` is a plan environment but has "
                f"protection rules ({', '.join(approval)}) — plan jobs will not "
                f"start immediately; put reviewers on `{env}-apply` instead.",
            )
        )
    if not is_apply and policy:
        out.append(
            (
                WARNING,
                f"GitHub Environment `{name}` is a plan environment but has a "
                "deployment branch policy — plans from feature branches will be "
                "refused; plan environments must allow all branches.",
            )
        )
    if is_apply and not approval:
        # NOTICE, not WARNING: legitimate for dev-tier envs. Worded on
        # `approval`, not on the raw rule list: a deployment branch policy may
        # be present, so claiming "no protection rules" would be false.
        out.append(
            (
                NOTICE,
                f"GitHub Environment `{name}` has no approval rules (required reviewers "
                "or a wait timer) — pre-merge applies to it are unreviewed.",
            )
        )
    return out


def _env_protection_warnings(ctx):
    """Plan/apply env split, checked live. An approval-type protection rule on
    a PLAN env — a required reviewer, or a wait timer — stops plan jobs from
    starting when they should: no error, just a stalled matrix, which is the
    hardest shipmate misconfiguration to diagnose. An APPLY env with no approval
    rule is the mirror problem: pre-merge applies to it are unreviewed.

    Existence comes from `_existing_env_names`; see its docstring."""
    out = []
    if not ctx["envs"]:
        # Nothing to probe, so nothing to read: listing the environments anyway
        # would let a repository whose token cannot list them collect a
        # "could not verify" degrade for a probe that had no work to do. The
        # skipped-probe statement itself lives in `_environment_warnings`.
        return out
    existing = _existing_env_names(ctx)
    for env in sorted(ctx["envs"]):
        for name, is_apply in ((env, False), (f"{env}-apply", True)):
            if name not in existing:
                continue  # existence is _environment_warnings' finding
            try:
                data = _gh_json(f"repos/{ctx['repo']}/environments/{name}")
            except (Exception, SystemExit) as e:  # noqa: BLE001 - degrade, see docstring
                out.append(
                    (
                        NOTICE,
                        f"GitHub Environment `{name}` exists but its settings could not be "
                        f"read ({_degrade_reason(e)}) — its plan/apply protection shape was "
                        "not checked.",
                    )
                )
                continue
            out.extend(_env_shape_findings(name, env, data, is_apply))
    return out


_ENGINE_ENV = "shipmate-engine"


def _engine_environment_warnings(ctx):
    """The App private key lives in the `shipmate-engine` GitHub Environment,
    not a repository secret — a deployment branch policy scoped to the
    default branch is the only thing that stops a branch workflow from
    reading it. A consumer that re-pins the engine but never creates this
    environment (or creates it with no branch policy, or one that does not
    actually name the default branch) has nothing scoping the key, and
    believes they are protected. What this probe observes is the
    environment's shape, never where the key actually lives -- listing
    repository secrets needs an App permission app/manifest.json does not
    declare -- so its warnings say what was seen and leave the repository
    secret conditional.

    Existence comes from `_existing_env_names`; see its docstring."""
    repo, default_branch = ctx["repo"], ctx["default_branch"]
    if _ENGINE_ENV not in _existing_env_names(ctx):
        return [
            (
                WARNING,
                f"GitHub Environment `{_ENGINE_ENV}` does not exist — nothing scopes "
                "which branches may claim the shipmate App private key. If the key is "
                "still a repository secret, every branch's workflow can read it (see "
                "docs/github-app.md).",
            )
        ]
    try:
        env = _gh_json(f"repos/{repo}/environments/{_ENGINE_ENV}")
    except (Exception, SystemExit) as e:  # noqa: BLE001 - degrade, see warnings()
        return [
            (
                NOTICE,
                f"GitHub Environment `{_ENGINE_ENV}` exists but its settings could not be "
                f"read ({_degrade_reason(e)}) — its branch-policy scoping was not checked.",
            )
        ]
    policy = env.get("deployment_branch_policy")
    if not policy:
        return [
            (
                WARNING,
                f"GitHub Environment `{_ENGINE_ENV}` has no deployment branch policy — "
                "a workflow on any branch can still claim the App private key it "
                f"holds. Restrict it to `{default_branch}`.",
            )
        ]
    if not policy.get("custom_branch_policies"):
        # protected_branches-only restricts deploys to whatever branch
        # protection covers, which is not necessarily the default branch alone
        # -- not the specific guarantee this probe exists to confirm.
        return [
            (
                WARNING,
                f"GitHub Environment `{_ENGINE_ENV}`'s deployment branch policy does not "
                f"use a custom policy naming `{default_branch}` — its actual scope could "
                "not be confirmed as default-branch-only.",
            )
        ]
    try:
        policies = _gh_json(f"repos/{repo}/environments/{_ENGINE_ENV}/deployment-branch-policies")
    except (Exception, SystemExit) as e:  # noqa: BLE001 - degrade, see warnings()
        return [
            (
                NOTICE,
                f"could not read `{_ENGINE_ENV}`'s deployment branch policies "
                f"({_degrade_reason(e)}) — its scope was not checked.",
            )
        ]
    names = {p.get("name") for p in (policies or {}).get("branch_policies", [])}
    if names != {default_branch}:
        if default_branch not in names:
            detail = (
                f"does not name `{default_branch}` — a branch other than the "
                "default can still claim the App private key."
            )
        else:
            extra = ", ".join(sorted(f"`{n}`" for n in names - {default_branch}))
            detail = (
                f"also permits {extra} — a workflow on those branches can still "
                "claim the App private key."
            )
        return [
            (
                WARNING,
                f"GitHub Environment `{_ENGINE_ENV}`'s deployment branch policy {detail}",
            )
        ]
    return []


# Named `_APP_KEY_NAME`, not `..._SECRET`: ruff's S105 hardcoded-password rule
# fires on a "SECRET" token in the binding name, and this is a secret's *name*.
_APP_KEY_NAME = "SHIPMATE_APP_PRIVATE_KEY"

# Emitted when the env-scoped token is absent: the listing needs the
# `environments: read` permission app/manifest.json declares, and an
# installation that has not accepted the request yet cannot mint it. A silent
# skip here would be byte-identical to "no plan environment holds a secret",
# which is the one thing this probe exists to be able to say.
_ENV_TOKEN_UNCHECKED = (
    WARNING,
    "plan-environment secrets were not checked — minting a token with the "
    "`environments: read` permission `app/manifest.json` declares did not succeed, "
    "which usually means the shipmate App installation has not accepted the "
    "permission request yet. Accept it in the installation settings, then comment "
    "`shipmate doctor` again.",
)


def _env_secret_names(ctx, name):
    """(names, total) of one environment's secrets.

    Names only -- no REST path returns a secret's value.

    Publishing those names is a deliberate trade: the report surface may be
    world-readable, and GitHub gates this metadata behind `environments: read`.
    Published anyway because "holds 3 secret(s)" tells an operator nothing about
    which credential to move.

    Read with SHIPMATE_ENV_TOKEN, restoring GH_TOKEN afterwards -- the ambient
    App token is minted without `environments: read` and every other probe still
    needs it. `total` comes from the payload, not the list length, because
    `bm.gh_json` does not multi-page.
    """
    saved = os.environ.get("GH_TOKEN")
    # `.get`, never a subscript: SHIPMATE_ENV_TOKEN is optional by contract --
    # absent, the probe reports the check as not performed
    # (`_ENV_TOKEN_UNCHECKED`) rather than killing the report.
    os.environ["GH_TOKEN"] = os.environ.get("SHIPMATE_ENV_TOKEN", "")
    try:
        data = _gh_json(f"repos/{ctx['repo']}/environments/{name}/secrets?per_page=100")
    finally:
        if saved is None:
            os.environ.pop("GH_TOKEN", None)
        else:
            os.environ["GH_TOKEN"] = saved
    names = [
        s.get("name")
        for s in (data.get("secrets") or [])
        if isinstance(s.get("name"), str) and s.get("name")
    ]
    total = data.get("total_count")
    return names, total if isinstance(total, int) and total > len(names) else len(names)


def _app_key_findings(env, names, total):
    """The App-key half of the plan-env secret finding, for one environment.

    `bm.gh_json` does not multi-page, so on a truncated listing the key can sit
    outside the page: absence is reportable as absence ONLY when the read was
    complete. A partial listing says the check could not be completed rather
    than passing the most dangerous configuration off as a routine note. Both
    are WARNING -- a check that went dark over this is not a note.
    """
    if _APP_KEY_NAME in names:
        return [
            (
                WARNING,
                f"plan environment `{env}` holds `{_APP_KEY_NAME}` — plan-time "
                "code execution can mint an App token with it, forge the "
                f"`{GATE}` status and approve its own pull request. The key belongs "
                f"only in `{_ENGINE_ENV}` (docs/github-app.md §Key-exposure "
                "boundary).",
            )
        ]
    if total > len(names):
        return [
            (
                WARNING,
                f"plan environment `{env}` holds {total} secret(s) but only "
                f"{len(names)} name(s) could be read, so whether `{_APP_KEY_NAME}` "
                "is one of them was not determined — no document blesses that "
                "configuration. List the environment's secrets in its settings and "
                "remove the key if it is there (docs/github-app.md §Key-exposure "
                "boundary).",
            )
        ]
    return []


def _plan_env_secret_warnings(ctx):
    """What a plan environment holds is the whole blast radius of plan-time code
    execution. `docs/hardening.md` control 8 pins plan environments open by
    construction -- no approval rules, no branch policy, or every plan cell
    stalls -- so anything in one is readable by anyone who can push a branch.

    A plan environment's baseline is zero secrets, so any name this returns is a
    consumer credential and no name-pattern matching is needed -- a deny list
    would be incomplete by construction and read "safe" for what it forgot.

    NOTICE, not WARNING: control 8 permits read-only, blast-radius-free
    credentials here, and doctor's WARNING means misconfiguration.
    `SHIPMATE_APP_PRIVATE_KEY` is the exception, matched by exact name.

    The finding states control 8's rule NORMATIVELY, never that this environment
    is unprotected -- that read belongs to `_env_protection_warnings`, and
    coupling them would let one probe's failure silence the other.

    Order is load-bearing. The declared-env check comes first: a docs-only pull
    request reads nothing, so the dark-check WARNING would be a false alarm
    there. Existence then comes from `_existing_env_names`; see its docstring.
    Scope is plan environments only: `<env>-apply` is where control 7 *requires*
    credentials, and `shipmate-engine` holds the App key by design.
    """
    if not ctx["envs"]:
        return []
    if not os.environ.get("SHIPMATE_ENV_TOKEN"):
        return [_ENV_TOKEN_UNCHECKED]
    existing = _existing_env_names(ctx)
    out = []
    for env in sorted(ctx["envs"]):
        if env not in existing:
            continue  # existence is _environment_warnings' finding
        try:
            names, total = _env_secret_names(ctx, env)
        except (Exception, SystemExit) as e:  # noqa: BLE001 - degrade, see docstring
            out.append(
                (
                    NOTICE,
                    f"GitHub Environment `{env}`'s secrets could not be listed "
                    f"({_degrade_reason(e)}) — whether this plan environment holds "
                    "credentials reachable by plan-time code was not checked.",
                )
            )
            continue
        if not names:
            continue
        # Capped like the all-clear line's environment list: the settings section
        # is never truncated, so one crowded environment would spend the whole of
        # `sc.SIZE_BUDGET` and push the other findings into the omitted fallback.
        # `count` still reports the true total, so the cap only hides names.
        shown = _one_line(", ".join(f"`{n}`" for n in sorted(names)), 400)
        count = f"at least {total}" if total > len(names) else str(len(names))
        out.append(
            (
                NOTICE,
                f"plan environment `{env}` holds {count} secret(s) ({shown}) — a plan "
                "cell runs the pull request branch's own code with whatever this "
                "environment releases to it, and a plan environment must have no "
                "approval rules and no deployment branch policy for its plan cells to "
                "run at all, so treat anything it holds as readable by anyone who can "
                "push a branch. Keep them read-only and blast-radius-free, or move to "
                "OIDC (docs/hardening.md control 8).",
            )
        )
        out += _app_key_findings(env, names, total)
    return out


_PIN = re.compile(
    r"uses:\s*['\"]?(?P<owner>[\w.-]+)/(?P<repo>[\w.-]+)/(?:actions|\.github)/"
    r"[\w./-]+@(?P<ref>[\w./-]+)"
)
_SHA40 = re.compile(r"[0-9a-fA-F]{40}")


_WORKFLOWS_DIR = ".github/workflows"
# Degrade for any unreadable contents call in this probe family, at NOTICE like
# the unreadable-release degrade below: a repo can legitimately fail this read
# (the directory does not exist on the ref being read -- the first shipmate PR
# is the one that adds it -- or the token cannot see it, or the API is
# transiently failing), and none of those are a misconfiguration to warn about.
# It must never fall through to the generic WARNING degrade in warnings().
PIN_UNREADABLE = (
    NOTICE,
    f"could not read `{_WORKFLOWS_DIR}` — engine pin freshness not verified.",
)
# The two preconditions this probe cannot work without. Both are NOTICE, like
# the unreadable-contents degrade above: neither is a repository
# misconfiguration, and neither may be silently substituted with a weaker read.
PIN_NO_COMMIT = (
    NOTICE,
    "engine pin freshness not verified — the commit under examination could not be determined.",
)
PIN_NO_ENGINE = (
    NOTICE,
    "engine pin freshness not verified — the engine repository could not be determined.",
)


def _contents_ref(ctx):
    """`?ref=` suffix for the workflow-file reads — the commit under
    examination — or None when there is no usable one.

    Never the default branch: a stale pin is fixed by a PR that bumps the SHA,
    and that SHA lives only on the PR head until it merges, so a default-branch
    read reports the pin stale on the very PR that fixes it. "No commit" is
    therefore a reason to SKIP the probe, not to read something else.

    Anything that is not a 40-char hex SHA counts as absent rather than being
    interpolated into the request path (same guard as apply-detect's) — a probe
    must not be able to retarget a `gh api` URL, however it was configured."""
    sha = ctx.get("head_sha") or ""
    return f"?ref={sha}" if _SHA40.fullmatch(sha) else None


def _workflow_names(base):
    """([names], readable): the `.yml`/`.yaml` regular files of the workflow
    directory listing.

    A non-file entry (a directory named `*.yml`) is skipped rather than
    degraded: the probes reading this scan file CONTENT and cannot read one, and
    treating it as an unreadable file would trip their stop-at-the-first-failure
    branch and silently drop every finding in the rest of the directory."""
    try:
        listing = _gh_json(base)
    except (Exception, SystemExit):  # noqa: BLE001 - degrade, see PIN_UNREADABLE
        return [], False
    return [
        e["name"]
        for e in listing
        if e["name"].endswith((".yml", ".yaml")) and e.get("type") == "file"
    ], True


def _workflow_text(path):
    """One workflow file's decoded text, or None when it cannot be read.

    Anything that is not a base64 blob is UNREADABLE, not empty: a >1 MB file
    answers with `encoding: "none"` and empty `content`, which would otherwise
    decode to a readable EMPTY workflow the probes read as clean.

    `errors="replace"` keeps a mis-encoded byte from raising, and one leading
    U+FEFF is dropped: a BOM sits in front of the column-0 `on:` key, which
    `_on_block` would otherwise read as no top-level trigger block at all.
    """
    try:
        blob = _gh_json(path)
    except (Exception, SystemExit):  # noqa: BLE001 - degrade, see PIN_UNREADABLE
        return None
    if not isinstance(blob, dict) or blob.get("encoding") != "base64":
        return None
    text = base64.b64decode(blob.get("content", "")).decode("utf-8", "replace")
    return text.removeprefix("\ufeff")


def _scan_workflow_texts(ctx, ref, per_file, unreadable):
    """Findings from `per_file(text, name)` over every workflow file at `ref`.

    Stops at the first unreadable file and reports `unreadable`: the same cause
    (permissions, a bad ref, an API outage) applies to the rest of the directory.

    KNOWN GAP, not a guarantee: files after that one are never examined, so a
    caller accumulating state across files (`_pins_in_workflows`' `seen`) hands
    its own caller a PARTIAL result that reads as complete. `unreadable` is the
    only signal, and it is a NOTICE, so a pin-freshness report can name stale
    pins in the files it read while saying nothing about the rest.

    The pin and fork-trigger probes each call this with their own reads rather
    than sharing one — a module-level cache would outlive a single probe run and
    couple two probes' failure modes — so each costs one listing plus one read
    per file."""
    base = f"repos/{ctx['repo']}/contents/{_WORKFLOWS_DIR}"
    names, readable = _workflow_names(f"{base}{ref}")
    if not readable:
        return [unreadable]
    out = []
    for name in names:
        text = _workflow_text(f"{base}/{name}{ref}")
        if text is None:
            out.append(unreadable)
            break
        out.extend(per_file(text, name))
    return out


def _pins_in_text(text, fname, ctx, seen):
    """Tag/branch-pin warnings for one workflow file, recording its SHA pins in
    `seen` ({slug: {(file, sha)}}) for the freshness comparison.

    Only pins of the engine's own repository are considered. Every finding here
    is worded about the engine — a moving ref letting the engine change under
    the consumer's deploy credentials, re-pinning to pick up engine fixes — and
    none of that is true of, say, another org's shared lint action, which holds
    no deploy credentials and has its own release cadence."""
    out = []
    repo, engine = ctx["repo"], ctx["engine_repo"]
    for m in _PIN.finditer(text):
        slug, ref = f"{m.group('owner')}/{m.group('repo')}", m.group("ref")
        if slug == repo:
            continue  # a repo pinning its own actions is not an engine pin
        if slug != engine:
            continue  # a third party's action is not shipmate's to report on
        if not _SHA40.fullmatch(ref):
            out.append(
                (
                    WARNING,
                    f"`{fname}` pins `{slug}@{ref}` by tag or branch — pin a "
                    "commit SHA (a moving ref lets the engine change under your "
                    "deploy credentials).",
                )
            )
            continue
        seen.setdefault(slug, set()).add((fname, ref.lower()))
    return out


def _pins_in_workflows(ctx):
    """(warnings, {slug: {(file, sha)}}) for every engine action pin found in
    the consumer's workflow files at the commit under examination. The engine's
    owner/repo comes from `ctx["engine_repo"]`, discovered at runtime from
    `github.action_repository` — shipmate never hardcodes an org. Either
    precondition missing, or an unreadable listing or file, degrades to a NOTICE
    rather than an error; the preconditions are checked before any API call,
    since without them no read could be interpreted anyway."""
    seen = {}
    if not ctx["engine_repo"]:
        return [PIN_NO_ENGINE], seen
    ref = _contents_ref(ctx)
    if ref is None:
        return [PIN_NO_COMMIT], seen
    out = _scan_workflow_texts(
        ctx,
        ref,
        lambda text, name: _pins_in_text(text, name, ctx, seen),
        PIN_UNREADABLE,
    )
    return out, seen


def _latest_release_sha(slug):
    """(tag, sha) of `slug`'s latest release; (None, None) when unreadable.

    Cross-repo read: the ambient GH_TOKEN is an App installation token scoped
    to the consumer repo and may not read the engine repo. Prefer
    SHIPMATE_PUBLIC_TOKEN (the workflow token — enough for a public-repo read)
    for these two calls only, restoring GH_TOKEN afterwards.
    """
    saved, public = os.environ.get("GH_TOKEN"), os.environ.get("SHIPMATE_PUBLIC_TOKEN")
    if public:
        os.environ["GH_TOKEN"] = public
    try:
        tag = _gh_json(f"repos/{slug}/releases/latest").get("tag_name")
        if not tag:
            return None, None
        return tag, _gh_json(f"repos/{slug}/commits/{tag}").get("sha")
    except (Exception, SystemExit):  # noqa: BLE001 - unreadable release is a NOTICE upstream
        return None, None
    finally:
        if public:
            if saved is None:
                os.environ.pop("GH_TOKEN", None)
            else:
                os.environ["GH_TOKEN"] = saved


def _pin_warnings(ctx):
    out, seen = _pins_in_workflows(ctx)
    for slug, pins in sorted(seen.items()):
        tag, sha = _latest_release_sha(slug)
        if not sha:
            # NOTICE, not WARNING: degrade, don't alarm.
            out.append(
                (
                    NOTICE,
                    f"could not read `{slug}`'s latest release — engine pin freshness "
                    "not verified.",
                )
            )
            continue
        differing = sorted({(f, ref) for f, ref in pins if ref != sha})
        for fname, ref in differing:
            out.append(
                (
                    WARNING,
                    f"`{fname}` pins `{slug}@{ref[:7]}`, which differs from the latest "
                    f"release {tag} (`{sha[:7]}`) — re-pin to pick up fixes.",
                )
            )
    return out


# The search is scoped to the workflow's top-level `on:` value, at the level
# where event names live: a `run:` body, an `if:` expression and a
# `strategy.matrix` value are not in that block at all, and a
# `workflow_dispatch` input's `options:` entry is nested below it. The token
# match takes word-ish boundaries so `pull_request_target_foo` is a different
# trigger. doctor is stdlib-only and cannot yaml.safe_load, so the block is
# sliced by indentation.
_PR_TARGET = re.compile(r"(?<![\w-])pull_request_target(?![\w-])")
# Same degrade posture and reason as PIN_UNREADABLE: an unreadable workflow
# directory is not a misconfiguration to warn about.
FORK_TRIGGER_UNREADABLE = (
    NOTICE,
    f"could not read `{_WORKFLOWS_DIR}` — `pull_request_target` triggers not verified.",
)
FORK_TRIGGER_NO_COMMIT = (
    NOTICE,
    "`pull_request_target` triggers not verified — the commit under examination "
    "could not be determined.",
)


#: `on` at column 0 only, optionally quoted: a workflow's `on:` is a top-level
#: key, so an indented one belongs to something else. `_on_block` matches rather
#: than searches, and that is the whole of the anchoring — unanchored,
#: `    python-version: 3.12` matches (`versi` + `on:`) and silently retargets
#: the block this probe reads.
_ON_KEY = re.compile(r"""["']?on["']?[ \t]*:(?P<rest>.*)$""")


def _strip_comment(line):
    """`line` up to its YAML comment marker: a `#` at the start of the line or
    preceded by whitespace. A `#` inside a token (`branch#1`) is not a comment."""
    for i, ch in enumerate(line):
        if ch == "#" and (i == 0 or line[i - 1] in " \t"):
            return line[:i]
    return line


def _on_block(text):
    """(inline remainder of the `on:` line, its following lines) with comments
    stripped, or (None, []) for a file with no top-level `on:`. The block runs to
    the first line starting at column 0; blank and comment-only lines do not end
    it."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        m = _ON_KEY.match(line)
        if not m:
            continue
        block = []
        for nxt in lines[i + 1 :]:
            stripped = _strip_comment(nxt)
            if stripped.strip() and not stripped[0].isspace():
                break
            block.append(stripped)
        return _strip_comment(m.group("rest")), block
    return None, []


def _event_lines(inline, block):
    """The lines of an `on:` value that can name an event: the inline remainder,
    plus — for a block mapping or sequence — only its shallowest children.
    Anything deeper is one event's own configuration (`types:`, a
    `workflow_dispatch` input's `options:`). A flow collection is a single value
    however it is wrapped across lines, so all of its lines count."""
    content = [ln for ln in [inline, *block] if ln.strip()]
    if content and content[0].lstrip()[:1] in ("[", "{"):
        return content
    indents = [len(ln) - len(ln.lstrip()) for ln in block if ln.strip()]
    if not indents:
        return [inline]
    top = min(indents)
    return [inline] + [ln for ln in block if ln.strip() and len(ln) - len(ln.lstrip()) == top]


def declares_pull_request_target(text):
    """Whether a workflow file declares the `pull_request_target` trigger.

    Comments are stripped first: `# never add pull_request_target here` is
    exactly the line a repository writes *because* it does not have one, and
    reporting it would train readers to ignore the finding."""
    inline, block = _on_block(text)
    if inline is None:
        return False
    return any(_PR_TARGET.search(ln) for ln in _event_lines(inline, block))


def _fork_trigger_warnings(ctx):
    """`pull_request_target` runs at the **base** ref, so it is handed the
    repository's secrets — and the base ref is exactly what `shipmate-engine`'s
    default-branch-only policy trusts, so a job declaring that environment would
    be handed the App key too — while checking out and acting on content the pull
    request author controls. That is the fork-reachable form of the
    branch-authored-workflow attack `docs/hardening.md` opens with, and the one
    misconfiguration on that page an outside contributor can reach without push
    access.

    Reads the consumer's workflow files at the commit under examination, the
    same way and for the same reason as the pin probe (`_contents_ref`): a pull
    request that *removes* the trigger must not still be reported for it."""
    ref = _contents_ref(ctx)
    if ref is None:
        return [FORK_TRIGGER_NO_COMMIT]

    def finding(text, name):
        if not declares_pull_request_target(text):
            return []
        return [
            (
                WARNING,
                f"`{name}` triggers on `pull_request_target` — that trigger runs at "
                "the base ref with this repository's secrets, and on a pull request "
                "into the default branch that is the ref `shipmate-engine`'s branch "
                "policy trusts, while acting on content the pull request author "
                "controls, so a fork can reach them. Remove it, or move the "
                "privileged work to a `workflow_run` job (see docs/hardening.md).",
            )
        ]

    return _scan_workflow_texts(ctx, ref, finding, FORK_TRIGGER_UNREADABLE)


def _one_line(s, limit=200):
    flat = " ".join(s.split())
    return flat if len(flat) <= limit else flat[: limit - 1] + "…"


def _team_warnings(ctx):
    """A typo'd or cross-org SHIPMATE_APPROVERS_TEAM surfaces today only as
    every apply being rejected "not a team member" — one API call names it."""
    if not ctx["team"]:
        return []
    try:
        team = _gh_json(f"orgs/{ctx['owner']}/teams/{ctx['team']}")
        resolved = isinstance(team, dict) and bool(team.get("slug"))
    except (Exception, SystemExit):  # noqa: BLE001 - a failed lookup IS the finding
        resolved = False
    if resolved:
        return []
    return [
        (
            WARNING,
            f"approvers team `{ctx['team']}` does not resolve in org `{ctx['owner']}` — "
            'every `shipmate apply` will be rejected as "not a team member". Check the '
            "SHIPMATE_APPROVERS_TEAM variable and that the App has members:read.",
        )
    ]


def _app_permission_warnings(ctx):
    """The comment path attempts an installation-token mint requesting every
    permission app/manifest.json declares. A failed mint is not a definitive
    signal -- it usually means the installation is missing a permission
    (typical after a manifest bump nobody re-approved), but a transient API
    error or rate limit produces the exact same failed-mint outcome, so the
    finding is worded as a hedge rather than a claim. Skipped where no such
    attempt was made."""
    if not ctx["app_permissions_checked"] or not ctx["app_permission_error"]:
        return []
    return [
        (
            WARNING,
            f"{_one_line(ctx['app_permission_error'])}, which usually means the shipmate App "
            "installation is missing a permission the manifest declares — re-accept the App's "
            "permission request in the installation settings (or retry if the API was "
            "transiently failing).",
        )
    ]


PROBES = (
    _gate_rule_warnings,
    _review_rule_warnings,
    _environment_warnings,
    _env_protection_warnings,
    _engine_environment_warnings,
    _plan_env_secret_warnings,
    _pin_warnings,
    _fork_trigger_warnings,
    _team_warnings,
    _app_permission_warnings,
)


def _probe_label(probe):
    """Reader-facing name of a probe, from its function name: `_pin_warnings`
    -> "pin". Used by the degrade note below so a reader learns which probe was
    skipped instead of being shown the `gh api` call that failed."""
    return probe.__name__.strip("_").removesuffix("_warnings").replace("_", " ")


def _degrade_reason(e):
    """The failure reason, safe in a comment body or an annotation. Strips
    `bm.gh_json`'s `::error::...: gh api <path>` wrapper -- the workflow-command
    prefix would nest inside `::warning ...::` in annotate mode, and the
    endpoint is an internal detail no reader can act on."""
    return _one_line(str(e).removeprefix("::error::").split(": gh api ")[0], 120)


def warnings(ctx):
    out = []
    for probe in PROBES:
        try:
            out.extend(probe(ctx))
        # noqa: BLE001 - doctor must never fail the run. `bm.gh_json` raises
        # SystemExit, not a plain Exception, so both are caught -- but never
        # bare BaseException, so KeyboardInterrupt still propagates.
        except (Exception, SystemExit) as e:  # noqa: BLE001
            out.append(
                (
                    WARNING,
                    f"doctor could not verify the {_probe_label(probe)} settings "
                    f"({_degrade_reason(e)}) — probe skipped.",
                )
            )
    return out


def _gha_escape(s):
    """GHA workflow-command data escaping (percent first, or it double-escapes)."""
    return s.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")


def render_annotations(findings):
    return [f"::{lvl} title={DOCTOR_TITLE}::{_gha_escape(text)}" for lvl, text in findings]


def _declared_envs(cells_dir):
    """Skip a cell.json that can't be read/parsed or lacks a usable
    "environment" rather than raising: a truncated file is plausible after a
    partial `gh run download`, and doctor must never fail a run over one bad
    file. A non-string or empty value is dropped too -- it would otherwise run
    every environment probe against a name that cannot exist."""
    envs = set()
    # Recursive: a single matching artifact is extracted without its
    # per-artifact directory (see scripts/pending-checks), so both layouts
    # occur.
    for cj in cells_dir.glob("**/cell.json"):
        try:
            env = json.loads(cj.read_text(encoding="utf-8"))["environment"]
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if isinstance(env, str) and env:
            envs.add(env)
    return envs


def ctx_from_env():
    repo = os.environ["GITHUB_REPOSITORY"]
    cells = pathlib.Path(os.environ.get("SHIPMATE_CELLS_DIR", "cells"))
    envs = _declared_envs(cells)
    return {
        "repo": repo,
        "owner": repo.split("/")[0],
        "app_id": os.environ["SHIPMATE_APP_ID"],
        "default_branch": os.environ["SHIPMATE_DEFAULT_BRANCH"],
        "envs": envs,
        "envs_available": bool(envs),
        "team": os.environ.get("SHIPMATE_TEAM") or None,
        "app_permissions_checked": os.environ.get("SHIPMATE_APP_PERMISSIONS_CHECKED") == "true",
        "app_permission_error": os.environ.get("SHIPMATE_APP_PERMISSION_ERROR", ""),
        "head_sha": os.environ.get("SHIPMATE_HEAD_SHA", ""),
        # github.action_repository: the owner/repo of the running action, i.e.
        # the engine's own slug, resolved by GitHub at runtime. Empty when the
        # action runs from a local path instead of a pinned slug.
        "engine_repo": os.environ.get("SHIPMATE_ENGINE_REPO", ""),
        "plan_run_id": os.environ.get("SHIPMATE_PLAN_RUN_ID", ""),
        "annotations_dir": os.environ.get("SHIPMATE_ANNOTATIONS_DIR", "ann"),
        "check_ids_path": os.environ.get("SHIPMATE_CHECK_IDS", "check-ids.tsv"),
        "harvest_failed": os.environ.get("SHIPMATE_HARVEST_FAILED") == "true",
        "harvest_pending": os.environ.get("SHIPMATE_HARVEST_PENDING") == "true",
    }


def _parse_check_run(line, app_id):
    """A single check-runs JSONL line -> its run dict, or None when the line
    is blank, unparseable, not a JSON object, or not authored by a
    shipmate-relevant app -- never raises, so one bad line can't take down
    the whole report."""
    line = line.strip()
    if not line:
        return None
    try:
        run = json.loads(line)
    except ValueError:
        return None
    if not isinstance(run, dict):
        return None
    if run.get("app_slug") not in _HARVEST_APP_SLUGS and not (
        app_id and str(run.get("app_id")) == str(app_id)
    ):
        return None
    return run


def latest_check_ids(lines, app_id=""):
    """[(id, name)] -- newest run per check name among shipmate-relevant
    authors. Ranks by `started_at`, not check-run `id` (unlike
    apply-gate.latest_by_name): a queued run has no `started_at` and no
    annotations to harvest, so ranking it BELOW a completed run is wanted."""
    newest = {}
    for line in lines:
        run = _parse_check_run(line, app_id)
        if run is None:
            continue
        name = run.get("name") or ""
        prev = newest.get(name)
        if prev is None or (run.get("started_at") or "") >= (prev.get("started_at") or ""):
            newest[name] = run
    out = []
    for name in sorted(newest):
        try:
            out.append((int(newest[name]["id"]), name))
        except (KeyError, TypeError, ValueError):
            continue
    return out


def harvest_pending(lines, app_id=""):
    """True when any shipmate-relevant check run on this commit has not
    completed.

    Keyed on the WHOLE relevant set, not the subset `latest_check_ids` selects:
    that ranking pushes a queued run below a completed one of the same name,
    which would hide exactly the case this flag exists to report."""
    for line in lines:
        run = _parse_check_run(line, app_id)
        if run is not None and run.get("status") != "completed":
            return True
    return False


def _write_step_output(name, value):
    """Append `name=<bool>` to the calling action step's GITHUB_OUTPUT. Silently
    skipped when GITHUB_OUTPUT is unset, so every mode stays runnable outside a
    runner."""
    path = os.environ.get("GITHUB_OUTPUT")
    if not path:
        return
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(f"{name}={'true' if value else 'false'}\n")


def load_annotations(ctx):
    """Join `ann/<id>.json` payloads onto the check names in check-ids.tsv.
    A missing or unreadable payload is skipped, never fatal."""
    ids_path = pathlib.Path(ctx["check_ids_path"])
    if not ids_path.exists():
        return []
    out = []
    for line in ids_path.read_text(encoding="utf-8").splitlines():
        if "\t" not in line:
            continue
        cid, name = line.split("\t", 1)
        payload = pathlib.Path(ctx["annotations_dir"]) / f"{cid.strip()}.json"
        try:
            # A `[]` payload is indistinguishable from the gather step's
            # `echo '[]'` fallback for a failed fetch: "this check run had no
            # annotations" and "this check run's annotations could not be
            # read" arrive here byte-identical. That is why the incomplete
            # harvest has to be signalled out of band, via
            # ctx["harvest_failed"], and cannot be inferred from the payloads.
            rows = json.loads(payload.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        for row in rows if isinstance(rows, list) else []:
            if not isinstance(row, dict):
                continue
            row["check_name"] = name.strip()
            out.append(row)
    return out


def harvest_sections(annotations):
    """Group harvested annotations by check name.

    Drops notices, and drops the plan path's own doctor annotations: the live
    probes in this same report re-state those findings, so keeping both
    double-reports every settings problem. Every other title is kept.
    """
    by_check = {}
    for a in annotations:
        level = a.get("annotation_level")
        if level not in HARVEST_LEVELS:
            continue
        if a.get("title") == DOCTOR_TITLE:
            continue
        by_check.setdefault(a.get("check_name") or "(unnamed check)", []).append(a)
    return by_check


def _provenance(ctx):
    """The report's preamble: what was examined, and NOTHING about what the
    probes did with it.

    Environment-probe coverage is stated only by `_environment_warnings`, keyed
    on `envs_available`, because the two signals can disagree: a `gh run
    download` that extracts cells but exits non-zero leaves `envs_available`
    true with no `plan_run_id`. A preamble keyed on the run id would then claim
    the probes were skipped while they actually produced findings."""
    head = ctx["head_sha"][:7] or "(unknown commit)"
    if ctx["plan_run_id"]:
        run_id = _one_line(ctx["plan_run_id"], 40)
        return f"_Commit `{head}`; cell summaries from plan run {run_id}._"
    return f"_Commit `{head}`; no plan run identified for this commit._"


def _all_clear_line(ctx):
    """The settings-probe all-clear, stating what it actually covers.

    All three environment probes see only the environments of the stacks this
    pull request changed, so a categorical "no problems found" OVERCLAIMS: a
    `prod-eu` holding the App key is invisible to a report on a dev-only pull
    request. Name the set instead.

    Env names are repository data, so escaped and length-bounded: this line
    renders in both report paths and neither truncates it."""
    envs = sorted(ctx.get("envs") or ())
    if not envs:
        return (
            "- :white_check_mark: no problems found by the settings probes — and no "
            "environments were probed, since no declared environment set was available "
            "for this commit."
        )
    named = _one_line(", ".join(f"`{_md_escape(e)}`" for e in envs), 400)
    return (
        "- :white_check_mark: no problems found by the settings probes. The environment "
        "probes covered only the environments of the stacks changed in this pull request: "
        f"{named}."
    )


def _truncated_checks(annotations):
    """Check names whose warning/failure annotations hit GitHub's per-level
    cap (10 per level per step) on the raw, pre-filter listing -- computed
    here rather than on the already-filtered harvest_sections output, since
    dropping notices and DOCTOR_TITLE rows first would both under- and
    over-count the real GitHub-side truncation."""
    counts = {}
    for a in annotations:
        level = a.get("annotation_level")
        if level not in HARVEST_LEVELS:
            continue
        key = (a.get("check_name") or "(unnamed check)", level)
        counts[key] = counts.get(key, 0) + 1
    return {name for (name, _level), n in counts.items() if n >= ANNOTATION_CAP}


def _render_annotation_row(a):
    emoji = ":x:" if a.get("annotation_level") == "failure" else ":warning:"
    title = _md_escape(_one_line(a.get("title") or "", 120))
    msg = _md_escape(_one_line(a.get("message") or "", 300))
    return f"  - {emoji} {title} — {msg}" if title else f"  - {emoji} {msg}"


def _emit_section(lines, name, rows, used, budget):
    """Append one check's header + as many of its rows as fit in the
    remaining budget. The header is emitted only when at least its first row
    also fits -- otherwise it would dangle with no children.
    Returns (new_used, rows_added, rows_dropped)."""
    if not rows:
        return used, 0, 0  # rendered[0] below would IndexError
    header = f"- **{_md_escape(_one_line(name, 120))}**"
    rendered = [_render_annotation_row(a) for a in rows]
    if used + len(header) + 1 + len(rendered[0]) + 1 > budget:
        return used, 0, len(rows)
    lines.append(header)
    used += len(header) + 1
    added, dropped = 0, 0
    for row in rendered:
        if used + len(row) + 1 <= budget:
            lines.append(row)
            used += len(row) + 1
            added += 1
        else:
            dropped += 1
    return used, added, dropped


def _harvest_lines(sections, annotations, budget):
    """Render harvest rows within `budget` chars. Truncatable, unlike the
    settings-probe section: dropped rows stay recoverable from the run logs.
    Returns (lines, dropped_count)."""
    truncated_checks = _truncated_checks(annotations)
    lines, used, dropped, over = [], 0, 0, False
    any_truncated = False
    for name in sorted(sections):
        rows = sections[name]
        if name in truncated_checks:
            any_truncated = True
        if over:
            dropped += len(rows)
            continue
        used, added, section_dropped = _emit_section(lines, name, rows, used, budget)
        if added == 0 or section_dropped:
            over = True
        dropped += section_dropped
    if any_truncated:
        lines.append(
            "- _GitHub keeps at most 10 annotations per level per step, so this list "
            "may be truncated — see the run logs for the full set._"
        )
    return lines, dropped


def _findings_lines(findings, budget):
    """Render settings-probe finding rows within `budget` chars. Returns
    (lines, dropped_count) -- the last-ditch fallback path (render_report,
    when even the harvest-less body still exceeds sc.HARD_CAP)."""
    lines, used, dropped = [], 0, 0
    for lvl, text in findings:
        line = _finding_row(lvl, text)
        if used + len(line) + 1 <= budget:
            lines.append(line)
            used += len(line) + 1
        else:
            dropped += 1
    return lines, dropped


def _report_head(ctx):
    """Shared by both render paths -- the marker is this comment's identity (the
    upsert PATCHes by it), so neither path can drift out of marker compliance."""
    return [
        DOCTOR_MARKER,
        "### shipmate doctor",
        "",
        _provenance(ctx),
        "",
        "#### repository settings",
        "",
    ]


def _finding_row(lvl, text):
    """One settings-probe finding as a list row.

    Escaped because a finding interpolates repository data (a file name, a team
    slug, an API error): an unescaped `<!-- shipmate:summary -->` in one would
    make actions/summary's marker upsert PATCH this comment with the plan
    comment's body."""
    return f"- {_LEVEL_EMOJI[lvl]} {_md_escape(text)}"


def _findings_only_report(findings, ctx):
    """Last-ditch fallback: a body still over sc.HARD_CAP with the harvest
    already excluded means the findings themselves are unexpectedly large.
    Hard-truncates them with a count, so the comment still posts rather than
    the whole POST failing with a 422."""
    head = _report_head(ctx)
    # 200 chars of headroom for the omitted-count line appended below.
    budget = max(0, sc.HARD_CAP - len("\n".join(head)) - 200)
    if findings:
        lines, dropped = _findings_lines(findings, budget)
    else:
        lines, dropped = [_all_clear_line(ctx)], 0
    if dropped:
        lines.append(
            f"- _{dropped} more finding(s) omitted to keep this comment within the size "
            "limit — see the workflow run for the full list._"
        )
    return "\n".join(head + lines)


def _harvest_body(sections, annotations, budget, harvest_failed, harvest_pending):
    """The harvest's rendered rows, plus a note for each of the two ways the
    harvest can fall short of "these are the warnings on this commit".

    Both notes are ADDITIVE to the rows, never alternatives: an incomplete
    harvest can still have warnings to show, and emitting the note only when
    there is nothing would let a partial harvest read as the complete set. A
    pending harvest is the same hazard one step earlier, so it suppresses the
    all-clear too while staying a separate statement."""
    lines = []
    if sections:
        lines, dropped = _harvest_lines(sections, annotations, budget)
        if dropped:
            lines.append(
                f"- _{dropped} more warning(s) omitted to keep this comment within the "
                "size limit — see the run logs for the full set._"
            )
    elif not harvest_failed and not harvest_pending:
        lines = [":white_check_mark: no warnings on this commit's workflow runs."]
    if harvest_pending:
        lines.append(HARVEST_PENDING)
    if harvest_failed:
        lines.append(HARVEST_INCOMPLETE)
    return lines


def render_report(findings, annotations, ctx):
    out = _report_head(ctx)
    if findings:
        out += [_finding_row(lvl, text) for lvl, text in findings]
    else:
        out.append(_all_clear_line(ctx))
    heading = ["", "#### warnings from this commit's workflow runs", ""]
    sections = harvest_sections(annotations)
    # The settings-probe section above is never truncated -- it is the part a
    # stale comment can't recover from the run logs -- so the harvest gets
    # whatever's left of sc.SIZE_BUDGET, not a fixed share.
    budget = max(0, sc.SIZE_BUDGET - len("\n".join(out)) - len("\n".join(heading)))
    lines = _harvest_body(
        sections,
        annotations,
        budget,
        bool(ctx.get("harvest_failed")),
        bool(ctx.get("harvest_pending")),
    )
    body = "\n".join(out + heading + lines)
    if len(body) > sc.HARD_CAP:
        # The harvest section is already budgeted against sc.SIZE_BUDGET
        # above, so overflow this large can only come from the
        # settings-probe findings themselves -- degrade those too rather than
        # let the comment-ops render step's `gh api ... -F body=@doctor.md` 422.
        body = _findings_only_report(findings, ctx)
    return body


def main():
    mode = os.environ.get("SHIPMATE_DOCTOR_MODE", "")
    if mode not in MODES:
        raise SystemExit(f"SHIPMATE_DOCTOR_MODE must be one of {', '.join(MODES)} (got: {mode!r})")
    if mode == "check-ids":
        app_id = os.environ.get("SHIPMATE_APP_ID", "")
        lines = sys.stdin.read().splitlines()
        for cid, name in latest_check_ids(lines, app_id):
            print(f"{cid}\t{name}")
        # A step output, NOT stdout: stdout is the (id, name) TSV
        # load_annotations parses, and an extra field would land in a check name.
        _write_step_output("harvest_pending", harvest_pending(lines, app_id))
        return
    ctx = ctx_from_env()
    found = warnings(ctx)
    if mode == "annotate":
        for line in render_annotations(found):
            print(line)
        return
    print(render_report(found, load_annotations(ctx), ctx))


if __name__ == "__main__":
    main()
    sys.exit(0)
