#!/usr/bin/env python3
"""shipmate doctor: read-only GitHub-settings drift probes.

Three modes, selected via SHIPMATE_DOCTOR_MODE:
- annotate: run the probes and emit GitHub workflow-command annotations
  (::warning::/::notice::) on stdout, one line per finding. Used by
  actions/summary right after a plan run. NEVER fails the run: a probe
  error becomes a 'could not verify' note — doctor guards onboarding, it
  must not take down the plan path.
- report: render the sticky PR comment on demand — the fifteen live probes'
  findings plus a harvest of the warnings GitHub already recorded as
  annotations on this commit's workflow check runs.
- check-ids: reduce a check-runs JSONL listing to the (id, name) pairs worth
  fetching annotations for, one call ahead of `report`. Runs before the rest
  of doctor's env contract is read.

An index only — one bullet per entry in PROBES, pinned by
test_probe_count_is_stated_correctly_in_the_docs. Each probe's own docstring
carries its rationale; do not restate it here.

Probes:
- gate ruleset: `shipmate / gate` required, pinned to the App, strict policy on.
- `pull_request` rule: code-owner review required (an approval count is not a
  substitute — the App can submit an approving review).
- GitHub Environments exist for every planned env: the <env>-plan/<env>-apply
  pair, or a single shared <env>.
- protection shape of those: plan envs open, apply envs reviewed, a shared env
  open and therefore ungated.
- `shipmate-engine`: exists, with a branch policy naming the default branch.
- secrets held by each declared plan environment.
- engine action-pin freshness in the consumer's workflow files.
- `pull_request_target` triggers in the consumer's workflow files.
- the plan-calling job name in the consumer's `shipmate.yml`: `shipmate`, or the
  plan cell checks are not `shipmate / <stack> / <env>`.
- a retired `plan_run_id` input still declared or forwarded by the consumer's
  `shipmate.yml`.
- a retired `mode` input still declared by the consumer's `shipmate.yml`, or
  forwarded from it to the engine's reusable apply workflows.
- the dispatch wiring of the consumer's `shipmate.yml`: the `workflow_dispatch`
  trigger every commented verb needs, its four inputs, and its call of the
  engine's plan workflow.
- the event routing of `shipmate.yml`: one job per engine reusable workflow, each
  with the `if:` that selects it — a wrong one sends a verb nowhere and its run
  completes green with every job skipped.
- approvers team resolvability in the repo's org.
- GitHub App installation permission drift.
"""

import base64
import importlib.util
import json
import os
import pathlib
import re
import sys
from importlib.machinery import SourceFileLoader

_D = pathlib.Path(__file__).resolve().parent


def _load(fname):
    loader = SourceFileLoader(fname.replace("-", "_"), str(_D / fname))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


bm = _load("build-matrix")
_gh_json = bm.gh_json
sc = _load("summary-comment")
ag = _load("apply-gate")
_md_escape = sc._md_escape

GATE = "shipmate / gate"

MODES = ("annotate", "report", "check-ids")
DOCTOR_TITLE = "shipmate doctor"
# Finding levels: NOTICE is informational (a legitimate-but-worth-knowing
# setting), WARNING is a misconfiguration. Rendered as ::notice::/::warning::
# in annotate mode.
WARNING, NOTICE = "warning", "notice"

# Findings of the review-rule probe. Format templates rather than finished
# tuples: each names the default branch, which is per repository.
_REVIEW_RULE_ABSENT = (
    "no active ruleset puts a `pull_request` rule on `{branch}` — nothing there "
    "requires the code-owner review that a leaked App private key cannot forge "
    "(docs/hardening.md #3–5). Classic branch protection is not reported by this "
    "endpoint, so check it if that is what this repository uses."
)
_CODE_OWNER_REVIEW_OFF = (
    "the `pull_request` rule on `{branch}` does not require code-owner review — "
    "the shipmate App can submit a counting approving review, so an approval count "
    "is no substitute against a leaked App private key. Set "
    "`require_code_owner_review`, and a `CODEOWNERS` entry covering the paths the "
    "IaC lives in: the rule is a no-op for changed files with no owner "
    "(docs/hardening.md #3–5)."
)
_SOLE_MAINTAINER_REVIEW = (
    "the `pull_request` rule on `{branch}` requires no approving review "
    "(sole-maintainer mode, docs/hardening.md #3–5) — a supported mode. "
    "`require_code_owner_review` is on, so the merge-side control a leaked App "
    "private key cannot satisfy is still in place."
)
# Same degrade posture as FORK_TRIGGER_UNREADABLE: unread is not misconfigured.
_REVIEW_RULE_UNREADABLE = (
    "the `pull_request` rule on `{branch}` carried no parameters — review "
    "requirements not verified."
)

DOCTOR_MARKER = "<!-- shipmate:doctor -->"
ANNOTATION_CAP = 10  # GitHub keeps at most 10 annotations per level per step
HARVEST_LEVELS = ("warning", "failure")
_LEVEL_EMOJI = {WARNING: ":warning:", NOTICE: ":information_source:"}
# github-actions authors the plan/apply/drift auto check-runs carrying shipmate's ::warning::
# emissions; the shipmate App is matched by id instead (org-dependent slug). A consumer's own
# non-shipmate workflows are indistinguishable here and remain, hence the generic "workflow runs".
_HARVEST_APP_SLUGS = ("github-actions",)
# Covers both shapes the gather step reports: nothing read at all, and some read
# but not all. A list item, so it reads as a peer of the rows it follows.
HARVEST_INCOMPLETE = (
    "- :warning: could not read all of this commit's check runs — any warnings recorded on "
    "the ones that could not be read are missing from this list."
)
# Distinct from HARVEST_INCOMPLETE: every read succeeded, nothing is recorded YET. An empty
# payload is byte-identical to "no warnings", so without this a `shipmate doctor` typed while the
# plan run is queued gets an all-clear that is never refreshed.
HARVEST_PENDING = (
    "- :hourglass: some of this commit's workflow runs had not finished when this report was "
    "rendered — warnings they record later are not in this list; comment `shipmate doctor` "
    "again once they have finished."
)


def _gate_rule_warnings(ctx):
    repo, default_branch = ctx["repo"], ctx["default_branch"]
    rules = _gh_json(f"repos/{repo}/rules/branches/{default_branch}?per_page=100")
    for rule in rules:
        if rule.get("type") != "required_status_checks":
            continue
        params = rule.get("parameters", {})
        for chk in params.get("required_status_checks", []):
            if chk.get("context") != GATE:
                continue
            out = []
            if chk.get("integration_id") != int(ctx["app_id"]):
                out.append(
                    (
                        WARNING,
                        f"gate ruleset does not pin `integration_id` to the shipmate App "
                        f"(found {chk.get('integration_id')!r}) — a forged `{GATE}` status "
                        "from another identity would satisfy the required check.",
                    )
                )
            if not params.get("strict_required_status_checks_policy"):
                out.append(
                    (
                        WARNING,
                        "gate ruleset does not require branches to be up to date "
                        "(strict) — plans can go stale against the base before merge.",
                    )
                )
            return out
    return [
        (
            WARNING,
            f"no active ruleset requires `{GATE}` on `{default_branch}` — "
            "merges are not gated (see docs/branch-protection.md).",
        )
    ]


def _review_rule_warnings(ctx):
    """Code-owner review on the default-branch ruleset (`docs/hardening.md`
    #3–5) — with #6's `<env>-apply` reviewers, the controls a holder of the App
    private key structurally cannot satisfy: an App cannot be a CODEOWNER and
    cannot approve a pending deployment. So the finding keys on
    `require_code_owner_review`, never on an approval COUNT, which the App holds
    `pull-requests: write` to forge.

    Aggregated across every `pull_request` rule on the branch, not the first:
    GitHub enforces the union across layered rulesets, so an org ruleset
    supplying code-owner review must not be masked by a repo-level count-only
    rule listed first. Count 0 with code-owner review OFF is the one
    configuration with no unforgeable merge-time control at all, so it must not
    read as the sole-maintainer note.

    Re-reads `rules/branches` rather than sharing `_gate_rule_warnings`'
    response, for `_existing_env_names`' per-probe-degrade reason.

    Two limits, both stated in the finding text or the docs rather than probed:
    the endpoint returns rulesets only (classic branch protection reads as no
    rule), and `require_code_owner_review` is a no-op for changed files no
    `CODEOWNERS` entry owns."""
    branch = ctx["default_branch"]
    rules = _gh_json(f"repos/{ctx['repo']}/rules/branches/{branch}?per_page=100")
    found = readable = code_owner = False
    count = 0
    for rule in rules:
        if rule.get("type") != "pull_request":
            continue
        found = True
        params = rule.get("parameters") or {}
        if not params:
            continue
        readable = True
        code_owner = code_owner or bool(params.get("require_code_owner_review"))
        count = max(count, params.get("required_approving_review_count") or 0)
    if not found:
        return [(WARNING, _REVIEW_RULE_ABSENT.format(branch=branch))]
    if not readable:
        return [(NOTICE, _REVIEW_RULE_UNREADABLE.format(branch=branch))]
    if not code_owner:
        return [(WARNING, _CODE_OWNER_REVIEW_OFF.format(branch=branch))]
    if not count:
        return [(NOTICE, _SOLE_MAINTAINER_REVIEW.format(branch=branch))]
    return []


def _existing_env_names(ctx):
    """The repository's GitHub Environment names.

    THE LISTING IS THE ONLY EXISTENCE ORACLE. `bm.gh_json`'s exception carries
    no status code, so a per-environment read cannot tell a 404 (absence, which
    is `_environment_warnings`' finding) from a 403 or a 5xx. Every probe below
    that needs existence decides it from here, then treats a failed
    per-environment read as "not checked" — inferring absence from that read
    would let a token lacking `environments` access produce loud findings about
    environments that are fine, while a genuine 403 on a present one passes as
    healthy. A failure of this listing is the caller's precondition and
    propagates to `warnings()`' degrade note.

    Re-read per probe rather than shared through `ctx`: `warnings()` degrades
    per probe, so one endpoint failure must not silence the others.

    per_page=100 covers >=50 logical env pairs, and `bm.gh_json` does not
    multi-page merge, so a repository past that raises rather than infers a mode
    from half the names: a wrong mode asserts a mode the repository is not in and
    redirects the plan-secret probe to the wrong environment. `total_count` is
    read strictly -- a listing missing the key is a listing whose completeness is
    unknown, and the KeyError degrades every environment probe loudly."""
    listing = _gh_json(f"repos/{ctx['repo']}/environments?per_page=100")
    names = {e["name"] for e in listing.get("environments", [])}
    if listing["total_count"] > len(names):
        raise SystemExit(
            f"::error::the environments listing is truncated ({listing['total_count']} "
            f"environments, {len(names)} read) — the naming of each environment cannot be "
            "determined from a partial listing."
        )
    return names


SPLIT, SHARED, AMBIGUOUS, MISSING = "split", "shared", "ambiguous", "missing"

# Which environments each mode's probes read, and the role each plays; see `_role_names`.
_MODE_ROLES = {
    SPLIT: ("plan", "apply"),
    SHARED: ("shared",),
    AMBIGUOUS: ("shared", "plan", "apply"),
    MISSING: (),
}


def _env_mode(env, existing):
    """Which naming one logical env uses, from the environment names alone."""
    bare = env in existing
    suffixed = f"{env}-plan" in existing or f"{env}-apply" in existing
    if bare and suffixed:
        return AMBIGUOUS
    if bare:
        return SHARED
    if suffixed:
        return SPLIT
    return MISSING


def _role_names(env, mode, roles=None):
    """[(environment name, role)] a mode's probes read for one logical env.
    `roles` narrows it to a subset (the plan-side names). The advice texts spell
    the suffixed names out inline; what is single here is which environments a
    mode is probed through, and `_env_mode` is the only place the mode is
    decided.

    The mode is really selected by the `SHIPMATE_SHARED_ENVS` repository
    variable, which doctor never reads: that needs a `variables: read`
    permission app/manifest.json does not declare, and every installation would
    have to re-accept it. `_MODE_ROLES[AMBIGUOUS]` reads both namings, so a
    phantom reviewer on the one nothing binds is still reported."""
    return [
        (env if role == "shared" else f"{env}-{role}", role)
        for role in _MODE_ROLES[mode]
        if roles is None or role in roles
    ]


def _shared_intro(name, env, mode):
    """Opening clause of a shared-role finding.

    Neither branch asserts the mode: sharing is selected by the
    `SHIPMATE_SHARED_ENVS` repository variable, which doctor cannot read. In
    ambiguous mode it may not go on to assert that nothing binds the bare
    environment either -- the plan side binds from that same variable, inside the
    engine's reusable plan and drift workflows, so a repository still pinned to an
    engine that binds `<env>-plan` statically leaves both namings live with the env
    shared; in shared mode the variable is what makes the
    bare environment the apply environment too, and a half-done migration that
    renamed the environments and forgot the variable leaves the applies binding
    `<env>-apply`. Two findings in one report may not contradict each other."""
    if mode == AMBIGUOUS:
        return (
            f"GitHub Environment `{name}` — shared between plan and apply only if "
            f"`{env}` is listed in the `SHIPMATE_SHARED_ENVS` repository variable, which "
            "doctor cannot read, and the suffixed naming exists beside it, so which "
            "naming each path binds is undetermined —"
        )
    return (
        f"GitHub Environment `{name}` — shared between plan and apply while `{env}` is "
        "listed in the `SHIPMATE_SHARED_ENVS` repository variable, which doctor cannot "
        "read —"
    )


def _env_noun(mode, role):
    """How a plan-side finding may name the environment's role. The shared role
    cannot be called the plan environment -- a sibling finding in the same report
    calls the same environment shared between both paths -- and in ambiguous mode
    neither can `<env>-plan`, since whether anything binds it depends on the
    repository variable."""
    return "plan environment" if role == "plan" and mode != AMBIGUOUS else "environment"


def _missing_half(name, env, role, mode):
    """One absent half of the split pair. Neither branch says the jobs "cannot
    {role}": the binding resolves to a name GitHub auto-creates empty, so they
    run. In ambiguous mode the bare `{env}` may be what a path binds instead, so
    there the consequence is conditional as well."""
    if mode == AMBIGUOUS:
        return (
            f"GitHub Environment `{name}` does not exist while `{env}` does — if this "
            f"repository binds the split naming, the {role} jobs for `env:{env}` bind a "
            "name GitHub auto-creates empty, with none of its variables, secrets or "
            f"protection rules. Create it, or delete `{env}` if both paths share one "
            "environment."
        )
    return (
        f"GitHub Environment `{name}` does not exist — the {role} jobs for stacks tagged "
        f"`env:{env}` bind a name GitHub auto-creates empty, with no variables, no secrets "
        "and none of its protection rules. Create it and set its TF_VAR_* vars."
    )


def _ambiguous_envs(names):
    """Logical envs that exist under both namings, from the environment names
    alone. This one check needs no declared environment set -- it compares
    environment names against each other -- so it is reported even when no plan
    run supplied that set. One failed cell out of a fan-out withholds it, and a
    half-migrated repository is exactly when the finding is wanted."""
    return {
        stem
        for name in names
        for suffix in ("-plan", "-apply")
        if name.endswith(suffix) and (stem := name.removesuffix(suffix)) in names
    }


def _ambiguity(env, names):
    present = ", ".join(f"`{n}`" for n, _ in _role_names(env, SPLIT) if n in names)
    return (
        f"GitHub Environments `{env}` and {present} exist side by side for "
        f"`env:{env}` — every path binds `{env}` while `{env}` is listed in "
        f"the `SHIPMATE_SHARED_ENVS` repository variable and the suffixed naming "
        "otherwise: the apply waves from the engine's reusable apply workflow, the "
        "plan cells and the nightly drift run from the engine's reusable plan and "
        "drift workflows. doctor cannot read the variable, so which naming each path "
        "binds is undetermined here. Either naming may therefore be bound by nothing, "
        "with its protection rules reading as a control that is in no code path. "
        "Establish both bindings before removing either naming — a repository still "
        "pinned to an engine that binds `-plan` statically keeps both namings live "
        f"while `{env}` is shared."
    )


def _environment_warnings(ctx):
    names = _existing_env_names(ctx)
    out = [(WARNING, _ambiguity(env, names)) for env in sorted(_ambiguous_envs(names))]
    if not ctx["envs_available"]:
        out.append(
            (
                NOTICE,
                "no plan run with cell summaries for this commit — the declared "
                "environment set is unknown, so the remaining environment probes were "
                "skipped. The ambiguous-naming check above does not need it.",
            )
        )
        return out
    for env in sorted(ctx["envs"]):
        mode = _env_mode(env, names)
        if mode == MISSING:
            out.append(
                (
                    WARNING,
                    f"neither GitHub Environment `{env}-plan` nor `{env}-apply` exists — "
                    f"every job for stacks tagged `env:{env}` binds a name GitHub "
                    "auto-creates empty: no variables, no secrets, no reviewers and no "
                    "branch policy, so a plan describes whatever the layout defaults to "
                    "rather than this environment. Create both and set their TF_VAR_* "
                    f"variables, or create a single `{env}` and list `{env}` "
                    "in the `SHIPMATE_SHARED_ENVS` repository variable to share one "
                    "environment between plan and apply (which gives up the reviewer gate "
                    "and the OIDC subject split).",
                )
            )
        # Ambiguity is reported by the name scan above, for every logical env in
        # the repository rather than only the ones this plan run covered.
        if mode in (SPLIT, AMBIGUOUS):
            # Ambiguous mode reports the missing half too: fail-closed, and the
            # ambiguity WARNING above says nothing about which environments exist.
            for name, role in _role_names(env, SPLIT):
                if name not in names:
                    out.append((WARNING, _missing_half(name, env, role, mode)))
    return out


def _env_shape_findings(name, env, data, role, mode):
    """One environment's protection-shape findings, from its already-read
    "Get an environment" payload."""
    out = []
    rules = sorted({r.get("type") for r in data.get("protection_rules", []) if r.get("type")})
    # GitHub reports "branch_policy" whenever deployment_branch_policy is set. Excluded both
    # ways: it refuses a plan job outright rather than delaying it (handled below), and it is
    # not a review, so an apply env carrying nothing else is still entirely unreviewed.
    approval = [r for r in rules if r != "branch_policy"]
    policy = data.get("deployment_branch_policy")
    if role == "plan" and approval:
        out.append(
            (
                WARNING,
                f"GitHub Environment `{name}` is a plan environment but has "
                f"protection rules ({', '.join(approval)}) — plan jobs will not "
                f"start immediately; put reviewers on `{env}-apply` instead.",
            )
        )
    if role == "plan" and policy:
        out.append(
            (
                WARNING,
                f"GitHub Environment `{name}` is a plan environment but has a "
                "deployment branch policy — plan jobs run at the pull request's "
                "base ref, so a policy that does not name every branch pull "
                "requests target refuses those plan cells; plan environments "
                "must allow all branches.",
            )
        )
    if role == "apply" and not approval:
        # NOTICE, not WARNING: legitimate for dev-tier envs. Worded on
        # `approval`, not on the raw rule list: a deployment branch policy may
        # be present, so claiming "no protection rules" would be false.
        out.append(
            (
                NOTICE,
                f"GitHub Environment `{name}` has no approval rules (required reviewers "
                "or a wait timer) — pre-merge applies to it are unreviewed.",
            )
        )
    if role == "shared" and approval:
        out.append(
            (
                WARNING,
                f"{_shared_intro(name, env, mode)} has "
                f"protection rules ({', '.join(approval)}) — a protection rule gates every "
                "job that binds the environment and GitHub offers no per-job filter, so "
                "the plan cells and the nightly drift run will not start immediately "
                f"either. To gate applies only, split it into `{env}-plan` and "
                f"`{env}-apply` and remove `{env}` from `SHIPMATE_SHARED_ENVS`.",
            )
        )
    if role == "shared" and policy and mode == AMBIGUOUS:
        # The NOTICE below is shared mode's accepted trade, and only shared mode's: while the
        # naming is ambiguous, the bare environment is what a plan side still on the old naming
        # binds, so this plan-stall is a live misconfiguration, not a secret-release control.
        out.append(
            (
                WARNING,
                f"GitHub Environment `{name}` has a deployment branch policy, and `{env}` "
                "is also named by the split naming — plan jobs run at the pull request's "
                f"base ref, so for as long as anything binds `{env}` on the plan path a "
                "policy that does not name every branch pull requests target refuses those "
                f"plan cells. Open it up, or finish the move to `{env}-plan` and "
                f"`{env}-apply` and keep the policy on the apply environment.",
            )
        )
    if role == "shared" and policy and mode != AMBIGUOUS:
        # NOTICE, not the plan environment's WARNING: on a shared environment the policy is a real
        # control over which branches may claim its secrets, and a consumer whose pull requests all
        # target the default branch is right to set it. A WARNING nobody can clear is noise.
        out.append(
            (
                NOTICE,
                f"{_shared_intro(name, env, mode)} has a "
                "deployment branch policy — on a shared environment that policy is what "
                "scopes which branches may claim its secrets, and it is also what refuses "
                "plan cells whose base ref it does not name. Correct while every pull "
                "request targets a branch it names; open it up, or split into "
                f"`{env}-plan` and `{env}-apply`, if they do not.",
            )
        )
    if role == "shared" and not approval:
        out.append(
            (
                NOTICE,
                f"{_shared_intro(name, env, mode)} has no "
                "approval rules (required reviewers or a wait timer) — pre-merge applies "
                "to it are unreviewed, and no reviewer gate is available while it is "
                "shared: a reviewer here would stall the plan cells and the nightly drift "
                f"run. Split it into `{env}-plan` and `{env}-apply` if you need one.",
            )
        )
    return out


def _env_protection_warnings(ctx):
    """Protection shape per environment, checked live, with the role each
    environment plays taken from `_env_mode`. An approval-type protection rule on
    a PLAN env — a required reviewer, or a wait timer — stops plan jobs from
    starting when they should: no error, only a stalled matrix — the hardest
    shipmate misconfiguration to diagnose. An APPLY env with no approval
    rule is the mirror problem: pre-merge applies to it are unreviewed. A SHARED
    env is both at once, so it can have neither.

    Existence comes from `_existing_env_names`; see its docstring."""
    out = []
    if not ctx["envs"]:
        # Nothing to probe, so nothing to read: listing the environments anyway would let a
        # repository whose token cannot list them collect a "could not verify" degrade for a probe
        # that had no work to do. The skipped-probe statement lives in `_environment_warnings`.
        return out
    existing = _existing_env_names(ctx)
    for env in sorted(ctx["envs"]):
        mode = _env_mode(env, existing)
        for name, role in _role_names(env, mode):
            if name not in existing:
                continue  # existence is _environment_warnings' finding
            try:
                data = _gh_json(f"repos/{ctx['repo']}/environments/{name}")
            except (Exception, SystemExit) as e:  # noqa: BLE001 - degrade, see docstring
                out.append(
                    (
                        NOTICE,
                        f"GitHub Environment `{name}` exists but its settings could not be "
                        f"read ({_degrade_reason(e)}) — its plan/apply protection shape was "
                        "not checked.",
                    )
                )
                continue
            out.extend(_env_shape_findings(name, env, data, role, mode))
    return out


_ENGINE_ENV = "shipmate-engine"


def _engine_environment_warnings(ctx):
    """The App private key lives in the `shipmate-engine` GitHub Environment,
    not a repository secret — a deployment branch policy scoped to the
    default branch is the only thing that stops a branch workflow from
    reading it. A consumer that re-pins the engine but never creates this
    environment (or creates it with no branch policy, or one that does not
    actually name the default branch) has nothing scoping the key, and
    believes they are protected. What this probe observes is the
    environment's shape, never where the key actually lives -- listing
    repository secrets needs an App permission app/manifest.json does not
    declare -- so its warnings say what was seen and leave the repository
    secret conditional.

    Existence comes from `_existing_env_names`; see its docstring."""
    repo, default_branch = ctx["repo"], ctx["default_branch"]
    if _ENGINE_ENV not in _existing_env_names(ctx):
        return [
            (
                WARNING,
                f"GitHub Environment `{_ENGINE_ENV}` does not exist — nothing scopes "
                "which branches may claim the shipmate App private key. If the key is "
                "still a repository secret, every branch's workflow can read it (see "
                "docs/github-app.md).",
            )
        ]
    try:
        env = _gh_json(f"repos/{repo}/environments/{_ENGINE_ENV}")
    except (Exception, SystemExit) as e:  # noqa: BLE001 - degrade, see warnings()
        return [
            (
                NOTICE,
                f"GitHub Environment `{_ENGINE_ENV}` exists but its settings could not be "
                f"read ({_degrade_reason(e)}) — its branch-policy scoping was not checked.",
            )
        ]
    policy = env.get("deployment_branch_policy")
    if not policy:
        return [
            (
                WARNING,
                f"GitHub Environment `{_ENGINE_ENV}` has no deployment branch policy — "
                "a workflow on any branch can still claim the App private key it "
                f"holds. Restrict it to `{default_branch}`.",
            )
        ]
    if not policy.get("custom_branch_policies"):
        # protected_branches-only restricts deploys to whatever branch
        # protection covers, which is not necessarily the default branch alone
        # -- not the specific guarantee this probe exists to confirm.
        return [
            (
                WARNING,
                f"GitHub Environment `{_ENGINE_ENV}`'s deployment branch policy does not "
                f"use a custom policy naming `{default_branch}` — its actual scope could "
                "not be confirmed as default-branch-only.",
            )
        ]
    try:
        policies = _gh_json(f"repos/{repo}/environments/{_ENGINE_ENV}/deployment-branch-policies")
    except (Exception, SystemExit) as e:  # noqa: BLE001 - degrade, see warnings()
        return [
            (
                NOTICE,
                f"could not read `{_ENGINE_ENV}`'s deployment branch policies "
                f"({_degrade_reason(e)}) — its scope was not checked.",
            )
        ]
    names = {p.get("name") for p in (policies or {}).get("branch_policies", [])}
    if names != {default_branch}:
        if default_branch not in names:
            detail = (
                f"does not name `{default_branch}` — a branch other than the "
                "default can still claim the App private key."
            )
        else:
            extra = ", ".join(sorted(f"`{n}`" for n in names - {default_branch}))
            detail = (
                f"also permits {extra} — a workflow on those branches can still "
                "claim the App private key."
            )
        return [
            (
                WARNING,
                f"GitHub Environment `{_ENGINE_ENV}`'s deployment branch policy {detail}",
            )
        ]
    return []


# Named `_APP_KEY_NAME`, not `..._SECRET`: ruff's S105 hardcoded-password rule
# fires on a "SECRET" token in the binding name, and this is a secret's *name*.
_APP_KEY_NAME = "SHIPMATE_APP_PRIVATE_KEY"

# Emitted when the env-scoped token is absent: the listing needs the `environments: read` permission
# app/manifest.json declares, and no token carries it until the installation accepts the request. A
# silent skip reads as "no plan environment holds a secret" — the one claim this probe exists for.
_ENV_TOKEN_UNCHECKED = (
    WARNING,
    "plan-environment secrets were not checked — minting a token with the "
    "`environments: read` permission `app/manifest.json` declares did not succeed, "
    "which usually means the shipmate App installation has not accepted the "
    "permission request yet. Accept it in the installation settings, then comment "
    "`shipmate doctor` again.",
)


def _env_secret_names(ctx, name):
    """(names, total) of one environment's secrets.

    Names only -- no REST path returns a secret's value.

    Publishing those names is a deliberate trade: the report surface may be
    world-readable, and GitHub gates this metadata behind `environments: read`.
    Published anyway because "holds 3 secret(s)" tells an operator nothing about
    which credential to move.

    Read with SHIPMATE_ENV_TOKEN, restoring GH_TOKEN afterwards -- the ambient
    App token is minted without `environments: read` and every other probe still
    needs it. `total` comes from the payload, not the list length, because
    `bm.gh_json` does not multi-page.
    """
    saved = os.environ.get("GH_TOKEN")
    # `.get`, never a subscript: SHIPMATE_ENV_TOKEN is optional by contract --
    # absent, the probe reports the check as not performed
    # (`_ENV_TOKEN_UNCHECKED`) rather than killing the report.
    os.environ["GH_TOKEN"] = os.environ.get("SHIPMATE_ENV_TOKEN", "")
    try:
        data = _gh_json(f"repos/{ctx['repo']}/environments/{name}/secrets?per_page=100")
    finally:
        if saved is None:
            os.environ.pop("GH_TOKEN", None)
        else:
            os.environ["GH_TOKEN"] = saved
    names = [
        s.get("name")
        for s in (data.get("secrets") or [])
        if isinstance(s.get("name"), str) and s.get("name")
    ]
    total = data.get("total_count")
    return names, total if isinstance(total, int) and total > len(names) else len(names)


def _app_key_findings(env, names, total, noun):
    """The App-key half of the plan-env secret finding, for one environment.

    `bm.gh_json` does not multi-page, so on a truncated listing the key can sit
    outside the page: absence is reportable as absence ONLY when the read was
    complete. A partial listing says the check could not be completed rather
    than passing the most dangerous configuration off as a routine note. Both
    are WARNING -- a check that went dark over this is not a note.
    """
    if _APP_KEY_NAME in names:
        return [
            (
                WARNING,
                f"{noun} `{env}` holds `{_APP_KEY_NAME}` — plan-time "
                "code execution can mint an App token with it, forge the "
                f"`{GATE}` status and approve its own pull request. The key belongs "
                f"only in `{_ENGINE_ENV}` (docs/github-app.md §Key-exposure "
                "boundary).",
            )
        ]
    if total > len(names):
        return [
            (
                WARNING,
                f"{noun} `{env}` holds {total} secret(s) but only "
                f"{len(names)} name(s) could be read, so whether `{_APP_KEY_NAME}` "
                "is one of them was not determined — no document blesses that "
                "configuration. List the environment's secrets in its settings and "
                "remove the key if it is there (docs/github-app.md §Key-exposure "
                "boundary).",
            )
        ]
    return []


def _secret_finding(name, env, role, mode, count, shown):
    """The plan-side secret NOTICE, forked by role.

    The shared variant does not repeat control 8's "no approval rules and no
    deployment branch policy" rule: on a shared environment a branch policy is a
    legitimate secret-release control, so stating it as a requirement would
    contradict `_env_protection_warnings`' NOTICE about the same setting.
    Whether the environment is the apply environment too rides on the repository
    variable doctor cannot read, so `_shared_intro` and this text hedge it; the
    advice that follows is the conservative read either way."""
    if role == "shared":
        return (
            f"{_shared_intro(name, env, mode)} holds {count} secret(s) ({shown}) — it may "
            "be the apply environment too, so a plan cell "
            "runs the pull request branch's own code with everything it releases: any "
            "credential held there for applying is reachable by plan-time code. "
            "Protection rules on it would stall those plan cells, so it cannot be gated "
            "either — treat anything it holds as readable by anyone who can push a "
            "branch, and keep them read-only and blast-radius-free, or move to OIDC "
            "(docs/hardening.md control 8)."
        )
    return (
        f"{_env_noun(mode, role)} `{name}` holds {count} secret(s) ({shown}) — a plan "
        "cell runs the pull request branch's own code with whatever this "
        "environment releases to it, and a plan environment must have no "
        "approval rules and no deployment branch policy for its plan cells to "
        "run at all, so treat anything it holds as readable by anyone who can "
        "push a branch. Keep them read-only and blast-radius-free, or move to "
        "OIDC (docs/hardening.md control 8)."
    )


def _plan_env_secret_warnings(ctx):
    """What a plan environment holds is the whole blast radius of plan-time code
    execution. `docs/hardening.md` control 8 pins plan environments open by
    construction -- no approval rules, no branch policy, or every plan cell
    stalls -- so anything in one is readable by anyone who can push a branch.

    A plan environment's baseline is zero secrets, so any name this returns is a
    consumer credential and no name-pattern matching is needed -- a deny list
    would be incomplete by construction and read "safe" for what it forgot.

    NOTICE, not WARNING: control 8 permits read-only, blast-radius-free
    credentials here, and doctor's WARNING means misconfiguration.
    `SHIPMATE_APP_PRIVATE_KEY` is the exception, matched by exact name.

    The finding states control 8's rule NORMATIVELY, never that this environment
    is unprotected -- that read belongs to `_env_protection_warnings`, and
    coupling them would let one probe's failure silence the other.

    Order is load-bearing. The declared-env check comes first: a docs-only pull
    request reads nothing, so the dark-check WARNING would be a false alarm
    there. Existence then comes from `_existing_env_names`; see its docstring.
    Scope is the plan-side environment of each mode -- `<env>-plan` in split
    mode, the bare `<env>` in shared mode, both when the naming is ambiguous.
    Never `<env>-apply`: that is where control 7 *requires* credentials, and
    `shipmate-engine` holds the App key by design.
    """
    if not ctx["envs"]:
        return []
    if not os.environ.get("SHIPMATE_ENV_TOKEN"):
        return [_ENV_TOKEN_UNCHECKED]
    existing = _existing_env_names(ctx)
    out = []
    for env in sorted(ctx["envs"]):
        mode = _env_mode(env, existing)
        for name, role in _role_names(env, mode, ("plan", "shared")):
            if name not in existing:
                continue  # existence is _environment_warnings' finding
            try:
                names, total = _env_secret_names(ctx, name)
            except (Exception, SystemExit) as e:  # noqa: BLE001 - degrade, see docstring
                out.append(
                    (
                        NOTICE,
                        f"GitHub Environment `{name}`'s secrets could not be listed "
                        f"({_degrade_reason(e)}) — whether this {_env_noun(mode, role)} holds "
                        "credentials reachable by plan-time code was not checked.",
                    )
                )
                continue
            if not names:
                continue
            # Capped like the all-clear line's env list: the settings section is never truncated, so
            # one crowded environment would spend all of `sc.SIZE_BUDGET` and push the rest into the
            # omitted fallback. `count` reports the true total, so the cap hides only names.
            shown = _one_line(", ".join(f"`{n}`" for n in sorted(names)), 400)
            count = f"at least {total}" if total > len(names) else str(len(names))
            out.append((NOTICE, _secret_finding(name, env, role, mode, count, shown)))
            out += _app_key_findings(name, names, total, _env_noun(mode, role))
    return out


_PIN = re.compile(
    r"uses:\s*['\"]?(?P<owner>[\w.-]+)/(?P<repo>[\w.-]+)/(?:actions|\.github)/"
    r"[\w./-]+@(?P<ref>[\w./-]+)"
)
_SHA40 = re.compile(r"[0-9a-fA-F]{40}")


_WORKFLOWS_DIR = ".github/workflows"
# Degrade for every unreadable contents call in this probe family, NOTICE like the
# unreadable-release degrade below: none of the ways that read fails is a misconfiguration, for
# the reasons `_scan_workflow_texts` states. Never the generic WARNING degrade in warnings().
PIN_UNREADABLE = (
    NOTICE,
    f"could not read `{_WORKFLOWS_DIR}` — engine pin freshness not verified.",
)
# The two preconditions this probe cannot work without. Both are NOTICE, like
# the unreadable-contents degrade above: neither is a repository
# misconfiguration, and neither may be silently substituted with a weaker read.
PIN_NO_COMMIT = (
    NOTICE,
    "engine pin freshness not verified — the commit under examination could not be determined.",
)
PIN_NO_ENGINE = (
    NOTICE,
    "engine pin freshness not verified — the engine repository could not be determined.",
)


def _contents_ref(ctx):
    """`?ref=` suffix for the workflow-file reads — the commit under
    examination — or None when there is no usable one.

    Never the default branch: a stale pin is fixed by a PR that bumps the SHA,
    and that SHA lives only on the PR head until it merges, so a default-branch
    read reports the pin stale on the very PR that fixes it. "No commit" is
    therefore a reason to SKIP the probe, not to read something else.

    Anything that is not a 40-char hex SHA counts as absent rather than being
    interpolated into the request path (same guard as apply-detect's) — a probe
    must not be able to retarget a `gh api` URL, however it was configured."""
    sha = ctx.get("head_sha") or ""
    return f"?ref={sha}" if _SHA40.fullmatch(sha) else None


def _workflow_names(base):
    """([names], readable): the `.yml`/`.yaml` regular files of the workflow
    directory listing.

    A non-file entry (a directory named `*.yml`) is skipped rather than
    degraded: the probes reading this scan file CONTENT and cannot read one, and
    treating it as an unreadable file would trip their stop-at-the-first-failure
    branch and silently drop every finding in the rest of the directory."""
    try:
        listing = _gh_json(base)
    except (Exception, SystemExit):  # noqa: BLE001 - degrade, see PIN_UNREADABLE
        return [], False
    return [
        e["name"]
        for e in listing
        if e["name"].endswith((".yml", ".yaml")) and e.get("type") == "file"
    ], True


def _workflow_text(path):
    """One workflow file's decoded text, or None when it cannot be read.

    Anything that is not a base64 blob is UNREADABLE, not empty: a >1 MB file
    answers with `encoding: "none"` and empty `content`, which would otherwise
    decode to a readable EMPTY workflow the probes read as clean.

    `errors="replace"` keeps a mis-encoded byte from raising, and one leading
    U+FEFF is dropped: a BOM sits in front of the column-0 `on:` key, which
    `_on_block` would otherwise read as no top-level trigger block at all.
    """
    try:
        blob = _gh_json(path)
    except (Exception, SystemExit):  # noqa: BLE001 - degrade, see PIN_UNREADABLE
        return None
    if not isinstance(blob, dict) or blob.get("encoding") != "base64":
        return None
    text = base64.b64decode(blob.get("content", "")).decode("utf-8", "replace")
    return text.removeprefix("\ufeff")


def _scan_workflow_texts(ctx, ref, per_file, unreadable):
    """Findings from `per_file(text, name)` over every workflow file at `ref`.

    Stops at the first unreadable file and reports `unreadable`: the same cause
    (permissions, a bad ref, an API outage) applies to the rest of the directory.

    KNOWN GAP, not a guarantee: files after that one are never examined, so a
    caller accumulating state across files (`_pins_in_workflows`' `seen`) hands
    its own caller a PARTIAL result that reads as complete. `unreadable` is the
    only signal, and it is a NOTICE, so a pin-freshness report can name stale
    pins in the files it read while saying nothing about the rest.

    The pin and fork-trigger probes each call this with their own reads rather
    than sharing one — a module-level cache would outlive a single probe run and
    couple two probes' failure modes — so each costs one listing plus one read
    per file.

    Every caller's `unreadable` constant is a NOTICE, never a WARNING: the
    directory may not exist on the ref being read — the first shipmate pull
    request is the one that adds it — or the token cannot see it, or the API is
    transiently failing. None of those is a misconfiguration to warn about."""
    base = f"repos/{ctx['repo']}/contents/{_WORKFLOWS_DIR}"
    names, readable = _workflow_names(f"{base}{ref}")
    if not readable:
        return [unreadable]
    out = []
    for name in names:
        text = _workflow_text(f"{base}/{name}{ref}")
        if text is None:
            out.append(unreadable)
            break
        out.extend(per_file(text, name))
    return out


def _pins_in_text(text, fname, ctx, seen):
    """Tag/branch-pin warnings for one workflow file, recording its SHA pins in
    `seen` ({slug: {(file, sha)}}) for the freshness comparison.

    Only pins of the engine's own repository are considered. Every finding here
    is worded about the engine — a moving ref letting the engine change under
    the consumer's deploy credentials, re-pinning to pick up engine fixes — and
    none of that is true of, say, another org's shared lint action, which holds
    no deploy credentials and has its own release cadence."""
    out = []
    repo, engine = ctx["repo"], ctx["engine_repo"]
    for m in _PIN.finditer(text):
        slug, ref = f"{m.group('owner')}/{m.group('repo')}", m.group("ref")
        if slug == repo:
            continue  # a repo pinning its own actions is not an engine pin
        if slug != engine:
            continue  # a third party's action is not shipmate's to report on
        if not _SHA40.fullmatch(ref):
            out.append(
                (
                    WARNING,
                    f"`{fname}` pins `{slug}@{ref}` by tag or branch — pin a "
                    "commit SHA (a moving ref lets the engine change under your "
                    "deploy credentials).",
                )
            )
            continue
        seen.setdefault(slug, set()).add((fname, ref.lower()))
    return out


def _pins_in_workflows(ctx):
    """(warnings, {slug: {(file, sha)}}) for every engine action pin found in
    the consumer's workflow files at the commit under examination. The engine's
    owner/repo comes from `ctx["engine_repo"]`, discovered at runtime from
    `github.action_repository` — shipmate never hardcodes an org. Either
    precondition missing, or an unreadable listing or file, degrades to a NOTICE
    rather than an error; the preconditions are checked before any API call,
    since without them no read could be interpreted anyway."""
    seen = {}
    if not ctx["engine_repo"]:
        return [PIN_NO_ENGINE], seen
    ref = _contents_ref(ctx)
    if ref is None:
        return [PIN_NO_COMMIT], seen
    out = _scan_workflow_texts(
        ctx,
        ref,
        lambda text, name: _pins_in_text(text, name, ctx, seen),
        PIN_UNREADABLE,
    )
    return out, seen


def _latest_release_sha(slug):
    """(tag, sha) of `slug`'s latest release; (None, None) when unreadable.

    Cross-repo read: the ambient GH_TOKEN is an App installation token scoped
    to the consumer repo and may not read the engine repo. Prefer
    SHIPMATE_PUBLIC_TOKEN (the workflow token — enough for a public-repo read)
    for these two calls only, restoring GH_TOKEN afterwards.
    """
    saved, public = os.environ.get("GH_TOKEN"), os.environ.get("SHIPMATE_PUBLIC_TOKEN")
    if public:
        os.environ["GH_TOKEN"] = public
    try:
        tag = _gh_json(f"repos/{slug}/releases/latest").get("tag_name")
        if not tag:
            return None, None
        return tag, _gh_json(f"repos/{slug}/commits/{tag}").get("sha")
    except (Exception, SystemExit):  # noqa: BLE001 - unreadable release is a NOTICE upstream
        return None, None
    finally:
        if public:
            if saved is None:
                os.environ.pop("GH_TOKEN", None)
            else:
                os.environ["GH_TOKEN"] = saved


def _pin_warnings(ctx):
    out, seen = _pins_in_workflows(ctx)
    for slug, pins in sorted(seen.items()):
        tag, sha = _latest_release_sha(slug)
        if not sha:
            # NOTICE, not WARNING: degrade, don't alarm.
            out.append(
                (
                    NOTICE,
                    f"could not read `{slug}`'s latest release — engine pin freshness "
                    "not verified.",
                )
            )
            continue
        differing = sorted({(f, ref) for f, ref in pins if ref != sha})
        for fname, ref in differing:
            out.append(
                (
                    WARNING,
                    f"`{fname}` pins `{slug}@{ref[:7]}`, which differs from the latest "
                    f"release {tag} (`{sha[:7]}`) — re-pin to pick up fixes.",
                )
            )
    return out


# Word-ish boundaries, so `pull_request_target_foo` is a different trigger. Where the search runs:
# `declares_pull_request_target`.
_PR_TARGET = re.compile(r"(?<![\w-])pull_request_target(?![\w-])")
# Same degrade posture and reason as PIN_UNREADABLE: an unreadable workflow
# directory is not a misconfiguration to warn about.
FORK_TRIGGER_UNREADABLE = (
    NOTICE,
    f"could not read `{_WORKFLOWS_DIR}` — `pull_request_target` triggers not verified.",
)
FORK_TRIGGER_NO_COMMIT = (
    NOTICE,
    "`pull_request_target` triggers not verified — the commit under examination "
    "could not be determined.",
)

# Flow-style tolerant. Why this input matters, and why the anchor and the value terminator are
# what they are: `_unsafe_checkout_warnings`.
_UNSAFE_CHECKOUT = re.compile(
    r"(?:^|[{,])[ \t]*allow-unsafe-pr-checkout[ \t]*:(?P<value>[^,}\n]*)", re.M
)


# `on` at column 0 only, optionally quoted; the anchoring is `_on_block`'s match, see there.
_ON_KEY = re.compile(r"""["']?on["']?[ \t]*:(?P<rest>.*)$""")


def _strip_comment(line):
    """`line` up to its YAML comment marker: a `#` at the start of the line or
    preceded by whitespace. A `#` inside a token (`branch#1`) is not a comment."""
    for i, ch in enumerate(line):
        if ch == "#" and (i == 0 or line[i - 1] in " \t"):
            return line[:i]
    return line


def _stripped_text(text):
    """`text` with every YAML comment removed, line structure intact."""
    return "\n".join(_strip_comment(ln) for ln in text.splitlines())


def _on_block(text):
    """(inline remainder of the `on:` line, its following lines) with comments
    stripped, or (None, []) for a file with no top-level `on:`. The block runs to
    the first line starting at column 0; blank and comment-only lines do not end
    it.

    A workflow's `on:` is a top-level key, so an indented one belongs to
    something else. `_ON_KEY` is matched rather than searched, and that is the
    whole of the anchoring — unanchored, `    python-version: 3.12` matches
    (`versi` + `on:`) and silently retargets the block this probe reads."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        m = _ON_KEY.match(line)
        if not m:
            continue
        block = []
        for nxt in lines[i + 1 :]:
            stripped = _strip_comment(nxt)
            if stripped.strip() and not stripped[0].isspace():
                break
            block.append(stripped)
        return _strip_comment(m.group("rest")), block
    return None, []


def _event_lines(inline, block):
    """The lines of an `on:` value that can name an event: the inline remainder,
    plus — for a block mapping or sequence — only its shallowest children.
    Anything deeper is one event's own configuration (`types:`, a
    `workflow_dispatch` input's `options:`). A flow collection is a single value
    however it is wrapped across lines, so all of its lines count."""
    content = [ln for ln in [inline, *block] if ln.strip()]
    if content and content[0].lstrip()[:1] in ("[", "{"):
        return content
    indents = [len(ln) - len(ln.lstrip()) for ln in block if ln.strip()]
    if not indents:
        return [inline]
    top = min(indents)
    return [inline] + [ln for ln in block if ln.strip() and len(ln) - len(ln.lstrip()) == top]


def declares_pull_request_target(text):
    """Whether a workflow file declares the `pull_request_target` trigger.

    Comments are stripped first: `# never add pull_request_target here` is
    exactly the line a repository writes *because* it does not have one, and
    reporting it would train readers to ignore the finding.

    The search is scoped to the workflow's top-level `on:` value, at the level
    where event names live: a `run:` body, an `if:` expression and a
    `strategy.matrix` value are not in that block at all, and a
    `workflow_dispatch` input's `options:` entry is nested below it. doctor is
    stdlib-only and cannot yaml.safe_load, so the block is sliced by
    indentation."""
    inline, block = _on_block(text)
    if inline is None:
        return False
    return any(_PR_TARGET.search(ln) for ln in _event_lines(inline, block))


def _unsafe_checkout_warnings(text, name):
    """`allow-unsafe-pr-checkout` set to anything but a literal false.

    Comments are stripped first, for the same reason
    `declares_pull_request_target` strips them: `# never set
    allow-unsafe-pr-checkout: true` is what a careful repository writes
    *because* it does not have one. A `${{ }}` value is unknown, not false, so
    it is reported — it may evaluate true.

    EVERY occurrence is examined, not the first: a consumer file checks out in
    more than one job, and one job's explicit `false` — the shape this very
    finding asks for — must not silence another job's `true`.

    The value is compared case-insensitively: `False` and `FALSE` are the same
    legal YAML boolean as `false`, and a finding on a correct repository trains
    readers to ignore the whole suite.

    `actions/checkout` refuses to check out a fork's head under
    `pull_request_target` unless this input turns the refusal off, which makes
    it the single most consequential line a consumer can add: that third party's
    default is the outermost guard on this path.

    `_UNSAFE_CHECKOUT` matches at a line start OR after `{`/`,`: flow style is a
    house idiom here — `docs/drift.md` and all four sample repositories write
    `with: { fetch-depth: 0 }`, so a one-line checkout step is what a consumer
    copying those pages produces. The value stops at `,`/`}` for the same
    reason: a flow-style `false` must read as `false` and not as `false }`,
    which would report the safest shape a consumer can write."""
    values = [
        m.group("value").strip().strip("\"'").lower()
        for m in _UNSAFE_CHECKOUT.finditer(_stripped_text(text))
    ]
    if all(v == "false" for v in values):
        return []
    return [
        (
            WARNING,
            f"`{name}` sets `allow-unsafe-pr-checkout` to something other than `false` — "
            "that input turns off `actions/checkout`'s own refusal to check out a fork's "
            "head, which is the outermost guard on shipmate's plan path. Under "
            "`pull_request_target` the job runs at the base ref and may hold this "
            "repository's secrets, so the checked-out code runs alongside them. Under "
            "`pull_request` a fork's run is handed no secrets, and the input is still "
            "reported: it holds nothing back the day this workflow gains a "
            "`pull_request_target` trigger. Remove the input or set it to `false` "
            "(see docs/hardening.md).",
        )
    ]


def _fork_trigger_warnings(ctx):
    """`pull_request_target` runs at the base ref, so it is handed the
    repository's secrets — and the base ref is exactly what `shipmate-engine`'s
    default-branch-only policy trusts, so a job declaring that environment would
    be handed the App key too — while checking out and acting on content the pull
    request author controls. That is the fork-reachable form of the
    branch-authored-workflow attack `docs/hardening.md` opens with, and the one
    misconfiguration on that page an outside contributor can reach without push
    access.

    The consumer's one workflow file is on this trigger by design and stays exempt with the
    comment-ops, deploy, drift, apply and unlock jobs in it: every one of those `if:`
    expressions is false under `pull_request_target`, so those jobs do not run, and a job
    that does not run binds no environment and is handed no token. `_routing_warnings` is
    what watches those seven `if:` expressions.

    Reads the consumer's workflow files at the commit under examination, the
    same way and for the same reason as the pin probe (`_contents_ref`): a pull
    request that *removes* the trigger must not still be reported for it."""
    ref = _contents_ref(ctx)
    if ref is None:
        return [FORK_TRIGGER_NO_COMMIT]

    def finding(text, name):
        # Before the `shipmate.yml` exemption below, not after: `shipmate.yml`
        # is exactly the file where a fork checkout would be turned on.
        out = _unsafe_checkout_warnings(text, name)
        # Exempt for the reasons the docstring gives. Exact name — a `custom-plan.yml` is a
        # consumer file and gets the warning.
        if name == "shipmate.yml":
            return out
        if not declares_pull_request_target(text):
            return out
        return out + [
            (
                WARNING,
                f"`{name}` triggers on `pull_request_target` — that trigger runs at "
                "the base ref with this repository's secrets, and on a pull request "
                "into the default branch that is the ref `shipmate-engine`'s branch "
                "policy trusts, so a fork can reach them. shipmate's own `shipmate.yml` "
                "uses this trigger safely because the job holding the App key — the "
                "`summary` job inside the engine's reusable plan workflow — runs "
                "no repository content at all. If this workflow checks out or acts "
                "on the pull request's own code in a job binding a CREDENTIALED "
                "environment — one holding the App key or cloud credentials — it "
                "does not have that property. Remove the trigger or split those "
                "two things apart (see docs/hardening.md).",
            )
        ]

    return _scan_workflow_texts(ctx, ref, finding, FORK_TRIGGER_UNREADABLE)


# The shim's call of the engine's plan workflow. Read by two probes: this one, which judges the
# calling job's name, and the dispatch probe, for which the call's absence is the finding.
_PLAN_WORKFLOW_CALL = re.compile(r"/\.github/workflows/plan\.yml@")
# Line-anchored, and matched only against a direct child of the calling job: a `name:` or `if:`
# deeper in the block belongs to something else. Read through `_job_key`.
_JOB_KEY = re.compile(r"^[ \t]*(?P<key>name|if)[ \t]*:(?P<value>.*)$")
_SHIM_JOB_NAME = "shipmate"
# Same degrade posture and reason as PIN_UNREADABLE: an unreadable workflow
# directory is not a misconfiguration to warn about.
SHIM_JOB_UNREADABLE = (
    NOTICE,
    f"could not read `{_WORKFLOWS_DIR}` — the workflow file's calling job name not verified.",
)
SHIM_JOB_NO_COMMIT = (
    NOTICE,
    "the workflow file's calling job name not verified — the commit under examination "
    "could not be determined.",
)


def _call_region(text, pattern):
    """The comment-stripped lines of the block enclosing the `uses:` line
    `pattern` matches, or None when the file has no such line.

    The block is found by walking BACK from the `uses:` line to the enclosing
    key (the first shallower line) and then forward to the next line at that
    key's level or above, so one `uses:` inside a shim's calling job returns
    that whole job, its id line included. Forward-only from `uses:` would miss a
    `name:` written above it — the shape docs/getting-started.md ships — and
    report a correctly named job as carrying no name at all. A probe that fires
    on the documented shape trains readers to ignore the suite."""
    lines = _stripped_text(text).splitlines()
    for i, line in enumerate(lines):
        if not pattern.search(line):
            continue
        depth = len(line) - len(line.lstrip())
        start = next(
            (
                j
                for j in range(i - 1, -1, -1)
                if lines[j].strip() and len(lines[j]) - len(lines[j].lstrip()) < depth
            ),
            i,
        )
        region = [lines[start]]
        for nxt in lines[start + 1 :]:
            if nxt.strip() and len(nxt) - len(nxt.lstrip()) < depth:
                break
            region.append(nxt)
        return "\n".join(region)
    return None


def _job_key(region, key):
    """The value of `key` written as a direct child of the job block `region`, or None.

    Only a direct child is read, so a `name:` under `with:` or an `if:` on a step cannot
    stand in for the job's own. Judged block-style, like the documented file and every other
    finder here.

    KNOWN GAP: a block scalar (`if: >-`) yields its first line alone, which the whole-value
    comparison then reports as differing. That reports a healthy file rather than passing a
    broken one, which is the safe direction, and the published file writes one line."""
    lines = region.splitlines()
    body = [ln for ln in lines[1:] if ln.strip()]
    depth = min((len(ln) - len(ln.lstrip()) for ln in body), default=0)
    values = [
        m.group("value").strip()
        for ln in body
        if len(ln) - len(ln.lstrip()) == depth
        for m in [_JOB_KEY.match(ln)]
        if m and m.group("key") == key
    ]
    return values[0] if values else None


def _shim_job_name_warnings(ctx):
    """A `shipmate.yml` whose plan-calling job is not named `shipmate` still plans
    correctly, and its plan comment loses every per-cell deep link.

    GitHub names a called workflow's check runs `<caller job> / <callee job>`,
    so the plan cell checks are `shipmate / <stack> / <env>` only when that
    job carries that name. `scripts/summary-comment` resolves each row's
    `[plan]` link by that exact name and falls back to the workflow-run URL on a
    miss — so the failure is a silently degraded comment, not an error anyone
    sees.

    Reads the consumer's workflow files at the commit under examination, the
    same way and for the same reason as the pin, fork-trigger and dispatch
    probes (`_contents_ref`): a pull request that renames the job must not still
    be reported for the old name."""
    ref = _contents_ref(ctx)
    if ref is None:
        return [SHIM_JOB_NO_COMMIT]

    def finding(text, name):
        # Exact name, like the fork-trigger exemption's: `shipmate.yml` is the file
        # `actions/dispatch` targets for every verb and the one whose cells produce the
        # linked checks.
        if name != "shipmate.yml":
            return []
        return _shim_job_name_finding(text, name)

    return _scan_workflow_texts(ctx, ref, finding, SHIM_JOB_UNREADABLE)


def _shim_job_name_finding(text, name):
    """The calling job's display name, or [] when it is `shipmate` or the file
    calls the engine's plan workflow nowhere.

    Regex over the call's own block rather than a YAML parse, like every other
    finder here: a consumer file that does not parse must still be read for what
    can be read, not skipped.

    An absent `name:` is not a finding — GitHub displays the job id then, so a job written
    `jobs:` / `  shipmate:` / `    uses: …` produces the same check names as the documented
    shape. Only a direct child of the job is read as its name, so a `name:` under `with:`
    cannot stand in for one. Judged block-style, like the documented file and every other
    finder here."""
    region = _call_region(text, _PLAN_WORKFLOW_CALL)
    if region is None:
        return []
    named = _job_key(region, "name")
    job_name = (
        named.strip("\"'")
        if named is not None
        else region.splitlines()[0].strip().rstrip(":").strip("\"'")
    )
    if job_name == _SHIM_JOB_NAME:
        return []
    return [
        (
            WARNING,
            f"`{name}`'s calling job is not named `{_SHIM_JOB_NAME}` — GitHub names a called "
            "workflow's check runs `<caller job> / <callee job>`, so this repository's plan cell "
            f"checks are not `{_SHIM_JOB_NAME} / <stack> / <env>`. The plan runs and the gate is "
            "unaffected; what is lost is every `[plan]` link in the plan comment, which falls "
            "back to the workflow-run page instead of the cell's own check. Rename the job "
            f"`{_SHIM_JOB_NAME}` (docs/getting-started.md).",
        )
    ]


# Both spellings, line-anchored, with a known gap: see `_plan_run_id_finding`.
_PLAN_RUN_ID_KEY = re.compile(r"^[ \t]*plan[-_]run[-_]id[ \t]*:", re.M)
# Same degrade posture and reason as PIN_UNREADABLE.
PLAN_RUN_ID_UNREADABLE = (
    NOTICE,
    f"could not read `{_WORKFLOWS_DIR}` — the workflow file's retired `plan_run_id` "
    "input not verified.",
)
PLAN_RUN_ID_NO_COMMIT = (
    NOTICE,
    "the workflow file's retired `plan_run_id` input not verified — the commit under "
    "examination could not be determined.",
)


def _plan_run_id_warnings(ctx):
    """The engine retired the `plan_run_id` rail: the plan run id now travels
    per apply cell, so no engine workflow or action outside `apply-cell` takes
    one. A consumer's workflow file that still declares or forwards it is the one
    shape of this breakage a consumer owns, and the forwarding half is invisible
    from outside (see `_plan_run_id_finding`).

    Reads the consumer's workflow files at the commit under examination, the
    same way and for the same reason as the pin, fork-trigger and shim-job-name
    probes (`_contents_ref`): a pull request that *removes* the input must not
    still be reported for it.

    Judged by exact name, like the shim-job-name exemption above: the file
    shipped in docs/getting-started.md is `shipmate.yml`, and it is the file that
    calls the engine's reusable apply workflows. The filter lives in this
    function rather than in `_plan_run_id_finding` so that a direct call of that
    function with another file's name still reports — a direct call bypasses the
    exemption, and silence there reads as a false positive that is not one.

    The forwarded count `_plan_run_id_finding` derives now spans all seven of that file's
    jobs rather than one file's single job, which widens it: a `plan_run_id` forwarded from
    any of them is a finding, and every one of them is a real breakage."""
    ref = _contents_ref(ctx)
    if ref is None:
        return [PLAN_RUN_ID_NO_COMMIT]

    def finding(text, name):
        # Exact name, and the filter's placement: see the docstring.
        if name != "shipmate.yml":
            return []
        return _plan_run_id_finding(text, name)

    return _scan_workflow_texts(ctx, ref, finding, PLAN_RUN_ID_UNREADABLE)


def _plan_run_id_finding(text, name):
    """The retired input declared, forwarded, or both.

    The two halves are told apart by the `on:` block: a `workflow_dispatch`
    input is declared inside it, and every other occurrence is a `with:` line
    forwarding the value on. Counting rather than partitioning keeps this to the
    one existing helper — every occurrence the whole file has that the `on:`
    block does not is a forward.

    They are reported separately because the consequences are not alike. A
    declaration alone is dead weight: the engine sends no such value, so nothing
    fills it in. A forward to the engine's reusable `apply.yml`/`apply-all.yml`
    is a LOAD-TIME rejection of the whole run: no jobs, no logs, only a
    workflow-validation error on the run itself — which is the hardest failure in
    this system to diagnose from the outside. Only that much is claimed, and it
    was MEASURED: `docs/releasing.md` establishes the load-time rejection for an
    undeclared SECRET and says an undeclared ACTION input is silently ignored, so
    the workflow-call case was checked rather than inferred — `conclusion:
    startup_failure`, `jobs` reporting `total_count: 0`, no check runs on the
    commit, and `gh run view --log` answering that the log is not found.

    `_PLAN_RUN_ID_KEY` matches both spellings: a
    `workflow_call`/`workflow_dispatch` input is declared as `plan_run_id`, an
    action input passed as `plan-run-id`, and a consumer file carrying either is
    carrying the retired rail. Line-anchored means a fully inline flow
    `on: { workflow_dispatch: { inputs: { plan_run_id: … } } }` is NOT seen — a
    gap that stays silent rather than reporting a healthy file."""
    _, block = _on_block(text)
    declared = len(_PLAN_RUN_ID_KEY.findall("\n".join(block)))
    forwarded = len(_PLAN_RUN_ID_KEY.findall(_stripped_text(text))) - declared
    out = []
    if declared:
        out.append(
            (
                WARNING,
                f"`{name}` still declares a `plan_run_id` input — the engine retired that "
                "input and dispatches no such value, so nothing ever fills it in. Remove the "
                "declaration, and any `with:` line forwarding it.",
            )
        )
    if forwarded:
        out.append(
            (
                WARNING,
                f"`{name}` still passes `plan_run_id` on — the engine retired that input, so "
                "nothing it calls accepts one. Passed to the engine's reusable `apply.yml` or "
                "`apply-all.yml`, GitHub rejects the run when it LOADS the workflow: the run "
                "has no jobs and no logs, only a workflow-validation error on the run itself, "
                "which is the hardest failure here to diagnose from the outside. Passed to a "
                "composite action it is only a warning and the run continues. Remove the "
                "`with:` line — "
                "the plan run id now travels with each apply cell and needs no wiring.",
            )
        )
    return out


# Line-anchored, like `_PLAN_RUN_ID_KEY` and with the same known gap; `mode` is generic YAML, so
# where the key is found is the whole finding. Both points: `_mode_input_finding`.
_MODE_KEY = re.compile(r"^[ \t]*mode[ \t]*:", re.M)
# A job calling the engine's reusable apply workflows, matched on the path rather than on
# `ctx["engine_repo"]`; that is an accepted cost, see `_apply_call_regions`.
_APPLY_CALL = re.compile(r"^[ \t]*uses[ \t]*:.*/\.github/workflows/apply(?:-all)?\.yml@")
# Same degrade posture and reason as PIN_UNREADABLE.
MODE_INPUT_UNREADABLE = (
    NOTICE,
    f"could not read `{_WORKFLOWS_DIR}` — the workflow file's retired `mode` input not verified.",
)
MODE_INPUT_NO_COMMIT = (
    NOTICE,
    "the workflow file's retired `mode` input not verified — the commit under examination "
    "could not be determined.",
)


def _mode_input_warnings(ctx):
    """The engine retired the `mode` rail: `shipmate unlock` dispatches its own
    `unlock.yml`, so the reusable `apply.yml`/`apply-all.yml` declare no such
    input. A consumer's workflow file that still declares or forwards it is the one shape
    of this breakage a consumer owns, and the forwarding half is invisible from outside
    (see `_mode_input_finding`).

    Reads the consumer's workflow files at the commit under examination, the
    same way and for the same reason as the pin, fork-trigger, shim-job-name and
    `plan_run_id` probes (`_contents_ref`): a pull request that *removes* the
    input must not still be reported for it."""
    ref = _contents_ref(ctx)
    if ref is None:
        return [MODE_INPUT_NO_COMMIT]

    def finding(text, name):
        # Exact name, and here rather than in `_mode_input_finding`, for the reasons
        # `_plan_run_id_warnings`' docstring states for its identical filter.
        if name != "shipmate.yml":
            return []
        return _mode_input_finding(text, name)

    return _scan_workflow_texts(ctx, ref, finding, MODE_INPUT_UNREADABLE)


def _apply_call_regions(lines):
    """The line ranges of every job whose `uses:` names the engine's reusable
    apply workflows. A job's own keys sit at that `uses:` line's indent, so the
    job runs from the nearest shallower line above to the nearest one below —
    both directions, because `with:` may be written before `uses:`.

    `_APPLY_CALL` matches on the path rather than on `ctx["engine_repo"]`, which
    is an ACCEPTED cost, not a claim about what a consumer can write: a forward
    on a call to another org's own `.github/workflows/apply.yml` is reported
    too. Scoping it would need the engine slug and therefore a third degrade
    path, for a shape the caller has already narrowed to the consumer's own
    `apply.yml`."""

    def shallower(ln, n):
        return ln.strip() and len(ln) - len(ln.lstrip()) < n

    for i, line in enumerate(lines):
        if not _APPLY_CALL.match(line):
            continue
        n = len(line) - len(line.lstrip())
        start = next((j + 1 for j in range(i - 1, -1, -1) if shallower(lines[j], n)), 0)
        end = next((j for j in range(i + 1, len(lines)) if shallower(lines[j], n)), len(lines))
        yield start, end


def _mode_input_finding(text, name):
    """The retired input declared, forwarded, or both.

    Unlike the `plan_run_id` sibling, the two halves are counted independently
    rather than by subtracting the declarations from a file-wide scan: `mode` is
    a name other things legitimately use, and a file-wide scan reports an
    `actions/state` step for `mode: restore`. A declaration is a `mode:` key
    inside the `on:` block, where no GitHub event has such a key; a forward is
    one inside a job calling the engine's reusable apply workflows, where the
    only keys are that call's own.

    They are reported separately because the consequences are not alike. A
    declaration alone is dead weight: nothing dispatches such a value, so nothing
    fills it in. A forward is a LOAD-TIME rejection of the whole run: no jobs, no
    logs, only a workflow-validation error on the run itself — which is the
    hardest failure in this system to diagnose from the outside. That asymmetry
    between an undeclared workflow-call input and an undeclared action input is
    the measured one at `docs/upgrading.md`.

    `_MODE_KEY` is line-anchored, like `_PLAN_RUN_ID_KEY` and with the same
    known gap, which applies to BOTH halves: a fully inline flow mapping —
    `on: { workflow_dispatch: { inputs: { mode: … } } }`, or
    `with: { environment: …, mode: …, … }` on the apply call — is not seen. Both
    stay silent rather than reporting a healthy file, but the forward's silence
    is the costly one: the consumer re-pins, the run dies as GitHub LOADS it
    with `startup_failure`, no job and no log, and this probe said nothing about
    the one shape it exists to pre-warn about. The threat model it is written for
    is a file copied from the block-style fences on our own pages and then
    drifting, so the anchor stays. `apply-cell`'s state steps and
    `actions/summary`'s `comment_mode` are two more unrelated uses of the
    name."""
    lines = _stripped_text(text).splitlines()
    _, block = _on_block(text)
    declared = _MODE_KEY.findall("\n".join(block))
    forwarded = [
        m for s, e in _apply_call_regions(lines) for m in _MODE_KEY.findall("\n".join(lines[s:e]))
    ]
    out = []
    if declared:
        out.append(
            (
                WARNING,
                f"`{name}` still declares a `mode` input — the engine retired that input and "
                "dispatches no such value, so nothing ever fills it in. `shipmate unlock` now "
                "dispatches its own `unlock.yml`. Remove the declaration, and any `with:` line "
                "forwarding it.",
            )
        )
    if forwarded:
        out.append(
            (
                WARNING,
                f"`{name}` still passes `mode` on to the engine's reusable `apply.yml` or "
                "`apply-all.yml` — the engine retired that input, so neither declares one, and "
                "GitHub rejects the run when it LOADS the workflow: the run has no jobs and no "
                "logs, only a workflow-validation error on the run itself, which is the hardest "
                "failure here to diagnose from the outside. Remove the `with:` line — `shipmate "
                "unlock` now dispatches its own `unlock.yml` and carries no mode.",
            )
        )
    return out


# The dispatch leg of the consumer's workflow file. NOT line-anchored like `_PLAN_RUN_ID_KEY`,
# and the polarity is the reason; see `_dispatch_wiring_finding`.
_DISPATCH_TRIGGER = re.compile(r"[\s{,]workflow_dispatch[ \t]*:")
#: Every input `scripts/dispatch-body` can name. An input the file does not declare is
#: `Unexpected inputs provided` (HTTP 422, no run); one it declares `required: true` that a body
#: omits is `Required input not provided` (HTTP 422, no run) — which is why the three beside
#: `verb` must be optional.
_DISPATCH_INPUTS = ("verb", "environment", "ref", "pr_number")
# One selector per input from one template: two spellings of "is this input declared" disagree
# eventually. Unanchored for `_DISPATCH_TRIGGER`'s reason.
_INPUT_KEYS = {name: re.compile(rf"[\s{{,]{name}[ \t]*:") for name in _DISPATCH_INPUTS}
#: The whole option list `actions/dispatch` and the `drift` job between them can send. Compared
#: as a whole value, in order: a list missing `unlock` refuses that verb at the form and at the
#: API, and one carrying an extra option offers a verb no `if:` selects. KNOWN GAP: only the
#: flow form is recognised, so a block-style `options:` is reported as differing — the safe
#: direction, and the published file writes the flow form. Read from `verb`'s own block
#: (`_input_block`), never the first `options:` in the trigger: a consumer's own input
#: declared above `verb` would otherwise become the list this compares.
_VERB_OPTIONS = "[plan, apply, unlock, drift]"
_VERB_OPTIONS_KEY = re.compile(r"[\s{,]options[ \t]*:[ \t]*(?P<value>\[[^\]]*\])")
_REQUIRED_TRUE = re.compile(r"""[\s{,]required[ \t]*:[ \t]*["']?true["']?""", re.I)
# Same degrade posture and reason as PIN_UNREADABLE.
DISPATCH_WIRING_UNREADABLE = (
    NOTICE,
    f"could not read `{_WORKFLOWS_DIR}` — the workflow file's dispatch wiring not verified.",
)
DISPATCH_WIRING_NO_COMMIT = (
    NOTICE,
    "the workflow file's dispatch wiring not verified — the commit under examination could "
    "not be determined.",
)


def _dispatch_wiring_warnings(ctx):
    """Every commented verb dispatches the consumer's own `shipmate.yml`, and every way
    that file can be unready for it is invisible until someone comments.

    Reads the consumer's workflow files at the commit under examination, the
    same way and for the same reason as the pin, fork-trigger and shim-job-name
    probes (`_contents_ref`): a pull request that *adds* the trigger must not
    still be reported for lacking it."""
    ref = _contents_ref(ctx)
    if ref is None:
        return [DISPATCH_WIRING_NO_COMMIT]

    def finding(text, name):
        # Exact name, like the retired-input probe's: `shipmate.yml` is the file
        # `actions/dispatch` targets for every verb. The filter lives here rather than in
        # `_dispatch_wiring_finding` so a direct call with another file's name still reports.
        if name != "shipmate.yml":
            return []
        return _dispatch_wiring_finding(text, name)

    return _scan_workflow_texts(ctx, ref, finding, DISPATCH_WIRING_UNREADABLE)


def _input_block(on_text, input_name):
    """The lines one input's declaration owns — the remainder of its key line plus every line
    indented deeper than it — or None when the `on:` block declares no such input.

    One input at a time, because the trigger's keys are not interchangeable: `verb` is the
    only required input and the only one carrying an `options:` list, so a scan of the whole
    trigger would read its `required: true` as every other input's and its `options:` as an
    earlier input's. A consumer may declare inputs of their own — `docs/drift.md` invites one
    — and one written above `verb` would otherwise become the thing both findings judge.

    KNOWN GAP: a wholly inline `on:` mapping puts every input on one line, so an input's block
    runs to the end of that line and takes the inputs after it in. The published file writes
    block style, and either way the finding names a remedy that applies to the file."""
    lines = on_text.splitlines()
    for i, line in enumerate(lines):
        m = _INPUT_KEYS[input_name].search(line)
        if not m:
            continue
        depth = len(line) - len(line.lstrip())
        body = [line[m.end() :]]
        for nxt in lines[i + 1 :]:
            if nxt.strip() and len(nxt) - len(nxt.lstrip()) <= depth:
                break
            body.append(nxt)
        return body
    return None


def _required_inputs(on_text):
    """The `_DISPATCH_INPUTS` other than `verb` that the `on:` block declares `required:
    true`, block-style or in a flow mapping on the key's own line."""
    return [
        name
        for name in _DISPATCH_INPUTS[1:]
        if any(_REQUIRED_TRUE.search(f" {b}") for b in _input_block(on_text, name) or [])
    ]


def _dispatch_input_findings(on_text, name):
    """The three ways a declared `workflow_dispatch` trigger still refuses a verb: an input
    `scripts/dispatch-body` names that the file does not declare, a `verb` offering the wrong
    option list, and an input other than `verb` declared required."""
    out = []
    missing = [n for n in _DISPATCH_INPUTS if not _INPUT_KEYS[n].search(on_text)]
    if missing:
        out.append(
            (
                WARNING,
                f"`{name}`'s `workflow_dispatch` trigger declares no "
                f"{_and_list(missing)} input — `actions/dispatch` sends one body per verb, and "
                "GitHub refuses a body naming an input the workflow does not declare: "
                "`Unexpected inputs provided`, no run created, and the pull request pointed at "
                "the comment-handling run by a comment saying the dispatch failed. Declare "
                f"{_and_list(_DISPATCH_INPUTS)} under the trigger's `inputs:` "
                "(docs/getting-started.md).",
            )
        )
    verb = _input_block(on_text, "verb")
    found = _VERB_OPTIONS_KEY.search("\n".join(verb)) if verb else None
    if not found or " ".join(found.group("value").split()) != _VERB_OPTIONS:
        out.append(
            (
                WARNING,
                f"`{name}`'s `verb` input does not offer `{_VERB_OPTIONS}` — that is the whole "
                "set of verbs this file routes. A missing option is refused at the dispatch "
                "form and at the API, so that verb reaches nothing; an extra one offers a verb "
                "no job's `if:` selects, and its run completes with every job skipped, which "
                f"reads as success everywhere. Write `options: {_VERB_OPTIONS}` "
                "(docs/getting-started.md).",
            )
        )
    required = _required_inputs(on_text)
    if required:
        out.append(
            (
                WARNING,
                f"`{name}` declares the {_and_list(required)} input `required: true` — every "
                "dispatch body omits at least one of these, and GitHub reads an omitted or "
                "empty value for a required input as not provided: `Required input not "
                "provided`, no run created, so one required input refuses a whole verb. `verb` "
                "is the only required one; give the rest `required: false` and `default: ''` "
                "(docs/getting-started.md).",
            )
        )
    return out


def _and_list(names):
    """The names as prose — `a`, `b` and `c` — for the findings that list an input set."""
    quoted = [f"`{n}`" for n in names]
    return " and ".join([", ".join(quoted[:-1]), quoted[-1]] if len(quoted) > 1 else quoted)


def _dispatch_wiring_finding(text, name):
    """The five ways the consumer's workflow file cannot serve a dispatched verb.

    The trigger and its inputs are looked for inside the `on:` block
    (`_on_block`), inline remainder included, and not in the whole file: a `with:`
    line forwarding `pr_number` on is not a declaration of it, and a
    `workflow_dispatch:` line under `jobs:` — no such key exists, but a stray line
    matches a whole-file regex — must not satisfy the trigger. That scoping is
    also what lets the two keys be matched unanchored, which is what sees a
    flow-style `on:` value.

    Five findings rather than one, because the remedies differ and so do the
    refusals. The first four end in a dispatch-time HTTP 422 with no run
    created, and they are told apart by the message GitHub answers with:
    `Workflow does not have 'workflow_dispatch' trigger` and `Unexpected inputs
    provided` are the pair `actions/dispatch` recognises, while `Required input
    not provided` is GitHub's answer to the requiredness finding and nothing
    downstream reads it. A wrong `options:` list is refused the same way, one
    verb at a time, and offers a verb no job's `if:` selects when it carries an
    extra. The last is not a refusal at all: the file accepts the dispatch and
    then runs nothing that plans.

    The three input findings are examined only where the trigger itself is there: without it
    nothing is dispatched at all, and three further remedies below that one bury it.

    `_DISPATCH_TRIGGER` and the `_INPUT_KEYS` are unanchored because ABSENCE is
    the finding here: where a match IS the finding (`_PLAN_RUN_ID_KEY`) a shape
    the anchor misses stays silent, while the same miss here would report a
    correctly wired file as declaring no trigger at all.
    `on: { workflow_dispatch: { inputs: { pr_number: … } } }` is legal YAML, and
    an anchor fails after `{ ` however much of the flow mapping is fed in. A
    preceding brace, comma or whitespace stands in for the line start. That is
    safe only inside the `on:` block: unanchored over a whole file, `versi` +
    `on:` is the retargeting `_on_block` documents."""
    inline, block = _on_block(text)
    on_text = "\n".join([inline or "", *block])
    out = []
    if not _DISPATCH_TRIGGER.search(on_text):
        out.append(
            (
                WARNING,
                f"`{name}` declares no `workflow_dispatch` trigger — every commented verb is "
                "authorized, reacted to with a rocket, and then dispatches nothing: "
                "GitHub answers the dispatch with `Workflow does not have 'workflow_dispatch' "
                "trigger`, no run is created, and the pull request gets a comment saying the "
                "dispatch failed and linking the comment-handling run that holds the error. Add "
                "the trigger, with its `verb`, `environment`, `ref` and `pr_number` inputs "
                "(docs/getting-started.md).",
            )
        )
    else:
        out.extend(_dispatch_input_findings(on_text, name))
    if not _PLAN_WORKFLOW_CALL.search(_stripped_text(text)):
        out.append(
            (
                WARNING,
                f"`{name}` does not call the engine's plan workflow — the dispatch is accepted "
                "and the run starts, with nothing in it that resolves the pull request, plans a "
                "cell or reports a gate status, so a commented `shipmate plan` produces a green "
                "run and no plan. That call is the whole `plan` job: `uses: "
                "<engine>/.github/workflows/plan.yml@<sha>` (docs/getting-started.md).",
            )
        )
    return out


#: The whole `if:` of each job of `shipmate.yml`, keyed by the engine reusable workflow it
#: calls. The consumer owns these seven expressions and `docs/getting-started.md` publishes
#: them; a wrong one routes a verb nowhere and its dispatched run completes with every job
#: skipped, which reads as success everywhere. Compared whole, normalised only for an
#: enclosing quote pair, the optional `${{ }}` wrapper and whitespace: a subset check would bless
#: `github.event_name == 'workflow_dispatch'` alone, which sends every verb to every job.
ROUTING_IFS = {
    "plan.yml": (
        "github.event_name == 'pull_request_target' || "
        "(github.event_name == 'workflow_dispatch' && github.event.inputs.verb == 'plan')"
    ),
    "comment-ops.yml": "github.event_name == 'issue_comment'",
    "deploy.yml": "github.event_name == 'push'",
    "drift.yml": (
        "github.event_name == 'schedule' || "
        "(github.event_name == 'workflow_dispatch' && github.event.inputs.verb == 'drift')"
    ),
    "apply.yml": (
        "github.event_name == 'workflow_dispatch' && inputs.verb == 'apply' "
        "&& inputs.environment != ''"
    ),
    "apply-all.yml": (
        "github.event_name == 'workflow_dispatch' && inputs.verb == 'apply' "
        "&& inputs.environment == ''"
    ),
    "unlock.yml": "github.event_name == 'workflow_dispatch' && inputs.verb == 'unlock'",
}
# Same degrade posture and reason as PIN_UNREADABLE.
ROUTING_UNREADABLE = (
    NOTICE,
    f"could not read `{_WORKFLOWS_DIR}` — the workflow file's event routing not verified.",
)
ROUTING_NO_COMMIT = (
    NOTICE,
    "the workflow file's event routing not verified — the commit under examination could "
    "not be determined.",
)


def _normalize_if(value):
    """An `if:` expression reduced to its comparable form: an enclosing pair of quotes
    dropped, then an enclosing `${{ }}` dropped, then every run of whitespace collapsed.

    Both wrappers are optional in GitHub's own syntax and the published files use neither,
    so a consumer who writes `if: ${{ ... }}` — the shape `docs/getting-started.md` shipped
    before this file existed — must not be reported for a difference that is not one.

    Only a MATCHING enclosing pair of quotes is dropped: five of the seven expressions end
    in a `'`, and stripping quote characters off both ends would mangle every one of them
    on both sides of the comparison, which stays green while the message is wrong."""
    v = value.strip()
    if len(v) > 1 and v[0] == v[-1] and v[0] in "\"'":
        v = v[1:-1].strip()
    if v.startswith("${{") and v.endswith("}}"):
        v = v[3:-2]
    return " ".join(v.split())


def _routing_finding(text, name):
    """One finding per `ROUTING_IFS` entry the file does not satisfy."""
    out = []
    stripped = _stripped_text(text)
    for callee, expected in ROUTING_IFS.items():
        pattern = re.compile(rf"/\.github/workflows/{re.escape(callee)}@")
        count = len(pattern.findall(stripped))
        if count != 1:
            out.append(
                (
                    WARNING,
                    f"`{name}` has {count} jobs calling the engine's `{callee}` — exactly one "
                    "does, selected by the `if:` that routes its event. With none, the verb or "
                    "event it serves reaches nothing and its run completes with every job "
                    "skipped, which reads as success everywhere; with more than one, either "
                    "the work runs twice or one of them is unreachable "
                    "(docs/getting-started.md).",
                )
            )
            continue
        found = _job_key(_call_region(text, pattern), "if")
        if found is None:
            out.append(
                (
                    WARNING,
                    f"`{name}`'s job calling the engine's `{callee}` declares no `if:` — it "
                    "then runs on every one of this file's triggers, so a `push` starts a plan "
                    f"and an `issue_comment` starts an apply. Add `if: {expected}` "
                    "(docs/getting-started.md).",
                )
            )
        elif _normalize_if(found) != _normalize_if(expected):
            out.append(
                (
                    WARNING,
                    f"`{name}`'s job calling the engine's `{callee}` is selected by "
                    f"`{_normalize_if(found)}`, not `{_normalize_if(expected)}` — a wrong "
                    "expression routes a verb nowhere and its dispatched run completes with "
                    "every job skipped, which reads as success everywhere "
                    "(docs/getting-started.md).",
                )
            )
    return out


def _routing_warnings(ctx):
    """One file gates seven jobs on the event, and a wrong gate is silent in both directions:
    a dispatched verb whose job never runs completes green with nothing done, and a job whose
    `if:` is too wide runs on an event it was never meant to see.

    Nothing else observes this. `actions/dispatch` sees an accepted dispatch; the run page
    shows six skipped jobs beside the one that ran, which is what a healthy run also shows.

    Reads the consumer's workflow files at the commit under examination, the same way and for
    the same reason as the pin, fork-trigger, shim-job-name and dispatch probes
    (`_contents_ref`): a pull request that FIXES an expression must not still be reported."""
    ref = _contents_ref(ctx)
    if ref is None:
        return [ROUTING_NO_COMMIT]

    def finding(text, name):
        if name != "shipmate.yml":
            return []
        return _routing_finding(text, name)

    return _scan_workflow_texts(ctx, ref, finding, ROUTING_UNREADABLE)


def _one_line(s, limit=200):
    flat = " ".join(s.split())
    return flat if len(flat) <= limit else flat[: limit - 1] + "…"


def _team_warnings(ctx):
    """A typo'd or cross-org SHIPMATE_APPROVERS_TEAM surfaces today only as
    every apply being rejected "not a team member" — one API call names it."""
    if not ctx["team"]:
        return []
    try:
        team = _gh_json(f"orgs/{ctx['owner']}/teams/{ctx['team']}")
        resolved = isinstance(team, dict) and bool(team.get("slug"))
    except (Exception, SystemExit):  # noqa: BLE001 - a failed lookup IS the finding
        resolved = False
    if resolved:
        return []
    return [
        (
            WARNING,
            f"approvers team `{ctx['team']}` does not resolve in org `{ctx['owner']}` — "
            'every `shipmate apply` will be rejected as "not a team member". Check the '
            "SHIPMATE_APPROVERS_TEAM variable and that the App has members:read.",
        )
    ]


def _app_permission_warnings(ctx):
    """The comment path attempts an installation-token mint requesting every
    permission app/manifest.json declares. A failed mint is not a definitive
    signal -- it usually means the installation is missing a permission
    (typical after a manifest bump nobody re-approved), but a transient API
    error or rate limit produces the exact same failed-mint outcome, so the
    finding is worded as a hedge rather than a claim. Skipped where no such
    attempt was made."""
    if not ctx["app_permissions_checked"] or not ctx["app_permission_error"]:
        return []
    return [
        (
            WARNING,
            f"{_one_line(ctx['app_permission_error'])}, which usually means the shipmate App "
            "installation is missing a permission the manifest declares — re-accept the App's "
            "permission request in the installation settings (or retry if the API was "
            "transiently failing).",
        )
    ]


PROBES = (
    _gate_rule_warnings,
    _review_rule_warnings,
    _environment_warnings,
    _env_protection_warnings,
    _engine_environment_warnings,
    _plan_env_secret_warnings,
    _pin_warnings,
    _fork_trigger_warnings,
    _shim_job_name_warnings,
    _plan_run_id_warnings,
    _mode_input_warnings,
    _dispatch_wiring_warnings,
    _routing_warnings,
    _team_warnings,
    _app_permission_warnings,
)


def _probe_label(probe):
    """Reader-facing name of a probe, from its function name: `_pin_warnings`
    -> "pin". Used by the degrade note below so a reader learns which probe was
    skipped instead of being shown the `gh api` call that failed."""
    return probe.__name__.strip("_").removesuffix("_warnings").replace("_", " ")


def _degrade_reason(e):
    """The failure reason, safe in a comment body or an annotation. Strips
    `bm.gh_json`'s `::error::...: gh api <path>` wrapper -- the workflow-command
    prefix would nest inside `::warning ...::` in annotate mode, and the
    endpoint is an internal detail no reader can act on."""
    return _one_line(str(e).removeprefix("::error::").split(": gh api ")[0], 120)


def warnings(ctx):
    out = []
    for probe in PROBES:
        try:
            out.extend(probe(ctx))
        # noqa: BLE001 - doctor must never fail the run. `bm.gh_json` raises
        # SystemExit, not a plain Exception, so both are caught -- but never
        # bare BaseException, so KeyboardInterrupt still propagates.
        except (Exception, SystemExit) as e:  # noqa: BLE001
            out.append(
                (
                    WARNING,
                    f"doctor could not verify the {_probe_label(probe)} settings "
                    f"({_degrade_reason(e)}) — probe skipped.",
                )
            )
    return out


def _gha_escape(s):
    """GHA workflow-command data escaping (percent first, or it double-escapes)."""
    return s.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")


def render_annotations(findings):
    return [f"::{lvl} title={DOCTOR_TITLE}::{_gha_escape(text)}" for lvl, text in findings]


def _declared_envs(cells_dir):
    """Skip a cell.json that can't be read/parsed or lacks a usable
    "environment" rather than raising: a truncated file is plausible after a
    partial `gh run download`, and doctor must never fail a run over one bad
    file. A non-string or empty value is dropped too -- it would otherwise run
    every environment probe against a name that cannot exist."""
    envs = set()
    # Recursive: a single matching artifact is extracted without its
    # per-artifact directory (see scripts/pending-checks), so both layouts
    # occur.
    for cj in cells_dir.glob("**/cell.json"):
        try:
            env = json.loads(cj.read_text(encoding="utf-8"))["environment"]
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if isinstance(env, str) and env:
            envs.add(env)
    return envs


def ctx_from_env():
    repo = os.environ["GITHUB_REPOSITORY"]
    cells = pathlib.Path(os.environ.get("SHIPMATE_CELLS_DIR", "cells"))
    envs = _declared_envs(cells)
    return {
        "repo": repo,
        "owner": repo.split("/")[0],
        "app_id": os.environ["SHIPMATE_APP_ID"],
        "default_branch": os.environ["SHIPMATE_DEFAULT_BRANCH"],
        "envs": envs,
        "envs_available": bool(envs),
        "team": os.environ.get("SHIPMATE_TEAM") or None,
        "app_permissions_checked": os.environ.get("SHIPMATE_APP_PERMISSIONS_CHECKED") == "true",
        "app_permission_error": os.environ.get("SHIPMATE_APP_PERMISSION_ERROR", ""),
        "head_sha": os.environ.get("SHIPMATE_HEAD_SHA", ""),
        # github.action_repository: the owner/repo of the running action, i.e.
        # the engine's own slug, resolved by GitHub at runtime. Empty when the
        # action runs from a local path instead of a pinned slug.
        "engine_repo": os.environ.get("SHIPMATE_ENGINE_REPO", ""),
        # A set, not one id: each cell's plan run comes from that cell's own
        # apply check, so one head's cells can come from several plan runs.
        "plan_run_ids": os.environ.get("SHIPMATE_PLAN_RUN_IDS", "").split(),
        "annotations_dir": os.environ.get("SHIPMATE_ANNOTATIONS_DIR", "ann"),
        "check_ids_path": os.environ.get("SHIPMATE_CHECK_IDS", "check-ids.tsv"),
        "harvest_failed": os.environ.get("SHIPMATE_HARVEST_FAILED") == "true",
        "harvest_pending": os.environ.get("SHIPMATE_HARVEST_PENDING") == "true",
    }


def _parse_check_run(line, app_id):
    """A single check-runs JSONL line -> its run dict, or None when the line
    is blank, unparseable, not a JSON object, or not authored by a
    shipmate-relevant app -- never raises, so one bad line can't take down
    the whole report."""
    line = line.strip()
    if not line:
        return None
    try:
        run = json.loads(line)
    except ValueError:
        return None
    if not isinstance(run, dict):
        return None
    if run.get("app_slug") not in _HARVEST_APP_SLUGS and not (
        app_id and str(run.get("app_id")) == str(app_id)
    ):
        return None
    return run


def latest_check_ids(lines, app_id=""):
    """[(id, name)] -- newest run per check name among shipmate-relevant
    authors, App-authored rows outside the `apply / ` namespace excluded.
    Ranks by `started_at`, not check-run `id` (unlike
    apply-gate.latest_by_name): a queued run has no `started_at` and no
    annotations to harvest, so ranking it BELOW a completed run is wanted."""
    newest = {}
    for line in lines:
        run = _parse_check_run(line, app_id)
        if run is None:
            continue
        name = run.get("name") or ""
        # An on-demand plan's mirrored cell checks share a name with the autoplan's
        # annotation-bearing ones and are created later, so ranking them together loses the
        # annotations: the mirror carries none. Only the apply checks are wanted from the App.
        if run.get("app_slug") not in _HARVEST_APP_SLUGS and not name.startswith(ag.APPLY_PREFIX):
            continue
        prev = newest.get(name)
        if prev is None or (run.get("started_at") or "") >= (prev.get("started_at") or ""):
            newest[name] = run
    out = []
    for name in sorted(newest):
        try:
            out.append((int(newest[name]["id"]), name))
        except (KeyError, TypeError, ValueError):
            continue
    return out


def harvest_pending(lines, app_id=""):
    """True when any shipmate-relevant check run on this commit has not
    completed.

    Keyed on the WHOLE relevant set, not the subset `latest_check_ids` selects:
    that ranking pushes a queued run below a completed one of the same name,
    which would hide exactly the case this flag exists to report."""
    for line in lines:
        run = _parse_check_run(line, app_id)
        if run is not None and run.get("status") != "completed":
            return True
    return False


def _write_step_output(name, value):
    """Append `name=<bool>` to the calling action step's GITHUB_OUTPUT. Silently
    skipped when GITHUB_OUTPUT is unset, so every mode stays runnable outside a
    runner."""
    path = os.environ.get("GITHUB_OUTPUT")
    if not path:
        return
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(f"{name}={'true' if value else 'false'}\n")


def load_annotations(ctx):
    """Join `ann/<id>.json` payloads onto the check names in check-ids.tsv.
    A missing or unreadable payload is skipped, never fatal."""
    ids_path = pathlib.Path(ctx["check_ids_path"])
    if not ids_path.exists():
        return []
    out = []
    for line in ids_path.read_text(encoding="utf-8").splitlines():
        if "\t" not in line:
            continue
        cid, name = line.split("\t", 1)
        payload = pathlib.Path(ctx["annotations_dir"]) / f"{cid.strip()}.json"
        try:
            # A `[]` payload is indistinguishable from the gather step's `echo '[]'` fallback for
            # a failed fetch, so the incomplete harvest has to be signalled out of band, via
            # ctx["harvest_failed"], and cannot be inferred from the payloads.
            rows = json.loads(payload.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        for row in rows if isinstance(rows, list) else []:
            if not isinstance(row, dict):
                continue
            row["check_name"] = name.strip()
            out.append(row)
    return out


def harvest_sections(annotations):
    """Group harvested annotations by check name.

    Drops notices, and drops the plan path's own doctor annotations: the live
    probes in this same report re-state those findings, so keeping both
    double-reports every settings problem. Every other title is kept.
    """
    by_check = {}
    for a in annotations:
        level = a.get("annotation_level")
        if level not in HARVEST_LEVELS:
            continue
        if a.get("title") == DOCTOR_TITLE:
            continue
        by_check.setdefault(a.get("check_name") or "(unnamed check)", []).append(a)
    return by_check


def _provenance(ctx):
    """The report's preamble: what was examined, and NOTHING about what the
    probes did with it.

    Environment-probe coverage is stated only by `_environment_warnings`, keyed
    on `envs_available`, because the two signals can disagree: the id set names
    the plan runs this head's apply checks recorded, whether or not their cell
    summaries could then be downloaded, so a non-empty set is no evidence that
    any environment was probed. A preamble keyed on it would claim a coverage
    the probes never had."""
    head = ctx["head_sha"][:7] or "(unknown commit)"
    runs = ctx["plan_run_ids"]
    if runs:
        named = _one_line(", ".join(runs), 120)
        plural = "s" if len(runs) > 1 else ""
        return f"_Commit `{head}`; cell summaries from plan run{plural} {named}._"
    return f"_Commit `{head}`; no plan records on this commit's apply checks._"


def _all_clear_line(ctx):
    """The settings-probe all-clear, stating what it actually covers.

    All three environment probes see only the environments of the stacks this
    pull request changed, so a categorical "no problems found" OVERCLAIMS: a
    `prod-eu` holding the App key is invisible to a report on a dev-only pull
    request. Name the set instead.

    Env names are repository data, so escaped and length-bounded: this line
    renders in both report paths and neither truncates it."""
    envs = sorted(ctx.get("envs") or ())
    if not envs:
        return (
            "- :white_check_mark: no problems found by the settings probes — and no "
            "environments were probed, since no declared environment set was available "
            "for this commit."
        )
    named = _one_line(", ".join(f"`{_md_escape(e)}`" for e in envs), 400)
    return (
        "- :white_check_mark: no problems found by the settings probes. The environment "
        "probes covered only the environments of the stacks changed in this pull request: "
        f"{named}."
    )


def _truncated_checks(annotations):
    """Check names whose warning/failure annotations hit GitHub's per-level
    cap (10 per level per step) on the raw, pre-filter listing -- computed
    here rather than on the already-filtered harvest_sections output, since
    dropping notices and DOCTOR_TITLE rows first would both under- and
    over-count the real GitHub-side truncation."""
    counts = {}
    for a in annotations:
        level = a.get("annotation_level")
        if level not in HARVEST_LEVELS:
            continue
        key = (a.get("check_name") or "(unnamed check)", level)
        counts[key] = counts.get(key, 0) + 1
    return {name for (name, _level), n in counts.items() if n >= ANNOTATION_CAP}


def _render_annotation_row(a):
    emoji = ":x:" if a.get("annotation_level") == "failure" else ":warning:"
    title = _md_escape(_one_line(a.get("title") or "", 120))
    msg = _md_escape(_one_line(a.get("message") or "", 300))
    return f"  - {emoji} {title} — {msg}" if title else f"  - {emoji} {msg}"


def _emit_section(lines, name, rows, used, budget):
    """Append one check's header + as many of its rows as fit in the
    remaining budget. The header is emitted only when at least its first row
    also fits -- otherwise it would dangle with no children.
    Returns (new_used, rows_added, rows_dropped)."""
    if not rows:
        return used, 0, 0  # rendered[0] below would IndexError
    header = f"- **{_md_escape(_one_line(name, 120))}**"
    rendered = [_render_annotation_row(a) for a in rows]
    if used + len(header) + 1 + len(rendered[0]) + 1 > budget:
        return used, 0, len(rows)
    lines.append(header)
    used += len(header) + 1
    added, dropped = 0, 0
    for row in rendered:
        if used + len(row) + 1 <= budget:
            lines.append(row)
            used += len(row) + 1
            added += 1
        else:
            dropped += 1
    return used, added, dropped


def _harvest_lines(sections, annotations, budget):
    """Render harvest rows within `budget` chars. Truncatable, unlike the
    settings-probe section: dropped rows stay recoverable from the run logs.
    Returns (lines, dropped_count)."""
    truncated_checks = _truncated_checks(annotations)
    lines, used, dropped, over = [], 0, 0, False
    any_truncated = False
    for name in sorted(sections):
        rows = sections[name]
        if name in truncated_checks:
            any_truncated = True
        if over:
            dropped += len(rows)
            continue
        used, added, section_dropped = _emit_section(lines, name, rows, used, budget)
        if added == 0 or section_dropped:
            over = True
        dropped += section_dropped
    if any_truncated:
        lines.append(
            "- _GitHub keeps at most 10 annotations per level per step, so this list "
            "may be truncated — see the run logs for the full set._"
        )
    return lines, dropped


def _findings_lines(findings, budget):
    """Render settings-probe finding rows within `budget` chars. Returns
    (lines, dropped_count) -- the last-ditch fallback path (render_report,
    when even the harvest-less body still exceeds sc.HARD_CAP)."""
    lines, used, dropped = [], 0, 0
    for lvl, text in findings:
        line = _finding_row(lvl, text)
        if used + len(line) + 1 <= budget:
            lines.append(line)
            used += len(line) + 1
        else:
            dropped += 1
    return lines, dropped


def _report_head(ctx):
    """Shared by both render paths -- the marker is this comment's identity (the
    upsert PATCHes by it), so neither path can drift out of marker compliance."""
    return [
        DOCTOR_MARKER,
        "### shipmate doctor",
        "",
        _provenance(ctx),
        "",
        "#### repository settings",
        "",
    ]


def _finding_row(lvl, text):
    """One settings-probe finding as a list row.

    Escaped because a finding interpolates repository data (a file name, a team
    slug, an API error): an unescaped `<!-- shipmate:summary -->` in one would
    make actions/summary's marker upsert PATCH this comment with the plan
    comment's body."""
    return f"- {_LEVEL_EMOJI[lvl]} {_md_escape(text)}"


def _findings_only_report(findings, ctx):
    """Last-ditch fallback: a body still over sc.HARD_CAP with the harvest
    already excluded means the findings themselves are unexpectedly large.
    Hard-truncates them with a count, so the comment still posts rather than
    the whole POST failing with a 422."""
    head = _report_head(ctx)
    # 200 chars of headroom for the omitted-count line appended below.
    budget = max(0, sc.HARD_CAP - len("\n".join(head)) - 200)
    if findings:
        lines, dropped = _findings_lines(findings, budget)
    else:
        lines, dropped = [_all_clear_line(ctx)], 0
    if dropped:
        lines.append(
            f"- _{dropped} more finding(s) omitted to keep this comment within the size "
            "limit — see the workflow run for the full list._"
        )
    return "\n".join(head + lines)


def _harvest_body(sections, annotations, budget, harvest_failed, harvest_pending):
    """The harvest's rendered rows, plus a note for each of the two ways the
    harvest can fall short of "these are the warnings on this commit".

    Both notes are ADDITIVE to the rows, never alternatives: an incomplete
    harvest can still have warnings to show, and emitting the note only when
    there is nothing would let a partial harvest read as the complete set. A
    pending harvest is the same hazard one step earlier, so it suppresses the
    all-clear too while staying a separate statement."""
    lines = []
    if sections:
        lines, dropped = _harvest_lines(sections, annotations, budget)
        if dropped:
            lines.append(
                f"- _{dropped} more warning(s) omitted to keep this comment within the "
                "size limit — see the run logs for the full set._"
            )
    elif not harvest_failed and not harvest_pending:
        lines = [":white_check_mark: no warnings on this commit's workflow runs."]
    if harvest_pending:
        lines.append(HARVEST_PENDING)
    if harvest_failed:
        lines.append(HARVEST_INCOMPLETE)
    return lines


def render_report(findings, annotations, ctx):
    out = _report_head(ctx)
    if findings:
        out += [_finding_row(lvl, text) for lvl, text in findings]
    else:
        out.append(_all_clear_line(ctx))
    heading = ["", "#### warnings from this commit's workflow runs", ""]
    sections = harvest_sections(annotations)
    # The settings-probe section above is never truncated -- it is the part a
    # stale comment can't recover from the run logs -- so the harvest gets
    # whatever's left of sc.SIZE_BUDGET, not a fixed share.
    budget = max(0, sc.SIZE_BUDGET - len("\n".join(out)) - len("\n".join(heading)))
    lines = _harvest_body(
        sections,
        annotations,
        budget,
        bool(ctx.get("harvest_failed")),
        bool(ctx.get("harvest_pending")),
    )
    body = "\n".join(out + heading + lines)
    if len(body) > sc.HARD_CAP:
        # The harvest section is already budgeted against sc.SIZE_BUDGET above, so overflow this
        # large can only come from the settings-probe findings themselves — degrade those too
        # rather than let the comment-ops render step's `gh api ... -F body=@doctor.md` 422.
        body = _findings_only_report(findings, ctx)
    return body


def main():
    mode = os.environ.get("SHIPMATE_DOCTOR_MODE", "")
    if mode not in MODES:
        raise SystemExit(f"SHIPMATE_DOCTOR_MODE must be one of {', '.join(MODES)} (got: {mode!r})")
    if mode == "check-ids":
        app_id = os.environ.get("SHIPMATE_APP_ID", "")
        lines = sys.stdin.read().splitlines()
        for cid, name in latest_check_ids(lines, app_id):
            print(f"{cid}\t{name}")
        # A step output, NOT stdout: stdout is the (id, name) TSV
        # load_annotations parses, and an extra field would land in a check name.
        _write_step_output("harvest_pending", harvest_pending(lines, app_id))
        return
    ctx = ctx_from_env()
    found = warnings(ctx)
    if mode == "annotate":
        for line in render_annotations(found):
            print(line)
        return
    print(render_report(found, load_annotations(ctx), ctx))


if __name__ == "__main__":
    main()
    sys.exit(0)
