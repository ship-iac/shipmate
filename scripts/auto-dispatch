#!/usr/bin/env python3
"""Decide whether a plan run's summary dispatches an `auto` apply, and print the environments
that call for one.

Prints, space-separated on one line, the `apply_mode: auto` environments of the default branch's
table that hold a changed cell among this run's cell summaries (`cells/`); prints nothing when
any condition below fails, writing why to stderr. The summary dispatches `verb: auto` when the
line is non-empty. The plan comment shows `action_reason`'s reason verbatim, so each one reads
as a sentence to the pull request's reader; the other reasons are log-only. Conditions, all
from the environment:

- `GITHUB_EVENT_NAME` is `pull_request_target`: only an autoplan dispatches.
- the `action` of the event payload at `GITHUB_EVENT_PATH` is `opened` or `synchronize`: only
  a push authorizes its pusher, never a ready-for-review or reopen click; an unreadable
  payload dispatches nothing.
- `GITHUB_RUN_ATTEMPT` is `1`: a re-run never starts a second `auto` run for the same head.
- `SHIPMATE_IS_DRAFT` is not `true`.
- gate-state's `SHIPMATE_GATE_STATE` and `SHIPMATE_COMMENT_MODE` are `pending` and `post`: the
  plan published completely and nothing holds the gate, and an apply check is pending.

The auto environments come from `SHIPMATE_AUTO_ENVS_TABLE`, build-matrix's `auto_envs` output
(a JSON list of names); a missing or malformed value exits 1 with `::error::`.
"""

import json
import os
import sys

from _shipmate import _load, cell_summaries, event_action, run_annotated

ag = _load("apply-gate")

_KEYS = ("stack", "environment", "changed")
_SKEW = (
    "-- plan-cell and the summary job must run the same engine revision; re-pin every engine "
    "reference to one commit"
)


_ACTION_REASONS = {
    "ready_for_review": "this plan was started by marking the pull request ready, not by a push",
    "reopened": "this plan was started by reopening the pull request, not by a push",
    "": "this plan's event could not be read",
}


def action_reason(action):
    """Why an autoplan started by the event action `action` dispatches no `auto` apply on any
    attempt, or None for a push."""
    if action in ag.PUSH_ACTIONS:
        return None
    return _ACTION_REASONS.get(
        action, f"this plan was started by the `{action}` event, not by a push"
    )


def skip_reason(*, event, action, attempt, is_draft, state, mode):
    """Why this run dispatches no `auto` apply, or None when every condition holds."""
    if event != "pull_request_target":
        return f"a {event or '(unset event)'} run is not an autoplan"
    if reason := action_reason(action):
        return reason
    if attempt != "1":
        return f"run attempt {attempt} is a re-run"
    if is_draft == "true":
        return "the pull request is a draft"
    if (state, mode) != ("pending", "post"):
        return f"the gate is not pending over a complete plan (state {state!r}, mode {mode!r})"
    return None


def changed_auto_envs(cells, auto):
    """The sorted environments in `auto` holding a changed cell of `cells`."""
    return sorted({c["environment"] for c in cells if c["changed"]} & set(auto))


def auto_set(raw):
    """build-matrix's `auto_envs` output `raw`, a JSON list of environment names, or None when it
    is not that shape."""
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        return None
    if isinstance(value, list) and all(isinstance(e, str) for e in value):
        return value
    return None


def main():
    reason = skip_reason(
        event=os.environ.get("GITHUB_EVENT_NAME", ""),
        action=event_action(),
        attempt=os.environ.get("GITHUB_RUN_ATTEMPT", ""),
        is_draft=os.environ.get("SHIPMATE_IS_DRAFT", ""),
        state=os.environ.get("SHIPMATE_GATE_STATE", ""),
        mode=os.environ.get("SHIPMATE_COMMENT_MODE", ""),
    )
    if reason:
        print(f"no auto apply dispatched: {reason}", file=sys.stderr)
        return
    cells = [
        c for _, c in cell_summaries(os.environ.get("SHIPMATE_CELLS_DIR", "cells"), _KEYS, _SKEW)
    ]
    auto = auto_set(os.environ.get("SHIPMATE_AUTO_ENVS_TABLE", ""))
    if auto is None:
        raise SystemExit(
            "::error::SHIPMATE_AUTO_ENVS_TABLE is not a JSON list of environment names"
        )
    envs = changed_auto_envs(cells, auto)
    if not envs:
        print(
            "no auto apply dispatched: no changed cell is in an apply_mode auto environment",
            file=sys.stderr,
        )
        return
    print(" ".join(envs))


if __name__ == "__main__":
    run_annotated(main)
