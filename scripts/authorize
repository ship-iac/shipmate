#!/usr/bin/env python3
"""Decide whether a `shipmate apply` comment is authorized to dispatch.

Pure decision from already-fetched GitHub API JSON. Checks run in fail-fast
order and each returns a DISTINCT, actionable reason (the reject comment). The
'comment head SHA == plan run SHA' rule is enforced here: the reviewed plan is
looked up by the PR's current head, so a plan for an older head (or none at all)
means new commits landed since the last plan -> stale -> re-plan. Review policy
is delegated to the branch ruleset via GitHub's `reviewDecision`, not re-derived
here.
"""

import json
import os


def decide(*, is_member, approvers_team, review_decision, pr, plan_run):
    """Return (authorized, reason). reason is '' when authorized."""
    if not is_member:
        return False, (
            f"not authorized: the commenter is not a member of the "
            f"required approvers team `{approvers_team}`."
        )
    if not pr.get("mergeable"):
        state = pr.get("mergeable_state", "unknown")
        if state in ("", "unknown"):
            # GitHub computes mergeability asynchronously; null/unknown means
            # "not computed yet", NOT a real conflict — don't misattribute.
            return False, (
                "GitHub is still computing this PR's mergeability; "
                "wait a moment and re-run `shipmate apply`."
            )
        return False, (
            f"PR is not mergeable (state: {state}); resolve conflicts "
            f"or branch-protection requirements first."
        )
    if review_decision == "REVIEW_REQUIRED":
        return False, (
            "not authorized: PR review is required by the branch ruleset and "
            "has not been satisfied; obtain the required approving review(s), "
            "then re-run `shipmate apply`."
        )
    if review_decision == "CHANGES_REQUESTED":
        return False, (
            "not authorized: changes were requested on this PR; resolve the "
            "review and get an approval, then re-run `shipmate apply`."
        )
    if not plan_run:
        return False, (
            "no reviewed plan for the current PR head — no successful "
            "plan run to apply. Push or re-run plan, then re-plan."
        )
    if plan_run.get("head_sha") != pr["head"]["sha"]:
        return False, (
            f"stale: the latest reviewed plan is for {plan_run.get('head_sha')} "
            f"but the PR head is now {pr['head']['sha']}; re-plan "
            f"(push or `shipmate plan`) before applying."
        )
    return True, ""


def _read_json(var, default):
    path = os.environ.get(var, "")
    if not path or not os.path.exists(path):
        return default
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)


def main():
    pr = _read_json("PR_JSON", {})
    plan_run = _read_json("PLAN_RUN_JSON", {})
    is_member = os.environ.get("IS_MEMBER", "false") == "true"
    review_decision = os.environ.get("REVIEW_DECISION", "")
    ok, reason = decide(
        is_member=is_member,
        approvers_team=os.environ.get("APPROVERS_TEAM", ""),
        review_decision=review_decision,
        pr=pr,
        plan_run=plan_run,
    )
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"authorized={'true' if ok else 'false'}\n")
        fh.write(f"reason={reason}\n")
        fh.write(f"environment={os.environ.get('SHIPMATE_ENV', '')}\n")
        fh.write(f"plan_run_id={plan_run.get('id', '')}\n")
        fh.write(f"head_sha={pr.get('head', {}).get('sha', '')}\n")
    print(f"::notice title=authorize::authorized={ok} reason={reason or 'ok'}")


if __name__ == "__main__":
    main()
