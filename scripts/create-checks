#!/usr/bin/env python3
"""Create App-authored apply checks: `create-checks <sha>`.

Reads check-run bodies on stdin, one JSON object per line (blank lines skipped), and POSTs each
to `repos/<GITHUB_REPOSITORY>/check-runs` through `create_retried`, the body on gh's stdin.
Before each rate-limited retry it runs `gate-status refuse-newer <sha>`, so a newer run's hold
stops the loop with `NEWER` and a failed read exits 1. A transient failure is not retried: a POST
that landed and still failed would create a duplicate check. `GH_TOKEN`, `GITHUB_REPOSITORY`,
`GITHUB_RUN_ID` and `SHIPMATE_APP_SLUG` come from the environment.

Fails closed, because the gate's work queue is the pending checks: the first body that still
fails stops the loop with run's `command failed (1): gh api ...` line and gh's own error line;
exit 1. A `<sha>` that is not 40 lowercase hex characters is refused before any API call.
"""

import functools
import os
import sys

from _shipmate import _load, create_retried, run, run_annotated, validate_head_sha

gs = _load("gate-status")


def main(argv):
    if len(argv) != 1:
        raise SystemExit(f"::error::usage: create-checks <sha> (bodies on stdin; got {argv})")
    sha = argv[0]
    validate_head_sha(sha, "head SHA")
    args = ["gh", "api", f"repos/{os.environ['GITHUB_REPOSITORY']}/check-runs", "--input", "-"]
    for body in [line.strip() for line in sys.stdin if line.strip()]:
        create_retried(
            functools.partial(run, args, stdin=body), before_retry=lambda: gs._refuse_newer(sha)
        )


if __name__ == "__main__":
    run_annotated(main, sys.argv[1:])
