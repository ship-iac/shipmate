#!/usr/bin/env python3
"""Build the sticky plan comment: a verdict line, then per environment a heading and its cells.

Reads the plan matrix jobs' auto check-runs (named `plan / <env> / <stack>`) as JSON
Lines on stdin (as emitted by `gh api --paginate ... --jq '.check_runs[]'`) and
cell summaries plus rendered plan text from the $CELLS directory (cell-summary.*
artifacts). Writes comment.md, plus pending, count, unmanaged, lost, missing and stacked_hold
to GITHUB_OUTPUT; `missing` is a JSON list of the `{stack, environment}` planned cells with no
cell summary, empty unless detect succeeded and `planned-cell-names` is a valid list.
`stacked_hold` is the pending gate text (`stacked_hold`) for a holder `SHIPMATE_STACKED` lists
and `SHIPMATE_DEFAULT_BRANCH` to retarget it to; gate-state writes it, and empty keeps the
generic text.

With `SHIPMATE_COMMENT_MODE=held` it writes the held comment (`held_comment`) to held.md instead,
reads no cell summary, only the `cell-error.json` files under $CELL_ERRORS (default
`cell-errors`), and writes nothing to GITHUB_OUTPUT; any other non-empty value refuses. The mode is
read in `main`, so loading this module stays free of side effects.

GitHub rejects issue-comment bodies over 65,536 characters. SIZE_BUDGET
leaves headroom below that cap; each changed cell's fold-out degrades
full plan -> truncated plan -> its bare line, never dropping the cell line's check link.
A truncated plan links the pull request's Checks tab, where the cell's apply check holds up
to 65,535 bytes of the plan.
A fold-out shows OpenTofu's `Objects have changed outside of OpenTofu` note as one counted line
(`fold_drift`); plan.txt and every other reader of it keep the full note.
Plan text is emitted only inside a backtick fence computed to be longer than
any backtick run in the text, so author-controlled plan output cannot escape
the fence (the comment-body injection surface).

The shared comment frame (`CIRCLES`, `worst`, `link`, `cell_line`, `env_heading`, `env_names`,
`by_env`, `header`, `provenance`, `footer`, `footer_hint`, `tally`, `_join`) lives here
because apply-comment and doctor already load this module.

`FOOTER_HINT` points at the comment commands, which have no other pull-request-visible surface
unless `command_hints` is on, and shows only where the reader has something to do: under a
refusal or a failure, under an apply or doctor verdict that is not 🟢. A plan comment carries it
only when the gate is held.
With `command_hints: true` in the table, a plan comment with a changed cell on a pull request
that is not a draft ends with the `commands` section, when the body has room for it under
SIZE_BUDGET; it never shrinks a cell. The section names `shipmate apply <env>` for each
`apply_mode: targeted` environment holding a changed cell, in apply order, then `shipmate apply`
when a changed cell sits outside every targeted environment (`to apply the other environments`
after a targeted line, since a bare apply waits on the targeted environments it needs), then
`shipmate unlock <env> --evict` for each environment holding a changed cell it marks locked, and
`shipmate help`. An empty or unreadable `targeted-envs` names no targeted environment, so the
section degrades to the bare `shipmate apply` even when every changed environment is targeted;
the unreadable one warns.

An autoplan of a pull request that is not a draft, not started by a push, that changed a cell of
an `apply_mode: auto` environment no other pull request locks says so in a line under the verdict
(`auto_line`), whatever `command_hints` is:
auto-dispatch's `action_reason` and its remedy.

A commanded plan (`SHIPMATE_ON_DEMAND` is `true`) names, directly under the verdict, each earlier
autoplan run of the head whose `plan / ` checks still read failed or cancelled
(`superseded_lines`): only checks of the head's `pull_request_target` runs of `PLAN_WORKFLOW`
(`autoplan_runs`) count, read before the newest-per-name collapse, so an App mirror of the same
name cannot hide one. A failed listing renders no line, with one warning.
"""

import collections
import glob
import html
import itertools
import json
import os
import pathlib
import re
import sys

from _shipmate import (
    CHECK_OUTPUT_CAP,
    REASON_CAP,
    _load,
    _run,
    cell_names,
    cell_summaries,
    command_data,
    current_run_url,
    event_action,
    is_head_sha,
    lock_who,
    run_annotated,
    write_outputs,
)

ad = _load("auto-dispatch")
ag = _load("apply-gate")

MARKER = "<!-- shipmate:summary -->"
# Phrased so the line does not itself match the comment grammar (`^shipmate <verb>`), which
# would make the comment a command. It names no doctor output, so no comment carrying it gains a
# coupling to doctor; the module docstring says where the hint shows.
FOOTER_HINT = "Comment `shipmate help` for the available commands."
SIZE_BUDGET = 60_000
HARD_CAP = 65_536
MIN_PLAN_CHARS = 500
#: Twice this is well below `HARD_CAP - SIZE_BUDGET`, so the unmanaged stacks and lost pairs
#: lines never eat the headroom.
UNMANAGED_LINE_CAP = 1000
#: build-matrix's own `UNMANAGED_NAMES`: the `unmanaged` and `lost` outputs carry at most this
#: many names. Kept equal by `test_the_two_unmanaged_name_caps_are_equal`.
UNMANAGED_NAMES = 10
CELL_KEYS = ("stack", "environment", "changed")

# A plan line's change sign, possibly indented: `+`, `-`, `~`, or the
# replace forms `-/+` / `+/-`. The sign moves to column 0 (GitHub's diff
# highlighting keys on the first character) and `~` becomes `!` (orange).
_SIGN = re.compile(r"^( *)(-/\+|\+/-|[-+~])")

# A heredoc opener (`<<EOT` / `<<-EOT`), capturing the terminator word.
# Anchored to end-of-line (tofu renders openers there) so a `<<WORD` inside a
# quoted single-line value cannot suppress diff mapping for the rest of a plan.
_HEREDOC_OPEN = re.compile(r"<<-?([A-Za-z_][A-Za-z0-9_]*)\s*$")


def diff_map(text):
    """Rewrite plan lines so change signs land at column 0 for ```diff
    coloring. The captured indent moves behind the sign, preserving width.

    Heredoc-aware: a heredoc's literal body (e.g. cloud-init YAML embedded in
    a `user_data = <<-EOT` value) can itself start with `-`/`~`/`+` — those
    are content, not plan diff markers. Once an opener line is seen, sign
    mapping is suspended until the line that closes it (its `strip()`, with
    any trailing `,` also stripped, equal to the terminator word), then
    resumes. The opener line itself is still sign-mapped — it is a real
    change line.
    """

    def repl(m):
        sign = "!" if m[2] == "~" else m[2]
        return sign + m[1]

    out = []
    terminator = None
    for line in text.splitlines():
        if terminator is not None:
            out.append(line)
            if line.strip().rstrip(",") == terminator:
                terminator = None
            continue
        out.append(_SIGN.sub(repl, line))
        opener = _HEREDOC_OPEN.search(line)
        if opener:
            terminator = opener[1]
    return "\n".join(out)


def _fence_of(text):
    """A backtick fence strictly longer than any backtick run in `text`
    (min 3) — fence-escape is the only comment-injection vector for content
    rendered inside a code fence."""
    longest = max((len(m) for m in re.findall(r"`+", text)), default=0)
    return "`" * max(3, longest + 1)


def fence(text, f, lang="diff"):
    """Wrap `text` in the backtick fence `f`, which the caller sizes with `_fence_of`.
    `lang` is the fence's language token (`diff` by default, for the plan-diff coloring
    below); pass `lang=""` for a plain, language-less fence."""
    return f"{f}{lang}\n{text}\n{f}"


def emoji(cell):
    """🟢 no changes / 🟡 changes. Deliberately two-state: a destroy count
    also covers ordinary replacements, so red on it renders healthy plans as
    broken. Magnitude is the cell line's own counts."""
    return "🟡" if cell["changed"] else "🟢"


_ENTITY_START = re.compile(r"&(?=#|\w+;)")


def _md_escape(s):
    """Neutralize structure characters in author-controlled display names (a stack path is
    chosen by the pull request author) for the contexts they appear in: a bare cell line, a
    fold-out's `<summary>`, and a doctor list row. `<`/`>` are escaped so a name like
    `x</summary><b>` cannot close the `<summary>` / `<details>` elements a fold-out is built
    from. `[`/`]` are escaped so a name like `[approve this deploy](https://evil)` cannot form a
    live markdown link inside the trusted bot comment. Newlines become spaces so a name cannot
    start a line of its own. `|` stays: no comment renders a name in a table, and a name cannot
    form a table's delimiter row because every line it sits on starts with engine text. An `&`
    that starts an entity reference becomes `&amp;`, first, so a name holding `&#91;` cannot
    render as `[`; any other `&` stays, so a doctor row's backticked `&&` reads as written.
    Every entity reads as its character outside a code span; inside one (a doctor row's
    backticked environment name) it shows as written."""
    return (
        _ENTITY_START.sub("&amp;", s)
        .replace("\r", " ")
        .replace("\n", " ")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace("[", "&#91;")
        .replace("]", "&#93;")
    )


def _md_name(s):
    """`_md_escape(s)` with each `@` followed by an empty HTML comment, for a stack or
    environment name outside a code span, so a name cannot mention a user or team: `&#64;`
    still renders a mention (GitHub markdown API, 2026-10-12); an empty HTML comment after `@`
    does not. Inside a code span the comment would show as written."""
    return _md_escape(s).replace("@", "@<!-- -->")


#: Every circle a comment uses, worst first.
CIRCLES = ("🔴", "🟠", "🟡", "⚪", "🟢")


def worst(circles):
    """The worst of `circles` by `CIRCLES` order, or 🟢 when there are none."""
    return min(circles, key=CIRCLES.index, default=CIRCLES[-1])


def link(url, text):
    """`<a href="url">text</a>`. Raw HTML because a Markdown link renders literally inside
    `<summary>`. `url` must come from the GitHub API or the run context, never from pull
    request content; it is attribute-escaped all the same. `text` is a fixed word."""
    return f'<a href="{html.escape(url, quote=True)}">{text}</a>'


def cell_line(circle, stack, env, state, url=None, text=""):
    """`<circle> <stack> (<env>): <state>`, without ` (<env>)` when `env` is None (a line under
    its environment's `env_heading`), then a space and `link(url, text)` unless `url` is None.
    `stack` and `env` are `_md_name`d here; `state` is the caller's and must already be safe (a
    blocked reason is escaped by its caller)."""
    where = "" if env is None else f" ({_md_name(env)})"
    line = f"{circle} {_md_name(stack)}{where}: {state}"
    return line if url is None else f"{line} {link(url, text)}"


def env_heading(env, n, tally):
    """`#### <env>: 1 cell, <tally>` or `#### <env>: N cells, <tally>`: the line above an
    environment's cell lines, `env` `_md_name`d."""
    return f"#### {_md_name(env)}: {n} cell{'' if n == 1 else 's'}, {tally}"


#: `env_names`' consequence for an unreadable `env-order`, in every comment that reads it.
ENV_ORDER_UNREAD = "the comment orders its environments by name"


def env_names(raw, label, unread):
    """The environments of `raw`, a JSON list of strings (detect's `env_order`, `auto_envs` or
    `targeted_envs` output); `[]` when empty, and `[]` with one warning naming the input `label`
    and the consequence `unread` when it is not that shape."""
    if not raw:
        return []
    names = ad.auto_set(raw)
    if names is None:
        print(f"::warning::{label} is not a JSON list of environment names; {unread}")
        return []
    return names


def by_env(items, order, first, cell=lambda item: item):
    """`[(env, items)]`: `items` grouped by `cell(item)["environment"]`, the environments `order`
    names in its order, then the rest by name; in each, the items `first` holds for, then the
    others, each sorted by stack."""
    groups = {}
    for item in items:
        groups.setdefault(cell(item)["environment"], []).append(item)
    envs = [e for e in dict.fromkeys(order) if e in groups]
    envs += sorted(set(groups) - set(envs))

    def key(item):
        return not first(cell(item)), cell(item)["stack"]

    return [(env, sorted(groups[env], key=key)) for env in envs]


def header(verb, env=""):
    """`### shipmate <verb> <env>`, `### shipmate <verb>` without `env`, and `### shipmate`
    without `verb` whatever `env` is (a comment that did not parse, or named no known verb).
    Both words are `_md_escape`d."""
    if not verb:
        return "### shipmate"
    return " ".join(["### shipmate", *(_md_escape(w) for w in (verb, env) if w)])


def provenance(sha, run_url):
    """A verdict's ending: `at [<first 7 chars>](<commit url>) in [run #<n>](<run_url>)` for a
    40-char lowercase hex SHA, `at an unknown commit in [run #<n>](<run_url>)` otherwise. The
    verdict is display, so an unreadable SHA never costs the comment. Reads the runner's
    `GITHUB_SERVER_URL`, `GITHUB_REPOSITORY` and `GITHUB_RUN_NUMBER`."""
    run = f"in [run #{os.environ['GITHUB_RUN_NUMBER']}]({run_url})"
    if not is_head_sha(sha):
        return f"at an unknown commit {run}"
    commit = f"{os.environ['GITHUB_SERVER_URL']}/{os.environ['GITHUB_REPOSITORY']}/commit/{sha}"
    return f"at [{sha[:7]}]({commit}) {run}"


def footer(run_url, hint=True):
    """`[comment run](<run_url>)`, then `. ` and `FOOTER_HINT` when `hint`: the footer of a
    comment whose verdict carries no `provenance`. `hint` is off for the help reply, which is the
    command list, and for a notice, which asks nothing of the reader."""
    return f"[comment run]({run_url}). {FOOTER_HINT}" if hint else f"[comment run]({run_url})"


def footer_hint(circle):
    """The footer of an apply or doctor comment, whose verdict line carries `provenance`:
    `FOOTER_HINT` unless the verdict's `circle` is 🟢, else empty."""
    return "" if circle == "🟢" else FOOTER_HINT


def check_url(cell, checks, run_url):
    """Link target for a cell: the latest `plan / <env> / <stack-path>` plan-job check run.

    Name is built FORWARD from the cell's (stack, environment) — the CONTRACT check-name
    grammar; never parsed back. Falls back to the workflow-run URL when the name is absent
    (a consumer file whose plan-calling job is not named `plan`).
    """
    run = checks.get(ag.plan_check_name(cell["stack"], cell["environment"]))
    return run["html_url"] if run and run.get("html_url") else run_url


def tally(add, change, destroy, imported=0, forgotten=0):
    """`+a ~c -d`, then `, N import` and `, N forget` for a count above zero: the counts text of
    a plan and an apply cell line. Every count is an int."""
    out = f"+{add} ~{change} -{destroy}"
    for n, word in ((imported, "import"), (forgotten, "forget")):
        if n:
            out += f", {n} {word}"
    return out


def state(cell):
    """A plan cell's state text: `no changes` for an unchanged cell; for a changed one its
    `tally`, or `+? ~? -?` when `load_cells` could not derive the counts."""
    if not cell["changed"]:
        return "no changes"
    if cell["add"] == "?":
        return "+? ~? -?"
    return tally(*(cell[k] for k in ("add", "change", "destroy", "import", "forget")))


def _lock_key(cell, locks):
    """`cell`'s `<stack> / <env>` key in `locks` when it is changed and another pull request
    holds it, else None."""
    key = f"{cell['stack']} / {cell['environment']}"
    return key if cell["changed"] and key in locks else None


def _plan_line(cell, url, locks, stacked=frozenset(), default_branch=""):
    """A cell's bare line; a changed cell another pull request holds ends with `🔒 locked by`
    and `lock_who` of its holder in `locks` (`cell-lock marks`' `<stack> / <env>` keys). When
    that holder is in `stacked` and `default_branch` is not empty, the line goes on to say the
    holder is stacked on this pull request and to retarget it to `default_branch`."""
    line = cell_line(emoji(cell), cell["stack"], None, state(cell), url, "plan")
    if key := _lock_key(cell, locks):
        who = lock_who(locks[key])
        line += f" 🔒 locked by {who}"
        if locks[key] in stacked and default_branch:
            line += (
                ", which is stacked on this pull request; merging this pull request first makes "
                f"its deploy refuse the cells {who} holds. Retarget {who} to "
                f"{_md_name(default_branch)} and merge it first."
            )
    return line


def stacked_hold(cells, locks, stacked, default_branch):
    """The pending gate text for the lowest holder in `stacked` of a changed cell of `cells`,
    with the count of its changed locked cells; empty when there is none or `default_branch` is
    empty."""
    held = [locks[k] for c in cells if (k := _lock_key(c, locks)) and locks[k] in stacked]
    if not held or not default_branch:
        return ""
    holder = min(held)
    return (
        f"stacked #{holder} holds {held.count(holder)} cell(s); retarget it to {default_branch} "
        "and merge it first"
    )


def commands(locked, targeted=(), changed=()):
    """The folded command section: per environment of `changed` (the changed cells'
    environments in apply order) in `targeted`, its `shipmate apply <env>`; then `shipmate apply`
    unless `changed` is not empty and all in `targeted`, worded `to apply the other
    environments` after a targeted paragraph, since a bare apply waits on the targeted
    environments it needs; then per environment of `locked`, sorted, its `shipmate unlock <env>
    --evict`, then `shipmate help`. No line starts with `shipmate`, so the section is not itself
    a command."""
    named = "".join(
        f"Comment `shipmate apply {e}` to apply {_md_name(e)}.\n\n"
        for e in changed
        if e in targeted
    )
    bare = ""
    if not changed or not set(changed) <= set(targeted):
        what = "the other environments" if named else "this plan"
        bare = f"Comment `shipmate apply` to apply {what}.\n\n"
    evict = "".join(
        f"Comment `shipmate unlock {e} --evict` to take a cell another pull request holds.\n\n"
        for e in sorted(locked)
    )
    return (
        "<details><summary>shipmate commands</summary>\n\n"
        f"{named}{bare}{evict}"
        "Comment `shipmate help` for every command.\n\n"
        "</details>"
    )


AUTO_REMEDY = "push a commit, or comment `shipmate apply`."


def auto_line(cells, auto, locks, *, event, action, is_draft):
    """`⚪ auto apply not started: <reason>; ` and `AUTO_REMEDY` when this run is an autoplan of a
    pull request that is not a draft, its event action is not a push (`action_reason` names
    why, the same on every attempt), and a changed cell of `cells` in `auto` is not locked by
    another pull request (`locks`); else empty. A locked cell applies on no trigger, and an
    on-demand plan cannot tell whether an auto apply of the head is running."""
    if event != "pull_request_target" or is_draft == "true":
        return ""
    reason = ad.action_reason(action)
    if not reason:
        return ""
    if not ad.changed_auto_envs([c for c in cells if not _lock_key(c, locks)], auto):
        return ""
    return f"⚪ auto apply not started: {reason}; {AUTO_REMEDY}"


_JOB_RUN = re.compile(r"/actions/runs/(\d+)/job/\d+$")
SUPERSEDED_LINE = (
    "⚪ {} check(s) from autoplan run [#{}]({}) still read failed or cancelled on this head; "
    "this run's plan supersedes them, and GitHub keeps them until the next push plans a new head."
)


def superseded_lines(rows, autoplan_ids, run_id):
    """One `SUPERSEDED_LINE` per earlier autoplan run, ascending run id, counting its checks in
    the head's check-run `rows` that still read `failure` or `cancelled`. A row counts when the
    run id in its Actions job `html_url` is in `autoplan_ids` and is not `run_id` (a string), its
    name starts with `CALLER_PREFIX`, and it is the newest of its name among those rows. The
    selection runs before any newest-per-name collapse across identities: an App mirror of the
    same name carries no job URL and must not hide the failure it mirrors."""

    def run_of(row):
        m = _JOB_RUN.search(row.get("html_url") or "")
        return int(m[1]) if m else None

    autoplan = [r for r in rows if run_of(r) in autoplan_ids and str(run_of(r)) != run_id]
    counts = collections.Counter(
        run_of(r)
        for r in ag.latest_by_name(autoplan, prefix=ag.CALLER_PREFIX).values()
        if r.get("conclusion") in ("failure", "cancelled")
    )
    return [
        SUPERSEDED_LINE.format(n, r, current_run_url(str(r))) for r, n in sorted(counts.items())
    ]


def fold(line, body, limit, trailer, cut, lang="diff"):
    """Largest form of a section that fits in `limit` characters: fold-out of its bare `line`
    with the whole `body` -> fold-out with `cut(body, room)` and `trailer` -> `line`, which the
    caller has already reserved room for. `cut` returns whole lines of at most `room`
    characters, or "" when none fits. The cut body reuses the full body's fence, so a cut can
    never re-open the fence-escape hole."""
    f = _fence_of(body)
    head = f"<details><summary>{line}</summary>\n\n"
    full = f"{head}{fence(body, f, lang)}\n</details>"
    if len(full) <= limit:
        return full
    room = limit - len(head) - len(fence("", f, lang)) - len(trailer)
    if room >= MIN_PLAN_CHARS:
        kept = cut(body, room)
        if kept:
            return f"{head}{fence(kept, f, lang)}{trailer}"
    return line


def _head_lines(text, room):
    # When the first line alone exceeds `room`, `rfind` returns -1, so degrade to the bare
    # line instead of cutting mid-line.
    sliced = text[:room]
    return sliced[: sliced.rfind("\n")] if "\n" in sliced else ""


def checks_tab_url(pr):
    """The pull request's Checks tab, where each changed cell's apply check shows up to 65,535
    bytes of its plan.
    Reads the runner's `GITHUB_SERVER_URL` and `GITHUB_REPOSITORY`."""
    return f"{os.environ['GITHUB_SERVER_URL']}/{os.environ['GITHUB_REPOSITORY']}/pull/{pr}/checks"


def render_section(line, plan_text, limit):
    """`fold` of a cell's plan, truncated at the end with a link to the pull request's Checks tab
    (`checks_tab_url` of `SHIPMATE_PR_NUMBER`)."""
    # A limit under MIN_PLAN_CHARS means this cell's budget is spent, so keep the bare line and
    # its check link rather than inline whatever small plan happens to fit.
    if plan_text is None or limit < MIN_PLAN_CHARS:
        return line
    url = checks_tab_url(ag.env_pr_number())
    trailer = f"\n\n_Truncated; see the cell's apply check in [the Checks tab]({url})._\n</details>"
    return fold(line, diff_map(plan_text), limit, trailer, _head_lines)


def verdict(cells, head_sha, run_url):
    """The line under the header: `⚪ nothing planned` for zero cells, `🟢 no changes` when no
    cell changes, else `🟡 N of M cells change`, then `provenance`. It reads the cells only:
    every failed plan job holds the gate, and a held gate posts `held_comment` instead."""
    if not cells:
        return f"⚪ nothing planned {provenance(head_sha, run_url)}"
    circle = worst(emoji(c) for c in cells)
    if circle == "🟢":
        return f"🟢 no changes {provenance(head_sha, run_url)}"
    n = sum(1 for c in cells if c["changed"])
    return f"{circle} {n} of {len(cells)} cells change {provenance(head_sha, run_url)}"


#: The most cell lines the held comment names before it counts the rest.
HELD_CELL_NAMES = 10
#: The cell error file is an artifact, and an all-backtick error of n characters renders as about
#: 3n (a fence of n + 1 backticks on each side), so the read side cuts too: ten errors at
#: `REASON_CAP` would pass HARD_CAP.
CELL_ERROR_CAP = 1000


def reason_fence(text, cap=REASON_CAP):
    """`text` cut to `cap` characters in a plain fence sized by `_fence_of`, so
    author-controlled text such as a stack path shows verbatim, where `_md_name`'s mention guard
    would show as written."""
    text = text[:cap]
    return fence(text, _fence_of(text), lang="")


def held_comment(reason, missing, checks, run_url, head_sha, errors=None, attempt=""):
    """The comment of a held gate: marker, header, `🔴 the gate is held` and `provenance`, then
    `reason` (the gate description before its 140-character cut, at most `REASON_CAP`
    characters) in a plain fence, then one line per cell of `missing` (`{stack, environment}`
    pairs) linking its plan check, then `FOOTER_HINT`. At most `HELD_CELL_NAMES` cell lines,
    then a count. The fence shows `reason` verbatim: it can name author-controlled stack paths,
    and `_md_name`'s mention guard would show as written inside a fence. A cell's state is `no
    plan summary read`: its plan matrix job did not succeed or the summary download failed. A
    cell's entry in `errors` (`cell_errors`), `(error, recorded attempt)`, follows its line when
    the error is not empty: `recorded by attempt <n> of this run` when `<n>` is set and is not
    `attempt`, this run's attempt, then the error in a plain fence cut at `CELL_ERROR_CAP`."""
    errors = errors or {}
    parts = [
        f"{MARKER}\n{header('plan')}",
        f"🔴 the gate is held {provenance(head_sha, run_url)}",
        reason_fence(reason),
    ]
    if missing:
        lines = []
        for c in missing[:HELD_CELL_NAMES]:
            url = check_url(c, checks, run_url)
            lines.append(
                cell_line("🔴", c["stack"], c["environment"], "no plan summary read", url, "plan")
            )
            error, recorded = errors.get((c["stack"], c["environment"]), ("", ""))
            if error:
                if recorded and recorded != attempt:
                    lines.append(f"recorded by attempt {_md_escape(recorded)} of this run")
                lines.append(reason_fence(error, CELL_ERROR_CAP))
        if len(missing) > HELD_CELL_NAMES:
            more = len(missing) - HELD_CELL_NAMES
            lines.append(f"and {more} more cells have no plan summary")
        parts.append("\n".join(lines))
    parts.append(FOOTER_HINT)
    return "\n\n".join(parts)


UNMANAGED_LEAD = (
    "⚪ {} changed stack(s) carry neither an env/* tag nor shipmate/local and are not "
    "managed by shipmate"
)
LOST_LEAD = (
    "⚪ {} stack / environment pair(s) lost their env/* tag in this pull request and are no "
    "longer planned or deployed"
)


def names_line(value, key, lead):
    """`lead` with its count, then the first names of build-matrix's `{"count": N, key: [...]}`
    output (at most `UNMANAGED_NAMES` by `_named_output`'s shape check) that fit in
    `UNMANAGED_LINE_CAP` characters, then `, and M more` for the other `count - named`. Each
    name is `_md_name`d. When not even the first fits, a fixed sentence names none. Empty for
    `None` or a zero count."""
    if not value or not value["count"]:
        return ""
    count = value["count"]
    lead = lead.format(count)
    line, names = "", []
    for name in value[key]:
        names.append(_md_name(name))
        more = count - len(names)
        candidate = f"{lead}: {', '.join(names)}" + (f", and {more} more" if more else "")
        if len(candidate) > UNMANAGED_LINE_CAP:
            break
        line = candidate
    return line or f"{lead}; their {key} are too long to list here."


def doctor_line(warnings, run_url):
    """The line naming `warnings` doctor warnings with a link to the run their annotations are
    on; empty when there are none."""
    if not warnings:
        return ""
    return (
        f"⚠️ shipmate doctor found {warnings} warning(s) beyond repository settings in this run: "
        f"see [the run]({run_url})"
    )


_BLOCKS = ("<details>", "#### ")


def _join(sections):
    """One newline between consecutive bare lines, a blank line on both sides of a fold-out or
    an `env_heading`: without the blank line after `</details>`, the next line stays inside the
    HTML block and its link renders literally."""
    out = sections[:1]
    for prev, cur in itertools.pairwise(sections):
        fold = prev.startswith(_BLOCKS) or cur.startswith(_BLOCKS)
        out.append("\n\n" if fold else "\n")
        out.append(cur)
    return "".join(out)


def _entries(cells, order, checks, run_url, locks, stacked, default_branch):
    """`(bare line, cell, plan text)` per heading and cell, in comment order; a heading has no
    cell."""
    entries = []
    for env, group in by_env(cells, order, lambda c: c["changed"], cell=lambda ct: ct[0]):
        n = sum(1 for c, _ in group if c["changed"])
        entries.append((env_heading(env, len(group), f"{n} changed"), None, None))
        for c, text in group:
            line = _plan_line(c, check_url(c, checks, run_url), locks, stacked, default_branch)
            entries.append((line, c, text))
    return entries


def build_comment(
    cells,
    checks,
    run_url,
    head_sha,
    unmanaged=None,
    lost=None,
    warnings=0,
    order=(),
    hints=False,
    locks=None,
    auto="",
    stacked=frozenset(),
    default_branch="",
    targeted=(),
    superseded=(),
):
    """Assemble the comment under SIZE_BUDGET: marker, header, verdict, the `superseded_lines`
    `superseded` as one block, the `auto_line` `auto`, `doctor_line` of `warnings`, the
    unmanaged paths line of `unmanaged` and the lost pairs line of `lost` when each count is not
    zero, then per environment in `by_env` order of `order` its
    `env_heading` (`N cells, M change`) and its cells, changed first (a fold-out for a changed
    cell with plan text, else its bare line, which names no environment). No footer: the verdict
    links the run, and neither plan verdict asks anything. With `hints`, a body with a changed
    cell ends with `commands` when the whole body stays within SIZE_BUDGET, and leaves it out
    silently otherwise, after every cell is sized, so it never shrinks one. `locks`
    (`lock_marks`) marks the changed cells another pull request holds, and `commands` names their
    environments, and the changed environments of `targeted` in `order`; `stacked` and
    `default_branch` go to `_plan_line`. Every cell is guaranteed its bare line: the space all
    headings and remaining cells' bare lines need is reserved up front, so an early giant plan
    cannot starve a later cell. Each of the five blocks yields, with a warning, when the headings
    and bare lines leave it no room under HARD_CAP. Returns
    `(body, unmanaged_named, lost_named)`, each flag saying whether that line is in `body`."""
    meta = [c for c, _ in cells]
    head = f"{MARKER}\n{header('plan')}\n\n{verdict(meta, head_sha, run_url)}"
    locks = locks or {}
    entries = _entries(cells, order, checks, run_url, locks, stacked, default_branch)
    bares = [e[0] for e in entries]
    named = {}
    for line, what in (
        ("\n".join(superseded), "superseded autoplan checks"),
        (auto, "auto apply not started"),
        (doctor_line(warnings, run_url), "shipmate doctor warnings"),
        (names_line(unmanaged, "paths", UNMANAGED_LEAD), "unmanaged stacks"),
        (names_line(lost, "pairs", LOST_LEAD), "lost stack / environment pairs"),
    ):
        # The smallest body with the line; past HARD_CAP it goes, so the refusal below keeps
        # its one cause. In `head`, the line is counted in `used` before any fold-out is sized.
        if line and len("\n\n".join(p for p in (head, line, _join(bares)) if p)) > HARD_CAP:
            print(
                "::warning::the plan comment's cell lines leave no room under the 65,536-char "
                f"comment cap for the {what} line; it was left out"
            )
            line = ""
        if line:
            head = f"{head}\n\n{line}"
        named[what] = bool(line)
    used = len(head) + 4
    reserve = sum(len(b) + 2 for b in bares)
    sections = []
    for bare, c, text in entries:
        reserve -= len(bare) + 2
        section = bare
        if c is not None and c["changed"]:
            section = render_section(bare, text, SIZE_BUDGET - used - reserve - 2)
        sections.append(section)
        used += len(section) + 2
    body = "\n\n".join(p for p in (head, _join(sections)) if p)
    envs = {c["environment"] for c in meta if c["changed"]}
    changed = [e for e in dict.fromkeys(order) if e in envs] + sorted(envs - set(order))
    section = commands({c["environment"] for c in meta if _lock_key(c, locks)}, targeted, changed)
    if hints and any(c["changed"] for c in meta) and len(body) + 2 + len(section) <= SIZE_BUDGET:
        body = f"{body}\n\n{section}"
    # Past SIZE_BUDGET every cell is already its bare line, the smallest body there is.
    # Stack/env display names are author-controlled, so fail loud rather than let GitHub 422
    # the POST on an oversized body.
    if len(body) > HARD_CAP:
        raise SystemExit(
            "::error::the plan comment's cell lines alone exceed the 65,536-char comment "
            "cap, shorten stack/env display names"
        )
    return body, named["unmanaged stacks"], named["lost stack / environment pairs"]


_STR_KEYS = ("stack", "environment")
_TALLY = re.compile(
    r"Plan: (?:(?P<import>\d+) to import, )?(?P<add>\d+) to add, (?P<change>\d+) to change, "
    r"(?P<destroy>\d+) to destroy(?:, (?P<forget>\d+) to forget)?\."
)
_ZERO_COUNT = ("No changes.", "You can apply this plan to save these new output values")


def counts(path):
    """(add, change, destroy, import, forget) from the `tofu show` text at `path`: its one
    column-0 `Plan:` tally line, where tofu omits a zero import or forget count (0 here), or all
    zeros when it has none and has a line starting with the no-changes or outputs-only sentence.
    None for a missing file, no recognised line, or two tally lines.
    Author text (heredoc bodies, multi-line outputs) renders indented, so only column 0 counts.
    The whole file is read: the tally sits at the end, past the SIZE_BUDGET cap on the rendered
    text."""
    if not path.exists():
        return None
    hits, zero = [], False
    # tofu prints a CR from author text raw; default newline handling would end a line there
    # and put the text after it at column 0.
    with open(path, encoding="utf-8", newline="\n") as fh:
        for line in fh:
            line = line.rstrip("\r\n")
            if m := _TALLY.fullmatch(line):
                hits.append(m)
            zero = zero or line.startswith(_ZERO_COUNT)
    if len(hits) == 1:
        return tuple(int(hits[0][k] or 0) for k in ("add", "change", "destroy", "import", "forget"))
    return (0, 0, 0, 0, 0) if not hits and zero else None


_DRIFT_NOTE = "Note: Objects have changed outside of OpenTofu"
_DRIFT_HEADER = re.compile(r"^  # .* has (changed|been deleted)$")
_DRIFT_LINE = (
    "ℹ️ {} object(s) changed outside OpenTofu; the full note is in this cell's apply check."
)


#: Bytes of the apply check's summary that its fence and truncation trailer take from the plan.
_CHECK_FRAME = 1024


def fold_drift(text):
    """`text` with OpenTofu's outside-changes note, from the note line to the first following
    line made only of `─`, replaced by one line counting the note's `has changed` and
    `has been deleted` headers. Unchanged unless the note line is the first non-empty line,
    where tofu prints it (author text, even split at a CR by the text-mode read, cannot reach
    it there), the rule line is complete (a cut read can stop inside it), and the text through
    the rule fits `CHECK_OUTPUT_CAP - _CHECK_FRAME` UTF-8 bytes, so the apply check the counted
    line names holds the whole note."""
    body = text.lstrip("\n")
    if not body.startswith(_DRIFT_NOTE + "\n"):
        return text
    lead = len(text) - len(body)
    lines = body.split("\n")
    n = 0
    # The last element is unterminated: a rule there may be cut mid-line.
    for end in range(1, len(lines) - 1):
        line = lines[end]
        if line and not line.strip("─"):
            note = "\n".join(lines[: end + 1]) + "\n"
            if lead + len(note.encode("utf-8")) > CHECK_OUTPUT_CAP - _CHECK_FRAME:
                return text
            return "\n".join([text[:lead] + _DRIFT_LINE.format(n), *lines[end + 1 :]])
        n += bool(_DRIFT_HEADER.match(line))
    return text


def _validate_cell(cell, path):
    """Type-check cell.json values past the missing-keys check. A
    pin-skewed/crafted cell.json can carry the right keys with the wrong
    types (e.g. `changed = "false"`, a truthy string that would mark a
    no-change cell pending)."""
    for k in _STR_KEYS:
        if type(cell[k]) is not str:
            raise SystemExit(f"::error::cell summary {path} key {k!r} must be a string")
    if type(cell["changed"]) is not bool:
        raise SystemExit(f"::error::cell summary {path} key 'changed' must be a bool")


def load_cells(cells_dir):
    """(cell, plan_text) per downloaded cell-summary artifact, sorted by
    (environment, stack). A cell.json missing schema keys, or carrying the
    right keys with the wrong types, fails loud — that is plan-cell/summary
    pin skew, not a state to render around. Each cell's `add`, `change`,
    `destroy`, `import` and `forget` are set here from `counts` over its
    `plan.txt`, whatever cell.json holds; underivable counts become "?" each,
    with one warning. `plan_text` is `fold_drift` of the file's first SIZE_BUDGET characters,
    topped up to SIZE_BUDGET when the fold shrank it; a fold that lengthens it leaves it over
    SIZE_BUDGET by that much."""
    out = []
    skew = "(plan-cell and summary must be pinned at the same engine SHA)"
    for p, cell in cell_summaries(cells_dir, CELL_KEYS, skew):
        _validate_cell(cell, p)
        txt = pathlib.Path(p).with_name("plan.txt")
        tally = counts(txt)
        if tally is None:
            name = f"{cell['stack']} / {cell['environment']}"
            print(
                f"::warning::plan text for {command_data(name)} has no single OpenTofu tally line; "
                "its counts render as ?"
            )
            tally = ("?",) * 5
        cell["add"], cell["change"], cell["destroy"], cell["import"], cell["forget"] = tally
        text = None
        if txt.exists():
            # A SIZE_BUDGET text exceeds every section limit, so a cut one renders truncated; the
            # top-up refills what `fold_drift` shrank (`max`: a negative size reads the whole file).
            with open(txt, encoding="utf-8") as fh:
                text = fold_drift(fh.read(SIZE_BUDGET))
                text += fh.read(max(0, SIZE_BUDGET - len(text)))
        out.append((cell, text))
    out.sort(key=lambda ct: (ct[0]["environment"], ct[0]["stack"]))
    return out


def missing_cells(planned, cells):
    """The `{stack, environment}` pairs of `planned` that no cell summary in `cells` names,
    sorted by (environment, stack): the cells whose plan this run never read."""
    read = {(c["stack"], c["environment"]) for c in cells}
    gone = [p for p in planned if (p["stack"], p["environment"]) not in read]
    return sorted(gone, key=lambda p: (p["environment"], p["stack"]))


def _missing(cells):
    """`missing_cells` of the `planned-cell-names` input, or none unless detect succeeded: a fmt
    or codegen failure still carries the full list. A value that is not a list of names warns."""
    raw = os.environ.get("SHIPMATE_PLANNED_CELLS_NAMES", "")
    planned = cell_names(raw) if raw else []
    if planned is None:
        print(
            "::warning::planned-cell-names is not a JSON list of {stack, environment} strings; "
            "the gate description and the plan comment name no cell"
        )
        planned = []
    if os.environ.get("SHIPMATE_DETECT_RESULT", "") != "success":
        return []
    return missing_cells(planned, cells)


def _named_output(raw, input_name, key, noun):
    """build-matrix's `{"count": N, key: [...]}` from the `input_name` input's `raw` value:
    `None` when empty, `None` with one warning when it is not that shape, with `N` a
    non-negative integer and exactly `min(N, UNMANAGED_NAMES)` strings under `key` (so a
    negative `N` fails too). `noun` names, in the warning, what the comment then omits."""
    if not raw:
        return None
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        value = None
    if isinstance(value, dict):
        count, names = value.get("count"), value.get(key)
        if (
            type(count) is int
            and isinstance(names, list)
            and all(isinstance(n, str) for n in names)
            and len(names) == min(count, UNMANAGED_NAMES)
        ):
            return value
    print(
        f'::warning::{input_name} is not a JSON object {{"count": N, "{key}": [strings]}} '
        f"naming min(N, {UNMANAGED_NAMES}) {key}; the plan comment names no {noun}"
    )
    return None


def lock_marks(raw):
    """`cell-lock marks`' `locks` output `raw`, `{"<stack> / <env>": holder}` with each holder
    an int or None: `{}` when empty (the marks step failed or was skipped), and `{}` with one
    warning when it is not that shape."""
    if not raw:
        return {}
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        value = None
    if isinstance(value, dict) and all(h is None or type(h) is int for h in value.values()):
        return value
    print("::warning::the cell locks are not a JSON map of holders; the plan comment marks none")
    return {}


def stacked_marks(raw):
    """`cell-lock marks`' `stacked` output `raw` as a frozenset of pull request numbers: empty
    when `raw` is empty, and empty with one warning when it is not a JSON list of ints."""
    if not raw:
        return frozenset()
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        value = None
    if isinstance(value, list) and all(type(h) is int for h in value):
        return frozenset(value)
    print(
        "::warning::the stacked lock holders are not a JSON list of pull request numbers; the "
        "plan comment names none as stacked"
    )
    return frozenset()


CELL_ERROR_KEYS = {"stack", "environment", "error", "attempt"}


def cell_errors(errors_dir):
    """`{(stack, environment): (error, attempt)}` from every `cell-error.json` under `errors_dir`,
    which plan-cell writes when an attempt of a cell fails, with the attempt that wrote it.
    Recursive, as `cell_summaries`. The errors are reviewer-facing only, so a file that is not a
    JSON object of exactly those four strings is skipped, with one warning."""
    out, bad = {}, False
    for p in sorted(glob.glob(os.path.join(errors_dir, "**", "cell-error.json"), recursive=True)):
        try:
            with open(p, encoding="utf-8") as fh:
                e = json.load(fh)
        except (OSError, ValueError):
            e = None
        if (
            isinstance(e, dict)
            and set(e) == CELL_ERROR_KEYS
            and all(type(v) is str for v in e.values())
        ):
            out[(e["stack"], e["environment"])] = (e["error"], e["attempt"])
        else:
            bad = True
    if bad:
        print(
            "::warning::a cell error file is not a JSON object of stack, environment, error and "
            "attempt strings; the held plan comment shows no error for its cell"
        )
    return out


def _superseded(rows):
    """`superseded_lines` of `rows` on a commanded plan (`SHIPMATE_ON_DEMAND` is `true`), else
    none. Reviewer-facing only: a failed or malformed `autoplan_runs` listing renders none, with
    one warning."""
    if os.environ.get("SHIPMATE_ON_DEMAND") != "true":
        return []
    head = os.environ.get("HEAD_SHA", "")
    try:
        runs = ag.autoplan_runs(os.environ["GITHUB_REPOSITORY"], head, run=_run)
    except (ValueError, SystemExit):
        print(
            f"::warning::could not list the autoplan runs of {head}; the plan comment names no "
            "superseded checks"
        )
        return []
    return superseded_lines(rows, {r["id"] for r in runs}, os.environ["GITHUB_RUN_ID"])


def _held_main(checks, url):
    body = held_comment(
        os.environ.get("SHIPMATE_HOLD_REASON", ""),
        cell_names(os.environ.get("SHIPMATE_MISSING", "")),
        checks,
        url,
        os.environ.get("HEAD_SHA", ""),
        cell_errors(os.environ.get("CELL_ERRORS", "cell-errors")),
        os.environ.get("GITHUB_RUN_ATTEMPT", ""),
    )
    with open("held.md", "w", encoding="utf-8") as fh:
        fh.write(body)


def main():
    mode = os.environ.get("SHIPMATE_COMMENT_MODE", "")
    if mode not in ("", "held"):
        raise SystemExit(f"::error::SHIPMATE_COMMENT_MODE must be empty or held (got: {mode!r})")
    # prefix="" gathers every check-run on the head SHA: plan checks, detect/summary, and earlier
    # runs' apply checks, since this run publishes its own after the comment. Plan check names
    # carry the calling job's `plan / ` prefix, so check_url's lookup is exact.
    rows = ag.parse_jsonl(sys.stdin)
    checks = ag.latest_by_name(rows, prefix="")
    # This job runs inside the plan run, so this run holds the logs and the
    # artifacts the verdict's run link and the per-cell fallback link promise.
    url = current_run_url()
    if mode == "held":
        _held_main(checks, url)
        return
    cells = load_cells(os.environ.get("CELLS", "cells"))
    unmanaged = _named_output(
        os.environ.get("SHIPMATE_UNMANAGED", ""), "unmanaged-stacks", "paths", "unmanaged stack"
    )
    lost = _named_output(
        os.environ.get("SHIPMATE_LOST_ENV_TAGS", ""),
        "lost-env-tags",
        "pairs",
        "lost stack / environment pair",
    )
    # Reviewer-facing only: anything but doctor's count renders no line.
    warnings = os.environ.get("SHIPMATE_DOCTOR_WARNINGS", "")
    auto = env_names(
        os.environ.get("SHIPMATE_AUTO_ENVS_TABLE", ""),
        "auto-envs",
        "the plan comment says nothing about an auto apply",
    )
    targeted = env_names(
        os.environ.get("SHIPMATE_TARGETED_ENVS", ""),
        "targeted-envs",
        "the commands section offers the bare shipmate apply",
    )
    locks = lock_marks(os.environ.get("SHIPMATE_LOCKS", ""))
    stacked = stacked_marks(os.environ.get("SHIPMATE_STACKED", ""))
    default_branch = os.environ.get("SHIPMATE_DEFAULT_BRANCH", "")
    body, named, lost_named = build_comment(
        cells,
        checks,
        url,
        os.environ.get("HEAD_SHA", ""),
        unmanaged,
        lost,
        int(warnings) if warnings.isdecimal() else 0,
        env_names(os.environ.get("SHIPMATE_ENV_ORDER", ""), "env-order", ENV_ORDER_UNREAD),
        # `shipmate apply` refuses a draft, so an on-demand plan of one must not invite it.
        hints=os.environ.get("SHIPMATE_COMMAND_HINTS") == "true"
        and os.environ.get("SHIPMATE_IS_DRAFT") != "true",
        locks=locks,
        auto=auto_line(
            [c for c, _ in cells],
            auto,
            locks,
            event=os.environ.get("GITHUB_EVENT_NAME", ""),
            action=event_action(),
            is_draft=os.environ.get("SHIPMATE_IS_DRAFT", ""),
        ),
        stacked=stacked,
        default_branch=default_branch,
        targeted=targeted,
        superseded=_superseded(rows),
    )
    with open("comment.md", "w", encoding="utf-8") as fh:
        fh.write(body)
    pending = any(c["changed"] for c, _ in cells)
    missing = _missing([c for c, _ in cells])
    write_outputs(
        pending=pending,
        count=len(cells),
        unmanaged=bool(named),
        lost=bool(lost_named),
        # `json.dumps` escapes CR and LF, so an author's stack path stays on this one line.
        missing=json.dumps(missing),
        stacked_hold=stacked_hold([c for c, _ in cells], locks, stacked, default_branch),
    )


if __name__ == "__main__":
    run_annotated(main)
