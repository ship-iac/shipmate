#!/usr/bin/env python3
"""Build the sticky plan comment: a verdict line, then one line or fold-out per cell.

Reads the plan matrix jobs' auto check-runs (named `shipmate / <stack> / <env>`) as JSON
Lines on stdin (as emitted by `gh api --paginate ... --jq '.check_runs[]'`) and
cell summaries plus rendered plan text from the $CELLS directory (cell-summary.*
artifacts). Writes comment.md, plus pending, count, unmanaged, lost and missing to
GITHUB_OUTPUT; `missing` is a JSON list of the `{stack, environment}` planned cells with no
cell summary, empty unless detect succeeded and `planned-cell-names` is a valid list.

With `SHIPMATE_COMMENT_MODE=held` it writes the held comment (`held_comment`) to held.md instead,
reads no cell summary and writes nothing to GITHUB_OUTPUT; any other non-empty value refuses. The
mode is read in `main`, so loading this module stays free of side effects.

GitHub rejects issue-comment bodies over 65,536 characters. SIZE_BUDGET
leaves headroom below that cap; each changed cell's fold-out degrades
full plan -> truncated plan -> its bare line, never dropping the check-run link.
Plan text is emitted only inside a backtick fence computed to be longer than
any backtick run in the text, so author-controlled plan output cannot escape
the fence (the comment-body injection surface).

The shared comment frame (`CIRCLES`, `worst`, `link`, `cell_line`, `header`, `provenance`,
`footer`, `footer_hint`, `tally`, `_join`) lives here because apply-comment and doctor already
load this module.

`FOOTER_HINT` points at the comment commands, which have no other pull-request-visible surface,
and shows only where the reader has something to do: under a refusal or a failure, under an
apply or doctor verdict that is not 🟢. A plan comment carries it only when the gate is held.
"""

import html
import itertools
import json
import os
import pathlib
import re
import sys

from _shipmate import (
    _load,
    cell_names,
    cell_summaries,
    command_data,
    current_run_url,
    is_head_sha,
    run_annotated,
    write_outputs,
)

ag = _load("apply-gate")

MARKER = "<!-- shipmate:summary -->"
# Phrased so the line does not itself match the comment grammar (`^shipmate <verb>`), which
# would make the comment a command. It names no doctor output, so no comment carrying it gains a
# coupling to doctor; the module docstring says where the hint shows.
FOOTER_HINT = "Comment `shipmate help` for the available commands."
SIZE_BUDGET = 60_000
HARD_CAP = 65_536
MIN_PLAN_CHARS = 500
#: Twice this is well below `HARD_CAP - SIZE_BUDGET`, so the unmanaged stacks and lost pairs
#: lines never eat the headroom.
UNMANAGED_LINE_CAP = 1000
#: build-matrix's own `UNMANAGED_NAMES`: the `unmanaged` and `lost` outputs carry at most this
#: many names. Kept equal by `test_the_two_unmanaged_name_caps_are_equal`.
UNMANAGED_NAMES = 10
CELL_KEYS = ("stack", "environment", "changed")

# A plan line's change sign, possibly indented: `+`, `-`, `~`, or the
# replace forms `-/+` / `+/-`. The sign moves to column 0 (GitHub's diff
# highlighting keys on the first character) and `~` becomes `!` (orange).
_SIGN = re.compile(r"^( *)(-/\+|\+/-|[-+~])")

# A heredoc opener (`<<EOT` / `<<-EOT`), capturing the terminator word.
# Anchored to end-of-line (tofu renders openers there) so a `<<WORD` inside a
# quoted single-line value cannot suppress diff mapping for the rest of a plan.
_HEREDOC_OPEN = re.compile(r"<<-?([A-Za-z_][A-Za-z0-9_]*)\s*$")


def diff_map(text):
    """Rewrite plan lines so change signs land at column 0 for ```diff
    coloring. The captured indent moves behind the sign, preserving width.

    Heredoc-aware: a heredoc's literal body (e.g. cloud-init YAML embedded in
    a `user_data = <<-EOT` value) can itself start with `-`/`~`/`+` — those
    are content, not plan diff markers. Once an opener line is seen, sign
    mapping is suspended until the line that closes it (its `strip()`, with
    any trailing `,` also stripped, equal to the terminator word), then
    resumes. The opener line itself is still sign-mapped — it is a real
    change line.
    """

    def repl(m):
        sign = "!" if m[2] == "~" else m[2]
        return sign + m[1]

    out = []
    terminator = None
    for line in text.splitlines():
        if terminator is not None:
            out.append(line)
            if line.strip().rstrip(",") == terminator:
                terminator = None
            continue
        out.append(_SIGN.sub(repl, line))
        opener = _HEREDOC_OPEN.search(line)
        if opener:
            terminator = opener[1]
    return "\n".join(out)


def _fence_of(text):
    """A backtick fence strictly longer than any backtick run in `text`
    (min 3) — fence-escape is the only comment-injection vector for content
    rendered inside a code fence."""
    longest = max((len(m) for m in re.findall(r"`+", text)), default=0)
    return "`" * max(3, longest + 1)


def fence(text, f, lang="diff"):
    """Wrap `text` in the backtick fence `f`, which the caller sizes with `_fence_of`.
    `lang` is the fence's language token (`diff` by default, for the plan-diff coloring
    below); pass `lang=""` for a plain, language-less fence."""
    return f"{f}{lang}\n{text}\n{f}"


def emoji(cell):
    """🟢 no changes / 🟡 changes. Deliberately two-state: a destroy count
    also covers ordinary replacements, so red on it renders healthy plans as
    broken. Magnitude is the cell line's own counts."""
    return "🟡" if cell["changed"] else "🟢"


_ENTITY_START = re.compile(r"&(?=#|\w+;)")


def _md_escape(s):
    """Neutralize structure characters in author-controlled display names (a stack path is
    chosen by the pull request author) for the contexts they appear in: a bare cell line, a
    fold-out's `<summary>`, and a doctor list row. `<`/`>` are escaped so a name like
    `x</summary><b>` cannot close the `<summary>` / `<details>` elements a fold-out is built
    from. `[`/`]` are escaped so a name like `[approve this deploy](https://evil)` cannot form a
    live markdown link inside the trusted bot comment. Newlines become spaces so a name cannot
    start a line of its own. `|` stays: no comment renders a name in a table, and a name cannot
    form a table's delimiter row because every line it sits on starts with engine text. An `&`
    that starts an entity reference becomes `&amp;`, first, so a name holding `&#91;` cannot
    render as `[`; any other `&` stays, so a doctor row's backticked `&&` reads as written.
    Every entity reads as its character outside a code span; inside one (a doctor row's
    backticked environment name) it shows as written."""
    return (
        _ENTITY_START.sub("&amp;", s)
        .replace("\r", " ")
        .replace("\n", " ")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace("[", "&#91;")
        .replace("]", "&#93;")
    )


def _md_name(s):
    """`_md_escape(s)` with each `@` followed by an empty HTML comment, for a stack or
    environment name outside a code span, so a name cannot mention a user or team: `&#64;`
    still renders a mention (GitHub markdown API, 2026-10-12); an empty HTML comment after `@`
    does not. Inside a code span the comment would show as written."""
    return _md_escape(s).replace("@", "@<!-- -->")


#: Every circle a comment uses, worst first.
CIRCLES = ("🔴", "🟠", "🟡", "⚪", "🟢")


def worst(circles):
    """The worst of `circles` by `CIRCLES` order, or 🟢 when there are none."""
    return min(circles, key=CIRCLES.index, default=CIRCLES[-1])


def link(url, text):
    """`<a href="url">text</a>`. Raw HTML because a Markdown link renders literally inside
    `<summary>`. `url` must come from the GitHub API or the run context, never from pull
    request content; it is attribute-escaped all the same. `text` is a fixed word."""
    return f'<a href="{html.escape(url, quote=True)}">{text}</a>'


def cell_line(circle, stack, env, state, url=None, text=""):
    """`<circle> <stack> (<env>): <state>`, then a space and `link(url, text)` unless `url` is
    None. `stack` and `env` are `_md_name`d here; `state` is the caller's and must already be
    safe (a blocked reason is escaped by its caller)."""
    line = f"{circle} {_md_name(stack)} ({_md_name(env)}): {state}"
    return line if url is None else f"{line} {link(url, text)}"


def header(verb, env=""):
    """`### shipmate <verb> <env>`, `### shipmate <verb>` without `env`, and `### shipmate`
    without `verb` whatever `env` is (a comment that did not parse, or named no known verb).
    Both words are `_md_escape`d."""
    if not verb:
        return "### shipmate"
    return " ".join(["### shipmate", *(_md_escape(w) for w in (verb, env) if w)])


def provenance(sha, run_url):
    """A verdict's ending: `at [<first 7 chars>](<commit url>) in [run #<n>](<run_url>)` for a
    40-char lowercase hex SHA, `at an unknown commit in [run #<n>](<run_url>)` otherwise. The
    verdict is display, so an unreadable SHA never costs the comment. Reads the runner's
    `GITHUB_SERVER_URL`, `GITHUB_REPOSITORY` and `GITHUB_RUN_NUMBER`."""
    run = f"in [run #{os.environ['GITHUB_RUN_NUMBER']}]({run_url})"
    if not is_head_sha(sha):
        return f"at an unknown commit {run}"
    commit = f"{os.environ['GITHUB_SERVER_URL']}/{os.environ['GITHUB_REPOSITORY']}/commit/{sha}"
    return f"at [{sha[:7]}]({commit}) {run}"


def footer(run_url, hint=True):
    """`[run](<run_url>)`, then `. ` and `FOOTER_HINT` when `hint`: the footer of a comment whose
    verdict carries no `provenance`. `hint` is off for the help reply, which is the command list,
    and for a notice, which asks nothing of the reader."""
    return f"[run]({run_url}). {FOOTER_HINT}" if hint else f"[run]({run_url})"


def footer_hint(circle):
    """The footer of an apply or doctor comment, whose verdict line carries `provenance`:
    `FOOTER_HINT` unless the verdict's `circle` is 🟢, else empty."""
    return "" if circle == "🟢" else FOOTER_HINT


def check_url(cell, checks, run_url):
    """Link target for a cell: the latest `shipmate / <stack-path> / <env>` plan-job check run.

    Name is built FORWARD from the cell's (stack, environment) — the CONTRACT check-name
    grammar; never parsed back. Falls back to the workflow-run URL when the name is absent
    (a consumer file whose plan-calling job is not named `shipmate`).
    """
    run = checks.get(f"{ag.CALLER_PREFIX}{cell['stack']} / {cell['environment']}")
    return run["html_url"] if run and run.get("html_url") else run_url


def tally(add, change, destroy, imported=0, forgotten=0):
    """`+a ~c -d`, then `, N import` and `, N forget` for a count above zero: the counts text of
    a plan and an apply cell line. Every count is an int."""
    out = f"+{add} ~{change} -{destroy}"
    for n, word in ((imported, "import"), (forgotten, "forget")):
        if n:
            out += f", {n} {word}"
    return out


def state(cell):
    """A plan cell's state text: `no changes` for an unchanged cell; for a changed one its
    `tally`, or `+? ~? -?` when `load_cells` could not derive the counts."""
    if not cell["changed"]:
        return "no changes"
    if cell["add"] == "?":
        return "+? ~? -?"
    return tally(*(cell[k] for k in ("add", "change", "destroy", "import", "forget")))


def _plan_line(cell, url):
    return cell_line(emoji(cell), cell["stack"], cell["environment"], state(cell), url, "plan")


def fold(line, body, limit, trailer, cut, lang="diff"):
    """Largest form of a section that fits in `limit` characters: fold-out of its bare `line`
    with the whole `body` -> fold-out with `cut(body, room)` and `trailer` -> `line`, which the
    caller has already reserved room for. `cut` returns whole lines of at most `room`
    characters, or "" when none fits. The cut body reuses the full body's fence, so a cut can
    never re-open the fence-escape hole."""
    f = _fence_of(body)
    head = f"<details><summary>{line}</summary>\n\n"
    full = f"{head}{fence(body, f, lang)}\n</details>"
    if len(full) <= limit:
        return full
    room = limit - len(head) - len(fence("", f, lang)) - len(trailer)
    if room >= MIN_PLAN_CHARS:
        kept = cut(body, room)
        if kept:
            return f"{head}{fence(kept, f, lang)}{trailer}"
    return line


def _head_lines(text, room):
    # When the first line alone exceeds `room`, `rfind` returns -1, so degrade to the bare
    # line instead of cutting mid-line.
    sliced = text[:room]
    return sliced[: sliced.rfind("\n")] if "\n" in sliced else ""


def render_section(line, plan_text, url, limit):
    """`fold` of a cell's plan, truncated at the end with a link to its check run."""
    # A limit under MIN_PLAN_CHARS means this cell's budget is spent, so link the check run
    # rather than inline whatever small plan happens to fit.
    if plan_text is None or limit < MIN_PLAN_CHARS:
        return line
    trailer = f"\n\n_Truncated, [full plan in the check run]({url})._\n</details>"
    return fold(line, diff_map(plan_text), limit, trailer, _head_lines)


def verdict(cells, head_sha, run_url):
    """The line under the header: `🟢 no changes` when no cell changes (zero cells included),
    else `🟡 N of M cells change`, then `provenance`. It reads the cells only: every failed
    plan job holds the gate, and a held gate posts `held_comment` instead."""
    circle = worst(emoji(c) for c in cells)
    if circle == "🟢":
        return f"🟢 no changes {provenance(head_sha, run_url)}"
    n = sum(1 for c in cells if c["changed"])
    return f"{circle} {n} of {len(cells)} cells change {provenance(head_sha, run_url)}"


#: The held comment's reason is cut here, so its body stays far under `HARD_CAP` with every cell
#: line it can carry.
HELD_REASON_CAP = 4000
#: The most cell lines the held comment names before it counts the rest.
HELD_CELL_NAMES = 10


def held_comment(reason, missing, checks, run_url, head_sha):
    """The comment of a held gate: marker, header, `🔴 the gate is held` and `provenance`, then
    `reason` (the gate description before its 140-character cut, at most `HELD_REASON_CAP`
    characters) in a plain fence, then one line per cell of `missing` (`{stack, environment}`
    pairs) linking its plan check, then `FOOTER_HINT`. At most `HELD_CELL_NAMES` cell lines,
    then a count. The fence shows `reason` verbatim: it can name author-controlled stack paths,
    and `_md_name`'s mention guard would show as written inside a fence. A cell's state is `no
    plan summary read`: its plan or its summary download failed, and the run cannot tell which."""
    reason = reason[:HELD_REASON_CAP]
    parts = [
        f"{MARKER}\n{header('plan')}",
        f"🔴 the gate is held {provenance(head_sha, run_url)}",
        fence(reason, _fence_of(reason), lang=""),
    ]
    if missing:
        lines = [
            cell_line(
                "🔴",
                c["stack"],
                c["environment"],
                "no plan summary read",
                check_url(c, checks, run_url),
                "plan",
            )
            for c in missing[:HELD_CELL_NAMES]
        ]
        if len(missing) > HELD_CELL_NAMES:
            more = len(missing) - HELD_CELL_NAMES
            lines.append(f"and {more} more cells have no plan summary")
        parts.append("\n".join(lines))
    parts.append(FOOTER_HINT)
    return "\n\n".join(parts)


UNMANAGED_LEAD = "⚪ {} changed stack(s) carry no env/* tag and are not managed by shipmate"
LOST_LEAD = (
    "⚪ {} stack / environment pair(s) lost their env/* tag in this pull request and are no "
    "longer planned or deployed"
)


def names_line(value, key, lead):
    """`lead` with its count, then the first names of build-matrix's `{"count": N, key: [...]}`
    output (at most `UNMANAGED_NAMES` by `_named_output`'s shape check) that fit in
    `UNMANAGED_LINE_CAP` characters, then `, and M more` for the other `count - named`. Each
    name is `_md_name`d. When not even the first fits, a fixed sentence names none. Empty for
    `None` or a zero count."""
    if not value or not value["count"]:
        return ""
    count = value["count"]
    lead = lead.format(count)
    line, names = "", []
    for name in value[key]:
        names.append(_md_name(name))
        more = count - len(names)
        candidate = f"{lead}: {', '.join(names)}" + (f", and {more} more" if more else "")
        if len(candidate) > UNMANAGED_LINE_CAP:
            break
        line = candidate
    return line or f"{lead}; their {key} are too long to list here."


def _join(sections):
    """One newline between consecutive bare lines, a blank line on both sides of a fold-out:
    without the blank line after `</details>`, the next line stays inside the HTML block and
    its link renders literally."""
    out = sections[:1]
    for prev, cur in itertools.pairwise(sections):
        fold = prev.startswith("<details>") or cur.startswith("<details>")
        out.append("\n\n" if fold else "\n")
        out.append(cur)
    return "".join(out)


def build_comment(cells, checks, run_url, head_sha, unmanaged=None, lost=None):
    """Assemble the comment under SIZE_BUDGET: marker, header, verdict, the unmanaged paths line of
    `unmanaged` and the lost pairs line of `lost` when each count is not zero, every cell in
    order (a fold-out for a changed cell with plan text, else its bare line). No footer: the
    verdict links the run, and neither plan verdict asks anything. Every cell is guaranteed its
    bare line: the space all remaining cells' bare lines need is reserved up front, so an early
    giant plan cannot starve a later cell. Each of the two lines yields, with a warning, when the
    bare lines leave it no room under HARD_CAP. Returns `(body, unmanaged_named, lost_named)`,
    each flag saying whether that line is in `body`."""
    meta = [c for c, _ in cells]
    head = f"{MARKER}\n{header('plan')}\n\n{verdict(meta, head_sha, run_url)}"
    urls = [check_url(c, checks, run_url) for c in meta]
    bares = [_plan_line(c, u) for c, u in zip(meta, urls, strict=True)]
    named = []
    for line, what in (
        (names_line(unmanaged, "paths", UNMANAGED_LEAD), "unmanaged stacks"),
        (names_line(lost, "pairs", LOST_LEAD), "lost stack / environment pairs"),
    ):
        # The smallest body with the line; past HARD_CAP it goes, so the refusal below keeps
        # its one cause. In `head`, the line is counted in `used` before any fold-out is sized.
        if line and len("\n\n".join(p for p in (head, line, "\n".join(bares)) if p)) > HARD_CAP:
            print(
                "::warning::the plan comment's cell lines leave no room under the 65,536-char "
                f"comment cap for the {what} line; it was left out"
            )
            line = ""
        if line:
            head = f"{head}\n\n{line}"
        named.append(bool(line))
    used = len(head) + 4
    reserve = sum(len(b) + 2 for b in bares)
    sections = []
    for (c, text), url, bare in zip(cells, urls, bares, strict=True):
        reserve -= len(bare) + 2
        section = bare
        if c["changed"]:
            section = render_section(bare, text, url, SIZE_BUDGET - used - reserve - 2)
        sections.append(section)
        used += len(section) + 2
    body = "\n\n".join(p for p in (head, _join(sections)) if p)
    # Past SIZE_BUDGET every cell is already its bare line, the smallest body there is.
    # Stack/env display names are author-controlled, so fail loud rather than let GitHub 422
    # the POST on an oversized body.
    if len(body) > HARD_CAP:
        raise SystemExit(
            "::error::the plan comment's cell lines alone exceed the 65,536-char comment "
            "cap, shorten stack/env display names"
        )
    return body, *named


_STR_KEYS = ("stack", "environment")
_TALLY = re.compile(
    r"Plan: (?:(?P<import>\d+) to import, )?(?P<add>\d+) to add, (?P<change>\d+) to change, "
    r"(?P<destroy>\d+) to destroy(?:, (?P<forget>\d+) to forget)?\."
)
_ZERO_COUNT = ("No changes.", "You can apply this plan to save these new output values")


def counts(path):
    """(add, change, destroy, import, forget) from the `tofu show` text at `path`: its one
    column-0 `Plan:` tally line, where tofu omits a zero import or forget count (0 here), or all
    zeros when it has none and has a line starting with the no-changes or outputs-only sentence.
    None for a missing file, no recognised line, or two tally lines.
    Author text (heredoc bodies, multi-line outputs) renders indented, so only column 0 counts.
    The whole file is read: the tally sits at the end, past the SIZE_BUDGET cap on the rendered
    text."""
    if not path.exists():
        return None
    hits, zero = [], False
    # tofu prints a CR from author text raw; default newline handling would end a line there
    # and put the text after it at column 0.
    with open(path, encoding="utf-8", newline="\n") as fh:
        for line in fh:
            line = line.rstrip("\r\n")
            if m := _TALLY.fullmatch(line):
                hits.append(m)
            zero = zero or line.startswith(_ZERO_COUNT)
    if len(hits) == 1:
        return tuple(int(hits[0][k] or 0) for k in ("add", "change", "destroy", "import", "forget"))
    return (0, 0, 0, 0, 0) if not hits and zero else None


def _validate_cell(cell, path):
    """Type-check cell.json values past the missing-keys check. A
    pin-skewed/crafted cell.json can carry the right keys with the wrong
    types (e.g. `changed = "false"`, a truthy string that would mark a
    no-change cell pending)."""
    for k in _STR_KEYS:
        if type(cell[k]) is not str:
            raise SystemExit(f"::error::cell summary {path} key {k!r} must be a string")
    if type(cell["changed"]) is not bool:
        raise SystemExit(f"::error::cell summary {path} key 'changed' must be a bool")


def load_cells(cells_dir):
    """(cell, plan_text) per downloaded cell-summary artifact, sorted by
    (environment, stack). A cell.json missing schema keys, or carrying the
    right keys with the wrong types, fails loud — that is plan-cell/summary
    pin skew, not a state to render around. Each cell's `add`, `change`,
    `destroy`, `import` and `forget` are set here from `counts` over its
    `plan.txt`, whatever cell.json holds; underivable counts become "?" each,
    with one warning."""
    out = []
    skew = "(plan-cell and summary must be pinned at the same engine SHA)"
    for p, cell in cell_summaries(cells_dir, CELL_KEYS, skew):
        _validate_cell(cell, p)
        txt = pathlib.Path(p).with_name("plan.txt")
        tally = counts(txt)
        if tally is None:
            name = f"{cell['stack']} / {cell['environment']}"
            print(
                f"::warning::plan text for {command_data(name)} has no single OpenTofu tally line; "
                "its counts render as ?"
            )
            tally = ("?",) * 5
        cell["add"], cell["change"], cell["destroy"], cell["import"], cell["forget"] = tally
        text = None
        if txt.exists():
            # Cap the read at SIZE_BUDGET: a body that long exceeds every section's limit
            # (all strictly below SIZE_BUDGET), so later characters could never be emitted,
            # and diff_map and _fence_of never regex-scan a multi-MB plan.txt in full.
            with open(txt, encoding="utf-8") as fh:
                text = fh.read(SIZE_BUDGET)
        out.append((cell, text))
    out.sort(key=lambda ct: (ct[0]["environment"], ct[0]["stack"]))
    return out


def missing_cells(planned, cells):
    """The `{stack, environment}` pairs of `planned` that no cell summary in `cells` names,
    sorted by (environment, stack): the cells whose plan this run never read."""
    read = {(c["stack"], c["environment"]) for c in cells}
    gone = [p for p in planned if (p["stack"], p["environment"]) not in read]
    return sorted(gone, key=lambda p: (p["environment"], p["stack"]))


def _missing(cells):
    """`missing_cells` of the `planned-cell-names` input, or none unless detect succeeded: a fmt
    or codegen failure still carries the full list. A value that is not a list of names warns."""
    raw = os.environ.get("SHIPMATE_PLANNED_CELLS_NAMES", "")
    planned = cell_names(raw) if raw else []
    if planned is None:
        print(
            "::warning::planned-cell-names is not a JSON list of {stack, environment} strings; "
            "the gate description and the plan comment name no cell"
        )
        planned = []
    if os.environ.get("SHIPMATE_DETECT_RESULT", "") != "success":
        return []
    return missing_cells(planned, cells)


def _named_output(raw, input_name, key, noun):
    """build-matrix's `{"count": N, key: [...]}` from the `input_name` input's `raw` value:
    `None` when empty, `None` with one warning when it is not that shape, with `N` a
    non-negative integer and exactly `min(N, UNMANAGED_NAMES)` strings under `key` (so a
    negative `N` fails too). `noun` names, in the warning, what the comment then omits."""
    if not raw:
        return None
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        value = None
    if isinstance(value, dict):
        count, names = value.get("count"), value.get(key)
        if (
            type(count) is int
            and isinstance(names, list)
            and all(isinstance(n, str) for n in names)
            and len(names) == min(count, UNMANAGED_NAMES)
        ):
            return value
    print(
        f'::warning::{input_name} is not a JSON object {{"count": N, "{key}": [strings]}} '
        f"naming min(N, {UNMANAGED_NAMES}) {key}; the plan comment names no {noun}"
    )
    return None


def _held_main(checks, url):
    body = held_comment(
        os.environ.get("SHIPMATE_HOLD_REASON", ""),
        cell_names(os.environ.get("SHIPMATE_MISSING", "")),
        checks,
        url,
        os.environ.get("HEAD_SHA", ""),
    )
    with open("held.md", "w", encoding="utf-8") as fh:
        fh.write(body)


def main():
    mode = os.environ.get("SHIPMATE_COMMENT_MODE", "")
    if mode not in ("", "held"):
        raise SystemExit(f"::error::SHIPMATE_COMMENT_MODE must be empty or held (got: {mode!r})")
    # prefix="" gathers every check-run on the head SHA: plan checks, detect/summary, and earlier
    # runs' apply checks, since this run publishes its own after the comment. Plan check names
    # carry the calling job's `shipmate / ` prefix, so check_url's lookup is exact.
    checks = ag.latest_by_name(ag.parse_jsonl(sys.stdin), prefix="")
    # This job runs inside the plan run, so this run holds the logs and the
    # artifacts the verdict's run link and the per-cell fallback link promise.
    url = current_run_url()
    if mode == "held":
        _held_main(checks, url)
        return
    cells = load_cells(os.environ.get("CELLS", "cells"))
    unmanaged = _named_output(
        os.environ.get("SHIPMATE_UNMANAGED", ""), "unmanaged-stacks", "paths", "unmanaged stack"
    )
    lost = _named_output(
        os.environ.get("SHIPMATE_LOST_ENV_TAGS", ""),
        "lost-env-tags",
        "pairs",
        "lost stack / environment pair",
    )
    body, named, lost_named = build_comment(
        cells, checks, url, os.environ.get("HEAD_SHA", ""), unmanaged, lost
    )
    with open("comment.md", "w", encoding="utf-8") as fh:
        fh.write(body)
    pending = any(c["changed"] for c, _ in cells)
    missing = _missing([c for c, _ in cells])
    write_outputs(
        pending=pending,
        count=len(cells),
        unmanaged=bool(named),
        lost=bool(lost_named),
        # `json.dumps` escapes CR and LF, so an author's stack path stays on this one line.
        missing=json.dumps(missing),
    )


if __name__ == "__main__":
    run_annotated(main)
