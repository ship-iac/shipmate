#!/usr/bin/env python3
"""Parse a PR comment against the strict comment-ops grammar.

Grammar: `shipmate <verb> [env]`. Injection-safe: the whole command line
must match one anchored regex; nothing is ever passed to a shell. The verbs are
`apply`, `doctor`, `help`, `plan` and `unlock`; any other verb is unknown.
env is optional for `apply` and required for `unlock`: a bare `shipmate apply`
targets every non-explicit environment (env=None -> "all"), while a bare
`shipmate unlock` is rejected. A second token outside the env charset, or a
third token, is malformed.
"""

import os
import re
import sys

from _shipmate import _load, current_run_url

# `shipmate` as a whole word, then verb, then an optional env in lower kebab (GitHub env naming).
_CMD = re.compile(r"^shipmate (?P<verb>[a-z]+)(?: (?P<env>[a-z0-9][a-z0-9-]*))?$")
_SHIPMATE_LINE = re.compile(r"^shipmate\b")

HELP_MARKER = "<!-- shipmate:help -->"

# Single source for the grammar, the help comment and the reject hint. `args` is the arg shape
# ("" = the verb takes none, and supplying one is an error, not silently ignored). A valid verb
# becomes the route actions/comment-ops branches on.
VERBS = {
    "apply": {
        "args": "[env]",
        "desc": (
            "Apply the reviewed plan for one environment, or every non-explicit "
            "environment when the environment is omitted."
        ),
    },
    "doctor": {
        "args": "",
        "desc": (
            "Report setup problems: repository settings, environments, App "
            "permissions, and warnings from this commit's workflow runs."
        ),
    },
    "help": {
        "args": "",
        "desc": "Show this command list.",
    },
    "plan": {
        "args": "",
        "desc": (
            "Plan this pull request's changed stacks on demand: the same plan a push "
            "produces, including on a draft. Re-planning is safe and replaces the plan of "
            "record for the current head."
        ),
    },
    "unlock": {
        "args": "<env>",
        "desc": (
            "Release a state lock stranded by a cancelled or killed apply, so "
            "the environment's stacks can apply again. Does not re-apply, and "
            "does not recover a partial apply."
        ),
    },
}


def _is_recognized_command(line):
    """True if `line` fully matches the command grammar AND its verb is one
    shipmate knows about -- as opposed to merely fitting
    the generic `shipmate <word> <word>` shape (e.g. `shipmate is great`)."""
    m = _CMD.match(line)
    return m is not None and m.group("verb") in VERBS


def _verb_error(verb, env):
    """The rejection message for `verb` carrying `env`, or None if the
    command is accepted. Lives next to the VERBS registry that defines these
    rules, so adding a verb does not first require splitting parse().
    """
    spec = VERBS.get(verb)
    if spec is None:
        return f"unknown verb `{verb}` (try `shipmate help`)"
    if spec["args"] == "" and env is not None:
        return f"`{verb}` takes no arguments (use `shipmate {verb}`)"
    if spec["args"].startswith("<") and env is None:
        return f"`{verb}` requires an environment (use `shipmate {verb} <env>`)"
    return None


def parse(body):
    """Return the parse result dict. Never raises."""
    result = {
        "is_command": False,
        "valid": False,
        "verb": None,
        "env": None,
        "route": None,
        "error": None,
    }
    lines = [ln.strip() for ln in body.splitlines()]
    # Prefer the first line that is a fully recognized command over the first merely
    # shipmate-prefixed line: incidental chatter like "shipmate is great" ahead of a real
    # "shipmate apply dev-eu" would otherwise win and bury it behind an "unknown verb" error.
    line = next((ln for ln in lines if _is_recognized_command(ln)), None)
    if line is None:
        line = next((ln for ln in lines if _SHIPMATE_LINE.match(ln)), None)
    if line is None:
        return result
    result["is_command"] = True
    m = _CMD.match(line)
    if not m:
        # Same `shipmate help` hint as the unknown-verb path: the shapes that
        # land here (a capitalized verb, a double space, an env outside its
        # charset, a third token) are typos, and the verb list is what resolves them.
        result["error"] = "malformed: expected `shipmate <verb> [env]` (try `shipmate help`)"
        return result
    verb, env = m.group("verb"), m.group("env")
    result.update(verb=verb, env=env)
    error = _verb_error(verb, env)
    if error is not None:
        result["error"] = error
        return result
    result["route"] = verb
    result["valid"] = True
    return result


def help_markdown(run_url):
    """The command list, rendered from VERBS so it cannot drift from the parser, under the shared
    header and above a footer linking `run_url` without the help hint (this is the help).

    Every usage string is inside backticks or a table cell on purpose: a bare
    line matching `_CMD` would make this very comment a shipmate command and
    retrigger comment-ops on the bot's own comment
    (test_help_has_no_bare_command_line guards it).
    """
    # Loaded here, not at import: every PR comment runs this script, and a summary-comment
    # import error must not silence every command (test_parse_does_not_import_summary_comment).
    sc = _load("summary-comment")
    lines = [
        HELP_MARKER,
        sc.header("help"),
        "",
        "Comment one of these on a pull request:",
        "",
        "| command | what it does |",
        "| --- | --- |",
    ]
    for verb in sorted(VERBS):
        spec = VERBS[verb]
        usage = f"shipmate {verb}" + (f" {spec['args']}" if spec["args"] else "")
        lines.append(f"| `{usage}` | {spec['desc']} |")
    lines += [
        "",
        (
            "The environment is a GitHub Environment name such as `dev-eu`. "
            "Applying requires write access to this repository, an approving "
            "review where the branch ruleset asks for one, a plan for the "
            "current head commit, and a pull request that is not a draft. "
            "Unlocking requires write access to this repository, but no "
            "review, no plan and no such readiness. "
            "`doctor` and `help` are read-only, and `plan` changes no "
            "infrastructure. `help` answers anyone; `doctor` and `plan` require "
            "write access to this repository."
        ),
        "",
        sc.footer(run_url, hint=False),
    ]
    return "\n".join(lines)


def main():
    if "--help-markdown" in sys.argv:
        print(help_markdown(current_run_url()))
        return
    r = parse(os.environ.get("COMMENT_BODY", ""))
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"is_command={'true' if r['is_command'] else 'false'}\n")
        fh.write(f"valid={'true' if r['valid'] else 'false'}\n")
        # A verb outside VERBS is written empty, so a reply to `shipmate aply` names no verb.
        fh.write(f"verb={r['verb'] if r['verb'] in VERBS else ''}\n")
        fh.write(f"env={r['env'] or ''}\n")
        fh.write(f"route={r['route'] or ''}\n")
        fh.write(f"error={r['error'] or ''}\n")


if __name__ == "__main__":
    main()
