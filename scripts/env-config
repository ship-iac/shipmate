#!/usr/bin/env python3
"""Read the environment table from the repository's default branch.

Branch content cannot rewrite these values because they are not read from the
branch: the table comes through the contents API with no ref, which GitHub answers
from the default branch. The read names `GITHUB_REPOSITORY`, the base repository
under both pull-request events, and a fork pull request is refused before it plans.
"""

import base64
import contextlib
import graphlib
import importlib.util
import json
import os
import re
import sys
import types

from _shipmate import load_config_text, run, yaml_error_text

#: The file the engine reads its settings from, and the interpreter floor that reading it
#: needs. The floor is CONTRACT.md section Runner prerequisites, which every runner already
#: promises; nothing in the engine installs or pins a Python, so this is the only place it
#: is checked.
CONFIG_PATH = ".github/shipmate-config.yml"
_MIN_PYTHON = (3, 12)


def _run(args):
    """stdout of `args` through `_shipmate.run`, its failure re-raised as an ::error::
    annotation. `_shipmate.run` stays unprefixed for the hand-run scripts that share it.

    `build-matrix` aliases this rather than keeping its own copy: this module `_load`s
    nothing at import, so reaching it from there terminates. The reverse would not --
    `_shipmate.py` caches nothing and re-executes a module on every `_load`.
    """
    try:
        return run(args)
    except SystemExit as e:
        raise SystemExit(f"::error::{e}") from None


def runner_refusal():
    """The refusal a runner lacking what reading the file needs earns, or `None`: an
    interpreter below the floor first, then a missing PyYAML.

    Separately callable so `doctor` can run it outside the try that turns a `SystemExit`
    into a "this file is not valid" finding: both are properties of the runner, true of the
    default branch's copy too, and merging anything changes nothing about them. PyYAML is
    looked up, never imported, so an old interpreter can still import this module.
    """
    if sys.version_info < _MIN_PYTHON:
        found = ".".join(str(n) for n in sys.version_info[:3])
        return (
            f"::error::the engine needs Python {_MIN_PYTHON[0]}.{_MIN_PYTHON[1]} or later; "
            f"this runner has {found}. CONTRACT.md section Runner prerequisites requires "
            f"python3 >= {_MIN_PYTHON[0]}.{_MIN_PYTHON[1]} on every runner. Choose a newer "
            "runs_on image."
        )
    if importlib.util.find_spec("yaml") is None:
        return (
            "::error::the engine needs PyYAML for python3 and this runner has none. Install "
            "python3-yaml (Debian or Ubuntu) or PyYAML >= 6 for this runner's python3; "
            "CONTRACT.md section Runner prerequisites lists it."
        )
    return None


_FLAGS = ("shared", "explicit", "gated")


def load_config(text):
    """The mapping parsed from `text` with no reference resolved, or `SystemExit`.

    The runner check runs ahead of the parse, which would otherwise fail on a missing PyYAML
    with a bare `ModuleNotFoundError` instead of naming the runner prerequisite.

    Every scalar is a string. An environment's `shared`, `explicit` or `gated` holding exactly
    `true` or `false` becomes a bool here, before any reference resolves; one holding a
    variable reference anywhere in it refuses here, and so does a `layout` that is neither a
    string nor a reference, so the refusals that quote those values never quote a resolved
    one. Any other value stays as written for `validate_structure` to refuse.
    """
    refusal = runner_refusal()
    if refusal:
        raise SystemExit(refusal)
    import yaml

    try:
        parsed = load_config_text(text)
    except yaml.YAMLError as exc:
        raise SystemExit(
            f"::error::{CONFIG_PATH} is not valid YAML: {yaml_error_text(exc)}"
        ) from exc
    if not isinstance(parsed, dict):
        raise SystemExit(
            f"::error::{CONFIG_PATH} must hold a mapping at the top level, got "
            f"{type(parsed).__name__}"
        )
    if "layout" in parsed and not _is_reference(parsed["layout"]):
        _string(parsed["layout"], "layout")
    environments = parsed.get("environments")
    for env, entry in environments.items() if isinstance(environments, dict) else ():
        if isinstance(entry, dict):
            _normalise_flags(env, entry)
    return parsed


def _normalise_flags(env, entry):
    for key in _FLAGS:
        if any(_is_reference(node) for _, node in _walk(entry.get(key), key)):
            raise SystemExit(
                f"::error::environments.{env}.{key} holds a variable reference; a flag accepts "
                "no variable reference. Write true or false."
            )
        if entry.get(key) in ("true", "false"):
            entry[key] = entry[key] == "true"


def _is_reference(value):
    """Exactly `{vars: NAME}`. Any other mapping holding `vars` is ordinary data."""
    return isinstance(value, dict) and len(value) == 1 and isinstance(value.get("vars"), str)


def _walk(value, path):
    """`(path, node)` for every node, depth first. List items render as `key[i]`."""
    yield path, value
    if isinstance(value, dict) and not _is_reference(value):
        for key, child in value.items():
            yield from _walk(child, f"{path}.{key}")
    elif isinstance(value, list):
        for i, child in enumerate(value):
            yield from _walk(child, f"{path}[{i}]")


def references(parsed):
    """`(dotted key path, NAME)` for every reference in a raw `load_config` result, by path.

    The root mapping is never a reference: a file holding only `vars: X` is a setting.
    """
    return sorted(
        (path, node["vars"])
        for key, child in parsed.items()
        for path, node in _walk(child, key)
        if _is_reference(node)
    )


def _environ_variables(path, name):
    """The GitHub variables the engine wired into this step as `SHIPMATE_GITHUB_VARS`.

    Absent or empty refuses before any lookup could blame `name`: every action defaults
    `github-vars` to "", so an unpassed input arrives empty, not absent.
    """
    raw = os.environ.get("SHIPMATE_GITHUB_VARS")
    if not raw:
        raise SystemExit(
            f"::error::{CONFIG_PATH} {path} references GitHub variable {name}, but this step "
            "received no GitHub variables: the engine did not pass github-vars to this step, "
            "or the repository reaches no variables at all."
        )
    from _shipmate import _load

    return _load("env-inject").parse_enumeration(raw, "SHIPMATE_GITHUB_VARS")


#: GitHub's variable-name charset in either case; a lowercase name refuses separately, naming
#: its uppercase spelling.
_VARIABLE_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


def _lookup(path, name, variables):
    """The value of `name`. No refusal quotes a value."""
    where = f"::error::{CONFIG_PATH} {path} references GitHub variable"
    if not _VARIABLE_NAME.fullmatch(name):
        raise SystemExit(
            f"{where} {name!r}, which is not a GitHub variable name ([A-Z_][A-Z0-9_]*)."
        )
    if name != name.upper():
        raise SystemExit(
            f'{where} "{name}"; GitHub variable names are uppercase. Write '
            f"{{vars: {name.upper()}}}."
        )
    if name not in variables:
        raise SystemExit(
            f"{where} {name}, which is not set. A reference reads repository and "
            "organization variables; the variables of a cell's <env>-plan, <env>-apply or "
            "shared <env> Environment are never read."
        )
    if variables[name] == "":
        raise SystemExit(f"{where} {name}, which is set to an empty value.")
    return variables[name]


def _replace(value, path, variables):
    if _is_reference(value):
        return _lookup(path, value["vars"], variables)
    if isinstance(value, dict):
        return {k: _replace(v, f"{path}.{k}", variables) for k, v in value.items()}
    if isinstance(value, list):
        return [_replace(v, f"{path}[{i}]", variables) for i, v in enumerate(value)]
    return value


def parse_table(text, variables=None):
    """The table parsed from `text`, each `{vars: NAME}` replaced by that GitHub variable's
    value, or `SystemExit`.

    Shared by every reader: `read_table` below reads the default branch's file, and
    `doctor` reads a branch's copy to report on it. Resolving here and nowhere else is what
    makes every reader see the same values.

    `variables` maps uppercase names to values. `None` reads `SHIPMATE_GITHUB_VARS`, and
    only when the file holds a reference: a file without one never touches it. An unset,
    empty, lowercase or malformed name refuses, naming the key path and the name.
    """
    parsed = load_config(text)
    refs = references(parsed)
    if not refs:
        return parsed
    if variables is None:
        variables = _environ_variables(*refs[0])
    table = {key: _replace(value, key, variables) for key, value in parsed.items()}
    # `validate_structure` quotes a bad layout, and no refusal may quote a resolved value.
    if _is_reference(parsed.get("layout")) and table["layout"] not in _LAYOUTS:
        raise SystemExit(
            f"::error::{CONFIG_PATH} layout references GitHub variable "
            f"{parsed['layout']['vars']}, whose value is not one of {', '.join(_LAYOUTS)}."
        )
    return table


#: The one refusal `read_table` raises when the table cannot be read.
_UNREADABLE = (
    f"::error::{CONFIG_PATH} could not be read from the default branch. The engine reads "
    "the environment table from the default branch, never from this branch, so the file "
    "must be merged there before the first plan."
)


def log_failure(e, label=""):
    """Write a caught failure to stderr for the step log, never as a workflow command.

    `gh_json`'s leading `::error::` is cut, and every other line starting with `::` (gh's
    stderr rides in the message) gets a space between the colons; the runner trims leading
    whitespace before matching a command, so indenting would not neutralise it. A failure
    other than `SystemExit` is prefixed with its type: a `KeyError`'s message is only the key.
    """
    text = str(e).removeprefix("::error::")
    if not isinstance(e, SystemExit):
        text = f"{type(e).__name__}: {text}"
    if label:
        text = f"{label}: {text}"
    sys.stderr.write(re.sub(r"(?m)^([ \t]*):(?=:)", r"\1: ", text) + "\n")


def _reporting_fetch(path):
    """`gh_json`, writing a failed call's reason to stderr before re-raising it.

    `contents_text` swallows every exception, so this is the only place a 404, a 403, a
    missing `gh` or a non-JSON answer is seen.
    """
    try:
        return gh_json(path)
    except (Exception, SystemExit) as e:
        log_failure(e)
        raise


def read_table():
    """The table from the default branch. Every failure here refuses.

    The contents API read names no ref, which GitHub answers from the default branch;
    a parameter or a `?ref=` here would let a caller point it at branch content.
    """
    path = f"repos/{os.environ['GITHUB_REPOSITORY']}/contents/{CONFIG_PATH}"
    text = contents_text(path, fetch=_reporting_fetch)
    if text is None:
        raise SystemExit(_UNREADABLE)
    return parse_table(text)


def gh_json(path, run=None):
    """`gh api <path>` -> parsed JSON, through `run` so a nonzero exit raises ::error::
    with the tool's stderr in the message, from a single definition. Callers alias it as
    `_gh_json` rather than repeating the `json.loads(_run(...))` pair.

    Homed beside `_run` for the same reason: `build-matrix` aliases it, and this module
    cannot alias upward.
    """
    return json.loads((run or _run)(["gh", "api", path]))


def contents_text(path, fetch=None):
    """One file's decoded text from the contents API, or None when it cannot be read.

    The one read mechanism for the file: `read_table` and `doctor`'s probes both read
    through it. An engine job holding the GitHub App key executes no consumer repository
    content on purpose, so the read never needs a checkout.

    Anything that is not a base64 blob is UNREADABLE, not empty: a >1 MB file answers with
    `encoding: "none"` and empty `content`, which would otherwise decode to a readable
    EMPTY file a caller reads as clean.

    `fetch` reads the JSON, defaulting to this module's `gh api` call. It is a seam, not
    flexibility: `doctor` passes its own reader so that the mocks in its tests keep
    intercepting this read.

    `errors="replace"` keeps a mis-encoded byte from raising.
    """
    fetch = fetch or gh_json
    try:
        blob = fetch(path)
    except (Exception, SystemExit):  # noqa: BLE001 - unreadable is the contract, not a failure
        return None
    if not isinstance(blob, dict) or blob.get("encoding") != "base64":
        return None
    return base64.b64decode(blob.get("content", "")).decode("utf-8", "replace")


#: The layouts a repository may declare, and the environment-level keys an entry may hold.
_LAYOUTS = ("tf_vars", "workspace", "folder")
_ENV_KEYS = ("region", "tf_vars", "identity", "workloads", "shared", "needs", "explicit", "gated")

#: An identity's fields, all under `aws`. Each is a string or a map keyed by workload.
_ID_FIELDS = ("account", "plan", "apply")
_ROLE_FIELDS = ("plan", "apply")

#: The only placeholder a role may carry, filled with `str.replace` from a listed workload.
_PLACEHOLDER = "{workload}"
_ACCOUNT_ID = re.compile(r"[0-9]{12}")

#: `vars` because a one-key `{vars: NAME}` is a reference; `role` and `region` because
#: `plan: {role: x}` and `plan: {region: x}` parse as maps keyed by them, which would
#: otherwise validate as a role for a workload of that name.
_RESERVED_WORKLOADS = ("vars", "role", "region")

#: Everything the file may declare at its top level.
_TOP_KEYS = ("layout", "identities", "environments")

#: Env names come from Terramate `env/<name>` tags, so the charset is comment-parse's env
#: grammar plus `_`, a legal tag character no `shipmate apply <env>` can name. Lowercase
#: because Terramate refuses an uppercase letter in a tag: an entry carrying an uppercase
#: letter can never name an environment, so its flags and its `needs` would apply to
#: nothing while reading as though they held.
_ENV_ENTRY = re.compile(r"[a-z0-9][a-z0-9_-]*")


def is_env_name(name):
    """Whether `name` is in the environment-name charset: lowercase letters, digits, `-` and
    `_`, starting with a letter or digit. It holds no space, so no ` / `."""
    return bool(_ENV_ENTRY.fullmatch(name))


def _mapping(value, where):
    if not isinstance(value, dict):
        raise SystemExit(f"::error::{where} must be a mapping, got {type(value).__name__}.")
    return value


def _string(value, where):
    if not isinstance(value, str):
        raise SystemExit(f"::error::{where} must be a string, got {type(value).__name__}.")
    return value


@contextlib.contextmanager
def _gather(errors):
    """Append the message of a `SystemExit` raised in the block to `errors`, and go on.

    Yields an object whose `ok` turns False when the block raised.
    """
    caught = types.SimpleNamespace(ok=True)
    try:
        yield caught
    except SystemExit as exc:
        errors.append(str(exc))
        caught.ok = False


def _check_vars(entry, env, errors):
    """`TF_VAR_*` and `TF_WORKSPACE` only, and strings only, one message per name. A
    non-mapping `tf_vars` gets its one message and no per-name check.

    A non-string value would otherwise pass here and refuse once per cell at injection
    time -- forty identical failures in a forty-cell matrix instead of one at the top.
    """
    tf_vars = entry["tf_vars"]
    with _gather(errors) as shape:
        _mapping(tf_vars, f"environment {env}: tf_vars")
    if not shape.ok:
        return
    for name, value in sorted(tf_vars.items()):
        if not name.startswith("TF_VAR_") and name != "TF_WORKSPACE":
            errors.append(
                f"::error::environment {env}: tf_vars may name only TF_VAR_* and "
                f"TF_WORKSPACE, and {name} is neither."
            )
        elif not isinstance(value, str):
            errors.append(
                f"::error::environment {env}: tf_vars.{name} must be a string, got "
                f"{type(value).__name__}. A non-string value would otherwise refuse once "
                "per cell at injection time."
            )


def _check_flags(entry, env, errors):
    """`shared`, `explicit` and `gated` hold `true` or `false`, one message per flag.

    `load_config` turned those two spellings into bools and refused any value holding a
    reference, so anything else here is written in the file. It reads as set to a person and
    resolves as unset; for `explicit` that puts the environment on a bare `shipmate apply`.
    """
    for key in _FLAGS:
        if key in entry and not isinstance(entry[key], bool):
            errors.append(
                f"::error::environments.{env}.{key} must be true or false, got {entry[key]!r}."
            )


def shared_envs(table):
    """The environments whose entry holds `shared: true`.

    Such an environment binds one bare GitHub Environment on both paths instead of the
    `<env>-plan` / `<env>-apply` pair. Anything but `true` is unshared, the protected
    direction; `validate_structure` refuses a non-boolean value before a run reads it.
    """
    return {
        env for env, entry in table.get("environments", {}).items() if entry.get("shared") is True
    }


def env_names(env, shared):
    """{role: GitHub Environment name} one logical env binds: `{"shared": env}` when
    `shared` is true, else `{"plan": "<env>-plan", "apply": "<env>-apply"}`, plan first."""
    if shared:
        return {"shared": env}
    return {"plan": f"{env}-plan", "apply": f"{env}-apply"}


def env_binding(env, shared, path):
    """The GitHub Environment a cell of `env` on `path` binds: the bare `env` when `shared`,
    `<env>-<path>` otherwise. When not `shared`, a `path` other than `plan` or `apply` raises
    KeyError."""
    return env_names(env, shared)["shared" if shared else path]


def explicit_envs(table):
    """Environments a bare `shipmate apply` skips: each needs its own `shipmate apply <env>`.

    Only `explicit: true` holds one back; `validate_structure` refuses any other value.
    """
    return sorted(
        e for e, entry in table.get("environments", {}).items() if entry.get("explicit") is True
    )


def ungated_envs(table):
    """Environments a targeted apply reaches without an approving review.

    Only `gated: false` exempts one; anything else is gated, the protected direction.
    Entry names are lowercase by `check_env_name`, so the set already matches the
    casefolded env name `authorize` compares against it.
    """
    return frozenset(
        e for e, entry in table.get("environments", {}).items() if entry.get("gated") is False
    )


def _check_environment(entry, env, errors, identities):
    """One entry's own shape, one message per check into `errors`. A non-mapping entry gets
    its one message and no other check. Nothing here reads context outside the file.

    `identities` is `(declared, valid)` from `_check_identities`, or `None` when the file's
    `identities` is not a mapping, which skips every check of how the entry names one.
    """
    with _gather(errors) as shape:
        _mapping(entry, f"environment {env}")
    if not shape.ok:
        return
    for key in sorted(entry):
        if key not in _ENV_KEYS:
            errors.append(
                f"::error::environment {env}: {key} is not a key this engine implements. "
                f"An environment holds {', '.join(_ENV_KEYS)}."
            )
    if "region" in entry:
        with _gather(errors):
            if _string(entry["region"], f"environment {env}: region") == "":
                raise SystemExit(
                    f"::error::environment {env}: region is empty. Give it a value, or remove "
                    "the key."
                )
    if "tf_vars" in entry:
        _check_vars(entry, env, errors)
    _check_flags(entry, env, errors)
    if identities is not None:
        _check_identity_use(entry, env, errors, *identities)


def _not_a_workload(where):
    return SystemExit(
        f"::error::{where} is not a workload name: lowercase letters, digits, '-' and '_', "
        "starting with a letter or digit, and not vars, role or region."
    )


def _is_workload(name):
    """The environment-name charset, because a workload name is a Terramate tag too."""
    return is_env_name(name) and name not in _RESERVED_WORKLOADS


def _empty(name, where):
    return SystemExit(
        f"::error::identities.{name}.{where} is empty. Give it a value, or remove the key."
    )


def _not_an_account(name, where):
    return SystemExit(f"::error::identities.{name}.{where} is not a 12-digit AWS account id.")


def _check_value(name, where, field, value):
    """One string at an identity's field position: non-empty, an account id where the field
    is `account`, and no brace but the placeholder in a role."""
    if value == "":
        raise _empty(name, where)
    if field == "account":
        if not _ACCOUNT_ID.fullmatch(value):
            raise _not_an_account(name, where)
    elif "{" in value.replace(_PLACEHOLDER, "") or "}" in value.replace(_PLACEHOLDER, ""):
        raise SystemExit(
            f"::error::identities.{name}.{where} holds a brace outside {_PLACEHOLDER}, the "
            "only placeholder."
        )


def _check_map_value(name, field, key, value):
    """One `key: value` of a field written as a map keyed by workload."""
    where = f"identities.{name}.aws.{field}.{key}"
    if not _is_workload(key):
        raise _not_a_workload(where)
    _string(value, where)
    _check_value(name, f"aws.{field}.{key}", field, value)


def _check_field(name, field, value, errors):
    """One identity field, a string or a map keyed by workload; each map entry is checked
    on its own."""
    if isinstance(value, str):
        with _gather(errors):
            _check_value(name, f"aws.{field}", field, value)
    elif value == {}:
        errors.append(str(_empty(name, f"aws.{field}")))
    elif isinstance(value, dict):
        for key in sorted(value):
            with _gather(errors):
                _check_map_value(name, field, key, value[key])
    else:
        errors.append(
            f"::error::identities.{name}.aws.{field} must be a string or a map keyed by "
            f"workload, got {type(value).__name__}."
        )


def _aws_key_error(name, key):
    return (
        f"::error::identities.{name}.aws.{key} is not a field this engine implements. An "
        "identity holds aws.account, aws.plan and aws.apply."
    )


def _check_identity(identity, name, errors):
    """One identity's own shape, one message per check into `errors`. A non-mapping
    identity, or a non-mapping `aws`, gets its one message and no other check."""
    with _gather(errors) as shape:
        _mapping(identity, f"identities.{name}")
    if not shape.ok:
        return
    for key in sorted(identity):
        if key != "aws":
            errors.append(
                f"::error::identities.{name}.{key} is not a key this engine implements. An "
                "identity holds aws.account, aws.plan and aws.apply."
            )
    aws = identity.get("aws", {})
    with _gather(errors) as shape:
        _mapping(aws, f"identities.{name}.aws")
    if not shape.ok:
        return
    errors.extend(_aws_key_error(name, key) for key in sorted(aws) if key not in _ID_FIELDS)
    if not any(field in aws for field in _ROLE_FIELDS):
        errors.append(
            f"::error::identities.{name} sets neither aws.plan nor aws.apply, so it grants no "
            "credential. Set one, or remove the identity."
        )
    for field in _ID_FIELDS:
        if field in aws:
            _check_field(name, field, aws[field], errors)


def _check_identities(identities, errors):
    """Every identity, by name. Returns the names that passed, the only ones an
    environment's role checks read."""
    valid = set()
    for name in sorted(identities):
        before = len(errors)
        _check_identity(identities[name], name, errors)
        if len(errors) == before:
            valid.add(name)
    return valid


def _varies(aws):
    """Whether a validated identity's roles depend on the cell's workload."""
    return any(isinstance(value, dict) or _PLACEHOLDER in value for value in aws.values())


def _check_workloads(entry, env, errors):
    """`workloads`, which only an entry naming an identity may hold. True when the list is
    absent or sound, so the role checks can read it."""
    if "workloads" not in entry:
        return True
    if "identity" not in entry:
        errors.append(
            f"::error::environment {env}: workloads admits workloads to an identity, and the "
            "environment names none. Name an identity, or remove workloads; without one a "
            "workload tag is inert."
        )
        return False
    listed = entry["workloads"]
    if (
        not isinstance(listed, list)
        or not listed
        or not all(isinstance(w, str) for w in listed)
        or len(set(listed)) != len(listed)
    ):
        errors.append(
            f"::error::environments.{env}.workloads must be a non-empty list of distinct "
            "workload-name strings."
        )
        return False
    bad = [w for w in listed if not _is_workload(w)]
    errors.extend(str(_not_a_workload(f"environments.{env}.workloads entry {w!r}")) for w in bad)
    return not bad


def _check_identity_use(entry, env, errors, declared, valid):
    """How one entry names an identity, and the roles that identity resolves for it."""
    listed_ok = _check_workloads(entry, env, errors)
    if "identity" not in entry:
        return
    name = entry["identity"]
    if not isinstance(name, str) or name not in declared:
        errors.append(
            f"::error::environment {env}: identity names no entry under identities; the "
            f"file declares {', '.join(sorted(declared)) or 'none'}."
        )
        return
    region = entry.get("region")
    if not isinstance(region, str) or not region:
        errors.append(
            f"::error::environment {env} names identity {name} but sets no region, and the "
            "credentials step requires one. Set region."
        )
    if name in valid:
        _check_named_identity(entry, env, name, declared[name]["aws"], errors, listed_ok)


def _check_named_identity(entry, env, name, aws, errors, listed_ok):
    """The rules that join an entry to the valid identity it names."""
    varies = _varies(aws)
    if varies and "workloads" not in entry:
        errors.append(
            f"::error::environment {env} names identity {name}, whose roles vary by workload, "
            "and lists no workloads. List the workloads it admits: workloads: […]."
        )
    shared = entry.get("shared") is True
    if shared and "plan" in aws:
        errors.append(
            f"::error::environment {env} is shared between the plan and apply paths, so "
            f"identity {name}'s aws.plan cannot apply to it: a shared environment uses "
            "aws.apply on both paths. Name an identity without aws.plan, or set shared: false."
        )
    if varies and not listed_ok:
        return
    # A non-varying identity resolves one role per path for every cell, list or no list.
    paths = ("apply",) if shared else _ROLE_FIELDS
    for workload in entry.get("workloads", []) if varies else [None]:
        with _gather(errors):
            _check_account_rule(env, name, aws, paths, workload)


def _listed_roles(env, name, aws, paths, workload):
    """`{path: role}` for one workload, `None` standing for every cell; a listed workload
    missing from a role map refuses."""
    roles = {}
    for path in paths:
        value = aws.get(path)
        if isinstance(value, dict):
            if workload not in value:
                raise _missing_entry(env, name, path, workload)
            value = value[workload]
        if value is not None:
            roles[path] = value.replace(_PLACEHOLDER, workload or "")
    return roles


def _missing_entry(env, name, field, workload):
    return SystemExit(
        f"::error::environment {env} lists workload {workload}, and identities.{name}.aws."
        f"{field} has no {workload} entry. Add it, or remove {workload} from workloads."
    )


def _check_account_rule(env, name, aws, paths, workload):
    """One workload's roles, over the paths the entry consults: all names or all ARNs, a name
    beside an account and an ARN beside none. Refuses at the first break."""
    roles = _listed_roles(env, name, aws, paths, workload)
    cell = "every cell" if workload is None else f"workload {workload}"
    arns = {role.startswith("arn:") for role in roles.values()}
    if len(arns) > 1:
        raise SystemExit(
            f"::error::environment {env}: identities.{name} gives {cell} a role name on one "
            "path and a full ARN on the other. Write both as ARNs."
        )
    if not roles:
        return
    path = next(iter(roles))
    account = aws.get("account")
    has_account = isinstance(account, str) or (isinstance(account, dict) and workload in account)
    if arns == {True} and has_account:
        raise SystemExit(
            f"::error::environment {env}: identities.{name}.aws.{path} is a full ARN for "
            f"{cell}, and identities.{name}.aws.account also gives "
            f"{'every cell' if workload is None else workload} an account. An ARN carries its "
            "own; remove the account, or write the role as a name."
        )
    if arns == {False} and not has_account:
        if isinstance(account, dict):
            raise _missing_entry(env, name, "account", workload)
        raise SystemExit(
            f"::error::environment {env}: identities.{name}.aws.{path} is a role name for "
            f"{cell}, and no account is set for it. Set identities.{name}.aws.account, or "
            "write the role as a full ARN."
        )


def _check_dry_coverage(environments, matrix_envs):
    """The `tf_vars` layout derives both identity variables from the table, so every cell
    needs an entry.

    An empty region is no region: `plan-classify` excludes an empty `TF_VAR_*` from the
    fingerprint, so the layout would derive nothing the cell could be distinguished by.
    """
    for env in sorted(matrix_envs):
        entry = environments.get(env)
        if entry is None:
            missing = "no entry in it"
        elif not _mapping(entry, f"environment {env}").get("region"):
            missing = "an entry with no region"
        else:
            continue
        raise SystemExit(
            "::error::layout: tf_vars derives TF_VAR_env and TF_VAR_region from the "
            f"environment table, and {env} has {missing}."
        )


#: Why the unused-entry diagnostics warn instead of refusing. One wording, because the
#: reasoning is one reasoning.
_TWO_PULL_REQUESTS = (
    "This is a warning rather than a refusal because the table is read from the default "
    "branch and the tags from this branch, so an environment arrives and leaves over two "
    "pull requests."
)


def _report_unused(table, tagged):
    """Name the entries no stack tags, and each entry's listed workloads no stack in it tags.
    A warning, deliberately, and never a refusal.

    The table is read from the default branch and the tags from the feature branch, so
    adding or removing an environment takes two pull requests; refusing an unused entry
    would deadlock both. Names are matched exactly, as `resolve`, `_check_dry_coverage` and
    apply-all-detect's exclusions match them. An uppercase entry name never gets here:
    `check_env_name` refuses it, so an unused entry is a lowercase one no stack tags.

    A `needs` predecessor no stack tags gets its own warning, because the key is fail-open: it
    reads as ordering something while the run orders nothing. The charset rule catches only
    names no env name could take; a plain typo passes it and lands here. Only predecessors are
    checked: the env holding `needs` is an entry, like one holding `explicit` or `gated`, and
    the unused-entry warning covers it.

    `tagged` maps each environment the whole-tree scan found to the workload names its
    stacks tag.
    """
    envs = set(tagged)
    unused = sorted(set(table.get("environments", {})) - envs)
    if unused:
        print(
            f"::warning::the environment table declares {', '.join(unused)}, which no stack "
            "tags. Remove the entry, or tag the stacks that belong to it. " + _TWO_PULL_REQUESTS
        )
    stale = stale_needs(table, envs)
    if stale:
        print(
            f"::warning::needs names {', '.join(stale)}, which no stack tags, so it orders "
            "nothing. Remove the entry, or tag the stacks that belong to it. " + _TWO_PULL_REQUESTS
        )
    _report_untagged_workloads(table, tagged)


def _report_untagged_workloads(table, tagged):
    """Name each entry's listed workloads no stack in that environment tags. A workload is
    listed before the branch tagging it merges and dropped after the branch untagging it. An
    environment no stack tags is skipped: the unused-entry warning already names it."""
    for env, untagged in untagged_workloads(table, tagged):
        print(
            f"::warning::environments.{env}.workloads lists {', '.join(untagged)}, which "
            f"no stack in {env} tags. Tag a stack with each, or remove it from the list "
            "once the pull request that drops its last tag has merged. This is a warning "
            "rather than a refusal because the table is read from the default branch and "
            "the tags from this branch, so a workload arrives and leaves over two pull "
            "requests."
        )


def stale_needs(table, envs):
    """The sorted `needs` predecessor names not in `envs`. `scripts/onboard` reports from
    this function too, so the two cannot disagree."""
    return sorted({p for preds in env_order(table).values() for p in preds} - set(envs))


def untagged_workloads(table, tagged):
    """`[(env, sorted names)]` in entry-name order: each entry's listed workloads no stack in
    that environment tags, per `tagged` (`{env: workload names}`). An environment absent from
    `tagged` is skipped, and so is one whose list is fully tagged. `scripts/onboard` reports
    from this function too."""
    return [
        (env, untagged)
        for env, entry in sorted(table.get("environments", {}).items())
        if env in tagged
        and (untagged := sorted(set(entry.get("workloads", ())).difference(tagged[env])))
    ]


def env_order(table):
    """`{env: [predecessors]}` from each entry's `needs`: the order `env-order` sorts."""
    return {
        env: entry["needs"]
        for env, entry in sorted(table.get("environments", {}).items())
        if "needs" in entry
    }


def _check_cycle(order):
    """`SystemExit` when `order`, already a mapping of env-name lists, is cyclic.

    Only after the list checks, or the sorter consumes a string predecessor character by
    character.
    """
    try:
        graphlib.TopologicalSorter(order).prepare()
    except graphlib.CycleError as exc:
        cycle = " -> ".join(exc.args[1])
        raise SystemExit(
            f"::error::needs is cyclic: {cycle}: each of those must fully apply "
            "before the next, so the ordering has no first environment and no apply path "
            f"can sort it. Break the chain in {CONFIG_PATH}."
        ) from exc


def _check_depth(order, environments):
    """`SystemExit` naming one longest chain when acyclic `order` spans more env levels
    than a deploy applies: the deepest env, then a predecessor one level lower each step,
    the sorted-first at every tie."""
    from _shipmate import _load

    eo = _load("env-order")
    levels = eo.env_levels(order, sorted(set(environments).union(*order.values())))
    depth = max(levels.values(), default=0)
    if depth < eo.MAX_ENV_LEVELS:
        return
    chain = [min(e for e, lv in levels.items() if lv == depth)]
    while levels[chain[-1]]:
        chain.append(min(p for p in order[chain[-1]] if levels[p] == levels[chain[-1]] - 1))
    raise SystemExit(
        f"::error::needs spans {depth + 1} env levels: {' -> '.join(reversed(chain))}. "
        f"A deploy applies at most {eo.MAX_ENV_LEVELS} env levels. Shorten the chain in "
        f"{CONFIG_PATH}."
    )


def validate_env_name_list(envs, key):
    """`envs`, or `SystemExit` unless it is a list of bare env-name strings.

    The list rule `needs` follows. `key` names the setting in every message. Guards a bare
    string, which would otherwise be iterated character by character, a non-list value, and
    each element under `check_env_name`.
    """
    if not isinstance(envs, list):
        raise SystemExit(
            f"::error::{key} must be a list of env-name strings, "
            f"got {type(envs).__name__} ({envs!r}); did you mean [{envs!r}]?"
        )
    bad = [e for e in envs if not isinstance(e, str)]
    if bad:
        raise SystemExit(
            f"::error::{key} elements must all be env-name strings; "
            f"got non-string element(s) {bad!r}"
        )
    for e in envs:
        check_env_name(e, f"{key} entry {e!r}", key)
    return envs


def check_env_name(e, label, matched):
    """Refuse a name no environment can take: an entry key, a list element, a stack's
    `env/<name>` tag or a dispatched `SHIPMATE_ENV`.

    Guards a name outside the charset, and one carrying a `-plan`/`-apply` environment
    suffix -- each is matched against the bare logical env name, matches nothing, and so
    orders, holds back or exempts nothing while reading as if it did. `label` opens each
    message and `matched` names what the suffix message says is matched.

    Charset before suffix: a suffixed name passes the charset, so the two are separate
    checks, and this order gives `"dev eu-plan"` the message about its space.
    """
    if not is_env_name(e):
        raise SystemExit(
            f"::error::{label} is not an environment name: lowercase letters, digits, '-' "
            "and '_', with no quotes, spaces or path separators."
        )
    for suffix in ("-plan", "-apply"):
        if e.endswith(suffix):
            raise SystemExit(
                f"::error::{label} carries the environment suffix "
                f"{suffix!r}; {matched} is matched against the bare logical env name; "
                f"write {e[: -len(suffix)]!r} instead."
            )


def _check_entries(environments, errors, identities):
    """Every entry name, then every entry, then each `needs` list, then the order they
    declare -- the cycle check only when every list passed, the depth check only when the
    order is acyclic. A non-mapping entry's `needs` is not read. `identities` is as
    `_check_environment` takes it."""
    for env in sorted(environments):
        with _gather(errors):
            check_env_name(env, f"environments.{env}", "an entry name")
    for env in sorted(environments):
        _check_environment(environments[env], env, errors, identities)
    order = {}
    lists_ok = True
    for env, entry in sorted(environments.items()):
        if isinstance(entry, dict) and "needs" in entry:
            order[env] = entry["needs"]
            with _gather(errors) as listed:
                validate_env_name_list(entry["needs"], f"environments.{env}.needs")
            lists_ok = lists_ok and listed.ok
    if lists_ok:
        with _gather(errors) as acyclic:
            _check_cycle(order)
        if acyclic.ok:
            with _gather(errors):
                _check_depth(order, environments)


def validate_structure(table):
    """Everything the file can be judged on by itself, or one `SystemExit` naming every
    error: its message is one `::error::` line per refused check, in check order.

    Every independent check runs. A check whose input an earlier check refused is skipped: a
    non-mapping `identities` skips every identity check and every entry's `identity` and
    `workloads` checks, a refused identity the role checks of each entry naming it, a
    non-mapping `environments` skips every entry, a non-mapping entry its own checks and its
    `needs`, a non-mapping `tf_vars` its per-name checks, a refused `needs` list the cycle
    check, and a cyclic `needs` graph the depth check. The role checks of one workload stop
    at its first refusal.

    Identities are checked before entries, each once, whatever the number of entries naming it.

    Every top-level field, so a "valid configuration" verdict cannot hide an ordering
    or flag error until an apply reads it. `doctor` and `gate-config` validate with
    this alone: the rules left to `validate` need a matrix or a whole-tree environment scan,
    neither of which either of them has.

    `layout` is required: it is the only source of a cell's environment identity, so a
    table without one leaves every cell with nothing to run as.
    """
    errors = [
        f"::error::{key} is not a setting this engine implements. "
        f"{CONFIG_PATH} holds {', '.join(_TOP_KEYS)}."
        for key in sorted(table)
        if key not in _TOP_KEYS
    ]
    # Key presence, not a truthy value: an empty layout is a declared layout holding a value
    # no layout may hold, and must say so rather than read as undeclared.
    if "layout" not in table:
        errors.append(
            f"::error::{CONFIG_PATH} declares no layout, so no cell can resolve its "
            "environment identity. Declare layout: tf_vars, layout: workspace or layout: "
            "folder on the default branch, which is where this table is read from."
        )
    elif table["layout"] not in _LAYOUTS:
        errors.append(
            f"::error::layout is {table['layout']!r}; it must be one of {', '.join(_LAYOUTS)}."
        )
    identities = table.get("identities", {})
    with _gather(errors) as shape:
        _mapping(identities, "identities")
    identities = (identities, _check_identities(identities, errors)) if shape.ok else None
    environments = table.get("environments", {})
    with _gather(errors) as shape:
        _mapping(environments, "environments")
    if shape.ok:
        _check_entries(environments, errors, identities)
    if errors:
        raise SystemExit("\n".join(errors))
    return table


def validate(table, matrix_envs, tagged=None):
    """The table, or `SystemExit`. Structure first, then the rules needing run context.

    `matrix_envs` is the environment set this operation resolved, and `tagged` the whole-tree
    scan where one exists, `{env: workload names its stacks tag}` -- only the unused-entry and
    untagged-workload warnings read it, and it is `None` on the paths that scan only a changed
    set or a workset, where an environment or workload absent from that set is not evidence
    of anything.
    """
    validate_structure(table)
    environments = table.get("environments", {})
    if table["layout"] == "tf_vars":
        _check_dry_coverage(environments, matrix_envs)
    if tagged is not None:
        _report_unused(table, tagged)
    return table


def _derived(layout, env, entry):
    """The identity variables a layout derives for one environment.

    The names are lowercase after the `TF_VAR_` prefix, which is what OpenTofu reads.
    A mis-cased name is not refused anywhere -- plan and apply derive it from the same
    table, so it hashes identically on both sides -- it just never reaches OpenTofu.
    """
    if layout == "tf_vars":
        return {"TF_VAR_env": env, "TF_VAR_region": entry.get("region", "")}
    if layout == "workspace":
        return {"TF_WORKSPACE": env}
    return {}


def _consulted(table, env, path):
    """`(shared, path)`: whether `env` is shared, and the path whose role a cell on `path`
    takes -- `apply` on both paths when shared. `resolve` and `resolved_roles` must agree."""
    shared = env in shared_envs(table)
    return shared, "apply" if shared else path


def _pick(value, workload):
    """A field's value for one workload: the string itself, or the map's entry, or ""."""
    if isinstance(value, dict):
        return value.get(workload, "")
    return value or ""


def _role(identity, entry, path, workload):
    """The role ARN a cell of `workload` assumes on `path`, the path already switched for a
    shared environment, or "".

    A varying identity gives a workload off the entry's list, or an untagged cell, no role:
    `{workload}` is never filled from a tag the default branch did not list. A name becomes
    `arn:aws:iam::<account>:role/<name>`; a value starting `arn:` is used as written.
    """
    aws = identity["aws"]
    if _varies(aws) and workload not in entry.get("workloads", ()):
        return ""
    role = _pick(aws.get(path), workload).replace(_PLACEHOLDER, workload)
    if not role or role.startswith("arn:"):
        return role
    account = _pick(aws.get("account"), workload)
    return f"arn:aws:iam::{account}:role/{role}" if account else ""


def outside_workloads(table, env, workload):
    """The entry's `workloads`, sorted, when `workload` is a tag that list does not name;
    else `None`.

    Only an entry naming an identity and writing the list refuses a tag. An untagged cell, an
    entry naming no identity (its tag is inert) and an entry without a list are never outside.
    """
    entry = table.get("environments", {}).get(env, {})
    listed = entry.get("workloads")
    if not workload or "identity" not in entry or listed is None or workload in listed:
        return None
    return sorted(listed)


def resolve(table, env, path, workload):
    """What one cell runs with: `role_arn`, `cred_region`, `tf_vars`, `config_path`,
    `env_binding`.

    `path` is the calling detect's path, never inferred; a shared environment resolves
    `aws.apply` on both paths, and `config_path` reports the path actually consulted rather
    than the one requested. `env_binding` is the GitHub Environment the cell's job binds,
    taken from `env_binding`. A `path` other than `plan` or `apply` raises KeyError. A
    reference in the table was resolved from a repository or organization variable by
    `parse_table`.

    The role comes from the identity the entry names. An empty `role_arn` means the caller
    skips the credentials step: no entry, no identity, no role for the path, a tag outside
    the entry's `workloads`, or a varying identity and a tag it does not list. It never raises
    on a validated table, including for a completed cell the table no longer lists. The
    workload is matched as written: `net-edge` and `net_edge` are two workloads. The
    environment's own `tf_vars` merges last, over the derivation.
    """
    environments = _mapping(table.get("environments", {}), "environments")
    entry = _mapping(environments.get(env, {}), f"environment {env}")
    shared, config_path = _consulted(table, env, path)
    role = ""
    if "identity" in entry and outside_workloads(table, env, workload) is None:
        role = _role(table["identities"][entry["identity"]], entry, config_path, workload)
    return {
        "role_arn": role,
        "cred_region": entry.get("region", "") if "identity" in entry else "",
        "tf_vars": {**_derived(table.get("layout"), env, entry), **entry.get("tf_vars", {})},
        "config_path": config_path,
        "env_binding": env_binding(env, shared, path),
    }


def resolved_roles(table):
    """`(env, path, workload, role_arn)` for every environment naming an identity, by env,
    then `plan` before `apply`, then the entry's `workloads` in written order.

    A non-varying identity gives one row per path with workload "", standing for every cell,
    or for untagged and listed cells when the entry writes `workloads`.
    A row whose `role_arn` is "" is a path the identity grants no credential on. Reads only a
    validated table.
    """
    rows = []
    for env, entry in sorted(table.get("environments", {}).items()):
        if "identity" not in entry:
            continue
        identity = table["identities"][entry["identity"]]
        workloads = entry.get("workloads", []) if _varies(identity["aws"]) else [""]
        for path in _ROLE_FIELDS:
            consulted = _consulted(table, env, path)[1]
            rows.extend((env, path, w, _role(identity, entry, consulted, w)) for w in workloads)
    return rows
