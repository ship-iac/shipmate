#!/usr/bin/env python3
"""Read the environment table from the repository's default branch.

Branch content cannot rewrite these values because they are not read from the
branch: the table is `git show`n out of `origin/<default>`. `origin` is the base
repository on every path -- no checkout in any workflow passes `repository:` -- and
a fork pull request is refused before it plans.
"""

import graphlib
import os
import re
import subprocess
import sys

#: The file the engine reads its settings from, and the interpreter floor that reading it
#: needs. The floor is CONTRACT.md section Runner prerequisites, which every runner already
#: promises; nothing in the engine installs or pins a Python, so this is the only place it
#: is checked.
CONFIG_PATH = ".github/shipmate.toml"
_MIN_PYTHON = (3, 11)


def _run(args, env=None, check=True):
    """stdout of `args`, raising ::error:: on a nonzero exit. `check=False` returns the
    CompletedProcess instead, for the two callers that report the failure themselves.

    `build-matrix` aliases this rather than keeping its own copy: this module `_load`s
    nothing, so reaching it from there terminates. The reverse would not -- `_shipmate.py`
    caches nothing and re-executes a module on every `_load`.
    """
    # args is a code-controlled tool invocation (gh/git/terramate by PATH name),
    # never user input, and shell=False -- safe.
    p = subprocess.run(args, capture_output=True, text=True, env=env)  # noqa: S603
    if not check:
        return p
    if p.returncode != 0:
        # Surface the tool's own error; a swallowed stderr makes CI opaque.
        sys.stderr.write(p.stderr)
        raise SystemExit(f"::error::command failed ({p.returncode}): {' '.join(args)}")
    return p.stdout


def _default_branch(run):
    """The default branch name, from the API rather than the event payload.

    `github.event.repository.default_branch` is not reliably populated under
    `schedule`; drift.yml resolves it this way for the same reason.
    """
    repo = os.environ["GITHUB_REPOSITORY"]
    return run(["gh", "api", f"repos/{repo}", "--jq", ".default_branch"]).strip()


def interpreter_refusal():
    """The refusal an under-floor interpreter earns, or `None`.

    Separately callable so `doctor` can run it outside the try that turns a `SystemExit`
    into a "this file is not valid" finding: the floor is a property of the runner, true
    of the default branch's copy too, and merging anything changes nothing about it. Lazy
    rather than module level, so an old interpreter can still import this module.
    """
    if sys.version_info >= _MIN_PYTHON:
        return None
    found = ".".join(str(n) for n in sys.version_info[:3])
    return (
        f"::error::{CONFIG_PATH} is read with tomllib, which needs Python "
        f"{_MIN_PYTHON[0]}.{_MIN_PYTHON[1]} or later; this runner has {found}. "
        "CONTRACT.md section Runner prerequisites requires python3 >= "
        f"{_MIN_PYTHON[0]}.{_MIN_PYTHON[1]} on every runner. Choose a newer "
        "runs_on image."
    )


def parse_table(text):
    """The table parsed from `text`, or `SystemExit`.

    Shared by both readers: `read_table` below reads the file with `git show`, and
    `doctor` reads the same bytes through the contents API, having no checkout. The
    interpreter check runs ahead of the import, because a module-level `import tomllib`
    would raise `ModuleNotFoundError` before any caller could report the real cause --
    an older runner image than CONTRACT.md requires.

    A leading U+FEFF is refused, not stripped: `tomllib` rejects it, `git show` and the
    contents API both deliver it, and both readers must reach the same verdict on the same
    file. Adding a strip here reddens test_a_byte_order_mark_is_reported_the_way_a_run_sees_it.
    """
    refusal = interpreter_refusal()
    if refusal:
        raise SystemExit(refusal)
    import tomllib

    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        raise SystemExit(f"::error::{CONFIG_PATH} is not valid TOML: {exc}") from exc


def read_table(run=None):
    """The table from the default branch. Every failure here refuses."""
    run = run or _run
    ref = f"origin/{_default_branch(run)}:{CONFIG_PATH}"
    p = run(["git", "show", ref], check=False)
    if p.returncode != 0:
        sys.stderr.write(p.stderr)
        raise SystemExit(
            f"::error::{CONFIG_PATH} could not be read from the default branch "
            f"({ref}). The engine reads the environment table from the default "
            "branch, never from this branch, so the file must be merged there "
            "before the first plan."
        )
    return parse_table(p.stdout)


#: The layouts a repository may declare, and the environment-level keys an entry may
#: hold. `aws` is the only provider implemented; a second one costs a field list here
#: and one conditional step in each cell action.
_LAYOUTS = ("dry", "workspace", "folder")
_AWS_FIELDS = ("region", "role")
_ENV_KEYS = ("region", "vars", "aws")

#: Reserved at every level: a tier selector, never a provider field.
_STRUCTURAL = ("plan", "apply", "workloads")

#: Everything the file may declare at its top level. Also the names reserved inside
#: `env_order`, which is keyed by environment name and would otherwise accept a
#: misplaced control as an ordering entry.
_TOP_KEYS = ("layout", "environments", "env_order", "explicit_envs", "gate", "version")

#: Everything a `[gate]` table may declare.
_GATE_KEYS = ("approvers_team", "ungated_envs")

#: Env names come from Terramate `env/<name>` tags, so the charset is comment-parse's env
#: grammar plus `_`, a legal tag character no `shipmate apply <env>` can name. Both cases are
#: accepted; the readers that compare an env name against this list do so case-insensitively.
_ENV_ENTRY = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*")


def _mapping(value, where):
    if not isinstance(value, dict):
        raise SystemExit(f"::error::{where} must be a mapping, got {type(value).__name__}.")
    return value


def _string(value, where):
    if not isinstance(value, str):
        raise SystemExit(f"::error::{where} must be a string, got {type(value).__name__}.")
    return value


def _fields(level, env, where, allowed_structural):
    """The provider fields of one level, refusing anything the schema does not give it."""
    fields = {}
    for key, value in level.items():
        if key in _STRUCTURAL:
            if key not in allowed_structural:
                raise SystemExit(
                    f"::error::environment {env}: {where}.{key} is a reserved key in a "
                    "position the schema does not give it. plan and apply sit inside a "
                    "provider block; workloads sits only under plan or apply."
                )
            continue
        if key == "vars":
            raise SystemExit(
                f"::error::environment {env}: {where}.vars is not a field the aws provider "
                "defines. vars sits at environment level: a per-tier one would let plan "
                "and apply inject different values, and every apply would then fail as "
                "stale."
            )
        if key not in _AWS_FIELDS:
            raise SystemExit(
                f"::error::environment {env}: {where}.{key} is not a field the aws "
                f"provider defines. It defines {', '.join(_AWS_FIELDS)}."
            )
        fields[key] = _string(value, f"environment {env}: {where}.{key}")
    return fields


def tiers(block, env, region):
    """Every tier of one provider block, as `(label, resolved fields)`.

    Block level, then the path, then the workload, each overriding the last field by
    field -- the merge order resolution repeats. The environment's own `region` inherits
    into the block, which is the schema's only cross-level default.
    """
    base = {"region": region} if region else {}
    base.update(_fields(_mapping(block, f"environment {env}: aws"), env, "aws", ("plan", "apply")))
    for path in ("plan", "apply"):
        where = f"aws.{path}"
        level = _mapping(block.get(path, {}), f"environment {env}: {where}")
        merged = {**base, **_fields(level, env, where, ("workloads",))}
        yield where, merged
        workloads = _mapping(level.get("workloads", {}), f"environment {env}: {where}.workloads")
        for name, workload in sorted(workloads.items()):
            inner = f"{where}.workloads.{name}"
            level_fields = _fields(
                _mapping(workload, f"environment {env}: {inner}"), env, inner, ()
            )
            yield inner, {**merged, **level_fields}


def _check_provider(block, env, region):
    """Refuse a block that authenticates nothing, or a tier that authenticates
    incompletely.

    A tier resolving no credential is legal: apply-only cloud access is a supported
    shape, and its plan path resolves an empty credential and skips the step.
    """
    resolved = list(tiers(block, env, region))
    if not any("role" in fields for _, fields in resolved):
        raise SystemExit(
            f"::error::environment {env}: the aws block resolves no role on any tier. "
            "Give aws, aws.plan, aws.apply or a workload a role, or remove the block."
        )
    for label, fields in resolved:
        if fields.get("role") == "":
            raise SystemExit(
                f"::error::environment {env}: {label} sets an empty role, which resolves to "
                "a skipped credentials step rather than to a credential. Give it a role, or "
                "remove the key."
            )
        if "role" in fields and "region" not in fields:
            raise SystemExit(
                f"::error::environment {env}: {label} resolves a role but no region, and "
                "the aws credentials step requires one. Set aws.region, or the "
                "environment's own region."
            )


def _check_vars(entry, env):
    """`TF_VAR_*` and `TF_WORKSPACE` only, and strings only.

    A non-string value would otherwise pass here and refuse once per cell at injection
    time -- forty identical failures in a forty-cell matrix instead of one at the top.
    """
    for name, value in sorted(_mapping(entry["vars"], f"environment {env}: vars").items()):
        if not name.startswith("TF_VAR_") and name != "TF_WORKSPACE":
            raise SystemExit(
                f"::error::environment {env}: vars may name only TF_VAR_* and "
                f"TF_WORKSPACE, and {name} is neither."
            )
        if not isinstance(value, str):
            raise SystemExit(
                f"::error::environment {env}: vars.{name} must be a string, got "
                f"{type(value).__name__}. A non-string value would otherwise refuse once "
                "per cell at injection time."
            )


def shared_env_names(raw):
    """The environments listed in `SHIPMATE_SHARED_ENVS`, as written.

    Split at commas without stripping, so a padded entry is unlisted here exactly as it is
    in `scripts/verify-environments` and the wave-job ternaries, which compare whole entries
    between comma boundaries. Case is normalized by `_is_shared`, not here.
    """
    return {e for e in raw.split(",") if e}


def _is_shared(env, shared_envs):
    """Whether `env` binds one shared environment rather than a plan/apply pair.

    Case-insensitive with `.lower()`, not `.casefold()`, to agree with the two readers this
    variable already has: `scripts/verify-environments` lowers, and the wave ternaries use
    GitHub's `contains()`. A case-exact reading here resolves the plan tier for a cell the
    workflow bound to the shared environment.
    """
    return env.lower() in {e.lower() for e in shared_envs}


def _check_environment(entry, env):
    """One entry's own shape. Nothing here reads context outside the file."""
    entry = _mapping(entry, f"environment {env}")
    for key in sorted(entry):
        if key not in _ENV_KEYS:
            raise SystemExit(
                f"::error::environment {env}: {key} is not a key this engine implements. "
                f"An environment holds {', '.join(_ENV_KEYS)}."
            )
    if "region" in entry:
        _string(entry["region"], f"environment {env}: region")
    if "vars" in entry:
        _check_vars(entry, env)
    if "aws" in entry:
        _check_provider(entry["aws"], env, entry.get("region"))


def _check_shared(environments, shared_envs):
    """The one environment rule that needs context the file does not carry.

    Membership comes from the `SHIPMATE_SHARED_ENVS` repository variable, so
    `validate_structure` cannot decide it and the structural-only caller skips it.

    Runs only after `validate_structure`, its sole caller's first step, which is what has
    already proven every entry and every `aws` block a mapping.
    """
    for env in sorted(environments):
        block = environments[env].get("aws")
        if block is None or not _is_shared(env, shared_envs):
            continue
        if "plan" in block:
            raise SystemExit(
                f"::error::environment {env} is shared between the plan and apply paths, so "
                "aws.plan cannot apply to it: a shared environment resolves aws.apply on both "
                f"paths. Remove aws.plan, or drop {env} from SHIPMATE_SHARED_ENVS."
            )


def _check_dry_coverage(environments, matrix_envs):
    """`dry` derives both identity variables from the table, so every cell needs an entry.

    An empty region is no region: `plan-classify` excludes an empty `TF_VAR_*` from the
    fingerprint, so the layout would derive nothing the cell could be distinguished by.
    """
    for env in sorted(matrix_envs):
        entry = environments.get(env)
        if entry is None:
            missing = "no entry in it"
        elif not _mapping(entry, f"environment {env}").get("region"):
            missing = "an entry with no region"
        else:
            continue
        raise SystemExit(
            '::error::layout = "dry" derives TF_VAR_env and TF_VAR_region from the '
            f"environment table, and {env} has {missing}."
        )


def _report_unused(environments, all_envs):
    """Name the entries no stack tags. A warning, deliberately, and never a refusal.

    The table is read from the default branch and the tags from the feature branch, so
    adding or removing an environment takes two pull requests; refusing an unused entry
    would deadlock both. Keys are matched exactly, as `resolve` and `_check_dry_coverage`
    match them -- an entry differing only in case resolves for nothing, so it is unused.
    """
    unused = sorted(set(environments) - set(all_envs))
    if unused:
        print(
            f"::warning::the environment table declares {', '.join(unused)}, which no stack "
            "tags. Remove the entry, or tag the stacks that belong to it. This is a warning "
            "rather than a refusal because the table is read from the default branch and the "
            "tags from this branch, so an environment arrives and leaves over two pull "
            "requests."
        )


def _validate_predecessors(env, preds):
    if not isinstance(preds, list):
        raise SystemExit(
            f"::error::env_order[{env!r}] must be a list of predecessor envs, "
            f"got {type(preds).__name__} ({preds!r}); did you mean [{preds!r}]?"
        )
    bad = [p for p in preds if not isinstance(p, str)]
    if bad:
        raise SystemExit(
            f"::error::env_order[{env!r}] predecessors must all be env-name "
            f"strings; got non-string element(s) {bad!r}"
        )


def validate_env_order(order):
    """`order`, or `SystemExit` unless it maps env -> list of env-name strings.

    Guards a bare string predecessor, which would otherwise be iterated character by
    character into an ordering nobody wrote, a non-mapping value, which reaches the graph
    builder as a raw `AttributeError`, and a cycle, which has no topological order at all.
    No caller reaches the graph builder with an unchecked order.
    """
    if not isinstance(order, dict):
        raise SystemExit(
            "::error::env_order must be a mapping of env -> [predecessor envs], "
            f"got {type(order).__name__} ({order!r})"
        )
    for env, preds in order.items():
        if env in _TOP_KEYS:
            raise SystemExit(
                f"::error::env_order[{env!r}] names a top-level setting, not an "
                "environment. A scalar written below a [table] header lands inside that "
                f"table, so `{env} = ...` after [env_order] becomes an ordering entry "
                "instead of a top-level setting. Move it above the first header in "
                f"{CONFIG_PATH}."
            )
        _validate_predecessors(env, preds)
    # After the shape checks, or the sorter consumes a string predecessor character by character.
    try:
        graphlib.TopologicalSorter(order).prepare()
    except graphlib.CycleError as exc:
        cycle = " -> ".join(exc.args[1])
        raise SystemExit(
            f"::error::env_order is cyclic: {cycle} — each of those must fully apply "
            "before the next, so the ordering has no first environment and no apply path "
            f"can sort it. Break the chain in {CONFIG_PATH}."
        ) from exc
    return order


def validate_env_name_list(envs, key):
    """`envs`, or `SystemExit` unless it is a list of bare env-name strings.

    The one env-name rule, shared by `explicit_envs`, `gate.ungated_envs` and the
    `SHIPMATE_UNGATED_ENVS` variable that `scripts/authorize` reads. `key` names the setting
    in every message. Guards a bare string, which would otherwise be iterated character by
    character, a non-list value, an entry no environment name can match, and an entry
    carrying a `-plan`/`-apply` environment suffix -- each of the last two is matched against
    the bare logical env name, matches nothing, and so excludes or exempts nothing while
    reading as if it did.

    Charset before suffix: a suffixed name passes the charset, so the two are separate
    checks, and this order gives `"dev eu-plan"` the message about its space.
    """
    if not isinstance(envs, list):
        raise SystemExit(
            f"::error::{key} must be a list of env-name strings, "
            f"got {type(envs).__name__} ({envs!r}); did you mean [{envs!r}]?"
        )
    bad = [e for e in envs if not isinstance(e, str)]
    if bad:
        raise SystemExit(
            f"::error::{key} elements must all be env-name strings; "
            f"got non-string element(s) {bad!r}"
        )
    for e in envs:
        if not _ENV_ENTRY.fullmatch(e):
            raise SystemExit(
                f"::error::{key} entry {e!r} is not an environment name; entries are bare "
                f"logical env names (letters, digits, '-' and '_'), with no quotes, spaces "
                f"or path separators."
            )
        for suffix in ("-plan", "-apply"):
            if e.endswith(suffix):
                raise SystemExit(
                    f"::error::{key} entry {e!r} carries the environment suffix "
                    f"{suffix!r}; {key} is matched against the bare logical env name — "
                    f"write {e[: -len(suffix)]!r} instead."
                )
    return envs


def validate_explicit_envs(envs):
    """`envs`, or `SystemExit`: the shared env-name rule, reported under this key."""
    return validate_env_name_list(envs, "explicit_envs")


def validate_gate(gate):
    """One `[gate]` table's shape, or `SystemExit`.

    Strict keys, as an environment entry is: a misspelled gate key leaves the setting at its
    default while the repository believes it declared one.
    """
    gate = _mapping(gate, "gate")
    for key in sorted(gate):
        if key not in _GATE_KEYS:
            raise SystemExit(
                f"::error::gate.{key} is not a key this engine implements. "
                f"The gate table holds {', '.join(_GATE_KEYS)}."
            )
    if "approvers_team" in gate:
        _string(gate["approvers_team"], "gate.approvers_team")
    if "ungated_envs" in gate:
        validate_env_name_list(gate["ungated_envs"], "gate.ungated_envs")
    return gate


def _check_version(table):
    """Refuse a file declaring a schema version this engine does not implement.

    A bool is excluded explicitly: `True == 1` in Python, so a plain comparison reads
    `version = true` as version 1.
    """
    found = table["version"]
    if not (isinstance(found, int) and not isinstance(found, bool) and found == 1):
        raise SystemExit(
            f"::error::version is {found!r}; this engine implements version 1 of {CONFIG_PATH}."
        )


def validate_structure(table):
    """Everything the file can be judged on by itself, or `SystemExit`.

    Every top-level field, so a "valid configuration" verdict cannot hide an ordering
    or exclusion error until an apply reads it. `doctor` validates a branch's file with
    this alone: the rules left to `validate` need a checkout, a matrix or a repository
    variable, none of which a file on its own supplies.

    `layout` is required: it is the only source of a cell's environment identity, so a
    table without one leaves every cell with nothing to run as.
    """
    for key in sorted(table):
        if key not in _TOP_KEYS:
            raise SystemExit(
                f"::error::{key} is not a setting this engine implements. "
                f"{CONFIG_PATH} holds {', '.join(_TOP_KEYS)}."
            )
    if "version" in table:
        _check_version(table)
    if "layout" not in table:
        raise SystemExit(
            f"::error::{CONFIG_PATH} declares no layout, so no cell can resolve its "
            'environment identity. Declare layout = "dry", "workspace" or "folder" on the '
            "default branch, which is where this table is read from. A scalar written below "
            "a [table] header lands inside that table rather than at the top level, so "
            "layout must come before the first header."
        )
    # Key presence, not a truthy value: an empty layout is a declared layout holding a value
    # no layout may hold, and must say so rather than read as undeclared.
    layout = table["layout"]
    if layout not in _LAYOUTS:
        raise SystemExit(f"::error::layout is {layout!r}; it must be one of {', '.join(_LAYOUTS)}.")
    environments = _mapping(table.get("environments", {}), "environments")
    for env in sorted(environments):
        _check_environment(environments[env], env)
    validate_env_order(table.get("env_order", {}))
    validate_explicit_envs(table.get("explicit_envs", []))
    validate_gate(table.get("gate", {}))
    return table


def validate(table, matrix_envs, shared_envs, all_envs=None):
    """The table, or `SystemExit`. Structure first, then the rules needing run context.

    `matrix_envs` is the environment set this operation resolved, `shared_envs` the
    `SHIPMATE_SHARED_ENVS` listing, and `all_envs` the whole-tree environment scan where
    one exists -- only the unused-entry warning reads it, and it is `None` on the paths
    that scan only a changed set or a workset, where an environment absent from that set
    is not evidence of anything.
    """
    validate_structure(table)
    environments = table.get("environments", {})
    _check_shared(environments, shared_envs)
    if table["layout"] == "dry":
        _check_dry_coverage(environments, matrix_envs)
    if all_envs is not None:
        _report_unused(environments, all_envs)
    return table


def _derived(layout, env, entry):
    """The identity variables a layout derives for one environment.

    The names are lowercase after the `TF_VAR_` prefix, which is what OpenTofu reads.
    A mis-cased name is not refused anywhere -- plan and apply derive it from the same
    table, so it hashes identically on both sides -- it just never reaches OpenTofu.
    """
    if layout == "dry":
        return {"TF_VAR_env": env, "TF_VAR_region": entry.get("region", "")}
    if layout == "workspace":
        return {"TF_WORKSPACE": env}
    return {}


def resolve(table, env, path, workload, shared_envs):
    """What one cell runs with: `role_arn`, `cred_region`, `tf_vars`, `config_path`.

    `path` is the calling detect's tier, never inferred; a shared environment resolves
    `aws.apply` on both paths, and `config_path` reports the tier actually consulted
    rather than the one requested. There is no fallback to `vars.*`: an environment with
    no entry resolves an empty role and the caller skips the credentials step.

    The workload tier is keyed by the raw `workload` tag value, never by a normalized
    form of it: `net-edge` and `net_edge` are two workloads. The environment's own `vars`
    merges last, over the derivation.
    """
    environments = _mapping(table.get("environments", {}), "environments")
    entry = _mapping(environments.get(env, {}), f"environment {env}")
    config_path = "apply" if _is_shared(env, shared_envs) else path
    fields = {}
    if "aws" in entry:
        resolved = dict(tiers(entry["aws"], env, entry.get("region")))
        label = f"aws.{config_path}"
        inner = f"{label}.workloads.{workload}"
        fields = resolved[inner] if inner in resolved else resolved.get(label, {})
    return {
        "role_arn": fields.get("role", ""),
        "cred_region": fields.get("region", ""),
        "tf_vars": {**_derived(table.get("layout"), env, entry), **entry.get("vars", {})},
        "config_path": config_path,
    }
