#!/usr/bin/env python3
"""Resolve the pull-request facts the plan path decides on, for either trigger.

One producer for eight values -- head SHA, head repository, head branch, base SHA, base
branch, pull-request number, draft flag, and whether a human named this run -- so the fork
refusal, the draft skip, the checkout ref, the behind check and the plan's recorded provenance
cannot read two different answers to the same question.

Payload-preferred. Under `pull_request` / `pull_request_target` every value comes
from GITHUB_EVENT_PATH, so the autoplan path cannot disagree with the event that
started it (the API answers with the head as it is NOW, which on a rapid re-push
is a different commit). One exception: a payload that says draft re-reads the
draft flag once from the API, since a ready click seconds after a push leaves the
push's run holding a stale draft payload; that read can only turn a draft skip
into a plan. A `workflow_dispatch` payload carries no pull request, so the
`pr_number` it does carry is resolved through the API instead.

Nothing here reads a head SHA or a head repository from a dispatch input. The
number is the only thing a dispatcher states, and a number cannot lie about its
own head repository -- `build-matrix`'s fork refusal keys on the head repository
this script emits, and a caller holding `actions: write` must not be able to
state it.
"""

import os
import sys

from _shipmate import (
    READ_ERRORS,
    command_data,
    event_payload,
    exit_text,
    is_pr_number,
    one_line,
    run_annotated,
    write_outputs,
)
from _shipmate import gh_json as _gh_json

_DELETED_FORK = (
    "::error::this pull request's head repository no longer exists (a deleted fork), so "
    "there is nothing to check the fork refusal against, and planning it would run code "
    "from a repository that is gone. Close the pull request, or push the branch to this "
    "repository and open it here."
)


def _facts(pr, on_demand):
    """The eight facts from a pull-request object -- payload or API, same shape.

    Refuses rather than emitting an empty value for anything nothing else can
    supply: an absent head SHA leaves the checkout on the base and the matrix
    empty, which is the direction that greens a gate over a pull request nobody
    planned.

    `state` is checked here, on both legs: planning a closed pull request would
    author fresh pending apply checks on a head the deploy path has already been
    through, and `deploy-detect`'s work queue IS the pending apply checks -- a
    re-run of that deploy would apply them again.

    `head_ref` alone is optional: it only decides whether a lock holder is stacked on this pull
    request, which the plan comment reports, so an absent one is emitted empty.
    """
    head = pr.get("head") or {}
    repo = head.get("repo") or {}
    ref = head.get("ref")
    base = pr.get("base") or {}
    base_ref = base.get("ref")
    facts = {
        "head_sha": head.get("sha") or "",
        "head_repo": repo.get("full_name") or "",
        "head_ref": ref if isinstance(ref, str) else "",
        "base_sha": base.get("sha") or "",
        "base_ref": base_ref if isinstance(base_ref, str) else "",
        "pr_number": str(pr.get("number") or ""),
        "is_draft": "true" if pr.get("draft") is True else "false",
        "on_demand": on_demand,
    }
    if not facts["head_repo"]:
        raise SystemExit(_DELETED_FORK)
    missing = [key for key in ("head_sha", "base_sha", "base_ref", "pr_number") if not facts[key]]
    if missing:
        raise SystemExit(
            "::error::this run's pull request is missing " + ", ".join(missing) + ". Every "
            "pull request has them, so the event payload was unreadable or the API answered a "
            "partial object. Nothing else names the commit to plan: without it the checkout "
            "stays on the base, the matrix comes out empty, and the gate greens with nothing "
            "queued to apply. Re-run the workflow."
        )
    state = pr.get("state")
    if state != "open":
        raise SystemExit(
            f"::error::pull request #{facts['pr_number']} is {state or 'in an unknown state'}, "
            "not open, so there is nothing to plan. Planning a closed pull request would queue "
            "apply checks on a head the deploy path has already been through."
        )
    return facts


def from_api(number, repository):
    """The facts for a dispatched plan, read from the API by number."""
    if not is_pr_number(number):
        raise SystemExit(
            f"::error::the plan workflow's pr_number input must be a pull-request number "
            f"(got: {number!r}). A dispatched plan sends it; a hand-dispatched run has to "
            "name it."
        )
    if not repository:
        raise SystemExit(
            "::error::GITHUB_REPOSITORY is unset, so this run cannot look up its own pull "
            "request. Re-run the workflow."
        )
    return _facts(_gh_json(f"repos/{repository}/pulls/{number}"), "true")


def draft_now(repository, number):
    """`"true"`, `"false"` or `""`: pull request `number`'s draft flag from one API read, for a
    payload that said draft. A failed read or a `draft` that is not a bool returns `""` and prints
    one `::warning::` naming the cause; the caller treats `""` as a draft."""
    try:
        draft = _gh_json(f"repos/{repository}/pulls/{number}")["draft"]
    except READ_ERRORS as exc:
        cause = exit_text(exc) if isinstance(exc, SystemExit) else repr(exc)
    else:
        if isinstance(draft, bool):
            return "true" if draft else "false"
        cause = f"draft is {draft!r}"
    print(
        f"::warning::could not re-read whether pull request #{number} is still a draft "
        f"({command_data(one_line(cause))}); this run skips as a draft",
        file=sys.stderr,
    )
    return ""


def main():
    # An unreadable payload is {}: it names no pull request and no `pr_number`, so the run is
    # refused rather than planned.
    payload = event_payload(os.environ.get("GITHUB_EVENT_PATH", ""))
    pr = payload.get("pull_request")
    provenance = ""
    if isinstance(pr, dict) and pr:
        facts = _facts(pr, "false")
        if facts["is_draft"] == "true":
            now = draft_now(os.environ.get("GITHUB_REPOSITORY", ""), facts["pr_number"])
            # A failed read keeps the payload's draft, so the read can only turn a skip into a plan.
            facts["is_draft"] = now or "true"
            reread = f"draft={now}" if now else "failed"
            provenance = f" (payload draft=true, re-read {reread})"
    else:
        number = str((payload.get("inputs") or {}).get("pr_number") or "").strip()
        if not number:
            raise SystemExit(
                "::error::this run has neither a pull request nor a pr_number input, so there "
                "is nothing to plan. A pull-request event supplies the first and a dispatched "
                "plan the second. Declare a `pr_number` input under "
                "`.github/workflows/shipmate.yml`'s `workflow_dispatch` trigger, and dispatch "
                "with `verb: plan` (see `docs/getting-started.md`)."
            )
        facts = from_api(number, os.environ.get("GITHUB_REPOSITORY", ""))
    write_outputs(**facts)
    print(
        f"pull request #{facts['pr_number']} at {facts['head_sha']} "
        f"({facts['head_repo']}), draft={facts['is_draft']}{provenance}, "
        f"on-demand={facts['on_demand']}"
    )


if __name__ == "__main__":
    run_annotated(main)
