#!/usr/bin/env python3
"""Write a drift cell's $RUNNER_TEMP/cell.json, the only channel by which its drift is visible.

Used by actions/drift-cell's `Compose cell summary` step, which runs on always(): a state
restore or the plan itself may have failed, and drift-issues must never auto-close an Issue for
a stack x env whose plan attempt did not succeed.
"""

import json
import os


def main():
    # plan_ok is false whenever `Plan + classify drift` did not conclude with success,
    # 'skipped' included. drift-issues treats such a cell as unknown and leaves its Issue
    # state untouched, rather than reading a missing or blank DRIFTED output as "clean".
    plan_ok = os.environ["PLAN_OUTCOME"] == "success"
    cell = {
        "stack": os.environ["STACK"],
        "stack_name": os.environ["STACK_NAME"],
        "environment": os.environ["ENV"],
        "plan_ok": plan_ok,
        "drifted": plan_ok and os.environ["DRIFTED"] == "true",
        "add": int(os.environ["ADD"]) if plan_ok else 0,
        "change": int(os.environ["CHANGE"]) if plan_ok else 0,
        "destroy": int(os.environ["DESTROY"]) if plan_ok else 0,
    }
    cell_path = os.path.join(os.environ["RUNNER_TEMP"], "cell.json")
    with open(cell_path, "w") as fh:
        json.dump(cell, fh)


if __name__ == "__main__":
    main()
