#!/usr/bin/env python3
"""Read and write the `shipmate / gate` commit status: the one script that does either. Its
`checks` subcommand serves `_shipmate.check_runs` to the bash sites.

    gate-status newest <sha>                     print `<state> <run id>` of the newest gate
    gate-status refuse-newer <sha>               exit `NEWER` when a newer run holds the gate
    gate-status post <sha> <state> <description> write the gate
    gate-status hold <sha> <description>         write a `failure` gate
    gate-status refresh <sha>                    green the gate once every apply check is done
    gate-status deploy <sha> <detect> <results>  write the post-merge verdict over job results
    gate-status checks <sha> <jq>                print one `jq` projection per line of check runs

The gate is a commit status, not a check-run: a check-run binds to a check-suite and can land in
a stale one when a commit carries two plan runs, which blocks the merge forever. Every write sets
`target_url` to this run. Env: `GH_TOKEN`, `GITHUB_REPOSITORY`, `GITHUB_SERVER_URL`,
`GITHUB_RUN_ID`, and `SHIPMATE_APP_ID` for `refresh`. A `<sha>` that is not 40 lowercase hex
characters is refused before any API call. A failed API call exits 1 with an `::error::` line,
except in `checks`. `refresh` over a hold prints why, unannotated, and exits `HELD`: each caller
decides whether a hold fails its step. `refuse-newer` prints its refusal as an `::error::` line
and exits `NEWER`, so a caller tells a newer run from a failed read (exit 1). `checks` serves
`_shipmate.check_runs` to the bash sites: UTF-8 with LF line ends on any host, and a malformed
`<sha>` or a failed listing exits 1 unannotated: a caller that degrades prints the only
annotation as a warning, and a fail-closed caller prints its own `::error::`.
"""

import os
import re
import sys

from _shipmate import (
    GATE_CONTEXT,
    _load,
    _run,
    check_runs,
    current_run_url,
    run,
    run_annotated,
    validate_head_sha,
)

ag = _load("apply-gate")

_RUN_ID = re.compile(r"/actions/runs/([0-9]+)$")
#: The fields `apply-gate` judges.
_CHECK_RUNS_JQ = ".check_runs[] | {name, status, conclusion, started_at, id, app: {id: .app.id}}"
_STATUSES_JQ = ".[] | {context, state, target_url}"
_GOOD_RESULTS = {"success", "skipped"}
HELD = 3
NEWER = 4


def _repo():
    return os.environ["GITHUB_REPOSITORY"]


def deploy_verdict(detect, results):
    """(state, description) over a deploy run's `detect` result and its comma-separated job
    results.

    An empty `detect` is a caller that passed no result. A `detect` that did not succeed applied
    nothing: it refused or stopped after writing the head.
    Otherwise any result but `success` or `skipped` (failure, cancelled, timed_out) is incomplete,
    and so is an empty `results`: no env-level job reported, so nothing was applied."""
    if not detect:
        return "failure", "deploy gate got no detect result; see the run"
    if detect != "success":
        return "failure", f"deploy stopped at detect ({detect}), nothing applied; see the run"
    tokens = results.split(",")
    if all(t in _GOOD_RESULTS for t in tokens):
        return "success", "all env-levels applied (deploy env-level applies completed)"
    return "failure", "deploy incomplete (deploy env-level applies completed)"


def _gates(sha):
    """`(state, run id)` of every gate status on `sha`, newest first.

    The run id is the `/actions/runs/<id>` suffix of `target_url`, `-` when it has none. The
    statuses listing is paginated: a head with many other contexts can push its gate past the
    first page."""
    out = _run(
        [
            "gh",
            "api",
            "--paginate",
            f"repos/{_repo()}/commits/{sha}/statuses?per_page=100",
            "--jq",
            _STATUSES_JQ,
        ]
    )
    gates = []
    for status in ag.parse_jsonl(out.splitlines()):
        if status.get("context") == GATE_CONTEXT:
            m = _RUN_ID.search(status.get("target_url") or "")
            gates.append((status["state"], m.group(1) if m else "-"))
    return gates


def newest_gate(sha):
    """(state, run id) of the newest gate status on `sha`, or None when it carries none."""
    gates = _gates(sha)
    return gates[0] if gates else None


def newer_hold(sha):
    """The highest run id among the `failure` gates on `sha` written by a run newer than this one,
    or None.

    Every status in the history counts, not only the newest: this run's own hold, written after a
    failed read, must not hide a newer run's earlier one. Only plan runs write a `failure` gate
    before a merge, so a newer one is a newer plan of the same head."""
    this_run = os.environ.get("GITHUB_RUN_ID", "")
    if not re.fullmatch(r"[0-9]+", this_run):
        raise SystemExit(f"::error::GITHUB_RUN_ID must be a decimal run id (got: {this_run!r})")
    runs = [
        int(run)
        for state, run in _gates(sha)
        if state == "failure" and run != "-" and int(run) > int(this_run)
    ]
    return max(runs) if runs else None


def post(sha, state, description):
    _run(
        [
            "gh",
            "api",
            f"repos/{_repo()}/statuses/{sha}",
            "-f",
            f"state={state}",
            "-f",
            f"context={GATE_CONTEXT}",
            "-f",
            f"description={description[:140]}",
            "-f",
            f"target_url={current_run_url()}",
        ]
    )


def refresh(sha):
    """Green the gate when every App-authored apply check on `sha` is done and no hold stands.

    A hold must not be cleared by the applies it exists to prevent: `shipmate apply` never
    consults the gate, so the parsed cells can all complete while stacks whose summaries were
    never read have no apply check at all. Only a fresh plan run exits a hold.

    A check re-created mid-apply stays open until its own plan is applied: `apply-gate` judges
    the newest run per name."""
    out = check_runs(_repo(), sha, _CHECK_RUNS_JQ)
    runs = ag.app_runs(out.splitlines(), os.environ.get("SHIPMATE_APP_ID", ""))
    if ag.verdict(runs) == "pending":
        open_ = sorted(set(ag.latest_by_name(runs)) - ag.done_names(runs))
        print(
            f"apply checks on {sha} are not all done ({len(open_)} open); the gate is left as it is"
        )
        return
    newest = newest_gate(sha)
    if newest and newest[0] == "failure":
        print(
            f"{GATE_CONTEXT} is held for {sha}; its status description on the pull request names "
            "the cause. A hold clears only when a new plan run rewrites the gate: comment "
            "shipmate plan, or push."
        )
        raise SystemExit(HELD)
    post(sha, "success", "all applies complete, nothing left to apply")


def _newest(sha):
    newest = newest_gate(sha)
    if newest:
        print(*newest)


def _refuse_newer(sha):
    newer = newer_hold(sha)
    if newer is not None:
        print(
            f"::error::plan run {newer} holds the gate of {sha} and is newer than this run "
            f"({os.environ['GITHUB_RUN_ID']}); this run stops without writing its final gate. "
            "Re-plan this pull request (comment shipmate plan or push) if that run did not "
            "finish.",
            file=sys.stderr,
        )
        raise SystemExit(NEWER)


def _checks(sha, jq):
    # Bytes, not `print`: a Windows text stdout re-encodes through the code page and writes CRLF.
    sys.stdout.buffer.write(check_runs(_repo(), sha, jq, run=run).encode("utf-8"))


#: command -> (argument count after the sha, handler)
_COMMANDS = {
    "newest": (0, _newest),
    "refuse-newer": (0, _refuse_newer),
    "checks": (1, _checks),
    "post": (2, post),
    "hold": (1, lambda sha, description: post(sha, "failure", description)),
    "refresh": (0, refresh),
    "deploy": (2, lambda sha, detect, results: post(sha, *deploy_verdict(detect, results))),
}


def main(argv):
    cmd, *args = argv or [""]
    if cmd not in _COMMANDS or len(args) != _COMMANDS[cmd][0] + 1:
        raise SystemExit(
            f"::error::usage: gate-status {'|'.join(_COMMANDS)} <sha> ... (got {argv})"
        )
    sha = args[0]
    if cmd == "deploy" and not sha:
        raise SystemExit("::error::detect produced no head SHA; deploy cannot gate")
    # Unannotated for `checks`: each caller annotates, as a warning where it degrades.
    validate_head_sha(sha, "head SHA", annotate=cmd != "checks")
    _COMMANDS[cmd][1](*args)


if __name__ == "__main__":
    run_annotated(main, sys.argv[1:])
