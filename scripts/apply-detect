#!/usr/bin/env python3
"""Apply detect: a dispatched apply's work set + waves, bare or targeted.

The dispatched workflow is the consumer's `shipmate.yml`, whose `apply` job
the `verb: apply` body selects; the engine's own `apply.yml` is `workflow_call`
and is what that job calls, and it runs this in the `detect` job of the
`apply-run.yml` it calls in turn.

Both forms source the work set from the head's own apply checks: a stack
belongs to this run when `apply / <env> / <path>` is among the App-authored
checks on the head, and the plan run it applies from is the one that check
records. Cells whose apply check already completed are dropped (idempotent
no-op), and the rest wave-ordered. Both write the env-level output contract
deploy-detect writes (`waves.env_level_outputs`), and the apply result comment's fields to a
report file (`write_report`).

An empty `SHIPMATE_ENV` selects the bare form, `bare_main`: every environment's
pending cells, bucketed into env-levels by the entries' `needs`, after the
exclusions its docstring names.

Before reading the head's checks, the bare and targeted forms wait while a `shipmate plan` run of
the pull request is live (`wait_for_plans`), up to `PLAN_WAIT` seconds of elapsed time, then
refuse a cell whose record names a run they waited for (`refuse_replanned`): that run's plan is
one no reviewer has seen. The auto form does not wait. `PLAN_WAIT` rests on the dispatched plan
runs of `ship-iac/repo-example-stacks` (50, 2026-09-29 to 2026-11-22) and
`ship-iac/repo-example-stacks-aws` (13, 2026-09-07 to 2026-10-18), `createdAt` to `updatedAt`:
all 63 median 76 s, p90 141 s, max 369 s (a failure); the 39 successes median 86 s, p90 202 s,
max 264 s. A large consumer's distribution is unknown.

The bare and targeted forms refuse the whole run when a cell they would apply is behind the
base (`refuse_behind`). Every form refuses it when another run holds the apply check of a cell
it would apply `in_progress` and may still apply that cell, or may have (`refuse_held`).

A named environment selects the targeted form, scoped to that ONE environment.
It does not order by `needs`: it passes `waves.env_level_waves` an empty order,
which puts every cell at env-level 0 and leaves levels 1-3 empty. A cell that runs
after a cell pending in another environment waits (`waves.waiting_cells`): it stays
pending, `waiting_cells` names it, and the rest apply. A cell another pull request
holds a cell lock on stays pending the same way, named in `held_cells` (both forms),
and the cells that run after it wait. Before any of that, the
PR's review decision — read server-side by the `review` job, narrowed by
`review: false` on the environment's entry — must authorize this environment, or
the run refuses.

`SHIPMATE_AUTO=true` selects the auto form, `bare_main(auto=True)`: the bare form over the
`apply_mode: auto` environments alone, dispatched by the App after an autoplan, which also
refuses unless the actor, the plan's provenance, the autoplan actor's permission and the pull
request's mergeability hold, and holds a cell whose stack the merge of the base into the
branch changes or whose apply check records that its plan found the base changed it, and a cell
an earlier apply run attempted and did not apply: an auto run never retries a cell unattended.
"""

import json
import os
import pathlib
import sys
import time

from _shipmate import (
    READ_ERRORS,
    RUN_CHECK,
    Refused,
    _load,
    _run,
    check_runs,
    command_data,
    current_run_url,
    decoded,
    env_pr_number,
    exit_text,
    gh_json,
    is_run_id,
    listed_jobs,
    live_plan_runs,
    named,
    one_line,
    run_annotated,
    sleep,
    status_text,
    validate_head_sha,
    write_outputs,
)

bm = _load("build-matrix")
wv = _load("waves")
ag = _load("apply-gate")
az = _load("authorize")
cl = _load("cell-lock")

#: The auto form's mergeability wait: reads, and seconds between them. Unprobed: GitHub
#: documents no bound on computing `mergeable` after a push.
_MERGEABLE_READS = 12
_MERGEABLE_WAIT = 5
_sleep = time.sleep
#: The commanded forms' wait for live `shipmate plan` runs: elapsed seconds on `_clock`, and
#: seconds between polls. 63 dispatched sample plan runs (2026-11-24), all 63: median 76 s,
#: p90 141 s; longest success 264 s; 480 s is 1.8 times that. More in the module docstring.
PLAN_WAIT = 480
PLAN_POLL = 30
#: Seconds a wait that waited on a run sleeps before the checks are read: a check-run listing can
#: lag its write by about a second, so a check the last waited run created may not list yet.
PLAN_SETTLE = 5
_clock = time.monotonic
_AUTO_REMEDY = "Comment `shipmate apply` on the pull request to apply it."
# An auto run has no comment to repeat: its draft and mergeability refusals name the comment.
_AUTO_RETRY = "comment `shipmate apply`"


def write_report(report):
    """Write the complete `report`, marked `"complete": true`, as JSON to `SHIPMATE_REPORT_PATH`,
    which the caller uploads as an artifact for the apply result comment; nothing else reads it.
    Its fields: `excluded_envs`, `skipped_envs`, `skipped_after`, `review_held_envs` and
    `applied_exempt_envs` (bare and auto forms), `review_not_required_envs`, `waiting_cells`,
    `held_cells` and `env_order` (every form), `pusher` and `bare_envs` (auto form), as each
    form's docstring describes them; a behind refusal writes only `behind` and `base`
    (`refuse_behind`). A file, not a job output: the report has no size cap, and
    GitHub drops a whole job output when any substring of it is masked."""
    path = pathlib.Path(os.environ["SHIPMATE_REPORT_PATH"])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({**report, "complete": True}), encoding="utf-8")


def paths_with_checks(env, candidate_paths, check_names):
    """The candidates whose `apply / <env> / <path>` check is on the head.

    Forward-construct the expected name per candidate path, never parse it back:
    `pending-checks` builds these names from the stack PATH, so constructing from the
    exact path is what binds each cell to its own check. Nothing here resolves a slug,
    which is what let two paths slugging alike apply each other's plan."""
    return [p for p in candidate_paths if ag.check_name(p, env) in check_names]


def cells_for_env(env, paths, tags_by_stack):
    """Wave cells for `paths` in `env`.

    The workload comes from the tags, never from the check name — the name
    carries no workload. A stack missing from the map raises `KeyError`: `tags_of`
    refuses such a stack first. A stack carrying two `workload/*` tags refuses
    (`workload_of`)."""
    return [
        {"stack": p, "environment": env, "workload": bm.workload_of(tags_by_stack[p], p)}
        for p in paths
    ]


def with_plan_runs(cells, check_run_lines, app_id, *, pr_number):
    """Each cell gains the plan run id and the plan-text digest ITS OWN check
    records in `check_run_lines`, so a cell recovered by a re-run plan job downloads
    from the run that re-planned it, and is bound to the plan text reviewed for it,
    while its siblings stay on the original.

    Both are read only from records App `app_id` wrote. That App authorship is what
    binds a run id to the plan workflow; there is no workflow-path check to re-add.

    A cell whose newest check records no usable run refuses. The alternative —
    falling back to a lookup keyed on a plan run's head_sha — is the platform
    dependency this path exists to drop, and a default would apply a cell from
    nowhere. Only cells still to be applied reach here: an applied cell needs no
    record, so a completed check that carries none never blocks its siblings.

    A cell with a run but no digest refuses separately, and says so separately:
    the causes differ, and a reader told "no plan run" would go looking for a
    check that exists. It refuses rather than applying unverified because an
    accepted absence is a guard the plan cell switches off by omitting a file.

    The run and digest refusals are shared by all three detects, so they are
    worded for both paths: deploy's candidates come from the git diff rather than
    from the checks, so a cell here may have no apply check whatsoever, and its
    pull request is already merged — a remedy phrased as "re-plan on this pull
    request" would send a post-merge operator to a pull request that no longer
    accepts commits. The partial-run refusal words its remedy for the path instead.

    `pr_number` binds each record to the dispatching pull request, and only the
    pre-merge paths pass one: a cell whose check records another pull request,
    or none, refuses with a re-plan remedy. Deploy passes None, which skips the
    check, because its pull request comes from the merge's mapping to its pull
    request (`commits/{sha}/pulls`, else the branch's closed pull requests)
    rather than from a dispatch input.

    With at least one cell to apply, a run that published only part of its apply
    checks refuses last (`refuse_incomplete`): a cell recording it, or the head's
    newest run being it, means a cell that run planned may be missing from this
    apply's view, and with it an ordering. It follows the pull-request binding so
    that a cell planned on another pull request is refused as that, not over the
    other pull request's run. With no cell to apply nothing is read, so a fully
    applied pull request whose records predate the count never refuses."""
    records = ag.plan_records(check_run_lines, app_id)
    rows = []
    for c in cells:
        name = ag.check_name(c["stack"], c["environment"])
        run, digest, pr = records.get(name, (None, None, None))
        rows.append((c, name, run, digest, pr))
    missing = [name for _, name, run, _, _ in rows if not run]
    if missing:
        raise SystemExit(
            f"::error::apply aborted: no plan run recorded for {', '.join(missing)}: the "
            "apply check names no plan run to apply from (post-merge, the cell may have no "
            "apply check at all), so the apply is refused. Re-plan these stacks on their pull "
            "request, then apply again; if that pull request has already merged, a new pull "
            "request touching them plans and applies them afresh."
        )
    unbound = [name for _, name, _, digest, _ in rows if not digest]
    if unbound:
        raise SystemExit(
            f"::error::apply aborted: no plan-text digest recorded for {', '.join(unbound)}: "
            "the reviewed plan text cannot be checked against the plan that would be applied, "
            "so this apply is refused rather than run unverified. Re-plan these stacks on "
            "their pull request, then apply again; if that pull request has already merged, a "
            "new pull request touching them plans and applies them afresh."
        )
    foreign = [
        f"{name} (plan run {run}, {'pull request #' + pr if pr else 'records no pull request'})"
        for _, name, run, _, pr in rows
        if pr_number is not None and pr != pr_number
    ]
    if foreign:
        raise SystemExit(
            f"::error::apply aborted: the plan recorded for {', '.join(foreign)} was not made "
            f"on pull request #{pr_number}, so this apply is refused. Re-plan on this pull "
            "request (push or comment `shipmate plan`), then apply again; if another open pull "
            "request shares this head commit, the newest plan decides which one may apply."
        )
    if cells:
        refuse_incomplete(
            rows, records, ag.incomplete_runs(check_run_lines, app_id), merged=pr_number is None
        )
    return [{**c, "plan_run_id": run, "plan_sha256": digest} for c, _, run, digest, _ in rows]


def _fact(published, counts, uncounted):
    """Every cause `apply-gate.incomplete_runs` found for one run, joined with `and`: an
    uncounted record, and a count that disagrees with another or with the checks published."""
    facts = []
    if uncounted:
        facts.append(
            f"records no planned cell count on {'some of ' if counts else ''}its apply checks"
        )
    if len(counts) > 1:
        listed = ", ".join(map(str, counts))
        facts.append(f"records disagreeing planned cell counts ({listed}) on its apply checks")
    elif counts and counts[0] != published:
        facts.append(
            f"published {_n(published, 'apply check')} for {_n(counts[0], 'planned cell')}"
        )
    return " and ".join(facts)


def _n(count, noun):
    return f"{count} {noun}{'' if count == 1 else 's'}"


def _stopped_publishing(published, counts, uncounted):
    """Fewer checks than one agreed count: the summary job stopped mid-publish, which fails it,
    and re-running the run's failed jobs publishes the rest. No other fact says a job failed."""
    return not uncounted and len(counts) == 1 and published < counts[0]


def refuse_incomplete(rows, records, incomplete, *, merged):
    """Refuse when a run that a cell to apply records, or the head's newest run, published only
    part of its apply checks (`apply-gate.incomplete_runs`). Each such run is named with its
    fact and the cells it holds back: the cells recording it, or every cell to apply when no
    cell records it (the newest run). Runs compare as integers, so `10` is newer than `9`.
    Called only with at least one cell, each recording a run, so the newest run exists. The
    remedy follows the pull request's state: open, it offers re-running failed jobs only when
    every named run `_stopped_publishing`, then a push; `merged`, a new pull request."""
    candidates = {run for _, _, run, _, _ in rows}
    candidates.add(max((run for run, _, _ in records.values() if run), key=int))
    named_runs = sorted(candidates & incomplete.keys(), key=int)
    if not named_runs:
        return
    found = []
    for run in named_runs:
        held = [name for _, name, r, _, _ in rows if r == run] or [name for _, name, *_ in rows]
        found.append(
            f"plan run {run} {_fact(*incomplete[run])}, holding back {named(held, ag.NAMED)}"
        )
    it, runs = ("it", "run") if len(found) == 1 else ("they", "runs")
    if merged:
        remedy = (
            "The pull request has merged, so a new pull request touching these stacks plans and "
            "applies them."
        )
    else:
        remedy = "Push"
        if all(_stopped_publishing(*incomplete[run]) for run in named_runs):
            remedy = (
                f"Re-run the failed jobs of the plan {runs} (not all jobs), then apply again; if "
                "the refusal remains, push"
            )
        remedy += (
            " a commit to the pull request, which plans and publishes every cell afresh, then "
            "apply again."
        )
    raise SystemExit(
        f"::error::apply aborted: {'; '.join(found)}: the published apply checks do not "
        f"match the cells {it} planned, so an ordering among them can be lost. {remedy}"
    )


def cells_from_checks(check_names, stacks_by_env, tags_by_stack):
    """All-envs workset: per env (from tags, never from a parse of a check
    name), the tree's candidates whose forward-constructed check name is on the
    head — exactly the targeted path's matching and workload handling, run
    over every env."""
    cells = []
    for env in sorted(stacks_by_env):
        paths = paths_with_checks(env, stacks_by_env[env], check_names)
        cells.extend(cells_for_env(env, paths, tags_by_stack))
    return cells


def filter_pending(cells, completed_names):
    return [c for c in cells if ag.check_name(c["stack"], c["environment"]) not in completed_names]


def pending_tuples(check_names, completed_names, stacks_by_env):
    """Every (stack, env) whose apply check is on the head and not done, in every env.

    Tuples, never cells: `cells_for_env` refuses a two-workload stack, and another
    environment's stack must not refuse this run."""
    return {
        (p, e)
        for e, stacks in stacks_by_env.items()
        for p in paths_with_checks(e, stacks, check_names)
        if ag.check_name(p, e) not in completed_names
    }


def drop_waiting(cells, waiting):
    keys = {(w["stack"], w["environment"]) for w in waiting}
    return [c for c in cells if (c["stack"], c["environment"]) not in keys]


def locked_cells(repo, pending, pr_number):
    """`cell_lock.foreign` over `pending`: the cells another pull request holds a lock on.
    Reads only the pending cells' environments; a failed read refuses the run."""
    locks = cl.read_locks(repo, {c["environment"] for c in pending}, run=_run)
    return cl.foreign(locks, pending, int(pr_number))


def held_cells(locked, overlap=(), attempted=()):
    """`locked`, `overlap` and `attempted` as one list, each cell tagged with its `cause`,
    `"locked"`, `"overlap"` or `"attempted"`; a locked cell keeps its `holder`. A cell both
    locked and overlap is listed once per cause, so the comment's footer names both remedies:
    evicting the lock does not clear the overlap. An attempted cell is never also locked or overlap
    (`bare_main`)."""
    return (
        [{**c, "cause": "locked"} for c in locked]
        + [{**c, "cause": "overlap"} for c in overlap]
        + [{**c, "cause": "attempted"} for c in attempted]
    )


def settle(order, stopped, pending, deps, tags, level, locked=frozenset()):
    """(sorted skipped envs, run cells, waiting cells) at the joint fixpoint of `needs`
    skips and waiting cells.

    An env with a waiting cell, or a cell in `locked` ((stack, env) pairs another pull
    request holds, or the auto form's overlap and attempted cells), is not fully applying, so it
    stops its `needs` successors like a stopped env, and each new skip can make more cells wait.
    A locked cell never runs; the env's ready cells still do: it joins `unavailable`, never
    `skipped`. `unavailable` only grows over a finite set, so the loop ends."""
    envs = {c["environment"] for c in pending} - stopped
    present = {(c["stack"], c["environment"]) for c in pending}
    lock_envs = {e for _, e in locked}
    unavailable, last = stopped | lock_envs, None
    while True:
        skipped = wv.blocked_envs(order, unavailable, envs)
        run = [
            c
            for c in pending
            if c["environment"] not in stopped | skipped
            and (c["stack"], c["environment"]) not in locked
        ]
        waiting = wv.waiting_cells(run, present, deps, tags, level)
        if (skipped, waiting) == last:
            return sorted(skipped), run, waiting
        last = (skipped, waiting)
        unavailable = stopped | skipped | lock_envs | {w["environment"] for w in waiting}


def _read_run(repo, run_id):
    """`(status, run_attempt)` of run `run_id`, or None, with one warning naming the cause, when
    the read fails, the status is not a string or the attempt not an int."""
    try:
        read = gh_json(f"repos/{repo}/actions/runs/{run_id}", _run)
        status, attempt = read["status"], read["run_attempt"]
    except READ_ERRORS as e:
        why = exit_text(e) if isinstance(e, SystemExit) else repr(e)
        sys.stderr.write(f"::warning::{command_data(one_line(why))}\n")
        return None
    if not isinstance(status, str):
        sys.stderr.write(f"::warning::run {run_id} has status {command_data(repr(status))}\n")
        return None
    if type(attempt) is not int:
        sys.stderr.write(f"::warning::run {run_id} has run_attempt {command_data(repr(attempt))}\n")
        return None
    return status, attempt


def newest_attempt(run_id, jobs):
    """The highest `run_attempt` of run `run_id`'s listed `jobs`, or None, with one warning
    naming the cause, when it lists no job or a job whose attempt is not an int."""
    if not jobs:
        sys.stderr.write(f"::warning::run {run_id} lists no job\n")
        return None
    bad = [j.get("run_attempt") for j in jobs if type(j.get("run_attempt")) is not int]
    if bad:
        found = command_data(repr(bad[0]))
        sys.stderr.write(f"::warning::run {run_id} lists a job with run_attempt {found}\n")
        return None
    return max(j["run_attempt"] for j in jobs)


def _holding_run(repo, run_id):
    """`("live", None)` while run `run_id` is not `completed`, when its listing's newest attempt
    is not the first read's, or when read again after its jobs listing it is not the same
    completed attempt: a re-run between the reads may not list its jobs yet, or may list them
    before the run read shows it, and a listing below the run's attempt is stale.
    `("ended", jobs)` otherwise, with every job of every attempt. `("unreadable", None)` when a
    run read or the jobs listing could not be read completely, a job's `run_attempt` included;
    each cause prints as one warning."""
    first = _read_run(repo, run_id)
    if first is None:
        return "unreadable", None
    if first[0] != "completed":
        return "live", None
    jobs = listed_jobs(repo, run_id, _run, counted=True, job_filter="all")
    newest = None if jobs is None else newest_attempt(run_id, jobs)
    if newest is None:
        return "unreadable", None
    if newest != first[1]:
        return "live", None
    again = _read_run(repo, run_id)
    if again is None:
        return "unreadable", None
    if again != first:
        return "live", None
    return "ended", jobs


def holder_state(repo, cell, check, runs):
    """`(cause, id)` for `cell`, whose apply check `check` another run holds `in_progress`.
    `("unknown", <check id>)` when `details_url` is not exactly a run page of this repository,
    else `(<cause>, <run id>)`, the run's state read through `_holding_run` once per run and kept
    in `runs`: `live` or `unreadable` as it reads, or, once it ended, `live` while a job of
    the cell it lists is not `completed`; `ended` when `ag.unsaved` names an attempt or the
    run lists no job of the cell, so a job name it does not read never reads as never applied;
    `saved` when an attempt applied and every applying attempt's state is saved; `deploy`
    when no attempt applied."""
    url, page = check.get("details_url") or "", current_run_url("")
    run_id = url.removeprefix(page) if url.startswith(page) else ""
    if not is_run_id(run_id):
        return "unknown", str(check["id"])
    if run_id not in runs:
        runs[run_id] = _holding_run(repo, run_id)
    state, jobs = runs[run_id]
    if state != "ended":
        return state, run_id
    stack, env = cell["stack"], cell["environment"]
    mine = [j for j in jobs if ag.cell_part(j.get("name", ""), stack, env)]
    if any(j["status"] != "completed" for j in mine):
        return "live", run_id
    if not mine or ag.unsaved(jobs, stack, env):
        return "ended", run_id
    verdicts = ag.attempts(jobs, stack, env).values()
    return ("deploy" if all(v["applied"] is False for v in verdicts) else "saved"), run_id


def attempted_cells(repo, candidates, lines, app_id, runs):
    """`{stack, environment}` of each cell in `candidates` whose newest App apply check in
    check-run `lines` shows an earlier apply run attempted it and did not apply it (`_attempted`).
    Only the auto form holds them: a writer's `shipmate apply` retries the cell. `runs` is the
    holder-run cache `holder_state` fills, shared with `refuse_held` so both decide on one read."""
    latest, own = ag.latest_by_name(ag.app_runs(lines, app_id)), current_run_url()
    return [
        {"stack": c["stack"], "environment": c["environment"]}
        for c in candidates
        if _attempted(repo, c, latest[ag.check_name(c["stack"], c["environment"])], own, runs)
    ]


def _attempted(repo, cell, check, own, runs):
    """Whether `check`, `cell`'s newest App apply check, was attempted and not applied:
    `in_progress` under another run that ended without applying the cell (`holder_state`
    `deploy`, an apply run that released it and wrote no completion); `completed` `stale`, since
    GitHub ends an incomplete check so after 14 days and a released check keeps the record title;
    otherwise retitled, its output title differing from the non-empty title its record holds,
    which only a successful apply restores. Any other `in_progress` holder is `refuse_held`'s."""
    if check["status"] == "in_progress":
        if check.get("details_url") == own:
            return False
        return holder_state(repo, cell, check, runs)[0] == "deploy"
    if check["status"] == "completed" and check.get("conclusion") == "stale":
        return True
    title = (decoded(check) or {}).get("title")
    return (
        isinstance(title, str) and title != "" and (check.get("output") or {}).get("title") != title
    )


#: The troubleshooting section that returns an in-progress apply check to `queued` by hand.
BY_HAND = "Return an in-progress apply check by hand"


def held_by_others(repo, lines, app_id, cells, runs=None):
    """`{(cause, id): [cell]}` for each of `cells` with an App apply check in `lines`, any of
    them and not only the newest, `in_progress` under a run other than this one, keyed by that
    check's `holder_state`, read through the holder-run cache `runs` (a fresh one when None). A
    same-head re-plan queues a newer check over a held one."""
    own, flipped = current_run_url(), {}
    for check in ag.app_runs(lines, app_id):
        if check["status"] == "in_progress" and check.get("details_url") != own:
            flipped.setdefault(check["name"], []).append(check)
    runs, held = {} if runs is None else runs, {}
    for c in cells:
        for check in flipped.get(ag.check_name(c["stack"], c["environment"]), []):
            listed = held.setdefault(holder_state(repo, c, check, runs), [])
            if c not in listed:
                listed.append(c)
    return held


def refuse_held(repo, lines, app_id, cells, runs=None):
    """Refuse the whole apply when another run holds a check of one of `cells` and that run may
    still apply the cell, may have applied it, or cannot be read (`held_by_others`). It lets
    through a cell whose holder ended without applying it (`deploy`): the bare and targeted forms
    apply it, and the auto form has already held it (`attempted_cells`). Only this head's checks
    are read, holder runs through the cache `runs` (`held_by_others`). A plain `SystemExit`, not
    `Refused`: infrastructure and its saved state may disagree, which no rule explains."""
    found = held_by_others(repo, lines, app_id, cells, runs)
    held = {k: v for k, v in found.items() if k[0] != "deploy"}
    if held:
        sentences = [_held_text(cause, ident, c) for (cause, ident), c in sorted(held.items())]
        raise SystemExit(f"::error::apply refused: {' '.join(sentences)}")


def _held_text(cause, ident, cells):
    """The apply refusal's sentence for `cells`, held for `cause` by run or check `ident`."""
    names = ", ".join(sorted(f"{c['stack']} / {c['environment']}" for c in cells))
    if cause == "live":
        return (
            f"{names} are held in progress by run {ident}, which is still running. Wait for it "
            "to end, then re-run `shipmate apply`."
        )
    if cause == "ended":
        return (
            f"{names} may have been applied by run {ident} without saving their state; follow "
            "docs/troubleshooting.md section The apply step ran and its state was not saved, "
            "then re-plan."
        )
    return held_text(cause, ident, names, "re-run `shipmate apply`")


def held_text(cause, ident, names, rerun):
    """The refusal's sentence for the cells `names` held for `cause` `saved`, `unknown` or
    `unreadable` by run or check `ident`, which the apply and the deploy share; `rerun` is
    the remedy's last step."""
    if cause == "saved":
        return (
            f"{names} were left in progress by run {ident}, which applied them and saved their "
            f"state. Follow docs/troubleshooting.md section {BY_HAND}, then {rerun}."
        )
    if cause == "unknown":
        return (
            f"{names}: apply check {ident} is in progress with no run named; follow "
            f"docs/troubleshooting.md section {BY_HAND}, then {rerun}."
        )
    return (
        f"{names}: run {ident} could not be read completely; {rerun}. If it fails the same "
        f"way, follow docs/troubleshooting.md section {BY_HAND}."
    )


def _check_run_lines(repo, head_sha):
    """The commit's check-runs as JSONL lines, for the apply and unlock name queries."""
    return check_runs(repo, head_sha, run=_run).splitlines()


def wait_for_plans(repo, pr_number):
    """The ids, as str, of the live `shipmate plan` runs of pull request `pr_number`
    (`live_plan_runs`, counted) this apply waited for, once a poll settles: its listing is
    complete and empty and every waited run not listed reads `completed` by id (`_read_run`).
    Every listed run joins the waited set, from an incomplete listing too, with one notice when
    first seen; a run that starts during the wait extends it, and the bound is total. A settled
    wait that waited on a run sleeps `PLAN_SETTLE` seconds before it returns.

    An unsettled poll sleeps `PLAN_POLL` seconds and polls again until `PLAN_WAIT` seconds of
    `_clock` have passed since the first, then refuses (`_wait_refusal`). The deadline is checked
    between polls: a read that stalls is not bounded by it."""
    deadline = _clock() + PLAN_WAIT
    waited = set()
    while True:
        complete, live, unread = _poll_plans(repo, pr_number, waited)
        if complete and not live and not unread:
            if waited:
                sleep(PLAN_SETTLE)
            return waited
        if _clock() >= deadline:
            raise _wait_refusal(pr_number, complete, live, unread)
        sleep(PLAN_POLL)


def _poll_plans(repo, pr_number, waited):
    """One poll of `wait_for_plans`, adding each listed run to `waited`: `(complete, live,
    unread)`, `complete` the listing's, `live` each waited run listed or read by id as not
    `completed`, mapped to its status words, `unread` the waited runs not listed whose by-id read
    failed, ascending."""
    runs, complete = live_plan_runs(repo, pr_number, _run, counted=True)
    live = {}
    for r in runs:
        run_id = str(r["id"])
        live[run_id] = status_text(r.get("status"))
        if run_id not in waited:
            waited.add(run_id)
            print(
                f"::notice::waiting for shipmate plan run {run_id} of this pull request "
                f"({command_data(live[run_id])}) before reading the apply checks"
            )
    unread = []
    for run_id in sorted(waited - live.keys(), key=int):
        read = _read_run(repo, run_id)
        if read is None:
            unread.append(run_id)
        elif read[0] != "completed":
            live[run_id] = status_text(read[0])
    return complete, live, unread


def _wait_refusal(pr_number, complete, live, unread):
    """The refusal at `wait_for_plans`' deadline after a poll that did not settle. The last
    listing decides: incomplete fails; else a run known live refuses by rule naming the lowest;
    else the lowest unread run fails. A failure is no `Refused`: no run is known live."""
    minutes = PLAN_WAIT // 60
    if not complete:
        return SystemExit(
            f"::error::apply aborted: the live shipmate plan runs of pull request #{pr_number} "
            f"could not all be listed for {minutes} minutes, so a plan in flight may change what "
            "this apply applies; comment the same `shipmate apply` command again"
        )
    if live:
        run_id = min(live, key=int)
        return Refused(
            f"::error::apply aborted: shipmate plan run {run_id} of this pull request is still "
            f"{live[run_id]} after {minutes} minutes; wait for it to finish, review its plan, "
            "then comment the same `shipmate apply` command"
        )
    return SystemExit(
        f"::error::apply aborted: shipmate plan run {unread[0]} of this pull request could not be "
        f"read for {minutes} minutes, so it may still change what this apply applies; comment "
        "the same `shipmate apply` command again"
    )


def refuse_replanned(runnable, waited):
    """Refuse by rule when a cell of `runnable` records a plan run in `waited` (`wait_for_plans`),
    naming the lowest such run and its cells: that run rewrote the record while this apply
    waited, so the plan it records is not the one reviewed. Ids compare as decimal strings."""
    hits = sorted({str(c["plan_run_id"]) for c in runnable} & waited, key=int)
    if hits:
        cells = sorted(
            f"{c['stack']} / {c['environment']}"
            for c in runnable
            if str(c["plan_run_id"]) == hits[0]
        )
        raise Refused(
            f"::error::apply aborted: shipmate plan run {hits[0]} of this pull request planned "
            f"{named(cells, ag.NAMED)} while this apply waited for it; review its plan, then "
            "comment the same `shipmate apply` command"
        )


def apply_check_names(check_run_lines, app_id):
    """Every App-authored apply check name on the head, whatever the newest run's
    status — the apply workset's membership authority.

    Not the unlock queue's pending set: a completed run with a failing conclusion
    is not pending, but its cell must stay re-appliable, so the done cells are
    dropped by `filter_pending` (apply-gate's success/neutral predicate) instead."""
    return set(ag.latest_by_name(ag.app_runs(check_run_lines, app_id)))


def dag_shape_notice(deps):
    """One line describing the apply DAG's shape: how many stacks, how many
    declared `after` edges, how many topological levels, and how wide the widest
    level is.

    Always a notice, never a warning. Wave ordering comes only from the `after`
    DAG, and "no declared dependency" is a legitimate state, so nothing can
    detect a MISSING edge — a repository migrating from another tool leaves its
    ordering behind in that tool's config with nothing to say so. What this line
    buys is a reader who knows the repository seeing the concurrency figure and
    knowing at once whether it is true."""
    lv = wv.stack_levels(deps)
    return (
        f"::notice::{len(deps)} stacks, {sum(len(d) for d in deps.values())} after edges, "
        f"{len(lv)} dependency levels; {max((len(x) for x in lv), default=0)} stacks would apply "
        "concurrently"
    )


def validate_env(value):
    """Refuse an empty `SHIPMATE_ENV`, or one `check_env_name` rejects.

    Empty is refused because each caller acts on exactly one environment: `main`
    routes an empty env to `bare_main` before calling this, and unlock-detect has no
    all-environments form. The `plan.<env>.<slug>` artifact name is unambiguous only
    because an env name never contains '.' — with env first, the first '.' after the
    `plan.` prefix is the env<->slug boundary. Terramate accepts '.' in a tag, so
    `env_membership` checks every tag-derived name; `SHIPMATE_ENV` arrives from a
    dispatch input instead, and is checked here with the same `check_env_name`. A
    dotted env would let distinct (env, slug) pairs render the same artifact name
    and cross-enrol the wrong stack into a wave."""
    if not value:
        raise SystemExit("::error::SHIPMATE_ENV is empty; this path is single-env.")
    bm.ec.check_env_name(value, f"SHIPMATE_ENV {value!r}", "the environment")


def refuse_undetermined(decision):
    """Fail on a review decision `authorize._review_reason` neither passes nor refuses by rule
    (`authorize.RULE_DECISIONS`), as plain `SystemExit`: it never arrived or has an unknown
    value, an engine fault rather than a rule, so it is no `Refused` (a failed review read fails
    the `review` job before this runs)."""
    if decision not in az.RULE_DECISIONS and az._review_reason(decision):
        raise SystemExit(
            f"::error::not authorized: could not determine the PR's review decision "
            f"(got {decision!r}); the apply run's `review` job passed `detect` no decision this "
            "engine knows; check the pinned engine version, then retry."
        )


def refuse_unreviewed(env, table, decision):
    """Refuse a targeted apply the PR's review decision does not authorize.

    The same `authorize._review_reason` comment-ops evaluated, re-run against the
    decision the `review` job read server-side: comment-ops decided on the state
    at comment time, and an approval dismissed since then must not still apply.
    The run dies before any wave, the apply checks stay pending, and the gate stays
    pending with them. An undetermined decision fails first (`refuse_undetermined`); every
    refusal this raises itself is `Refused`.

    `table` must have been through `validate_structure`: `exempt_envs` reads only a
    boolean `false` as review-exempt, so a `review: no` would otherwise refuse as
    unreviewed rather than as the malformed setting it is."""
    refuse_undetermined(decision)
    reason = az._review_reason(decision, env, bm.ec.exempt_envs(table))
    if reason:
        raise Refused(f"::error::{reason}")


def refuse_actor(lines, app_id, actor, triggering_actor):
    """Refuse unless `actor` and `triggering_actor` are the bot login of the App that authored
    the head's checks.

    The whole string, never a `[bot]` suffix: a `GITHUB_TOKEN` dispatch runs as
    `github-actions[bot]`. The slug comes from the App-authored check runs except `RUN_CHECK`,
    which an apply run creates, so a head with none refuses. A human's "Re-run all jobs"
    keeps `actor` and makes the human `triggering_actor`, so a re-run refuses."""
    runs = [r for r in ag.app_runs(lines, app_id) if r.get("name") != RUN_CHECK]
    slugs = {(r.get("app") or {}).get("slug") for r in runs}
    if not slugs:
        raise SystemExit(
            "::error::auto apply refused: no check run on the head is authored by the shipmate "
            "App, so its bot login is unknown. " + _AUTO_REMEDY
        )
    bots = {f"{s}[bot]" for s in slugs if s}
    if actor not in bots:
        raise SystemExit(
            f"::error::auto apply refused: the run's actor is {actor!r}, not the shipmate App: "
            "only the App dispatches an auto apply, after an autoplan. " + _AUTO_REMEDY
        )
    if triggering_actor not in bots:
        raise SystemExit(
            f"::error::auto apply refused: the run's triggering actor is {triggering_actor!r}, "
            "not the shipmate App: a re-run of an auto apply never applies. " + _AUTO_REMEDY
        )


def refuse_provenance(repo, head, runnable, actions, drafts, pr_number):
    """`apply-gate.auto_source`'s `(plan, authorizer)` of `head`, refused unless every cell in
    `runnable` records one plan run and `apply-gate.provenance_reason` admits it, with each
    cell's event action from `actions` (`apply-gate.plan_actions`) and its draft origin from
    `drafts` (`apply-gate.draft_names`), and no `shipmate plan` run of pull request
    `pr_number`, a str, created since the plan run counts as newer (`apply-gate.newer_plans`).

    A `shipmate plan` run is a `workflow_dispatch`, so its commenter is lost and nothing
    authorizes it as the autoplan's actor; it is never the autoplan listed. Any actor's newer
    plan run refuses while live, or once it planned: it rewrites the head's records, so applying
    the older plan under it would apply what the reviewer no longer sees. A newer autoplan of the
    head that recorded no cell must not leave an older one applying. A reopen autoplan
    dispatches no auto apply yet becomes the newest autoplan; a ready-for-review run that
    deferred to an earlier plan leaves that plan applying, authorized as the run's clicker; a
    record with no action is an older engine's."""
    runs = sorted({c["plan_run_id"] for c in runnable}, key=int)
    if len(runs) > 1:
        listed = "; ".join(
            f"plan run {r}: "
            + named(
                [
                    ag.check_name(c["stack"], c["environment"])
                    for c in runnable
                    if c["plan_run_id"] == r
                ],
                ag.NAMED,
            )
            for r in runs
        )
        raise SystemExit(
            f"::error::auto apply refused: the cells to apply record different plan runs "
            f"({listed}), so no one autoplan planned them all. " + _AUTO_REMEDY
        )
    try:
        newest, authorizer = ag.auto_source(repo, head, run=_run)
    except ValueError as e:
        raise _malformed("autoplan listing", e) from None
    names = [ag.check_name(c["stack"], c["environment"]) for c in runnable]
    cells = {
        n: (c["plan_run_id"], actions.get(n), n in drafts)
        for n, c in zip(names, runnable, strict=True)
    }
    reason = ag.provenance_reason(newest, runs[0], head, cells, authorizer)
    if reason:
        raise SystemExit(
            f"::error::auto apply refused: {ag.provenance_text(*reason, runs[0], head)}. "
            + _AUTO_REMEDY
        )
    since = newest.get("created_at")
    reason = ag.newer_plan(*ag.newer_plans(repo, pr_number, newest, since=since, run=_run))
    if reason:
        raise SystemExit(f"::error::auto apply refused: {_newer_plan_text(runs[0], *reason)}")
    return newest, authorizer


def _newer_plan_text(run_id, cause, newer):
    """`apply-gate.newer_plan`'s `(cause, newer)` for plan run `run_id`, with its remedy."""
    if cause == "plan-listing":
        return (
            "the shipmate plan runs of this pull request could not all be listed, so a newer one "
            "may exist. " + _AUTO_REMEDY
        )
    status = status_text(newer.get("status"))
    if status == "completed":
        return (
            f"shipmate plan run {newer['id']} of this pull request planned after plan run "
            f"{run_id}. Review its plan, then comment `shipmate apply`."
        )
    return (
        f"shipmate plan run {newer['id']} of this pull request is {status} and newer than plan "
        f"run {run_id}. Wait for it to finish, review its plan, then comment `shipmate apply`."
    )


def _malformed(what, e):
    return SystemExit(
        f"::error::auto apply refused: the {what} read returned a malformed answer ({e!r}). "
        + _AUTO_REMEDY
    )


def refuse_pusher(repo, authorizer):
    """The login `authorize.pusher_reason` admits as the actor of `authorizer`,
    `apply-gate.auto_source`'s authorizing autoplan; refuses unless it admits one."""
    reason = az.pusher_reason(repo, authorizer, run=_run)
    if reason:
        raise SystemExit(f"::error::{reason}")
    return az._login(authorizer.get("actor"))


def wait_mergeable(repo, pr_number, head):
    """The pull request's base tip, after re-reading it until GitHub has computed `mergeable`
    or `_MERGEABLE_READS` reads are spent, then refusing as `authorize.decide` does on its head
    repository, draft and mergeable state. Every read refuses when the head moved: the new
    head's autoplan decides its own apply. The base tip is the base branch's
    (`apply-gate.base_tip`); one that cannot be read refuses."""
    for i in range(_MERGEABLE_READS):
        if i:
            _sleep(_MERGEABLE_WAIT)
        pr = gh_json(f"repos/{repo}/pulls/{pr_number}", run=_run)
        sha = (pr.get("head") or {}).get("sha")
        if sha != head:
            raise SystemExit(
                f"::error::auto apply refused: pull request #{pr_number} head is {sha}, but this "
                f"run applies {head}. The new head's autoplan decides its own apply."
            )
        if pr.get("mergeable") is not None:
            break
    reason = az._head_repo_reason(pr) or az._ready_reason(pr, retry=_AUTO_RETRY)
    if reason:
        raise SystemExit(f"::error::{reason}")
    tip = _base_tip(repo, pr_number, "auto apply refused", f". {_AUTO_REMEDY}", pull=pr)
    return tip[1]


def overlap_cells(candidates, changed, behind=frozenset()):
    """`{stack, environment}` of each cell in `candidates` whose stack is in `changed`, the
    stacks the merge of the base into the branch changes, directly or through a module they
    source, or removes files they own, or whose apply check name is in `behind`
    (`apply-gate.behind_names`), its plan having found the base changed it: its plan was made
    without the base's change. A cell under both causes is listed once."""
    return [
        {"stack": c["stack"], "environment": c["environment"]}
        for c in candidates
        if c["stack"] in changed or ag.check_name(c["stack"], c["environment"]) in behind
    ]


def behind_cells(tip, cells, lines, app_id, stacks):
    """`overlap_cells` of `cells` against base tip `tip` (`build-matrix.base_changed_stacks`,
    passed `stacks`, a collection of every stack path of the head) and the head's behind records
    in check-run `lines`. A merge conflict refuses with `MergeConflict`'s text, any other failed
    step with its own."""
    changed = bm.base_changed_stacks(tip, {c["stack"] for c in cells}, stacks)
    return overlap_cells(cells, changed, ag.behind_names(lines, app_id))


def _base_tip(repo, pr_number, lead, remedy, pull=None):
    """`(base branch, base tip)` of pull request `pr_number`, the tip from the branch ref
    (`apply-gate.base_tip`). `pull` is the pull request's REST object, read here when None. A
    failed or malformed read refuses as
    `<lead>: could not read the base tip of pull request #<n> (<why>)<remedy>`."""
    try:
        if pull is None:
            pull = gh_json(f"repos/{repo}/pulls/{pr_number}", run=_run)
        return pull["base"]["ref"], ag.base_tip(repo, pull, run=_run)
    except SystemExit as e:
        why = one_line(exit_text(e))
    except (LookupError, TypeError, AttributeError, ValueError) as e:
        why = repr(e)
    raise SystemExit(
        f"::error::{lead}: could not read the base tip of pull request #{pr_number} ({why}){remedy}"
    )


def _read_base(repo, pr_number):
    """`_base_tip` of pull request `pr_number` from one pull request read, refused with the
    commanded forms' remedy."""
    return _base_tip(repo, pr_number, "apply refused", "; comment `shipmate apply` again.")


def refuse_behind(repo, pr_number, selected, lines, app_id, stacks):
    """The base tip of pull request `pr_number`, refusing the whole run when a cell of
    `selected`, the cells a bare or targeted apply would apply, is behind it (`behind_cells`,
    passed `stacks`, a collection of every stack path of the head).
    Before refusing it writes the report `{"behind": [{stack, environment}, ...], "base":
    <base branch>}`, which the apply result comment renders. With no selected cell it reads
    nothing and returns ""."""
    if not selected:
        return ""
    base, tip = _read_base(repo, pr_number)
    behind = behind_cells(tip, selected, lines, app_id, stacks)
    if behind:
        write_report({"behind": behind, "base": base})
        cells = named([f"{c['stack']} / {c['environment']}" for c in behind], ag.NAMED)
        raise Refused(
            f"::error::apply refused: {len(behind)} cell(s) behind {base} ({cells}); update the "
            f"branch from {base} and push."
        )
    return tip


def bare_main(auto=False):
    """The bare `shipmate apply` work set -> env-levels -> waves.

    The pre-merge equivalent of deploy-detect, sourced like the targeted form:
    cells are the tree's stacks whose `apply / <env> / <stack>` check is on the
    head, each applying from the plan run its own check records, and the
    environment entries' `needs` bucket the pending ones into env-levels exactly as
    on the merge-deploy path. Env membership comes from stack tags
    (build-matrix.env_membership) so this form only ever constructs check names
    forward, never reverse-parses them; a stack with no `env/*` tag is in no environment and
    adds no cell.

    First, an undetermined review decision fails the run before any GitHub or tree read
    (`refuse_undetermined`). Then, after the run-graph read (a cycle refuses without waiting) and
    unless `auto`, it waits for the live `shipmate plan` runs of the pull request
    (`wait_for_plans`) before reading the head's checks, and refuses a runnable cell whose record
    names a run it waited for (`refuse_replanned`).

    After `settle`, it refuses a run cell that runs after a pending cell `needs` puts on a
    later env-level (`waves.refuse_inversions`): a cell of an env `settle` skips is no root. A
    waiting run cell stays one, and a held or targeted upstream counts, so the contradiction
    refuses rather than wait for a review or apply that would only reach this refusal. Four
    exclusions distinguish the bare form from deploy:
    - envs whose entry holds `apply_mode: targeted` (typically prod) are removed
      before env-levels are built; their apply checks stay pending, so
      `shipmate / gate` keeps gating the merge until a targeted
      `shipmate apply <env>` completes them. `excluded_envs` names every one with
      pending work, including those also held for review;
    - envs ordered (transitively) after an env not fully applying this run — held,
      excluded as targeted, holding a waiting cell, holding a cell another pull request
      locks, or, under the auto form, holding a cell the base also changed or not
      `apply_mode: auto` — are skipped with a notice
      (`skipped_after_targeted`, named for its first cause) — their ordering
      precondition cannot be met this run, exactly like a failed predecessor
      level. `skipped_after` maps each to its transitive predecessors not fully
      applying for a cause of their own;
    - envs the PR's review decision does not authorize are held until it carries
      an approving review, dropped the same way; an entry holding
      `review: false` is exempt from that hold;
    - cells that run after a pending cell not applying this run wait, named in
      `waiting_cells`. An env with a waiting cell stops its `needs` successors, and
      each new skip can make more cells wait: `settle` runs both to one fixpoint.

    A pending cell another pull request locks (`locked_cells`) stays pending and applies
    nowhere, exactly like a waiting cell; it is named in `held_cells`. Locks are read only
    in the envs neither held nor excluded as targeted. Before the locks are read, the bare form
    refuses the whole run when one of those envs' pending cells is behind the base
    (`refuse_behind`), and writes `base_sha`, the base tip it checked, empty when no cell was
    selected.

    `auto` is the auto form, over the `apply_mode: auto` environments' pending cells.
    Every other pending environment counts as stopped in `settle`, so its `needs` successors
    skip as a held one's do; review holds, locks, waiting cells and `excluded_envs` are the
    bare form's. After the review decision check, the run's actor must be the App's bot login
    (`refuse_actor`). With a pending cell in an environment not stopped, the pull request must be
    ready and mergeable at this head (`wait_mergeable`), and a cell whose stack the merge of the
    base into the branch changes, directly or through a module it sources, or removes files it owns
    (`build-matrix.base_changed_stacks`), or whose apply check records that its plan found the
    base changed it (`apply-gate.behind_names`), is named in `held_cells` with cause `overlap`:
    it stays pending and stops its environment's `needs` successors, as a locked cell does. A
    cell `settle` would run (neither locked, overlap nor waiting on one) whose newest App apply
    check shows an earlier apply run attempted it and did not apply it (`attempted_cells`) is held
    the same way with cause `attempted`; `refuse_held` reads it beside the runnable cells, so a
    refusal over another check of it wins. With a cell to apply, its records must name one plan
    run that `apply-gate.provenance_reason` admits against `apply-gate.auto_source`'s plan and
    authorizer, no newer `shipmate plan` run of the pull request may be live or have planned
    (`refuse_provenance`), and the authorizer's actor must have write access (`refuse_pusher`).
    Writes the bare outputs plus `provenance_run`, empty when no cell applies; its report also
    holds `pusher`, the authorizer's `actor` login, empty when no cell applies, and
    `bare_envs`, the pending environments neither `auto`, `targeted` nor held, left for a bare
    apply.
    """
    repo = os.environ["GITHUB_REPOSITORY"]
    head = os.environ["SHIPMATE_HEAD_SHA"]

    validate_head_sha(head)
    pr_number = env_pr_number()
    decision = os.environ.get("SHIPMATE_REVIEW_DECISION", "")
    refuse_undetermined(decision)

    stacks_by_env, tags_by_stack = bm.env_membership(all_stacks=True)
    app_id = os.environ["SHIPMATE_APP_ID"]
    deps = bm.run_graph_deps()
    # The auto form refuses a live or newer plan run at once instead (`refuse_provenance`).
    waited = set() if auto else wait_for_plans(repo, pr_number)
    lines = _check_run_lines(repo, head)
    if auto:
        refuse_actor(
            lines,
            app_id,
            os.environ.get("GITHUB_ACTOR", ""),
            os.environ.get("GITHUB_TRIGGERING_ACTOR", ""),
        )
    cells = cells_from_checks(apply_check_names(lines, app_id), stacks_by_env, tags_by_stack)
    table = bm.env_config(cells, bm.tagged_workloads(stacks_by_env, tags_by_stack))
    cells = bm.stamp_rows(cells, table, "apply")

    pending = filter_pending(cells, ag.app_done_names(lines, app_id))

    order = bm.ec.env_order(table)
    levels = wv.cell_levels(order, tags_by_stack)
    pending_envs = {c["environment"] for c in pending}
    exempt = bm.ec.exempt_envs(table)
    held = sorted(e for e in pending_envs if az._review_reason(decision, e, exempt))
    targeted = bm.ec.mode_envs(table, "targeted")
    stopped = pending_envs & set(targeted + held)
    # Pending envs the auto form leaves to a bare apply: neither targeted nor held, not auto.
    unselected = pending_envs - set(bm.ec.mode_envs(table, "auto")) - stopped if auto else set()
    stopped |= unselected
    # Envs neither held nor excluded as targeted; a needs-skipped env's lock stays because a
    # waiting cell's remedy names it.
    candidates = [c for c in pending if c["environment"] not in stopped]
    overlap, base_sha = [], ""
    # One read: the wave re-check compares the base tip with the one this run checked.
    if auto and candidates:
        base_sha = wait_mergeable(repo, pr_number, head)
        overlap = behind_cells(base_sha, candidates, lines, app_id, tags_by_stack)
    elif not auto:
        base_sha = refuse_behind(repo, pr_number, candidates, lines, app_id, tags_by_stack)
    locked = locked_cells(repo, candidates, pr_number)
    # One cause per held cell: a locked or overlap cell is never also named attempted.
    taken = {(c["stack"], c["environment"]) for c in [*locked, *overlap]}
    # One holder read per run: a second read could turn an unreadable holder into `deploy`.
    runs, attempted = {}, []
    if auto:
        # Only a cell `settle` would run can be attempted: a waiting cell keeps its wait cause.
        _, run, waiting = settle(order, stopped, pending, deps, tags_by_stack, levels, taken)
        attempted = attempted_cells(repo, drop_waiting(run, waiting), lines, app_id, runs)
    holds = taken | {(c["stack"], c["environment"]) for c in attempted}
    skipped, run, waiting = settle(order, stopped, pending, deps, tags_by_stack, levels, holds)
    # A skipped env names the predecessors not fully applying for a cause of their own, each with
    # a remedy of its kind; one skipped for nothing but its own predecessors is passed through.
    blockers = stopped | {e for _, e in holds} | {w["environment"] for w in waiting}
    skipped_after = {e: sorted(wv.predecessors(order, e) & blockers) for e in skipped}
    wv.refuse_inversions(
        run, {(c["stack"], c["environment"]) for c in pending}, deps, tags_by_stack, order
    )
    # Every pending targeted env, held or not: the comment names a held one's
    # targeted command under the hold. A held env that is not targeted stays out.
    excluded = sorted(pending_envs & set(targeted))
    # The plan runs attach to `runnable`, not `pending`: an excluded, held, waiting or locked
    # cell's check stays pending by design for a later apply, and that apply refuses on its own
    # over a record-less cell, so refusing here would strand the cells that CAN apply.
    runnable = with_plan_runs(drop_waiting(run, waiting), lines, app_id, pr_number=pr_number)
    refuse_replanned(runnable, waited)
    # A refusal over another check of an attempted cell wins over holding it.
    refuse_held(repo, lines, app_id, [*runnable, *attempted], runs)
    bm.refuse_workload_gaps(runnable, table)
    auto_outputs, auto_report = {"base_sha": base_sha}, {}
    if auto:
        provenance_run = pusher = ""
        if runnable:
            actions, drafts = ag.plan_actions(lines, app_id), ag.draft_names(lines, app_id)
            _, authorizer = refuse_provenance(repo, head, runnable, actions, drafts, pr_number)
            pusher = refuse_pusher(repo, authorizer)
            provenance_run = runnable[0]["plan_run_id"]
        auto_outputs["provenance_run"] = provenance_run
        auto_report = {"pusher": pusher, "bare_envs": sorted(unselected)}
    # From `runnable`, never from `pending & exempt`: an exempt env can still be
    # excluded or skipped, and claiming it applied is worse than saying nothing.
    applied_exempt = sorted(
        {
            c["environment"]
            for c in runnable
            if az._review_exemption(decision, c["environment"], exempt)
        }
    )
    # From `runnable` for the same reason.
    no_review_required = sorted(
        {
            c["environment"]
            for c in runnable
            if az._review_not_required(decision, c["environment"], exempt)
        }
    )

    # Before the padding, whose over-depth refusal is where this line helps most.
    print(dag_shape_notice(deps))
    per_level = wv.env_level_waves(runnable, order, deps)
    level_counts = [sum(map(len, w.values())) for w in per_level]
    # The title is what `apply-comment`'s held-env remedy and CONTRACT.md tell reviewers to
    # read; rename all three together.
    print(
        f"::notice title=apply-all-detect::head={head} "
        f"cells={len(cells)} pending={len(pending)} envlevels={level_counts} "
        f"excluded_targeted={excluded} skipped_after_targeted={skipped} "
        f"review_held={held} waiting={len(waiting)} locked={len(locked)} overlap={len(overlap)} "
        f"attempted={len(attempted)} applied_exempt={applied_exempt} "
        # The hold cause: an everything-held run is otherwise indistinguishable
        # from a CHANGES_REQUESTED one.
        f"review_decision={decision!r}"
    )
    write_report(
        {
            "excluded_envs": excluded,
            "skipped_envs": skipped,
            "skipped_after": skipped_after,
            "review_held_envs": held,
            "applied_exempt_envs": applied_exempt,
            "review_not_required_envs": no_review_required,
            "waiting_cells": waiting,
            "held_cells": held_cells(locked, overlap, attempted),
            # Over `cells`, not `runnable`: the comment lists excluded, held, waiting and
            # locked cells.
            "env_order": wv.env_sequence(order, {c["environment"] for c in cells}),
            **auto_report,
        }
    )
    write_outputs(
        **wv.env_level_outputs(per_level),
        head_sha=head,
        **auto_outputs,
    )


def main():
    if os.environ.get("SHIPMATE_AUTO") == "true":
        bare_main(auto=True)
        return
    env = os.environ["SHIPMATE_ENV"]
    # Routed before `refuse_unreviewed`: `_review_reason` reads an empty env as a bare
    # apply, exempt when any entry is review-exempt, so it must never reach the targeted refusal.
    if not env:
        bare_main()
        return
    repo = os.environ["GITHUB_REPOSITORY"]
    head = os.environ["SHIPMATE_HEAD_SHA"]

    validate_head_sha(head)
    validate_env(env)
    pr_number = env_pr_number()

    # Structure-validated before the refusal reads `review`; `validate` re-runs it
    # below, which costs nothing and parses nothing again.
    table = bm.ec.read_table()
    bm.ec.validate_structure(table)
    decision = os.environ.get("SHIPMATE_REVIEW_DECISION", "")
    refuse_unreviewed(env, table, decision)
    no_review_required = (
        [env] if az._review_not_required(decision, env, bm.ec.exempt_envs(table)) else []
    )

    deps = bm.run_graph_deps()

    app_id = os.environ["SHIPMATE_APP_ID"]
    waited = wait_for_plans(repo, pr_number)
    # One listing answers all three questions — which cells this run applies,
    # which plan run each applies from, and which are already done — so a check
    # completing mid-run cannot make the three disagree.
    lines = _check_run_lines(repo, head)
    names = apply_check_names(lines, app_id)
    completed = ag.app_done_names(lines, app_id)

    paths = paths_with_checks(env, list(deps.keys()), names)
    tag_map = bm.all_tags()
    cells = cells_for_env(env, paths, bm.tags_of(paths, tag_map))
    table = bm.env_config(cells, table=table)
    cells = bm.stamp_rows(cells, table, "apply")

    all_pending = pending_tuples(names, completed, wv.env_stacks(tag_map))
    pending = filter_pending(cells, completed)
    base_sha = refuse_behind(repo, pr_number, pending, lines, app_id, tag_map)
    locked = locked_cells(repo, pending, pr_number)
    run = drop_waiting(pending, locked)
    levels = wv.cell_levels(bm.ec.env_order(table), tag_map)
    waiting = wv.waiting_cells(run, all_pending, deps, tag_map, levels)
    # Locked and waiting cells drop before `with_plan_runs`: their checks stay pending for a later
    # apply, which refuses on its own over a record-less cell.
    runnable = with_plan_runs(drop_waiting(run, waiting), lines, app_id, pr_number=pr_number)
    refuse_replanned(runnable, waited)
    refuse_held(repo, lines, app_id, runnable)
    bm.refuse_workload_gaps(runnable, table)

    # Before the padding, whose over-depth refusal is where this line helps most.
    print(dag_shape_notice(deps))
    per_level = wv.env_level_waves(runnable, {}, deps)
    w0 = per_level[0]
    print(
        f"::notice title=apply-detect::env={env} head={head} "
        f"cells={len(cells)} completed={len(completed)} pending={len(pending)} "
        f"waiting={len(waiting)} locked={len(locked)} "
        f"waves={[len(w) for w in w0.values()]} empty={not any(w0.values())}"
    )
    write_report(
        {
            "review_not_required_envs": no_review_required,
            "waiting_cells": waiting,
            "held_cells": held_cells(locked),
            "env_order": [env],
        }
    )
    write_outputs(
        **wv.env_level_outputs(per_level),
        head_sha=head,
        base_sha=base_sha,
    )


if __name__ == "__main__":
    run_annotated(main, refusal_output=True)
