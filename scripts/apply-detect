#!/usr/bin/env python3
"""Apply detect: a dispatched single-env apply's work set + waves.

The dispatched workflow is the consumer's `shipmate.yml`, whose `apply` job
the `verb: apply` body selects; the engine's own `apply.yml` is `workflow_call`
and is what that job calls.

Unlike deploy-detect (merge-driven, all envs), the work set here is scoped to
ONE environment and sourced from the head's own apply checks: a run-graph stack
belongs to this run when `apply / <path> / <env>` is among the App-authored
checks on the head, and the plan run it applies from is the one that check
records. Cells whose apply check already completed are dropped (idempotent
no-op), and the rest wave-ordered. A targeted `shipmate apply <env>` is explicit by
design — it never blocks on other environments; region-level sequencing across
envs is handled separately by the bare form.

It writes the same env-level output contract as the bare form
(`env-order.write_env_level_waves`), with every wave at env-level 0 and levels
1-3 empty.

Before any of that, the PR's review decision — read server-side by the `review`
job, narrowed by `gated: false` on the environment's entry — must authorize this
environment, or the run refuses.
"""

import json
import os
import re

from _shipmate import _load

_SHA_RE = re.compile(r"^[0-9a-f]{40}$")


bm = _load("build-matrix")
wv = _load("waves")
eo = _load("env-order")
ag = _load("apply-gate")
az = _load("authorize")


def paths_with_checks(env, candidate_paths, check_names):
    """The candidates whose `apply / <path> / <env>` check is on the head.

    Forward-construct the expected name per candidate path, never reverse-parse
    it: a stack path contains '/', so `apply / components/app / dev-eu` cannot be
    split back into its parts without inventing a convention — and a convention
    is a second reader of the name grammar. `pending-checks` builds these names
    from the stack PATH, so the exact path is what comes back; nothing here
    resolves a slug, which is what let two paths slugging alike apply each
    other's plan."""
    return [p for p in candidate_paths if ag.check_name(p, env) in check_names]


def cells_for_env(env, paths, tags_by_stack):
    """Wave cells for `paths` in `env`.

    The workload comes from the tags, never from the check name — the name
    carries no workload. A stack missing from the map carries "" and applies with
    the environment's generic role; the map itself is REQUIRED, so a caller that
    stops deriving it raises here instead of silently applying every cell with
    the generic role. A stack carrying two `workload/*` tags refuses (`workload_of`)."""
    workloads = {p: bm.workload_of(tags_by_stack.get(p, []), p) for p in paths}
    return [
        {
            "stack": p,
            "environment": env,
            "workload": workloads[p],
        }
        for p in paths
    ]


def with_plan_runs(cells, check_run_lines, app_id):
    """Each cell gains the plan run id and the plan-text digest ITS OWN check
    records in `check_run_lines`, so a cell recovered by a re-run plan job downloads
    from the run that re-planned it, and is bound to the plan text reviewed for it,
    while its siblings stay on the original.

    Both are read only from records App `app_id` wrote. That App authorship is what
    binds a run id to the plan workflow; there is no workflow-path check to re-add.

    A cell whose newest check records no usable run refuses. The alternative —
    falling back to a lookup keyed on a plan run's head_sha — is the platform
    dependency this path exists to drop, and a default would apply a cell from
    nowhere. Only cells still to be applied reach here: an applied cell needs no
    record, so a completed check that carries none never blocks its siblings.

    A cell with a run but no digest refuses separately, and says so separately:
    the causes differ, and a reader told "no plan run" would go looking for a
    check that exists. It refuses rather than applying unverified because an
    accepted absence is a guard the plan cell switches off by omitting a file.

    The refusals are shared by all three detects, so they are worded for both
    paths: deploy's candidates come from the git diff rather than from the
    checks, so a cell here may have no apply check whatsoever, and its pull
    request is already merged — a remedy phrased as "re-plan on this pull
    request" would send a post-merge operator to a pull request that no longer
    accepts commits."""
    plan_runs = ag.plan_runs_by_name(check_run_lines, app_id)
    plan_hashes = ag.plan_hashes_by_name(check_run_lines, app_id)
    named = [
        (
            c,
            plan_runs.get(ag.check_name(c["stack"], c["environment"])),
            plan_hashes.get(ag.check_name(c["stack"], c["environment"])),
        )
        for c in cells
    ]
    missing = [ag.check_name(c["stack"], c["environment"]) for c, run, _ in named if not run]
    if missing:
        raise SystemExit(
            f"::error::apply aborted: no plan run recorded for {', '.join(missing)}: the "
            "apply check names no plan run to apply from (post-merge, the cell may have no "
            "apply check at all), so the apply is refused. Re-plan these stacks on their pull "
            "request, then apply again; if that pull request has already merged, a new pull "
            "request touching them plans and applies them afresh."
        )
    unbound = [ag.check_name(c["stack"], c["environment"]) for c, _, digest in named if not digest]
    if unbound:
        raise SystemExit(
            f"::error::apply aborted: no plan-text digest recorded for {', '.join(unbound)}: "
            "the reviewed plan text cannot be checked against the plan that would be applied, "
            "so this apply is refused rather than run unverified. Re-plan these stacks on "
            "their pull request, then apply again; if that pull request has already merged, a "
            "new pull request touching them plans and applies them afresh."
        )
    return [{**c, "plan_run_id": run, "plan_sha256": digest} for c, run, digest in named]


def filter_pending(cells, completed_names):
    return [c for c in cells if ag.check_name(c["stack"], c["environment"]) not in completed_names]


def _check_run_lines(repo, head_sha):
    """The commit's check-runs as JSONL lines, for the apply and unlock name queries."""
    return bm._run(
        [
            "gh",
            "api",
            # filter=all keeps this listing in step with gate-refresh's
            # (test_check_runs_filter_aligned); --paginate --jq streams JSONL so
            # no page — hence no completed apply — is dropped on a >100-check PR.
            "--paginate",
            "--jq",
            ".check_runs[]",
            f"repos/{repo}/commits/{head_sha}/check-runs?filter=all&per_page=100",
        ]
    ).splitlines()


def apply_check_names(check_run_lines, app_id):
    """Every App-authored apply check name on the head, whatever the newest run's
    status — the apply workset's membership authority.

    Not the unlock queue's pending set: a completed run with a failing conclusion
    is not pending, but its cell must stay re-appliable, so the done cells are
    dropped by `filter_pending` (apply-gate's success/neutral predicate) instead."""
    return set(ag.latest_by_name(ag.app_runs(check_run_lines, app_id)))


def run_graph_deps():
    """The stack dependency graph, parsed. `--label stack.dir` is what makes
    waves.parse_dot's node normalization correct -- its docstring pins the argv
    as contract."""
    return wv.parse_dot(bm._run(["terramate", "experimental", "run-graph", "--label", "stack.dir"]))


def dag_shape_notice(deps):
    """One line describing the apply DAG's shape: how many stacks, how many
    declared `after` edges, how many topological levels, and how wide the widest
    level is.

    Always a notice, never a warning. Wave ordering comes only from the `after`
    DAG, and "no declared dependency" is a legitimate state, so nothing can
    detect a MISSING edge — a repository migrating from another tool leaves its
    ordering behind in that tool's config with nothing to say so. What this line
    buys is a reader who knows the repository seeing the concurrency figure and
    knowing at once whether it is true."""
    lv = wv.stack_levels(deps)
    return (
        f"::notice::{len(deps)} stacks, {sum(len(d) for d in deps.values())} after edges, "
        f"{len(lv)} wave levels; {max((len(x) for x in lv), default=0)} stacks would apply "
        "concurrently"
    )


def validate_head_sha(value):
    """Guard against a malformed SHIPMATE_HEAD_SHA retargeting the gh api URLs
    built from it (e.g. `/`, `?`, `..`). Safe to echo — not a secret."""
    if not _SHA_RE.fullmatch(value):
        raise SystemExit(
            f"::error::SHIPMATE_HEAD_SHA must be a 40-char lowercase hex SHA (got: {value!r})"
        )


def validate_env(value):
    """Refuse an empty `SHIPMATE_ENV`, or one `check_env_name` rejects.

    Empty is refused because each caller acts on exactly one environment. The
    `plan.<env>.<slug>` artifact name is unambiguous only because an env name never
    contains '.' — with env first, the first '.' after the `plan.` prefix is the
    env<->slug boundary. Terramate accepts '.' in a tag, so `env_membership` checks
    every tag-derived name; `SHIPMATE_ENV` arrives from a dispatch input instead, and
    is checked here with the same `check_env_name`. A dotted env would let distinct
    (env, slug) pairs render the same artifact name and cross-enrol the wrong stack
    into a wave."""
    if not value:
        raise SystemExit("::error::SHIPMATE_ENV is empty; this path is single-env.")
    bm.ec.check_env_name(value, f"SHIPMATE_ENV {value!r}", "the environment")


def refuse_unreviewed(env, table, decision):
    """Refuse a targeted apply the PR's review decision does not authorize.

    The same `authorize._review_reason` comment-ops evaluated, re-run against the
    decision the `review` job read server-side: comment-ops decided on the state
    at comment time, and an approval dismissed since then must not still apply.
    Refusing here rather than in workflow YAML is deliberate — the review job has
    no checkout, so it holds no scripts. The run dies before any wave, the apply
    checks stay pending, and the gate stays pending with them.

    `table` must have been through `validate_structure`: `ungated_envs` reads only a
    boolean `false` as ungated, so a `gated: no` would otherwise refuse as
    unreviewed rather than as the malformed setting it is."""
    ungated = bm.ec.ungated_envs(table)
    reason = az._review_reason(decision, env, ungated)
    if reason:
        raise SystemExit(f"::error::{reason}")


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    env = os.environ["SHIPMATE_ENV"]
    head = os.environ["SHIPMATE_HEAD_SHA"]

    validate_head_sha(head)
    # `_review_reason` reads an empty env as a bare apply, exempt when any entry is
    # ungated, so an empty SHIPMATE_ENV must be refused before `refuse_unreviewed`.
    validate_env(env)

    # Structure-validated before the refusal reads `gated`; `validate` re-runs it
    # below, which costs nothing and parses nothing again.
    table = bm.ec.read_table()
    bm.ec.validate_structure(table)
    decision = os.environ.get("SHIPMATE_REVIEW_DECISION", "")
    refuse_unreviewed(env, table, decision)
    no_review_required = (
        [env] if az._review_not_required(decision, env, bm.ec.ungated_envs(table)) else []
    )

    deps = run_graph_deps()

    app_id = os.environ["SHIPMATE_APP_ID"]
    # One listing answers all three questions — which cells this run applies,
    # which plan run each applies from, and which are already done — so a check
    # completing mid-run cannot make the three disagree.
    lines = _check_run_lines(repo, head)
    names = apply_check_names(lines, app_id)
    completed = ag.app_done_names(lines, app_id)

    # Tags only for the workset: this path reconstructs its cells from the head's
    # apply checks plus the run-graph, and evaluating the whole tree would let one
    # unrelated stack's unresolvable expression block an approved plan.
    paths = paths_with_checks(env, list(deps.keys()), names)
    cells = cells_for_env(env, paths, {p: bm._tags(p) for p in paths})
    table = bm.env_config(cells, table=table)
    cells = bm.stamp_rows(cells, table, "apply")

    pending = with_plan_runs(filter_pending(cells, completed), lines, app_id)
    bm.refuse_workload_gaps(pending, table)

    # Before the padding, whose over-depth refusal is where this line helps most.
    print(dag_shape_notice(deps))
    per_level = eo.waves_by_env_level(pending, deps, {})
    w0 = per_level[0]
    print(
        f"::notice title=apply-detect::env={env} head={head} "
        f"cells={len(cells)} completed={len(completed)} pending={len(pending)} "
        f"waves={[len(w) for w in w0.values()]} empty={not any(w0.values())}"
    )
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        eo.write_env_level_waves(fh, per_level)
        fh.write(f"head_sha={head}\n")
        fh.write(f"review_not_required_envs={json.dumps(no_review_required)}\n")


if __name__ == "__main__":
    main()
