#!/usr/bin/env python3
"""Apply detect: a dispatched single-env apply's work set + waves.

The dispatched workflow is the consumer's apply wrapper; the engine's own
`apply.yml` is `workflow_call` and is what that wrapper calls.

Unlike deploy-detect (merge-driven, all envs), the work set here is scoped to
ONE environment and sourced from the head's own apply checks: a run-graph stack
belongs to this run when `apply / <path> / <env>` is among the App-authored
checks on the head, and the plan run it applies from is the one that check
records. We drop cells whose apply check already completed (idempotent no-op),
then wave-order. A targeted `shipmate apply <env>` is single-env and explicit by
design — it never blocks on other environments; region-level sequencing across
envs is handled separately on the apply-all path.

Before any of that, the PR's review decision — read server-side by the `review`
job, narrowed by `SHIPMATE_UNGATED_ENVS` — must authorize this environment, or
the run refuses.

`completed_apply_names` lives here and this module's `main` calls it, so
test_detect_app_scoping's textual guard covers all three detects — but for this
one it proves nothing by itself: a substring cannot tell a call site from the
definition in the same file. The stronger pin on this `main` stays the
behavioural test_a_forged_completed_check_does_not_mark_a_cell_applied.
"""

import importlib.util
import json
import os
import pathlib
import re
from graphlib import CycleError
from importlib.machinery import SourceFileLoader

_D = pathlib.Path(__file__).resolve().parent

_SHA_RE = re.compile(r"^[0-9a-f]{40}$")


def _load(fname):
    loader = SourceFileLoader(fname.replace("-", "_"), str(_D / fname))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


bm = _load("build-matrix")
wv = _load("waves")
ag = _load("apply-gate")
az = _load("authorize")


def _check_name(stack, env):
    return f"apply / {stack} / {env}"


def paths_with_checks(env, candidate_paths, check_names):
    """The candidates whose `apply / <path> / <env>` check is on the head.

    Forward-construct the expected name per candidate path, never reverse-parse
    it: a stack path contains '/', so `apply / components/app / dev-eu` cannot be
    split back into its parts without inventing a convention — and a convention
    is a second reader of the name grammar. `pending-checks` builds these names
    from the stack PATH, so the exact path is what comes back; nothing here
    resolves a slug, which is what let two paths slugging alike apply each
    other's plan."""
    return [p for p in candidate_paths if _check_name(p, env) in check_names]


def cells_for_env(env, paths, tags_by_stack):
    """Wave cells for `paths` in `env`.

    `workload_var` comes from the tags, never from the check name — the name
    carries no workload. A stack missing from the map carries "" and applies with
    the environment's generic role; the map itself is REQUIRED, so a caller that
    stops deriving it raises here instead of silently applying every cell with
    the generic role."""
    return [
        {
            "stack": p,
            "environment": env,
            "workload_var": bm.workload_var(bm.workload_of(tags_by_stack.get(p, []))),
        }
        for p in paths
    ]


def with_plan_runs(cells, plan_runs):
    """Each cell gains the plan run id ITS OWN check records, so a cell recovered
    by a re-run plan job downloads from the run that re-planned it while its
    siblings stay on the original.

    A cell whose newest check records no usable run refuses. The alternative —
    falling back to a lookup keyed on a plan run's head_sha — is the platform
    dependency this path exists to drop, and a default would apply a cell from
    nowhere. Only cells still to be applied reach here: a cell applied by an
    older engine version carries a record-less check on that head forever, and
    refusing over one already-completed apply would strand every upgraded PR.

    The refusal is shared by all three detects, so it is worded for both paths:
    deploy's candidates come from the git diff rather than from the checks, so a
    cell here may have no apply check whatsoever, and its pull request is already
    merged — a remedy phrased as "re-plan on this pull request" would send a
    post-merge operator to a pull request that no longer accepts commits."""
    named = [(c, plan_runs.get(_check_name(c["stack"], c["environment"]))) for c in cells]
    missing = [_check_name(c["stack"], c["environment"]) for c, run in named if not run]
    if missing:
        raise SystemExit(
            f"::error::apply aborted: no plan run recorded for {', '.join(missing)} — the "
            "apply check names no plan run to apply from — most likely a check written "
            "before this engine version, and post-merge possibly no apply check for that "
            "cell at all. Re-plan these stacks on their pull request, then apply again; if "
            "that pull request has already merged, a new pull request touching them plans "
            "and applies them afresh."
        )
    return [{**c, "plan_run_id": run} for c, run in named]


def filter_pending(cells, completed_names):
    return [c for c in cells if _check_name(c["stack"], c["environment"]) not in completed_names]


def _check_run_lines(repo, head_sha):
    """The commit's check-runs as JSONL lines, for the two name queries below."""
    return bm._run(
        [
            "gh",
            "api",
            # filter=all keeps this listing in step with gate-refresh's
            # (test_check_runs_filter_aligned); --paginate --jq streams JSONL so
            # no page — hence no completed apply — is dropped on a >100-check PR.
            "--paginate",
            "--jq",
            ".check_runs[]",
            f"repos/{repo}/commits/{head_sha}/check-runs?filter=all&per_page=100",
        ]
    ).splitlines()


def apply_check_names(check_run_lines, app_id):
    """Every App-authored apply check name on the head, whatever the newest run's
    status — the apply workset's membership authority.

    Not `pending_apply_names`: a completed run with a failing conclusion is not
    pending, but its cell must stay re-appliable, so the done cells are dropped
    by `filter_pending` (apply-gate's success/neutral predicate) instead."""
    return set(ag.latest_by_name(ag.from_app(ag.parse_jsonl(check_run_lines), app_id)))


def completed_apply_names(check_run_lines, app_id):
    """App-authored apply checks already completed in `check_run_lines`, shared by
    all three detects so they judge the identical "already applied" set.

    Pure like `apply_check_names`, and for the same reason: every detect asks
    several questions of one listing, so the caller owns the fetch. Fetching here
    as well would give a caller two reads of one listing, and a re-plan landing
    between them re-opens a name the first read saw completed while its cell keeps
    the first read's plan-run record.

    Only App-authored checks count: a forged same-name check from any other
    identity must not mark work done (see apply-gate.app_done_names)."""
    return ag.app_done_names(check_run_lines, app_id)


def pending_apply_names(repo, head_sha):
    """App-authored apply checks on `head_sha` whose latest run is present and
    NOT completed — the inverse question `completed_apply_names` answers, and the
    unlock queue's only membership authority.

    Not `not app_done_names(...)`: a name absent from the listing has no run at
    all and is not pending, and a completed run with a bad conclusion is done
    being run whatever its verdict. Both would otherwise enrol a cell nobody
    asked about into a force-unlock. Built on the same apply-gate primitives so
    "newest run per name" and "authored by our App" have one definition each."""
    runs = ag.from_app(
        ag.parse_jsonl(_check_run_lines(repo, head_sha)), os.environ["SHIPMATE_APP_ID"]
    )
    return {n for n, r in ag.latest_by_name(runs).items() if r["status"] != "completed"}


def run_graph_deps():
    """The stack dependency graph, parsed. `--label stack.dir` is what makes
    waves.parse_dot's node normalization correct -- its docstring pins the argv
    as contract."""
    return wv.parse_dot(bm._run(["terramate", "experimental", "run-graph", "--label", "stack.dir"]))


def dag_shape_notice(deps):
    """One line describing the apply DAG's shape: how many stacks, how many
    declared `after` edges, how many topological levels, and how wide the widest
    level is.

    Always a notice, never a warning. Wave ordering comes only from the `after`
    DAG, and "no declared dependency" is a legitimate state, so nothing can
    detect a MISSING edge — a repository migrating from another tool leaves its
    ordering behind in that tool's config with nothing to say so. What this line
    buys is a reader who knows the repository seeing the concurrency figure and
    knowing at once whether it is true."""
    lv = wv.levels(deps)
    return (
        f"::notice::{len(deps)} stacks, {sum(len(d) for d in deps.values())} after edges, "
        f"{len(lv)} wave levels; {max((len(x) for x in lv), default=0)} stacks would apply "
        "concurrently"
    )


def validate_head_sha(value):
    """Guard against a malformed SHIPMATE_HEAD_SHA retargeting the gh api URLs
    built from it (e.g. `/`, `?`, `..`). Safe to echo — not a secret."""
    if not _SHA_RE.fullmatch(value):
        raise SystemExit(
            f"::error::SHIPMATE_HEAD_SHA must be a 40-char lowercase hex SHA (got: {value!r})"
        )


def validate_env(value):
    """The `plan.<env>.<slug>` artifact name is unambiguous only because an env
    name never contains '.' — with env first, the first '.' after the `plan.`
    prefix is the env<->slug boundary. Terramate tag grammar forbids '.' in tags
    (the source of env names), but that is an upstream tool's invariant; enforce
    it here at the trust boundary rather than trusting it silently. A dotted env
    would let distinct (env, slug) pairs render the same artifact name and
    cross-enrol the wrong stack into a wave — the exact bug the rename removed.

    Empty is refused for a second reason: `_review_reason` reads an empty
    environment as a BARE apply and exempts it whenever the variable names any
    env at all, so an unset SHIPMATE_ENV would slip past `refuse_unreviewed`
    below. This path is single-env by construction; there is no bare form here."""
    if not value:
        raise SystemExit(
            "::error::SHIPMATE_ENV is empty; the targeted apply path is single-env "
            "and its review refusal is evaluated per environment."
        )
    if "." in value:
        raise SystemExit(
            f"::error::SHIPMATE_ENV must not contain '.' (would break plan.<env>.<slug> "
            f"artifact-name disambiguation): {value!r}"
        )


def refuse_unreviewed(env, raw_ungated, decision):
    """Refuse a targeted apply the PR's review decision does not authorize.

    The same `authorize._review_reason` comment-ops evaluated, re-run against the
    decision the `review` job read server-side: comment-ops decided on the state
    at comment time, and an approval dismissed since then must not still apply.
    Refusing here rather than in workflow YAML is deliberate — the review job has
    no checkout, so it holds no scripts. The run dies before any wave, the apply
    checks stay pending, and the gate stays pending with them."""
    reason = az._review_reason(decision, env, az.parse_ungated_envs(raw_ungated))
    if reason:
        raise SystemExit(f"::error::{reason}")


def run_unlock(repo, env, head):
    """The unlock branch: the cells in `env` that HAVE a pending apply check, as
    a flat queue — releasing a lock has no dependencies, so there are no waves.

    Selection is by membership in `pending_apply_names`, not by removing the
    completed ones: every queued cell takes a real state lock and may force-break
    one, so a stack this pull request never planned — no apply check at all —
    must not be in range. The tree walk still supplies the cells because a
    check-run name carries no `workload_var`.

    Unlike the apply path it needs no plan run at all: a lock outlives the run
    that stranded it, those plan artifacts may be long expired, and unlock
    consumes no plan. The pending apply checks ARE the queue, the same authority
    deploy-detect uses.

    `all_stacks=True` evaluates tags across the whole tree, which the apply path
    deliberately avoids (one unrelated stack's unresolvable expression would
    block an approved plan). That trade is inverted here on purpose: unlock has
    no plan to protect, and it must reach a cell whose plan artifacts expired
    long ago. Deliberate, not an oversight.

    `require_env_tag=False` for the same reason the bare-apply path passes it: an
    untagged stack contributes no cell anyway, and unlock is the RECOVERY verb —
    reached when the pipeline is already degraded, which is exactly when a
    half-finished stack may be sitting in the tree. Failing loud there would make
    unlock unavailable for every environment precisely when it is needed.

    `env_membership` + `build_matrix([env], ...)` rather than `compute_cells`,
    which is what the bare-apply detect does with the same whole-tree walk and
    for the same reason: `build_matrix` refuses a set above the GHA matrix limit,
    and over `all_stacks=True` that ceiling counts every stack × every
    environment in the tree — so a repository large enough to exceed it could
    never unlock ANY environment, however short the queue, and the refusal would
    tell the operator to split a pull request that does not exist. Building only
    the target env's cells bounds the check to what the matrix will actually
    hold, and keeps the reserved-path, workload-collision and slug-collision
    guards `build_matrix` also carries. None of those three can affect an unlock —
    it consumes no plan artifact — so each is a refusal inherited from the reuse,
    and the slug one can make a repository with a latent colliding pair unable to
    unlock at all.

    `refuse_unreviewed` is skipped because an approval reviews a diff and unlock
    applies none — the run-time half of the decision `scripts/authorize` already
    made at comment time. `cells` is written in BOTH modes (`[]` on the apply
    path) because the unlock job's `strategy.matrix.include` is
    `fromJSON(cells)` and `fromJSON('')` is an error."""
    stacks_by_env, tags_by_stack = bm.env_membership(all_stacks=True, require_env_tag=False)
    cells = bm.build_matrix([env], stacks_by_env, tags_by_stack)
    names = pending_apply_names(repo, head)
    pending = [c for c in cells if _check_name(c["stack"], c["environment"]) in names]
    print(
        f"::notice title=apply-detect::mode=unlock env={env} head={head} "
        f"cells={len(cells)} pending={len(pending)}"
    )
    if not pending:
        print(
            f"::warning::no cell in {env} has a pending apply check, so no lock was "
            "probed; a lock on a cell whose check already completed, or on a stack "
            "applied out of band, is released out of band — see the state-lock "
            "section of docs/troubleshooting.md."
        )
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"cells={json.dumps(pending)}\n")
        fh.write(f"empty={'false' if pending else 'true'}\n")
        fh.write(f"head_sha={head}\n")


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    env = os.environ["SHIPMATE_ENV"]
    head = os.environ["SHIPMATE_HEAD_SHA"]

    validate_head_sha(head)
    validate_env(env)
    # Anything that is not exactly "unlock" takes the apply path, which is the
    # stricter of the two — an absent or garbled mode fails closed.
    if os.environ.get("SHIPMATE_MODE", "") == "unlock":
        return run_unlock(repo, env, head)

    refuse_unreviewed(
        env,
        os.environ.get("SHIPMATE_UNGATED_ENVS", ""),
        os.environ.get("SHIPMATE_REVIEW_DECISION", ""),
    )

    deps = run_graph_deps()

    app_id = os.environ["SHIPMATE_APP_ID"]
    # One listing answers all three questions — which cells this run applies,
    # which plan run each applies from, and which are already done — so a check
    # completing mid-run cannot make the three disagree.
    lines = _check_run_lines(repo, head)
    names = apply_check_names(lines, app_id)
    # The run ids are read only from records our App wrote (plan_runs_by_name's
    # from_app filter). That App authorship is what binds a run id to the plan
    # workflow; there is no workflow-path check to re-add here.
    plan_runs = ag.plan_runs_by_name(lines, app_id)
    completed = completed_apply_names(lines, app_id)

    # Tags only for the workset: this path reconstructs its cells from the head's
    # apply checks plus the run-graph, and evaluating the whole tree would let one
    # unrelated stack's unresolvable expression block an approved plan.
    paths = paths_with_checks(env, list(deps.keys()), names)
    cells = cells_for_env(env, paths, {p: bm._tags(p) for p in paths})

    pending = with_plan_runs(filter_pending(cells, completed), plan_runs)

    waves = wv.assign_waves(wv.levels(deps), pending)
    wv.guard_max_waves(waves)
    print(dag_shape_notice(deps))
    print(
        f"::notice title=apply-detect::env={env} head={head} "
        f"cells={len(cells)} completed={len(completed)} pending={len(pending)} "
        f"waves={[len(w) for w in waves]} empty={not any(waves)}"
    )
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        wv.write_waves(fh, waves)
        # Always written, in both modes: the unlock job fromJSONs it.
        fh.write("cells=[]\n")
        fh.write(f"head_sha={head}\n")


if __name__ == "__main__":
    try:
        main()
    except CycleError as e:
        raise SystemExit(f"::error::dependency cycle in run-graph: {e}") from e
