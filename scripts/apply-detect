#!/usr/bin/env python3
"""Apply detect: a dispatched apply's work set + waves, bare or targeted.

The dispatched workflow is the consumer's `shipmate.yml`, whose `apply` job
the `verb: apply` body selects; the engine's own `apply.yml` is `workflow_call`
and is what that job calls.

Both forms source the work set from the head's own apply checks: a stack
belongs to this run when `apply / <path> / <env>` is among the App-authored
checks on the head, and the plan run it applies from is the one that check
records. Cells whose apply check already completed are dropped (idempotent
no-op), and the rest wave-ordered. Both write the env-level output contract
deploy-detect writes (`waves.env_level_outputs`).

An empty `SHIPMATE_ENV` selects the bare form, `bare_main`: every environment's
pending cells, bucketed into env-levels by the entries' `needs`, after the
exclusions its docstring names.

A named environment selects the targeted form, scoped to that ONE environment.
It does not order by `needs`: it passes `waves.env_level_waves` an empty order,
which puts every cell at env-level 0 and leaves levels 1-3 empty. A cell that runs
after a cell pending in another environment waits (`waves.waiting_cells`): it stays
pending, `waiting_cells` names it, and the rest apply. A cell another pull request
holds a cell lock on stays pending the same way, named in `held_cells` (both forms),
and the cells that run after it wait. Before any of that, the
PR's review decision — read server-side by the `review` job, narrowed by
`review: false` on the environment's entry — must authorize this environment, or
the run refuses.

`SHIPMATE_AUTO=true` selects the auto form, `bare_main(auto=True)`: the bare form over the
`apply_mode: auto` environments alone, dispatched by the App after an autoplan, which also
refuses unless the actor, the plan's provenance, the pusher's permission and the pull
request's mergeability hold, and holds a cell whose stack the merge of the base into the
branch changes.
"""

import json
import os
import time

from _shipmate import (
    _load,
    _run,
    check_runs,
    gh_json,
    named,
    run_annotated,
    validate_head_sha,
    write_outputs,
)

bm = _load("build-matrix")
wv = _load("waves")
ag = _load("apply-gate")
az = _load("authorize")
cl = _load("cell-lock")

_NAMED = 10
#: The auto form's mergeability wait: reads, and seconds between them. Unprobed: GitHub
#: documents no bound on computing `mergeable` after a push.
_MERGEABLE_READS = 12
_MERGEABLE_WAIT = 5
_sleep = time.sleep
_AUTO_REMEDY = "Comment `shipmate apply` on the pull request to apply it."
# An auto run has no comment to repeat: its draft and mergeability refusals name the comment.
_AUTO_RETRY = "comment `shipmate apply`"


def paths_with_checks(env, candidate_paths, check_names):
    """The candidates whose `apply / <path> / <env>` check is on the head.

    Forward-construct the expected name per candidate path, never reverse-parse
    it: a stack path contains '/', so `apply / components/app / dev-eu` cannot be
    split back into its parts without inventing a convention — and a convention
    is a second reader of the name grammar. `pending-checks` builds these names
    from the stack PATH, so the exact path is what comes back; nothing here
    resolves a slug, which is what let two paths slugging alike apply each
    other's plan."""
    return [p for p in candidate_paths if ag.check_name(p, env) in check_names]


def cells_for_env(env, paths, tags_by_stack):
    """Wave cells for `paths` in `env`.

    The workload comes from the tags, never from the check name — the name
    carries no workload. A stack missing from the map raises `KeyError`: `tags_of`
    refuses such a stack first. A stack carrying two `workload/*` tags refuses
    (`workload_of`)."""
    return [
        {"stack": p, "environment": env, "workload": bm.workload_of(tags_by_stack[p], p)}
        for p in paths
    ]


def with_plan_runs(cells, check_run_lines, app_id, *, pr_number):
    """Each cell gains the plan run id and the plan-text digest ITS OWN check
    records in `check_run_lines`, so a cell recovered by a re-run plan job downloads
    from the run that re-planned it, and is bound to the plan text reviewed for it,
    while its siblings stay on the original.

    Both are read only from records App `app_id` wrote. That App authorship is what
    binds a run id to the plan workflow; there is no workflow-path check to re-add.

    A cell whose newest check records no usable run refuses. The alternative —
    falling back to a lookup keyed on a plan run's head_sha — is the platform
    dependency this path exists to drop, and a default would apply a cell from
    nowhere. Only cells still to be applied reach here: an applied cell needs no
    record, so a completed check that carries none never blocks its siblings.

    A cell with a run but no digest refuses separately, and says so separately:
    the causes differ, and a reader told "no plan run" would go looking for a
    check that exists. It refuses rather than applying unverified because an
    accepted absence is a guard the plan cell switches off by omitting a file.

    The run and digest refusals are shared by all three detects, so they are
    worded for both paths: deploy's candidates come from the git diff rather than
    from the checks, so a cell here may have no apply check whatsoever, and its
    pull request is already merged — a remedy phrased as "re-plan on this pull
    request" would send a post-merge operator to a pull request that no longer
    accepts commits. The partial-run refusal words its remedy for the path instead.

    `pr_number` binds each record to the dispatching pull request, and only the
    pre-merge paths pass one: a cell whose check records another pull request,
    or none, refuses with a re-plan remedy. Deploy passes None, which skips the
    check, because its pull request comes from `commits/{sha}/pulls` on the
    merged head rather than from a dispatch input.

    With at least one cell to apply, a run that published only part of its apply
    checks refuses last (`refuse_incomplete`): a cell recording it, or the head's
    newest run being it, means a cell that run planned may be missing from this
    apply's view, and with it an ordering. It follows the pull-request binding so
    that a cell planned on another pull request is refused as that, not over the
    other pull request's run. With no cell to apply nothing is read, so a fully
    applied pull request whose records predate the count never refuses."""
    records = ag.plan_records(check_run_lines, app_id)
    rows = []
    for c in cells:
        name = ag.check_name(c["stack"], c["environment"])
        run, digest, pr = records.get(name, (None, None, None))
        rows.append((c, name, run, digest, pr))
    missing = [name for _, name, run, _, _ in rows if not run]
    if missing:
        raise SystemExit(
            f"::error::apply aborted: no plan run recorded for {', '.join(missing)}: the "
            "apply check names no plan run to apply from (post-merge, the cell may have no "
            "apply check at all), so the apply is refused. Re-plan these stacks on their pull "
            "request, then apply again; if that pull request has already merged, a new pull "
            "request touching them plans and applies them afresh."
        )
    unbound = [name for _, name, _, digest, _ in rows if not digest]
    if unbound:
        raise SystemExit(
            f"::error::apply aborted: no plan-text digest recorded for {', '.join(unbound)}: "
            "the reviewed plan text cannot be checked against the plan that would be applied, "
            "so this apply is refused rather than run unverified. Re-plan these stacks on "
            "their pull request, then apply again; if that pull request has already merged, a "
            "new pull request touching them plans and applies them afresh."
        )
    foreign = [
        f"{name} (plan run {run}, {'pull request #' + pr if pr else 'records no pull request'})"
        for _, name, run, _, pr in rows
        if pr_number is not None and pr != pr_number
    ]
    if foreign:
        raise SystemExit(
            f"::error::apply aborted: the plan recorded for {', '.join(foreign)} was not made "
            f"on pull request #{pr_number}, so this apply is refused. Re-plan on this pull "
            "request (push or comment `shipmate plan`), then apply again; if another open pull "
            "request shares this head commit, the newest plan decides which one may apply."
        )
    if cells:
        refuse_incomplete(
            rows, records, ag.incomplete_runs(check_run_lines, app_id), merged=pr_number is None
        )
    return [{**c, "plan_run_id": run, "plan_sha256": digest} for c, _, run, digest, _ in rows]


def _fact(published, counts, uncounted):
    """Every cause `apply-gate.incomplete_runs` found for one run, joined with `and`: an
    uncounted record, and a count that disagrees with another or with the checks published."""
    facts = []
    if uncounted:
        facts.append(
            f"records no planned cell count on {'some of ' if counts else ''}its apply checks"
        )
    if len(counts) > 1:
        listed = ", ".join(map(str, counts))
        facts.append(f"records disagreeing planned cell counts ({listed}) on its apply checks")
    elif counts and counts[0] != published:
        facts.append(
            f"published {_n(published, 'apply check')} for {_n(counts[0], 'planned cell')}"
        )
    return " and ".join(facts)


def _n(count, noun):
    return f"{count} {noun}{'' if count == 1 else 's'}"


def _stopped_publishing(published, counts, uncounted):
    """Fewer checks than one agreed count: the summary job stopped mid-publish, which fails it,
    and re-running the run's failed jobs publishes the rest. No other fact says a job failed."""
    return not uncounted and len(counts) == 1 and published < counts[0]


def refuse_incomplete(rows, records, incomplete, *, merged):
    """Refuse when a run that a cell to apply records, or the head's newest run, published only
    part of its apply checks (`apply-gate.incomplete_runs`). Each such run is named with its
    fact and the cells it holds back: the cells recording it, or every cell to apply when no
    cell records it (the newest run). Runs compare as integers, so `10` is newer than `9`.
    Called only with at least one cell, each recording a run, so the newest run exists. The
    remedy follows the pull request's state: open, it offers re-running failed jobs only when
    every named run `_stopped_publishing`, then a push; `merged`, a new pull request."""
    candidates = {run for _, _, run, _, _ in rows}
    candidates.add(max((run for run, _, _ in records.values() if run), key=int))
    named_runs = sorted(candidates & incomplete.keys(), key=int)
    if not named_runs:
        return
    found = []
    for run in named_runs:
        held = [name for _, name, r, _, _ in rows if r == run] or [name for _, name, *_ in rows]
        found.append(
            f"plan run {run} {_fact(*incomplete[run])}, holding back {named(held, _NAMED)}"
        )
    it, runs = ("it", "run") if len(found) == 1 else ("they", "runs")
    if merged:
        remedy = (
            "The pull request has merged, so a new pull request touching these stacks plans and "
            "applies them."
        )
    else:
        remedy = "Push"
        if all(_stopped_publishing(*incomplete[run]) for run in named_runs):
            remedy = (
                f"Re-run the failed jobs of the plan {runs} (not all jobs), then apply again; if "
                "the refusal remains, push"
            )
        remedy += (
            " a commit to the pull request, which plans and publishes every cell afresh, then "
            "apply again."
        )
    raise SystemExit(
        f"::error::apply aborted: {'; '.join(found)}: the published apply checks do not "
        f"match the cells {it} planned, so an ordering among them can be lost. {remedy}"
    )


def cells_from_checks(check_names, stacks_by_env, tags_by_stack):
    """All-envs workset: per env (from tags, never from a parse of a check
    name), the tree's candidates whose forward-constructed check name is on the
    head — exactly the targeted path's matching and workload handling, run
    over every env."""
    cells = []
    for env in sorted(stacks_by_env):
        paths = paths_with_checks(env, stacks_by_env[env], check_names)
        cells.extend(cells_for_env(env, paths, tags_by_stack))
    return cells


def filter_pending(cells, completed_names):
    return [c for c in cells if ag.check_name(c["stack"], c["environment"]) not in completed_names]


def pending_tuples(check_names, completed_names, stacks_by_env):
    """Every (stack, env) whose apply check is on the head and not done, in every env.

    Tuples, never cells: `cells_for_env` refuses a two-workload stack, and another
    environment's stack must not refuse this run."""
    return {
        (p, e)
        for e, stacks in stacks_by_env.items()
        for p in paths_with_checks(e, stacks, check_names)
        if ag.check_name(p, e) not in completed_names
    }


def drop_waiting(cells, waiting):
    keys = {(w["stack"], w["environment"]) for w in waiting}
    return [c for c in cells if (c["stack"], c["environment"]) not in keys]


def locked_cells(repo, pending, pr_number):
    """`cell_lock.foreign` over `pending`: the cells another pull request holds a lock on.
    Reads only the pending cells' environments; a failed read refuses the run."""
    locks = cl.read_locks(repo, {c["environment"] for c in pending}, run=_run)
    return cl.foreign(locks, pending, int(pr_number))


def held_cells(locked, overlap=()):
    """`locked` and `overlap` as one list, each cell tagged with its `cause`, `"locked"` or
    `"overlap"`; a locked cell keeps its `holder`. A cell in both is listed once per cause, so
    the comment's footer names both remedies: evicting the lock does not clear the overlap."""
    return [{**c, "cause": "locked"} for c in locked] + [{**c, "cause": "overlap"} for c in overlap]


def settle(order, stopped, pending, deps, tags, level, locked=frozenset()):
    """(sorted skipped envs, run cells, waiting cells) at the joint fixpoint of `needs`
    skips and waiting cells.

    An env with a waiting cell, or a cell in `locked` ((stack, env) pairs another pull
    request holds, or the auto form's overlap cells), is not fully applying, so it stops its
    `needs` successors like a stopped env, and each new skip can make more cells wait. A locked
    cell never runs; the env's ready cells still do: it joins `unavailable`, never `skipped`.
    `unavailable` only grows over a finite set, so the loop ends."""
    envs = {c["environment"] for c in pending} - stopped
    present = {(c["stack"], c["environment"]) for c in pending}
    lock_envs = {e for _, e in locked}
    unavailable, last = stopped | lock_envs, None
    while True:
        skipped = wv.blocked_envs(order, unavailable, envs)
        run = [
            c
            for c in pending
            if c["environment"] not in stopped | skipped
            and (c["stack"], c["environment"]) not in locked
        ]
        waiting = wv.waiting_cells(run, present, deps, tags, level)
        if (skipped, waiting) == last:
            return sorted(skipped), run, waiting
        last = (skipped, waiting)
        unavailable = stopped | skipped | lock_envs | {w["environment"] for w in waiting}


def _check_run_lines(repo, head_sha):
    """The commit's check-runs as JSONL lines, for the apply and unlock name queries."""
    return check_runs(repo, head_sha, run=_run).splitlines()


def apply_check_names(check_run_lines, app_id):
    """Every App-authored apply check name on the head, whatever the newest run's
    status — the apply workset's membership authority.

    Not the unlock queue's pending set: a completed run with a failing conclusion
    is not pending, but its cell must stay re-appliable, so the done cells are
    dropped by `filter_pending` (apply-gate's success/neutral predicate) instead."""
    return set(ag.latest_by_name(ag.app_runs(check_run_lines, app_id)))


def dag_shape_notice(deps):
    """One line describing the apply DAG's shape: how many stacks, how many
    declared `after` edges, how many topological levels, and how wide the widest
    level is.

    Always a notice, never a warning. Wave ordering comes only from the `after`
    DAG, and "no declared dependency" is a legitimate state, so nothing can
    detect a MISSING edge — a repository migrating from another tool leaves its
    ordering behind in that tool's config with nothing to say so. What this line
    buys is a reader who knows the repository seeing the concurrency figure and
    knowing at once whether it is true."""
    lv = wv.stack_levels(deps)
    return (
        f"::notice::{len(deps)} stacks, {sum(len(d) for d in deps.values())} after edges, "
        f"{len(lv)} wave levels; {max((len(x) for x in lv), default=0)} stacks would apply "
        "concurrently"
    )


def validate_env(value):
    """Refuse an empty `SHIPMATE_ENV`, or one `check_env_name` rejects.

    Empty is refused because each caller acts on exactly one environment: `main`
    routes an empty env to `bare_main` before calling this, and unlock-detect has no
    all-environments form. The `plan.<env>.<slug>` artifact name is unambiguous only
    because an env name never contains '.' — with env first, the first '.' after the
    `plan.` prefix is the env<->slug boundary. Terramate accepts '.' in a tag, so
    `env_membership` checks every tag-derived name; `SHIPMATE_ENV` arrives from a
    dispatch input instead, and is checked here with the same `check_env_name`. A
    dotted env would let distinct (env, slug) pairs render the same artifact name
    and cross-enrol the wrong stack into a wave."""
    if not value:
        raise SystemExit("::error::SHIPMATE_ENV is empty; this path is single-env.")
    bm.ec.check_env_name(value, f"SHIPMATE_ENV {value!r}", "the environment")


def refuse_unreviewed(env, table, decision):
    """Refuse a targeted apply the PR's review decision does not authorize.

    The same `authorize._review_reason` comment-ops evaluated, re-run against the
    decision the `review` job read server-side: comment-ops decided on the state
    at comment time, and an approval dismissed since then must not still apply.
    The run dies before any wave, the apply checks stay pending, and the gate stays
    pending with them.

    `table` must have been through `validate_structure`: `exempt_envs` reads only a
    boolean `false` as review-exempt, so a `review: no` would otherwise refuse as
    unreviewed rather than as the malformed setting it is."""
    exempt = bm.ec.exempt_envs(table)
    reason = az._review_reason(decision, env, exempt)
    if reason:
        raise SystemExit(f"::error::{reason}")


def refuse_actor(lines, app_id, actor, triggering_actor):
    """Refuse unless `actor` and `triggering_actor` are the bot login of the App that authored
    the head's checks.

    The whole string, never a `[bot]` suffix: a `GITHUB_TOKEN` dispatch runs as
    `github-actions[bot]`. The slug comes from the App-authored check runs, so a head with
    none refuses. A human's "Re-run all jobs" keeps `actor` and makes the human
    `triggering_actor`, so a re-run refuses."""
    slugs = {(r.get("app") or {}).get("slug") for r in ag.app_runs(lines, app_id)}
    if not slugs:
        raise SystemExit(
            "::error::auto apply refused: no check run on the head is authored by the shipmate "
            "App, so its bot login is unknown. " + _AUTO_REMEDY
        )
    bots = {f"{s}[bot]" for s in slugs if s}
    if actor not in bots:
        raise SystemExit(
            f"::error::auto apply refused: the run's actor is {actor!r}, not the shipmate App: "
            "only the App dispatches an auto apply, after an autoplan. " + _AUTO_REMEDY
        )
    if triggering_actor not in bots:
        raise SystemExit(
            f"::error::auto apply refused: the run's triggering actor is {triggering_actor!r}, "
            "not the shipmate App: a re-run of an auto apply never applies. " + _AUTO_REMEDY
        )


def refuse_provenance(repo, head, runnable, actions):
    """The newest autoplan of `head`, refused unless every cell in `runnable` records one plan
    run and `apply-gate.provenance_reason` admits it, with each cell's event action from
    `actions` (`apply-gate.plan_actions`).

    A `shipmate plan` run is a `workflow_dispatch` the App sends, so its commenter is lost and
    nothing authorizes it as the pusher; it is never listed. A newer autoplan of the head that
    recorded no cell must not leave an older one applying. A ready-for-review or reopen autoplan
    dispatches no auto apply yet becomes the newest autoplan, and its clicker is no pusher; a
    record with no action is an older engine's."""
    runs = sorted({c["plan_run_id"] for c in runnable}, key=int)
    if len(runs) > 1:
        listed = "; ".join(
            f"plan run {r}: "
            + named(
                [
                    ag.check_name(c["stack"], c["environment"])
                    for c in runnable
                    if c["plan_run_id"] == r
                ],
                _NAMED,
            )
            for r in runs
        )
        raise SystemExit(
            f"::error::auto apply refused: the cells to apply record different plan runs "
            f"({listed}), so no one autoplan planned them all. " + _AUTO_REMEDY
        )
    try:
        newest = ag.newest_autoplan(repo, head, run=_run)
    except ValueError as e:
        raise _malformed("autoplan listing", e) from None
    names = [ag.check_name(c["stack"], c["environment"]) for c in runnable]
    cells = {n: (c["plan_run_id"], actions.get(n)) for n, c in zip(names, runnable, strict=True)}
    reason = ag.provenance_reason(newest, runs[0], head, cells)
    if reason:
        raise SystemExit(
            f"::error::auto apply refused: {_provenance_text(runs[0], head, *reason)} "
            + _AUTO_REMEDY
        )
    return newest


def _provenance_text(run_id, head, cause, detail):
    """`apply-gate.provenance_reason`'s `(cause, detail)` for plan run `run_id`, as one
    sentence."""
    if cause == "unlisted":
        return f"plan run {run_id} is not listed, and no autoplan run of the head is listed."
    if cause == "newer":
        return f"plan run {run_id} is not the newest autoplan of the head (run {detail} is)."
    if cause == "event":
        return (
            f"plan run {run_id} is a `{detail}` run, not an autoplan: an auto apply applies "
            "only the plan a push started."
        )
    if cause == "head":
        return f"plan run {run_id} planned {detail}, not the head {head}."
    if cause == "record":
        return (
            f"the plan records of {named([n for n, _ in detail], _NAMED)} name other plan runs "
            f"than {run_id}."
        )
    bad = [f"{n} ({a!r})" for n, a in detail]
    return (
        f"the plan records of {named(bad, _NAMED)} name no push event action (opened or "
        "synchronize), so no push started that plan."
    )


def _malformed(what, e):
    return SystemExit(
        f"::error::auto apply refused: the {what} read returned a malformed answer ({e!r}). "
        + _AUTO_REMEDY
    )


def refuse_pusher(repo, newest):
    """Refuse unless `authorize.pusher_reason` admits the pusher of `newest`, the listed
    autoplan."""
    reason = az.pusher_reason(repo, newest, run=_run)
    if reason:
        raise SystemExit(f"::error::{reason}")


def wait_mergeable(repo, pr_number, head):
    """The pull request's base tip, after re-reading it until GitHub has computed `mergeable`
    or `_MERGEABLE_READS` reads are spent, then refusing as `authorize.decide` does on its head
    repository, draft and mergeable state. Every read refuses when the head moved: the new
    head's autoplan decides its own apply. The base tip is the base branch's
    (`apply-gate.base_tip`); one that cannot be read refuses."""
    for i in range(_MERGEABLE_READS):
        if i:
            _sleep(_MERGEABLE_WAIT)
        pr = gh_json(f"repos/{repo}/pulls/{pr_number}", run=_run)
        sha = (pr.get("head") or {}).get("sha")
        if sha != head:
            raise SystemExit(
                f"::error::auto apply refused: pull request #{pr_number} head is {sha}, but this "
                f"run applies {head}. The new head's autoplan decides its own apply."
            )
        if pr.get("mergeable") is not None:
            break
    reason = az._head_repo_reason(pr) or az._ready_reason(pr, retry=_AUTO_RETRY)
    if reason:
        raise SystemExit(f"::error::{reason}")
    try:
        return ag.base_tip(repo, pr, run=_run)
    except SystemExit as e:
        why = str(e.code).removeprefix("::error::")
    except (LookupError, TypeError, AttributeError) as e:
        why = repr(e)
    raise SystemExit(
        f"::error::auto apply refused: could not read the base tip of pull request "
        f"#{pr_number} ({why}). " + _AUTO_REMEDY
    )


def overlap_cells(candidates, changed):
    """`{stack, environment}` of each cell in `candidates` whose stack is in `changed`, the
    stacks the merge of the base into the branch changes, directly or through a module they
    source, or removes files in: applying its plan would revert that change."""
    return [
        {"stack": c["stack"], "environment": c["environment"]}
        for c in candidates
        if c["stack"] in changed
    ]


def bare_main(auto=False):
    """The bare `shipmate apply` work set -> env-levels -> waves.

    The pre-merge equivalent of deploy-detect, sourced like the targeted form:
    cells are the tree's stacks whose `apply / <stack> / <env>` check is on the
    head, each applying from the plan run its own check records, and the
    environment entries' `needs` bucket the pending ones into env-levels exactly as
    on the merge-deploy path. Env membership comes from stack tags
    (build-matrix.env_membership) so this form only ever constructs check names
    forward, never reverse-parses them (deploy-detect's stranded-check refusal is
    the one site that does); a stack with no `env/*` tag is in no environment and
    adds no cell.

    After `settle`, it refuses a run cell that runs after a pending cell `needs` puts on a
    later env-level (`waves.refuse_inversions`): a cell of an env `settle` skips is no root. A
    waiting run cell stays one, and a held or targeted upstream counts, so the contradiction
    refuses rather than wait for a review or apply that would only reach this refusal. Four
    exclusions distinguish the bare form from deploy:
    - envs whose entry holds `apply_mode: targeted` (typically prod) are removed
      before env-levels are built; their apply checks stay pending, so
      `shipmate / gate` keeps gating the merge until a targeted
      `shipmate apply <env>` completes them. `excluded_envs` names every one with
      pending work, including those also held for review;
    - envs ordered (transitively) after an env not fully applying this run — held,
      excluded as targeted, holding a waiting cell, holding a cell another pull request
      locks, or, under the auto form, holding a cell the base also changed or not
      `apply_mode: auto` — are skipped with a notice
      (`skipped_after_targeted`, named for its first cause) — their ordering
      precondition cannot be met this run, exactly like a failed predecessor
      level. `skipped_after` maps each to its transitive predecessors not fully
      applying for a cause of their own;
    - envs the PR's review decision does not authorize are held until it carries
      an approving review, dropped the same way; an entry holding
      `review: false` is exempt from that hold;
    - cells that run after a pending cell not applying this run wait, named in
      `waiting_cells`. An env with a waiting cell stops its `needs` successors, and
      each new skip can make more cells wait: `settle` runs both to one fixpoint.

    A pending cell another pull request locks (`locked_cells`) stays pending and applies
    nowhere, exactly like a waiting cell; it is named in `held_cells`. Locks are read only
    in the envs neither held nor excluded as targeted.

    `auto` is the auto form, over the `apply_mode: auto` environments' pending cells.
    Every other pending environment counts as stopped in `settle`, so its `needs` successors
    skip as a held one's do; review holds, locks, waiting cells and `excluded_envs` are the
    bare form's. First the run's actor must be the App's bot login (`refuse_actor`). With a
    pending cell in an environment not stopped, the pull request must be ready and mergeable at
    this head (`wait_mergeable`), and a cell whose stack the merge of the base into the branch
    changes, directly or through a module it sources, or removes files in
    (`build-matrix.base_changed_stacks`) is named in `held_cells`: it stays pending and stops
    its environment's `needs` successors, as a locked cell does. With a cell to apply, its
    records must name one plan run that `apply-gate.provenance_reason` admits against the
    head's newest autoplan listed (`refuse_provenance`), and that listed run's pusher must have
    write access (`refuse_pusher`). Writes the bare outputs plus
    `provenance_run`, empty when no cell applies, `base_sha`, the base tip overlap was computed
    on, empty when no pull request read was needed, and `bare_envs`, the
    pending environments neither `auto`, `targeted` nor held, left for a bare apply.
    """
    repo = os.environ["GITHUB_REPOSITORY"]
    head = os.environ["SHIPMATE_HEAD_SHA"]

    validate_head_sha(head)
    pr_number = ag.env_pr_number()

    stacks_by_env, tags_by_stack = bm.env_membership(all_stacks=True)
    app_id = os.environ["SHIPMATE_APP_ID"]
    lines = _check_run_lines(repo, head)
    if auto:
        refuse_actor(
            lines,
            app_id,
            os.environ.get("GITHUB_ACTOR", ""),
            os.environ.get("GITHUB_TRIGGERING_ACTOR", ""),
        )
    cells = cells_from_checks(apply_check_names(lines, app_id), stacks_by_env, tags_by_stack)
    table = bm.env_config(cells, bm.tagged_workloads(stacks_by_env, tags_by_stack))
    cells = bm.stamp_rows(cells, table, "apply")

    pending = filter_pending(cells, ag.app_done_names(lines, app_id))

    deps = bm.run_graph_deps()
    order = bm.ec.env_order(table)
    levels = wv.cell_levels(order, tags_by_stack)
    pending_envs = {c["environment"] for c in pending}
    exempt = bm.ec.exempt_envs(table)
    decision = os.environ.get("SHIPMATE_REVIEW_DECISION", "")
    # An absent decision reads as '' and holds every env. It is reachable only through
    # wiring drift: the review job has no `if:`, and a failed one skips this script.
    held = sorted(e for e in pending_envs if az._review_reason(decision, e, exempt))
    targeted = bm.ec.targeted_envs(table)
    stopped = pending_envs & set(targeted + held)
    # Pending envs the auto form leaves to a bare apply: neither targeted nor held, not auto.
    unselected = pending_envs - set(bm.ec.auto_envs(table)) - stopped if auto else set()
    stopped |= unselected
    # Envs neither held nor excluded as targeted; a needs-skipped env's lock stays because a
    # waiting cell's remedy names it.
    candidates = [c for c in pending if c["environment"] not in stopped]
    overlap, base_sha = [], ""
    if auto and candidates:
        # One read: the wave re-check compares the base tip with the one overlap was computed on.
        base_sha = wait_mergeable(repo, pr_number, head)
        stacks = {c["stack"] for c in candidates}
        overlap = overlap_cells(candidates, bm.base_changed_stacks(base_sha, stacks))
    locked = locked_cells(repo, candidates, pr_number)
    holds = {(c["stack"], c["environment"]) for c in [*locked, *overlap]}
    skipped, run, waiting = settle(order, stopped, pending, deps, tags_by_stack, levels, holds)
    # A skipped env names the predecessors not fully applying for a cause of their own, each with
    # a remedy of its kind; one skipped for nothing but its own predecessors is passed through.
    blockers = stopped | {e for _, e in holds} | {w["environment"] for w in waiting}
    skipped_after = {e: sorted(wv.predecessors(order, e) & blockers) for e in skipped}
    wv.refuse_inversions(
        run, {(c["stack"], c["environment"]) for c in pending}, deps, tags_by_stack, order
    )
    # Every pending targeted env, held or not: the comment names a held one's
    # targeted command under the hold. A held env that is not targeted stays out.
    excluded = sorted(pending_envs & set(targeted))
    # The plan runs attach to `runnable`, not `pending`: an excluded, held, waiting or locked
    # cell's check stays pending by design for a later apply, and that apply refuses on its own
    # over a record-less cell, so refusing here would strand the cells that CAN apply.
    runnable = with_plan_runs(drop_waiting(run, waiting), lines, app_id, pr_number=pr_number)
    bm.refuse_workload_gaps(runnable, table)
    auto_outputs = {}
    if auto:
        provenance_run = ""
        if runnable:
            actions = ag.plan_actions(lines, app_id)
            refuse_pusher(repo, refuse_provenance(repo, head, runnable, actions))
            provenance_run = runnable[0]["plan_run_id"]
        auto_outputs = {
            "provenance_run": provenance_run,
            "base_sha": base_sha,
            "bare_envs": json.dumps(sorted(unselected)),
        }
    # From `runnable`, never from `pending & exempt`: an exempt env can still be
    # excluded or skipped, and claiming it applied is worse than saying nothing.
    applied_exempt = sorted(
        {
            c["environment"]
            for c in runnable
            if az._review_exemption(decision, c["environment"], exempt)
        }
    )
    # From `runnable` for the same reason.
    no_review_required = sorted(
        {
            c["environment"]
            for c in runnable
            if az._review_not_required(decision, c["environment"], exempt)
        }
    )

    # Before the padding, whose over-depth refusal is where this line helps most.
    print(dag_shape_notice(deps))
    per_level = wv.env_level_waves(runnable, order, deps)
    level_counts = [sum(map(len, w.values())) for w in per_level]
    # The title is what `apply-comment`'s held-env remedy and CONTRACT.md tell reviewers to
    # read; rename all three together.
    print(
        f"::notice title=apply-all-detect::head={head} "
        f"cells={len(cells)} pending={len(pending)} envlevels={level_counts} "
        f"excluded_targeted={excluded} skipped_after_targeted={skipped} "
        f"review_held={held} waiting={len(waiting)} locked={len(locked)} overlap={len(overlap)} "
        f"applied_exempt={applied_exempt} "
        # The hold cause: an everything-held run is otherwise indistinguishable
        # from a CHANGES_REQUESTED one, and an absent decision (a mis-wired
        # review job) renders visibly as ''.
        f"review_decision={decision!r}"
    )
    write_outputs(
        **wv.env_level_outputs(per_level),
        head_sha=head,
        excluded_envs=json.dumps(excluded),
        skipped_envs=json.dumps(skipped),
        skipped_after=json.dumps(skipped_after),
        review_held_envs=json.dumps(held),
        applied_exempt_envs=json.dumps(applied_exempt),
        review_not_required_envs=json.dumps(no_review_required),
        waiting_cells=json.dumps(waiting),
        held_cells=json.dumps(held_cells(locked, overlap)),
        # Over `cells`, not `runnable`: the comment lists excluded, held, waiting and locked cells.
        env_order=json.dumps(wv.env_sequence(order, {c["environment"] for c in cells})),
        **auto_outputs,
    )


def main():
    if os.environ.get("SHIPMATE_AUTO") == "true":
        bare_main(auto=True)
        return
    env = os.environ["SHIPMATE_ENV"]
    # Routed before `refuse_unreviewed`: `_review_reason` reads an empty env as a bare
    # apply, exempt when any entry is review-exempt, so it must never reach the targeted refusal.
    if not env:
        bare_main()
        return
    repo = os.environ["GITHUB_REPOSITORY"]
    head = os.environ["SHIPMATE_HEAD_SHA"]

    validate_head_sha(head)
    validate_env(env)
    pr_number = ag.env_pr_number()

    # Structure-validated before the refusal reads `review`; `validate` re-runs it
    # below, which costs nothing and parses nothing again.
    table = bm.ec.read_table()
    bm.ec.validate_structure(table)
    decision = os.environ.get("SHIPMATE_REVIEW_DECISION", "")
    refuse_unreviewed(env, table, decision)
    no_review_required = (
        [env] if az._review_not_required(decision, env, bm.ec.exempt_envs(table)) else []
    )

    deps = bm.run_graph_deps()

    app_id = os.environ["SHIPMATE_APP_ID"]
    # One listing answers all three questions — which cells this run applies,
    # which plan run each applies from, and which are already done — so a check
    # completing mid-run cannot make the three disagree.
    lines = _check_run_lines(repo, head)
    names = apply_check_names(lines, app_id)
    completed = ag.app_done_names(lines, app_id)

    paths = paths_with_checks(env, list(deps.keys()), names)
    tag_map = bm.all_tags()
    cells = cells_for_env(env, paths, bm.tags_of(paths, tag_map))
    table = bm.env_config(cells, table=table)
    cells = bm.stamp_rows(cells, table, "apply")

    all_pending = pending_tuples(names, completed, wv.env_stacks(tag_map))
    pending = filter_pending(cells, completed)
    locked = locked_cells(repo, pending, pr_number)
    run = drop_waiting(pending, locked)
    levels = wv.cell_levels(bm.ec.env_order(table), tag_map)
    waiting = wv.waiting_cells(run, all_pending, deps, tag_map, levels)
    # Locked and waiting cells drop before `with_plan_runs`: their checks stay pending for a later
    # apply, which refuses on its own over a record-less cell.
    runnable = with_plan_runs(drop_waiting(run, waiting), lines, app_id, pr_number=pr_number)
    bm.refuse_workload_gaps(runnable, table)

    # Before the padding, whose over-depth refusal is where this line helps most.
    print(dag_shape_notice(deps))
    per_level = wv.env_level_waves(runnable, {}, deps)
    w0 = per_level[0]
    print(
        f"::notice title=apply-detect::env={env} head={head} "
        f"cells={len(cells)} completed={len(completed)} pending={len(pending)} "
        f"waiting={len(waiting)} locked={len(locked)} "
        f"waves={[len(w) for w in w0.values()]} empty={not any(w0.values())}"
    )
    write_outputs(
        **wv.env_level_outputs(per_level),
        head_sha=head,
        review_not_required_envs=json.dumps(no_review_required),
        waiting_cells=json.dumps(waiting),
        held_cells=json.dumps(held_cells(locked)),
        env_order=json.dumps([env]),
    )


if __name__ == "__main__":
    run_annotated(main, refusal_output=True)
