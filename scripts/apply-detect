#!/usr/bin/env python3
"""Apply detect: a dispatched single-env apply's work set + waves.

The dispatched workflow is the consumer's apply wrapper; the engine's own
`apply.yml` is `workflow_call` and is what that wrapper calls.

Unlike deploy-detect (merge-driven, all envs), the work set here is scoped to
ONE environment and sourced from a specific plan run's plan artifacts:
`plan.<env>.<slug>` artifacts present in SHIPMATE_PLAN_RUN_ID name exactly the
stacks that were planned for this env. We map each present slug back to a stack
PATH via the run-graph (path->slug is one-way; we slug each graph node forward
and match), drop cells whose apply check already completed (idempotent no-op),
then wave-order. A targeted `shipmate apply <env>` is single-env and explicit by
design — it never blocks on other environments; region-level sequencing across
envs is handled separately on the apply-all path.
"""

import importlib.util
import os
import pathlib
import re
from graphlib import CycleError
from importlib.machinery import SourceFileLoader

_D = pathlib.Path(__file__).resolve().parent

_SHA_RE = re.compile(r"^[0-9a-f]{40}$")
_RUN_ID_RE = re.compile(r"^[0-9]+$")


def _load(fname):
    loader = SourceFileLoader(fname.replace("-", "_"), str(_D / fname))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


bm = _load("build-matrix")
wv = _load("waves")
ag = _load("apply-gate")


def _slug(path):
    return path.replace("/", "-")


def workset_paths(artifact_names, env, graph_paths):
    """Graph stacks whose exact `plan.<env>.<slug>` artifact is present."""
    names = set(artifact_names)
    return [p for p in graph_paths if f"plan.{env}.{_slug(p)}" in names]


def workset_from_artifacts(artifact_names, env, graph_paths, tags_by_stack):
    """Cells for `env` = graph stacks whose exact `plan.<env>.<slug>` artifact is
    present in the plan run. Forward-construct the expected name per graph path,
    never reverse-parse it (`validate_env` guards what makes that safe).
    path->slug is many-to-one, so fail loud if two paths collide.

    `workload_var` comes from the tags, never from the artifact name: the slug
    grammar is what keeps artifact names collision-free and nothing may be added
    to it. A stack missing from the map carries "" and applies with the
    environment's generic role; the map itself is REQUIRED, so a caller that
    stops deriving it raises here instead of silently applying every cell with
    the generic role."""
    cells = [
        {
            "stack": p,
            "environment": env,
            "workload_var": bm.workload_var(bm.workload_of(tags_by_stack.get(p, []))),
        }
        for p in workset_paths(artifact_names, env, graph_paths)
    ]
    slugs = [_slug(c["stack"]) for c in cells]
    dupes = sorted({s for s in slugs if slugs.count(s) > 1})
    if dupes:
        raise SystemExit(
            f"::error::stack path slug collision {dupes}: distinct stack paths map "
            "to the same artifact slug; rename so the path->'-' slug is unique."
        )
    return cells


def filter_pending(cells, completed_names):
    return [c for c in cells if f"apply / {c['stack']} / {c['environment']}" not in completed_names]


_gh_json = bm.gh_json


def verify_plan_run(repo, run_id, head_sha):
    """Provenance gate for a dispatched apply: comment-ops' `authorize` already
    binds head<->run on the comment path, but a direct `workflow_dispatch` (or a
    hand-edited one) skips that binding entirely. This check is therefore the
    trust boundary for dispatched applies -- without it, a mismatched
    run/head pair would apply another run's reviewed plans and green-tick the
    wrong PR's checks."""
    run = _gh_json(f"repos/{repo}/actions/runs/{run_id}")
    if run.get("head_sha") != head_sha:
        raise SystemExit(
            f"::error::plan run {run_id} head_sha mismatch: expected {head_sha}, "
            f"got {run.get('head_sha')}"
        )
    if run.get("conclusion") != "success":
        raise SystemExit(
            f"::error::plan run {run_id} conclusion is {run.get('conclusion')!r}, "
            "expected 'success'"
        )
    path = run.get("path") or ""
    if not path.endswith("/plan.yml"):
        raise SystemExit(
            f"::error::plan run {run_id} is not a plan.yml run: workflow path is {path!r}"
        )


def _artifact_names(repo, run_id):
    data = bm._run(
        [
            "gh",
            "api",
            "--paginate",
            "--jq",
            ".artifacts[].name",
            f"repos/{repo}/actions/runs/{run_id}/artifacts?per_page=100",
        ]
    )
    return [ln.strip() for ln in data.splitlines() if ln.strip()]


def completed_apply_names(repo, head_sha):
    """App-authored apply checks already completed on `head_sha`, shared by all
    three detects so they judge the identical "already applied" set.

    Only App-authored checks count: a forged same-name check from any other
    identity must not mark work done (see apply-gate.app_done_names)."""
    checks_jsonl = bm._run(
        [
            "gh",
            "api",
            # filter=all keeps this listing in step with gate-refresh's
            # (test_check_runs_filter_aligned); --paginate --jq streams JSONL so
            # no page — hence no completed apply — is dropped on a >100-check PR.
            "--paginate",
            "--jq",
            ".check_runs[]",
            f"repos/{repo}/commits/{head_sha}/check-runs?filter=all&per_page=100",
        ]
    )
    return ag.app_done_names(checks_jsonl.splitlines(), os.environ["SHIPMATE_APP_ID"])


def run_graph_deps():
    """The stack dependency graph, parsed. `--label stack.dir` is what makes
    waves.parse_dot's node normalization correct -- its docstring pins the argv
    as contract."""
    return wv.parse_dot(bm._run(["terramate", "experimental", "run-graph", "--label", "stack.dir"]))


def dag_shape_notice(deps):
    """One line describing the apply DAG's shape: how many stacks, how many
    declared `after` edges, how many topological levels, and how wide the widest
    level is.

    Always a notice, never a warning. Wave ordering comes only from the `after`
    DAG, and "no declared dependency" is a legitimate state, so nothing can
    detect a MISSING edge — a repository migrating from another tool leaves its
    ordering behind in that tool's config with nothing to say so. What this line
    buys is a reader who knows the repository seeing the concurrency figure and
    knowing at once whether it is true."""
    lv = wv.levels(deps)
    return (
        f"::notice::{len(deps)} stacks, {sum(len(d) for d in deps.values())} after edges, "
        f"{len(lv)} wave levels; {max((len(x) for x in lv), default=0)} stacks would apply "
        "concurrently"
    )


def validate_head_sha(value):
    """Guard against a malformed SHIPMATE_HEAD_SHA retargeting the gh api URLs
    built from it (e.g. `/`, `?`, `..`). Safe to echo — not a secret."""
    if not _SHA_RE.fullmatch(value):
        raise SystemExit(
            f"::error::SHIPMATE_HEAD_SHA must be a 40-char lowercase hex SHA (got: {value!r})"
        )


def validate_plan_run_id(value):
    """Guard against a malformed SHIPMATE_PLAN_RUN_ID retargeting the gh api URLs
    built from it. Safe to echo — not a secret."""
    if not _RUN_ID_RE.fullmatch(value):
        raise SystemExit(f"::error::SHIPMATE_PLAN_RUN_ID must be a numeric run id (got: {value!r})")


def validate_env(value):
    """The `plan.<env>.<slug>` artifact name is unambiguous only because an env
    name never contains '.' — with env first, the first '.' after the `plan.`
    prefix is the env<->slug boundary. Terramate tag grammar forbids '.' in tags
    (the source of env names), but that is an upstream tool's invariant; enforce
    it here at the trust boundary rather than trusting it silently. A dotted env
    would let distinct (env, slug) pairs render the same artifact name and
    cross-enrol the wrong stack into a wave — the exact bug the rename removed."""
    if "." in value:
        raise SystemExit(
            f"::error::SHIPMATE_ENV must not contain '.' (would break plan.<env>.<slug> "
            f"artifact-name disambiguation): {value!r}"
        )


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    env = os.environ["SHIPMATE_ENV"]
    plan_run_id = os.environ["SHIPMATE_PLAN_RUN_ID"]
    head = os.environ["SHIPMATE_HEAD_SHA"]

    validate_head_sha(head)
    validate_plan_run_id(plan_run_id)
    validate_env(env)

    verify_plan_run(repo, plan_run_id, head)

    deps = run_graph_deps()
    graph_paths = list(deps.keys())

    names = _artifact_names(repo, plan_run_id)
    # Tags only for the workset: this path reconstructs its cells from the plan
    # artifacts plus the run-graph, and evaluating the whole tree would let one
    # unrelated stack's unresolvable expression block an approved plan.
    paths = workset_paths(names, env, graph_paths)
    cells = workset_from_artifacts(names, env, paths, {p: bm._tags(p) for p in paths})

    completed = completed_apply_names(repo, head)
    pending = filter_pending(cells, completed)

    waves = wv.assign_waves(wv.levels(deps), pending)
    wv.guard_max_waves(waves)
    print(dag_shape_notice(deps))
    print(
        f"::notice title=apply-detect::env={env} plan_run={plan_run_id} head={head} "
        f"cells={len(cells)} completed={len(completed)} pending={len(pending)} "
        f"waves={[len(w) for w in waves]} empty={not any(waves)}"
    )
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        wv.write_waves(fh, waves)
        fh.write(f"head_sha={head}\n")
        fh.write(f"plan_run_id={plan_run_id}\n")


if __name__ == "__main__":
    try:
        main()
    except CycleError as e:
        raise SystemExit(f"::error::dependency cycle in run-graph: {e}") from e
