#!/usr/bin/env python3
"""Decide the `shipmate / gate` state, and whether the sticky comment may be written.

Runs in the trusted post-plan job (`workflow_run`), which has no `needs`, so the
plan run's own conclusion replaces the per-job results this logic used to read.

Three counts describe one plan run, and the gate greens only when all three
agree. `matrix_count` is how many cells `detect` planned, published by
`actions/build-matrix` as the artifact name `plan-matrix.<N>` because a
`workflow_run` event carries no job outputs; `artifact_count` is how many
`cell-summary.*` artifacts the API reports for that run; `cell_count` is how
many of them this job actually parsed. Each is `unknown` when the workflow could
not determine it. A missing marker, a listing that does not match it, or a
shortfall between listed and parsed means the evidence for this run is
incomplete -- a lagging artifact listing, a failed download, or an engine pin
skew -- and incomplete evidence must never green the gate. A zero cell count
means "nothing changed" only when the marker says the matrix was empty; without
it, zero is indistinguishable from a listing that simply did not show the cells,
and greening it merges reviewed stacks that have no apply check and so are never
applied.
"""

import json
import os
import sys

_HOLD = "hold"
_POST = "post"
_NOTHING = "nothing-changed"


def _as_int(value):
    """A reported count as an int, or None when the caller could not count it.

    The workflow reports `unknown` when the plan run's artifact listing failed,
    when the run published no plan-matrix marker (or two that disagreed), and
    the `with:` fallback reports it for a step that emitted no output at all.
    Anything that is not a base-10 integer is that same state.
    """
    try:
        return int(str(value), 10)
    except ValueError:
        return None


def _evidence_gap(*, counted, cell_count, planned):
    """A hold description when this plan run's evidence is incomplete, else None.

    `counted` and `planned` are None when the workflow could not report a
    number. Ordered so that every check a plausible count could satisfy comes
    after the two that no count can.
    """
    if counted is None:
        return (
            "the plan run's artifact list could not be read, so its evidence is "
            "unknown — re-plan this run before merging"
        )
    if planned is None:
        return (
            "the plan run published no plan-matrix marker — re-pin "
            "actions/build-matrix, then re-plan before merging"
        )
    if counted != planned:
        return (
            f"the plan run planned {planned} cell(s) but its artifact list shows "
            f"{counted} — re-plan before merging"
        )
    if cell_count < counted:
        # Reaching here means the listing agreed with the marker, so this is a
        # download or parse shortfall -- usually partial, not total. Say how many
        # of how many, or a maintainer hunts a failure that did not happen.
        return (
            f"only {cell_count} of {counted} cell summaries could be read from the plan "
            "run's artifacts — re-run before merging"
        )
    return None


def decide(*, run_conclusion, artifact_count, cell_count, matrix_count, pending):
    """Return (state, description, comment_mode).

    state is None when nothing should be written at all.
    """
    if run_conclusion in ("skipped", "cancelled"):
        return None, "", _HOLD
    if run_conclusion != "success":
        return (
            "failure",
            f"plan incomplete (plan run: {run_conclusion}) — fix the failing "
            "<stack> / <env> plan check before merging",
            _HOLD,
        )
    planned = _as_int(matrix_count)
    gap = _evidence_gap(counted=_as_int(artifact_count), cell_count=cell_count, planned=planned)
    if gap:
        return "failure", gap, _HOLD
    if pending:
        return (
            "pending",
            "one or more stacks are waiting to be applied — merge is blocked "
            "until applies complete",
            _POST,
        )
    if planned == 0:
        return "success", "no pending applies for this PR", _NOTHING
    return "success", "no pending applies for this PR", _POST


def main():
    state, desc, mode = decide(
        run_conclusion=os.environ["SHIPMATE_RUN_CONCLUSION"],
        artifact_count=os.environ.get("SHIPMATE_ARTIFACT_COUNT", ""),
        cell_count=int(os.environ.get("SHIPMATE_CELL_COUNT", "0")),
        matrix_count=os.environ.get("SHIPMATE_MATRIX_COUNT", ""),
        pending=os.environ.get("SHIPMATE_PENDING", "false") == "true",
    )
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"state={state or ''}\n")
        fh.write(f"comment_mode={mode}\n")
    if state is None:
        return
    body = {"state": state, "context": "shipmate / gate", "description": desc[:140]}
    # The plan run's URL when the caller supplied it. GITHUB_RUN_ID is this
    # trusted summary run -- a five-step job with no plan output and no
    # artifacts -- so clicking the gate would land nowhere useful; it stays as
    # the fallback for a caller that passes nothing.
    plan_run_url = os.environ.get("SHIPMATE_PLAN_RUN_URL", "")
    server, repo, run_id = (
        os.environ.get(k, "") for k in ("GITHUB_SERVER_URL", "GITHUB_REPOSITORY", "GITHUB_RUN_ID")
    )
    if plan_run_url:
        body["target_url"] = plan_run_url
    elif server and repo and run_id:
        body["target_url"] = f"{server}/{repo}/actions/runs/{run_id}"
    json.dump(body, sys.stdout)


if __name__ == "__main__":
    main()
