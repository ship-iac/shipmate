#!/usr/bin/env python3
"""Decide the `shipmate / gate` state, and how the sticky comment is written.

Runs in the trusted `summary` job of the plan workflow, which `needs:` the
`detect` and `plan` jobs and is handed their results directly.

Two numbers describe one plan run and the gate greens only when they agree:
`planned_cells` is how many cells `detect` planned, and `cell_count` is how many
cell summaries this job actually parsed. A shortfall means a download or a parse
did not produce the evidence the gate would be greening over, and incomplete
evidence must never green the gate: `deploy-detect`'s work queue IS the pending
apply checks, so a green gate over missing cells merges reviewed stacks that are
then never applied.

One case runs before both numbers: an autoplan of a draft pull request skips
`detect`, so there is no count to compare. `decide` writes that run `pending`
with a description naming the recovery, and comment mode `draft`, which leaves
the sticky comment as it is. An on-demand plan never takes that branch: a
skipped `detect` there is a failure like any other non-success.
"""

import os

from _shipmate import _load, cell_names, run_annotated, write_outputs

ag = _load("apply-gate")

_HOLD = "hold"
_HELD = "held"
_POST = "post"
_NOTHING = "nothing-changed"
_DRAFT = "draft"

DRAFT_DESCRIPTION = (
    "the pull request was a draft when this run started, so nothing was planned; "
    "comment `shipmate plan`, or mark it ready"
)


def _as_int(value):
    """A reported count as an int, or None when the caller could not count it.

    An input the action never wired, or a step that emitted no output at all,
    arrives as the empty string. Anything that is not a base-10 integer is that
    same "nobody reported a count" state.
    """
    try:
        return int(str(value), 10)
    except ValueError:
        return None


def _missing_description(missing):
    """The description naming the first of `missing` (`{stack, environment}` pairs in the comment's
    order) by its plan check as having no plan summary, or None when there is none or the text
    passes the 140 characters the statuses API accepts: a cut would name a check that does not
    exist. A cell is missing when its plan matrix job did not succeed or the summary download
    failed, and the run cannot tell which, so the text names neither."""
    if not missing:
        return None
    check = f"{ag.CALLER_PREFIX}{missing[0]['stack']} / {missing[0]['environment']}"
    if len(missing) == 1:
        text = f"{check} has no plan summary; fix its plan or re-plan"
    else:
        text = (
            f"{check} and {len(missing) - 1} more have no plan summary; fix their plans or re-plan"
        )
    return text if len(text) <= 140 else None


def _plan_gap(*, plan_result, planned, missing):
    """A hold description when the plan job produced no usable plan, else None.

    `skipped` with cells planned is the one that is not obviously a failure: the
    job the matrix was built for did not run at all, so there is nothing to
    review and nothing to apply. A failed plan job names its first cell with no plan summary when
    one is known (`_missing_description`); `missing` changes no other text.
    """
    if plan_result == "skipped" and planned != 0:
        return f"the plan job did not run for {planned} planned cell(s); re-plan before merging"
    if plan_result not in ("success", "skipped"):
        named = _missing_description(missing) if plan_result == "failure" else None
        return named or (
            f"plan incomplete (plan job: {plan_result}); fix the failing plan checks before merging"
        )
    return None


def _evidence_gap(*, cell_count, planned):
    """A hold description when this run's evidence is incomplete, else None.

    One comparison, both directions. A same-run download that failed leaves
    `cell_count` at 0 against a non-zero `planned`, which holds — and a parse
    that produced more cells than were planned describes a run nobody can
    account for, which holds for the same reason.

    The recovery is a fresh plan run: comment `shipmate plan` or push. Re-running this
    run's plan jobs 409s, since `plan-cell`'s uploads are not `overwrite:`. The
    description is truncated to 140 characters by `main()`, so it leads with the
    recovery.
    """
    if cell_count != planned:
        return (
            "re-plan this pull request (comment shipmate plan or push): "
            f"{planned} cell(s) planned but {cell_count} cell summary/summaries read"
        )
    return None


def evidence_gap(*, plan_result, planned_cells, cell_count, missing=()):
    """A hold description when this plan run's evidence is not trustworthy, else None.

    The one predicate the gate and the apply-check publisher share: `decide` holds the gate on
    it, and `pending-checks` publishes no apply check on it. `planned_cells` is the count as
    reported (a string, possibly empty); `cell_count` is the number of cell summaries parsed.
    The plan-job checks run before the evidence check, so a plan job that broke or never ran is
    reported as a plan problem rather than shadowed by the evidence shortfall it also produces.
    `missing`, the planned cells with no cell summary, changes only a failed plan job's text,
    never whether there is a gap.
    """
    planned = _as_int(planned_cells)
    if planned is None:
        return (
            "the planned cell count was not reported, so this run's evidence is "
            "unknown; re-plan before merging"
        )
    return _plan_gap(plan_result=plan_result, planned=planned, missing=missing) or _evidence_gap(
        cell_count=cell_count, planned=planned
    )


def _detect_gap(detect_result, refusal):
    """The hold description for a `detect` that did not succeed.

    A `detect` that failed with a `::error::` line (a refusal or a failed tool or API call) is
    named by that line, whole: `main` cuts the description, and the held comment shows all of it.
    An empty one (a fmt or codegen failure, a crash with no `::error::` line) keeps the generic
    text."""
    if refusal:
        return f"detect failed: {refusal}"
    return (
        f"change detection did not succeed ({detect_result}); fix the "
        "shipmate / detect job before merging"
    )


def decide(
    *,
    detect_result,
    plan_result,
    planned_cells,
    cell_count,
    pending,
    is_draft=False,
    on_demand=False,
    refusal="",
    missing=(),
):
    """Return (state, description, comment_mode).

    state is None when nothing should be written at all: a cancelled plan job, whose comment mode
    `hold` keeps the sticky comment as it is. Every `failure` state has comment mode `held`, which
    replaces the comment with why the gate is held.

    `plan_result` is a JOB result, not a run conclusion, and the two disagree on
    exactly one value: `skipped`. A run whose plan matrix was empty arrives as a
    skipped job. Treating that as "write nothing" would leave every docs-only
    pull request with no gate at all, so `skipped` is accepted and then measured
    against the same evidence checks as a successful plan.

    A draft autoplan (`is_draft` and not `on_demand`) with `detect` skipped is
    `pending`, never `success`: nothing was planned, so there is nothing to green.
    It returns before `planned_cells` is read, because a skipped `detect` reports
    no count.

    `refusal` is the first line of the `::error::` refusal message `build-matrix` failed with
    (`_detect_gap`). `missing` goes to `evidence_gap`.
    """
    if detect_result == "skipped" and is_draft and not on_demand:
        return "pending", DRAFT_DESCRIPTION, _DRAFT
    if detect_result != "success":
        return "failure", _detect_gap(detect_result, refusal), _HELD
    if plan_result == "cancelled":
        return None, "", _HOLD
    gap = evidence_gap(
        plan_result=plan_result, planned_cells=planned_cells, cell_count=cell_count, missing=missing
    )
    if gap:
        return "failure", gap, _HELD
    if pending:
        return (
            "pending",
            "one or more stacks are waiting to be applied; merge is blocked until applies complete",
            _POST,
        )
    # Safe only below the gap check: a None gap means `cell_count` equals the planned count,
    # so moving this branch above it would green a run nobody reported a count for.
    if cell_count == 0:
        return "success", "no pending applies for this PR", _NOTHING
    return "success", "no pending applies for this PR", _POST


def main():
    state, desc, mode = decide(
        detect_result=os.environ["SHIPMATE_DETECT_RESULT"],
        plan_result=os.environ["SHIPMATE_PLAN_RESULT"],
        planned_cells=os.environ.get("SHIPMATE_PLANNED_CELLS", ""),
        # Bare `int()`, unlike the planned count: this one is `len(cells)` from summary-comment,
        # so a non-integer means that step did not run and the ValueError kills the action
        # before any gate is written -- blocking the merge. Fail-closed, not a hold's guarantee.
        cell_count=int(os.environ.get("SHIPMATE_CELL_COUNT", "0")),
        pending=os.environ.get("SHIPMATE_PENDING", "false") == "true",
        is_draft=os.environ.get("SHIPMATE_IS_DRAFT", "false") == "true",
        on_demand=os.environ.get("SHIPMATE_ON_DEMAND", "false") == "true",
        refusal=os.environ.get("SHIPMATE_DETECT_REFUSAL", ""),
        missing=cell_names(os.environ.get("SHIPMATE_MISSING", "")),
    )
    # A stack path holding CR or LF would end the `GITHUB_OUTPUT` line. `reason` is the whole
    # text, for the held comment.
    flat = desc.replace("\r", " ").replace("\n", " ")
    write_outputs(state=state or "", description=flat[:140], reason=flat, comment_mode=mode)


if __name__ == "__main__":
    run_annotated(main)
