#!/usr/bin/env python3
"""Decide the `shipmate / gate` state, and whether the sticky comment may be written.

Runs in the trusted `summary` job of the plan workflow, which `needs:` the
`detect` and `plan` jobs and is handed their results directly.

Two numbers describe one plan run and the gate greens only when they agree:
`planned_cells` is how many cells `detect` planned, and `cell_count` is how many
cell summaries this job actually parsed. A shortfall means a download or a parse
did not produce the evidence the gate would be greening over, and incomplete
evidence must never green the gate: `deploy-detect`'s work queue IS the pending
apply checks, so a green gate over missing cells merges reviewed stacks that are
then never applied.
"""

import json
import os
import sys

_HOLD = "hold"
_POST = "post"
_NOTHING = "nothing-changed"


def _as_int(value):
    """A reported count as an int, or None when the caller could not count it.

    An input the action never wired, or a step that emitted no output at all,
    arrives as the empty string. Anything that is not a base-10 integer is that
    same "nobody reported a count" state.
    """
    try:
        return int(str(value), 10)
    except ValueError:
        return None


def _plan_gap(*, plan_result, planned):
    """A hold description when the plan job produced no usable plan, else None.

    `skipped` with cells planned is the one that is not obviously a failure: the
    job the matrix was built for did not run at all, so there is nothing to
    review and nothing to apply.
    """
    if plan_result == "skipped" and planned != 0:
        return f"the plan job did not run for {planned} planned cell(s) — re-plan before merging"
    if plan_result not in ("success", "skipped"):
        return (
            f"plan incomplete (plan job: {plan_result}) — fix the failing "
            "<stack> / <env> plan check before merging"
        )
    return None


def _evidence_gap(*, cell_count, planned):
    """A hold description when this run's evidence is incomplete, else None.

    One comparison, both directions. A same-run download that failed leaves
    `cell_count` at 0 against a non-zero `planned`, which holds — and a parse
    that produced more cells than were planned describes a run nobody can
    account for, which holds for the same reason.
    """
    if cell_count != planned:
        return (
            f"the plan job planned {planned} cell(s) but {cell_count} cell "
            "summary/summaries could be read — re-plan before merging"
        )
    return None


def decide(*, detect_result, plan_result, planned_cells, cell_count, pending):
    """Return (state, description, comment_mode).

    state is None when nothing should be written at all.

    `plan_result` is a JOB result, not the old run conclusion, and the two
    disagree on exactly one value: `skipped`. A run whose plan matrix was empty
    used to arrive here as a SUCCESSFUL run; it now arrives as a skipped job.
    Treating that as "write nothing" would leave every docs-only pull request
    with no gate at all — so `skipped` is accepted, and then measured against
    the same evidence checks as a successful plan rather than short-circuiting
    past them.
    """
    if detect_result != "success":
        return (
            "failure",
            f"change detection did not succeed ({detect_result}) — fix the "
            "shipmate / detect job before merging",
            _HOLD,
        )
    if plan_result == "cancelled":
        return None, "", _HOLD
    planned = _as_int(planned_cells)
    if planned is None:
        return (
            "failure",
            "the planned cell count was not reported, so this run's evidence is "
            "unknown — re-plan before merging",
            _HOLD,
        )
    # `or`, so the plan-job checks still run before the evidence check: cells
    # nobody planned must not be described as a shortfall.
    gap = _plan_gap(plan_result=plan_result, planned=planned) or _evidence_gap(
        cell_count=cell_count, planned=planned
    )
    if gap:
        return "failure", gap, _HOLD
    if pending:
        return (
            "pending",
            "one or more stacks are waiting to be applied — merge is blocked "
            "until applies complete",
            _POST,
        )
    if planned == 0:
        return "success", "no pending applies for this PR", _NOTHING
    return "success", "no pending applies for this PR", _POST


def main():
    state, desc, mode = decide(
        detect_result=os.environ["SHIPMATE_DETECT_RESULT"],
        plan_result=os.environ["SHIPMATE_PLAN_RESULT"],
        planned_cells=os.environ.get("SHIPMATE_PLANNED_CELLS", ""),
        cell_count=int(os.environ.get("SHIPMATE_CELL_COUNT", "0")),
        pending=os.environ.get("SHIPMATE_PENDING", "false") == "true",
    )
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"state={state or ''}\n")
        fh.write(f"comment_mode={mode}\n")
    if state is None:
        return
    body = {"state": state, "context": "shipmate / gate", "description": desc[:140]}
    # This job runs inside the plan run, so this run's URL is the right target.
    server, repo, run_id = (
        os.environ.get(k, "") for k in ("GITHUB_SERVER_URL", "GITHUB_REPOSITORY", "GITHUB_RUN_ID")
    )
    if server and repo and run_id:
        body["target_url"] = f"{server}/{repo}/actions/runs/{run_id}"
    json.dump(body, sys.stdout)


if __name__ == "__main__":
    main()
