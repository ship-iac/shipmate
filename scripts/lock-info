#!/usr/bin/env python3
"""Parse OpenTofu's state-lock acquisition failure into its lock's identity.

The only parser of lock output in the engine: `apply-comment` imports `parse`
to render the failure legibly, and `actions/unlock-cell` runs this as a CLI to
discover the id `tofu force-unlock` needs. Two parsers for one format would
disagree eventually.

Measured against OpenTofu v1.12.4 on both the local backend and S3 with
`use_lockfile = true`: the `Error acquiring the state lock` line and the whole
`Lock Info:` block are identical across backends, and only the `Error message:`
line differs — so nothing here reads that line. The block arrives inside
OpenTofu's `|`-prefixed diagnostic box even with no TTY, values are space-padded
after the colon, and on a GitHub Actions runner every one of those lines is
ANSI-coloured (see `_ANSI_RE`).

Fail-closed by construction: anything short of a complete block with an
in-charset `ID` returns None, which every caller reads as "do not unlock".

`Who` is deliberately not returned. It is `user@host` (`runner@fv-az…` on a
hosted runner), so it cannot attribute a run, and a caller that could see it
would eventually render it as if it could.
"""

import json
import os
import re
import sys

_ERROR_LINE = "Error acquiring the state lock"
_BLOCK_START = "Lock Info:"

# OpenTofu colours its diagnostics whenever the sink looks capable, and a GitHub
# Actions runner does, so a live cell emits `ESC[31m│ESC[0m ESC[0mLock Info:`
# rather than `│ Lock Info:`. Colour comes off before anything else here: every
# pattern below anchors at the start of the line, which is exactly where an
# escape sequence sits.
#
# The apply-comment path never exposed this. It strips ANSI in `load_cells`
# before this parser is reached, and the captures used as fixtures had been put
# through a colour-stripping filter as they were taken -- so the first output
# this parser ever met with colour still in it was a real unlock run against S3.
_ANSI_RE = re.compile(
    r"\x1b\[[0-?]*[ -/]*[@-~]"  # CSI
    r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"  # OSC
    r"|\x1b[@-_]"  # two-character escape
)

# The box prefix OpenTofu renders diagnostics with, plus one optional space.
_PREFIX_RE = re.compile(r"^[│|]\s?")
_FIELD_RE = re.compile(r"^(?P<key>[A-Za-z]+):\s*(?P<value>.*?)\s*$")

# A lock id is a uuid in every backend the engine has seen, but the guard that
# matters is the charset: this value reaches a `tofu force-unlock` argv, and
# apply.txt is provider output a stack can influence.
_ID_RE = re.compile(r"^[0-9a-fA-F][0-9a-fA-F-]{7,63}$")

_WANTED = {"ID": "id", "Path": "path", "Operation": "operation", "Created": "created"}


# `created` and `operation` are display-only, and unlike `id` they have no
# format the engine can rely on -- apply.txt is provider/`local-exec` output,
# capped only in total (60,000 chars), so one `Created:` line can carry tens of
# thousands of characters or markdown emphasis into the bot comment that renders
# it. Both are whitelisted at the source so every consumer inherits the bound.
_CREATED_RE = re.compile(r"^[0-9A-Za-z:.+\- ]{1,64}$")
_OPERATION_RE = re.compile(r"^[A-Za-z]{1,32}$")


def _strip(line):
    return _PREFIX_RE.sub("", _ANSI_RE.sub("", line)).strip()


def _fields(lines):
    """The wanted fields of the block starting at `lines`, keeping only values
    that pass their own guard.

    Stops at the first line that is not `key: value` -- the block ends there,
    and reading past it would pick up the prose OpenTofu prints after it.

    `created` and `operation` are blanked rather than dropped, so `parse`'s
    completeness check still sees a complete block; `id` is never touched here,
    because an unusable one makes the whole lock unusable and `parse` refuses it.
    """
    found = {}
    for ln in lines:
        m = _FIELD_RE.match(ln)
        if not m:
            break
        key = _WANTED.get(m.group("key"))
        if key is not None:
            found[key] = m.group("value")
    for key, ok in (("created", _CREATED_RE), ("operation", _OPERATION_RE)):
        if key in found and not ok.match(found[key]):
            found[key] = ""
    return found


def parse(text):
    """The lock identity in `text`, or None if it holds no complete lock block.

    Returns {"id", "path", "operation", "created"}. Every key is required: a
    partial block means the output was truncated (the tail cap in
    apply-comment, a killed process), and guessing an id from half a block is
    the one thing this must never do.

    `created` and `operation` are display-only and whitelisted (`_fields`): a
    value that fails its guard becomes the empty string and the lock is still
    returned. The asymmetry with `id` is deliberate -- it reaches a
    `force-unlock` argv, so an unusable one means there is nothing safe to act
    on, while refusing the whole lock over a cosmetic field would suppress a
    real lock note and block a legitimate unlock. Callers must render neither
    field unconditionally.
    """
    lines = [_strip(ln) for ln in text.splitlines()]
    if not any(_ERROR_LINE in ln for ln in lines):
        return None
    try:
        start = next(i for i, ln in enumerate(lines) if ln == _BLOCK_START)
    except StopIteration:
        return None
    found = _fields(lines[start + 1 :])
    if set(found) != set(_WANTED.values()):
        return None
    if not _ID_RE.match(found["id"]):
        return None
    return found


def main():
    lock = parse(sys.stdin.read())
    out = os.environ.get("GITHUB_OUTPUT")
    if out:
        with open(out, "a", encoding="utf-8") as fh:
            fh.write(f"held={'true' if lock else 'false'}\n")
            if lock:
                fh.write(f"lock_id={lock['id']}\n")
                fh.write(f"lock_created={lock['created']}\n")
                fh.write(f"lock_operation={lock['operation']}\n")
    if lock:
        print(
            f"::notice title=lock-info::state lock held — id={lock['id']} "
            f"created={lock['created']} operation={lock['operation']}"
        )
    else:
        print("::notice title=lock-info::no state lock reported in this output")
    print(json.dumps(lock or {}))


if __name__ == "__main__":
    main()
