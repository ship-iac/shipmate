#!/usr/bin/env python3
"""Parse OpenTofu's state-lock acquisition failure into its lock's identity.

The only parser of lock output in the engine: `apply-comment` imports `parse`
to render the failure legibly, and `actions/unlock-cell` runs this as a CLI to
discover the id `tofu force-unlock` needs. Two parsers for one format would
disagree eventually.

Measured against OpenTofu v1.12.4 on both the local backend and S3 with
`use_lockfile = true`: the `Error acquiring the state lock` line and the whole
`Lock Info:` block are identical across backends, and only the `Error message:`
line differs — so nothing here reads that line. The block arrives inside
OpenTofu's `|`-prefixed diagnostic box even with no TTY, and values are
space-padded after the colon.

Fail-closed by construction: anything short of a complete, in-charset block
returns None, which every caller reads as "do not unlock".

`Who` is deliberately not returned. It is `user@host` (`runner@fv-az…` on a
hosted runner), so it cannot attribute a run, and a caller that could see it
would eventually render it as if it could.
"""

import json
import os
import re
import sys

_ERROR_LINE = "Error acquiring the state lock"
_BLOCK_START = "Lock Info:"

# The box prefix OpenTofu renders diagnostics with, plus one optional space.
_PREFIX_RE = re.compile(r"^[│|]\s?")
_FIELD_RE = re.compile(r"^(?P<key>[A-Za-z]+):\s*(?P<value>.*?)\s*$")

# A lock id is a uuid in every backend the engine has seen, but the guard that
# matters is the charset: this value reaches a `tofu force-unlock` argv, and
# apply.txt is provider output a stack can influence.
_ID_RE = re.compile(r"^[0-9a-fA-F][0-9a-fA-F-]{7,63}$")

_WANTED = {"ID": "id", "Path": "path", "Operation": "operation", "Created": "created"}


def _strip(line):
    return _PREFIX_RE.sub("", line).strip()


def parse(text):
    """The lock identity in `text`, or None if it holds no complete lock block.

    Returns {"id", "path", "operation", "created"}. Every key is required: a
    partial block means the output was truncated (the tail cap in
    apply-comment, a killed process), and guessing an id from half a block is
    the one thing this must never do.
    """
    lines = [_strip(ln) for ln in text.splitlines()]
    if not any(_ERROR_LINE in ln for ln in lines):
        return None
    try:
        start = next(i for i, ln in enumerate(lines) if ln == _BLOCK_START)
    except StopIteration:
        return None
    found = {}
    for ln in lines[start + 1 :]:
        m = _FIELD_RE.match(ln)
        if not m:
            break
        key = _WANTED.get(m.group("key"))
        if key is not None:
            found[key] = m.group("value")
    if set(found) != set(_WANTED.values()):
        return None
    if not _ID_RE.match(found["id"]):
        return None
    return found


def main():
    lock = parse(sys.stdin.read())
    out = os.environ.get("GITHUB_OUTPUT")
    if out:
        with open(out, "a", encoding="utf-8") as fh:
            fh.write(f"held={'true' if lock else 'false'}\n")
            if lock:
                fh.write(f"lock_id={lock['id']}\n")
                fh.write(f"lock_created={lock['created']}\n")
                fh.write(f"lock_operation={lock['operation']}\n")
    if lock:
        print(
            f"::notice title=lock-info::state lock held — id={lock['id']} "
            f"created={lock['created']} operation={lock['operation']}"
        )
    else:
        print("::notice title=lock-info::no state lock reported in this output")
    print(json.dumps(lock or {}))


if __name__ == "__main__":
    main()
