#!/usr/bin/env python3
"""Register the shipmate GitHub App and store its credentials, in one command.

    python3 scripts/register-app --name shipmate-<org> --repo <org>/shipmate \
        --out shipmate-app.private-key.pem

One-time dev/ops setup; docs/github-app.md §1-§2 is the runbook. Registration
via a manifest is a browser POST, so this builds the self-submitting form from
app/manifest.json, opens it, and receives GitHub's redirect on a loopback
listener it started first -- the single-use code never leaves the machine.
It then converts the code, stores the app id as a repository variable, and
creates the private key at --out, which must not already exist. The file is
mode 0600 where the platform has modes; on Windows it inherits the directory's
ACLs, so choose a directory only you can read.

The key goes to a file, never to a repository secret: a repository secret is
readable by any workflow on any branch, which is the placement §5's
`shipmate-engine` environment exists to replace. --out serves both placements.

Use --code to skip the browser leg with a code you already hold (single-use and
short-lived, so this is for a retry after a later step failed).
"""

import argparse
import http.server
import json
import os
import pathlib
import re
import secrets
import subprocess
import sys
import tempfile
import threading
import urllib.parse
import webbrowser

REDACTED = "***"

#: `code` is interpolated into the `app-manifests/<code>/conversions` API path and arrives over
#: a loopback socket; a '/' or '..' in it retargets that request at another endpoint.
_CODE_RE = re.compile(r"[A-Za-z0-9_-]+")
#: `--repo`'s owner half is interpolated into the registration URL, and both halves into
#: `gh variable set --repo`. Each half starts alphanumeric, as GitHub logins and repository names
#: do: that forecloses '.' and '..', and a value beginning with '-' reads to a CLI as a flag.
_REPO_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*")
#: `--name` is embedded in the local HTML form, where a quote would escape the attribute holding
#: it. 34 is GitHub's App-name limit.
_NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9 ._-]{0,33}")

MANIFEST = pathlib.Path(__file__).resolve().parents[1] / "app" / "manifest.json"

DONE_PAGE = b"""<!doctype html><meta charset=utf-8>
<title>shipmate registered</title>
<body style="font:16px system-ui;max-width:34em;margin:4em auto">
<h1>App registered</h1>
<p>The code was captured locally. Return to the terminal &mdash; it is storing the
credentials now.</p>
"""


def _scrub(text, secrets):
    for secret in secrets:
        if secret:
            text = text.replace(secret, REDACTED)
    return text


def _run(args, secrets=(), **kw):
    """Run a `gh` invocation, returning stdout; raise on a nonzero exit.

    `secrets` are the live credential values this call carries, scrubbed from
    everything the failure path prints. Both are unrotatable at the moment they
    would leak: the manifest `code` is one-time and sits in the conversions URL,
    and the private key fails exactly when it has been minted but not yet
    stored. Neither shipmate's own message (which names the subcommand only) nor
    gh's stderr (which quotes the URL it called) may carry them into shell
    scrollback or a CI log.
    """
    # args is a `gh` invocation built here, shell=False, and the two values
    # interpolated into it -- `--repo` and the manifest `code`, which lands in an
    # API *path* -- passed _REPO_RE / _CODE_RE at their entry point in main().
    p = subprocess.run(args, capture_output=True, text=True, **kw)  # noqa: S603
    if p.returncode != 0:
        # gh's stderr is the only diagnosis a hand-run bootstrap gets.
        sys.stderr.write(_scrub(p.stderr, secrets))
        raise SystemExit(f"command failed ({p.returncode}): {' '.join(args[:2])}")
    return p.stdout


class _Handler(http.server.BaseHTTPRequestHandler):
    code = None
    state = None

    def do_GET(self):  # noqa: N802 -- BaseHTTPRequestHandler's dispatch name
        """Capture the redirect's `code`; 404 everything else.

        The browser also asks this port for /favicon.ico, and answering that as a
        capture would end the wait holding no code. The port is reachable by anything
        on this machine, so a callback that does not carry this run's state is some
        other App's code, which main() would convert and store as if it were ours.
        """
        params = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        got = params.get("code", [None])[0]
        if not got or params.get("state", [None])[0] != _Handler.state:
            self.send_error(404)
            return
        _Handler.code = got
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(DONE_PAGE)))
        self.end_headers()
        self.wfile.write(DONE_PAGE)

    def log_message(self, *args):
        pass  # The request line carries the single-use code.


def _capture_code(name, org):
    """Post the manifest from the browser and return the code GitHub redirects
    with, caught on a loopback listener bound to a free port."""
    manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    manifest["name"] = name

    _Handler.state = secrets.token_urlsafe(16)
    server = http.server.HTTPServer(("127.0.0.1", 0), _Handler)
    manifest["redirect_url"] = f"http://127.0.0.1:{server.server_port}/callback"
    action = f"https://github.com/organizations/{org}/settings/apps/new?state={_Handler.state}"
    form = f"""<!doctype html><meta charset=utf-8>
<title>Register {name}</title>
<form id="f" action="{action}" method="post">
<input type="hidden" name="manifest" value='{json.dumps(manifest)}'>
</form>
<p style="font:16px system-ui">Submitting to GitHub&hellip;
<button type="submit" form="f">Continue</button></p>
<script>document.getElementById("f").submit()</script>
"""
    fd, html = tempfile.mkstemp(prefix="shipmate-app-manifest-", suffix=".html")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(form)

    print(f"Listening on {manifest['redirect_url']}; opening {html}")
    opener = threading.Thread(target=webbrowser.open, args=(pathlib.Path(html).as_uri(),))
    opener.daemon = True
    opener.start()
    print("Confirm the registration in the browser (Ctrl-C to abort).")
    try:
        while _Handler.code is None:
            server.handle_request()
    finally:
        server.server_close()
        pathlib.Path(html).unlink(missing_ok=True)
    return _Handler.code


def _validate_out(path):
    """Refuse an unusable --out BEFORE the conversion call.

    After it, the key exists only in this process and the single-use manifest
    code can never mint another, so every reason the write could fail has to be
    found while failing is still free."""
    parent = pathlib.Path(path).parent
    if pathlib.Path(path).exists():
        raise SystemExit(f"{path} already exists; refusing to overwrite it. Choose another --out.")
    if not parent.is_dir():
        raise SystemExit(f"{path}: the directory {parent} does not exist. Create it first.")
    if not os.access(parent, os.W_OK):
        raise SystemExit(f"{path}: the directory {parent} is not writable.")


def _write_key(path, pem):
    """Create the PEM at `path`, owner-only where the platform has modes.

    `O_EXCL` is the load-bearing flag, twice over. POSIX applies the mode
    argument only when the call creates the file, so writing into a path that
    already exists -- the browser-downloaded key an earlier bootstrap left at
    this very filename -- would inherit its 0644. And the key this overwrote
    could never be converted again: the manifest code is single-use.
    """
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        raise SystemExit(
            f"{path} already exists; refusing to overwrite it. The App is registered and its "
            "key is now unrecoverable -- generate a replacement in the App's settings."
        ) from None
    except OSError as e:
        raise SystemExit(
            f"{path} could not be created ({e}). The App was created and its key existed only "
            "in this process, so it is lost -- generate a replacement in the App's settings."
        ) from None
    with os.fdopen(fd, "w", encoding="utf-8", newline="") as fh:
        fh.write(pem)


def main(argv=None):
    ap = argparse.ArgumentParser(description="Register the shipmate GitHub App.")
    ap.add_argument("--name", required=True, help="App name; unique across all of GitHub")
    ap.add_argument("--repo", required=True, help="<org>/<repo> the app id is stored on")
    ap.add_argument("--out", required=True, help="path the private key is written to (mode 0600)")
    ap.add_argument("--code", help="skip the browser leg and convert this manifest code")
    args = ap.parse_args(argv)
    if not _REPO_RE.fullmatch(args.repo):
        raise SystemExit(f"--repo must be <owner>/<repo>: {args.repo!r}")
    if not _NAME_RE.fullmatch(args.name):
        raise SystemExit(
            "--name must be 1-34 characters of letters, digits, space, '.', '_' or '-', "
            f"starting alphanumeric: {args.name!r}"
        )
    org = args.repo.split("/")[0]

    _validate_out(args.out)
    code = args.code or _capture_code(args.name, org)
    if not _CODE_RE.fullmatch(code):
        # Never echoed: the code converts into a private key.
        raise SystemExit("the manifest code must be letters, digits, '_' or '-'; refusing it.")
    out = _run(["gh", "api", "-X", "POST", f"app-manifests/{code}/conversions"], secrets=(code,))
    app = json.loads(out)
    app_id = str(app["id"])
    # The id first, so a refusal below still leaves the operator with it; then
    # the key, before the variable set, because a failing `gh` there would
    # otherwise lose a key that exists only in this process.
    print(f"App created: id={app_id} slug={app.get('slug')}")
    _write_key(args.out, app["pem"])
    _run(["gh", "variable", "set", "SHIPMATE_APP_ID", "--repo", args.repo, "--body", app_id])
    print(f"Stored SHIPMATE_APP_ID (variable) and wrote the private key to {args.out}.")
    print("Next: install the App, then place that key per docs/github-app.md §4-§6.")


if __name__ == "__main__":
    main()
