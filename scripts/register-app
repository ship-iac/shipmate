#!/usr/bin/env python3
"""Exchange a GitHub App manifest-flow `code` for credentials, then store them.

One-time dev/ops setup. The manifest flow is browser-driven (docs/github-app.md
walks it): you POST app/manifest.json via a tiny HTML form, GitHub redirects
with `?code=...`. Paste that code here (MANIFEST_CODE) to convert it to an app
id + private key, then this stores the id as a repo variable and the key as a
repo secret via `gh`.
"""

import json
import os
import subprocess
import sys

REDACTED = "***"


def _scrub(text, secrets):
    for secret in secrets:
        if secret:
            text = text.replace(secret, REDACTED)
    return text


def _run(args, secrets=(), **kw):
    """Run a `gh` invocation, returning stdout; raise on a nonzero exit.

    `secrets` are the live credential values this call carries, scrubbed from
    everything the failure path prints. Both are unrotatable at the moment they
    would leak: the manifest `code` is one-time and sits in the conversions URL,
    and the private key fails exactly when it has been minted but not yet
    stored. Neither shipmate's own message (which names the subcommand only) nor
    gh's stderr (which quotes the URL it called) may carry them into shell
    scrollback or a CI log.
    """
    # args is a fixed, code-controlled `gh` invocation (never user input) and
    # shell=False -- safe.
    p = subprocess.run(args, capture_output=True, text=True, **kw)  # noqa: S603
    if p.returncode != 0:
        # gh's stderr is the only diagnosis a hand-run bootstrap gets.
        sys.stderr.write(_scrub(p.stderr, secrets))
        raise SystemExit(f"command failed ({p.returncode}): {' '.join(args[:2])}")
    return p.stdout


def main():
    code = os.environ["MANIFEST_CODE"]
    repo = os.environ["GITHUB_REPOSITORY"]
    out = _run(["gh", "api", "-X", "POST", f"app-manifests/{code}/conversions"], secrets=(code,))
    app = json.loads(out)
    app_id = str(app["id"])
    pem = app["pem"]
    print(f"App created: id={app_id} slug={app.get('slug')}")
    _run(["gh", "variable", "set", "SHIPMATE_APP_ID", "--repo", repo, "--body", app_id])
    _run(
        ["gh", "secret", "set", "SHIPMATE_APP_PRIVATE_KEY", "--repo", repo, "--body", pem],
        secrets=(pem,),
    )
    print("Stored SHIPMATE_APP_ID (variable) and SHIPMATE_APP_PRIVATE_KEY (secret).")
    print("Next: install the App on the sample repos (see docs/github-app.md).")


if __name__ == "__main__":
    main()
