#!/usr/bin/env python3
"""Check that the checkout's HCL is formatted and its generated code current.

Runs `terramate fmt --check`, then `terramate generate --detailed-exit-code`, always both, from
the checkout root. Each command's raw stdout and stderr go to stderr first, the stream the
annotations use, in a `::group::<command>` with workflow commands stopped by a random token, so
a branch-controlled file name cannot run one and no annotation lands inside the stopped window.
Each file `fmt` lists (exit 1, every stdout line an existing file relative to the cwd), and
each file `generate` reports stale, gets an `::error file=<path>::` annotation naming its
remedy; then each failing command gets one `::error::` summary naming the remedy and the first
`LISTED` files: `fmt`'s first, so the step output `refusal` is the first failing command's
summary. A tool exit this cannot read is the generic `terramate <subcommand> exited <code>`
error with the tool's output under it, each line indented two spaces so a line starting
`::error::` cannot become an annotation of its own, and a `terramate` that does not start is
`terramate <subcommand> did not start` with the OS error under it, indented the same: never
exit 0 and never a traceback. Exits 1 when either command failed.

GitHub keeps 10 error annotations per step, so the per-file annotations stop at 10 less the
summaries, `fmt`'s files first, and every summary keeps its annotation.

`generate` rewrites stale files in the checkout. `detect` uploads nothing from the tree, so that
is harmless there.
"""

import posixpath
import re
import secrets
import subprocess
import sys
from os.path import isfile

from _shipmate import (
    ANNOTATION_CAP,
    command_data,
    command_property,
    named,
    run_annotated,
    utf8_output,
)

FMT = ["terramate", "fmt", "--check"]
GENERATE = ["terramate", "generate", "--detailed-exit-code"]
_STACK = re.compile(r"- (/.*)")
_FILE = re.compile(r"\t\[[+~-]\] (.+)")
_ERROR = "\terror: "
LISTED = 10


def _fmt(code, out):
    """(summary, [(path, message)]) for `fmt --check`'s file list, or None when it lists none or
    a line that is not an existing file."""
    paths = [ln for ln in out.splitlines() if ln]
    if code != 1 or not paths or not all(map(isfile, paths)):
        return None
    summary = f"{len(paths)} file(s) not formatted; run terramate fmt and commit the result: "
    return summary + named(paths, LISTED), [(p, "not formatted; run terramate fmt") for p in paths]


def _stale_files(lines):
    """The repository-relative files of a `generate` report, or [] when a file line comes before
    any stack line."""
    stack, files = None, []
    for line in lines:
        if m := _STACK.fullmatch(line):
            stack = m.group(1)
        elif m := _FILE.fullmatch(line):
            if stack is None:
                return []
            files.append(posixpath.join(stack.lstrip("/"), m.group(1)))
    return files


def _generate(code, out):
    """(summary, [(path, message)]) for a stale or failed `generate` report, or None when the
    report holds nothing this reads."""
    lines = out.splitlines()
    if code == 2:
        files = _stale_files(lines)
        if files:
            summary = f"{len(files)} generated file(s) stale; run terramate generate and commit "
            return (
                summary + f"the result: {named(files, LISTED)}",
                [(f, "generated code is stale; run terramate generate") for f in files],
            )
    if code == 1:
        first = next((ln for ln in lines if ln.startswith(_ERROR)), None)
        if first is not None:
            reason = first.removeprefix(_ERROR)
            return f"terramate generate failed; fix the first error it reports: {reason}", []
    return None


def _echo(argv, out, err):
    token = secrets.token_hex(16)
    raw = "".join(t if t.endswith("\n") else t + "\n" for t in (out, err) if t)
    sys.stderr.write(
        f"::group::{' '.join(argv)}\n::stop-commands::{token}\n{raw}::{token}::\n::endgroup::\n"
    )
    sys.stderr.flush()


def _detail(text):
    """`text` as lines under a first line, each indented two spaces."""
    return "".join(f"\n  {ln}" for ln in text.rstrip("\n").splitlines())


def _check(argv, read):
    """(summary or None, [(path, message)]) of one command."""
    try:
        # A fixed argv with no input, run with shell=False.
        p = subprocess.run(argv, capture_output=True)  # noqa: S603
    except OSError as e:
        return f"terramate {argv[1]} did not start; run it locally to see why{_detail(str(e))}", []
    out = p.stdout.decode("utf-8", "replace")
    err = p.stderr.decode("utf-8", "replace")
    _echo(argv, out, err)
    if p.returncode == 0:
        return None, []
    found = read(p.returncode, out)
    if found:
        return found
    detail = _detail(err or out)
    return f"terramate {argv[1]} exited {p.returncode}; run it locally to see why{detail}", []


def main():
    checks = [_check(FMT, _fmt), _check(GENERATE, _generate)]
    errors = [summary for summary, _ in checks if summary]
    files = [f for _, found in checks for f in found]
    for path, message in files[: ANNOTATION_CAP - len(errors)]:
        sys.stderr.write(f"::error file={command_property(path)}::{command_data(message)}\n")
    sys.stderr.flush()
    if errors:
        raise SystemExit("\n".join("::error::" + e for e in errors))


if __name__ == "__main__":
    utf8_output()
    run_annotated(main, refusal_output=True)
