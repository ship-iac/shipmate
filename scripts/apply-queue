#!/usr/bin/env python3
"""Cancel this pull request's stale apply runs and say which run this one waits behind; with
`waiters`, tell the runs waiting behind this one.

Without an argument it runs in `apply.yml`'s `queue` job, beside this run's `run` call and
outside `shipmate-apply-<pr_number>`; `waiters` runs in `apply-run.yml`'s `waiters` job, while
this run holds the group. Any other argument exits 1. Lists the runs of `shipmate.yml`.
Reads `GITHUB_REPOSITORY`, `GITHUB_RUN_ID`, `PR_NUMBER`, `SHIPMATE_ENV` (the queue reply
header's environment), `SHIPMATE_AUTO` (`true` posts only the cancel sentences),
`SHIPMATE_APP_SLUG`, `SHIPMATE_ACTOR`, `SHIPMATE_TRIGGERING_ACTOR` and `GH_TOKEN` (an App token with
`pull-requests: write`, and `actions: write` for the queue or `actions: read` for `waiters`).

Order: list the apply runs (`apply_runs`), read the live head, read the jobs of each trusted run,
read the head again. A trusted run whose title names another head is stale, and is cancelled only
when its jobs listing is complete, both head reads agree, and its call's `review` waits for the
group, or every unfinished job of the call is a cell's `apply` `waiting` on an environment's
approval or that cell's `save` listing no steps. An incomplete runs listing or a failed head read
cancels nothing, and a failed first head read skips the jobs reads. Only a run whose own listed
`ref` is the live head cancels: a run not at the live head is stale itself and leaves stale runs to
a run at the live head; a run missing from its own listing cancels nothing. An untrusted run is
never cancelled. The queue reply names the holder and the untrusted run only while this run's
own call waits for the group (`own_waits`, never read for an `auto` run), and starts with this
run's `waits_marker` when it names the holder.

`waiters` tells each App-dispatched run with a command comment whose call waits for the group,
once per run across the `queue` and `waiters` jobs: a run whose `waits_marker` starts a
comment of `<slug>[bot]` is skipped.

Writes, a cancel or a reply, happen only when this run's `actor` and `triggering_actor` are
both `<slug>[bot]`; the replies' sentences print to the log either way. Both modes only report
and tidy, so a failed read, cancel or reply warns and exits 0; the replies are in CONTRACT.md
§Comment-ops, "One apply run per pull request".
"""

import os
import sys
import time

from _shipmate import (
    REPO_RE,
    _load,
    _run,
    apply_runs,
    current_run_url,
    env_pr_number,
    is_run_id,
    one_line,
    pr_head,
    retried,
    run_annotated,
    run_jobs,
)

ag = _load("apply-gate")
rc = _load("reply-comment")
uc = _load("upsert-comment")

#: In a jobs listing, a job of the `run` call (`<caller> / run / review`); `guard`, `queue` and
#: `outcome` sit outside the group, so their status says nothing about it.
_IN_CALL = " / run / "


def in_call(jobs):
    """The jobs of `jobs` that run inside the `run` call, in `shipmate-apply-<pr_number>`."""
    return [j for j in jobs if _IN_CALL in j["name"]]


def _unfinished(jobs):
    return [j for j in in_call(jobs) if j["status"] != "completed"]


def _segments(job):
    return job["name"].split(" / ")


def _is_review(job):
    """Whether `job` is the call's `review` job, `<caller> / run / review`, matched whole: a cell
    of env `run` and root stack `review` also ends in ` / run / review`."""
    segments = _segments(job)
    return len(segments) == 3 and segments[1:] == ["run", "review"]


def _cell_part(job):
    """`"apply"` or `"save"` when `job` is that job of a cell of the call, exactly
    `<caller> / run / L<n> / <env> / <stack> / <part>`, six segments; else None. A caller job
    name containing ` / ` never matches, so such a run is kept."""
    segments = _segments(job)
    if len(segments) != 6 or segments[1] != "run":
        return None
    # The env and stack come from the name itself, so this checks only the `L<n>` segment and
    # the part, through the grammar's one owner.
    return ag.cell_part(job["name"], segments[4], segments[3])


def _in_group_wait(jobs):
    """Whether the run's call waits for `shipmate-apply-<pr_number>`: its `review` is
    `pending`, so no job of this attempt inside the call has run."""
    return any(_is_review(j) and j["status"] == "pending" for j in jobs)


def idle(jobs):
    """Whether a run whose `jobs` listing is complete may be cancelled: its call waits for the
    group, or every unfinished job of its call is a cell's `apply` `waiting` on an environment's
    approval, or that cell's `save` listing no steps. Any other unfinished job keeps the run: a
    `pending` cell or `summary` waits on its own concurrency group mid-run, a started `save`
    writes the state, and a cancelled `summary` drops the apply comment and the gate refresh.
    An unfinished `waiters` job keeps the run too: a stale run is not cancelled while its
    `waiters` is pending, an accepted cost of a display-only job."""
    if _in_group_wait(jobs):
        return True
    unfinished = _unfinished(jobs)
    waiting = {
        j["name"] for j in unfinished if _cell_part(j) == "apply" and j["status"] == "waiting"
    }

    def held(job):
        if job["name"] in waiting:
            return True
        save = _cell_part(job) == "save" and job.get("steps") == []
        return save and job["name"].removesuffix("save") + "apply" in waiting

    return bool(unfinished) and all(held(j) for j in unfinished)


def holds(jobs):
    """Whether the run holds `shipmate-apply-<pr_number>`: a job of its call is unfinished and
    its call no longer waits for the group. An unfinished `waiters` job, display only, counts: the
    run holds the group until it ends."""
    return bool(_unfinished(jobs)) and not _in_group_wait(jobs)


#: Re-lists of this run's own jobs while its call's `review` is not listed yet, and the seconds
#: between them: `queue` starts beside `run`, before GitHub may list the call's jobs.
_OWN_RELISTS, _OWN_PAUSE = 3, 3


def own_waits(repo, own):
    """Whether this run's own call waits for `shipmate-apply-<pr_number>`, read from the call's
    `review` in a complete jobs listing of run `own`: `pending` waits, `in_progress` or
    `completed` does not. Any other listing (incomplete, no `review`, or `review` in another
    status such as `queued`) is undecided: re-lists up to `_OWN_RELISTS` times, `_OWN_PAUSE`
    seconds apart; still undecided, it warns and counts as a wait."""
    for relist in range(_OWN_RELISTS + 1):
        if relist:
            time.sleep(_OWN_PAUSE)
        jobs, complete = run_jobs(repo, own)
        status = next((j["status"] for j in jobs if _is_review(j)), None) if complete else None
        if status == "pending":
            return True
        if status in ("in_progress", "completed"):
            return False
    print(
        f"::warning::could not tell whether run {own} waits for the group: no complete jobs "
        "listing showed its review pending, running or done; the reply names the run it may "
        "wait behind"
    )
    return True


def _link(run_id):
    return current_run_url(str(run_id))


def sentences(own, holder, foreign, cancelled, complete):
    """The reply's sentences: the run `holder` this one waits for, the run `foreign` shipmate
    did not dispatch, then each cancelled run; with an incomplete listing, only that this run
    may wait."""
    me = f"[the apply run]({_link(own)})"
    if not complete:
        return [
            (
                f"{me} may wait for an earlier apply run of this pull request; its apply runs "
                "could not all be listed."
            )
        ]
    out = []
    if holder:
        out.append(
            f"{me} waits for [an earlier apply run]({_link(holder['id'])}) of this pull request "
            "to finish."
        )
    if foreign:
        out.append(
            f"{me} may wait for [an apply run]({_link(foreign['id'])}) of this pull request "
            "that shipmate did not dispatch."
        )
    out += [
        f"{me} cancelled [an apply run]({_link(r['id'])}) of this pull request waiting at an "
        f"older head ({r['ref'][:7]})."
        for r in cancelled
    ]
    return out


def _head(repo, pr):
    try:
        return pr_head(repo, pr)[0]
    except SystemExit as exc:
        print(f"::warning::could not read pull request #{pr}; no run is cancelled: {exc.code}")
        return None


def cancel(repo, run_id):
    """Cancel run `run_id`; False, with a warning, when the request fails."""
    try:
        retried(
            lambda: _run(["gh", "api", "-X", "POST", f"repos/{repo}/actions/runs/{run_id}/cancel"])
        )
    except SystemExit as exc:
        print(f"::warning::could not cancel run {run_id}: {one_line(exc.code)}")
        return False
    return True


def _while_waiting(repo, own, auto, *named):
    """`named`, or as many Nones unless this run's own call waits for the group (`own_waits`,
    read only when one is set). An `auto` run names none and reads nothing: its reply holds only
    cancel sentences."""
    if any(named) and (auto or not own_waits(repo, own)):
        return (None,) * len(named)
    return named


def queue(repo, pr, own, slug, self_by_app, auto=False):
    """`(sentences, named, cancelled)`: the reply's sentences, after cancelling each stale run
    when `self_by_app` and this run's own listed `ref` is the live head; `named` when they name
    the run this one waits for; `cancelled` the runs cancelled. The holder and the untrusted run
    are named only as `_while_waiting` allows, read after the cancels."""
    runs, complete = apply_runs(repo, pr, slug)
    own_ref = next((r["ref"] for r in runs if r["id"] == own), None)
    others = [r for r in runs if r["id"] != own]
    head = _head(repo, pr)
    if not complete:
        return sentences(own, None, None, [], False), False, []
    app_runs = [r for r in others if r["by_app"]]
    foreign = [r for r in others if not r["by_app"]]
    if head is None:
        (untrusted,) = _while_waiting(repo, own, auto, (foreign or [None])[0])
        return sentences(own, None, untrusted, [], True), False, []
    jobs = {r["id"]: run_jobs(repo, r["id"]) for r in app_runs}
    stale = [
        r for r in app_runs if r["ref"] != head and jobs[r["id"]][1] and idle(jobs[r["id"]][0])
    ]
    if own_ref != head or _head(repo, pr) != head:
        stale = []
    cancelled = [r for r in stale if self_by_app and cancel(repo, r["id"])]
    kept = [r for r in app_runs if r not in cancelled]
    holding = [r for r in kept if holds(jobs[r["id"]][0])]
    earlier = holding or [r for r in kept if r["id"] < own and _unfinished(jobs[r["id"]][0])]
    holder, untrusted = _while_waiting(
        repo, own, auto, (earlier or [None])[0], (foreign or [None])[0]
    )
    said = sentences(own, holder, untrusted, cancelled, True)
    return said, holder is not None, cancelled


def _comment_link(repo, pr, comment_id):
    return f"{os.environ['GITHUB_SERVER_URL']}/{repo}/pull/{pr}#issuecomment-{comment_id}"


def waits_marker(run_id):
    """The first line of a reply telling run `run_id` which run it waits behind."""
    return f"<!-- shipmate:waits-{run_id} -->"


def waits_sentence(waiter, repo, pr, own):
    """The sentence telling run `waiter`, an `apply_runs` row, that run `own` holds the group,
    citing the waiter's command comment on pull request `pr` of `repo`. Every id in a link is
    validated (the row's `id` and `comment`, `is_pr_number`, `is_run_id`), never raw API text."""
    return (
        f"[the apply run]({_link(waiter['id'])}) for "
        f"[this comment]({_comment_link(repo, pr, waiter['comment'])}) waits for "
        f"[the apply run]({_link(own)}) of this pull request to finish."
    )


def waiting_runs(repo, pr, own, slug):
    """The App-dispatched runs of pull request `pr` other than `own`, each with a command
    comment, whose call waits for `shipmate-apply-<pr_number>` (`_in_group_wait` over a complete
    jobs listing). Jobs are read only for such runs. An incomplete runs listing finds none; a
    run whose jobs are not all listed is skipped; each warns."""
    runs, complete = apply_runs(repo, pr, slug)
    if not complete:
        print(f"::warning::the apply runs of #{pr} could not all be listed; no waiting run is told")
        return []
    found = []
    for r in runs:
        if not r["by_app"] or r["id"] == own or not r["comment"]:
            continue
        jobs, listed = run_jobs(repo, r["id"])
        if not listed:
            print(f"::warning::the jobs of run {r['id']} could not all be listed; it is not told")
        elif _in_group_wait(jobs):
            found.append(r)
    return found


def waiters(repo, pr, own, slug, self_by_app):
    """Tell each of `waiting_runs` that this run holds the group, once: a run whose
    `waits_marker` starts a comment of `<slug>[bot]` is skipped. One comments listing, only when
    a waiting run exists. Display only: every failure warns and the run goes on."""
    found = waiting_runs(repo, pr, own, slug)
    if not found:
        return
    try:
        listed = uc.marker_comments(repo, pr, "<!-- shipmate:waits-")
    except SystemExit as exc:
        print(
            f"::warning::could not list the comments of #{pr}; no waiting run is told: "
            f"{one_line(exc.code)}"
        )
        return
    told = [c["head"] for c in listed if c["login"] == f"{slug}[bot]"]
    for r in found:
        marker = waits_marker(r["id"])
        if any(head.startswith(marker) for head in told):
            continue
        text = waits_sentence(r, repo, pr, own)
        print(text)
        if not self_by_app:
            continue
        body = rc.body("apply", "", "notice", text, current_run_url(), "apply run")
        try:
            rc.post(pr, f"{marker}\n{body}")
        except SystemExit as exc:
            print(
                f"::warning::could not tell run {r['id']} on #{pr} what it waits behind: "
                f"{one_line(exc.code)}"
            )


def main():
    mode = sys.argv[1:]
    if mode not in ([], ["waiters"]):
        sys.exit("::error::usage: apply-queue [waiters]")
    repo = os.environ["GITHUB_REPOSITORY"]
    if REPO_RE.fullmatch(repo) is None:
        sys.exit(f"::error::GITHUB_REPOSITORY is not a repository slug: {repo!r}")
    pr, own = env_pr_number("PR_NUMBER"), os.environ["GITHUB_RUN_ID"]
    if not is_run_id(own):
        sys.exit(f"::error::GITHUB_RUN_ID must be a run id (got: {own!r})")
    slug = os.environ.get("SHIPMATE_APP_SLUG", "")
    bot = f"{slug}[bot]" if slug else None
    self_by_app = bot is not None and (
        os.environ.get("SHIPMATE_ACTOR") == bot == os.environ.get("SHIPMATE_TRIGGERING_ACTOR")
    )
    if not self_by_app:
        print("::notice::this run was not dispatched by the shipmate App; it writes nothing")
    if mode:
        waiters(repo, pr, int(own), slug, self_by_app)
    else:
        reply(repo, pr, own, slug, self_by_app)


def told(repo, pr, own, slug):
    """Whether a comment of `<slug>[bot]` on pull request `pr` starts with run `own`'s
    `waits_marker`: the holder's `waiters` told this run first. A failed listing warns and reads
    as not told."""
    marker = waits_marker(own)
    try:
        listed = uc.marker_comments(repo, pr, marker)
    except SystemExit as exc:
        print(f"::warning::could not list the comments of #{pr}: {one_line(exc.code)}")
        return False
    return any(c["login"] == f"{slug}[bot]" and c["head"].startswith(marker) for c in listed)


def reply(repo, pr, own, slug, self_by_app):
    """`queue`, then its reply on pull request `pr`, under this run's `waits_marker` when it
    names the run this one waits for. When the App already told this run (`told`), the reply
    drops the marker and the waits sentence, and posts only the rest, if any. An `auto` run
    posts only the cancel sentences, and nothing when it cancelled no run."""
    auto = os.environ.get("SHIPMATE_AUTO") == "true"
    said, named, cancelled = queue(repo, pr, int(own), slug, self_by_app, auto)
    for line in said:
        print(line)
    if auto:
        said, named = (sentences(int(own), None, None, cancelled, True) if cancelled else []), False
    if not said or not self_by_app:
        return
    # `sentences` puts the waits sentence first.
    if named and told(repo, pr, own, slug):
        said, named = said[1:], False
    if not said:
        return
    marker = f"{waits_marker(own)}\n" if named else ""
    body = marker + rc.body(
        "apply",
        os.environ.get("SHIPMATE_ENV", ""),
        "notice",
        " ".join(said),
        current_run_url(),
        "apply run",
    )
    try:
        rc.post(pr, body)
    except SystemExit as exc:
        print(f"::warning::could not post the queue reply on #{pr}: {one_line(exc.code)}")


if __name__ == "__main__":
    run_annotated(main)
