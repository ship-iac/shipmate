#!/usr/bin/env python3
"""Re-pin every engine ref of one consumer repository to a release tag.

    python <engine>/scripts/repin <consumer> <tag> [--write-fence]

Run from anywhere: the engine is the checkout holding this script, and `<consumer>` is the
consumer repository's checkout. Every check runs before the first write, so a refusal leaves
every file as it was:

1. `<tag>` is `vX.Y.Z` and resolves as a tag, never as a branch of that name. When `origin`
   holds the tag, its commit is the local tag's commit: a stale local tag refuses. The commit
   is on the engine's `origin/main`, fetched first. It prints `<tag> -> <sha>`, and
   `origin has no tag <tag>: pinning to a local tag` when `origin` lacks it, the pre-push
   release smoke being the intended case.
2. In every `*.yml` and `*.yaml` file directly under `<consumer>/.github/workflows/` (GitHub
   runs only those two extensions; other files are not read), the first
   `ship-iac/shipmate/<path>@<40 hex>` of each line, with an optional closing `"` and
   `# vX.Y.Z` label, becomes `ship-iac/shipmate/<path>@<sha> # <tag>`. Line endings are kept.
3. Every engine ref in those files, the slug matched case-insensitively, then ends its line as
   `@<sha> # <tag>` or `@<sha>" # <tag>`, trailing blanks allowed, one ref per line. `@main`,
   a single-quoted ref, a case-variant slug, and text after or glued to the label each
   refuse, listed as `<file>:<line>: <text>` with the line as it stands on disk, to fix by
   hand. A directory holding no engine ref refuses.
4. Every engine workflow the directory calls with an `@` ref exists at `<sha>`.
5. The `shipmate` fence of `docs/getting-started.md` at `<sha>` renders as `onboard` renders
   it, on the branch named by the consumer's `shipmate.yml` line `    branches: [X]` directly
   under `  push:` when that is the only such line, `X` is a single plain branch name, and
   the push block holds nothing else but blank and comment lines. Any other shape renders on
   `main`, so a list, a wildcard, a flow mapping or a `paths:` filter shows in the diff. A
   single branch other than the default is `onboard`'s to report, not this script's.

It then writes each changed file, prints `updated <file>` or `unchanged <file>` for every file
it read, and prints the diff from the rendered fence to `shipmate.yml`, pins masked.
It does not commit.

`--write-fence`, in any position, then writes the rendered fence over a differing
`shipmate.yml`, in its line endings, and prints `wrote shipmate.yml from the <tag> fence`. It
keeps the file's push branch and replaces every other local edit, a changed `runs_on` or
secret mapping included, so read the printed diff first. When `shipmate.yml` is absent, or
differs and its push trigger holds anything but one plain branch, it prints
`not writing shipmate.yml: <why>` after the `updated`/`unchanged` lines, then the diff (or
`shipmate.yml absent`), and writes nothing more.

Exit codes: 0 every engine ref pinned to the tag and `shipmate.yml` matches the fence or was
written from it; 2 every engine ref pinned and `shipmate.yml` differs or is absent; 1 a
refusal or a usage error, nothing written. A re-run that writes nothing exits 0 or 2 by the
same rule.
"""

import pathlib
import re
import subprocess
import sys

from _shipmate import _load, utf8_output

onboard = _load("onboard")

ENGINE = pathlib.Path(__file__).resolve().parents[1]
SHIM = "shipmate.yml"
_SLUG = rf"(?<![\w.-]){re.escape(onboard.ENGINE_SLUG)}"
_LABEL = r"[ \t]+# v[0-9]+\.[0-9]+\.[0-9]+(?=[ \t]|$)"
_PIN = re.compile(rf'({_SLUG}/[^@ \t"]+)@[0-9a-f]{{40}}("?)({_LABEL})?')
#: Case-insensitive, unlike `_PIN`: GitHub resolves `Ship-IaC/shipmate` too, so a variant the
#: rewrite leaves alone still refuses as a leftover.
_REF = re.compile(rf'(?i:{_SLUG})/([^@ \t"]+)@')
#: The next line that is not blank or a comment sits at indent 2 or less: a `paths:`, `tags:` or
#: `branches-ignore:` line under `push:` makes the trigger more than one branch.
_TRIGGER = re.compile(
    r"^  push:\n    branches: \[([^\]\n]*)\]$(?!\n(?:[ \t]*(?:#[^\n]*)?\n)*[ \t]{3,}[^ \t\n#])",
    re.M,
)
_FLAG = "--write-fence"


def _git(*args):
    """(return code, stdout, stderr) of `git -C <engine> <args>`."""
    argv = ["git", "-C", str(ENGINE), *args]
    # shell=False over a code-built git argv; the tag is checked against `_VERSION_RE` first.
    p = subprocess.run(argv, capture_output=True)  # noqa: S603
    out, err = (s.decode("utf-8", "replace") for s in (p.stdout, p.stderr))
    return p.returncode, out, err.strip()


def _lines(text):
    """(body, terminator) per line, split at `\\n` alone as sed splits: never `str.splitlines`,
    which also splits at `\\f`, `\\v` and `\\u2028`."""
    for line in re.findall(r"[^\n]*\n|[^\n]+", text):
        body = line.removesuffix("\n")
        if body != line:
            body = body.removesuffix("\r")
        yield body, line[len(body) :]


def _resolve(tag):
    """(the commit `tag` names, whether `origin` holds the tag), refused unless it is a release
    tag on `origin/main` agreeing with `origin`'s."""
    if not onboard._VERSION_RE.fullmatch(tag):
        raise SystemExit(f"{tag!r} is not a vX.Y.Z release tag.")
    rc, _out, err = _git("fetch", "origin", "main")
    if rc:
        raise SystemExit(f"git fetch origin main failed in {ENGINE}:\n{err}")
    rc, sha, _err = _git("rev-parse", "--verify", "--quiet", f"refs/tags/{tag}^{{commit}}")
    if rc:
        raise SystemExit(
            f"no tag {tag} in the engine checkout at {ENGINE}. Fetch it with "
            f"`git -C {ENGINE} fetch origin tag {tag}`."
        )
    sha = sha.strip()
    on_origin = _check_remote_tag(tag, sha)
    rc, _out, err = _git("merge-base", "--is-ancestor", sha, "origin/main")
    if rc == 1:
        raise SystemExit(
            f"{tag} ({sha}) is not on origin/main. A commit reachable only from a branch stops "
            "resolving once that branch is force-pushed or deleted."
        )
    if rc:
        raise SystemExit(f"git merge-base --is-ancestor failed in {ENGINE}:\n{err}")
    return sha, on_origin


def _check_remote_tag(tag, sha):
    """Whether `origin` holds `tag`, refused when it does on a commit other than `sha`. A tag
    `origin` lacks passes: the release smoke re-pins before the tag is pushed."""
    ref = f"refs/tags/{tag}"
    rc, out, err = _git("ls-remote", "origin", ref, f"{ref}^{{}}")
    if rc:
        raise SystemExit(f"git ls-remote origin failed in {ENGINE}:\n{err}")
    remote = dict(line.split("\t")[::-1] for line in out.splitlines())
    peeled = remote.get(f"{ref}^{{}}", remote.get(ref))
    if peeled not in (None, sha):
        raise SystemExit(
            f"the local tag {tag} names {sha}, but origin's names {peeled}. Replace the local "
            f"tag: `git -C {ENGINE} tag -d {tag} && git -C {ENGINE} fetch origin tag {tag}`."
        )
    return peeled is not None


def _read(consumer):
    """(the workflows directory, {file name: text}) with every line ending kept."""
    wf = pathlib.Path(consumer) / ".github" / "workflows"
    if not wf.is_dir():
        raise SystemExit(f"no workflows directory at {wf}.")
    texts = {}
    for name in sorted(p.name for p in wf.iterdir() if p.is_file()):
        if not name.endswith((".yml", ".yaml")):
            continue
        try:
            # Not `read_text`: it takes `newline` only from Python 3.13, and CI runs 3.12.
            with (wf / name).open(encoding="utf-8", newline="") as f:
                texts[name] = f.read()
        except UnicodeDecodeError:
            raise SystemExit(f"{wf / name} is not UTF-8 text, so it cannot be re-pinned.") from None
    return wf, texts


def _rewrite(texts, sha, tag):
    def line(body):
        return _PIN.sub(lambda m: f"{m[1]}@{sha}{m[2]} # {tag}", body, count=1)

    return {name: "".join(line(b) + t for b, t in _lines(text)) for name, text in texts.items()}


def _check_refs(wf, texts, new, sha, tag):
    """Refuse a rewritten line in `new` whose engine ref is not the pin, listing the line as it
    stands in `texts`, the file on disk."""
    # The rest of the line after the FIRST ref must be exactly the pin, so a second ref on the
    # line refuses too: a pinned ref in a comment cannot hide an earlier `@main`.
    good = re.compile(rf'{sha}"? # {re.escape(tag)}[ \t]*')
    slug = f"{onboard.ENGINE_SLUG}/"
    bad, seen = [], False
    for name, text in new.items():
        pairs = zip(_lines(text), _lines(texts[name]), strict=True)
        for n, ((body, _end), (old, _old_end)) in enumerate(pairs, 1):
            ref = _REF.search(body)
            seen = seen or bool(ref)
            if ref and not (ref[0].startswith(slug) and good.fullmatch(body, ref.end())):
                bad.append(f"{name}:{n}: {old}")
    if bad:
        raise SystemExit(
            f"engine refs not spelled `{slug}...@{sha} # {tag}` alone at the end of their line; "
            "fix each by hand and run again:\n" + "\n".join(bad)
        )
    if not seen:
        raise SystemExit(f"no engine reference under {wf}.")


def _check_callees(texts, sha, tag):
    paths = {m[1] for t in texts.values() for b, _ in _lines(t) for m in _REF.finditer(b)}
    callees = sorted(p for p in paths if p.startswith(".github/workflows/"))
    missing = [c for c in callees if _git("cat-file", "-e", f"{sha}:{c}")[0]]
    if missing:
        raise SystemExit(
            f"engine workflows missing at {tag}, so their pins would not resolve: make the "
            "consumer-file edit its CHANGELOG names:\n" + "\n".join(missing)
        )


def _render(texts, sha, tag):
    """(the fence rendered for `shipmate.yml`, whether its push trigger is one plain branch and
    nothing else)."""
    rc, page, err = _git("show", f"{sha}:docs/getting-started.md")
    if rc:
        raise SystemExit(f"cannot read docs/getting-started.md at {tag}:\n{err}")
    found = _TRIGGER.findall(texts.get(SHIM, "").replace("\r\n", "\n"))
    plain = len(found) == 1 and bool(onboard._BRANCH_RE.fullmatch(found[0]))
    return onboard._render(page, sha, tag, found[0] if plain else "main"), plain


def _args():
    """(consumer, tag, whether `--write-fence` was given) from `sys.argv`."""
    flags = {a for a in sys.argv[1:] if a.startswith("-")}
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if len(args) != 2 or flags - {_FLAG}:
        raise SystemExit(f"usage: python <engine>/scripts/repin <consumer> <tag> [{_FLAG}]")
    return *args, _FLAG in flags


def main():
    consumer, tag, write = _args()
    sha, on_origin = _resolve(tag)
    print(f"{tag} -> {sha}")
    if not on_origin:
        print(f"origin has no tag {tag}: pinning to a local tag")
    wf, texts = _read(consumer)
    new = _rewrite(texts, sha, tag)
    _check_refs(wf, texts, new, sha, tag)
    _check_callees(new, sha, tag)
    rendered, plain = _render(new, sha, tag)
    for name, text in new.items():
        if text == texts[name]:
            print(f"unchanged {name}")
        else:
            (wf / name).write_text(text, encoding="utf-8", newline="")
            print(f"updated {name}")
    if SHIM not in new:
        if write:
            print(f"not writing {SHIM}: it is absent")
        print(f"{SHIM} absent")
        sys.exit(2)
    diff = onboard.shim_diff(rendered, new[SHIM], SHIM)
    if write and diff and not plain:
        print(f"not writing {SHIM}: its push trigger must hold one plain branch and nothing else")
    print(diff or f"{SHIM} matches the {tag} fence\n", end="")
    if write and diff and plain:
        crlf = "\r\n" in new[SHIM]
        text = rendered.replace("\n", "\r\n") if crlf else rendered
        (wf / SHIM).write_text(text, encoding="utf-8", newline="")
        print(f"wrote {SHIM} from the {tag} fence; every line above that differed is replaced")
        sys.exit(0)
    sys.exit(2 if diff else 0)


if __name__ == "__main__":
    utf8_output()
    main()
