#!/usr/bin/env python3
"""Write one cell's identity variables into the job environment.

The single writer of `TF_VAR_*` and `TF_WORKSPACE` for a cell. The source is
`SHIPMATE_TF_VARS`, the matrix row's resolved mapping, and nothing else.
"""

import json
import os
import uuid

#: The matrix row's resolved `tf_vars`, serialised by `toJSON` at the cell step.
_TABLE = "SHIPMATE_TF_VARS"


def resolve(environ):
    """The identity variables this cell should carry, by injected name.

    Only a JSON object of strings is accepted. `{}` is legitimate -- `layout =
    "folder"` derives none -- but `null` is what `toJSON` renders for a matrix field
    nothing stamped, and injecting nothing for it would authenticate the cell and then
    run it against another environment's workspace.

    The injected names are lowercase after the `TF_VAR_` prefix: GitHub uppercases
    variable names, the process environment does not, and a mismatch changes every plan
    fingerprint.
    """
    raw = environ.get(_TABLE, "")
    try:
        parsed = json.loads(raw)
    except ValueError as exc:
        raise SystemExit(
            f"::error::{_TABLE} must be the JSON object the cell step passes as "
            f"toJSON(matrix.tf_vars), and {raw!r} is not JSON. An empty value means the "
            "step omitted the input."
        ) from exc
    if not isinstance(parsed, dict) or not all(isinstance(v, str) for v in parsed.values()):
        raise SystemExit(
            f"::error::{_TABLE} must be a JSON object of strings, got {raw!r}. "
            "The empty table is {}; null is what toJSON renders for a matrix field "
            "nothing stamped, and is not the same thing."
        )
    return parsed


def _delimiter(value):
    """A heredoc delimiter that does not occur as a line of `value`.

    GitHub requires it: a delimiter appearing on its own line inside the value
    ends the value there, and the remainder is parsed as further assignments.
    """
    delim = "SHIPMATE_EOF"
    lines = value.splitlines()
    while delim in lines:
        delim = f"SHIPMATE_EOF_{uuid.uuid4().hex}"
    return delim


def write_env(pairs, path):
    """Append `pairs` to the `$GITHUB_ENV` file in heredoc form.

    Heredoc rather than `NAME=value`: an OpenTofu variable may hold JSON or any
    other multi-line value, and a bare assignment truncates it at the first
    newline.
    """
    with open(path, "a", encoding="utf-8") as fh:
        for name, value in sorted(pairs.items()):
            delim = _delimiter(value)
            fh.write(f"{name}<<{delim}\n{value}\n{delim}\n")


def main():
    write_env(resolve(os.environ), os.environ["GITHUB_ENV"])


if __name__ == "__main__":
    main()
