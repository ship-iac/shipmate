#!/usr/bin/env python3
"""Emit `POST /check-runs` bodies mirroring this run's own per-cell plan checks
onto the pull request head.

A dispatched plan's job check-runs attach to the commit of the ref that was
dispatched -- the default branch -- so the pull request shows none of them. In
particular it shows no failed cell, which is the state `shipmate plan` exists to
recover from. The plan cells' own checks are copied rather than the cell
summaries because a cell that fails before `plan-cell`'s last two steps uploads
no `cell.json` at all: a summary-derived set can report successes and nothing
else.

Reads the check-runs of the run's OWN commit as JSON Lines on stdin (as emitted
by `gh api --paginate ... --jq '.check_runs[]'`) and keeps the COMPLETED ones in
this run's check suite. `completed` is what excludes this job's own still-running
check without matching on a job name -- a name the consumer's wrapper chooses.

Nothing author-controlled is copied. The output is a fixed line plus the link
back to the original check, whose step summary is where the plan text lives.
"""

import importlib.util
import json
import os
import pathlib
import re
import sys
from importlib.machinery import SourceFileLoader

_D = pathlib.Path(__file__).resolve().parent


def _load(fname):
    loader = SourceFileLoader(fname.replace("-", "_"), str(_D / fname))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


ag = _load("apply-gate")
bm = _load("build-matrix")

#: Conclusions `POST /check-runs` accepts. The listing can also answer `stale`,
#: which it does not accept on create, so anything outside this set is mirrored
#: as `neutral` rather than failing the step or dropping the row.
_CONCLUSIONS = frozenset(
    {"success", "failure", "neutral", "cancelled", "skipped", "timed_out", "action_required"}
)
_TITLE = "planned on demand"
_SUMMARY = (
    "Mirrored onto this commit from this plan run's own check, which is attached to the ref "
    "the run was dispatched on. Follow the link for the plan output."
)
_DECIMAL = re.compile(r"[0-9]+")


def bodies(lines, suite_id, head_sha):
    """One POST body per completed check-run of `suite_id`, aimed at `head_sha`.

    An empty or non-decimal `suite_id` is refused rather than treated as "match
    everything": a run whose suite could not be identified would otherwise
    mirror every check on the commit, including other workflows'.
    """
    if not _DECIMAL.fullmatch(str(suite_id or "")):
        raise SystemExit(
            "::warning::this run's check suite could not be identified, so there is no way to "
            "tell its own per-cell checks from every other check on the commit. Nothing was "
            "mirrored."
        )
    out = []
    for run in ag.parse_jsonl(lines):
        if str(((run.get("check_suite") or {}).get("id")) or "") != str(suite_id):
            continue
        if run.get("status") != "completed":
            continue
        conclusion = run.get("conclusion")
        body = {
            "name": run["name"],
            "head_sha": head_sha,
            "status": "completed",
            "conclusion": conclusion if conclusion in _CONCLUSIONS else "neutral",
            "output": {"title": _TITLE, "summary": _SUMMARY},
        }
        if run.get("html_url"):
            body["details_url"] = run["html_url"]
        out.append(body)
    return out


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    run_id = os.environ["GITHUB_RUN_ID"]
    # The reusable summary workflow shares the caller's run id (measured), so
    # this reads the plan run's own suite without an input.
    suite_id = bm.gh_json(f"repos/{repo}/actions/runs/{run_id}").get("check_suite_id")
    out = bodies(sys.stdin, suite_id, os.environ["SHIPMATE_HEAD_SHA"])
    for body in out:
        print(json.dumps(body))
    if not out:
        # Never silent: a mirror that copied nothing means the reviewer sees no
        # per-cell checks, and the reason is not visible anywhere else.
        print(
            "::warning::this plan run's own check suite held no completed checks to mirror "
            "onto the pull request head; the pull request shows no per-cell plan checks for "
            "this run",
            file=sys.stderr,
        )


if __name__ == "__main__":
    main()
