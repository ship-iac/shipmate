#!/usr/bin/env python3
"""Collapse this run's started reply on a pull request as outdated, once the run posted its result.

Reads `GH_TOKEN`, `GITHUB_REPOSITORY`, `PR_NUMBER`, `SHIPMATE_REPLY_VERB` (`plan` or `apply`)
and `GITHUB_RUN_ID`. Lists the pull request's `github-actions[bot]` comments and minimizes, with
classifier `OUTDATED`, each one holding a line equal to the started verdict `reply-comment`
writes for this verb and this run (`matches`). A reply that links no run never matches and stays.

The collapse only decides what a reader sees, so it never fails the caller: any argument, a
`PR_NUMBER` that is not a pull-request number (both before any `gh` call), a failed listing, an
unparsable listing line (quoted, cut to 200 characters) or a failed minimize prints one
`::warning::` line and exits 0, and a failed minimize still attempts the remaining matches.
Prints `collapsed N started reply(ies)` once the matches were attempted.
"""

import json
import os
import sys
from collections.abc import Iterable

from _shipmate import _load, command_data, is_pr_number, is_run_id, run, run_annotated

rc = _load("reply-comment")

JQ = '.[] | select(.user.login == "github-actions[bot]") | {node_id, body}'
MINIMIZE = (
    "mutation($id: ID!) { minimizeComment(input: {subjectId: $id, classifier: OUTDATED}) "
    "{ minimizedComment { isMinimized } } }"
)
LINE_CUT = 200
NOT_COLLAPSED = "the started reply was not collapsed"


def matches(lines: Iterable[str], verb: str, run_id: str) -> list[str]:
    """The `node_id` of each `{node_id, body}` JSON line whose body has a line equal to the
    started verdict linking run `run_id`, in listing order. A `run_id` that is not a run id
    matches nothing, because its verdict would be the link-less one. Raises ValueError, naming
    the line cut to `LINE_CUT` characters, on a line that is not such an object."""
    if not is_run_id(run_id):
        return []
    expected = rc.VERDICTS["started"] + rc.started_text(verb, run_id)
    ids = []
    for line in lines:
        if not line.strip():
            continue
        try:
            comment = json.loads(line)
            node, body = comment["node_id"], comment["body"] or ""
            found = expected in body.splitlines()
        except (ValueError, LookupError, TypeError, AttributeError) as exc:
            raise ValueError(repr(line[:LINE_CUT])) from exc
        if found:
            ids.append(node)
    return ids


def _warn(text):
    # One line: a raw gh stderr line could otherwise start a workflow command.
    print("::warning::" + command_data(" | ".join(str(text).splitlines())))


def main():
    if sys.argv[1:]:
        _warn(f"usage: collapse-reply; {NOT_COLLAPSED}")
        return
    pr = os.environ.get("PR_NUMBER", "")
    # Bound into the API path.
    if not is_pr_number(pr):
        _warn(f"PR_NUMBER must be a pull request number (got: {pr}); {NOT_COLLAPSED}")
        return
    repo = os.environ.get("GITHUB_REPOSITORY", "")
    listing = ["gh", "api", "--paginate", f"repos/{repo}/issues/{pr}/comments?per_page=100"]
    try:
        out = run([*listing, "--jq", JQ])
    except SystemExit as exc:
        _warn(f"could not list the comments of pull request #{pr}; {NOT_COLLAPSED}: {exc.code}")
        return
    try:
        ids = matches(
            out.splitlines(),
            os.environ.get("SHIPMATE_REPLY_VERB", ""),
            os.environ.get("GITHUB_RUN_ID", ""),
        )
    except ValueError as exc:
        _warn(f"could not parse a comment of pull request #{pr}; {NOT_COLLAPSED}: {exc}")
        return
    collapsed = 0
    for node in ids:
        try:
            run(["gh", "api", "graphql", "-f", f"query={MINIMIZE}", "-f", f"id={node}"])
        except SystemExit as exc:
            _warn(
                f"could not minimize a comment of pull request #{pr}; {NOT_COLLAPSED}: {exc.code}"
            )
            continue
        collapsed += 1
    print(f"collapsed {collapsed} started reply(ies)")


if __name__ == "__main__":
    run_annotated(main)
