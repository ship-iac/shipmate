#!/usr/bin/env python3
"""Judge the `apply / <stack> / <env>` checks on a commit.

Reads check-runs as JSON Lines on stdin (one check-run object per line, as
emitted by `gh api --paginate ... --jq '.check_runs[]'`) and prints the run
projection of `plan_records`, `{name: plan run id}`, on stdout for comment-ops'
reviewed-plan lookup. `verdict` is the gate's done-predicate over the same checks:

- `complete`   — every apply check's latest run is completed with a good
                 conclusion (success, or neutral for no-change cells).
- `pending`    — at least one apply check is still open, failed, or was
                 cancelled, or the commit has no apply check at all.

Check-runs are filtered to the shipmate GitHub App's identity (`from_app`,
env `SHIPMATE_APP_ID`), so a same-name run created by any other identity can
never feed the gate.

The GitHub API returns every historical run of a re-created check name, so
runs are grouped by name and judged by the newest run per name, ordered by
check-run id (monotonically increasing with creation, and always present --
unlike a queued run's nullable started_at, which could otherwise sort a newer
queued duplicate below an older completed run).
"""

import json
import os
import re
import sys

from _shipmate import is_pr_number, is_run_id, run_annotated

APPLY_PREFIX = "apply / "
#: The consumer names its plan-calling job `plan`, and GitHub names a called workflow's
#: check runs `<caller job> / <callee job>`. `shipmate doctor` reports a job carrying another
#: name, and `CONTRACT.md` §Check names states it.
CALLER_PREFIX = "plan / "
DONE_CONCLUSIONS = {"success", "neutral"}


def env_pr_number():
    """`SHIPMATE_PR_NUMBER`, refused unless it is a decimal pull request number with no
    leading zero: the apply record carries it, and the apply refuses a record whose number
    is not the dispatch's own."""
    value = os.environ.get("SHIPMATE_PR_NUMBER", "")
    if not is_pr_number(value):
        raise SystemExit(
            f"::error::SHIPMATE_PR_NUMBER must be a pull request number (got: {value!r})"
        )
    return value


def check_name(stack, env):
    """The apply check's name, `apply / <stack> / <env>`: built forward. Two sites read it
    back: `deploy-detect.refuse_stranded_checks`, because after the merge the env a stack lost
    exists only in its check's name, and `apply-complete` through `parse_check_name`, because
    its snapshot is keyed by check name. `stack` is the stack path, so a deploy that knows only
    the path rebuilds it exactly."""
    return f"{APPLY_PREFIX}{stack} / {env}"


def parse_check_name(name):
    """`(stack, env)` of the apply check name `name`. An env name holds no ` / `, so the env
    is the text after the last one."""
    stack, _, env = name.removeprefix(APPLY_PREFIX).rpartition(" / ")
    return stack, env


def cell_job_name(stack, env):
    """A cell job's own name, `<env> / <stack>`, as `plan.yml`, `drift.yml` and
    `apply-env-level.yml` declare it. GitHub prefixes each caller level's job name."""
    return f"{env} / {stack}"


def plan_check_name(stack, env):
    """The plan cell's check name, `plan / <env> / <stack>`."""
    return CALLER_PREFIX + cell_job_name(stack, env)


def is_cell_job(job_name, stack, env):
    """Whether the listed job `job_name` is the cell's: its whole name, or a suffix after a
    ` / ` boundary, since every caller level prepends its own name and the levels differ per
    route. The boundary keeps env `eu` from matching a job of env `dev-eu`."""
    own = cell_job_name(stack, env)
    return job_name == own or job_name.endswith(f" / {own}")


def app_runs(check_run_lines, app_id):
    """The check-runs in JSONL `check_run_lines` that the App `app_id` created: `parse_jsonl`
    then the fail-closed `from_app`."""
    return from_app(parse_jsonl(check_run_lines), app_id)


def latest_by_name(check_runs, prefix=APPLY_PREFIX):
    """Group check-runs by name (names starting with `prefix`; default: apply
    checks), keeping only the newest run per name. Returns {name: run}.

    "Newest" is by check-run `id`. GitHub assigns ids monotonically at creation,
    so the highest id is the most recently created run. Unlike `started_at`
    (nullable -- a freshly-created queued run may carry none) an id is always
    present, so a newer queued duplicate never sorts below an older completed
    run. summary-comment reuses this with prefix="": it resolves plan-check
    links by an exact `plan_check_name` lookup, not a prefix filter."""
    latest = {}
    for run in check_runs:
        name = run["name"]
        if not name.startswith(prefix):
            continue
        key = run.get("id") or 0
        if name not in latest or key > latest[name][0]:
            latest[name] = (key, run)
    return {name: run for name, (_, run) in latest.items()}


def _is_done(run):
    return run["status"] == "completed" and run.get("conclusion") in DONE_CONCLUSIONS


def done_names(check_runs):
    """Names whose *latest* run is completed with a good conclusion (success,
    or neutral for no-change cells). This is the single done-predicate shared
    with the apply-side detects so a "completed" status with a bad
    conclusion, or a stale completed run superseded by a newer pending one,
    is never mistaken for done."""
    return {name for name, run in latest_by_name(check_runs).items() if _is_done(run)}


def parse_jsonl(lines):
    """Parse newline-delimited JSON (one object per line, blank lines
    skipped), as emitted by `gh api --paginate --jq`. A malformed line raises
    SystemExit naming the offending line (truncated) instead of letting a raw
    json.JSONDecodeError traceback obscure which line was bad. Shared by this
    script's stdin parsing and by the detects' check-runs parsing."""
    out = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError as e:
            raise SystemExit(f"::error::malformed JSON line ({e}): {line[:120]!r}") from e
    return out


def from_app(check_runs, app_id):
    """Keep only check-runs created by the given GitHub App id.

    A same-name check created by any other identity (github-actions app id
    15368, another App) must never feed a gate verdict or a detect work queue —
    a forged newer completed duplicate would otherwise green a pending name via
    latest_by_name, and a forged pending one would wedge the gate. Runs with no
    `app` field are dropped too (fail-closed)."""
    if not app_id:
        raise SystemExit(
            "::error::SHIPMATE_APP_ID is empty; set the SHIPMATE_APP_ID repo/org "
            "variable to the shipmate App id (see docs/github-app.md)."
        )
    want = int(app_id)
    return [r for r in check_runs if ((r.get("app") or {}).get("id")) == want]


def app_done_names(check_run_lines, app_id):
    """done_names restricted to a single App's apply checks: parse JSONL,
    from_app-filter to app_id, then done_names. The one entry point the
    detects call, so "only App-authored checks count as done" lives in one
    place — dropping the from_app filter here is a visible, tested change."""
    return done_names(app_runs(check_run_lines, app_id))


def plan_records(check_run_lines, app_id):
    """Map each App-authored apply check name to `(plan run id, plan-text sha256, pull request
    number)`, read from the `external_id` record pending-checks wrote on it. Runs
    app_done_names' primitives -- parse_jsonl, the fail-closed from_app filter, and
    latest_by_name's newest-by-id grouping -- so only the newest App-authored run per name is
    consulted.

    A name is absent when that newest run carries no decodable record: a null/empty/non-JSON
    external_id (a bare hex digest included), or one that decodes to something other than an
    object. No JSONDecodeError escapes. A present name's run is its decimal-digit `plan_run`
    and its digest the 64-lowercase-hex `plan_sha256` that the trusted summary job published,
    and its pull request the `pr` string `_shipmate.is_pr_number` accepts; each is None when
    the record carries no such value. Absence is not an error here: each caller decides per
    cell what a missing run, an unbound plan text or a missing pull request means.

    `main` prints `{name: run}` for every record whose run is not None and does not
    narrow it for any other reason: authorize reads that projection as PLAN_RUN_JSON and
    answers an empty mapping with "no reviewed plan for the current PR head". A name dropped
    from it for a policy that is not its own, a missing digest included, surfaces as that
    message."""
    out = {}
    for name, run in latest_by_name(app_runs(check_run_lines, app_id)).items():
        record = _decoded(run)
        if record is None:
            continue
        digest = record.get("plan_sha256")
        pr = record.get("pr")
        out[name] = (
            _plan_run(record),
            digest if isinstance(digest, str) and re.fullmatch(r"[0-9a-f]{64}", digest) else None,
            pr if isinstance(pr, str) and is_pr_number(pr) else None,
        )
    return out


def incomplete_runs(check_run_lines, app_id):
    """Map each plan run that published only part of its apply checks to `(distinct names
    published, sorted distinct declared counts, whether any record has no valid count)`.
    Complete runs are absent.

    A run's names are every App-authored `apply / ` check, of any status, whose decodable
    record names it; its declared counts are the records' `cells` values that are an int and
    not a bool. The run is complete only when every record declares a count and those counts
    are exactly `{len(names)}`: a record with no valid count (even beside a sibling that has
    one), two or more counts (they disagree), or a single count larger or smaller than the
    names makes it incomplete. Records are decoded with `plan_records`' tolerance: one that is
    undecodable, not an object, or has no valid `plan_run` counts for no run.

    Every check run is read, not only the newest per name, so a same-head re-plan that no
    longer plans a cell leaves the older run's names still counted, rather than making that
    run incomplete for good. Within one attempt of run R the wider scan cannot inflate R's
    names: only R's summary job writes a record naming R. A "Re-run all jobs" attempt that
    plans a different cell set can add names under the same run id, and then R is incomplete
    (it fails closed)."""
    names, counts = {}, {}
    for run in app_runs(check_run_lines, app_id):
        if not run["name"].startswith(APPLY_PREFIX):
            continue
        record = _decoded(run)
        plan_run = _plan_run(record) if record is not None else None
        if plan_run is None:
            continue
        names.setdefault(plan_run, set()).add(run["name"])
        cells = record.get("cells")
        valid = isinstance(cells, int) and not isinstance(cells, bool)
        counts.setdefault(plan_run, set()).add(cells if valid else None)
    return {
        run: (
            len(named),
            tuple(sorted(c for c in counts[run] if c is not None)),
            None in counts[run],
        )
        for run, named in names.items()
        if counts[run] != {len(named)}
    }


def _decoded(run):
    """The object `run`'s `external_id` decodes to, or None when it is empty, not JSON, or not
    an object. No JSONDecodeError escapes."""
    try:
        record = json.loads(run.get("external_id") or "")
    except json.JSONDecodeError:
        return None
    return record if isinstance(record, dict) else None


def _plan_run(record):
    """The decimal-digit `plan_run` of decoded `record`, or None when it carries no such
    string."""
    plan_run = record.get("plan_run")
    return plan_run if isinstance(plan_run, str) and is_run_id(plan_run) else None


def verdict(check_runs):
    """The gate verdict over `check_runs`, which must already be `app_runs` output: this does
    not filter by App identity."""
    latest = latest_by_name(check_runs)
    return "complete" if latest and all(_is_done(r) for r in latest.values()) else "pending"


def main():
    records = plan_records(sys.stdin, os.environ["SHIPMATE_APP_ID"])
    print(json.dumps({name: run for name, (run, _, _) in records.items() if run is not None}))


if __name__ == "__main__":
    run_annotated(main)
