#!/usr/bin/env python3
"""Judge the `apply / <env> / <stack>` checks on a commit.

Reads check-runs as JSON Lines on stdin (one check-run object per line, as
emitted by `gh api --paginate ... --jq '.check_runs[]'`) and prints the run
projection of `plan_records`, `{name: plan run id}`, on stdout for comment-ops'
reviewed-plan lookup. `verdict` is the gate's done-predicate over the same checks:

- `complete`   — every apply check's latest run is completed with a good
                 conclusion (success, or neutral for no-change cells).
- `pending`    — at least one apply check is still open, failed, or was
                 cancelled, or the commit has no apply check at all.

Check-runs are filtered to the shipmate GitHub App's identity (`from_app`,
env `SHIPMATE_APP_ID`), so a same-name run created by any other identity can
never feed the gate.

The GitHub API returns every historical run of a re-created check name, so
runs are grouped by name and judged by the newest run per name, ordered by
check-run id (monotonically increasing with creation, and always present --
unlike a queued run's nullable started_at, which could otherwise sort a newer
queued duplicate below an older completed run).
"""

import json
import os
import posixpath
import re
import sys
import urllib.parse

from _shipmate import (
    decoded,
    gh_json,
    is_env_name,
    is_head_sha,
    is_pr_number,
    is_run_id,
    listed_jobs,
    plan_runs_since,
    retried,
    run_annotated,
    run_jobs,
)

#: The prefix keeps the gate's pending-apply queue off the plan checks on the same head.
APPLY_PREFIX = "apply / "
#: The consumer names its plan-calling job `plan`, and GitHub names a called workflow's
#: check runs `<caller job> / <callee job>`. `shipmate doctor` reports a job carrying another
#: name, and `CONTRACT.md` §Check names states it.
CALLER_PREFIX = "plan / "
DONE_CONCLUSIONS = {"success", "neutral"}
#: The `apply` job's steps the attempt verdict reads, as `cell.yml` names them: the pre-apply
#: check, whose failure makes `apply-cell` refuse before it applies, and the step running it.
PRE_APPLY_STEP = "Pre-apply check"
APPLY_STEP = "Apply the cell"
#: The title of an apply check held `in_progress` because its cell's state may not be saved.
HELD_TITLE = "State not saved"


def env_pr_number():
    """`SHIPMATE_PR_NUMBER`, refused unless it is a decimal pull request number with no
    leading zero: the apply record carries it, and the apply refuses a record whose number
    is not the dispatch's own."""
    value = os.environ.get("SHIPMATE_PR_NUMBER", "")
    if not is_pr_number(value):
        raise SystemExit(
            f"::error::SHIPMATE_PR_NUMBER must be a pull request number (got: {value!r})"
        )
    return value


def check_name(stack, env):
    """The apply check's name, `apply / <env> / <stack>`; `parse_check_name` inverts it.
    The format changes only in a breaking release: after a merge, an open check's name is the
    only record of an env its stack lost, and a check written in another format is not read.
    `stack` is the stack path, so every reader builds the name forward from the path, a
    deploy that knows only the path included."""
    return f"{APPLY_PREFIX}{env} / {stack}"


def parse_check_name(name):
    """`(stack, env)` of the apply check name `name`, or None when `name` is outside the
    grammar: no `APPLY_PREFIX`, a first segment that is no env name, or an empty stack. An env
    name holds no ` / ` and a stack path may, so the env is the text before the first one.
    Shape cannot tell an old-order one-segment name from a new one: `apply / dns / dev-us`
    parses as stack `dev-us` in env `dns`."""
    if not name.startswith(APPLY_PREFIX):
        return None
    env, _, stack = name.removeprefix(APPLY_PREFIX).partition(" / ")
    return (stack, env) if is_env_name(env) and stack else None


def cell_job_name(stack, env):
    """A cell job's own name, `<env> / <stack>`, as `plan.yml`, `drift.yml` and
    `apply-env-level.yml` declare it. GitHub prefixes each caller level's job name."""
    return f"{env} / {stack}"


def plan_check_name(stack, env):
    """The plan cell's check name, `plan / <env> / <stack>`."""
    return CALLER_PREFIX + cell_job_name(stack, env)


def cell_part(job_name, stack, env):
    """`"apply"` or `"save"` when the listed job `job_name` is that job of the cell's
    `cell.yml`, `L<n> / <env> / <stack> / <part>` (`apply-run.yml` and `deploy.yml` name their
    env-level jobs `L<n>`), whole or after a ` / ` boundary, since the calling jobs prepend their
    own names; else None. The `L<n>` segment keeps out any other job ending in the cell's name,
    and the boundary keeps env `eu` from matching a job of env `dev-eu`."""
    pattern = rf"(?:.* / )?L[0-9]+ / {re.escape(cell_job_name(stack, env))} / (apply|save)"
    match = re.fullmatch(pattern, job_name)
    return match.group(1) if match else None


def level_of(jobs, job_id):
    """The level of the listed job `job_id`, its name up to the `L<n>` segment (`apply / run /
    L0`): for a cell job, `<level> / <env> / <stack> / <part>`, or a job directly under the
    level. "" when `jobs` does not list it or its name has neither shape."""
    own = next((j.get("name", "") for j in jobs if str(j.get("id")) == str(job_id)), "")
    segments = own.split(" / ")
    cell = len(segments) >= 4 and segments[-1] in ("apply", "save")
    depth = 4 if cell and re.fullmatch(r"L[0-9]+", segments[-4]) else 2
    if len(segments) < depth or not re.fullmatch(r"L[0-9]+", segments[-depth]):
        return ""
    return " / ".join(segments[: 1 - depth])


def cell_rows(jobs, level, stack, env):
    """`{"apply": [...], "save": [...]}`: the listed jobs of `jobs` named exactly
    `<level> / <env> / <stack> / <part>`, `level` from `level_of`. Both empty when `level` is
    empty, so a listing that does not list the calling job matches no cell."""
    rows = {"apply": [], "save": []}
    for part in rows:
        name = f"{level} / {cell_job_name(stack, env)} / {part}"
        if level and cell_part(name, stack, env) == part:
            rows[part] = [j for j in jobs if j.get("name") == name]
    return rows


def is_carried(row, jobs):
    """Whether the listed job `row` is a copy of an earlier attempt's row in `jobs`: a re-run
    lists a job it did not re-run again under the new attempt, with the same name and start and
    no steps. A carried job ran in its original attempt only."""
    attempt, key = row.get("run_attempt"), (row.get("name"), row.get("started_at"))
    return isinstance(attempt, int) and any(
        isinstance(j.get("run_attempt"), int)
        and j["run_attempt"] < attempt
        and (j.get("name"), j.get("started_at")) == key
        for j in jobs
    )


def _applied(row):
    """Whether the `apply` row `row`, no carried copy, applied: True, False, or None when
    unknown."""
    steps = row.get("steps")
    if steps == []:
        # Ended with no steps: cancelled while pending, or failed before it started (a rejected
        # deployment, a group conflict). A queued, waiting, running or successful one is unknown.
        ended = row.get("status") == "completed" and row.get("conclusion") in (
            "cancelled",
            "skipped",
            "failure",
        )
        return False if ended else None
    if not isinstance(steps, list):
        return None

    def conclusion(name):
        named = [s for s in steps if isinstance(s, dict) and s.get("name") == name]
        return named[0].get("conclusion") if len(named) == 1 else None

    return not (conclusion(APPLY_STEP) == "skipped" or conclusion(PRE_APPLY_STEP) == "failure")


def attempts(jobs, stack, env):
    """`{attempt: {"applied": ..., "saved": ...}}` for the cell's rows in `jobs`, a
    `filter=all` listing. `applied` is the verdict (`_applied`) of the attempt's `apply` rows
    that are no carried copy (`is_carried`): True when any applied, None when the attempt lists
    no `apply` row or any is unknown, False when every row is carried or did not apply. `saved`
    is True when a `save` row of the attempt or a later one succeeded: a later save succeeds only
    after the earlier attempts' state was found. None when no such row is listed, else False."""
    rows = {}
    for job in jobs:
        part = cell_part(job.get("name", ""), stack, env)
        if part:
            rows.setdefault(job.get("run_attempt"), {"apply": [], "save": []})[part].append(job)
    out = {}
    for attempt in sorted(rows):
        listed = rows[attempt]["apply"]
        verdicts = [_applied(row) for row in listed if not is_carried(row, jobs)]
        applied = True if True in verdicts else None if None in verdicts or not listed else False
        saves = [j for k in rows if k >= attempt for j in rows[k]["save"]]
        saved = any(j.get("conclusion") == "success" for j in saves) if saves else None
        out[attempt] = {"applied": applied, "saved": saved}
    return out


def unsaved(jobs, stack, env, before=None):
    """The sorted attempts of the cell in `jobs` (below `before` when given) that applied or may
    have, and whose state is not known saved (`attempts`)."""
    return [
        attempt
        for attempt, verdict in sorted(attempts(jobs, stack, env).items())
        if (before is None or attempt < before)
        and verdict["applied"] is not False
        and verdict["saved"] is not True
    ]


def app_runs(check_run_lines, app_id):
    """The check-runs in JSONL `check_run_lines` that the App `app_id` created: `parse_jsonl`
    then the fail-closed `from_app`."""
    return from_app(parse_jsonl(check_run_lines), app_id)


def latest_by_name(check_runs, prefix=APPLY_PREFIX):
    """Group check-runs by name (names starting with `prefix`; default: apply
    checks), keeping only the newest run per name. Returns {name: run}.

    "Newest" is by check-run `id`. GitHub assigns ids monotonically at creation,
    so the highest id is the most recently created run. Unlike `started_at`
    (nullable -- a freshly-created queued run may carry none) an id is always
    present, so a newer queued duplicate never sorts below an older completed
    run. summary-comment reuses this with prefix="": it resolves plan-check
    links by an exact `plan_check_name` lookup, not a prefix filter."""
    latest = {}
    for run in check_runs:
        name = run["name"]
        if not name.startswith(prefix):
            continue
        key = run.get("id") or 0
        if name not in latest or key > latest[name][0]:
            latest[name] = (key, run)
    return {name: run for name, (_, run) in latest.items()}


def _is_done(run):
    return run["status"] == "completed" and run.get("conclusion") in DONE_CONCLUSIONS


def held_names(check_runs):
    """Names whose *latest* run is `in_progress` and titled `HELD_TITLE`."""
    return {
        name
        for name, run in latest_by_name(check_runs).items()
        if run["status"] == "in_progress" and (run.get("output") or {}).get("title") == HELD_TITLE
    }


def done_names(check_runs):
    """Names whose *latest* run is completed with a good conclusion (success,
    or neutral for no-change cells). This is the single done-predicate shared
    with the apply-side detects so a "completed" status with a bad
    conclusion, or a stale completed run superseded by a newer pending one,
    is never mistaken for done."""
    return {name for name, run in latest_by_name(check_runs).items() if _is_done(run)}


def parse_jsonl(lines):
    """Parse newline-delimited JSON (one object per line, blank lines
    skipped), as emitted by `gh api --paginate --jq`. A malformed line raises
    SystemExit naming the offending line (truncated) instead of letting a raw
    json.JSONDecodeError traceback obscure which line was bad. Shared by this
    script's stdin parsing and by the detects' check-runs parsing."""
    out = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError as e:
            raise SystemExit(f"::error::malformed JSON line ({e}): {line[:120]!r}") from e
    return out


def from_app(check_runs, app_id):
    """Keep only check-runs created by the given GitHub App id.

    A same-name check created by any other identity (github-actions app id
    15368, another App) must never feed a gate verdict or a detect work queue —
    a forged newer completed duplicate would otherwise green a pending name via
    latest_by_name, and a forged pending one would wedge the gate. Runs with no
    `app` field are dropped too (fail-closed)."""
    if not app_id:
        raise SystemExit(
            "::error::SHIPMATE_APP_ID is empty; set the SHIPMATE_APP_ID repo/org "
            "variable to the shipmate App id (see docs/github-app.md)."
        )
    want = int(app_id)
    return [r for r in check_runs if ((r.get("app") or {}).get("id")) == want]


def app_done_names(check_run_lines, app_id):
    """done_names restricted to a single App's apply checks: parse JSONL,
    from_app-filter to app_id, then done_names. The one entry point the
    detects call, so "only App-authored checks count as done" lives in one
    place — dropping the from_app filter here is a visible, tested change."""
    return done_names(app_runs(check_run_lines, app_id))


def plan_records(check_run_lines, app_id):
    """Map each App-authored apply check name to `(plan run id, plan-text sha256, pull request
    number)`, read from the `external_id` record pending-checks wrote on it. Runs
    app_done_names' primitives -- parse_jsonl, the fail-closed from_app filter, and
    latest_by_name's newest-by-id grouping -- so only the newest App-authored run per name is
    consulted.

    A name is absent when that newest run carries no decodable record: a null/empty/non-JSON
    external_id (a bare hex digest included), or one that decodes to something other than an
    object. No JSONDecodeError escapes. A present name's run is its decimal-digit `plan_run`
    and its digest the 64-lowercase-hex `plan_sha256` that the trusted summary job published,
    and its pull request the `pr` string `_shipmate.is_pr_number` accepts; each is None when
    the record carries no such value. Absence is not an error here: each caller decides per
    cell what a missing run, an unbound plan text or a missing pull request means.

    `main` prints `{name: run}` for every record whose run is not None and does not
    narrow it for any other reason: authorize reads that projection as PLAN_RUN_JSON and
    answers an empty mapping with "no reviewed plan for the current PR head". A name dropped
    from it for a policy that is not its own, a missing digest included, surfaces as that
    message."""
    out = {}
    for name, record in _newest_records(check_run_lines, app_id):
        digest = record.get("plan_sha256")
        pr = record.get("pr")
        out[name] = (
            _plan_run(record),
            digest if is_plan_digest(digest) else None,
            pr if isinstance(pr, str) and is_pr_number(pr) else None,
        )
    return out


def is_plan_digest(value):
    """Whether `value` is a plan-text digest as the apply record carries it: a str of 64
    lowercase hex characters."""
    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def plan_actions(check_run_lines, app_id):
    """Map each App-authored apply check name to the `action` its newest record holds, None
    when it holds none, as an older engine's does; callers compare it with `PUSH_ACTIONS`. A
    name whose newest check carries no decodable record is absent. Read beside
    `plan_records`, whose tuple every reader unpacks."""
    return {name: record.get("action") for name, record in _newest_records(check_run_lines, app_id)}


def _newest_records(check_run_lines, app_id):
    """`(name, decoded record)` of each App-authored apply check whose newest run carries one."""
    for name, run in latest_by_name(app_runs(check_run_lines, app_id)).items():
        record = decoded(run)
        if record is not None:
            yield name, record


def behind_names(check_run_lines, app_id):
    """The App-authored apply check names whose newest run's record holds `behind` exactly
    `True`: the plan found that the base changed the cell's stack after the branch left it, so
    no plan of the cell exists to apply until the branch is updated from the base."""
    return {
        name
        for name, record in _newest_records(check_run_lines, app_id)
        if record.get("behind") is True
    }


#: The event actions of an autoplan a push started: only its plan applies automatically.
PUSH_ACTIONS = ("opened", "synchronize")


def incomplete_runs(check_run_lines, app_id):
    """Map each plan run that published only part of its apply checks to `(distinct names
    published, sorted distinct declared counts, whether any record has no valid count)`.
    Complete runs are absent.

    A run's names are every App-authored `apply / ` check, of any status, whose decodable
    record names it; its declared counts are the records' `cells` values that are an int and
    not a bool. The run is complete only when every record declares a count and those counts
    are exactly `{len(names)}`: a record with no valid count (even beside a sibling that has
    one), two or more counts (they disagree), or a single count larger or smaller than the
    names makes it incomplete. Records are decoded with `plan_records`' tolerance: one that is
    undecodable, not an object, or has no valid `plan_run` counts for no run.

    Every check run is read, not only the newest per name, so a same-head re-plan that no
    longer plans a cell leaves the older run's names still counted, rather than making that
    run incomplete for good. Within one attempt of run R the wider scan cannot inflate R's
    names: only R's summary job writes a record naming R. A "Re-run all jobs" attempt that
    plans a different cell set can add names under the same run id, and then R is incomplete
    (it fails closed)."""
    names, counts = {}, {}
    for run in app_runs(check_run_lines, app_id):
        if not run["name"].startswith(APPLY_PREFIX):
            continue
        record = decoded(run)
        plan_run = _plan_run(record) if record is not None else None
        if plan_run is None:
            continue
        names.setdefault(plan_run, set()).add(run["name"])
        cells = record.get("cells")
        valid = isinstance(cells, int) and not isinstance(cells, bool)
        counts.setdefault(plan_run, set()).add(cells if valid else None)
    return {
        run: (
            len(named),
            tuple(sorted(c for c in counts[run] if c is not None)),
            None in counts[run],
        )
        for run, named in names.items()
        if counts[run] != {len(named)}
    }


def _plan_run(record):
    """The decimal-digit `plan_run` of decoded `record`, or None when it carries no such
    string."""
    plan_run = record.get("plan_run")
    return plan_run if isinstance(plan_run, str) and is_run_id(plan_run) else None


#: Where the consumer's workflow file must live. Three surfaces match this filename
#: literally: `shipmate doctor` keys its fork-trigger exemption and its `shipmate.yml` probe on it,
#: `actions/dispatch` sends every commented verb to it, and `scripts/onboard` renders it
#: under this name. `newest_autoplan` lists its runs by basename.
PLAN_WORKFLOW = ".github/workflows/shipmate.yml"


_LISTED_KEYS = ("id", "event", "head_sha", "actor", "triggering_actor")


def autoplan_runs(repo, head, *, run):
    """Every listed run of `PLAN_WORKFLOW` started by `pull_request_target` on `head`, in listing
    order. Every page is read. Each run is the listing's object cut to `_LISTED_KEYS` plus
    `status`, `conclusion`, `run_attempt` and `created_at`: its integer `id`, `event`,
    `head_sha`, and `actor` and `triggering_actor`, which the projection always emits as
    `{"login": ...}` mappings, the login null when GitHub gives none. A missing actor so reaches
    `authorize.pusher_reason` and refuses there, never as a malformed listing. The logins equal
    a single-run read's. A transient failure is retried (`retried`). Raises `ValueError` on a
    line that is not such an object or whose `id` is not an integer; `status`, `conclusion`,
    `run_attempt` and `created_at` are not checked."""
    query = f"event=pull_request_target&head_sha={head}&per_page=100"
    args = [
        "gh",
        "api",
        "--paginate",
        f"repos/{repo}/actions/workflows/{posixpath.basename(PLAN_WORKFLOW)}/runs?{query}",
        "--jq",
        (
            ".workflow_runs[] | {id, event, head_sha, status, conclusion, run_attempt, created_at, "
            "actor: {login: .actor.login}, triggering_actor: {login: .triggering_actor.login}} "
            "| tojson"
        ),
    ]
    listing = retried(lambda: run(args))
    runs = [json.loads(line) for line in listing.splitlines() if line.strip()]
    for listed in runs:
        if not isinstance(listed, dict) or any(k not in listed for k in _LISTED_KEYS):
            raise ValueError(f"not a listed run: {listed!r}")
        if type(listed["id"]) is not int:
            raise ValueError(f"run id is {listed['id']!r}")
    return runs


def newest_autoplan(repo, head, *, run):
    """The `autoplan_runs` entry with the greatest `id` that did not defer, or None when none
    is listed. Walking down by id, a run is read past only when it is listed `completed` with
    conclusion `success`, an older run is listed, and its jobs (`run_jobs`, through `run`), every
    one at the listed `run_attempt`, are `deferred`: it planned nothing and left the head the
    older run's plan. Jobs at another attempt are not deferred, as a re-run turned the run live.
    Retries and raises as `autoplan_runs` does, and raises `ValueError` on an incomplete jobs
    listing or one `deferred` cannot read."""
    runs = sorted(autoplan_runs(repo, head, run=run), key=lambda listed: listed["id"], reverse=True)
    for listed in runs[:-1]:
        if not _deferred_run(repo, listed, run):
            return listed
    return runs[-1] if runs else None


def _deferred_run(repo, listed, run):
    if (listed.get("status"), listed.get("conclusion")) != ("completed", "success"):
        return False
    jobs, complete = run_jobs(repo, listed["id"], run)
    if not complete:
        raise ValueError(f"the jobs of autoplan run {listed['id']} could not be listed")
    return all(j.get("run_attempt") == listed.get("run_attempt") for j in jobs) and deferred(jobs)


def planned(jobs):
    """Whether a plan run planned, from `jobs`: a complete, counted jobs listing
    (`_shipmate.listed_jobs(..., counted=True)`) of a run attempt that has ended, every job of that
    attempt, which the caller checks. It planned when exactly one job is named `CALLER_PREFIX +
    "detect"`, `completed` with conclusion `success`. A draft-skipped run lists that job `skipped`,
    a `closed`-event run and a run cancelled before `detect` list none, and a zero-cell plan lists
    it `success`. Raises `ValueError` when it cannot tell: two such jobs, or one whose `status` is
    not a str or not `completed`, or `completed` with a `conclusion` that is not a str."""
    detects = [j for j in jobs if j.get("name") == CALLER_PREFIX + "detect"]
    if len(detects) > 1:
        raise ValueError(f"{len(detects)} jobs are named {CALLER_PREFIX}detect")
    if not detects:
        return False
    status, conclusion = status_and_conclusion(detects[0], f"job {CALLER_PREFIX}detect")
    if status != "completed":
        raise ValueError(f"job {CALLER_PREFIX}detect is {status!r} in a run that has ended")
    return conclusion == "success"


def deferred(jobs):
    """Whether a plan run deferred to an earlier plan of its head, from `jobs`, a listing as
    `planned` takes: exactly one `CALLER_PREFIX + "defer"` job `completed` `success` and exactly
    one `CALLER_PREFIX + "detect"` job `completed` `skipped`. A draft-skipped run lists `defer`
    skipped. Raises `ValueError` on two jobs of either name."""
    found = {}
    for name in ("defer", "detect"):
        named = [j for j in jobs if j.get("name") == CALLER_PREFIX + name]
        if len(named) > 1:
            raise ValueError(f"{len(named)} jobs are named {CALLER_PREFIX}{name}")
        found[name] = [(j.get("status"), j.get("conclusion")) for j in named]
    return found == {"defer": [("completed", "success")], "detect": [("completed", "skipped")]}


def status_and_conclusion(listed, what):
    """`(status, conclusion)` of a listed run or job `listed`: a str `status` and, once
    `completed`, a str `conclusion`. Raises `ValueError` naming `what` otherwise: a missing or
    mistyped value cannot say whether it ran."""
    status, conclusion = listed.get("status"), listed.get("conclusion")
    if not isinstance(status, str) or (status == "completed" and not isinstance(conclusion, str)):
        raise ValueError(f"{what} has status {status!r} and conclusion {conclusion!r}")
    return status, conclusion


def provenance_reason(newest, plan_run, head, cells):
    """The first provenance check the auto apply of `plan_run`, a decimal run id, on `head`
    fails, as `(cause, detail)`, or None when every check passes. Pure: each caller words the
    cause itself from `detail`.

    `newest` is `newest_autoplan`'s object or None. `cells` maps each check name to the
    `(recorded plan run or None, event action or None)` its record holds, possibly empty;
    failing names are reported in its order. Checks, in this order:

    - `("unlisted", None)`: `newest` is None.
    - `("newer", newest["id"])`: the newest autoplan is another run, older or newer. Ids
      compare as strings: `is_run_id` admits a leading zero, and a record `"0123"` names no
      run 123.
    - `("event", newest["event"])`: it is not a `pull_request_target` run; the listing's
      `event=` filter should already exclude one.
    - `("head", newest["head_sha"])`: it planned another commit than `head`.
    - `("record", [(name, recorded), ...])`: cells recording another plan run.
    - `("action", [(name, action), ...])`: cells whose action is not in `PUSH_ACTIONS`."""
    if newest is None:
        return "unlisted", None
    if str(newest["id"]) != plan_run:
        return "newer", newest["id"]
    if newest["event"] != "pull_request_target":
        return "event", newest["event"]
    if newest["head_sha"] != head:
        return "head", newest["head_sha"]
    records = [(name, run) for name, (run, _) in cells.items() if run != plan_run]
    if records:
        return "record", records
    actions = [(name, act) for name, (_, act) in cells.items() if act not in PUSH_ACTIONS]
    return ("action", actions) if actions else None


def newer_plans(repo, pr_number, newest, *, since, run):
    """`(counted, complete)`: the first `shipmate plan` run of pull request `pr_number`, a str,
    any actor, created at or after `since` (`plan_runs_since`) with a greater id than autoplan
    `newest` (`newest_autoplan`'s object, the plan run an auto apply applies), that counts against
    that apply, as a one-item list, or an empty one. Runs are judged ascending by id and the
    read stops at the first counted one. Ids decide: a run created in the same second can be
    newer. A run whose status is not `completed` counts. A completed run counts when its jobs
    (`listed_jobs`, count checked) show it `planned`, whatever its conclusion: a failed plan run
    whose `detect` succeeded may have rewritten the head's records. A complete and empty jobs
    listing (cancelled while queued, a startup failure) did not plan. `complete` is false when
    the listing is, or a judged run's status or conclusion is not a str
    (`status_and_conclusion`), or a completed run's `run_attempt` is not an int, or its jobs
    cannot be listed, carry another run attempt, or cannot tell (`planned` raises). Raises
    `ValueError` on an int `pr_number`."""
    runs, complete = plan_runs_since(repo, pr_number, since, run)
    for listed in runs:
        if listed["id"] <= newest["id"]:
            continue
        try:
            status, _ = status_and_conclusion(listed, f"shipmate plan run {listed['id']}")
        except ValueError:
            complete = False
            continue
        if status != "completed":
            return [listed], complete
        attempt = listed.get("run_attempt")
        jobs = (
            None if type(attempt) is not int else listed_jobs(repo, listed["id"], run, counted=True)
        )
        if jobs is None or any(j.get("run_attempt") != attempt for j in jobs):
            complete = False
            continue
        try:
            if planned(jobs):
                return [listed], complete
        except ValueError:
            complete = False
    return [], complete


def newer_plan(counted, complete):
    """The newer-plan check of an auto apply over `newer_plans`' answer, as `(cause, detail)`,
    or None when it passes. Pure: each caller words the cause.

    - `("newer-plan", run)`: `run` is the lowest counted id, as listed.
    - `("plan-listing", None)`: none is counted and the listing is incomplete."""
    if counted:
        return "newer-plan", counted[0]
    return None if complete else ("plan-listing", None)


def base_tip(repo, pull, *, run):
    """The tip commit of the REST pull request `pull`'s base branch (`branch_tip`). Not
    `pull["base"]["sha"]`: probed on a sample pull request, it kept the old tip for 20 s and more
    after a push to the base, while the branch ref answered the new tip at once. Raises as
    `branch_tip` does, and `LookupError` or `TypeError` on a malformed pull request."""
    return branch_tip(repo, pull["base"]["ref"], run=run)


def branch_tip(repo, branch, *, run):
    """The tip commit of `branch`, read from its ref. Raises `SystemExit` on a failed read or an
    answer that is not that branch's commit."""
    path = urllib.parse.quote(branch, safe="/")
    ref = gh_json(f"repos/{repo}/git/ref/heads/{path}", run)
    sha = ref["object"]["sha"]
    if ref["ref"] != f"refs/heads/{branch}" or ref["object"]["type"] != "commit":
        raise SystemExit(f"::error::{ref['ref']} is not the commit ref of branch {branch!r}")
    if not is_head_sha(sha):
        raise SystemExit(f"::error::branch {branch!r} points at {sha!r}, not a commit sha")
    return sha


def verdict(check_runs):
    """The gate verdict over `check_runs`, which must already be `app_runs` output: this does
    not filter by App identity."""
    latest = latest_by_name(check_runs)
    return "complete" if latest and all(_is_done(r) for r in latest.values()) else "pending"


def main():
    records = plan_records(sys.stdin, os.environ["SHIPMATE_APP_ID"])
    print(json.dumps({name: run for name, (run, _, _) in records.items() if run is not None}))


if __name__ == "__main__":
    run_annotated(main)
