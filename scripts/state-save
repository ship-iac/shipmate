#!/usr/bin/env python3
"""Decide what one cell's `save` job does with its state, and fetch the sealed bundle it needs.

Runs as the first step of `actions/state-save` with `STACK`, `ENV_NAME`, `STATE` (the `apply`
job's `state` output from `state-handoff`, possibly empty) and `JOB_ID` (this job's check run
id). Writes `kind`, and for `save` and `lookup` also `attempt` (the attempt in the state key),
`path` and `slug`. The slug comes from the trusted `STACK` by `apply-cell`'s rule (`slug_of`),
never from the `apply` job, which runs pull-request code. In order:

| Attempt | `STATE` | Result |
| --- | --- | --- |
| any | `<digest> attempt=n`, n this attempt | refuse over an unsaved earlier attempt, else `save` |
| any | `missing ...` | refuse: the apply left no state file |
| 1 | `not-applied ...` or `none ...` | `skip` |
| any | empty or malformed | refuse when this attempt's own `apply` may have started |
| 1 | empty or malformed | `skip` |
| > 1 | anything else | `lookup` of the one unsaved earlier attempt; refuse on two; else `skip` |

"Unsaved" is `apply-gate.unsaved` over this run's `filter=all` listing, at this job's level. A
`save` only ever writes this attempt's own state, so a `save` that succeeds after its earlier
attempts were found clears them; a `lookup` never writes. An `apply` row a re-run carried from
an earlier attempt is not this attempt's apply (`apply-gate.is_carried`).

Only `save` and `lookup` reach the runner check (`RUNNER_ENVIRONMENT` exactly
`github-hosted`), right before the first artifact call: a `skip` succeeds on any runner. The
bundle comes from the artifact `state-handoff.artifact_name(ENV_NAME, slug, attempt)`: for
`save`, and for a `lookup` whose `STATE` carries that attempt's digest, only a copy hashing to
the digest; otherwise the first copy that parses, since a forged path only makes the exact-key
lookup miss. Its path is checked with `state-path.validate`; `save` writes the ciphertext to
`$GITHUB_WORKSPACE/<path>`. It reads no encryption key and never decrypts.
"""

import hashlib
import io
import json
import os
import re
import subprocess
import urllib.parse
import zipfile

from _shipmate import (
    _load,
    command_data,
    exit_text,
    listed_jobs,
    one_line,
    retried,
    run,
    run_annotated,
    write_outputs,
)

ag = _load("apply-gate")
sh = _load("state-handoff")
sp = _load("state-path")

STATE = re.compile(r"(not-applied|none|missing|[0-9a-f]{64}) attempt=([1-9][0-9]{0,3})")
HOSTED_ONLY = (
    "the state saver runs only on GitHub-hosted runners; a reused self-hosted runner could alter "
    "what it saves. Use a GitHub-hosted runs_on or a remote backend"
)
MEMBER = "state.bundle"
#: The remedy every refusal ends with; `actions/state-save` repeats it, pinned by
#: `test_state_save.py` against this constant.
REMEDY = (
    "Never re-run this job or its workflow run. A re-run, a shipmate apply comment, or a merge "
    "can apply this cell's reviewed plan again against the state from before the apply. Before "
    "applying or merging any plan of this stack in this environment, on any pull request, follow "
    "docs/troubleshooting.md section The apply step ran and its state was not saved."
)
NO_STATE = ("not-applied", "none")
SLUG = re.compile(r"[A-Za-z0-9._-]+")
SKIP = ("skip", None, None)


def slug_of(stack):
    """The stack path with `/` as `-`, as `apply-cell`'s `Stack slug` step derives it; refuses
    any other character, since the slug names the artifact and the state key."""
    slug = stack.replace("/", "-")
    if not SLUG.fullmatch(slug):
        raise SystemExit("::error::stack path produced invalid slug")
    return slug


def refuse(reason, attempts):
    """Raise the refusal naming the state keys of `attempts` and the runbook section."""
    env, stack = os.environ["ENV_NAME"], os.environ["STACK"]
    prefix = f"state/{slug_of(stack)}/{env}/{os.environ['GITHUB_RUN_ID']}-"
    keys = " and ".join(f"{prefix}{k} or {prefix}{k}-r1" for k in attempts)
    raise SystemExit(
        f"::error::{reason}, so the state of {env} / {stack} is not known saved under {keys}. "
        + REMEDY
    )


def _artifacts(name):
    repo, run_id = os.environ["GITHUB_REPOSITORY"], os.environ["GITHUB_RUN_ID"]
    query = urllib.parse.quote(name, safe="")
    path = f"repos/{repo}/actions/runs/{run_id}/artifacts?name={query}&per_page=100"
    listing = retried(lambda: run(["gh", "api", "--paginate", "--jq", ".artifacts[]", path]))
    found = [json.loads(line) for line in listing.splitlines() if line.strip()]
    return [a for a in found if a.get("name") == name]


def _download(artifact_id):
    """The zip archive's bytes; `run` decodes stdout as text, which would corrupt them."""
    argv = [
        "gh",
        "api",
        f"repos/{os.environ['GITHUB_REPOSITORY']}/actions/artifacts/{artifact_id}/zip",
    ]

    def call():
        # A fixed gh argv run with shell=False; the id is an integer from the listing.
        p = subprocess.run(argv, capture_output=True)  # noqa: S603
        if p.returncode != 0:
            stderr = p.stderr.decode("utf-8", "replace").strip()
            raise SystemExit(f"command failed ({p.returncode}): {' '.join(argv)}\n{stderr}")
        return p.stdout

    return retried(call)


def _bundle(archive):
    """The one `MEMBER` of a downloaded archive when it starts with the bundle header, or None."""
    try:
        with zipfile.ZipFile(io.BytesIO(archive)) as zf:
            if zf.namelist() != [MEMBER]:
                return None
            bundle = zf.read(MEMBER)
    except zipfile.BadZipFile:
        return None
    return bundle if bundle.startswith(sh.BUNDLE_MAGIC) else None


def matching(name, digest):
    """The bundle of an artifact named `name` whose bytes hash to `digest`, or with `digest`
    None the first that parses; None when there is none."""
    for artifact in _artifacts(name):
        if not isinstance(artifact.get("id"), int):
            continue
        try:
            bundle = _bundle(_download(artifact["id"]))
        except SystemExit:
            print(f"state-save: artifact {artifact['id']} could not be downloaded")
            continue
        if bundle is not None and digest in (None, hashlib.sha256(bundle).hexdigest()):
            return bundle
    return None


def _cell(stack, env, own):
    """`{"apply": [...], "save": [...]}`, the cell's rows at this job's level in the run's
    `filter=all` listing; refuses when the listing fails or does not list this job."""
    repo, run_id = os.environ["GITHUB_REPOSITORY"], os.environ["GITHUB_RUN_ID"]
    jobs = listed_jobs(repo, run_id, counted=True, job_filter="all")
    level = ag.level_of(jobs or [], os.environ["JOB_ID"])
    if not level:
        refuse("the run's job listing failed or does not list this job", [own])
    return ag.cell_rows(jobs, level, stack, env)


def _unsaved(cell, stack, env, own):
    """The earlier attempts `apply-gate.unsaved` names; refuses on two or more."""
    unsaved = ag.unsaved(cell["apply"] + cell["save"], stack, env, before=own)
    if len(unsaved) > 1:
        refuse(_unsaved_reason(unsaved), unsaved)
    return unsaved


def _unsaved_reason(attempts):
    return f"run attempts {', '.join(map(str, attempts))} of this cell may have applied unsaved"


def _parsed(state, own):
    """`(value, attempt)` of a well-formed `STATE` naming this attempt or an earlier one, else
    `(None, None)`."""
    m = STATE.fullmatch(state)
    return (m[1], int(m[2])) if m and int(m[2]) <= own else (None, None)


def decide(stack, env, state, own):
    """`(kind, attempt, digest)`: what the table in this module's docstring makes of `STATE`;
    `digest` is the one the fetched bundle must hash to, or None."""
    value, n = _parsed(state, own)
    if value == "missing":
        refuse("the apply step ran and left no state file", [n])
    if n == own and value not in NO_STATE:
        if own > 1 and (earlier := _unsaved(_cell(stack, env, own), stack, env, own)):
            refuse(_unsaved_reason(earlier), earlier)
        return "save", own, value
    if own == 1 and value is not None:
        return SKIP
    cell = _cell(stack, env, own)
    own_apply = ag.attempts(cell["apply"] + cell["save"], stack, env).get(own, {})
    if value is None and own_apply.get("applied") is not False:
        refuse(f"the apply job's state output reads {state!r} after its apply may have run", [own])
    unsaved = _unsaved(cell, stack, env, own) if own > 1 else []
    if not unsaved:
        return SKIP
    return "lookup", unsaved[0], value if n == unsaved[0] and value not in NO_STATE else None


def main():
    stack, env = os.environ["STACK"], os.environ["ENV_NAME"]
    slug = slug_of(stack)
    own = int(os.environ["GITHUB_RUN_ATTEMPT"])
    kind, attempt, digest = decide(stack, env, os.environ.get("STATE", ""), own)
    if kind == "skip":
        write_outputs(kind=kind)
        print("state-save: nothing to save or look up")
        return
    if os.environ.get("RUNNER_ENVIRONMENT") != "github-hosted":
        refuse(HOSTED_ONLY, [attempt])
    name = sh.artifact_name(env, slug, attempt)
    try:
        bundle = matching(name, digest)
    except SystemExit as exc:
        refuse(f"the run's artifacts could not be listed ({one_line(exit_text(exc))})", [attempt])
    if bundle is None:
        refuse(f"no artifact of this run named {name} holds the cell's state bundle", [attempt])
    head, _, ciphertext = bundle.removeprefix(sh.BUNDLE_MAGIC).partition(b"\n")
    path = head.decode("utf-8", "replace")
    # The path may hold a value the cell masked, and masks do not cross jobs.
    print(f"::add-mask::{command_data(path)}")
    try:
        sp.validate(stack, path)
    except SystemExit as exc:
        refuse(exit_text(exc), [attempt])
    if kind == "save":
        target = os.path.join(os.environ["GITHUB_WORKSPACE"], path)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "wb") as fh:
            fh.write(ciphertext)
    write_outputs(kind=kind, attempt=attempt, path=path, slug=slug)
    print(f"state-save: {name} matched; mode {kind}")


if __name__ == "__main__":
    run_annotated(main)
