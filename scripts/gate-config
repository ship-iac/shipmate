#!/usr/bin/env python3
"""Resolve the gate settings the comment-ops authorization path runs on.

The environments whose entry holds `gated: false`, from `.github/shipmate-config.yml` on the
default branch, and from nowhere else, read through the contents API: the comment-ops job
checks out no consumer content, and that read needs none.

`validate_structure` is not optional: the resolvers document a validated table and do not
enforce it, and an unvalidated `gated: no` resolves as gated, exempting nothing while
reading as though it did.
"""

from _shipmate import _load, run_annotated, write_outputs

ec = _load("env-config")


def main():
    table = ec.validate_structure(ec.read_table())
    ungated = ec.ungated_envs(table)
    # Sorted, so two runs over one file cannot produce two different output strings.
    write_outputs(ungated_envs=",".join(sorted(ungated)))


if __name__ == "__main__":
    run_annotated(main)
