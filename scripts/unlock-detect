#!/usr/bin/env python3
"""Unlock detect: the cells in one environment that HAVE a pending apply check, as
a flat queue — releasing a lock has no dependencies, so there are no waves.

Selection is by membership in the App-authored apply checks whose newest run
is not completed, not by removing the completed ones: every queued cell takes
a real state lock and may force-break one, so a stack this pull request never
planned — no apply check at all — must not be in range. The tree walk still
supplies the cells because a check-run name carries no workload.

Unlike the apply path it needs no plan run at all: a lock outlives the run
that stranded it, those plan artifacts may be long expired, and unlock
consumes no plan. The pending apply checks ARE the queue, the same authority
deploy-detect uses.

`all_stacks=True` evaluates tags across the whole tree, which the apply path
deliberately avoids (one unrelated stack's unresolvable expression would
block an approved plan). That trade is inverted here on purpose: unlock has
no plan to protect, and it must reach a cell whose plan artifacts expired
long ago. A stack with no `env/*` tag is in no environment, so it adds no
cell and cannot make unlock unavailable. For the same reason the walk passes
`check_names=False`: another stack's unusable `env/*` tag refuses every other
run, and must not strand this env's lock; `validate_env` checked `env` itself.

`env_membership` + `cap_cells(full_tree([env], {env: queued}, ...))` rather than
`compute_cells`, which is what the bare-apply detect does with the same whole-tree walk
and for the same reason: `cap_cells` refuses a set above the GHA matrix limit, and
over `all_stacks=True` that ceiling counts every stack × every environment in the tree
— so a repository large enough to exceed it could never unlock ANY environment,
however short the queue, and the refusal would tell the operator to split a pull
request that does not exist. The queue is narrowed before any cell is built, so every
refusal `full_tree`, `cap_cells`, `stamp_rows` and `refuse_workload_gaps` carry sees only the
queued stacks: the matrix limit, the slug-collision guard, two
`workload/*` tags, and a workload tag outside its environment's `workloads` list.
None of them can affect a lock release, and a stack outside the queue is not
released, so none of them may make `env` unable to unlock.

No review decision is read because an approval reviews a diff and unlock
applies none — the run-time half of the decision `scripts/authorize` already
made at comment time. `cells` is written even for an empty queue, as `[]`,
because the unlock job's `strategy.matrix.include` is `fromJSON(cells)` and
`fromJSON('')` is an error.
"""

import json
import os

from _shipmate import _load

ad = _load("apply-detect")
# Aliases, not loads: unlock-detect and apply-detect share one build-matrix instance.
bm = ad.bm
ag = ad.ag


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    env = os.environ["SHIPMATE_ENV"]
    head = os.environ["SHIPMATE_HEAD_SHA"]

    ad.validate_head_sha(head)
    ad.validate_env(env)

    stacks_by_env, tags_by_stack = bm.env_membership(all_stacks=True, check_names=False)
    runs = ag.app_runs(ad._check_run_lines(repo, head), os.environ["SHIPMATE_APP_ID"])
    # Not the complement of done: a name with no run is not pending, and a completed run
    # with a bad conclusion is done being run; either would enrol a cell into a force-unlock.
    names = {n for n, r in ag.latest_by_name(runs).items() if r["status"] != "completed"}
    in_env = stacks_by_env.get(env, [])
    queued = [s for s in in_env if ag.check_name(s, env) in names]
    pending = bm.cap_cells(bm.full_tree([env], {env: queued}, tags_by_stack), False)
    table = bm.env_config(pending, bm.tagged_workloads(stacks_by_env, tags_by_stack))
    pending = bm.stamp_rows(pending, table, "apply")
    bm.refuse_workload_gaps(pending, table)
    print(
        f"::notice title=unlock-detect::env={env} head={head} "
        f"cells={len(in_env)} pending={len(pending)}"
    )
    if not pending:
        print(
            f"::warning::no cell in {env} has a pending apply check, so no lock was "
            "probed; a lock on a cell whose check already completed, or on a stack "
            "applied out of band, is released out of band; see the state-lock "
            "section of docs/troubleshooting.md."
        )
    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
        fh.write(f"cells={json.dumps(pending)}\n")


if __name__ == "__main__":
    main()
