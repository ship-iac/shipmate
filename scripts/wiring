#!/usr/bin/env python3
"""Check the consumer wiring the `shipmate / gate` status depends on.

Three conditions, all in files the engine does not own, all silent when broken
(CONTRACT.md §Post-plan topology):

- the plan workflow lives at `.github/workflows/plan.yml`, which the engine's
  reusable `summary.yml` byte-matches in its `workflow_run.path` guard;
- its top-level `name:` is exactly `shipmate · plan`;
- some workflow triggers on `workflow_run` for that name and calls the engine's
  reusable `.github/workflows/summary.yml`.

Two callers with different reads of the same directory: `build-matrix` from the
local checkout inside the plan run's `detect` job, and `doctor`'s probe through
the contents API at the commit under examination. Both hand this module BYTES —
the decode lives here so the two cannot drift on decode policy, which is exactly
the axis the middot trap runs along.

Findings are three-valued. BROKEN is reserved for near-tautological facts (a
filename absent from a listing, a scalar that is not the literal); everything
else is UNKNOWN. `build-matrix` fails a pull request's `detect` job on BROKEN,
so a false positive would block every pull request in every consumer until an
engine fix and a re-pin — the checks below therefore err toward passing.

Deliberately containment, not a descent into `on:` -> `workflow_run:` ->
`workflows:`. `workflows:` can be a block sequence, a one-line flow sequence or
a flow sequence spread over lines, and the indentation-descent shape is what
made doctor's `pull_request_target` matcher wrong twice. Asking whether the
`on:` block *contains* a `workflow_run` token and the literal name accepts every
spelling and cannot manufacture a warning for a working repository.
"""

import re

BROKEN, UNKNOWN = "broken", "unknown"

#: The plan workflow's filename, and the path the engine's reusable
#: `summary.yml` byte-matches in its `workflow_run.path` guard.
PLAN_FILE = "plan.yml"
PLAN_PATH = f".github/workflows/{PLAN_FILE}"
#: The workflow name GitHub matches `workflow_run.workflows:` against. The
#: separator is U+00B7 MIDDLE DOT. Never normalize, casefold or collapse
#: whitespace when comparing against this: a look-alike separator is the whole
#: failure mode.
PLAN_NAME = "shipmate · plan"
#: The engine's reusable workflow a consumer's wiring file must call.
SUMMARY_PATH = ".github/workflows/summary.yml"
#: Annotation title. Distinct from doctor's, because `build-matrix` cannot
#: import doctor (doctor `_load`s build-matrix at module scope) and because an
#: annotation that fails a run must not claim doctor's never-fails identity.
WIRING_TITLE = "shipmate wiring"

_NAME_KEY = re.compile(r"""^["']?name["']?[ \t]*:(?P<rest>.*)$""")
#: `on` at column 0 only, optionally quoted: a workflow's `on:` is a top-level
#: key, so an indented one belongs to something else. Unanchored, a
#: `    python-version: 3.12` would match (`versi` + `on:`) and silently
#: retarget the block both this module's wiring checks and doctor's
#: `pull_request_target` probe read.
_ON_KEY = re.compile(r"""^["']?on["']?[ \t]*:(?P<rest>.*)$""")
_WORKFLOW_RUN = re.compile(r"(?<![\w-])workflow_run(?![\w-])")
_WORKFLOWS_KEY = re.compile(r"""["']?workflows["']?[ \t]*:""")
#: The trailing `(?![\w-])` is what keeps `pull_request_target` from counting as
#: a `pull_request` trigger -- they are different events, and only the first one
#: satisfies the engine's `workflow_run.event` guard.
_PULL_REQUEST = re.compile(r"(?<![\w-])pull_request(?![\w-])")

BAD_PATH = (
    BROKEN,
    f"no `{PLAN_PATH}` in this repository — the engine's reusable summary "
    "workflow skips every job unless the completed plan run's path is exactly "
    "that, so no apply checks and no `shipmate / gate` status are ever written "
    "and every pull request stays unmergeable. Move the plan workflow back to "
    f"`{PLAN_PATH}`.",
)
NO_WIRING = (
    BROKEN,
    "no workflow triggers on `workflow_run` for the plan workflow and calls the "
    f"engine's reusable `{SUMMARY_PATH}` — so nothing creates the apply checks, "
    "the plan comment or the `shipmate / gate` status, and every pull request "
    "stays unmergeable. Copy `.github/workflows/summary.yml` from any of the "
    "`repo-example-{stacks,folders,workspaces}` sample repositories (README.md "
    "§Example repositories) — the wrapper is identical across all three, and "
    "CONTRACT.md §Post-plan topology states what it has to keep.",
)
BAD_TRIGGER = (
    BROKEN,
    f"`{PLAN_PATH}` does not trigger on `pull_request` — the engine's reusable "
    "summary workflow skips every job unless the completed plan run's event was "
    "exactly that, so no apply checks and no `shipmate / gate` status are ever "
    "written. `pull_request_target` is a different event and does not satisfy "
    "it (and is unsafe here besides — see docs/hardening.md). Add "
    "`pull_request` to the plan workflow's `on:`.",
)
LISTING_UNREADABLE = (
    UNKNOWN,
    "could not read `.github/workflows` — the plan/summary wiring was not verified.",
)
PLAN_UNREADABLE = (
    UNKNOWN,
    f"could not read `{PLAN_PATH}` — its workflow name was not verified.",
)
WIRING_UNREADABLE = (
    UNKNOWN,
    "could not read every workflow file — the `workflow_run` wiring was not verified.",
)
WIRING_ESCAPED = (
    UNKNOWN,
    f"a workflow triggers on `workflow_run` into the engine's `{SUMMARY_PATH}`, but its "
    "`workflows:` value carries a backslash escape this check does not process — it was "
    f"not compared against `{PLAN_NAME}`.",
)
NAME_UNREADABLE = (
    UNKNOWN,
    f"`{PLAN_PATH}`'s `name:` is not a plain scalar this check can read — its "
    f"value was not compared against `{PLAN_NAME}`.",
)
TRIGGER_UNREADABLE = (
    UNKNOWN,
    f"`{PLAN_PATH}` has no top-level `on:` this check can read — it was not "
    "verified that the plan workflow triggers on `pull_request`.",
)
WIRING_INDIRECT = (
    UNKNOWN,
    "a workflow triggers on `workflow_run` for the plan workflow, but it does not "
    f"itself call the engine's reusable `{SUMMARY_PATH}` — it may reach it through "
    "another workflow, which this check cannot follow. Verify by hand that a "
    "`shipmate / gate` status appears on this pull request.",
)


def decode(data):
    """Workflow-file bytes -> text. One decode policy for both callers.

    `errors="replace"` is load-bearing rather than defensive: a middot written
    through a lossy encoding is not valid UTF-8, and mapping it to U+FFFD is
    what makes the string comparison below equivalent to a byte comparison.
    U+FFFD cannot occur inside PLAN_NAME, and UTF-8 decoding is injective on
    valid input, so `decode(b) == PLAN_NAME` holds exactly when `b` was that
    literal's UTF-8.

    One leading U+FEFF is dropped. A BOM'd `plan.yml` carries its byte-order
    mark in front of the column-0 `name:` key, which reads as no top-level
    `name:` at all and would be reported broken. U+FEFF cannot occur inside
    PLAN_NAME either, so removing it leaves the equivalence above intact.
    """
    return data.decode("utf-8", "replace").removeprefix("\ufeff")


def _strip_comment(line):
    """`line` up to its YAML comment marker: a `#` at the start of the line or
    preceded by whitespace. A `#` inside a token (`branch#1`) is not a comment."""
    for i, ch in enumerate(line):
        if ch == "#" and (i == 0 or line[i - 1] in " \t"):
            return line[:i]
    return line


def _on_block(text):
    """(inline remainder of the `on:` line, its following lines) with comments
    stripped, or (None, []) for a file with no top-level `on:`. The block runs to
    the first line starting at column 0; blank and comment-only lines do not end
    it."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        m = _ON_KEY.match(line)
        if not m:
            continue
        block = []
        for nxt in lines[i + 1 :]:
            stripped = _strip_comment(nxt)
            if stripped.strip() and not stripped[0].isspace():
                break
            block.append(stripped)
        return _strip_comment(m.group("rest")), block
    return None, []


def _unquote(value):
    """A quoted YAML scalar's contents, or None when this module cannot read it
    faithfully. A backslash inside a double-quoted scalar is an escape sequence
    (`"shipmate \\u00b7 plan"` is the correct name spelled the long way), and
    processing escapes is a YAML parser's job — so that degrades rather than
    being compared raw and reported wrong."""
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        inner = value[1:-1]
        if value[0] == '"' and "\\" in inner:
            return None
        return inner
    if "\\" in value:
        return None
    return value


def plan_name(text):
    """(kind, value) for a workflow's top-level `name:`.

    kind is "scalar" (value is the name), "block" (a `|`/`>` block scalar or a
    value continued on following lines — unreadable here, and never reported as
    wrong), or "absent" (no top-level `name:` at all, which makes GitHub name
    the workflow after its path).

    Column 0 only: a job's `name:` is indented, and matching it would compare
    the wrong string.
    """
    for line in text.splitlines():
        m = _NAME_KEY.match(_strip_comment(line))
        if not m:
            continue
        rest = m.group("rest").strip()
        if not rest or rest[0] in "|>":
            return "block", None
        value = _unquote(rest)
        return ("block", None) if value is None else ("scalar", value)
    return "absent", None


def _engine_summary(engine_repo):
    """`uses:` matcher for the engine's reusable summary workflow.

    The slug is pinned to the engine when it is known -- `github.action_repository`,
    resolved by GitHub at runtime, never hardcoded -- so another org's
    same-named reusable workflow does not satisfy the check. It is empty only
    when the action runs from a local path -- unsupported for a consumer, which
    pins the engine by SHA -- and any slug then passes: erring toward a false
    PASS is the required direction for a check that can fail a run. That
    fallback does not make a vendored engine work, and is not meant to: such a
    wrapper says `uses: ./.github/workflows/summary.yml`, which carries no slug
    and no `@ref`, so this matcher misses it whatever the slug pattern is.

    Only the SLUG is case-insensitive, and deliberately so: GitHub resolves an
    owner/repo case-insensitively, so `Acme/Shipmate` is the engine, while the
    workflow path after it is a file in that repository and `Summary.yml` is not
    that file.
    """
    slug = re.escape(engine_repo) if engine_repo else r"[\w.-]+/[\w.-]+"
    # `uses[ \t]*:`, matching every other key matcher here: `uses : x` is valid
    # YAML, and this is the one matcher whose miss is fatal rather than merely
    # imprecise.
    return re.compile(rf"""uses[ \t]*:\s*["']?(?i:{slug})/{re.escape(SUMMARY_PATH)}@""")


def _escaped_workflows(on_text):
    """Whether a backslash follows the `workflows:` key in an `on:` block. A
    `workflows: ["shipmate \\u00b7 plan"]` is the plan name spelled the long way,
    and this module does not process YAML escapes -- the same reason `_unquote`
    degrades rather than comparing raw. Containment, not an escape processor:
    the answer only ever downgrades a BROKEN to an UNKNOWN."""
    m = _WORKFLOWS_KEY.search(on_text)
    return bool(m) and "\\" in on_text[m.end() :]


def _wiring_state(text, engine_repo):
    """One workflow file's state: "present", "indirect", "escaped" or "absent".

    "present" is both halves in the same file: a `workflow_run` trigger naming
    the plan workflow, and a call into the engine's reusable summary workflow.
    Comments are stripped from both reads -- a repository that commented the
    wiring out has no wiring, and a commented-out name is exactly the line
    somebody leaves behind when they break it.

    "indirect" is the trigger naming the plan workflow WITHOUT that call. A
    wrapper may reach the engine through another reusable workflow, local or in
    a shared-workflows repository, and both chain correctly on GitHub. This
    module cannot follow the hop, and a trigger aimed at this exact plan name is
    far too specific to be a coincidence -- so it degrades rather than claiming
    a repository that gates fine has no wiring at all.

    "escaped" is that same wiring with a `workflows:` value this module cannot
    read faithfully. Reporting it broken would contradict the name half, which
    already degrades on the identical spelling.
    """
    inline, block = _on_block(text)
    if inline is None:
        return "absent"
    on_text = "\n".join([inline, *block])
    if not _WORKFLOW_RUN.search(on_text):
        return "absent"
    if PLAN_NAME not in on_text:
        return "escaped" if _escaped_workflows(on_text) else "absent"
    body = "\n".join(_strip_comment(ln) for ln in text.splitlines())
    return "present" if _engine_summary(engine_repo).search(body) else "indirect"


def _trigger_findings(blob):
    """Whether the plan workflow triggers on `pull_request`.

    The fourth condition the engine's reusable `summary.yml` gates on, alongside
    the path and the two the wiring checks cover:
    `github.event.workflow_run.event == 'pull_request'`. A plan workflow that
    runs on `pull_request_target`, or only on `merge_group`, satisfies every
    other check here and still never produces a gate -- which is the exact
    silent failure this module exists to surface, so leaving it unchecked made
    the probe assert the wiring was fine over a dead gate.
    """
    if blob is None:
        return []  # PLAN_UNREADABLE already says the file could not be read
    inline, block = _on_block(decode(blob))
    if inline is None:
        return [TRIGGER_UNREADABLE]
    if _PULL_REQUEST.search("\n".join([inline, *block])):
        return []
    return [BAD_TRIGGER]


def _name_findings(blob):
    if blob is None:
        return [PLAN_UNREADABLE]
    kind, value = plan_name(decode(blob))
    if kind == "block":
        return [NAME_UNREADABLE]
    if kind == "absent":
        return [
            (
                BROKEN,
                f"`{PLAN_PATH}` has no top-level `name:`, so GitHub names the "
                f"workflow after its path — the consumer `workflow_run` trigger "
                f"matches on the name `{PLAN_NAME}` and can never fire. Add "
                f"`name: {PLAN_NAME}`.",
            )
        ]
    if value == PLAN_NAME:
        return []
    return [
        (
            BROKEN,
            f"`{PLAN_PATH}` is named {ascii(value)}, not `{PLAN_NAME}` "
            f"({ascii(PLAN_NAME)}) — the separator is U+00B7 MIDDLE DOT and a "
            "look-alike renders identically. GitHub matches the `workflow_run` "
            "trigger against the workflow name recorded on the DEFAULT BRANCH, "
            "so this pull request still gets its gate and the breakage begins at "
            "merge; a pull request opened afterwards to fix it has no gate "
            "either, and needs an administrator to merge it.",
        )
    ]


def _wiring_findings(files, engine_repo):
    readable = [v for v in files.values() if v is not None]
    states = [_wiring_state(decode(v), engine_repo) for v in readable]
    if "present" in states:
        return []
    # An unreadable file might have been the one that wired it, so an
    # incomplete read can only ever say "not verified".
    if len(readable) != len(files):
        return [WIRING_UNREADABLE]
    if "indirect" in states:
        return [WIRING_INDIRECT]
    if "escaped" in states:
        return [WIRING_ESCAPED]
    return [NO_WIRING]


def findings(files, engine_repo):
    """Wiring findings for a `.github/workflows` directory.

    `files` maps each `.yml`/`.yaml` base filename to its bytes; `None` for one
    entry means that file could not be read, and `None` for the whole argument
    means the listing could not be read. An empty list means the wiring is good.
    """
    if files is None:
        return [LISTING_UNREADABLE]
    out = []
    if PLAN_FILE not in files:
        out.append(BAD_PATH)
    else:
        out.extend(_name_findings(files[PLAN_FILE]))
        out.extend(_trigger_findings(files[PLAN_FILE]))
    out.extend(_wiring_findings(files, engine_repo))
    return out
