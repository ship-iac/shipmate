#!/usr/bin/env python3
"""Reconcile one consumer repository to shipmate's per-repository setup.

    python <engine>/scripts/onboard --app-id <id> \
        [--key shipmate-app.private-key.pem] \
        [--dry-run]

Hand-run from inside the consumer checkout, with `gh` authenticated against that
repository. It reads what is already there and
creates or updates only what differs, so a second run over a configured
repository changes nothing.

Flags:

  --app-id        the shipmate App's numeric id.
  --key           path to the App's PEM private key (its text, not the path,
                  is what gets stored). Needed only while `shipmate-engine`
                  holds no SHIPMATE_APP_PRIVATE_KEY; without it such a run
                  refuses before its first write.
  --dry-run       report `would <verb>` for every change and run no write.

Exit codes: 0 clean, 2 at least one item differs, 1 a refusal or a failed
write. `argparse` also exits 2 on a usage error, so a wrapper branching on 2
must distinguish the two by output, or validate its own arguments first.

Environments are derived, never passed in: the union of the repository's own
Terramate env/* tags and the `environments` entries of the checkout's
`.github/shipmate.toml`. Those bound as
one bare `<env>` instead of the `<env>-plan` / `<env>-apply` pair are the entries
holding `shared = true` in the checkout's `.github/shipmate.toml`.

The closing checklist also reads the whole Terramate tree: stacks carrying no env/*
tag, the tag refusals a plan would raise (two workload/* tags on one stack, two stack
paths sharing one plan artifact name, a workload tag its environment's `workloads` list
does not name), listed workloads no stack tags, and `needs` naming an environment that is
neither an entry nor tagged. It reads the working tree's `.github/workflows/` too: each
file calling the engine's `drift.yml` has its `tags` query run against the tree as a drift
run's detect does, naming cells no sweep covers, a clause or query matching no cell, and a
sweep that run refuses. Each is a checklist item; none changes the exit code.
"""

import argparse
import contextlib
import io
import json
import pathlib
import re
import sys
import textwrap
import urllib.parse

from _shipmate import APP_ID_VAR, ENGINE_ENV, REPO_RE, _load, gate_check, review_count, utf8_output
from _shipmate import APP_KEY_NAME as _APP_KEY_NAME
from _shipmate import approval_rules as _approval_rules
from _shipmate import run as _run

ec = _load("env-config")
bm = _load("build-matrix")
dr = _load("doctor")

GATE = dr.GATE
REPORT = []
_DRY = False

#: Environment names are interpolated into API paths and `gh --env` arguments.
_ENV_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
_VERSION_RE = re.compile(r"v[0-9]+\.[0-9]+\.[0-9]+")
_APP_ID_RE = re.compile(r"[0-9]+")
#: The default branch is rendered unquoted into a YAML flow list and a GitHub branch filter:
#: a leading letter forecloses a number-like `1.0`, and the set forecloses `,` `{` `&` and
#: the filter's `+` `!` `*` `?` `[`.
_BRANCH_RE = re.compile(r"[A-Za-z][A-Za-z0-9._/-]*")


def _gh_json(path):
    return ec.gh_json(path, _run)


def _gh_json_or_none(path):
    """Parsed `gh api <path>`, or None when `gh` answers 404.

    Only a 404 is absence. Every other failure -- an expired token, a dropped
    network, a 403 for a permission the token lacks -- re-raises, because a
    caller reading "absent" from one of those does not merely skip a create: a
    plan environment whose read failed takes the create branch and is PUT with a
    null `deployment_branch_policy`, silently removing a policy the consumer set.
    `_run` puts gh's scrubbed stderr in the message, so the status is there to match.
    """
    try:
        return _gh_json(path)
    except SystemExit as e:
        if "HTTP 404" not in str(e):
            raise
        return None


def report(verb, subject, detail=""):
    REPORT.append((verb, subject, detail))
    print(f"{verb} {subject}" + (f": {detail}" if detail else ""))


def write(verb, subject, args, stdin=None, detail="", secrets=()):
    """Perform one write, or report it as pending under --dry-run.

    `secrets` reaches `_run` unchanged: a write that carries a credential must
    go through here, not around it, or --dry-run stops being read-only.
    """
    if _DRY:
        report(f"would {verb}", subject, detail)
        return
    _run(args, secrets=secrets, stdin=stdin)
    report(verb, subject, detail)


def write_file(path, text, subject):
    """Create one file, or report it as pending under --dry-run.

    A file write is not a `gh` argv, so it cannot go through `write`; it honours
    `_DRY` here instead, because a --dry-run that writes into a consumer checkout
    is not a dry run.
    """
    if _DRY:
        report("would create", subject)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8", newline="\n")
    report("created", subject)


def _env_membership():
    """Terramate env membership for this checkout. Its own function so tests can
    replace it without a terramate binary on PATH."""
    return bm.env_membership(all_stacks=True)


def _derive_envs(names):
    bad = sorted(e for e in names if not _ENV_RE.fullmatch(e))
    if bad:
        raise SystemExit(f"::error::unusable environment name(s): {', '.join(bad)}")
    return sorted(names)


def _repo_root():
    """The consumer checkout's root.

    Not `cwd`: `gh repo view` resolves the same repository from any subdirectory and
    `terramate list` still enumerates every stack, so a run from `stacks/` would report six
    files created under `stacks/.github/workflows/`, where GitHub never looks.
    """
    return pathlib.Path(_run(["git", "rev-parse", "--show-toplevel"]).strip())


def _repo_facts():
    facts = json.loads(
        _run(["gh", "repo", "view", "--json", "nameWithOwner,defaultBranchRef,isPrivate"])
    )
    slug = facts.get("nameWithOwner") or ""
    branch = (facts.get("defaultBranchRef") or {}).get("name") or ""
    if not slug or not branch:
        raise SystemExit(
            "`gh repo view` returned no repository slug or no default branch. Run this from "
            "inside the consumer checkout, with `gh` authenticated against it."
        )
    if not REPO_RE.fullmatch(slug):
        raise SystemExit(f"unusable repository slug: {slug!r}")
    if not _BRANCH_RE.fullmatch(branch):
        raise SystemExit(
            f"the default branch {branch!r} cannot be written unquoted into the workflow "
            "file's `push: branches:` filter, so this script does not onboard it. Follow "
            "docs/getting-started.md by hand and edit `branches:` to match the branch."
        )
    return slug, branch, bool(facts.get("isPrivate"))


def _engine_pin(engine):
    """(sha, version) for the engine checkout `engine` is sitting on."""
    sha = _run(["git", "-C", str(engine), "rev-parse", "HEAD"]).strip()
    tags = _run(["git", "-C", str(engine), "tag", "--points-at", "HEAD"]).split()
    version = next((t for t in tags if _VERSION_RE.fullmatch(t)), "")
    if not version:
        raise SystemExit(
            f"the engine checkout at {engine} is on {sha[:7]}, which carries no vX.Y.Z tag. "
            "Pinning a consumer to a commit with no release is what doctor's pin probe reports "
            "as staleness, and it then tells the consumer to re-pin backwards. Check out a "
            "release tag, or cut one first (docs/releasing.md)."
        )
    return sha, version


def _read_key(path):
    path = pathlib.Path(path)
    if not path.is_file():
        raise SystemExit(f"--key: {path} does not exist.")
    pem = path.read_text(encoding="utf-8")
    if not pem.strip():
        raise SystemExit(f"--key: {path} is empty.")
    return pem


def _resolve_shared(root, repo, variables):
    """(table, shared): the checkout's validated `.github/shipmate.toml` and the
    environments it marks `shared = true`.

    No file gives `(None, set())`. A file holding a `{ vars = "NAME" }` reference
    resolves it from the repository `variables` over the organization variables reaching
    `repo`, GitHub's precedence; a file without one makes no API call. The table is
    structurally validated first, because `shared_envs` trusts its shape, and this runs
    before the first write.
    """
    path = root / ec.CONFIG_PATH
    if not path.is_file():
        return None, set()
    text = path.read_text(encoding="utf-8")
    table = ec.load_toml(text)
    refs = ec.references(table)
    if refs:
        key, var = refs[0]
        reaching = _reaching_variables(
            repo,
            f"{ec.CONFIG_PATH} {key} references GitHub variable {var}, and onboard "
            "resolves a reference from these variables and the repository's.",
        )
        table = ec.parse_table(text, {**reaching, **variables})
    ec.validate_structure(table)
    return table, ec.shared_envs(table)


def _variables():
    # The API returns variable names uppercased, so every lookup here is on an uppercased key.
    listed = json.loads(_run(["gh", "variable", "list", "--json", "name,value"]))
    return {v["name"].upper(): v["value"] for v in listed}


#: An apply environment -- and `shipmate-engine`, which is one -- is scoped to the
#: default branch alone. A PUT naming only this key is additive: an environment
#: carrying reviewers, `prevent_self_review` or a `wait_timer` keeps all three.
_APPLY_BODY = {
    "deployment_branch_policy": {"protected_branches": False, "custom_branch_policies": True}
}
#: A plan environment takes no branch policy: plan cells evaluate at the pull request's
#: base ref, so a policy blocks every cell whose pull request targets a branch it does
#: not name (docs/hardening.md row 8).
_PLAN_BODY = {"deployment_branch_policy": None}


def _ensure_policy(ctx, name):
    """Scope `name` to the default branch alone: POST it when missing, report any other.

    Additive only. Extra names are drift -- `doctor` warns that a workflow on one of
    them can still claim what the environment scopes -- but removing a policy entry the
    consumer added is not this script's call, so they are named, not deleted.
    """
    path = f"repos/{ctx['repo']}/environments/{name}/deployment-branch-policies"
    policies = _gh_json_or_none(path)
    branch = ctx["default_branch"]
    names = {p.get("name") for p in (policies or {}).get("branch_policies", [])}
    subject = f"{name} branch policy"
    if branch in names:
        report("ok", subject, branch)
    else:
        write(
            "create",
            subject,
            ["gh", "api", "-X", "POST", path, "-f", f"name={branch}"],
            detail=branch,
        )
    extra = sorted(n for n in names if n and n != branch)
    if extra:
        report(
            "differs",
            subject,
            f"also permits {', '.join(extra)}: a workflow on those branches can still "
            f"claim what `{name}` scopes. Remove them by hand if that is not intended.",
        )


def _plan_drift(env):
    """What disqualifies `env` as a plan environment, as one sentence, or ""."""
    reasons = []
    if env.get("deployment_branch_policy"):
        reasons.append(
            "it carries a deployment branch policy, which blocks every plan cell whose "
            "pull request targets a branch the policy does not name"
        )
    rules = _approval_rules(env)
    if rules:
        reasons.append(f"it carries protection rules ({', '.join(rules)}), which stall plan cells")
    if not reasons:
        return ""
    return (
        f"{' and '.join(reasons)}. Removing a protection a consumer set is not this "
        "script's call, so it is reported and left alone."
    )


def _report_shared_approval(ctx, name, env):
    """Report approval rules on a shared bare environment.

    `_env_names` collapses a shared env to one apply-role environment, but a protection
    rule there is not the reviewer gate the split naming gives an apply environment: the
    plan cells and every drift sweep covering it bind the same environment and GitHub offers no
    per-job filter, so they stall too. `doctor` warns on it; reported here, never stripped.
    """
    approval = _approval_rules(env) if env is not None and name in ctx["shared"] else []
    if not approval:
        return
    report(
        "differs",
        name,
        f"it carries protection rules ({', '.join(approval)}) and is shared, so the plan "
        "cells and every drift sweep covering it do not start immediately either. To gate applies "
        f"alone, split it into `{name}-plan` and `{name}-apply` and drop `shared = true` "
        f"from `[environments.{name}]`.",
    )


def _reconcile_env(ctx, name, role):
    """Create or repair one environment. `role` is "plan" or "apply"."""
    path = f"repos/{ctx['repo']}/environments/{name}"
    env = _gh_json_or_none(path)
    if role == "apply":
        ctx["apply_envs"][name] = env
    body = _APPLY_BODY if role == "apply" else _PLAN_BODY
    put = ["gh", "api", "-X", "PUT", path, "--input", "-"]
    if env is None:
        write("create", name, put, stdin=json.dumps(body))
    elif role == "plan":
        drift = _plan_drift(env)
        report("differs" if drift else "ok", name, drift)
    elif (env.get("deployment_branch_policy") or {}).get("custom_branch_policies"):
        report("ok", name)
    else:
        write("update", name, put, stdin=json.dumps(body))
    if role == "apply":
        _report_shared_approval(ctx, name, env)
        _ensure_policy(ctx, name)


def _engine_secrets(repo):
    """The secret names on `shipmate-engine`; none when the environment does not exist."""
    data = _gh_json_or_none(f"repos/{repo}/environments/{ENGINE_ENV}/secrets?per_page=100")
    return {s.get("name") for s in (data or {}).get("secrets", [])}


def _repo_secrets():
    return {s.get("name") for s in json.loads(_run(["gh", "secret", "list", "--json", "name"]))}


def _refuse_missing_key(ctx):
    """Refuse a run with no `--key` while `shipmate-engine` holds no App private key.

    Under `--dry-run` too: a `would set` with no key to set is a false report.
    """
    if ctx["key"] is None and _APP_KEY_NAME not in ctx["engine_secrets"]:
        raise SystemExit(
            f"{ENGINE_ENV} holds no {_APP_KEY_NAME}, so this run has no key to place there. "
            "Re-run with --key <path to the App's PEM private key>."
        )


def _reconcile_key(ctx):
    """Place the App key on `shipmate-engine`, and remove any repository-level copy.

    An existing environment copy is left alone: no REST path returns a secret's
    value, so overwriting could only destroy a working placement. Rotation is
    docs/github-app.md.
    """
    subject = f"{ENGINE_ENV} {_APP_KEY_NAME}"
    if _APP_KEY_NAME in ctx["engine_secrets"]:
        report("ok", subject)
    else:
        write(
            "set",
            subject,
            ["gh", "secret", "set", _APP_KEY_NAME, "--env", ENGINE_ENV],
            stdin=ctx["key"],
            secrets=(ctx["key"],),
        )
    if _APP_KEY_NAME not in ctx["repo_secrets"]:
        report("ok", f"no repository-level {_APP_KEY_NAME}")
        return
    write(
        "delete",
        f"repository secret {_APP_KEY_NAME}",
        ["gh", "secret", "delete", _APP_KEY_NAME],
        detail="a repository secret is readable by a workflow on any branch",
    )


def _env_names(env, shared):
    """[(environment name, role)] for one derived environment; a shared one is reconciled
    as an apply environment."""
    names = ec.env_names(env, shared)
    return [(name, "apply" if role == "shared" else role) for name, role in names]


def _unused_naming(env, shared):
    """The environment names for the naming this repository does *not* bind: `env_names`
    under the opposite `shared` setting."""
    unused = set() if env in shared else {env}
    return [name for name, _role in ec.env_names(env, unused)]


def _naming_conflict(ctx, env):
    """True when the naming this repository does not bind already exists for `env`.

    Probed before the create, not only over what is already there: a check that fires
    only once both namings exist still lets a repository holding one of them get the
    other created here and be refused by the next run -- over environments this script
    itself wrote, falsifying "a second run changes nothing" and leaving the pair
    unreconcilable from then on.
    """
    base = f"repos/{ctx['repo']}/environments/"
    unused = [n for n in _unused_naming(env, ctx["shared"]) if _gh_json_or_none(f"{base}{n}")]
    if not unused:
        return False
    names = " and ".join(f"`{n}`" for n in unused)
    remedy = (
        f"drop `shared = true` from `[environments.{env}]`"
        if env in ctx["shared"]
        else f"set `shared = true` in `[environments.{env}]` so the engine binds the bare "
        f"`{env}` instead"
    )
    report(
        "differs",
        env,
        f"the engine binds {' / '.join(f'`{n}`' for n, _role in _env_names(env, ctx['shared']))} "
        f"for `{env}`, and {names} {'is' if len(unused) == 1 else 'are'} also present. Nothing "
        f"binds {names}, so nothing was created or changed for `{env}`. Delete {names}, or "
        f"{remedy}.",
    )
    return True


def _reconcile_envs(ctx):
    for env in ctx["envs"]:
        if _naming_conflict(ctx, env):
            ctx["unresolved"].add(env)
            continue
        for name, role in _env_names(env, ctx["shared"]):
            _reconcile_env(ctx, name, role)


def _reaching_variables(repo, remedy):
    """{NAME: value} for the organization variables that reach `repo`.

    A failed read refuses with the permission hint followed by `remedy`, the caller's
    own sentence on why the read ran.

    GitHub applies each variable's visibility policy to this endpoint, so a
    variable missing here does not reach this repository and contributes nothing
    to what the workflows resolve -- which is the only question worth asking.
    The response carries no visibility field, so why it is missing is not knowable.
    """
    try:
        pages = json.loads(
            _run(
                [
                    "gh",
                    "api",
                    f"repos/{repo}/actions/organization-variables",
                    "--paginate",
                    "--slurp",
                ]
            )
        )
    except SystemExit as exc:
        # gh's stderr rides along in `exc`, so a failure that is not a permission
        # problem still shows its real cause under the hint.
        raise SystemExit(
            f"could not read the organization variables reaching {repo}: {exc}\n"
            "A fine-grained token needs this repository's Variables read permission, and "
            f"`--slurp` needs a recent `gh`. {remedy}"
        ) from exc
    return {
        var["name"].upper(): var["value"] for page in pages for var in page.get("variables", [])
    }


def _reconcile_variables(ctx):
    """Set APP_ID_VAR, the repository variable the workflows read.

    An existing value always equals --app-id here: `_refuse_diverging_app_id` refuses any
    other before the first reconciler.
    """
    value = ctx["app_id"]
    if APP_ID_VAR in ctx["variables"]:
        report("ok", APP_ID_VAR, value)
        return
    write("set", APP_ID_VAR, ["gh", "variable", "set", APP_ID_VAR, "--body", value], detail=value)


def _ruleset_body(ctx):
    """A ruleset carrying the gate rule alone.

    `docs/branch-protection.md`'s `pull_request`, `non_fast_forward` and `deletion`
    rules stay a documented choice: a repository already carrying a ruleset with a
    `pull_request` rule must not get a conflicting second one.
    """
    return {
        "name": "shipmate-gate",
        "target": "branch",
        "enforcement": "active",
        "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
        "rules": [
            {
                "type": "required_status_checks",
                "parameters": {
                    "required_status_checks": [
                        {"context": GATE, "integration_id": int(ctx["app_id"])}
                    ],
                    "strict_required_status_checks_policy": True,
                },
            }
        ],
    }


_NAME_TAKEN = (
    "the rulesets POST was rejected (HTTP 422). Most likely a `shipmate-gate` ruleset "
    "already exists but requires nothing on this branch, because its enforcement is "
    "`evaluate` or `disabled` and the effective-rules read cannot see it. A 422 has other "
    "causes, so read `gh api repos/OWNER/REPO/rulesets` before acting. Set it to active, "
    "or delete it and run this again."
)

_PLAN_TIER = (
    "rulesets need GitHub Pro, Team, Enterprise, or a public repository "
    "(docs/branch-protection.md §Reproducible ruleset). Configure the gate by hand there."
)


def _gate_entry(ctx):
    """(the `shipmate / gate` status-check entry, its rule parameters, the review count),
    the first two None when no rule requires the gate.

    The effective rules across every ruleset, read the way `doctor`'s gate probe reads
    them -- including the assumption, inherited from it and not verified here, that this
    endpoint answers `[]` rather than 404 when the branch carries no rule. If that is
    wrong, a repository with no ruleset crashes here instead of reaching the report
    `_reconcile_ruleset` writes for one that cannot have rulesets at all.

    The review count is the highest `required_approving_review_count` over every
    `pull_request` rule in the same response, 0 when none.
    """
    branch = urllib.parse.quote(ctx["default_branch"], safe="")
    rules = _gh_json(f"repos/{ctx['repo']}/rules/branches/{branch}?per_page=100")
    return (*gate_check(rules, GATE), review_count(rules))


def _post_failure(e):
    """The report detail for a failed rulesets POST, or None when it must re-raise."""
    if "HTTP 422" in str(e):
        return _NAME_TAKEN
    if "HTTP 403" in str(e) or "HTTP 404" in str(e):
        return _PLAN_TIER
    return None


def _shim_on_default(repo, branch):
    """True when `.github/workflows/shipmate.yml` is on the remote default branch.

    A 404 reads as absent: the file is not there, or the token cannot see it. A 403 stops
    the run, which is why `main` reads this before the first write.
    """
    ref = urllib.parse.quote(branch, safe="")
    return (
        _gh_json_or_none(f"repos/{repo}/contents/.github/workflows/shipmate.yml?ref={ref}")
        is not None
    )


def _reconcile_ruleset(ctx):
    """Require `shipmate / gate`, pinned to the App, on the default branch.

    An entry under another `integration_id`, or without `strict`, is reported and left
    alone: editing a ruleset this script did not create is a policy change it must not
    make silently.

    The ruleset is wanted only once the workflow file is on the remote default branch:
    `pull_request_target` runs that branch's copy, so before it lands no pull request can
    produce the gate, and the one adding the file could not merge. A missing ruleset is
    deferred; one already required is reported.
    """
    subject = "gate ruleset"
    chk, params, ctx["review_count"] = _gate_entry(ctx)
    app_id = int(ctx["app_id"])
    branch = ctx["default_branch"]
    if chk is None and not ctx["shim_on_default"]:
        ctx["ruleset_deferred"] = True
        report(
            "deferred",
            subject,
            f"`.github/workflows/shipmate.yml` is not on {branch} yet, or this token cannot "
            "read it and GitHub answered 404. No pull request can produce "
            f"`{GATE}` before the file is there. Merge the pull request that adds it, then "
            "run this again to create the ruleset.",
        )
    elif chk is not None and not ctx["shim_on_default"]:
        report(
            "differs",
            subject,
            f"`{GATE}` is already required, but `.github/workflows/shipmate.yml` is not on "
            f"{branch} yet, or this token cannot read it and GitHub answered 404. The pull "
            "request adding the file cannot get the gate: disable the gate rule until it "
            "merges, or merge it through a bypass actor.",
        )
    elif chk is None:
        try:
            write(
                "create",
                subject,
                ["gh", "api", "-X", "POST", f"repos/{ctx['repo']}/rulesets", "--input", "-"],
                stdin=json.dumps(_ruleset_body(ctx)),
                detail=GATE,
            )
        except SystemExit as e:
            detail = _post_failure(e)
            if detail is None:
                raise
            report("differs", subject, detail)
    elif chk.get("integration_id") != app_id:
        report(
            "differs",
            subject,
            f"`{GATE}` is required under integration_id {chk.get('integration_id')!r}, not the "
            f"shipmate App ({app_id}), so a status from another identity satisfies it. "
            "Change it by hand.",
        )
    elif not params.get("strict_required_status_checks_policy"):
        report(
            "differs",
            subject,
            "it does not require branches to be up to date (strict), so plans can go "
            "stale against the base before merge. Change it by hand.",
        )
    else:
        report("ok", subject)


#: `scripts/tests/test_docs_yaml_parses.py` imports this rather than keeping a second copy:
#: the workflow file is rendered from a fence that guard parses, and an indented fence must
#: be dedented rather than missed.
_FENCE = re.compile(r"^(?P<indent>[ \t]*)```yaml[ \t]*$\n(?P<body>.*?)^\1```", re.M | re.S)
ENGINE_SLUG = "ship-iac/shipmate"
_DOC_PIN = re.compile(
    rf"(?P<ref>{re.escape(ENGINE_SLUG)}/\.github/workflows/[^@\s]+)@<engine-sha>[^\S\n]*#[^\n]*"
)
#: Only a 40-hex pin, matching what the docs/releasing.md re-pin rewrites: a file still carrying
#: the docs placeholder must not be reported `pin-only`, because that names a remedy which would
#: then find no engine reference to move.
_ANY_PIN = re.compile(
    rf"(?P<ref>{re.escape(ENGINE_SLUG)}/\.github/workflows/[^@\s]+)@[0-9a-f]{{40}}[^\S\n]*(#[^\n]*)?"
)


def _fence(page_text, name):
    """The dedented body of the one ```yaml fence in `page_text` whose first line is
    `name: <name>`."""
    bodies = [
        body
        for m in _FENCE.finditer(page_text)
        for body in [textwrap.dedent(m.group("body"))]
        if body.partition("\n")[0] == f"name: {name}"
    ]
    if len(bodies) != 1:
        raise SystemExit(
            f"{len(bodies)} documented fences are named {name!r}; expected exactly one. "
            "The workflow file is rendered from the docs, so its fence name must agree."
        )
    return bodies[0]


def _render(engine, sha, version, default_branch):
    """The full text of one consumer workflow file, LF-delimited and newline-terminated,
    with its `push` trigger on `default_branch`."""
    text = _fence(
        (pathlib.Path(engine) / "docs" / "getting-started.md").read_text(encoding="utf-8"),
        "shipmate",
    )
    trigger = "    branches: [main]\n"
    if text.count(trigger) != 1:
        raise SystemExit(
            f"the documented shipmate fence holds {text.count(trigger)} `branches: [main]` "
            "lines; expected exactly one, the push trigger this script retargets."
        )
    text = text.replace(trigger, f"    branches: [{default_branch}]\n")
    return _DOC_PIN.sub(rf"\g<ref>@{sha} # {version}", text)


def _depin(text):
    """`text` with every engine pin and its trailing comment reduced to a placeholder."""
    return _ANY_PIN.sub(r"\g<ref>@<pin>", text)


def _reconcile_shim(ctx):
    """Write the consumer workflow file, reporting anything already there.

    `pin-only` is not drift: moving a pin is the re-pin procedure in docs/releasing.md, so
    it does not reach `_exit_code`.
    """
    filename = "shipmate.yml"
    path = pathlib.Path(ctx["root"]) / ".github" / "workflows" / filename
    text = _render(ctx["engine"], ctx["sha"], ctx["version"], ctx["default_branch"])
    if not path.is_file():
        write_file(path, text, filename)
        return
    # Universal-newline read: a CRLF checkout of an otherwise identical file is not drift.
    current = path.read_text(encoding="utf-8")
    if current == text:
        report("ok", filename)
    elif _depin(current) == _depin(text):
        report(
            "pin-only",
            filename,
            "move every engine ref to this engine's SHA in one commit (docs/releasing.md)",
        )
    elif "<engine-sha>" in current:
        report("differs", filename, "the published fence, never pinned: delete it and run again")
    else:
        report("differs", filename, "differs beyond its pin, not overwritten")


#: GitHub's own search order for the file.
_CODEOWNERS_PATHS = (".github/CODEOWNERS", "CODEOWNERS", "docs/CODEOWNERS")


def _passphrase_item(ctx):
    item = "SHIPMATE_PLAN_PASSPHRASE repository secret (optional)"
    if "SHIPMATE_PLAN_PASSPHRASE" in ctx["repo_secrets"]:
        return "ok", item, []
    return (
        "todo",
        item,
        [
            "gh secret set SHIPMATE_PLAN_PASSPHRASE",
            "An organization secret of that name is not visible to this read.",
        ],
    )


def _table_item(ctx):
    item = f"`{ec.CONFIG_PATH}`"
    if ctx["table"] is None:
        return (
            "todo",
            item,
            ["Add one: copy the example in docs/getting-started.md §Environments for this tier."],
        )
    try:
        ec.validate(ctx["table"], ctx["envs"])
    except SystemExit as e:
        return "todo", item, [ln.removeprefix("::error::") for ln in str(e).splitlines()]
    # Not env-config's unused-entry warning: it says to remove an entry that onboard asks the
    # consumer to declare before tagging, and removing it reopens the auto-created environment.
    lines = []
    untagged = [e for e in ctx["envs"] if e not in ctx["tagged"]]
    if len(untagged) == 1:
        lines = textwrap.wrap(
            f"Provisioned for {untagged[0]}, which no stack tags yet: its first tagging pull "
            "request deploys under that environment's protection. If the name is a typo, fix "
            "the entry.",
            width=80,
        )
    elif untagged:
        lines = textwrap.wrap(
            f"Provisioned for {', '.join(untagged)}, which no stack tags yet: the first pull "
            "request tagging a stack into each deploys under that environment's protection. If "
            "a name is a typo, fix the entry.",
            width=80,
        )
    # A declared, untagged predecessor is the provisioned-ahead order named above; only a
    # name that is neither an entry nor tagged orders nothing while reading as ordering.
    stale = ec.stale_needs(ctx["table"], set(ctx["tagged"]) | set(ctx["table"]["environments"]))
    if stale:
        lines += textwrap.wrap(
            f"`needs` names {', '.join(stale)}, which no entry declares and no stack tags, so "
            "it orders nothing. If a name is a typo, fix it.",
            width=80,
        )
    return ("todo" if stale else "ok"), item, lines


def _app_item(ctx):
    return (
        "cannot check",
        f"{ctx['repo']} in the App installation's repository selection",
        [
            f"Reading `repos/{ctx['repo']}/installation` needs an App JWT, which this run",
            "does not hold. Check it, or add the repository, at",
            f"https://github.com/organizations/{ctx['repo'].split('/')[0]}/settings/installations",
            "under the App's `Configure` button, in `Repository access`.",
            "The add-repository endpoint accepts PAT-classic tokens only, so it stays a UI step.",
        ],
    )


def _reviewed(env):
    """True when `env` requires a named reviewer and prevents self-review."""
    return env is not None and any(
        r.get("type") == "required_reviewers"
        and r.get("reviewers")
        and r.get("prevent_self_review") is True
        for r in env.get("protection_rules") or []
    )


def _review_item(ctx, names, shared=()):
    """`ok` when a `pull_request` rule on the default branch requires an approving review,
    or when every environment in `names` is reviewed and `shared`, the gated shared
    environments, is empty: a shared environment has no `<env>-apply` to carry reviewers,
    so that rule is its only apply gate. `apply_envs` holds `None` for an environment a dry
    run would create, and that is not reviewed."""
    item = "approving review before apply"
    if ctx["review_count"] >= 1:
        rule = (
            f"`required_approving_review_count` is {ctx['review_count']} on the default "
            "branch's `pull_request` rule."
        )
        return "ok", item, [rule] if shared else []
    missing = [n for n in names if not _reviewed(ctx["apply_envs"].get(n))]
    if not missing and not shared:
        return "ok", item, []
    lines = []
    if missing:
        lines.append(f"Required reviewers and `Prevent self-review` on {', '.join(missing)}")
        if not ctx["is_private"]:
            lines.append("(docs/getting-started.md §Environment setup).")
        else:
            lines += [
                "(docs/getting-started.md §Environment setup). On a private repository below",
                "Enterprise, GitHub refuses required reviewers, so the apply gate is then an",
                "approving-review `pull_request` rule on the default branch, which this script",
                "does not create (docs/branch-protection.md §Reproducible ruleset).",
            ]
    if shared:
        lines += [
            f"Shared, so no `<env>-apply` carries required reviewers: {', '.join(shared)}.",
            "Their apply gate is an approving-review `pull_request` rule on the default",
            "branch, which this script does not create (docs/branch-protection.md",
            "§Reproducible ruleset).",
        ]
    return "todo", item, lines


def _codeowners_item(ctx):
    item = "CODEOWNERS entry covering /.github/workflows/"
    found = [p for p in _CODEOWNERS_PATHS if (pathlib.Path(ctx["root"]) / p).is_file()]
    if not found:
        return "todo", item, [f"Add one in `{_CODEOWNERS_PATHS[0]}`."]
    return (
        "cannot check",
        item,
        [f"`{found[0]}` exists. Which paths it covers is GitHub's matching, not this run's."],
    )


def _cache_written(lock):
    """True when a `provider` block of the lock text carries no `zh:` hash. A registry read
    records `zh:` for every provider; a `tofu init` through a plugin cache or a mirror
    records only the local platform's `h1:`, and nothing here can tell which `h1:` is
    `linux_amd64`'s, so a block without `zh:` is the observable signature."""
    return any('"zh:' not in block for block in lock.split('provider "')[1:])


def _stack_list(stacks):
    lines = [f"  {s}" for s in stacks[:10]]
    if len(stacks) > 10:
        lines.append(f"  and {len(stacks) - 10} more")
    return lines


def _lock_files_item(ctx):
    """`ok` when every stack has a git-tracked `.terraform.lock.hcl`, the only lock the
    provider cache keys on, and no tracked lock on disk was written through a plugin cache
    (`_cache_written`). Tracked, not present on disk: any local `tofu init` writes the file,
    gitignored or not; a tracked lock absent from the working tree gets no content verdict.
    `ctx["stacks"]` and the paths named here are relative to the working directory, as
    `terramate list` printed them; `git ls-files` prints the same form. One fixed pathspec
    keeps the argv under Windows' command-line limit at any stack count.
    """
    item = "Provider lock files"
    stacks = sorted(ctx["stacks"])
    tracked = set()
    if stacks:
        out = _run(["git", "ls-files", "-z", "--", ":(top)*.terraform.lock.hcl"])
        tracked = set(out.split("\0"))
    missing, cached = [], []
    for s in stacks:
        path = pathlib.PurePosixPath(s) / ".terraform.lock.hcl"
        if path.as_posix() not in tracked:
            missing.append(s)
        elif (lock := pathlib.Path(path)).is_file() and _cache_written(
            lock.read_text(encoding="utf-8")
        ):
            cached.append(s)
    if not missing and not cached:
        return "ok", item, []
    lines = []
    if missing:
        lines += [
            f"{len(missing)} of {len(stacks)} stack(s) have no git-tracked `.terraform.lock.hcl`,",
            "so the provider cache serves none of them. Remove any `.gitignore` entry for the",
            "file first, since git refuses to add an ignored path:",
            *_stack_list(missing),
        ]
    if cached:
        lines += [
            f"{len(cached)} of {len(stacks)} stack(s) track a `.terraform.lock.hcl` without the",
            "registry's `zh:` hashes, as a `tofu init` through a plugin cache writes it, so",
            "the runner's provider cache cannot use it:",
            *_stack_list(cached),
        ]
    lines += [
        "In each, run `tofu init -backend=false`, then",
        "`tofu providers lock -platform=linux_amd64`, and commit the file.",
    ]
    return "todo", item, lines


def _unmanaged_item(ctx):
    item = "unmanaged stacks"
    unmanaged = bm.unmanaged_stacks(ctx["tags_by_stack"])
    if not unmanaged:
        return "ok", item, []
    return (
        "todo",
        item,
        [
            f"{len(unmanaged)} stack(s) carry no `env/*` tag:",
            *_stack_list(unmanaged),
            "shipmate runs no stack without an `env/*` tag. A stack kept out on purpose",
            "needs nothing.",
        ],
    )


def _stack_tags_item(ctx):
    """The stack-tag refusals a plan would raise over the whole tree, and each entry's
    listed workloads no stack in it tags. `ctx["cells"]` is None when a slug collision lost
    the tree, and the table checks are skipped when there is no table."""
    item = "stack tags"
    errors = list(ctx["tree_errors"])
    table = ctx["table"]
    if table is not None and ctx["cells"] is not None:
        with ec._gather(errors):
            bm.refuse_workload_gaps(ctx["cells"], table)
    lines = [e.removeprefix("::error::") for e in errors]
    if table is not None:
        for env, names in ec.untagged_workloads(table, ctx["tagged"]):
            lines += textwrap.wrap(
                f"`environments.{env}.workloads` lists {', '.join(names)}, which no stack in "
                f"{env} tags. Tag a stack with each, or remove it from the list.",
                width=80,
            )
    return ("todo" if lines else "ok"), item, lines


def _adoption_item(ctx):
    item = "adoption pull request"
    if ctx["shim_on_default"]:
        return "ok", item, []
    verb = "Re-run without --dry-run, then commit" if _DRY else "Commit"
    return (
        "todo",
        item,
        [
            f"{verb} the workflow file and the table together,",
            "in a pull request that changes no stack. The table is read from the default",
            "branch, so the first plan needs it merged.",
        ],
    )


_NO_DRIFT_FILE = [
    "Add one workflow file per drift sweep from the `shipmate drift` fence in",
    "docs/getting-started.md, under any name in `.github/workflows/`, with the same",
    "pin as `shipmate.yml`. Without one, no stack is checked for drift (docs/drift.md).",
]

#: A `tags:` key at the start of a line (block form) or after `{` or `,` (flow form).
_TAGS_KEY = re.compile(r"""(?:^[ \t]*|(?P<flow>[{,])[ \t]*)["']?tags["']?[ \t]*:""", re.M)


def _tags_value(rest, flow):
    """The value written after one `tags:` key (`rest`, the stripped remainder of its line),
    or None when it starts on a later line: empty, or a `>`/`|` block scalar."""
    if rest[:1] in ("'", '"'):
        return rest[1:].partition(rest[0])[0]
    if flow:
        return re.split(r"[,}]", rest, maxsplit=1)[0].rstrip()
    if not rest or rest[0] in ">|":
        return None
    return rest


def _drift_query(region):
    """(the `tags` query of the drift job `region`, "") or (None, why it cannot be read).
    `region` is None when the selector matched a call `_call_region` cannot find line by line.

    No key is "", which sweeps every cell. A block value runs to the end of the line, so
    `env/a,env/b` is one OR query; a flow value stops at `,` or `}` unless quoted. A value on
    a later line or a flow mapping split across lines is unread, never "".
    """
    if region is None:
        return None, "its `uses:` value starts on a later line, which this reader does not follow"
    if any(line.count("{") > line.count("}") for line in region.splitlines()):
        return (
            None,
            "its drift job splits a flow mapping across lines, which this reader does not follow",
        )
    values = [
        _tags_value(region[m.end() :].partition("\n")[0].strip(), m["flow"])
        for m in _TAGS_KEY.finditer(region)
    ]
    if None in values:
        return None, "its `tags` value is not on the key's line, which this reader does not follow"
    if len(values) > 1:
        return None, "its drift job sets `tags` more than once"
    if values and "${{" in values[0]:
        return None, "its `tags` is a `${{ }}` expression, which only a run resolves"
    return (values[0] if values else ""), ""


def _drift_file(path, call):
    """`_drift_files`' entry for one workflow file, or None when it is no drift file."""
    try:
        if not path.is_file():
            return None
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return path.name, None, "it is not UTF-8 text, so it was not read"
    except OSError as exc:
        return path.name, None, f"it could not be read: {exc}"
    calls = len(list(call.finditer(dr._stripped_text(text))))
    if calls > 1:
        return path.name, None, "it calls `drift.yml` more than once"
    if calls:
        return path.name, *_drift_query(dr._call_region(text, call))
    return None


def _drift_files(root):
    """[(file name, `tags` query or None, why None)] for each `.yml`/`.yaml` file in the
    working tree's `.github/workflows/` whose comment-stripped text calls the engine's
    `drift.yml`, by doctor's own selector, so the two cannot disagree on what a drift file is.
    The query is read from the calling job alone (`_call_region`). A file that cannot be
    read, or calls `drift.yml` more than once, is listed with None; so is the directory when
    it cannot be listed."""
    workflows = pathlib.Path(root) / ".github" / "workflows"
    call = dr._engine_call(ENGINE_SLUG, "drift.yml")
    # Python 3.11-3.13 re-raise a `stat` PermissionError from `is_dir`/`is_file`.
    try:
        if not workflows.is_dir():
            return []
        paths = sorted(workflows.iterdir())
    except OSError as exc:
        return [(".github/workflows/", None, f"it could not be listed: {exc}")]
    found = [_drift_file(path, call) for path in paths if path.suffix in (".yml", ".yaml")]
    return [entry for entry in found if entry is not None]


def _coverage_blockers(ctx, files):
    """Why coverage cannot be computed, one indented line each; [] when it can."""
    why = [f"  {name}: {reason}." for name, query, reason in files if query is None]
    if ctx["cells"] is None:
        why.append("  a slug collision loses the tree; see `stack tags`.")
    elif ctx["tree_errors"]:
        why.append("  a stack with two `workload/*` tags has its cells dropped; see `stack tags`.")
    if ctx["table"] is None:
        why.append(
            f"  `{ec.CONFIG_PATH}` is absent, and a drift run refuses without it; see its item."
        )
    else:
        try:
            ec.validate(ctx["table"], ctx["envs"])
        except SystemExit:
            why.append(f"  `{ec.CONFIG_PATH}` fails validation; see its item.")
    return why


def _sweep(ctx, name, query):
    """(the lines one drift file's sweep reports, the (stack, env) cells it runs): the calls a
    drift run's detect makes, a refusal by any of them running no cell."""
    errors, notices, swept = [], io.StringIO(), set()
    with ec._gather(errors), contextlib.redirect_stdout(notices):
        kept = bm.filter_cells(ctx["cells"], ctx["tags_by_stack"], query)
        bm.cap_cells(kept, True)
        bm.refuse_workload_gaps(bm.stamp_rows(kept, ctx["table"], "plan"), ctx["table"])
        # Assigned last: a refusal above leaves the sweep running no cell.
        swept = {(c["stack"], c["environment"]) for c in kept}
    found = [n.removeprefix("::notice::") for n in notices.getvalue().splitlines()]
    return [f"{name}: {m.removeprefix('::error::')}" for m in [*found, *errors]], swept


def _drift_sweeps_item(ctx):
    """Each drift file's `tags` query run over the whole tree through `filter_cells` and
    `cap_cells`, then `stamp_rows` and `refuse_workload_gaps` (`_sweep`). Their notices and
    refusals are listed, then the cells no file sweeps; a refused sweep covers none. Coverage
    is computed only when every query was read, the tree is whole and the table is present
    and validates: a drift run refuses without one."""
    item = "drift sweeps"
    files = _drift_files(ctx["root"])
    if not files:
        return "todo", item, _NO_DRIFT_FILE
    read = (
        f"Read {', '.join(name for name, _q, _r in files)} in this working tree; a drift run "
        "reads the default branch's copy."
    )
    why = _coverage_blockers(ctx, files)
    if why:
        return "cannot check", item, ["Coverage was not computed:", *why, read]
    lines, covered = [], set()
    for name, query, _reason in files:
        found, swept = _sweep(ctx, name, query)
        lines += found
        covered |= swept
    uncovered = [
        f"{c['stack']} ({c['environment']})"
        for c in ctx["cells"]
        if (c["stack"], c["environment"]) not in covered
    ]
    if uncovered:
        lines += [
            f"{len(uncovered)} cell(s) no drift file sweeps:",
            *_stack_list(uncovered),
            "Widen a `tags` query, or add a drift file for them.",
        ]
    return ("todo" if lines else "ok"), item, [*lines, read]


_RULESET_ITEM = (
    "todo",
    "gate ruleset",
    [
        "Merge the adoption pull request: no ruleset requires `shipmate / gate` yet, because",
        "the workflows that produce it are not on the default branch (CONTRACT.md",
        "§Post-plan topology). Then run this script again to create the gate ruleset.",
    ],
)


def _checklist(ctx):
    """Print each value and step this script cannot supply, marked `ok`, `todo` or
    `cannot check` from what this run read. Only a `todo` carries a command or template.

    The verdicts never reach `_exit_code`: every item is the consumer's to do, so a first
    run exits 0 over them.
    """
    # A reviewer on a shared env's bare environment stalls the plan cells and the drift
    # sweeps covering it, so it is asked for only where the apply path has an environment
    # of its own.
    ungated = ec.ungated_envs(ctx["table"] or {})
    gated = [env for env in ctx["envs"] if env not in ctx["unresolved"] and env not in ungated]
    reviewed = [
        name
        for env in gated
        if env not in ctx["shared"]
        for name, role in _env_names(env, ctx["shared"])
        if role == "apply"
    ]
    items = [_passphrase_item(ctx), _table_item(ctx)]
    items.append(_app_item(ctx))
    if gated:
        items.append(_review_item(ctx, reviewed, [e for e in gated if e in ctx["shared"]]))
    items += [
        _codeowners_item(ctx),
        _lock_files_item(ctx),
        _unmanaged_item(ctx),
        _stack_tags_item(ctx),
        _drift_sweeps_item(ctx),
        _adoption_item(ctx),
    ]
    if ctx["ruleset_deferred"]:
        items.append(_RULESET_ITEM)
    out = ["", "Still yours, each item marked from what this run read:", ""]
    for verdict, item, details in items:
        out.append(f"{verdict:<12}  {item}")
        out += [f"    {line}" if line else "" for line in details]
        if details:
            out.append("")
    print("\n".join(out).rstrip("\n"))


def _refuse_diverging_app_id(app_id, variables):
    """Refuse when APP_ID_VAR exists and disagrees with --app-id.

    Refused rather than reported, because `app_id` has three consumers: the workflows
    mint their token from the variable, while `--app-id` pins the gate ruleset's
    `integration_id` and selects whose PEM goes on `shipmate-engine`. Reconciling those
    separately writes a required check no workflow can satisfy, and the default branch
    stays blocked until an admin deletes the ruleset. Called before the first
    reconciler, while failing is still free.
    """
    current = variables.get(APP_ID_VAR)
    if current is None or current == app_id:
        return
    raise SystemExit(
        f"the {APP_ID_VAR} repository variable is {current} and --app-id is {app_id}. "
        "The workflows mint their token from the variable, so a gate ruleset pinned to "
        f"{app_id} could never be satisfied and the default branch would be blocked. "
        f"Re-run with --app-id {current}, or change the variable first."
    )


def _exit_code():
    """2 when anything differs, else 0.

    Exactly `differs`, never a substring or a not-`would` test: each reconciler
    names its own verbs, and a verb that merely contains the word is not drift.
    """
    return 2 if any(verb == "differs" for verb, _subject, _detail in REPORT) else 0


def main(argv=None):
    global _DRY
    ap = argparse.ArgumentParser(description="Reconcile a consumer repository to shipmate.")
    ap.add_argument("--app-id", required=True, help="the shipmate App's numeric id")
    ap.add_argument(
        "--key",
        default=None,
        help="path to the App's PEM private key; needed only while shipmate-engine holds none",
    )
    ap.add_argument("--dry-run", action="store_true", help="report changes, write nothing")
    args = ap.parse_args(argv)
    if not _APP_ID_RE.fullmatch(args.app_id):
        raise SystemExit(f"--app-id must be all digits: {args.app_id!r}")
    _DRY = args.dry_run

    # The local reads first: a bad key path or an unreadable engine pin must fail in under
    # a second, before the first API call creates anything.
    key = _read_key(args.key) if args.key is not None else None
    engine = pathlib.Path(__file__).resolve().parents[1]
    sha, version = _engine_pin(engine)
    root = _repo_root()
    repo, default_branch, is_private = _repo_facts()
    stacks_by_env, tags_by_stack = _env_membership()
    variables = _variables()
    _refuse_diverging_app_id(args.app_id, variables)
    table, shared = _resolve_shared(root, repo, variables)
    # Table entries no stack tags yet are provisioned too: the first pull request tagging a
    # stack into one deploys on merge, into an `<env>-apply` GitHub would otherwise auto-create.
    envs = _derive_envs(set(stacks_by_env) | set((table or {}).get("environments", {})))
    ctx = {
        "repo": repo,
        "default_branch": default_branch,
        "app_id": args.app_id,
        "key": key,
        "envs": envs,
        "stacks": sorted({s for stacks in stacks_by_env.values() for s in stacks}),
        "table": table,
        "shared": shared,
        "unresolved": set(),
        "root": root,
        "engine": engine,
        "variables": variables,
        "sha": sha,
        "version": version,
        "is_private": is_private,
        # Read before the first write: a token without Contents read answers 403 here.
        "shim_on_default": _shim_on_default(repo, default_branch),
        "ruleset_deferred": False,
        "apply_envs": {},
        "review_count": 0,
        "tags_by_stack": tags_by_stack,
        "tagged": bm.tagged_workloads(stacks_by_env, tags_by_stack),
        "tree_errors": [],
        "cells": None,
    }
    # A slug collision raises after the per-stack collection, so on that path the tree is lost.
    with ec._gather(ctx["tree_errors"]):
        ctx["cells"] = bm.full_tree(
            sorted(stacks_by_env), stacks_by_env, tags_by_stack, ctx["tree_errors"]
        )
    # Read before the first write, so `_refuse_missing_key` refuses while nothing exists.
    ctx["engine_secrets"] = _engine_secrets(repo)
    ctx["repo_secrets"] = _repo_secrets()
    _refuse_missing_key(ctx)
    print(f"{ctx['repo']} (default branch {ctx['default_branch']})")
    print(f"environments: {', '.join(ctx['envs']) or '(none)'}")
    print(f"shared: {', '.join(sorted(ctx['shared'])) or '(none)'}")
    print(f"engine pin: {ctx['sha']} ({ctx['version']})")

    _reconcile_env(ctx, ENGINE_ENV, "apply")
    _reconcile_key(ctx)
    _reconcile_envs(ctx)
    _reconcile_variables(ctx)
    _reconcile_ruleset(ctx)
    _reconcile_shim(ctx)
    _checklist(ctx)

    sys.exit(_exit_code())


if __name__ == "__main__":
    utf8_output()
    main()
