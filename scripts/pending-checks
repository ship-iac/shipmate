#!/usr/bin/env python3
"""Emit `POST /check-runs` bodies (JSONL on stdout) for every planned cell.

The summary job creates ALL pending apply checks with ONE App installation
token, so the App private key never enters the plan matrix cells (they execute
PR-head code) and a 256-cell run mints one token, not 256. Changed cells get a
queued check titled with the plan's counts whose summary is the plan in a fence, cut to
`CHECK_OUTPUT_CAP` UTF-8 bytes with a link to this run's page; no-change cells a
completed/neutral "no changes" check. Each check's external_id is a JSON record of the
TF_VAR fingerprint, the id of the plan run that produced the cell, the number of the pull request it
planned, the sha256 of the plan text that run published, on either branch, and
`cells`, the number of cells that run planned, against which apply judges whether
the run published every check, and `action`, the plan run's event action (`""` when its
payload names none, as a `shipmate plan` dispatch's does), which the auto apply requires
to be a push's. That digest is computed here, over the whole
plan.txt this job downloaded, never copied from the cell: it is what binds the
reviewed text to the plan apply executes. The comment and the check embed capped prefixes of
the same file, so the digest covers at least what a reviewer saw and often more.
The check name uses the stack PATH so deploy-detect (which only has the path)
reconstructs it exactly. A missing pending check is not a quiet degradation: the pre-apply snapshot
refuses over it, and deploy-detect's work queue comes up empty.

Only cells this run has not published are emitted, judged against the head's check runs in the
JSONL file `SHIPMATE_CHECK_RUNS` (the App `SHIPMATE_APP_ID`'s, newest per name): a re-run of the
summary job leaves alone a check an apply has completed, or is completing, since. A record from a
newer plan run refuses before any cell summary is read, so an older run never replaces a newer
run's checks, whatever its cells hold. That refusal alone exits `NEWER_RUN`: the summary step holds
the gate on any other failure.

A run whose evidence `gate-state.evidence_gap` rejects (a plan job that did not succeed, a missing
or unparseable `SHIPMATE_PLANNED_CELLS`, or parsed cell summaries that do not match it) emits
nothing and reads no plan text, with a `::warning::` when that withholds a body.
"""

import hashlib
import json
import os
import pathlib
import sys

from _shipmate import (
    _load,
    cell_summaries,
    current_run_url,
    event_action,
    is_run_id,
    run_annotated,
)

ag = _load("apply-gate")
gs = _load("gate-state")
sc = _load("summary-comment")
NEWER_RUN = 3
# GitHub refuses an output.summary over 65,535 characters and, separately, over 65,535 UTF-8
# bytes; bytes bind first for any non-ASCII text.
CHECK_OUTPUT_CAP = 65_535
_COUNT_KEYS = ("add", "change", "destroy", "import", "forget")


_KEYS = ("stack", "environment", "changed", "fingerprint")
_SKEW = (
    "-- plan-cell and the summary job must run the same engine revision; re-pin every engine "
    "reference to one commit, then re-plan (comment shipmate plan or push)"
)


def _plan_run():
    plan_run = os.environ.get("GITHUB_RUN_ID", "")
    if not is_run_id(plan_run):
        raise SystemExit(
            "::error::GITHUB_RUN_ID is unset or not a decimal run id: every apply "
            "check must record the plan run that produced its cell, or apply can "
            "never find the reviewed plan."
        )
    return plan_run


def _utf8_len(text):
    return len(text.encode("utf-8"))


def check_output(cell, txt, url):
    """The check `output` of the changed cell `cell` whose plan text is the file `txt`: its counts
    as the title (`+? ~? -?` when underivable) and the plan in a `diff` fence as the summary,
    at most `CHECK_OUTPUT_CAP` UTF-8 bytes. A cut plan keeps whole lines and ends with a link to
    `url`, the plan run's page, whose plan job's raw log has the full plan; when no whole line
    fits, the summary is that link alone. Only a prefix of `txt` is read."""
    tally = sc.counts(txt) or ("?",) * 5
    title = sc.state({**cell, **dict(zip(_COUNT_KEYS, tally, strict=True))})
    # No prefix longer than the cap can fit. The fence is sized over the whole prefix, a
    # superset of any cut, so the cut text cannot close it.
    with open(txt, encoding="utf-8") as fh:
        prefix = fh.read(CHECK_OUTPUT_CAP + 1)
    mapped = sc.diff_map(prefix)
    f = sc._fence_of(mapped)
    whole = sc.fence(mapped, f)
    if len(prefix) <= CHECK_OUTPUT_CAP and _utf8_len(whole) <= CHECK_OUTPUT_CAP:
        return {"title": title, "summary": whole}
    where = f"the plan job's raw log in [the plan run]({url}) has the full plan"
    trailer = f"\n\n_Truncated; {where}._"
    room = CHECK_OUTPUT_CAP - _utf8_len(sc.fence("", f)) - _utf8_len(trailer)
    # `room + 1` keeps a line whose newline is byte `room + 1`; the newline itself is dropped.
    # A negative room yields an empty or over-cap candidate, which the guard below refuses.
    cut = mapped.encode("utf-8")[: room + 1].decode("utf-8", errors="ignore")
    kept = cut.rpartition("\n")[0]
    summary = sc.fence(kept, f) + trailer
    if not kept or _utf8_len(summary) > CHECK_OUTPUT_CAP:
        return {"title": title, "summary": f"_Plan too large to show here; {where}._"}
    return {"title": title, "summary": summary}


def body(name, cell_json, cell, head_sha, plan_run, pr, cells, action, url):
    """The POST body for the cell summary `cell` at `cell_json`, whose apply check is `name`,
    hashing the plan.txt beside it. `cells` is the number of cells the run planned, `action`
    its event action, `url` the run page a cut plan links."""
    txt = pathlib.Path(cell_json).with_name("plan.txt")
    if not txt.is_file():
        raise SystemExit(
            f"::error::{cell_json} has no plan.txt beside it: the plan text a reviewer "
            "reads cannot be bound to the plan that will be applied. plan-cell and "
            "summary are from mismatched engine revisions; re-pin every engine reference to "
            "one commit, then re-plan (comment shipmate plan or push)."
        )
    plan_sha256 = hashlib.sha256(txt.read_bytes()).hexdigest()
    out = {
        "name": name,
        "head_sha": head_sha,
        "status": "queued",
        "external_id": json.dumps(
            {
                "fingerprint": cell["fingerprint"],
                "plan_run": plan_run,
                "plan_sha256": plan_sha256,
                "pr": pr,
                "cells": cells,
                "action": action,
            }
        ),
    }
    if cell["changed"]:
        out["output"] = check_output(cell, txt, url)
    else:
        out["status"] = "completed"
        out["conclusion"] = "neutral"
        out["output"] = {
            "title": "no changes",
            "summary": "Plan produced no changes for this stack x environment.",
        }
    return out


def published(check_run_lines, app_id, plan_run):
    """The names whose newest App-authored check carries a record from this run.

    A check with no decodable record (an older engine's, a hand-made one) or an older run's is
    not this run's, so it is published again. Any record from a run newer than this one refuses
    with `NEWER_RUN`. Run ids compare as integers."""
    this_run = int(plan_run)
    runs = {
        name: int(run)
        for name, (run, _, _) in ag.plan_records(check_run_lines, app_id).items()
        if run is not None
    }
    newer = sorted(name for name, run in runs.items() if run > this_run)
    if newer:
        print(
            f"::error::plan run {max(runs[n] for n in newer)}, newer than this run ({this_run}), "
            f"published apply checks on this head ({', '.join(newer)}); this run publishes nothing "
            "over them. That run's summary writes the gate; if it did not finish, re-plan this "
            "pull request (comment shipmate plan or push).",
            file=sys.stderr,
        )
        raise SystemExit(NEWER_RUN)
    return {name for name, run in runs.items() if run == this_run}


def main():
    head = os.environ["SHIPMATE_HEAD_SHA"]
    plan_run = _plan_run()
    lines = pathlib.Path(os.environ["SHIPMATE_CHECK_RUNS"]).read_text(encoding="utf-8").splitlines()
    done = published(lines, os.environ.get("SHIPMATE_APP_ID", ""), plan_run)
    pr = ag.env_pr_number()
    cells = [
        (ag.check_name(cell["stack"], cell["environment"]), cj, cell)
        for cj, cell in cell_summaries(os.environ.get("SHIPMATE_CELLS_DIR", "cells"), _KEYS, _SKEW)
    ]
    todo = [c for c in cells if c[0] not in done]
    gap = gs.evidence_gap(
        plan_result=os.environ.get("SHIPMATE_PLAN_RESULT", ""),
        planned_cells=os.environ.get("SHIPMATE_PLANNED_CELLS", ""),
        cell_count=len(cells),
    )
    if gap:
        if todo:
            print(f"::warning::this run publishes no apply check: {gap}", file=sys.stderr)
        return
    action = event_action()
    url = current_run_url()
    for name, cj, cell in todo:
        print(json.dumps(body(name, cj, cell, head, plan_run, pr, len(cells), action, url)))


if __name__ == "__main__":
    run_annotated(main)
