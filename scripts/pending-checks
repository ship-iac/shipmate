#!/usr/bin/env python3
"""Emit `POST /check-runs` bodies (JSONL on stdout) for every planned cell and every behind cell.

The summary job creates ALL pending apply checks with ONE App installation
token, so the App private key never enters the plan matrix cells (they execute
PR-head code) and a 256-cell run mints one token, not 256. Changed cells get a
queued check titled with the plan's counts whose summary is the plan in a fence, cut to
`CHECK_OUTPUT_CAP` UTF-8 bytes with a link to this run's page; no-change cells a
completed/neutral "no changes" check. Each check's external_id is a compact JSON record of
the id of the plan run that produced the cell, the number of the pull request it planned,
the sha256 of the plan text that run published, on either branch, and
`cells`, the number of cells that run planned plus its behind cells, against which apply judges
whether the run published every check, and `action`, the plan run's event action (`""` when its
payload names none, as a `shipmate plan` dispatch's does), which the auto apply requires
to be a push's, and `title`, the check's own output title, which a successful apply restores
after a failed one retitled the check. GitHub caps `external_id` at `EXTERNAL_ID_CAP`
characters and truncates a longer one, which no reader can decode, so a record over the cap
refuses. That digest is computed here, over the whole plan.txt this job downloaded, never
copied from the cell: it is what binds the reviewed text to the plan apply executes.
The comment and the check embed capped prefixes of the same file, so the digest covers at
least what a reviewer saw and often more.
Each behind cell (`SHIPMATE_BEHIND`, build-matrix's `behind` output read by
`gate-state.behind_cells`) gets a queued check titled `Behind <base>: update the branch` whose
summary names the base commits that changed its stack, and whose record is `{plan_run, pr, cells,
action, behind: true}`: no digest, since no plan exists, and no title, which no apply restores.
The base branch stays out of the record, whose size it would make unbounded.
The check name uses the stack PATH so deploy-detect (which only has the path)
reconstructs it exactly. A missing pending check is not a quiet degradation: the pre-apply snapshot
refuses over it, and deploy-detect's work queue comes up empty.

Only cells this run has not published are emitted, judged against the head's check runs in the
JSONL file `SHIPMATE_CHECK_RUNS` (the App `SHIPMATE_APP_ID`'s, newest per name): a re-run of the
summary job leaves alone a check an apply has completed, or is completing, since. A cell planned
over this run's own behind record, which an earlier attempt published, gets its plan check
anyway. A record from a
newer plan run refuses before any cell summary is read, so an older run never replaces a newer
run's checks, whatever its cells hold. That refusal alone exits `NEWER_RUN`: the summary step holds
the gate on any other failure.

A run whose evidence `gate-state.evidence_gap` rejects (a plan job that did not succeed, a missing
or unparseable `SHIPMATE_PLANNED_CELLS` or `SHIPMATE_BEHIND`, or parsed cell summaries that do
not match it) emits nothing and reads no plan text, with a `::warning::` when that withholds a
body.
"""

import hashlib
import io
import json
import os
import pathlib
import sys

from _shipmate import (
    CHECK_OUTPUT_CAP,
    _load,
    cell_summaries,
    current_run_url,
    env_pr_number,
    event_action,
    is_run_id,
    run_annotated,
)

ag = _load("apply-gate")
gs = _load("gate-state")
sc = _load("summary-comment")
NEWER_RUN = 3
EXTERNAL_ID_CAP = 255


_KEYS = ("stack", "environment", "changed")
_SKEW = (
    "-- plan-cell and the summary job must run the same engine revision; re-pin every engine "
    "reference to one commit, then re-plan (comment shipmate plan or push)"
)


def _plan_run():
    plan_run = os.environ.get("GITHUB_RUN_ID", "")
    if not is_run_id(plan_run):
        raise SystemExit(
            "::error::GITHUB_RUN_ID is unset or not a decimal run id: every apply "
            "check must record the plan run that produced its cell, or apply can "
            "never find the reviewed plan."
        )
    return plan_run


def _text(raw, newline=None):
    """The UTF-8 bytes `raw` as a text stream decoded as it is read, with `open`'s `newline`."""
    return io.TextIOWrapper(io.BytesIO(raw), encoding="utf-8", newline=newline)


def check_output(cell, raw, url):
    """The check `output` of the changed cell `cell` whose plan text is the bytes `raw`: its
    counts as the title (`+? ~? -?` when underivable) and the plan in a `diff` fence as the
    summary, at most `CHECK_OUTPUT_CAP` UTF-8 bytes. A cut plan keeps whole lines and ends with a
    link to `url`, the plan run's page, whose plan job's raw log has the full plan; when no whole
    line fits, the summary is that link alone. Both are streamed from `raw`: the counts line by
    line, and only a prefix for the summary."""
    tally = sc.counts_of(_text(raw, newline="\n")) or ("?",) * 5
    title = sc.state({**cell, **dict(zip(sc.COUNT_KEYS, tally, strict=True))})
    # No prefix longer than the cap can fit.
    f, kept, cut = sc.check_frame(_text(raw).read(CHECK_OUTPUT_CAP + 1), url)
    if not cut:
        return {"title": title, "summary": sc.fence(kept, f)}
    if not kept:
        return {"title": title, "summary": f"_Plan too large to show here; {sc.check_where(url)}._"}
    return {"title": title, "summary": sc.fence(kept, f) + sc.check_trailer(url)}


def body(name, cell_json, cell, head_sha, plan_run, pr, cells, action, url):
    """The POST body for the cell summary `cell` at `cell_json`, whose apply check is `name`,
    hashing the plan.txt beside it, which it reads once. `cells` is the number of cells the run
    planned, `action` its event action, `url` the run page a cut plan links."""
    txt = pathlib.Path(cell_json).with_name("plan.txt")
    if not txt.is_file():
        raise SystemExit(
            f"::error::{cell_json} has no plan.txt beside it: the plan text a reviewer "
            "reads cannot be bound to the plan that will be applied. plan-cell and "
            "summary are from mismatched engine revisions; re-pin every engine reference to "
            "one commit, then re-plan (comment shipmate plan or push)."
        )
    raw = txt.read_bytes()
    plan_sha256 = hashlib.sha256(raw).hexdigest()
    if cell["changed"]:
        status, output = {"status": "queued"}, check_output(cell, raw, url)
    else:
        status = {"status": "completed", "conclusion": "neutral"}
        output = {
            "title": "no changes",
            "summary": "Plan produced no changes for this stack x environment.",
        }
    return {
        "name": name,
        "head_sha": head_sha,
        **status,
        "external_id": external_id(
            {
                "plan_run": plan_run,
                "plan_sha256": plan_sha256,
                "pr": pr,
                "cells": cells,
                "action": action,
                "title": output["title"],
            }
        ),
        "output": output,
    }


def behind_body(row, report, head_sha, plan_run, pr, cells, action):
    """The POST body for the behind cell `row` of the behind report `report`: queued, titled
    with the base branch, its summary `summary-comment.behind_line` and that the cell is not
    planned until the branch is updated. `cells` and `action` are as `body`'s."""
    base = report["base"]
    return {
        "name": ag.check_name(row["stack"], row["environment"]),
        "head_sha": head_sha,
        "status": "queued",
        "external_id": external_id(
            {"plan_run": plan_run, "pr": pr, "cells": cells, "action": action, "behind": True}
        ),
        "output": {
            "title": f"Behind {base}: update the branch",
            "summary": f"{sc.behind_line(row, report)}\n\nThis cell is not planned until the "
            f"branch is updated from {sc._md_name(base)}.",
        },
    }


def external_id(record):
    """`record` as compact JSON; a record over `EXTERNAL_ID_CAP` characters refuses."""
    text = json.dumps(record, separators=(",", ":"))
    if len(text) <= EXTERNAL_ID_CAP:
        return text
    raise SystemExit(
        f"::error::the apply check record is {len(text)} characters, over GitHub's "
        f"{EXTERNAL_ID_CAP}-character external_id cap"
    )


def published(check_run_lines, app_id, plan_run):
    """The names whose newest App-authored check carries a record from this run.

    A check with no decodable record (an older engine's, a hand-made one) or an older run's is
    not this run's, so it is published again. Any record from a run newer than this one refuses
    with `NEWER_RUN`. Run ids compare as integers."""
    this_run = int(plan_run)
    runs = {
        name: int(run)
        for name, (run, _, _) in ag.plan_records(check_run_lines, app_id).items()
        if run is not None
    }
    newer = sorted(name for name, run in runs.items() if run > this_run)
    if newer:
        print(
            f"::error::plan run {max(runs[n] for n in newer)}, newer than this run ({this_run}), "
            f"published apply checks on this head ({', '.join(newer)}); this run publishes nothing "
            "over them. That run's summary writes the gate; if it did not finish, re-plan this "
            "pull request (comment shipmate plan or push).",
            file=sys.stderr,
        )
        raise SystemExit(NEWER_RUN)
    return {name for name, run in runs.items() if run == this_run}


def main():
    head = os.environ["SHIPMATE_HEAD_SHA"]
    plan_run = _plan_run()
    lines = pathlib.Path(os.environ["SHIPMATE_CHECK_RUNS"]).read_text(encoding="utf-8").splitlines()
    done = published(lines, os.environ.get("SHIPMATE_APP_ID", ""), plan_run)
    pr = env_pr_number()
    cells = [
        (ag.check_name(cell["stack"], cell["environment"]), cj, cell)
        for cj, cell in cell_summaries(os.environ.get("SHIPMATE_CELLS_DIR", "cells"), _KEYS, _SKEW)
    ]
    # A behind record of this run's earlier attempt does not stand for a cell this attempt plans.
    behind = ag.behind_names(lines, os.environ.get("SHIPMATE_APP_ID", ""))
    todo = [c for c in cells if c[0] not in done - behind]
    report = gs.behind_cells(os.environ.get("SHIPMATE_BEHIND", ""))
    rows = [] if report is None else report["cells"]
    gap = gs.evidence_gap(
        plan_result=os.environ.get("SHIPMATE_PLAN_RESULT", ""),
        planned_cells=os.environ.get("SHIPMATE_PLANNED_CELLS", ""),
        cell_count=len(cells),
        behind=None if report is None else len(rows),
    )
    if gap:
        if todo or rows:
            print(f"::warning::this run publishes no apply check: {gap}", file=sys.stderr)
        return
    action = event_action()
    url = current_run_url()
    total = len(cells) + len(rows)
    for name, cj, cell in todo:
        print(json.dumps(body(name, cj, cell, head, plan_run, pr, total, action, url)))
    # This run's earlier attempt may have published a plan check under the name; only a behind
    # record of this run stands for this behind cell.
    for row in rows:
        if ag.check_name(row["stack"], row["environment"]) not in done & behind:
            print(json.dumps(behind_body(row, report, head, plan_run, pr, total, action)))


if __name__ == "__main__":
    run_annotated(main)
