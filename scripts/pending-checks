#!/usr/bin/env python3
"""Emit `POST /check-runs` bodies (JSONL on stdout) for every planned cell.

Relocated from plan-cell: the summary job creates ALL pending apply checks
with ONE App installation token, so the App private key never enters the
plan matrix cells (they execute PR-head code) and a 256-cell run mints one
token, not 256. Body semantics match the old plan-cell step apart from
external_id: changed cells get a queued "apply pending" check, no-change cells
a completed/neutral "no changes" check. external_id is new -- a JSON record of
the TF_VAR fingerprint and the id of the plan run that produced the cell, on
either branch, where plan-cell wrote the bare fingerprint. The check name uses
the stack PATH so deploy-detect (which only has the path) reconstructs it
exactly. A missing pending check is not a quiet degradation: the pre-apply snapshot
refuses over it, and deploy-detect's work queue comes up empty.
"""

import json
import os
import pathlib
import re


def bodies(cells_dir, head_sha):
    plan_run = os.environ.get("GITHUB_RUN_ID", "")
    if not re.fullmatch(r"[0-9]+", plan_run):
        raise SystemExit(
            "::error::GITHUB_RUN_ID is unset or not a decimal run id — every apply "
            "check must record the plan run that produced its cell, or apply can "
            "never find the reviewed plan."
        )
    out = []
    # Recursive, not `cell-summary.*/cell.json`: `actions/download-artifact` drops the
    # per-artifact subdirectory when exactly one artifact matches the pattern, so a one-cell
    # plan lands at `<cells>/cell.json`, where the nested-only glob matched nothing.
    for cj in sorted(pathlib.Path(cells_dir).glob("**/cell.json")):
        cell = json.loads(cj.read_text(encoding="utf-8"))
        if "fingerprint" not in cell:
            raise SystemExit(
                f"::error::{cj} has no 'fingerprint' key — plan-cell and summary "
                "are from mismatched engine revisions; re-run the plan."
            )
        body = {
            "name": f"apply / {cell['stack_path']} / {cell['environment']}",
            "head_sha": head_sha,
            "status": "queued",
            "external_id": json.dumps({"fingerprint": cell["fingerprint"], "plan_run": plan_run}),
            "output": {
                "title": "apply pending",
                "summary": "Waiting to be applied. Merge after apply completes "
                + "for this stack x environment.",
            },
        }
        if not cell["changed"]:
            body["status"] = "completed"
            body["conclusion"] = "neutral"
            body["output"] = {
                "title": "no changes",
                "summary": "Plan produced no changes for this stack x environment.",
            }
        out.append(body)
    return out


def main():
    head = os.environ["SHIPMATE_HEAD_SHA"]
    cells = os.environ.get("SHIPMATE_CELLS_DIR", "cells")
    for body in bodies(cells, head):
        print(json.dumps(body))


if __name__ == "__main__":
    main()
