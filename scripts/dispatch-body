#!/usr/bin/env python3
"""Build the `workflow_dispatch` request body for `shipmate.yml` (one input shape per verb), and
send it.

    dispatch-body         print the body
    dispatch-body post    POST the body and print the API's answer

Env: `VERB`, `REF`, `PR_NUMBER`, `ENVIRONMENT`, `DISPATCH_REF`; `post` also reads
`GITHUB_REPOSITORY` and `GH_TOKEN`. Any other argument list refuses with an `::error::` usage line.

`post` retries a transient failure (`_shipmate.retried`), and a transient failure may have
started a run: GitHub can start it and still answer 502. Before each retry it lists `shipmate.yml`'s
`workflow_dispatch` runs (one page of 100, newest first) and stops when any was created since
`t0`, five seconds before the first attempt. The stop rule reads no title: a run's title is the
consumer's `run-name`, which nothing checks, so no title can prove a run is not this dispatch's.
A concurrent dispatch landing in the window therefore stops the retry too; a wrong stop costs a
comment, a wrong retry a double start. Exit codes:

    0                   dispatched; stdout is the API's answer, unchanged
    1                   failed on the first attempt with a failure that is not transient, so no
                        run started
    3 MAY_HAVE_STARTED  a listed run was created since `t0`; not retried
    4 UNDETERMINED      the attempts ended on transient failures, a later attempt failed after a
                        transient one, or the listing failed or was malformed

On 1 and 4 the final failure's message goes to stderr, unannotated.

Known ceilings: a run that landed but is not listed yet when the listing is read is not seen, so
that attempt can be retried and start twice. A runner clock ahead of GitHub's by more than five
seconds puts `t0` after a run that landed.
"""

import json
import os
import sys
from datetime import UTC, datetime, timedelta

from _shipmate import retried, run, run_annotated

MAY_HAVE_STARTED = 3
UNDETERMINED = 4
_USAGE = "::error::usage: dispatch-body [post]"
#: How far `t0` sits before the first attempt: the margin for a runner clock behind GitHub's.
_CLOCK_MARGIN = timedelta(seconds=5)


def _now():
    return datetime.now(UTC)


def body() -> dict:
    """The dispatch request body for `VERB`, from the env."""
    verb = os.environ["VERB"]
    if verb == "plan":
        # `shipmate.yml` declares four inputs; a plan fills two. `ref` is not among them: the
        # dispatched run resolves the head from the pull request itself, so nothing a
        # dispatcher states decides what is planned.
        inputs = {"verb": verb, "pr_number": os.environ["PR_NUMBER"]}
    elif verb == "unlock":
        # Releasing a stranded lock applies no plan and comments on no pull request, so
        # nothing on that path reads a pull-request number.
        inputs = {
            "verb": verb,
            "ref": os.environ["REF"],
            "environment": os.environ["ENVIRONMENT"],
        }
    else:
        inputs = {
            "verb": verb,
            "ref": os.environ["REF"],
            "pr_number": os.environ["PR_NUMBER"],
        }
        # The `environment` key is included only when set: an empty value is the bare
        # `shipmate apply`, which `apply.yml` runs across every pending environment.
        if os.environ.get("ENVIRONMENT"):
            inputs["environment"] = os.environ["ENVIRONMENT"]
    # `return_run_details` makes the API answer 200 with the started run's id, which the success
    # reply links when it is a usable id; without it the answer is an empty 204.
    return {"ref": os.environ["DISPATCH_REF"], "inputs": inputs, "return_run_details": True}


def landed_since(repo: str, t0: datetime, run=run) -> bool:
    """True when a `shipmate.yml` `workflow_dispatch` run in `repo` was created at or after `t0`.

    Reads one page through `retried`: a retry window is seconds long, so 100 runs hold every
    candidate. A failed read raises its `SystemExit`; a row that is not an object with an ISO 8601
    `created_at` carrying a zone raises `ValueError`."""
    args = [
        "gh",
        "api",
        f"repos/{repo}/actions/workflows/shipmate.yml/runs?event=workflow_dispatch&per_page=100",
        "--jq",
        ".workflow_runs[] | {created_at} | tojson",
    ]
    out = retried(lambda: run(args))
    landed = False
    for line in filter(None, out.splitlines()):
        listed = json.loads(line)
        created = listed.get("created_at") if isinstance(listed, dict) else None
        if not isinstance(created, str):
            raise ValueError(f"listed run without a created_at: {line}")
        at = datetime.fromisoformat(created)
        if at.tzinfo is None:
            raise ValueError(f"listed run created_at without a zone: {line}")
        landed = landed or at >= t0
    return landed


def post():
    repo = os.environ["GITHUB_REPOSITORY"]
    data = json.dumps(body())
    args = ["gh", "api", "-X", "POST", f"repos/{repo}/actions/workflows/shipmate.yml/dispatches"]
    args += ["--input", "-"]
    t0 = _now() - _CLOCK_MARGIN
    attempts = []

    def attempt():
        attempts.append(None)
        return run(args, stdin=data)

    def before_retry():
        try:
            landed = landed_since(repo, t0, run=run)
        except (SystemExit, ValueError) as e:
            print(e, file=sys.stderr)
            raise SystemExit(UNDETERMINED) from None
        if landed:
            raise SystemExit(MAY_HAVE_STARTED)

    try:
        out = retried(attempt, before_retry)
    except SystemExit as e:
        if isinstance(e.code, int):
            raise
        print(e.code, file=sys.stderr)
        # Only a first attempt that failed without a transient failure cannot have started a run.
        raise SystemExit(1 if len(attempts) == 1 else UNDETERMINED) from None
    sys.stdout.write(out)


def main(argv):
    if argv == []:
        print(json.dumps(body()))
    elif argv == ["post"]:
        post()
    else:
        raise SystemExit(_USAGE)


if __name__ == "__main__":
    run_annotated(main, sys.argv[1:])
