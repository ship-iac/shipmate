#!/usr/bin/env python3
"""Build actions/dispatch's `workflow_dispatch` request body: one input shape per verb, on one file.

Printed to stdout, which the step redirects to the file `gh api --input` reads.
"""

import json
import os


def main():
    verb = os.environ["VERB"]
    if verb == "plan":
        # `shipmate.yml` declares four inputs; a plan fills two. `ref` is not among them: the
        # dispatched run resolves the head from the pull request itself, so nothing a
        # dispatcher states decides what is planned.
        inputs = {"verb": verb, "pr_number": os.environ["PR_NUMBER"]}
    elif verb == "unlock":
        # Releasing a stranded lock applies no plan and comments on no pull request, so
        # nothing on that path reads a pull-request number.
        inputs = {
            "verb": verb,
            "ref": os.environ["REF"],
            "environment": os.environ["ENVIRONMENT"],
        }
    else:
        inputs = {
            "verb": verb,
            "ref": os.environ["REF"],
            "pr_number": os.environ["PR_NUMBER"],
        }
        # The `environment` key is included only when set: an empty value is the bare
        # `shipmate apply`, which is what selects the `all` job over `targeted`.
        if os.environ.get("ENVIRONMENT"):
            inputs["environment"] = os.environ["ENVIRONMENT"]
    print(json.dumps({"ref": os.environ["DISPATCH_REF"], "inputs": inputs}))


if __name__ == "__main__":
    main()
