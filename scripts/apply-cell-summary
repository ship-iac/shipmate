#!/usr/bin/env python3
"""Decide an apply cell's result and blocked reason, then write $RUNNER_TEMP/cell.json.

Used by actions/apply-cell's `Compose cell summary` step, which runs even when a fail-safe or
the apply itself failed or was cancelled: the aggregator needs a result for every
attempted-or-blocked cell.

`state_lost` is true exactly when the step `Warn that the applied state was not saved` fires: the
apply step ran, the state was restored, and `actions/state` did not report the save as `saved`.
The apply comment names those cells so it never prescribes a re-apply for them.
"""

import json
import os

# Checked in pipeline order and matched on 'failure', not "!= success": a
# composite-action step failure halts every later non-always() step, so a fail-safe
# that never ran reads 'skipped', not 'failure'. Matching 'failure' exactly means only
# the fail-safe that actually tripped can claim the blocked reason.
FAILSAFES = [
    (
        "DOWNLOAD_OUTCOME",
        (
            "reviewed plan artifact missing or expired; re-plan: comment shipmate plan or push, "
            "or after the merge open a new pull request touching the stack"
        ),
    ),
    (
        "PLANNED_HEAD_OUTCOME",
        "reviewed plan records no commit or was produced from a different one; re-plan",
    ),
    (
        "DECRYPT_OUTCOME",
        (
            "plan artifact could not be decrypted (no passphrase; unencrypted or from an earlier "
            "engine release; failed authentication: a rotated passphrase, different values on "
            "<env>-plan and <env>-apply, or a corrupt, truncated or altered artifact; or an "
            "openssl or disk failure on the runner, which a re-run of the job clears when "
            "transient); docs/troubleshooting.md gives each remedy"
        ),
    ),
    (
        "FINGERPRINT_OUTCOME",
        "environment does not match the reviewed plan's fingerprint; re-plan",
    ),
    (
        "DIGEST_INPUT_OUTCOME",
        "no plan-text digest reached this action; re-pin every engine reference to one commit",
    ),
    ("INIT_OUTCOME", "tofu init failed; see the job log"),
    (
        "LOCATE_OUTCOME",
        "shipmate cannot tell where this stack's local state lives; see the job log",
    ),
    ("RESTORE_OUTCOME", "state restore failed"),
    (
        "PLAN_DIGEST_OUTCOME",
        (
            "the stored plan cannot be rendered, or does not render to the plan text that was "
            "reviewed; re-plan"
        ),
    ),
]


def main():
    result, reason = None, ""
    for env_key, message in FAILSAFES:
        if os.environ[env_key] == "failure":
            result, reason = "blocked", message
            break

    if result is None:
        apply_outcome = os.environ["APPLY_OUTCOME"]
        if apply_outcome == "success":
            result = "applied"
        elif apply_outcome in ("failure", "cancelled"):
            result = "failed"
        else:
            # No fail-safe failed and apply never ran, so some other step failed
            # first. Still blocked, but the reason must not name a fail-safe that
            # was never attempted.
            result = "blocked"
            reason = "an earlier step failed before the apply ran; see the job log"

    # apply.txt needs no copy: `Apply the stored plan` already tee'd it to
    # $RUNNER_TEMP/apply.txt, so a blocked cell that never reached the apply never wrote
    # it, and an attempted cell's copy already sits where `Upload apply summary` reads.
    state_lost = (
        os.environ["APPLY_OUTCOME"] != "skipped"
        and os.environ["RESTORE_OUTCOME"] == "success"
        and os.environ["STATE_SAVED"] != "true"
    )
    cell_path = os.path.join(os.environ["RUNNER_TEMP"], "cell.json")
    with open(cell_path, "w") as fh:
        json.dump(
            {
                "stack": os.environ["STACK"],
                "environment": os.environ["ENV"],
                "result": result,
                "reason": reason,
                "state_lost": state_lost,
            },
            fh,
        )


if __name__ == "__main__":
    main()
