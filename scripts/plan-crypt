#!/usr/bin/env python3
"""Shared cipher for the plan artifact and the cached local state file.

Single definition of the cipher so plan-cell (require first, encrypt before upload),
apply-cell (decrypt after download) and actions/state (encrypt before save, decrypt after
restore) can never drift. The openssl flags and the key derivation live ONLY here.

Format shipmate-crypt-v1: MAGIC || salt || body || tag.

- MAGIC is `shipmate-crypt-v1\\n` (18 bytes); a later format bumps the digit.
- salt is 16 random bytes. master = PBKDF2-HMAC-SHA256(passphrase, salt, 600,000
  iterations, 32 bytes); enc_key and mac_key are HMAC-SHA256(master, "shipmate-crypt-v1
  enc") and HMAC-SHA256(master, "shipmate-crypt-v1 mac").
- body is the output of `openssl enc -aes-256-ctr -pbkdf2 -iter 1 -md sha256 -salt`
  (`Salted__`, openssl's 8-byte salt, the ciphertext), with enc_key's hex as openssl's
  passphrase, passed in the child's environment, never argv.
- tag is HMAC-SHA256(mac_key, MAGIC || salt || body), 32 bytes.

The passphrase comes from the PLAN_PASSPHRASE env var and is required: every operation
refuses when it is empty or unset.

AES-256-CTR is unauthenticated: a wrong key or a damaged byte decrypts to garbage WITH
EXIT 0. So a decrypt checks, in this order, before openssl sees any byte: a file that
starts with `Salted__` (every earlier release's ciphertext) or is plaintext (a zip, or a
whole JSON object) refuses as not shipmate-crypt-v1; anything else that is not a whole v1
file whose tag verifies refuses as failing authentication. Only then does openssl run.
"""

import hashlib
import hmac
import json
import os
import secrets
import subprocess
import sys

MAGIC = b"shipmate-crypt-v1\n"
SALT_LEN = 16
TAG_LEN = 32
# MAGIC, salt, openssl's `Salted__` and its own 8-byte salt, then the tag.
MIN_LEN = len(MAGIC) + SALT_LEN + 16 + TAG_LEN
ITERATIONS = 600000
KEY_VAR = "SHIPMATE_CRYPT_KEY"
_REPLAN = (
    "comment shipmate plan or push, or after the merge open a new pull request touching the stack."
)
_RUNNER = (
    "Re-run the job, which clears a transient hosted-runner disk failure, or fix a self-hosted "
    "runner's openssl or disk."
)
ENV_VAR = "PLAN_PASSPHRASE"  # name of the env var carrying the secret (not the secret itself)


def _passphrase():
    return os.environ.get(ENV_VAR, "")


def _keys(salt):
    master = hashlib.pbkdf2_hmac("sha256", os.fsencode(_passphrase()), salt, ITERATIONS)
    enc_key = hmac.new(master, b"shipmate-crypt-v1 enc", "sha256").digest()
    mac_key = hmac.new(master, b"shipmate-crypt-v1 mac", "sha256").digest()
    return enc_key, mac_key


def _tag(mac_key, data):
    return hmac.new(mac_key, data, "sha256").digest()


def _openssl(data, enc_key, *, decrypt):
    # The ONLY place the openssl flags live (coupling: plan-cell, apply-cell, actions/state).
    # The key travels in the child's environment alone: never argv, never this process's env.
    args = [
        "openssl",
        "enc",
        "-aes-256-ctr",
        "-pbkdf2",
        "-iter",
        "1",
        "-md",
        "sha256",
        "-salt",
        "-pass",
        f"env:{KEY_VAR}",
    ]
    if decrypt:
        args.insert(2, "-d")
    env = {**os.environ, KEY_VAR: enc_key.hex()}
    return subprocess.run(args, input=data, stdout=subprocess.PIPE, env=env, check=True).stdout  # noqa: S603, S607 - fixed argv, no shell; key via env, openssl is a runner prereq


def _replace(path, transform, failure):
    """Write `transform()` over `path` through a temp sibling and an atomic replace."""
    tmp = path + ".crypt.tmp"
    try:
        data = transform()
        with open(tmp, "wb") as fh:
            fh.write(data)
        os.replace(tmp, path)
    except subprocess.CalledProcessError:
        raise SystemExit(failure) from None
    # A missing openssl, or a temp file that cannot be written or moved, still prints ::error::.
    except OSError as exc:
        raise SystemExit(f"{failure} Error: {exc}") from None
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                print(
                    f"::error::could not remove the temporary file `{tmp}`; delete it, because "
                    "after a decrypt it can hold the plaintext."
                )


def _require_passphrase():
    if not _passphrase():
        raise SystemExit(
            "::error::SHIPMATE_PLAN_PASSPHRASE is not set; it is required to encrypt and "
            "decrypt plan artifacts and local state. Set the secret and forward it to the "
            "shipmate workflows."
        )


def _repo_flag():
    repo = os.environ.get("GITHUB_REPOSITORY", "")
    return f" --repo {repo}" if repo else ""


def _purge_command(prefix):
    repo = _repo_flag()
    return (
        f"gh cache list{repo} --key {prefix} --limit 1000 --json id --jq '.[].id' "
        f"| xargs -n1 gh cache delete{repo}"
    )


def encrypt(path):
    """Encrypt in place as shipmate-crypt-v1, or refuse without a passphrase."""
    _require_passphrase()
    # No remedy here: a plan cell re-plans, and whether an apply cell's state save may be
    # re-run depends on whether its apply ran. docs/troubleshooting.md splits the cases.
    failure = (
        f"::error::`{path}` could not be encrypted: openssl or the disk failed on the runner, "
        "so it was not uploaded or saved. docs/troubleshooting.md section `... could not be "
        "encrypted: openssl or the disk failed on the runner` says what to do for a plan cell and "
        "for an apply cell's state save."
    )

    def sealed():
        with open(path, "rb") as fh:
            plaintext = fh.read()
        salt = secrets.token_bytes(SALT_LEN)
        enc_key, mac_key = _keys(salt)
        head = MAGIC + salt + _openssl(plaintext, enc_key, decrypt=False)
        return head + _tag(mac_key, head)

    _replace(path, sealed, failure)


def _is_pre_v1(data):
    # A one-bit flip turns MAGIC's `s` into `{`, so only a whole JSON object reads as plaintext.
    if data.startswith((b"Salted__", b"PK\x03\x04")):
        return True
    try:
        return isinstance(json.loads(data), dict)
    except ValueError:
        return False


def _decrypt(path, *, unreadable, no_header, unauthenticated, failure):
    """The decrypt both artifact kinds share; each caller supplies its refusals."""
    _require_passphrase()
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError as exc:
        raise SystemExit(f"{unreadable} Error: {exc}") from None
    if _is_pre_v1(data):
        raise SystemExit(no_header)
    if len(data) < MIN_LEN or not data.startswith(MAGIC):
        raise SystemExit(unauthenticated)
    enc_key, mac_key = _keys(data[len(MAGIC) : len(MAGIC) + SALT_LEN])
    if not hmac.compare_digest(_tag(mac_key, data[:-TAG_LEN]), data[-TAG_LEN:]):
        raise SystemExit(unauthenticated)
    body = data[len(MAGIC) + SALT_LEN : -TAG_LEN]
    _replace(path, lambda: _openssl(body, enc_key, decrypt=True), failure)


def decrypt(path):
    """Decrypt a plan artifact in place, or refuse before tofu can read it.

    Refuses without a passphrase, on an artifact that cannot be read, on one that is not
    shipmate-crypt-v1 (plaintext, or an earlier release's ciphertext), on one that fails
    authentication (another passphrase, corruption, truncation or alteration), and when
    openssl or the disk fails on the runner, leaving the ciphertext in place. Never prints
    the file.
    """
    _decrypt(
        path,
        unreadable=(
            f"::error::plan artifact `{path}` cannot be read. Nothing was applied. An artifact "
            f"downloaded without stack.otplan needs a re-plan: {_REPLAN} For a disk failure on "
            "the runner, the refusal comes before any apply step, so a re-run of the job is safe."
        ),
        no_header=(
            f"::error::plan artifact `{path}` is not a shipmate-crypt-v1 artifact: it was "
            "uploaded unencrypted or encrypted by an earlier engine release. Nothing was "
            f"applied. Re-plan: {_REPLAN}"
        ),
        unauthenticated=(
            f"::error::plan artifact `{path}` failed authentication: it was encrypted with "
            "another passphrase (a rotated one, or different values on <env>-plan and "
            "<env>-apply), or it is corrupt, truncated or altered. Nothing was applied. "
            "docs/troubleshooting.md section `plan artifact ... failed authentication` gives "
            "each remedy."
        ),
        failure=(
            f"::error::plan artifact `{path}` could not be decrypted: openssl or the disk failed "
            f"on the runner. Nothing was applied. {_RUNNER}"
        ),
    )


def decrypt_state(path, cache_key):
    """Decrypt a restored state cache entry in place, or refuse before tofu can read it.

    Refuses as `decrypt` does, naming the cache key. An entry that is not shipmate-crypt-v1
    names the command that deletes every entry under its prefix; one that fails
    authentication names no delete command, because the refusal cannot tell corruption from a
    wrong passphrase. Never prints the file's contents.
    """
    prefix = cache_key.rpartition("/")[0] + "/"
    _decrypt(
        path,
        unreadable=(
            f"::error::state cache entry `{cache_key}` cannot be read: the restore may not have "
            "written the file, or the runner's disk failed. tofu was not run. The refusal comes "
            "before any apply step, so a re-run of the job is safe."
        ),
        no_header=(
            f"::error::state cache entry `{cache_key}` is not a shipmate-crypt-v1 entry: it was "
            "saved unencrypted or by an earlier engine release. Delete every entry under its "
            f"prefix, then re-run: `{_purge_command(prefix)}` (the restore matches by prefix, "
            f"so deleting only `{cache_key}` restores the next-older entry, which is no "
            "shipmate-crypt-v1 entry either). Deleting discards that state: OpenTofu no longer "
            "tracks the resources it recorded. A sample stack's null and random resources "
            "re-create; a real resource can collide with or be duplicated by its re-creation."
        ),
        unauthenticated=(
            f"::error::state cache entry `{cache_key}` failed authentication: it was saved with "
            "another passphrase (a rotated one, or different values on <env>-plan and "
            "<env>-apply), or it is corrupt, truncated or altered. tofu was not run. "
            "docs/troubleshooting.md section `state cache entry ... failed authentication` tells "
            "the causes apart. Fix a passphrase with the secret: deleting an intact entry loses "
            "the state it holds."
        ),
        failure=(
            f"::error::state cache entry `{cache_key}` could not be decrypted: openssl or the "
            f"disk failed on the runner. tofu was not run. {_RUNNER}"
        ),
    )


USAGE = (
    "usage: plan-crypt require | plan-crypt {encrypt|decrypt} <file> | "
    "plan-crypt decrypt-state <file> <cache-key>"
)


def main(argv):
    if argv[1:] == ["require"]:
        _require_passphrase()
    elif len(argv) == 4 and argv[1] == "decrypt-state":
        decrypt_state(argv[2], argv[3])
    elif len(argv) == 3 and argv[1] in ("encrypt", "decrypt"):
        (encrypt if argv[1] == "encrypt" else decrypt)(argv[2])
    else:
        raise SystemExit(USAGE)


if __name__ == "__main__":
    main(sys.argv)
