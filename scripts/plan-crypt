#!/usr/bin/env python3
"""Shared cipher for the plan artifact and the cached local state file.

Single definition of the cipher so plan-cell (require first, encrypt before upload),
apply-cell (decrypt after download) and actions/state (encrypt before save, decrypt after
restore) can never drift. The openssl flags and the key derivation live ONLY here.

Format shipmate-crypt-v1: MAGIC || salt || body || tag.

- MAGIC is `shipmate-crypt-v1\\n` (18 bytes); a later format bumps the digit.
- salt is 16 random bytes. master = PBKDF2-HMAC-SHA256(encryption key, salt, 600,000
  iterations, 32 bytes); enc_key and mac_key are HMAC-SHA256(master, "shipmate-crypt-v1
  <kind> enc") and HMAC-SHA256(master, "shipmate-crypt-v1 <kind> mac"), where <kind> is
  `plan` or `state`, so a file of one kind never authenticates as the other.
- body is the output of `openssl enc -aes-256-ctr -pbkdf2 -iter 1 -md sha256 -nosalt`, the
  bare ciphertext, with enc_key's hex as openssl's passphrase, passed in the child's
  environment, never argv. The salt above already makes enc_key unique per file.
- tag is HMAC-SHA256(mac_key, len(scope) as 4 bytes || scope || MAGIC || salt || body), 32
  bytes. scope is empty for a plan and the cache prefix (`state/<stack>/<env>/`) for a
  state entry, so an entry copied under another stack's or environment's key refuses.

The encryption key comes from the ENCRYPTION_KEY env var and is required: every operation
refuses when it is empty or unset.

AES-256-CTR is unauthenticated: a wrong key or a damaged byte decrypts to garbage WITH
EXIT 0. So a decrypt refuses anything that is not a whole v1 file whose tag verifies as
failing authentication, before openssl sees any byte.
"""

import hashlib
import hmac
import os
import secrets
import subprocess
import sys

from _shipmate import run_annotated

MAGIC = b"shipmate-crypt-v1\n"
SALT_LEN = 16
TAG_LEN = 32
MIN_LEN = len(MAGIC) + SALT_LEN + TAG_LEN  # an empty plaintext has an empty body
ITERATIONS = 600000
KEY_VAR = "SHIPMATE_CRYPT_KEY"
_REPLAN = (
    "comment shipmate plan or push, or after the merge open a new pull request touching the stack."
)
_RUNNER = (
    "Re-run the job, which clears a transient hosted-runner disk failure, or fix a self-hosted "
    "runner's openssl or disk."
)
ENV_VAR = "ENCRYPTION_KEY"  # name of the env var carrying the secret (not the secret itself)


def _encryption_key():
    return os.environ.get(ENV_VAR, "")


def _keys(salt, kind):
    master = hashlib.pbkdf2_hmac("sha256", os.fsencode(_encryption_key()), salt, ITERATIONS)
    label = f"shipmate-crypt-v1 {kind} ".encode()
    enc_key = hmac.new(master, label + b"enc", "sha256").digest()
    mac_key = hmac.new(master, label + b"mac", "sha256").digest()
    return enc_key, mac_key


def _tag(mac_key, scope, data):
    # The one tagged input, for encrypt and decrypt alike. The length prefix keeps scope and
    # data from trading bytes.
    s = scope.encode()
    return hmac.new(mac_key, len(s).to_bytes(4, "big") + s + data, "sha256").digest()


def _state_scope(cache_key):
    return cache_key.rpartition("/")[0] + "/"


def _openssl(data, enc_key, *, decrypt):
    # The ONLY place the openssl flags live (coupling: plan-cell, apply-cell, actions/state).
    # The key travels in the child's environment alone: never argv, never this process's env.
    args = [
        "openssl",
        "enc",
        "-aes-256-ctr",
        "-pbkdf2",
        "-iter",
        "1",
        "-md",
        "sha256",
        "-nosalt",
        "-pass",
        f"env:{KEY_VAR}",
    ]
    if decrypt:
        args.insert(2, "-d")
    env = {**os.environ, KEY_VAR: enc_key.hex()}
    return subprocess.run(args, input=data, stdout=subprocess.PIPE, env=env, check=True).stdout  # noqa: S603, S607 - fixed argv, no shell; key via env, openssl is a runner prereq


def _replace(path, transform, failure):
    """Write `transform()` over `path` through a temp sibling and an atomic replace."""
    tmp = path + ".crypt.tmp"
    try:
        data = transform()
        with open(tmp, "wb") as fh:
            fh.write(data)
        os.replace(tmp, path)
    except subprocess.CalledProcessError:
        raise SystemExit(failure) from None
    # A missing openssl, or a temp file that cannot be written or moved, still prints ::error::.
    except OSError as exc:
        raise SystemExit(f"{failure} Error: {exc}") from None
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                print(
                    f"::error::could not remove the temporary file `{tmp}`; delete it, because "
                    "after a decrypt it can hold the plaintext."
                )


def _require_encryption_key():
    if not _encryption_key():
        raise SystemExit(
            "::error::SHIPMATE_ENCRYPTION_KEY is not set; it is required to encrypt and "
            "decrypt plan artifacts and local state. Set the secret and forward it to the "
            "shipmate workflows."
        )


def _encrypt(path, kind, scope):
    """The encrypt both artifact kinds share. `_keys` binds `kind` through the HMAC labels and
    `_tag` binds `scope`, as `_decrypt` reads them."""
    _require_encryption_key()
    # No remedy here: a plan cell re-plans, and whether an apply cell's state save may be
    # re-run depends on whether its apply ran. docs/troubleshooting.md splits the cases.
    failure = (
        f"::error::`{path}` could not be encrypted: openssl or the disk failed on the runner, "
        "so it was not uploaded or saved. docs/troubleshooting.md section `... could not be "
        "encrypted: openssl or the disk failed on the runner` says what to do for a plan cell and "
        "for an apply cell's state save."
    )

    def sealed():
        with open(path, "rb") as fh:
            plaintext = fh.read()
        salt = secrets.token_bytes(SALT_LEN)
        enc_key, mac_key = _keys(salt, kind)
        head = MAGIC + salt + _openssl(plaintext, enc_key, decrypt=False)
        return head + _tag(mac_key, scope, head)

    _replace(path, sealed, failure)


def encrypt(path):
    """Encrypt a plan artifact in place as shipmate-crypt-v1, or refuse without a key."""
    _encrypt(path, "plan", "")


def encrypt_state(path, cache_key):
    """Encrypt a state file in place, bound to the prefix of the cache key it is saved under."""
    _encrypt(path, "state", _state_scope(cache_key))


def _decrypt(path, kind, scope, *, unreadable, unauthenticated, failure):
    """The decrypt both artifact kinds share; each caller supplies its refusals."""
    _require_encryption_key()
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError as exc:
        raise SystemExit(f"{unreadable} Error: {exc}") from None
    if len(data) < MIN_LEN or not data.startswith(MAGIC):
        raise SystemExit(unauthenticated)
    enc_key, mac_key = _keys(data[len(MAGIC) : len(MAGIC) + SALT_LEN], kind)
    if not hmac.compare_digest(_tag(mac_key, scope, data[:-TAG_LEN]), data[-TAG_LEN:]):
        raise SystemExit(unauthenticated)
    body = data[len(MAGIC) + SALT_LEN : -TAG_LEN]
    _replace(path, lambda: _openssl(body, enc_key, decrypt=True), failure)


def decrypt(path):
    """Decrypt a plan artifact in place, or refuse before tofu can read it.

    Refuses without an encryption key, on an artifact that cannot be read, on one that fails
    authentication (another encryption key, corruption, truncation or alteration), and when
    openssl or the disk fails on the runner, leaving the ciphertext in place. Never prints
    the file.
    """
    _decrypt(
        path,
        "plan",
        "",
        unreadable=(
            f"::error::plan artifact `{path}` cannot be read. Nothing was applied. An artifact "
            f"downloaded without stack.otplan needs a re-plan: {_REPLAN} For a disk failure on "
            "the runner, the refusal comes before any apply step, so a re-run of the job is safe."
        ),
        unauthenticated=(
            f"::error::plan artifact `{path}` failed authentication: it was encrypted with "
            "another encryption key (a rotated one, or different values on <env>-plan and "
            "<env>-apply), or it is corrupt, truncated or altered. Nothing was applied. "
            "docs/troubleshooting.md section `plan artifact ... failed authentication` gives "
            "each remedy."
        ),
        failure=(
            f"::error::plan artifact `{path}` could not be decrypted: openssl or the disk failed "
            f"on the runner. Nothing was applied. {_RUNNER}"
        ),
    )


def decrypt_state(path, cache_key):
    """Decrypt a restored state cache entry in place, or refuse before tofu can read it.

    Refuses as `decrypt` does, naming the cache key. An authentication failure names no delete
    command, because the refusal cannot tell corruption from a wrong encryption key. Never prints
    the file's contents.
    """
    prefix = _state_scope(cache_key)
    _decrypt(
        path,
        "state",
        prefix,
        unreadable=(
            f"::error::state cache entry `{cache_key}` cannot be read: the restore may not have "
            "written the file, or the runner's disk failed. tofu was not run. The refusal comes "
            "before any apply step, so a re-run of the job is safe."
        ),
        unauthenticated=(
            f"::error::state cache entry `{cache_key}` failed authentication: it was saved with "
            "another encryption key (a rotated one, or different values on <env>-plan and "
            "<env>-apply), or it is corrupt, truncated, altered or copied under another stack's "
            "or environment's key. tofu was not run. "
            "docs/troubleshooting.md section `state cache entry ... failed authentication` tells "
            "the causes apart. Fix an encryption key with the secret: deleting an intact entry "
            "loses the state it holds."
        ),
        failure=(
            f"::error::state cache entry `{cache_key}` could not be decrypted: openssl or the "
            f"disk failed on the runner. tofu was not run. {_RUNNER}"
        ),
    )


USAGE = (
    "usage: plan-crypt require | plan-crypt {encrypt|decrypt} <file> | "
    "plan-crypt {encrypt-state|decrypt-state} <file> <cache-key>"
)


def main(argv):
    if argv[1:] == ["require"]:
        _require_encryption_key()
    elif len(argv) == 4 and argv[1] in ("encrypt-state", "decrypt-state"):
        (encrypt_state if argv[1] == "encrypt-state" else decrypt_state)(argv[2], argv[3])
    elif len(argv) == 3 and argv[1] in ("encrypt", "decrypt"):
        (encrypt if argv[1] == "encrypt" else decrypt)(argv[2])
    else:
        raise SystemExit(USAGE)


if __name__ == "__main__":
    run_annotated(main, sys.argv)
