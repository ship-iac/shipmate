#!/usr/bin/env python3
"""Shared cipher for the plan artifact and the cached local state file.

Single definition of the openssl invocation so plan-cell (require first, encrypt
before upload), apply-cell (decrypt after download) and actions/state (encrypt before
save, decrypt after restore) can never drift. The openssl flags live ONLY here.

Cipher: openssl enc -aes-256-ctr -pbkdf2 -iter 600000 -md sha256 -salt,
passphrase from the PLAN_PASSPHRASE env var (never argv). The passphrase is
required: every operation refuses when it is empty or unset, and every decrypt
refuses an unsalted (plaintext) file.

AES-256-CTR is an unauthenticated stream cipher: a WRONG passphrase, or a file
written with another key derivation, decrypts to garbage WITH EXIT 0 -- it does
NOT error. So each decrypt checks its result before it replaces the ciphertext: a
plan must be a zip archive or OpenTofu's encrypted-plan envelope, state must parse
as OpenTofu state (CONTRACT.md §Plan artifact encryption).
"""

import json
import os
import subprocess
import sys

MAGIC = b"Salted__"  # openssl salted-header prefix (first 8 bytes)
HEADER_LEN = 16  # openssl cannot decrypt an input shorter than `Salted__` plus its 8-byte salt.
PLAN_MAGIC = b"PK\x03\x04"  # zip local-file header: a plaintext OpenTofu plan is a zip archive
_REPLAN = (
    "comment shipmate plan or push, or after the merge open a new pull request touching the stack."
)
_RUNNER = (
    "Re-run the job, which clears a transient hosted-runner disk failure, or fix a self-hosted "
    "runner's openssl or disk."
)
ENV_VAR = "PLAN_PASSPHRASE"  # name of the env var carrying the secret (not the secret itself)


def _passphrase():
    return os.environ.get(ENV_VAR, "")


def _starts_with(path, magic):
    with open(path, "rb") as fh:
        return fh.read(len(magic)) == magic


def _openssl(path, *, decrypt, failure, accept=None):
    # The ONLY place the openssl flags live (coupling: plan-cell, apply-cell, actions/state).
    # openssl enc cannot read and write the same file, so go via a temp sibling, checked
    # by `accept` before the atomic replace. -pass env: keeps the secret out of argv.
    tmp = path + ".crypt.tmp"
    args = [
        "openssl",
        "enc",
        "-aes-256-ctr",
        "-pbkdf2",
        "-iter",
        "600000",
        "-md",
        "sha256",
        "-salt",
        "-in",
        path,
        "-out",
        tmp,
        "-pass",
        f"env:{ENV_VAR}",
    ]
    if decrypt:
        args.insert(2, "-d")
    try:
        subprocess.run(args, check=True)  # noqa: S603, S607 - fixed argv, no shell; secret via env, openssl is a runner prereq
        if accept and not accept(tmp):
            return False
        os.replace(tmp, path)
        return True
    except subprocess.CalledProcessError:
        raise SystemExit(failure) from None
    # A missing openssl, or a temp file that cannot be read or moved, still prints ::error::.
    except OSError as exc:
        raise SystemExit(f"{failure} Error: {exc}") from None
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                print(
                    f"::error::could not remove the temporary file `{tmp}`; delete it, because "
                    "after a decrypt it can hold the plaintext."
                )


def _require_passphrase():
    if not _passphrase():
        raise SystemExit(
            "::error::SHIPMATE_PLAN_PASSPHRASE is not set; it is required to encrypt and "
            "decrypt plan artifacts and local state. Set the secret and forward it to the "
            "shipmate workflows."
        )


def _repo_flag():
    repo = os.environ.get("GITHUB_REPOSITORY", "")
    return f" --repo {repo}" if repo else ""


def _purge_command(prefix):
    repo = _repo_flag()
    return (
        f"gh cache list{repo} --key {prefix} --limit 1000 --json id --jq '.[].id' "
        f"| xargs -n1 gh cache delete{repo}"
    )


def encrypt(path):
    """Encrypt in place, or refuse without a passphrase."""
    _require_passphrase()
    # No remedy here: a plan cell re-plans, and whether an apply cell's state save may be
    # re-run depends on whether its apply ran. docs/troubleshooting.md splits the cases.
    failure = (
        f"::error::`{path}` could not be encrypted: openssl or the disk failed on the runner, "
        "so it was not uploaded or saved. docs/troubleshooting.md section `... could not be "
        "encrypted: openssl or the disk failed on the runner` says what to do for a plan cell and "
        "for an apply cell's state save."
    )
    _openssl(path, decrypt=False, failure=failure)


def decrypt(path):
    """Decrypt a plan artifact in place, or refuse before tofu can read it.

    Refuses without a passphrase, on plaintext, on an artifact shorter than its salted
    header, when openssl or the disk fails on the runner, and on a result that is neither a
    zip archive nor OpenTofu's encrypted-plan envelope (another passphrase or key
    derivation, or, for a zip plan, damage to its first bytes), leaving the ciphertext in
    place. Never
    prints the file.
    """
    _require_passphrase()
    try:
        truncated = os.path.getsize(path) < HEADER_LEN
        salted = _starts_with(path, MAGIC)
    except OSError as exc:
        raise SystemExit(
            f"::error::plan artifact `{path}` cannot be read. Nothing was applied. An artifact "
            f"downloaded without stack.otplan needs a re-plan: {_REPLAN} For a disk failure on "
            "the runner, the refusal comes before any apply step, so a re-run of the job is safe. "
            f"Error: {exc}"
        ) from None
    if truncated:
        raise SystemExit(
            f"::error::plan artifact `{path}` is truncated: it is shorter than its {HEADER_LEN}-"
            f"byte salted header. Nothing was applied. Re-plan: {_REPLAN}"
        )
    if not salted:
        raise SystemExit(
            "::error::plan artifact is plaintext; refusing to apply an unencrypted plan. "
            f"Re-plan to produce an encrypted plan: {_REPLAN}"
        )
    failure = (
        f"::error::plan artifact `{path}` could not be decrypted: openssl or the disk failed on "
        f"the runner. Nothing was applied. {_RUNNER}"
    )
    if not _openssl(path, decrypt=True, accept=_is_plan, failure=failure):
        raise SystemExit(
            "::error::plan artifact does not decrypt to an OpenTofu plan: it was encrypted with "
            "another key derivation or a rotated passphrase, the plan and apply sides read "
            "different SHIPMATE_PLAN_PASSPHRASE values, or it is corrupt. Nothing was applied. "
            "docs/troubleshooting.md section `plan artifact does not decrypt to an OpenTofu "
            "plan` gives each remedy."
        )


def _json_keys(path):
    with open(path, "rb") as fh:
        try:
            doc = json.loads(fh.read())
        except ValueError:
            return set()
    return set(doc) if isinstance(doc, dict) else set()


def _is_plan(path):
    # OpenTofu's own plan encryption writes a JSON envelope holding `encryption_version`.
    if _starts_with(path, PLAN_MAGIC):
        return True
    return _starts_with(path, b"{") and "encryption_version" in _json_keys(path)


def _is_state(path):
    # OpenTofu's own state encryption writes `encryption_version` in place of `version`.
    return bool(_json_keys(path) & {"version", "encryption_version"})


def decrypt_state(path, cache_key):
    """Decrypt a restored state cache entry in place, or refuse before tofu can read it.

    Refuses without a passphrase, on a plaintext entry, on an entry shorter than its salted
    header, when openssl or the disk fails on the runner, and on a result that is not a JSON
    object with `version` or `encryption_version` (saved with another passphrase or key
    derivation, or a corrupt entry), leaving the ciphertext in place. Never prints the
    file's contents.
    """
    _require_passphrase()
    prefix = cache_key.rpartition("/")[0] + "/"
    delete = f"gh cache delete {cache_key}{_repo_flag()}"
    try:
        truncated = os.path.getsize(path) < HEADER_LEN
        salted = _starts_with(path, MAGIC)
    except OSError as exc:
        raise SystemExit(
            f"::error::state cache entry `{cache_key}` cannot be read. tofu was not run. The "
            "refusal comes before any apply step, so a re-run of the job is safe. "
            f"Error: {exc}"
        ) from None
    if truncated:
        raise SystemExit(
            f"::error::state cache entry `{cache_key}` is truncated: it is shorter than its "
            f"{HEADER_LEN}-byte salted header. tofu was not run. `{delete}` deletes it, and the "
            "next restore uses the previous one."
        )
    if not salted:
        raise SystemExit(
            f"::error::state cache entry `{cache_key}` is plaintext. Delete every entry under "
            f"its prefix, then re-run: `{_purge_command(prefix)}` (the restore matches by "
            f"prefix, so deleting only `{cache_key}` restores the next-older plaintext entry). "
            "Deleting discards that state: OpenTofu no longer tracks the resources it recorded. "
            "A sample stack's null and random resources re-create; a real resource can "
            "collide with or be duplicated by its re-creation."
        )
    failure = (
        f"::error::state cache entry `{cache_key}` could not be decrypted: openssl or the disk "
        f"failed on the runner. tofu was not run. {_RUNNER}"
    )
    if not _openssl(path, decrypt=True, accept=_is_state, failure=failure):
        raise SystemExit(
            f"::error::state cache entry `{cache_key}` does not decrypt to OpenTofu state: it "
            "was saved with another key derivation or a rotated passphrase, the plan and apply "
            "sides read different SHIPMATE_PLAN_PASSPHRASE values, or it is corrupt. tofu was "
            "not run. docs/troubleshooting.md section `state cache entry ... does not decrypt to "
            "OpenTofu state` says which command fits which cause. Delete this entry: "
            f"`{delete}`. Delete every entry under its prefix, which discards that state: "
            f"`{_purge_command(prefix)}`."
        )


USAGE = (
    "usage: plan-crypt require | plan-crypt {encrypt|decrypt} <file> | "
    "plan-crypt decrypt-state <file> <cache-key>"
)


def main(argv):
    if argv[1:] == ["require"]:
        _require_passphrase()
    elif len(argv) == 4 and argv[1] == "decrypt-state":
        decrypt_state(argv[2], argv[3])
    elif len(argv) == 3 and argv[1] in ("encrypt", "decrypt"):
        (encrypt if argv[1] == "encrypt" else decrypt)(argv[2])
    else:
        raise SystemExit(USAGE)


if __name__ == "__main__":
    main(sys.argv)
